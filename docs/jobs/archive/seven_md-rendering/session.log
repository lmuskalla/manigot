= $derived.by(() => {\n57\t    let jobs = data.active === project ? data.jobs : []\n58\t    if (filter === 'human') jobs = jobs.filter((j) => j.jdi?.state === 'stopped:needs-human')\n59\t    if (filter === 'running') jobs = jobs.filter((j) => j.jdi?.state === 'running')\n60\t    if (typeFilter) jobs = jobs.filter((j) => j.type === typeFilter)\n61\t    const needle = search.trim().toLowerCase()\n62\t    if (needle) {\n63\t      jobs = jobs.filter(\n64\t        (j) =>\n65\t          j.title.toLowerCase().includes(needle) ||\n66\t          j.name.toLowerCase().includes(needle) ||\n67\t          j.id.toLowerCase().includes(needle),\n68\t      )\n69\t    }\n70\t    return [...jobs].sort((a, b) => attention(a).level - attention(b).level)\n71\t  })\n72\t\n73\t  const counts = $derived.by(() => {\n74\t    const jobs = data.active === project ? data.jobs : []\n75\t    return {\n76\t      all: jobs.length,\n77\t      human: jobs.filter((j) => j.jdi?.state === 'stopped:needs-human').length,\n78\t      running: jobs.filter((j) => j.jdi?.state === 'running').length,\n79\t    }\n80\t  })\n81\t\n82\t  async function createJob() {\n83\t    creating = true\n84\t    try {\n85\t      const res = await api.createJob(project, newTitle.trim(), newType)\n86\t      toasts.ok(`Job scaffolded — ${typeof res.job === 'string' ? res.job : res.job?.name ?? newTitle}`)\n87\t      showNew = false\n88\t      newTitle = ''\n89\t      newType = 'feature'\n90\t      await data.refreshJobs()\n91\t    } catch (e) {\n92\t      toasts.error(actionError(e, 'create jobs'))\n93\t    } finally {\n94\t      creating = false\n95\t    }\n96\t  }\n97\t\n98\t  async function removeOrphans() {\n99\t    removingOrphans = true\n100\t    try {\n101\t      const res = await api.removeOrphans(project)\n102\t      toasts.ok(res.message ?? 'Orphaned worktrees removed')\n103\t      confirmOrphans = false\n104\t      await loadOrphans()\n105\t    } catch (e) {\n106\t      toasts.error(actionError(e, 'remove orphans'))\n107\