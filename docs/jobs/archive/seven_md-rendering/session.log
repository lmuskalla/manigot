ckground: var(--bg-2);\n    border: 1px solid var(--line);\n    border-radius: 4px;\n    padding: 1px 5px;\n    font-size: 0.86em;\n    color: #c9bdf0;\n  }\n  .md :global(pre) {\n    background: var(--bg-1);\n    border: 1px solid var(--line);\n    border-radius: var(--radius-m);\n    padding: var(--r-3) var(--r-4);\n    overflow-x: auto;\n    margin: 0 0 var(--r-3);\n  }\n  .md :global(pre code) {\n    background: none;\n    border: none;\n    padding: 0;\n    font-size: 12.5px;\n    line-height: 1.6;\n    color: var(--ink-1);\n  }\n  .md :global(table) {\n    border-collapse: collapse;\n    margin: 0 0 var(--r-4);\n    font-size: 13px;\n  }\n  .md :global(th),\n  .md :global(td) {\n    border: 1px solid var(--line);\n    padding: 5px 12px;\n    text-align: left;\n  }\n  .md :global(th) {\n    font-family: var(--font-mono);\n    font-size: 10px;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: var(--ink-2);\n    font-weight: 500;\n  }\n  .md :global(td) {\n    color: var(--ink-1);\n  }\n  .md :global(td:first-child code) {\n    color: var(--accent-bright);\n  }\n  .md :global(blockquote) {\n    margin: 0 0 var(--r-3);\n    border-left: 2px solid var(--accent);\n    padding: 2px 0 2px var(--r-4);\n    color: var(--ink-2);\n  }\n  .md :global(hr) {\n    border: none;\n    border-top: 1px solid var(--line);\n    margin: var(--r-4) 0;\n  }\n  .md :global(a) {\n    text-underline-offset: 3px;\n  }\n</style>\n","numLines":140,"startLine":1,"totalLines":140}}}
