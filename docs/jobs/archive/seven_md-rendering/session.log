{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WzQdg8DmuzvKsNo1VwRsMW","type":"tool_result","content":"1\t// Markdown → sanitized HTML. Job files are agent-authored markdown; they are\n2\t// rendered (never executed) with DOMPurify scrubbing everything. The renderer\n3\t// is tuned for the four-file contract: headings, lists, task lines, code\n4\t// fences, tables.\n5\t\n6\timport { marked } from 'marked'\n7\timport DOMPurify from 'dompurify'\n8\t\n9\tmarked.setOptions({\n10\t  gfm: true,\n11\t  breaks: false,\n12\t})\n13\t\n14\texport function renderMarkdown(src: string): string {\n15\t  const html = marked.parse(src ?? '', { async: false })\n16\t  return DOMPurify.sanitize(html, {\n17\t    FORBID_TAGS: ['style', 'form', 'input', 'iframe'],\n18\t    FORBID_ATTR: ['onerror', 'onclick', 'onload'],\n19\t    ALLOW_DATA_ATTR: false,\n20\t  })\n21\t}\n22\t\n23\t/** Extract the `## Overall` verdict status line from a verdict document. */\n24\texport function verdictStatus(src: string): string {\n25\t  const m = src.match(/^##\\s*overall\\s*$/im)\n26\t  if (!m) return ''\n27\t  const rest = src.slice(m.index! + m[0].length)\n28\t  const section = rest.split(/\\n(?=##\\s)/)[0]\n29\t  for (const line of section.split('\\n')) {\n30\t    if (/APPROVED|REJECTED|NEEDS WORK/i.test(line)) return line.trim()\n31\t  }\n32\t  return ''\n33\t}\n34\t\n35\tconst FRONT_KEY = /^(status|type|id|branch|date|author):/\n36\t\n37\t/**\n38\t * Pre-render transform for job markdown:\n39\t *  · the leading run of loose frontmatter (`key: value` lines under the\n40\t *    title, blank lines inside the run swallowed) becomes a table — the\n41\t *    brief's metadata is data, not prose;\n42\t *  · `TASK-n:` line prefixes are emphasised as the task markers they are.\n43\t */\n44\texport function preprocessJobMarkdown(src: string): string {\n45\t  const lines = (src ?? '').split('\\n')\n46\t  const out: string[] = []\n47\t  let i = 0\n48\t\n49\t  if (lines[0]?.startsWith('# ')) {\n50\t    out.push(lines[0])\n51\t    i = 1\n52\t  }\n53\t  // Skip blank lines between the title and the frontmatter run.\n54\t  while (i < lines.length && lines[i].trim() === '') i++\n55\t\n56\t  const fm: [string, string][] = []\n57\t  while (i < lines.length) {\n58\t    const line = lines[i]\n59\t    const m = line.match(/^([a-z]+):\\s*(.*)$/)\n60\t    if (m && FRONT_KEY.test(line)) {\n61\t      fm.push([m[1], m[2]])\n62\t      i++\n63\t    } else if (line.trim() === '' && fm.length > 0 && FRONT_KEY.test(lines[i + 1] ?? '')) {\n64\t      i++ // blank between frontmatter lines\n65\t    } else {\n66\t      break\n67\t    }\n68\t  }\n69\t  if (fm.length > 0) {\n70\t    out.push('| key | value |', '| --- | ----- |')\n71\t    for (const [k, v] of fm) out.push(`| \\`${k}\\` | ${v || '—'} |`)\n72\t    out.push('')\n73\t  }\n74\t\n75\t  for (; i < lines.length; i++) {\n76\t    const t = lines[i].match(/^(TASK-\\d+):(.*)$/)\n77\t    out.push(t ? `**${t[1]}**:${t[2]}` : lines[i])\n78\t  }\n79\t  return out.join('\\n')\n80\t}\n81\t"}]},"parent_tool_use_id":null,"session_id":"561e42e9-f91a-46b3-ab07-d4e54ed01e9c","uuid":"9642266f-c83f-48d3-aec1-da5179d9cc6d","timestamp":"2026-08-29T12:58:21.502Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/web-ui/src/lib/markdown.ts","content":"// Markdown → sanitized HTML. Job files are agent-authored markdown; they are\n// rendered (never executed) with DOMPurify scrubbing everything. The renderer\n// is tuned for the four-file contract: headings, lists, task lines, code\n// fences, tables.\n\nimport { marked } from 'marked'\nimport DOMPurify from 'dompurify'\n\nmarked.setOptions({\n  gfm: true,\n  breaks: false,\n})\n\nexport function renderMarkdown(src: string): string {\n  const html = marked.parse(src ?? '', { async: false })\n  return DOMPurify.sanitize(html, {\n    FORBID_TAGS: ['style', 'form', 'input', 'iframe'],\n    FORBID_ATTR: ['onerror', 'onclick', 'onload'],\n    ALLOW_DATA_ATTR: false,\n  })\n}\n\n/** Extract the `## Overall` verdict status line from a verdict document. */\nexport function verdictStatus(src: string): string {\n  const m = src.match(/^##\\s*overall\\s*$/im)\n  if (!m) return ''\n  const rest = src.slice(m.index! + m[0].length)\n  const section = rest.split(/\\n(?=##\\s)/)[0]\n  for (const line of section.split('\\n')) {\n    if (/APPROVED|REJECTED|NEEDS WORK/i.test(line)) return line.trim()\n  }\n  return ''\n}\n\nconst FRONT_KEY = /^(status|type|id|branch|date|author):/\n\n/**\n * Pre-render transform for job markdown:\n *  · the leading run of loose frontmatter (`key: value` lines under the\n *    title, blank lines inside the run swallowed) becomes a table — the\n *    brief's metadata is data, not prose;\n *  · `TASK-n:` line prefixes are emphasised as the task markers they are.\n */\nexport function preprocessJobMarkdown(src: string): string {\n  const lines = (src ?? '').split('\\n')\n  const out: string[] = []\n  let i = 0\n\n  if (lines[0]?.startsWith('# ')) {\n    out.push(lines[0])\n    i = 1\n  }\n  // Skip blank lines between the title and the frontmatter run.\n  while (i < lines.length && lines[i].trim() === '') i++\n\n  const fm: [string, string][] = []\n  while (i < lines.length) {\n    const line = lines[i]\n    const m = line.match(/^([a-z]+):\\s*(.*)$/)\n    if (m && FRONT_KEY.test(line)) {\n      fm.push([m[1], m[2]])\n      i++\n    } else if (line.trim() === '' && fm.length > 0 && FRONT_KEY.test(lines[i + 1] ?? '')) {\n      i++ // blank between frontmatter lines\n    } else {\n      break\n    }\n  }\n  if (fm.length > 0) {\n    out.push('| key | value |', '| --- | ----- |')\n    for (const [k, v] of fm) out.push(`| \\`${k}\\` | ${v || '—'} |`)\n    out.push('')\n  }\n\n  for (; i < lines.length; i++) {\n    const t = lines[i].match(/^(TASK-\\d+):(.*)$/)\n    out.push(t ? `**${t[1]}**:${t[2]}` : lines[i])\n  }\n  return out.join('\\n')\n}\n","numLines":81,"startLine":1,"totalLines":81}}}
