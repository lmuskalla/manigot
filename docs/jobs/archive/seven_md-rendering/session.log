{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XpQoboWgou2vpGvdf1b28S","type":"tool_result","content":"1\t<script lang=\"ts\">\n2\t  import { onMount } from 'svelte'\n3\t  import Pipeline from '$lib/components/Pipeline.svelte'\n4\t  import MarkdownView from '$lib/components/MarkdownView.svelte'\n5\t  import Modal from '$lib/components/Modal.svelte'\n6\t  import Confirm from '$lib/components/Confirm.svelte'\n7\t  import RunConsole from '$lib/components/RunConsole.svelte'\n8\t  import DiffView from '$lib/components/DiffView.svelte'\n9\t  import { data } from '$lib/state/data.svelte'\n10\t  import { toasts } from '$lib/state/toasts.svelte'\n11\t  import { navigate, href } from '$lib/router'\n12\t  import { relativeTime } from '$lib/time'\n13\t  import { verdictStatus } from '$lib/markdown'\n14\t  import * as api from '$lib/api/client'\n15\t  import type { AgentRow, JobRow } from '$lib/api/types'\n16\t\n17\t  let { project, jobName, tab = 'brief' }: { project: string; jobName: string; tab?: string } = $props()\n18\t\n19\t  const TABS = [\n20\t    { id: 'brief', label: 'Brief' },\n21\t    { id: 'tasks', label: 'Tasks' },\n22\t    { id: 'implementation', label: 'Implementation' },\n23\t    { id: 'verdict', label: 'Verdict' },\n24\t    { id: 'diff', label: 'Diff' },\n25\t    { id: 'run', label: 'Run' },\n26\t  ] as const\n27\t\n28\t  const job = $derived<JobRow | undefined>(\n29\t    (data.active === project ? data.jobs : []).find(\n30\t      (j) => j.name === jobName || j.id === jobName || j.name.startsWith(jobName + '_'),\n31\t    ),\n32\t  )\n33\t\n34\t  // file content per tab\n35\t  let fileContent = $state('')\n36\t  let fileLoading = $state(false)\n37\t  let fileMissing = $state(false)\n38\t\n39\t  // brief editing (Part 2)\n40\t  let editing = $state(false)\n41\t  let draft = $state('')\n42\t  let saving = $state(false)\n43\t\n44\t  // agents + launches (Part 2)\n45\t  let agents = $state<AgentRow[]>([])\n46\t  let showAgents = $state(false)\n47\t  let agentQuery = $state('')\n48\t  let launchingAgent = $state('')\n49\t  let profile = $state('')\n50\t\n51\t  // jdi run\n52\t  let showJdi = $state(false)\n53\t  let startingJdi = $state(false)\n54\t\n55\t  // lifecycle confirms\n56\t  let confirmKind = $state<null | 'done' | 'delete' | 'push'>(null)\n57\t  let lifecycleBusy = $state(false)\n58\t\n59\t  let verdict = $state('')\n60\t  let verdictApproved = $state(false)\n61\t\n62\t  $effect(() => {\n63\t    // (re)load whenever the tab or job changes\n64\t    jobName\n65\t    void loadTab()\n66\t  })\n67\t\n68\t  onMount(async () => {\n69\t    if (data.active !== project) {\n70\t      data.setActive(project)\n71\t      await data.refreshJobs()\n72\t    } else if (!job) {\n73\t      await data.refreshJobs() // direct link — the list may not know this job yet\n74\t    }\n75\t    void loadAgents()\n76\t    data.startPolling()\n77\t    return () => data.stopPolling()\n78\t  })\n79\t\n80\t  async function loadTab() {\n81\t    if (tab === 'diff' || tab === 'run') return\n82\t    fileLoading = true\n83\t    fileMissing = false\n84\t    try {\n85\t      fileContent = await api.getJobFile(project, jobName, tab)\n86\t      if (tab === 'verdict') {\n87\t        verdict = verdictStatus(fileContent)\n88\t        verdictApproved = /\\bAPPROVED\\b/i.test(verdict) && !/REJECTED|NEEDS WORK/i.test(verdict)\n89\t      }\n90\t    } catch {\n91\t      fileContent = ''\n92\t      fileMissing = true\n93\t    } finally {\n94\t      fileLoading = false\n95\t    }\n96\t  }\n97\t\n98\t  async function loadAgents() {\n99\t    try {\n100\t      const res = await api.getAgents(project)\n101\t      agents = res.agents ?? []\n102\t    } catch {\n103\t      agents = []\n104\t    }\n105\t  }\n106\t\n107\t  function goTab(t: string) {\n108\t    navigate(href({ name: 'job', project, job: jobName, tab: t }))\n109\t  }\n110\t\n111\t  function actionError(e: unknown, what: string): string {\n112\t    if (e instanceof api.ApiError && e.capabilityMiss) {\n113\t      return `This daemon does not expose ${what} yet — mutating endpoints land with job two of the control plane.`\n114\t    }\n115\t    return e instanceof Error ? e.message : String(e)\n116\t  }\n117\t\n118\t  async function startEdit() {\n119\t    draft = fileContent\n120\t    editing = true\n121\t  }\n122\t\n123\t  async function saveBrief() {\n124\t    saving = true\n125\t    try {\n126\t      await api.saveBrief(project, jobName, draft)\n127\t      toasts.ok('Brief saved')\n128\t      editing = false\n129\t      fileContent = draft\n130\t      await data.refreshJobs()\n131\t    } catch (e) {\n132\t      toasts.error(actionError(e, 'brief editing'))\n133\t    } finally {\n134\t      saving = false\n135\t    }\n136\t  }\n137\t\n138\t  async function launch(agent: string) {\n139\t    launchingAgent = agent\n140\t    try {\n141\t      const res = await api.launchAgent(project, jobName, agent, profile || undefined)\n142\t      toasts.ok(res.message ?? `@${agent} launched detached`)\n143\t      showAgents = false\n144\t      await data.refreshJobs()\n145\t    } catch (e) {\n146\t      toasts.error(actionError(e, 'agent launches'))\n147\t    } finally {\n148\t      launchingAgent = ''\n149\t    }\n150\t  }\n151\t\n152\t  async function runJdi() {\n153\t    startingJdi = true\n154\t    try {\n155\t      const res = await api.startJdi(project, jobName, profile || undefined)\n156\t      toasts.ok(res.message ?? 'mg jdi detached — watch the Run tab')\n157\t      showJdi = false\n158\t      goTab('run')\n159\t      await data.refreshJobs()\n160\t    } catch (e) {\n161\t      toasts.error(actionError(e, 'jdi launches'))\n162\t    } finally {\n163\t      startingJdi = false\n164\t    }\n165\t  }\n166\t\n167\t  async function lifecycle(kind: 'done' | 'delete' | 'push') {\n168\t    lifecycleBusy = true\n169\t    try {\n170\t      if (kind === 'done') {\n171\t        const res = await api.doneJob(project, jobName)\n172\t        toasts.ok(res.message ?? 'Job archived and squash-merged')\n173\t      } else if (kind === 'delete') {\n174\t        const res = await api.deleteJob(project, jobName)\n175\t        toasts.ok(res.message ?? 'Job deleted')\n176\t      } else {\n177\t        const res = await api.pushJob(project, jobName)\n178\t        toasts.ok(res.message ?? 'Branch pushed')\n179\t      }\n180\t      confirmKind = null\n181\t      if (kind === 'delete') navigate(href({ name: 'jobs', project }))\n182\t      else await data.refreshJobs()\n183\t    } catch (e) {\n184\t      toasts.error(actionError(e, kind === 'done' ? 'done' : kind === 'delete' ? 'delete' : 'push'))\n185\t    } finally {\n186\t      lifecycleBusy = false\n187\t    }\n188\t  }\n189\t\n190\t  const filteredAgents = $derived.by(() => {\n191\t    const q = agentQuery.trim().toLowerCase()\n192\t    if (!q) return agents\n193\t    return agents.filter(\n194\t      (a) => a.name.toLowerCase().includes(q) || a.description.toLowerCase().includes(q),\n195\t    )\n196\t  })\n197\t\n198\t  const needsHuman = $derived(job?.jdi?.state === 'stopped:needs-human')\n199\t  const isRunning = $derived(job?.jdi?.state === 'running')\n200\t</script>\n201\t\n202\t<div class=\"detail\">\n203\t  <header class=\"head\">\n204\t    <a class=\"back\" href={href({ name: 'jobs', project })} aria-label=\"Back to jobs\">←</a>\n205\t    <div class=\"titles\">\n206\t      <h1>{job?.title ?? jobName}</h1>\n207\t      <p class=\"ident\">\n208\t        <span class=\"mono\">{job?.name ?? jobName}</span>\n209\t        {#if job?.branch}<span class=\"sep\">·</span><span class=\"mono dim\">{job.branch}</span>{/if}\n210\t        {#if job}<span class=\"sep\">·</span><span>{job.type}</span>{/if}\n211\t        {#if job?.date}<span class=\"sep\">·</span><span class=\"dim\">{job.date}</span>{/if}\n212\t        {#if job?.jdi}\n213\t          <span class=\"sep\">·</span>\n214\t          <span class=\"dim\">{job.jdi.agent} · {relativeTime(job.jdi.updated)}</span>\n215\t        {/if}\n216\t      </p>\n217\t    </div>\n218\t    <div class=\"actions\">\n219\t      <button class=\"btn\" class:btn-live={isRunning} onclick={() => (showJdi = true)}>\n220\t        {#if isRunning}mg jdi running…{:else}Run mg jdi{/if}\n221\t      </button>\n222\t      <button class=\"btn\" onclick={() => (showAgents = true)}>Launch agent</button>\n223\t      <div class=\"more\" role=\"group\" aria-label=\"Lifecycle\">\n224\t        <button class=\"btn btn-sm\" onclick={() => (confirmKind = 'push')} disabled={!job?.branch}>\n225\t          Push\n226\t        </button>\n227\t        <button\n228\t          class=\"btn btn-sm\"\n229\t          class:btn-primary={job?.stage === 'finished'}\n230\t          onclick={() => (confirmKind = 'done')}\n231\t        >\n232\t          Done\n233\t        </button>\n234\t        <button class=\"btn btn-sm btn-danger\" onclick={() => (confirmKind = 'delete')}>Delete</button>\n235\t      </div>\n236\t    </div>\n237\t  </header>\n238\t\n239\t  {#if job}\n240\t    <div class=\"stage-row\">\n241\t      <Pipeline stage={job.stage} jdi={job.jdi} variant=\"full\" />\n242\t      {#if job.jdi?.state === 'running'}\n243\t        <span class=\"chip chip-running\"><span class=\"dot\"></span> {job.jdi.agent} running</span>\n244\t      {:else if needsHuman}\n245\t        <span class=\"chip chip-human\"><span class=\"dot\"></span> stopped for a human</span>\n246\t      {/if}\n247\t    </div>\n248\t  {/if}\n249\t\n250\t  {#if needsHuman}\n251\t    <aside class=\"human\" role=\"alert\">\n252\t      <div class=\"human-body\">\n253\t        <p class=\"eyebrow human-eyebrow\">handoff</p>\n254\t        <p class=\"human-text\">\n255\t          The run stopped with <code>NEEDS-HUMAN-INPUT</code> — a decision only you can make.\n256\t          Answer it in the brief (or the relevant job file), then relaunch the sequence.\n257\t        </p>\n258\t      </div>\n259\t      <div class=\"human-actions\">\n260\t        <button class=\"btn\" onclick={() => (tab === 'brief' ? startEdit() : goTab('brief'))}>\n261\t          Edit brief\n262\t        </button>\n263\t        <button class=\"btn btn-primary\" onclick={() => (showJdi = true)}>Relaunch mg jdi</button>\n264\t      </div>\n265\t    </aside>\n266\t  {/if}\n267\t\n268\t  <nav class=\"tabs\" role=\"tablist\" aria-label=\"Job files\">\n269\t    {#each TABS as t (t.id)}\n270\t      <button role=\"tab\" aria-selected={tab === t.id} class:active={tab === t.id} onclick={() => goTab(t.id)}>\n271\t        {t.label}\n272\t        {#if t.id === 'verdict' && verdict && tab !== 'verdict'}\n273\t          <span class=\"v-dot\" class:approved={verdictApproved}></span>\n274\t        {/if}\n275\t      </button>\n276\t    {/each}\n277\t  </nav>\n278\t\n279\t  <div class=\"body\" role=\"tabpanel\">\n280\t    {#if tab === 'diff'}\n281\t      <DiffView {project} job={jobName} />\n282\t    {:else if tab === 'run'}\n283\t      <RunConsole {project} job={jobName} />\n284\t    {:else if editing && tab === 'brief'}\n285\t      <div class=\"editor\">\n286\t        <textarea\n287\t          class=\"textarea\"\n288\t          bind:value={draft}\n289\t          spellcheck=\"false\"\n290\t          aria-label=\"Editing brief.md\"\n291\t        ></textarea>\n292\t        <div class=\"editor-bar\">\n293\t          <span class=\"hint mono\">brief.md — raw markdown replaces the file</span>\n294\t          <div class=\"editor-actions\">\n295\t            <button class=\"btn\" onclick={() => (editing = false)} disabled={saving}>Cancel</button>\n296\t            <button class=\"btn btn-primary\" onclick={saveBrief} disabled={saving}>\n297\t              {#if saving}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n298\t              Save brief\n299\t            </button>\n300\t          </div>\n301\t        </div>\n302\t      </div>\n303\t    {:else}\n304\t      {#if fileLoading}\n305\t        <p class=\"loading\">Reading {tab}.md…</p>\n306\t      {:else if fileMissing}\n307\t        <div class=\"missing\">\n308\t          <p class=\"mono\">no {tab}.md yet</p>\n309\t          <p class=\"dim\">\n310\t            {#if tab === 'tasks'}The analyst writes this (@analyst, or Run mg jdi).\n311\t            {:else if tab === 'implementation'}The developer writes this as tasks complete.\n312\t            {:else if tab === 'verdict'}The reviewer writes this after review.\n313\t            {:else}The brief is the job's first file.{/if}\n314\t          </p>\n315\t        </div>\n316\t      {:else}\n317\t        <MarkdownView source={fileContent} />\n318\t        {#if tab === 'brief'}\n319\t          <div class=\"file-actions\">\n320\t            <button class=\"btn\" onclick={startEdit}>Edit brief</button>\n321\t          </div>\n322\t        {/if}\n323\t        {#if tab === 'verdict' && verdict}\n324\t          <p class=\"verdict-line\" class:approved={verdictApproved} class:rejected={!verdictApproved}>\n325\t            Verdict: {verdict}\n326\t          </p>\n327\t        {/if}\n328\t      {/if}\n329\t    {/if}\n330\t  </div>\n331\t</div>\n332\t\n333\t{#if showAgents}\n334\t  <Modal title=\"Launch agent\" onclose={() => (showAgents = false)} width=\"560px\">\n335\t    <p class=\"launch-hint\">\n336\t      One detached run in the job's worktree — its output lands in <code>session.log</code> and the\n337\t      Run tab. Interactive sessions stay in the terminal by design.\n338\t    </p>\n339\t    <div class=\"field\">\n340\t      <label for=\"launch-profile\">profile</label>\n341\t      <select id=\"launch-profile\" class=\"select\" bind:value={profile}>\n342\t        <option value=\"\">daemon default</option>\n343\t        <option value=\"claude-pro\">claude-pro</option>\n344\t        <option value=\"zai\">zai</option>\n345\t        <option value=\"opencode-go\">opencode-go</option>\n346\t        <option value=\"opencode-zen\">opencode-zen</option>\n347\t        <option value=\"opencode-zen-free\">opencode-zen-free</option>\n348\t      </select>\n349\t    </div>\n350\t    <input class=\"input\" placeholder=\"Filter the crew…\" bind:value={agentQuery} spellcheck=\"false\" aria-label=\"Filter agents\" />\n351\t    <ul class=\"crew\">\n352\t      {#each filteredAgents as a (a.name)}\n353\t        <li>\n354\t          <button class=\"crew-row\" onclick={() => launch(a.name)} disabled={launchingAgent !== ''}>\n355\t            <span class=\"crew-name\">{\"@\" + a.name}</span>\n356\t            <span class=\"crew-desc\">{a.description}</span>\n357\t            {#if launchingAgent === a.name}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n358\t          </button>\n359\t        </li>\n360\t      {/each}\n361\t    </ul>\n362\t    {#snippet footer()}\n363\t      <button class=\"btn\" onclick={() => (showAgents = false)} disabled={launchingAgent !== ''}>Cancel</button>\n364\t    {/snippet}\n365\t  </Modal>\n366\t{/if}\n367\t\n368\t{#if showJdi}\n369\t  <Modal title=\"Run mg jdi\" busy={startingJdi} onclose={() => (showJdi = false)} width=\"460px\">\n370\t    <p class=\"launch-hint\">\n371\t      The fixed sequence — <code>@analyst → @developer → @reviewer</code> — runs detached, end to\n372\t      end. It stops on an approved verdict, a human decision, or its retry budget.\n373\t    </p>\n374\t    <div class=\"field\">\n375\t      <label for=\"jdi-profile\">profile</label>\n376\t      <select id=\"jdi-profile\" class=\"select\" bind:value={profile}>\n377\t        <option value=\"\">daemon default (claude-pro)</option>\n378\t        <option value=\"claude-pro\">claude-pro</option>\n379\t        <option value=\"zai\">zai</option>\n380\t        <option value=\"opencode-go\">opencode-go</option>\n381\t        <option value=\"opencode-zen\">opencode-zen</option>\n382\t        <option value=\"opencode-zen-free\">opencode-zen-free</option>\n383\t      </select>\n384\t    </div>\n385\t    {#snippet footer()}\n386\t      <button class=\"btn\" onclick={() => (showJdi = false)} disabled={startingJdi}>Cancel</button>\n387\t      <button class=\"btn btn-primary\" onclick={runJdi} disabled={startingJdi}>\n388\t        {#if startingJdi}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n389\t        Launch sequence\n390\t      </button>\n391\t    {/snippet}\n392\t  </Modal>\n393\t{/if}\n394\t\n395\t{#if confirmKind === 'done'}\n396\t  <Confirm\n397\t    title=\"Archive and merge\"\n398\t    body={job?.stage === 'finished'\n399\t      ? `Done squash-merges ${jobName} into the base branch and archives its docs.`\n400\t      : `The verdict is not approved yet (${verdict || 'no verdict status found'}). mg done can still archive and merge — continue?`}\n401\t    confirmLabel=\"Archive & merge\"\n402\t    confirmKind=\"primary\"\n403\t    busy={lifecycleBusy}\n404\t    onconfirm={() => lifecycle('done')}\n405\t    onclose={() => (confirmKind = null)}\n406\t  />\n407\t{:else if confirmKind === 'delete'}\n408\t  <Confirm\n409\t    title=\"Delete job\"\n410\t    body={`Permanently delete ${jobName}?\\nThe worktree and branch are removed — uncommitted changes will be discarded.\\n\\nThis cannot be undone.`}\n411\t    confirmLabel=\"Delete permanently\"\n412\t    confirmKind=\"danger\"\n413\t    busy={lifecycleBusy}\n414\t    onconfirm={() => lifecycle('delete')}\n415\t    onclose={() => (confirmKind = null)}\n416\t  />\n417\t{:else if confirmKind === 'push'}\n418\t  <Confirm\n419\t    title=\"Push branch\"\n420\t    body={`Push ${job?.branch ?? jobName} to origin?`}\n421\t    confirmLabel=\"Push\"\n422\t    busy={lifecycleBusy}\n423\t    onconfirm={() => lifecycle('push')}\n424\t    onclose={() => (confirmKind = null)}\n425\t  />\n426\t{/if}\n427\t\n428\t<style>\n429\t  .detail {\n430\t    max-width: 880px;\n431\t    margin: 0 auto;\n432\t    width: 100%;\n433\t    padding: var(--r-5) var(--r-6) var(--r-7);\n434\t  }\n435\t\n436\t  .head {\n437\t    display: flex;\n438\t    gap: var(--r-4);\n439\t    align-items: flex-start;\n440\t  }\n441\t  .back {\n442\t    color: var(--ink-2);\n443\t    text-decoration: none;\n444\t    font-size: 18px;\n445\t    padding: 4px 8px 0 0;\n446\t    flex: none;\n447\t    transition: color var(--t-fast);\n448\t  }\n449\t  .back:hover {\n450\t    color: var(--accent-bright);\n451\t    text-decoration: none;\n452\t  }\n453\t  .titles {\n454\t    min-width: 0;\n455\t    flex: 1;\n456\t  }\n457\t  h1 {\n458\t    font-size: 21px;\n459\t    letter-spacing: -0.015em;\n460\t    overflow-wrap: anywhere;\n461\t  }\n462\t  .ident {\n463\t    margin-top: 4px;\n464\t    font-size: 12.5px;\n465\t    color: var(--ink-2);\n466\t    display: flex;\n467\t    flex-wrap: wrap;\n468\t    gap: 6px;\n469\t    align-items: baseline;\n470\t  }\n471\t  .mono {\n472\t    font-family: var(--font-mono);\n473\t    font-size: 12px;\n474\t  }\n475\t  .dim {\n476\t    color: var(--ink-2);\n477\t  }\n478\t  .sep {\n479\t    color: var(--ink-2);\n480\t  }\n481\t  .actions {\n482\t    display: flex;\n483\t    gap: var(--r-2);\n484\t    align-items: center;\n485\t    flex-wrap: wrap;\n486\t    justify-content: flex-end;\n487\t  }\n488\t  .more {\n489\t    display: flex;\n490\t    gap: 6px;\n491\t  }\n492\t  .btn-live {\n493\t    border-color: rgba(139, 108, 246, 0.5);\n494\t    color: var(--accent-bright);\n495\t    background: var(--st-running-dim);\n496\t  }\n497\t\n498\t  .stage-row {\n499\t    display: flex;\n500\t    align-items: center;\n501\t    gap: var(--r-3) var(--r-4);\n502\t    flex-wrap: wrap;\n503\t    margin: var(--r-5) 0 var(--r-4);\n504\t    padding: var(--r-3) var(--r-4);\n505\t    background: var(--bg-1);\n506\t    border: 1px solid var(--line);\n507\t    border-radius: var(--radius-m);\n508\t  }\n509\t\n510\t  .human {\n511\t    display: flex;\n512\t    gap: var(--r-4);\n513\t    align-items: center;\n514\t    justify-content: space-between;\n515\t    flex-wrap: wrap;\n516\t    border: 1px solid rgba(242, 85, 90, 0.45);\n517\t    background:\n518\t      radial-gradient(400px 120px at 0% 0%, rgba(242, 85, 90, 0.1), transparent),\n519\t      var(--bg-1);\n520\t    border-radius: var(--radius-m);\n521\t    padding: var(--r-4) var(--r-5);\n522\t    margin-bottom: var(--r-5);\n523\t  }\n524\t  .human-eyebrow {\n525\t    color: #ff8d91;\n526\t    margin-bottom: 4px;\n527\t  }\n528\t  .human-text {\n529\t    color: var(--ink-1);\n530\t    font-size: 13.5px;\n531\t    max-width: 62ch;\n532\t  }\n533\t  .human-text code {\n534\t    color: #ff8d91;\n535\t    font-size: 0.9em;\n536\t  }\n537\t  .human-actions {\n538\t    display: flex;\n539\t    gap: var(--r-2);\n540\t  }\n541\t\n542\t  .tabs {\n543\t    display: flex;\n544\t    gap: 2px;\n545\t    border-bottom: 1px solid var(--line);\n546\t    overflow-x: auto;\n547\t    scrollbar-width: none;\n548\t    position: relative;\n549\t  }\n550\t  .tabs::-webkit-scrollbar {\n551\t    display: none;\n552\t  }\n553\t  /* a scrollability hint at the right edge — the strip scrolls on phones */\n554\t  .tabs::after {\n555\t    content: '';\n556\t    position: sticky;\n557\t    right: 0;\n558\t    top: 0;\n559\t    flex: none;\n560\t    width: 28px;\n561\t    align-self: stretch;\n562\t    background: linear-gradient(90deg, transparent, var(--bg-0) 70%);\n563\t    pointer-events: none;\n564\t    margin-left: -28px;\n565\t  }\n566\t  .tabs button {\n567\t    appearance: none;\n568\t    background: none;\n569\t    border: none;\n570\t    color: var(--ink-2);\n571\t    font: inherit;\n572\t    font-size: 13.5px;\n573\t    font-weight: 530;\n574\t    padding: 8px 14px 10px;\n575\t    cursor: pointer;\n576\t    border-bottom: 2px solid transparent;\n577\t    margin-bottom: -1px;\n578\t    white-space: nowrap;\n579\t    display: inline-flex;\n580\t    align-items: center;\n581\t    gap: 6px;\n582\t    transition: color var(--t-fast);\n583\t  }\n584\t  .tabs button:hover {\n585\t    color: var(--ink-0);\n586\t  }\n587\t  .tabs button.active {\n588\t    color: var(--accent-bright);\n589\t    border-bottom-color: var(--accent);\n590\t  }\n591\t  .v-dot {\n592\t    width: 7px;\n593\t    height: 7px;\n594\t    border-radius: 50%;\n595\t    background: var(--st-human);\n596\t  }\n597\t  .v-dot.approved {\n598\t    background: var(--st-done);\n599\t  }\n600\t\n601\t  .body {\n602\t    padding-top: var(--r-5);\n603\t    min-height: 240px;\n604\t  }\n605\t\n606\t  .loading,\n607\t  .missing {\n608\t    color: var(--ink-2);\n609\t    font-size: 14px;\n610\t    padding: var(--r-4) 0;\n611\t  }\n612\t  .missing .mono {\n613\t    color: var(--st-open);\n614\t    margin-bottom: 4px;\n615\t    display: block;\n616\t  }\n617\t\n618\t  .file-actions {\n619\t    margin-top: var(--r-4);\n620\t    padding-top: var(--r-4);\n621\t    border-top: 1px solid var(--line);\n622\t  }\n623\t\n624\t  .verdict-line {\n625\t    margin-top: var(--r-4);\n626\t    font-family: var(--font-mono);\n627\t    font-size: 12.5px;\n628\t    padding: 8px 12px;\n629\t    border-radius: var(--radius-s);\n630\t  }\n631\t  .verdict-line.approved {\n632\t    color: var(--st-done);\n633\t    background: var(--st-done-dim);\n634\t  }\n635\t  .verdict-line.rejected {\n636\t    color: #ffb3b6;\n637\t    background: var(--st-human-dim);\n638\t  }\n639\t\n640\t  .editor {\n641\t    display: flex;\n642\t    flex-direction: column;\n643\t    gap: var(--r-3);\n644\t  }\n645\t  .editor .textarea {\n646\t    min-height: 380px;\n647\t  }\n648\t  .editor-bar {\n649\t    display: flex;\n650\t    justify-content: space-between;\n651\t    align-items: center;\n652\t    gap: var(--r-3);\n653\t    flex-wrap: wrap;\n654\t  }\n655\t  .editor-actions {\n656\t    display: flex;\n657\t    gap: var(--r-2);\n658\t  }\n659\t  .hint {\n660\t    font-size: 11.5px;\n661\t    color: var(--ink-2);\n662\t  }\n663\t\n664\t  .launch-hint {\n665\t    font-size: 13.5px;\n666\t    color: var(--ink-1);\n667\t    margin-bottom: var(--r-4);\n668\t    line-height: 1.6;\n669\t  }\n670\t  .launch-hint code {\n671\t    color: var(--accent-bright);\n672\t  }\n673\t\n674\t  .crew {\n675\t    list-style: none;\n676\t    margin: var(--r-3) 0 0;\n677\t    padding: 0;\n678\t    max-height: 300px;\n679\t    overflow-y: auto;\n680\t    display: flex;\n681\t    flex-direction: column;\n682\t    gap: 4px;\n683\t  }\n684\t  .crew-row {\n685\t    display: flex;\n686\t    align-items: baseline;\n687\t    gap: var(--r-3);\n688\t    width: 100%;\n689\t    text-align: left;\n690\t    background: var(--bg-1);\n691\t    border: 1px solid var(--line);\n692\t    border-radius: var(--radius-s);\n693\t    padding: 9px 12px;\n694\t    cursor: pointer;\n695\t    font: inherit;\n696\t    transition: border-color var(--t-fast), background var(--t-fast);\n697\t  }\n698\t  .crew-row:hover:not(:disabled) {\n699\t    border-color: var(--accent);\n700\t    background: var(--bg-2);\n701\t  }\n702\t  .crew-row:disabled {\n703\t    opacity: 0.6;\n704\t    cursor: wait;\n705\t  }\n706\t  .crew-name {\n707\t    font-family: var(--font-mono);\n708\t    font-size: 12.5px;\n709\t    color: var(--accent-bright);\n710\t    flex: none;\n711\t    min-width: 96px;\n712\t  }\n713\t  .crew-desc {\n714\t    font-size: 12.5px;\n715\t    color: var(--ink-2);\n716\t  }\n717\t\n718\t  @media (max-width: 760px) {\n719\t    .detail {\n720\t      padding: var(--r-4) var(--r-4) var(--r-6);\n721\t    }\n722\t    .head {\n723\t      flex-wrap: wrap;\n724\t    }\n725\t    .actions {\n726\t      width: 100%;\n727\t      justify-content: flex-start;\n728\t    }\n729\t    .stage-row {\n730\t      overflow-x: auto;\n731\t    }\n732\t  }\n733\t</style>\n734\t"}]},"parent_tool_use_id":null,"session_id":"561e42e9-f91a-46b3-ab07-d4e54ed01e9c","uuid":"65144e89-e813-4fdb-b0c5-a80a83ace8ef","timestamp":"2026-08-29T12:58:29.885Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/web-ui/src/lib/views/JobDetailView.svelte","content":"<script lang=\"ts\">\n  import { onMount } from 'svelte'\n  import Pipeline from '$lib/components/Pipeline.svelte'\n  import MarkdownView from '$lib/components/MarkdownView.svelte'\n  import Modal from '$lib/components/Modal.svelte'\n  import Confirm from '$lib/components/Confirm.svelte'\n  import RunConsole from '$lib/components/RunConsole.svelte'\n  import DiffView from '$lib/components/DiffView.svelte'\n  import { data } from '$lib/state/data.svelte'\n  import { toasts } from '$lib/state/toasts.svelte'\n  import { navigate, href } from '$lib/router'\n  import { relativeTime } from '$lib/time'\n  import { verdictStatus } from '$lib/markdown'\n  import * as api from '$lib/api/client'\n  import type { AgentRow, JobRow } from '$lib/api/types'\n\n  let { project, jobName, tab = 'brief' }: { project: string; jobName: string; tab?: string } = $props()\n\n  const TABS = [\n    { id: 'brief', label: 'Brief' },\n    { id: 'tasks', label: 'Tasks' },\n    { id: 'implementation', label: 'Implementation' },\n    { id: 'verdict', label: 'Verdict' },\n    { id: 'diff', label: 'Diff' },\n    { id: 'run', label: 'Run' },\n  ] as const\n\n  const job = $derived<JobRow | undefined>(\n    (data.active === project ? data.jobs : []).find(\n      (j) => j.name === jobName || j.id === jobName || j.name.startsWith(jobName + '_'),\n    ),\n  )\n\n  // file content per tab\n  let fileContent = $state('')\n  let fileLoading = $state(false)\n  let fileMissing = $state(false)\n\n  // brief editing (Part 2)\n  let editing = $state(false)\n  let draft = $state('')\n  let saving = $state(false)\n\n  // agents + launches (Part 2)\n  let agents = $state<AgentRow[]>([])\n  let showAgents = $state(false)\n  let agentQuery = $state('')\n  let launchingAgent = $state('')\n  let profile = $state('')\n\n  // jdi run\n  let showJdi = $state(false)\n  let startingJdi = $state(false)\n\n  // lifecycle confirms\n  let confirmKind = $state<null | 'done' | 'delete' | 'push'>(null)\n  let lifecycleBusy = $state(false)\n\n  let verdict = $state('')\n  let verdictApproved = $state(false)\n\n  $effect(() => {\n    // (re)load whenever the tab or job changes\n    jobName\n    void loadTab()\n  })\n\n  onMount(async () => {\n    if (data.active !== project) {\n      data.setActive(project)\n      await data.refreshJobs()\n    } else if (!job) {\n      await data.refreshJobs() // direct link — the list may not know this job yet\n    }\n    void loadAgents()\n    data.startPolling()\n    return () => data.stopPolling()\n  })\n\n  async function loadTab() {\n    if (tab === 'diff' || tab === 'run') return\n    fileLoading = true\n    fileMissing = false\n    try {\n      fileContent = await api.getJobFile(project, jobName, tab)\n      if (tab === 'verdict') {\n        verdict = verdictStatus(fileContent)\n        verdictApproved = /\\bAPPROVED\\b/i.test(verdict) && !/REJECTED|NEEDS WORK/i.test(verdict)\n      }\n    } catch {\n      fileContent = ''\n      fileMissing = true\n    } finally {\n      fileLoading = false\n    }\n  }\n\n  async function loadAgents() {\n    try {\n      const res = await api.getAgents(project)\n      agents = res.agents ?? []\n    } catch {\n      agents = []\n    }\n  }\n\n  function goTab(t: string) {\n    navigate(href({ name: 'job', project, job: jobName, tab: t }))\n  }\n\n  function actionError(e: unknown, what: string): string {\n    if (e instanceof api.ApiError && e.capabilityMiss) {\n      return `This daemon does not expose ${what} yet — mutating endpoints land with job two of the control plane.`\n    }\n    return e instanceof Error ? e.message : String(e)\n  }\n\n  async function startEdit() {\n    draft = fileContent\n    editing = true\n  }\n\n  async function saveBrief() {\n    saving = true\n    try {\n      await api.saveBrief(project, jobName, draft)\n      toasts.ok('Brief saved')\n      editing = false\n      fileContent = draft\n      await data.refreshJobs()\n    } catch (e) {\n      toasts.error(actionError(e, 'brief editing'))\n    } finally {\n      saving = false\n    }\n  }\n\n  async function launch(agent: string) {\n    launchingAgent = agent\n    try {\n      const res = await api.launchAgent(project, jobName, agent, profile || undefined)\n      toasts.ok(res.message ?? `@${agent} launched detached`)\n      showAgents = false\n      await data.refreshJobs()\n    } catch (e) {\n      toasts.error(actionError(e, 'agent launches'))\n    } finally {\n      launchingAgent = ''\n    }\n  }\n\n  async function runJdi() {\n    startingJdi = true\n    try {\n      const res = await api.startJdi(project, jobName, profile || undefined)\n      toasts.ok(res.message ?? 'mg jdi detached — watch the Run tab')\n      showJdi = false\n      goTab('run')\n      await data.refreshJobs()\n    } catch (e) {\n      toasts.error(actionError(e, 'jdi launches'))\n    } finally {\n      startingJdi = false\n    }\n  }\n\n  async function lifecycle(kind: 'done' | 'delete' | 'push') {\n    lifecycleBusy = true\n    try {\n      if (kind === 'done') {\n        const res = await api.doneJob(project, jobName)\n        toasts.ok(res.message ?? 'Job archived and squash-merged')\n      } else if (kind === 'delete') {\n        const res = await api.deleteJob(project, jobName)\n        toasts.ok(res.message ?? 'Job deleted')\n      } else {\n        const res = await api.pushJob(project, jobName)\n        toasts.ok(res.message ?? 'Branch pushed')\n      }\n      confirmKind = null\n      if (kind === 'delete') navigate(href({ name: 'jobs', project }))\n      else await data.refreshJobs()\n    } catch (e) {\n      toasts.error(actionError(e, kind === 'done' ? 'done' : kind === 'delete' ? 'delete' : 'push'))\n    } finally {\n      lifecycleBusy = false\n    }\n  }\n\n  const filteredAgents = $derived.by(() => {\n    const q = agentQuery.trim().toLowerCase()\n    if (!q) return agents\n    return agents.filter(\n      (a) => a.name.toLowerCase().includes(q) || a.description.toLowerCase().includes(q),\n    )\n  })\n\n  const needsHuman = $derived(job?.jdi?.state === 'stopped:needs-human')\n  const isRunning = $derived(job?.jdi?.state === 'running')\n</script>\n\n<div class=\"detail\">\n  <header class=\"head\">\n    <a class=\"back\" href={href({ name: 'jobs', project })} aria-label=\"Back to jobs\">←</a>\n    <div class=\"titles\">\n      <h1>{job?.title ?? jobName}</h1>\n      <p class=\"ident\">\n        <span class=\"mono\">{job?.name ?? jobName}</span>\n        {#if job?.branch}<span class=\"sep\">·</span><span class=\"mono dim\">{job.branch}</span>{/if}\n        {#if job}<span class=\"sep\">·</span><span>{job.type}</span>{/if}\n        {#if job?.date}<span class=\"sep\">·</span><span class=\"dim\">{job.date}</span>{/if}\n        {#if job?.jdi}\n          <span class=\"sep\">·</span>\n          <span class=\"dim\">{job.jdi.agent} · {relativeTime(job.jdi.updated)}</span>\n        {/if}\n      </p>\n    </div>\n    <div class=\"actions\">\n      <button class=\"btn\" class:btn-live={isRunning} onclick={() => (showJdi = true)}>\n        {#if isRunning}mg jdi running…{:else}Run mg jdi{/if}\n      </button>\n      <button class=\"btn\" onclick={() => (showAgents = true)}>Launch agent</button>\n      <div class=\"more\" role=\"group\" aria-label=\"Lifecycle\">\n        <button class=\"btn btn-sm\" onclick={() => (confirmKind = 'push')} disabled={!job?.branch}>\n          Push\n        </button>\n        <button\n          class=\"btn btn-sm\"\n          class:btn-primary={job?.stage === 'finished'}\n          onclick={() => (confirmKind = 'done')}\n        >\n          Done\n        </button>\n        <button class=\"btn btn-sm btn-danger\" onclick={() => (confirmKind = 'delete')}>Delete</button>\n      </div>\n    </div>\n  </header>\n\n  {#if job}\n    <div class=\"stage-row\">\n      <Pipeline stage={job.stage} jdi={job.jdi} variant=\"full\" />\n      {#if job.jdi?.state === 'running'}\n        <span class=\"chip chip-running\"><span class=\"dot\"></span> {job.jdi.agent} running</span>\n      {:else if needsHuman}\n        <span class=\"chip chip-human\"><span class=\"dot\"></span> stopped for a human</span>\n      {/if}\n    </div>\n  {/if}\n\n  {#if needsHuman}\n    <aside class=\"human\" role=\"alert\">\n      <div class=\"human-body\">\n        <p class=\"eyebrow human-eyebrow\">handoff</p>\n        <p class=\"human-text\">\n          The run stopped with <code>NEEDS-HUMAN-INPUT</code> — a decision only you can make.\n          Answer it in the brief (or the relevant job file), then relaunch the sequence.\n        </p>\n      </div>\n      <div class=\"human-actions\">\n        <button class=\"btn\" onclick={() => (tab === 'brief' ? startEdit() : goTab('brief'))}>\n          Edit brief\n        </button>\n        <button class=\"btn btn-primary\" onclick={() => (showJdi = true)}>Relaunch mg jdi</button>\n      </div>\n    </aside>\n  {/if}\n\n  <nav class=\"tabs\" role=\"tablist\" aria-label=\"Job files\">\n    {#each TABS as t (t.id)}\n      <button role=\"tab\" aria-selected={tab === t.id} class:active={tab === t.id} onclick={() => goTab(t.id)}>\n        {t.label}\n        {#if t.id === 'verdict' && verdict && tab !== 'verdict'}\n          <span class=\"v-dot\" class:approved={verdictApproved}></span>\n        {/if}\n      </button>\n    {/each}\n  </nav>\n\n  <div class=\"body\" role=\"tabpanel\">\n    {#if tab === 'diff'}\n      <DiffView {project} job={jobName} />\n    {:else if tab === 'run'}\n      <RunConsole {project} job={jobName} />\n    {:else if editing && tab === 'brief'}\n      <div class=\"editor\">\n        <textarea\n          class=\"textarea\"\n          bind:value={draft}\n          spellcheck=\"false\"\n          aria-label=\"Editing brief.md\"\n        ></textarea>\n        <div class=\"editor-bar\">\n          <span class=\"hint mono\">brief.md — raw markdown replaces the file</span>\n          <div class=\"editor-actions\">\n            <button class=\"btn\" onclick={() => (editing = false)} disabled={saving}>Cancel</button>\n            <button class=\"btn btn-primary\" onclick={saveBrief} disabled={saving}>\n              {#if saving}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n              Save brief\n            </button>\n          </div>\n        </div>\n      </div>\n    {:else}\n      {#if fileLoading}\n        <p class=\"loading\">Reading {tab}.md…</p>\n      {:else if fileMissing}\n        <div class=\"missing\">\n          <p class=\"mono\">no {tab}.md yet</p>\n          <p class=\"dim\">\n            {#if tab === 'tasks'}The analyst writes this (@analyst, or Run mg jdi).\n            {:else if tab === 'implementation'}The developer writes this as tasks complete.\n            {:else if tab === 'verdict'}The reviewer writes this after review.\n            {:else}The brief is the job's first file.{/if}\n          </p>\n        </div>\n      {:else}\n        <MarkdownView source={fileContent} />\n        {#if tab === 'brief'}\n          <div class=\"file-actions\">\n            <button class=\"btn\" onclick={startEdit}>Edit brief</button>\n          </div>\n        {/if}\n        {#if tab === 'verdict' && verdict}\n          <p class=\"verdict-line\" class:approved={verdictApproved} class:rejected={!verdictApproved}>\n            Verdict: {verdict}\n          </p>\n        {/if}\n      {/if}\n    {/if}\n  </div>\n</div>\n\n{#if showAgents}\n  <Modal title=\"Launch agent\" onclose={() => (showAgents = false)} width=\"560px\">\n    <p class=\"launch-hint\">\n      One detached run in the job's worktree — its output lands in <code>session.log</code> and the\n      Run tab. Interactive sessions stay in the terminal by design.\n    </p>\n    <div class=\"field\">\n      <label for=\"launch-profile\">profile</label>\n      <select id=\"launch-profile\" class=\"select\" bind:value={profile}>\n        <option value=\"\">daemon default</option>\n        <option value=\"claude-pro\">claude-pro</option>\n        <option value=\"zai\">zai</option>\n        <option value=\"opencode-go\">opencode-go</option>\n        <option value=\"opencode-zen\">opencode-zen</option>\n        <option value=\"opencode-zen-free\">opencode-zen-free</option>\n      </select>\n    </div>\n    <input class=\"input\" placeholder=\"Filter the crew…\" bind:value={agentQuery} spellcheck=\"false\" aria-label=\"Filter agents\" />\n    <ul class=\"crew\">\n      {#each filteredAgents as a (a.name)}\n        <li>\n          <button class=\"crew-row\" onclick={() => launch(a.name)} disabled={launchingAgent !== ''}>\n            <span class=\"crew-name\">{\"@\" + a.name}</span>\n            <span class=\"crew-desc\">{a.description}</span>\n            {#if launchingAgent === a.name}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n          </button>\n        </li>\n      {/each}\n    </ul>\n    {#snippet footer()}\n      <button class=\"btn\" onclick={() => (showAgents = false)} disabled={launchingAgent !== ''}>Cancel</button>\n    {/snippet}\n  </Modal>\n{/if}\n\n{#if showJdi}\n  <Modal title=\"Run mg jdi\" busy={startingJdi} onclose={() => (showJdi = false)} width=\"460px\">\n    <p class=\"launch-hint\">\n      The fixed sequence — <code>@analyst → @developer → @reviewer</code> — runs detached, end to\n      end. It stops on an approved verdict, a human decision, or its retry budget.\n    </p>\n    <div class=\"field\">\n      <label for=\"jdi-profile\">profile</label>\n      <select id=\"jdi-profile\" class=\"select\" bind:value={profile}>\n        <option value=\"\">daemon default (claude-pro)</option>\n        <option value=\"claude-pro\">claude-pro</option>\n        <option value=\"zai\">zai</option>\n        <option value=\"opencode-go\">opencode-go</option>\n        <option value=\"opencode-zen\">opencode-zen</option>\n        <option value=\"opencode-zen-free\">opencode-zen-free</option>\n      </select>\n    </div>\n    {#snippet footer()}\n      <button class=\"btn\" onclick={() => (showJdi = false)} disabled={startingJdi}>Cancel</button>\n      <button class=\"btn btn-primary\" onclick={runJdi} disabled={startingJdi}>\n        {#if startingJdi}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n        Launch sequence\n      </button>\n    {/snippet}\n  </Modal>\n{/if}\n\n{#if confirmKind === 'done'}\n  <Confirm\n    title=\"Archive and merge\"\n    body={job?.stage === 'finished'\n      ? `Done squash-merges ${jobName} into the base branch and archives its docs.`\n      : `The verdict is not approved yet (${verdict || 'no verdict status found'}). mg done can still archive and merge — continue?`}\n    confirmLabel=\"Archive & merge\"\n    confirmKind=\"primary\"\n    busy={lifecycleBusy}\n    onconfirm={() => lifecycle('done')}\n    onclose={() => (confirmKind = null)}\n  />\n{:else if confirmKind === 'delete'}\n  <Confirm\n    title=\"Delete job\"\n    body={`Permanently delete ${jobName}?\\nThe worktree and branch are removed — uncommitted changes will be discarded.\\n\\nThis cannot be undone.`}\n    confirmLabel=\"Delete permanently\"\n    confirmKind=\"danger\"\n    busy={lifecycleBusy}\n    onconfirm={() => lifecycle('delete')}\n    onclose={() => (confirmKind = null)}\n  />\n{:else if confirmKind === 'push'}\n  <Confirm\n    title=\"Push branch\"\n    body={`Push ${job?.branch ?? jobName} to origin?`}\n    confirmLabel=\"Push\"\n    busy={lifecycleBusy}\n    onconfirm={() => lifecycle('push')}\n    onclose={() => (confirmKind = null)}\n  />\n{/if}\n\n<style>\n  .detail {\n    max-width: 880px;\n    margin: 0 auto;\n    width: 100%;\n    padding: var(--r-5) var(--r-6) var(--r-7);\n  }\n\n  .head {\n    display: flex;\n    gap: var(--r-4);\n    align-items: flex-start;\n  }\n  .back {\n    color: var(--ink-2);\n    text-decoration: none;\n    font-size: 18px;\n    padding: 4px 8px 0 0;\n    flex: none;\n    transition: color var(--t-fast);\n  }\n  .back:hover {\n    color: var(--accent-bright);\n    text-decoration: none;\n  }\n  .titles {\n    min-width: 0;\n    flex: 1;\n  }\n  h1 {\n    font-size: 21px;\n    letter-spacing: -0.015em;\n    overflow-wrap: anywhere;\n  }\n  .ident {\n    margin-top: 4px;\n    font-size: 12.5px;\n    color: var(--ink-2);\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px;\n    align-items: baseline;\n  }\n  .mono {\n    font-family: var(--font-mono);\n    font-size: 12px;\n  }\n  .dim {\n    color: var(--ink-2);\n  }\n  .sep {\n    color: var(--ink-2);\n  }\n  .actions {\n    display: flex;\n    gap: var(--r-2);\n    align-items: center;\n    flex-wrap: wrap;\n    justify-content: flex-end;\n  }\n  .more {\n    display: flex;\n    gap: 6px;\n  }\n  .btn-live {\n    border-color: rgba(139, 108, 246, 0.5);\n    color: var(--accent-bright);\n    background: var(--st-running-dim);\n  }\n\n  .stage-row {\n    display: flex;\n    align-items: center;\n    gap: var(--r-3) var(--r-4);\n    flex-wrap: wrap;\n    margin: var(--r-5) 0 var(--r-4);\n    padding: var(--r-3) var(--r-4);\n    background: var(--bg-1);\n    border: 1px solid var(--line);\n    border-radius: var(--radius-m);\n  }\n\n  .human {\n    display: flex;\n    gap: var(--r-4);\n    align-items: center;\n    justify-content: space-between;\n    flex-wrap: wrap;\n    border: 1px solid rgba(242, 85, 90, 0.45);\n    background:\n      radial-gradient(400px 120px at 0% 0%, rgba(242, 85, 90, 0.1), transparent),\n      var(--bg-1);\n    border-radius: var(--radius-m);\n    padding: var(--r-4) var(--r-5);\n    margin-bottom: var(--r-5);\n  }\n  .human-eyebrow {\n    color: #ff8d91;\n    margin-bottom: 4px;\n  }\n  .human-text {\n    color: var(--ink-1);\n    font-size: 13.5px;\n    max-width: 62ch;\n  }\n  .human-text code {\n    color: #ff8d91;\n    font-size: 0.9em;\n  }\n  .human-actions {\n    display: flex;\n    gap: var(--r-2);\n  }\n\n  .tabs {\n    display: flex;\n    gap: 2px;\n    border-bottom: 1px solid var(--line);\n    overflow-x: auto;\n    scrollbar-width: none;\n    position: relative;\n  }\n  .tabs::-webkit-scrollbar {\n    display: none;\n  }\n  /* a scrollability hint at the right edge — the strip scrolls on phones */\n  .tabs::after {\n    content: '';\n    position: sticky;\n    right: 0;\n    top: 0;\n    flex: none;\n    width: 28px;\n    align-self: stretch;\n    background: linear-gradient(90deg, transparent, var(--bg-0) 70%);\n    pointer-events: none;\n    margin-left: -28px;\n  }\n  .tabs button {\n    appearance: none;\n    background: none;\n    border: none;\n    color: var(--ink-2);\n    font: inherit;\n    font-size: 13.5px;\n    font-weight: 530;\n    padding: 8px 14px 10px;\n    cursor: pointer;\n    border-bottom: 2px solid transparent;\n    margin-bottom: -1px;\n    white-space: nowrap;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    transition: color var(--t-fast);\n  }\n  .tabs button:hover {\n    color: var(--ink-0);\n  }\n  .tabs button.active {\n    color: var(--accent-bright);\n    border-bottom-color: var(--accent);\n  }\n  .v-dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: var(--st-human);\n  }\n  .v-dot.approved {\n    background: var(--st-done);\n  }\n\n  .body {\n    padding-top: var(--r-5);\n    min-height: 240px;\n  }\n\n  .loading,\n  .missing {\n    color: var(--ink-2);\n    font-size: 14px;\n    padding: var(--r-4) 0;\n  }\n  .missing .mono {\n    color: var(--st-open);\n    margin-bottom: 4px;\n    display: block;\n  }\n\n  .file-actions {\n    margin-top: var(--r-4);\n    padding-top: var(--r-4);\n    border-top: 1px solid var(--line);\n  }\n\n  .verdict-line {\n    margin-top: var(--r-4);\n    font-family: var(--font-mono);\n    font-size: 12.5px;\n    padding: 8px 12px;\n    border-radius: var(--radius-s);\n  }\n  .verdict-line.approved {\n    color: var(--st-done);\n    background: var(--st-done-dim);\n  }\n  .verdict-line.rejected {\n    color: #ffb3b6;\n    background: var(--st-human-dim);\n  }\n\n  .editor {\n    display: flex;\n    flex-direction: column;\n    gap: var(--r-3);\n  }\n  .editor .textarea {\n    min-height: 380px;\n  }\n  .editor-bar {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: var(--r-3);\n    flex-wrap: wrap;\n  }\n  .editor-actions {\n    display: flex;\n    gap: var(--r-2);\n  }\n  .hint {\n    font-size: 11.5px;\n    color: var(--ink-2);\n  }\n\n  .launch-hint {\n    font-size: 13.5px;\n    color: var(--ink-1);\n    margin-bottom: var(--r-4);\n    line-height: 1.6;\n  }\n  .launch-hint code {\n    color: var(--accent-bright);\n  }\n\n  .crew {\n    list-style: none;\n    margin: var(--r-3) 0 0;\n    padding: 0;\n    max-height: 300px;\n    overflow-y: auto;\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n  }\n  .crew-row {\n    display: flex;\n    align-items: baseline;\n    gap: var(--r-3);\n    width: 100%;\n    text-align: left;\n    background: var(--bg-1);\n    border: 1px solid var(--line);\n    border-radius: var(--radius-s);\n    padding: 9px 12px;\n    cursor: pointer;\n    font: inherit;\n    transition: border-color var(--t-fast), background var(--t-fast);\n  }\n  .crew-row:hover:not(:disabled) {\n    border-color: var(--accent);\n    background: var(--bg-2);\n  }\n  .crew-row:disabled {\n    opacity: 0.6;\n    cursor: wait;\n  }\n  .crew-name {\n    font-family: var(--font-mono);\n    font-size: 12.5px;\n    color: var(--accent-bright);\n    flex: none;\n    min-width: 96px;\n  }\n  .crew-desc {\n    font-size: 12.5px;\n    color: var(--ink-2);\n  }\n\n  @media (max-width: 760px) {\n    .detail {\n      padding: var(--r-4) var(--r-4) var(--r-6);\n    }\n    .head {\n      flex-wrap: wrap;\n    }\n    .actions {\n      width: 100%;\n      justify-content: flex-start;\n    }\n    .stage-row {\n      overflow-x: auto;\n    }\n  }\n</style>\n","numLines":734,"startLine":1,"totalLines":734}}}
