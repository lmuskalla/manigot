Implemented by commandAgentRunner for real invocations; the tests use a\n322\t// fake instead of spawning real containers.\n323\ttype AgentRunner interface {\n324\t\tRun(agent string, j job.Job, live io.Writer) ([]byte, error)\n325\t}\n326\t\n327\t// commandAgentRunner is the real AgentRunner: it calls the session package's\n328\t// --print path in-process (the replacement for exec'ing the resolved run.sh),\n329\t// capturing the agent's stdout and routing diagnostics to a buffer that only\n330\t// surfaces on error — the same visibility the exec'd run.sh's fd-3\n331\t// diagnostics had.\n332\ttype commandAgentRunner struct {\n333\t\tprojectRoot string\n334\t\tprofile     string\n335\t}\n336\t\n337\t// newCommandAgentRunner builds the in-process runner. projectRoot is where\n338\t// --job resolution starts from (run.sh used $PWD, which the old runner set to\n339\t// the project root); profile is passed through unchanged to every Run\n340\t// invocation — see its own doc.\n341\tfunc newCommandAgentRunner(projectRoot, profile string) (*commandAgentRunner, error) {\n342\t\treturn &commandAgentRunner{projectRoot: projectRoot, profile: profile}, nil\n343\t}\n344\t\n345\t// agentInvocation builds the session options for one agent run — the --print\n346\t// invocation with the runner's pinned profile, the agent, and the exact job\n347\t// directory name.\n348\tfunc (r *commandAgentRunner) agentInvocation(agent string, j job.Job) session.Options {\n349\t\treturn session.Options{Print: true, Profile: r.profile, Agent: agent, Job: j.Name}\n350\t}\n351\t\n352\t// Run invokes the session launcher's --print path synchronously and returns\n353\t// its stdout. The --print path keeps stdout clean of its own diagnostics\n354\t// (they go to the diag writer), so stdout here is exactly the agent's own\n355\t// response. live receives the exact same bytes as they arrive — the io.\n356\t// MultiWriter tee that makes the job's session.log grow live during the\n357\t// invocation (the loo