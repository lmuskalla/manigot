{"type":"tool_use","timestamp":1787938933795,"sessionID":"ses_fb6891103ffeJz653vCFao7FeS","part":{"type":"tool","tool":"glob","callID":"call_3c6158790a1243c79e2c49bb","state":{"status":"completed","input":{"pattern":"src/internal/launch/*.go"},"output":"/workspace/src/internal/launch/launch_test.go\n/workspace/src/internal/launch/launch.go","metadata":{"count":2,"truncated":false},"title":"","time":{"start":1787938933322,"end":1787938933794}},"id":"prt_0497709e10015Xpdn4Rn3mOh07","sessionID":"ses_fb6891103ffeJz653vCFao7FeS","messageID":"msg_04977009a001iXCkB7JvZU0N7W"}}
