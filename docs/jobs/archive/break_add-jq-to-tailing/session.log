call log stays completely empty (not even list-panes, which the launch\n42: // path's replace policy runs first), mirroring\n43: // TestTigKeyReportsNotInstalledAndLaunchesNothing's assertion that a\n44: // gated-off launch never spawns anything.\n45: func TestTailKeyReportsNoSessionLogAndLaunchesNothing(t *testing.T) {\n46: \troot := t.TempDir()\n47: \tj := discoverOneJob(t, root, \"aaaa09_g\")\n48: \n49: \tlogPath := writeTmuxStub(t)\n50: \n51: \ta := NewApp(root, []job.Job{j})\n52: \ta.width, a.height = 80, 24\n53: \ta.detail = newDetailView(j, 80, 24)\n54: \ta.state = stateDetail\n55: \n56: \ta.updateDetail(keyMsg(\"l\"))\n57: \tif !strings.Contains(a.detail.status, \"no mg jdi run has happened for this job yet\") {\n58: \t\tt.Errorf(\"status = %q, want it to explain no session.log exists yet\", a.detail.status)\n59: \t}\n60: \t// The stub's call log only exists once the stub has been invoked at all —\n61: \t// a never-reached launch path leaves no file behind, which is exactly the\n62: \t// empty log this assertion means.\n63: \tcalls, err := os.ReadFile(logPath)\n64: \tif err != nil && !os.IsNotExist(err) {\n65: \t\tt.Fatalf(\"tmux stub call log not readable: %v\", err)\n66: \t}\n67: \tif len(calls) != 0 {\n68: \t\tt.Errorf(\"launch path reached despite the gate — tmux stub was invoked:\\n%s\", calls)\n69: \t}\n70: }\n71: \n72: // --- \"l\" success path (tails session.log in a tmux pane) ---------------------\n73: \n74: // TestTailKeyLaunchesTailInTmuxPane exercises the full \"l\" flow with a real\n75: // session.log in the job's dir and a stubbed tmux on PATH + $TMUX: the\n76: // split-window invocation must carry the `tail -f '<path>'` inner command\n77: // (routed through launch.Tail → launchDetached's tmux path, exactly like\n78: // tig/agent launches), the pane must be tagged, and the status reports where\n79: // it opened.\n80: func TestTailKeyLaunchesTailInTmuxPane(t *testing.T) {\n81: \troot := t.TempDir()\n82: \tj := discoverOneJob(t, root, \"aaaa10_t\")\n83: \n84: \tsessionLog := filepath.Join(j.Dir, \"session.log\")\n85: \tif err := os.WriteFile(sessionLog, []byte(\"=== mg jdi started ===\\n\"), 0o644); err != nil {\n86: \t\tt.Fatal(err)\n87: \t}\n88: \n89: \tlogPath := writeTmuxStub(t)\n90: \n91: \ta := NewApp(root, []job.Job{j})\n92: \ta.width, a.height = 80, 24\n93: \ta.detail = newDetailView(j, 80, 24)\n94: \ta.state = stateDetail\n95: \n96: \ta.updateDetail(keyMsg(\"l\"))\n97: \tif !strings.Contains(a.detail.status, \"→ tailing session.log in tmux pane\") {\n98: \t\tt.Errorf(\"status = %q, want it to report the tail launch in a tmux pane\", a.detail.status)\n99: \t}\n100: \tcalls, err := os.ReadFile(logPath)\n101: \tif err != nil {\n102: \t\tt.Fatalf(\"tmux stub call log not written: %v\", err)\n103: \t}\n104: \tif !strings.Contains(string(calls), \"tail -f '\"+sessionLog+\"'\") {\n105: \t\tt.Errorf(\"tmux split-window not invoked with the tail inner command:\\n%s\", calls)\n106: \t}\n107: \tif !strings.Contains(string(calls), \"select-pane -t %100 -T manigot\") {\n108: \t\tt.Errorf(\"select-pane tagging of the new pane missing:\\n%s\", calls)\n109: \t}\n110: }\n\n(End of file - total 110 lines)\n</content>","metadata":{"preview":"package ui\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// --- footer hint (TASK-4) ----------------------------------------------------\n\n// TestDetailFooterTailHintShownWhenSessionLogExists: the \"· l tail\" hint\n// renders only when a session.log exists for this job — the file-exists gate\n// from the analysis, mirroring the conditional \"e edit\" and \"t tig\" hints.\nfunc TestDetailFooterTailHintShownWhenSessionLogExists(t *testing.T) {\n\troot := t.TempDir()\n\tj := discoverOneJob(t, root, \"aaaa08_t\")\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/ui/tail_test.go","text":"package ui\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// --- footer hint (TASK-4) ----------------------------------------------------\n\n// TestDetailFooterTailHintShownWhenSessionLogExists: the \"· l tail\" hint\n// renders only when a session.log exists for this job — the file-exists gate\n// from the analysis, mirroring the conditional \"e edit\" and \"t tig\" hints.\nfunc TestDetailFooterTailHintShownWhenSessionLogExists(t *testing.T) {\n\troot := t.TempDir()\n\tj := discoverOneJob(t, root, \"aaaa08_t\")\n\n\t// No session.log yet: no hint.\n\td := newDetailView(j, 80, 24)\n\tif strings.Contains(d.renderFooter(), \"l tail\") {\n\t\tt.Errorf(\"footer shows the tail hint with no session.log:\\n%s\", d.renderFooter())\n\t}\n\n\t// A session.log appears (mg jdi drove the job): the hint shows.\n\tif err := os.WriteFile(filepath.Join(j.Dir, \"session.log\"), []byte(\"=== mg jdi started ===\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\td2 := newDetailView(j, 80, 24)\n\tif !strings.Contains(d2.renderFooter(), \"l tail\") {\n\t\tt.Errorf(\"footer missing the tail hint when a session.log exists:\\n%s\", d2.renderFooter())\n\t}\n}\n\n// --- \"l\" key gate ------------------------------------------------------------\n\n// TestTailKeyReportsNoSessionLogAndLaunchesNothing: with no session.log, \"l\"\n// must report the gate and never reach the launch path at all — the tmux stub\n// call log stays completely empty (not even list-panes, which the launch\n// path's replace policy runs first), mirroring\n// TestTigKeyReportsNotInstalledAndLaunchesNothing's assertion that a\n// gated-off launch never spawns anything.\nfunc TestTailKeyReportsNoSessionLogAndLaunchesNothing(t *testing.T) {\n\troot := t.TempDir()\n\tj := discoverOneJob(t, root, \"aaaa09_g\")\n\n\tlogPath := writeTmuxStub(t)\n\n\ta := NewApp(root, []job.Job{j})\n\ta.width, a.height = 80, 24\n\ta.detail = newDetailView(j, 80, 24)\n\ta.state = stateDetail\n\n\ta.updateDetail(keyMsg(\"l\"))\n\tif !strings.Contains(a.detail.status, \"no mg jdi run has happened for this job yet\") {\n\t\tt.Errorf(\"status = %q, want it to explain no session.log exists yet\", a.detail.status)\n\t}\n\t// The stub's call log only exists once the stub has been invoked at all —\n\t// a never-reached launch path leaves no file behind, which is exactly the\n\t// empty log this assertion means.\n\tcalls, err := os.ReadFile(logPath)\n\tif err != nil && !os.IsNotExist(err) {\n\t\tt.Fatalf(\"tmux stub call log not readable: %v\", err)\n\t}\n\tif len(calls) != 0 {\n\t\tt.Errorf(\"launch path reached despite the gate — tmux stub was invoked:\\n%s\", calls)\n\t}\n}\n\n// --- \"l\" success path (tails session.log in a tmux pane) ---------------------\n\n// TestTailKeyLaunchesTailInTmuxPane exercises the full \"l\" flow with a real\n// session.log in the job's dir and a stubbed tmux on PATH + $TMUX: the\n// split-window invocation must carry the `tail -f '<path>'` inner command\n// (routed through launch.Tail → launchDetached's tmux path, exactly like\n// tig/agent launches), the pane must be tagged, and the status reports where\n// it opened.\nfunc TestTailKeyLaunchesTailInTmuxPane(t *testing.T) {\n\troot := t.TempDir()\n\tj := discoverOneJob(t, root, \"aaaa10_t\")\n\n\tsessionLog := filepath.Join(j.Dir, \"session.log\")\n\tif err := os.WriteFile(sessionLog, []byte(\"=== mg jdi started ===\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tlogPath := writeTmuxStub(t)\n\n\ta := NewApp(root, []job.Job{j})\n\ta.width, a.height = 80, 24\n\ta.detail = newDetailView(j, 80, 24)\n\ta.state = stateDetail\n\n\ta.updateDetail(keyMsg(\"l\"))\n\tif !strings.Contains(a.detail.status, \"→ tailing session.log in tmux pane\") {\n\t\tt.Errorf(\"status = %q, want it to report the tail launch in a tmux pane\", a.detail.status)\n\t}\n\tcalls, err := os.ReadFile(logPath)\n\tif err != nil {\n\t\tt.Fatalf(\"tmux stub call log not written: %v\", err)\n\t}\n\tif !strings.Contains(string(calls), \"tail -f '\"+sessionLog+\"'\") {\n\t\tt.Errorf(\"tmux split-window not invoked with the tail inner command:\\n%s\", calls)\n\t}\n\tif !strings.Contains(string(calls), \"select-pane -t %100 -T manigot\") {\n\t\tt.Errorf(\"select-pane tagging of the new pane missing:\\n%s\", calls)\n\t}\n}","lineStart":1,"lineEnd":110,"totalLines":110,"truncated":false}},"title":"src/internal/ui/tail_test.go","time":{"start":1787938937719,"end":1787938937722}},"id":"prt_049771b0f001EVYT7691CA3RBM","sessionID":"ses_fb6891103ffeJz653vCFao7FeS","messageID":"msg_0497714790014lf5JEwB2MP057"}}
