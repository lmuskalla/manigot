4\t// takes none of them (it is a host git command, not a session launch).\n1205\tfunc TestTigShellCommandOmitsSessionFlags(t *testing.T) {\n1206\t\tgot := tigShellCommand(\"/usr/local/bin/manigot\", \"term_tig-in-tui\", \"/home/me/proj\")\n1207\t\tfor _, flag := range []string{\"--profile\", \"--agent\", \"--job\"} {\n1208\t\t\tif strings.Contains(got, flag) {\n1209\t\t\t\tt.Errorf(\"tigShellCommand unexpectedly contains %s: %q\", flag, got)\n1210\t\t\t}\n1211\t\t}\n1212\t}\n1213\t\n1214\t// A checkout in a directory with spaces must still produce a single word for\n1215\t// the manigot path, since the string is re-parsed by osascript / bash -lc.\n1216\tfunc TestTigShellCommandQuotesPathWithSpaces(t *testing.T) {\n1217\t\tgot := tigShellCommand(\"/Users/me/My Projects/manigot/scripts/run.sh\", \"term_tig-in-tui\", \"/tmp/p\")\n1218\t\tif !strings.Contains(got, `'/Users/me/My Projects/manigot/scripts/run.sh'`) {\n1219\t\t\tt.Errorf(\"manigot path not quoted as one word in %q\", got)\n1220\t\t}\n1221\t}\n1222\t\n1223\t// Embedded quotes in either value must be escaped, not close the quote.\n1224\tfunc TestTigShellCommandQuoteEscape(t *testing.T) {\n1225\t\tgot := tigShellCommand(\"/bin/manigot\", \"a'b\", \"/path/with'quote\")\n1226\t\tif !strings.Contains(got, `'/path/with'\\''quote'`) {\n1227\t\t\tt.Errorf(\"root quote not escaped in %q\", got)\n1228\t\t}\n1229\t\tif !strings.Contains(got, `'a'\\''b'`) {\n1230\t\t\tt.Errorf(\"jobID quote not escaped in %q\", got)\n1231\t\t}\n1232\t}\n1233\t\n1234\tfunc TestTigAvailableTrueWhenTigResolves(t *testing.T) {\n1235\t\tstubTigLookPath(t, func(name string) (string, error) {\n1236\t\t\tif name != \"tig\" {\n1237\t\t\t\tt.Errorf(\"TigLookPath called with %q, want %q\", name, \"tig\")\n1238\t\t\t}\n1239\t\t\treturn \"/usr/bin/tig\", nil\n1240\t\t})\n1241\t\tif !TigAvailable() {\n1242\t\t\tt.Error(\"TigAvailable() = false, want true when tig resolves\")\n1243\t\t}\n1244\t}\n1245\t\n1246\tfunc TestTigAvailableFalseWhenTigMissing(t *testing.T) {\n1247\t\tstubTigLookPath(t, func(name string) (string, error) {\n1248\t\t\treturn \"\", exec.ErrNotFound\n1249\t\t})\n1250\t\tif TigAvailable() {\n1251\t\t\tt.Error(\"TigAvailable() = true, want false when tig does not resolve\")\n1252\t\t}\n1253\t}\n1254\t\n1255\t// TestTigMissingErrorsBeforeSpawn: with tig unresolvable, Tig must return the\n1256\t// not-installed error synchronously without consulting ExeOverride at all —\n1257\t// the availability check is the authoritative backstop that runs first, so a\n1258\t// stale cached gate can never open a doomed pane. ExeOverride is pointed at a\n1259\t// marker that fails loudly: reaching it would change the error.\n1260\tfunc TestTigMissingErrorsBeforeSpawn(t *testing.T) {\n1261\t\tstubTigLookPath(t, func(name string) (string, error) {\n1262\t\t\treturn \"\", exec.ErrNotFound\n1263\t\t})\n1264\t\told := ExeOverride\n1265\t\tt.Cleanup(func() { ExeOverride = old })\n1266\t\tExeOverride = func() (string, error) { return \"\", errors.New(\"exe override should not be consulted\") }\n1267\t\n1268\t\t_, err := Tig(\"term_tig-in-tui\", t.TempDir(), \"\")\n1269\t\tif err == nil || !strings.Contains(err.Error(), \"tig is not installed\") {\n1270\t\t\tt.Errorf(\"Tig with tig missing = %v, want the not-installed error\", err)\n1271\t\t}\n1272\t}\n1273\t\n1274\t// TestTigExeOverrideFailure: with tig available but the mg binary unresolvable\n1275\t// (ExeOverride fails), Tig must surface that resolution error — mirroring\n1276\t// Agent/Quick's own \"locate mg binary\" error path.\n1277\tfunc TestTigExeOverrideFailure(t *testing.T) {\n1278\t\tstubTigLookPath(t, func(name string) (string, error) {\n1279\t\t\treturn \"/usr/bin/tig\", nil\n1280\t\t})\n1281\t\told := ExeOverride\n1282\t\tt.Cleanup(func() { ExeOverride = old })\n1283\t\tExeOverride = func() (string, error) { return \"\", errors.New(\"boom\") }\n1284\t\n1285\t\t_, err := Tig(\"term_tig-in-tui\", t.TempDir(), \"\")\n1286\t\tif err == nil || !strings.Contains(err.Error(), \"boom\") {\n1287\t\t\tt.Errorf(\"Tig with ExeOverride failure = %v, want the resolution error\", err)\n1288\t\t}\n1289\t}\n1290\t\n1291\t// TestTigSuccessThroughTmuxStub exercises the full Tig launch through the\n1292\t// existing tmuxStub, mirroring TestAgentAndQuickShareOneTrackedPane: with\n1293\t// $TMUX set and a stubbed tmux on PATH, the split-window invocation must carry\n1294\t// the tig inner command, the pane must be tagged/recorded, and the returned\n1295\t// description must be \"tmux pane\".\n1296\tfunc TestTigSuccessThroughTmuxStub(t *testing.T) {\n1297\t\tstub := newTmuxStub(t)\n1298\t\tstubTigLookPath(t, func(name string) (string, error) {\n1299\t\t\treturn \"/usr/bin/tig\", nil\n1300\t\t})\n1301\t\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n1302\t\ttmuxLastPaneID = \"\"\n1303\t\n1304\t\troot := t.TempDir()\n1305\t\tdesc, err := Tig(\"t5oc4j\", root, \"\")\n1306\t\tif err != nil {\n1307\t\t\tt.Fatalf(\"Tig: %v\", err)\n1308\t\t}\n1309\t\tif desc != \"tmux pane\" {\n1310\t\t\tt.Errorf(\"desc = %q, want %q\", desc, \"tmux pane\")\n1311\t\t}\n1312\t\tif tmuxLastPaneID == \"\" {\n1313\t\t\tt.Error(\"Tig launch did not record a pane id\")\n1314\t\t}\n1315\t\tcalls := stub.calls()\n1316\t\tif !strings.Contains(calls, \"diff 't5oc4j' --tig\") {\n1317\t\t\tt.Errorf(\"tmux split-window not invoked with the tig inner command:\\n%s\", calls)\n1318\t\t}\n1319\t\tif !strings.Contains(calls, \"select-pane -t %100 -T manigot\") {\n1320\t\t\tt.Errorf(\"select-pane tagging of the new pane missing:\\n%s\", calls)\n1321\t\t}\n1322\t}\n1323\t\n1324\t// --- tail (log tailing) launcher ---------------------------------------------\n1325\t\n1326\tfunc TestTailShellCommandFormat(t *testing.T) {\n1327\t\tgot := tailShellCommand(\"/home/me/proj/.manigot/jdi-status/irw320/run.log\")\n1328\t\twant := \"tail -f '/home/me/proj/.manigot/jdi-status/irw320/run.log'\"\n1329\t\tif got != want {\n1330\t\t\tt.Errorf(\"tailShellCommand =\\n %q\\nwant\\n %q\", got, want)\n1331\t\t}\n1332\t\t// Deliberately NOT wrapped in holdOnFailure: a user ends a tail pane with\n1333\t\t// Ctrl+C (exit 130, non-zero), so holding on a non-zero exit would leave\n1334\t\t// a \"press enter to close\" prompt every single time.\n1335\t\tif strings.Contains(got, \"ec=$?\") {\n1336\t\t\tt.Errorf(\"tailShellCommand must not wrap its inner command with holdOnFailure:\\n%q\", got)\n1337\t\t}\n1338\t}\n1339\t\n1340\t// A log path in a directory with spaces must still produce a single word for\n1341\t// the inner command, since the string is re-parsed by osascript / bash -lc.\n1342\tfunc TestTailShellCommandQuotesPathWithSpaces(t *testing.T) {\n1343\t\tgot := tailShellCommand(\"/Users/me/My Projects/manigot/.manigot/jdi-status/irw320/run.log\")\n1344\t\tif !strings.Contains(got, `'/Users/me/My Projects/manigot/.manigot/jdi-status/irw320/run.log'`) {\n1345\t\t\tt.Errorf(\"log path not quoted as one word in %q\", got)\n1346\t\t}\n1347\t}\n1348\t\n1349\t// Embedded quotes in the log path must be escaped, not close the quote.\n1350\tfunc TestTailShellCommandQuoteEscape(t *testing.T) {\n1351\t\tgot := tailShellCommand(\"/path/with'quote/run.log\")\n1352\t\tif !strings.Contains(got, `'/path/with'\\''quote/run.log'`) {\n1353\t\t\tt.Errorf(\"log path quote not escaped in %q\", got)\n1354\t\t}\n1355\t}\n1356\t\n1357\t// TestTailSuccessThroughTmuxStub exercises the full Tail launch through the\n1358\t// existing tmuxStub, mirroring TestTigSuccessThroughTmuxStub: with $TMUX set\n1359\t// and a stubbed tmux on PATH, the split-window invocation must carry the tail\n1360\t// inner command, the pane must be tagged/recorded, and the returned\n1361\t// description must be \"tmux pane\". Unlike Tig there is no ExeOverride /\n1362\t// TigLookPath seam to stub — Tail is a plain host command with no mg-binary\n1363\t// hop.\n1364\tfunc TestTailSuccessThroughTmuxStub(t *testing.T) {\n1365\t\tstub := newTmuxStub(t)\n1366\t\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n1367\t\ttmuxLastPaneID = \"\"\n1368\t\n1369\t\tdesc, err := Tail(\"/home/me/proj/.manigot/jdi-status/t5oc4j/run.log\", \"\")\n1370\t\tif err != nil {\n1371\t\t\tt.Fatalf(\"Tail: %v\", err)\n1372\t\t}\n1373\t\tif desc != \"tmux pane\" {\n1374\t\t\tt.Errorf(\"desc = %q, want %q\", desc, \"tmux pane\")\n1375\t\t}\n1376\t\tif tmuxLastPaneID == \"\" {\n1377\t\t\tt.Error(\"Tail launch did not record a pane id\")\n1378\t\t}\n1379\t\tcalls := stub.calls()\n1380\t\tif !strings.Contains(calls, \"tail -f '/home/me/proj/.manigot/jdi-status/t5oc4j/run.log'\") {\n1381\t\t\tt.Errorf(\"tmux split-window not invoked with the tail inner command:\\n%s\", calls)\n1382\t\t}\n1383\t\tif !strings.Contains(calls, \"select-pane -t %100 -T manigot\") {\n1384\t\t\tt.Errorf(\"select-pane tagging of the new pane missing:\\n%s\", calls)\n1385\t\t}\n1386\t}\n1387\t"}]},"parent_tool_use_id":null,"session_id":"24c1a82b-aecc-49e0-8a6c-9a9931b7cfe5","uuid":"5dcfd810-b531-4353-8dfc-e1f60c2d1a9c","timestamp":"2026-08-28T17:48:17.026Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/launch/launch_test.go","content":"\t\tif data, err := os.ReadFile(out); err == nil {\n\t\t\traw = data\n\t\t\tbreak\n\t\t}\n\t\ttime.Sleep(10 * time.Millisecond)\n\t}\n\tif raw == nil {\n\t\tt.Fatal(\"stub did not run within the timeout\")\n\t}\n\n\trecorded := string(raw)\n\tfor _, want := range []string{\"arg=--profile\", \"arg=\" + config.ProfileZAI} {\n\t\tif !strings.Contains(recorded, want) {\n\t\t\tt.Errorf(\"missing %q in stub record:\\n%s\", want, recorded)\n\t\t}\n\t}\n}\n\n// --- tig (diff browsing) launcher -------------------------------------------\n\n// stubTigLookPath points the launch package's tig lookup at fn and restores\n// it after the test, so tig availability can be controlled without a real\n// tig on the test machine.\nfunc stubTigLookPath(t *testing.T, fn func(string) (string, error)) {\n\tt.Helper()\n\told := TigLookPath\n\tTigLookPath = fn\n\tt.Cleanup(func() { TigLookPath = old })\n}\n\nfunc TestTigShellCommandFormat(t *testing.T) {\n\tgot := tigShellCommand(\"/usr/local/bin/manigot\", \"term_tig-in-tui\", \"/home/me/proj\")\n\twantInner := \"cd '/home/me/proj' && '/usr/local/bin/manigot' diff 'term_tig-in-tui' --tig\"\n\tif !strings.HasPrefix(got, wantInner) {\n\t\tt.Errorf(\"tigShellCommand =\\n %q\\nwant prefix\\n %q\", got, wantInner)\n\t}\n\t// The inner command must be wrapped so a failure holds the window open,\n\t// exactly like every other launch path.\n\tif got != holdOnFailure(wantInner) {\n\t\tt.Errorf(\"tigShellCommand does not wrap its inner command with holdOnFailure:\\n%q\", got)\n\t}\n}\n\n// A tig launch must never carry --profile, --agent or --job — `mg diff`\n// takes none of them (it is a host git command, not a session launch).\nfunc TestTigShellCommandOmitsSessionFlags(t *testing.T) {\n\tgot := tigShellCommand(\"/usr/local/bin/manigot\", \"term_tig-in-tui\", \"/home/me/proj\")\n\tfor _, flag := range []string{\"--profile\", \"--agent\", \"--job\"} {\n\t\tif strings.Contains(got, flag) {\n\t\t\tt.Errorf(\"tigShellCommand unexpectedly contains %s: %q\", flag, got)\n\t\t}\n\t}\n}\n\n// A checkout in a directory with spaces must still produce a single word for\n// the manigot path, since the string is re-parsed by osascript / bash -lc.\nfunc TestTigShellCommandQuotesPathWithSpaces(t *testing.T) {\n\tgot := tigShellCommand(\"/Users/me/My Projects/manigot/scripts/run.sh\", \"term_tig-in-tui\", \"/tmp/p\")\n\tif !strings.Contains(got, `'/Users/me/My Projects/manigot/scripts/run.sh'`) {\n\t\tt.Errorf(\"manigot path not quoted as one word in %q\", got)\n\t}\n}\n\n// Embedded quotes in either value must be escaped, not close the quote.\nfunc TestTigShellCommandQuoteEscape(t *testing.T) {\n\tgot := tigShellCommand(\"/bin/manigot\", \"a'b\", \"/path/with'quote\")\n\tif !strings.Contains(got, `'/path/with'\\''quote'`) {\n\t\tt.Errorf(\"root quote not escaped in %q\", got)\n\t}\n\tif !strings.Contains(got, `'a'\\''b'`) {\n\t\tt.Errorf(\"jobID quote not escaped in %q\", got)\n\t}\n}\n\nfunc TestTigAvailableTrueWhenTigResolves(t *testing.T) {\n\tstubTigLookPath(t, func(name string) (string, error) {\n\t\tif name != \"tig\" {\n\t\t\tt.Errorf(\"TigLookPath called with %q, want %q\", name, \"tig\")\n\t\t}\n\t\treturn \"/usr/bin/tig\", nil\n\t})\n\tif !TigAvailable() {\n\t\tt.Error(\"TigAvailable() = false, want true when tig resolves\")\n\t}\n}\n\nfunc TestTigAvailableFalseWhenTigMissing(t *testing.T) {\n\tstubTigLookPath(t, func(name string) (string, error) {\n\t\treturn \"\", exec.ErrNotFound\n\t})\n\tif TigAvailable() {\n\t\tt.Error(\"TigAvailable() = true, want false when tig does not resolve\")\n\t}\n}\n\n// TestTigMissingErrorsBeforeSpawn: with tig unresolvable, Tig must return the\n// not-installed error synchronously without consulting ExeOverride at all —\n// the availability check is the authoritative backstop that runs first, so a\n// stale cached gate can never open a doomed pane. ExeOverride is pointed at a\n// marker that fails loudly: reaching it would change the error.\nfunc TestTigMissingErrorsBeforeSpawn(t *testing.T) {\n\tstubTigLookPath(t, func(name string) (string, error) {\n\t\treturn \"\", exec.ErrNotFound\n\t})\n\told := ExeOverride\n\tt.Cleanup(func() { ExeOverride = old })\n\tExeOverride = func() (string, error) { return \"\", errors.New(\"exe override should not be consulted\") }\n\n\t_, err := Tig(\"term_tig-in-tui\", t.TempDir(), \"\")\n\tif err == nil || !strings.Contains(err.Error(), \"tig is not installed\") {\n\t\tt.Errorf(\"Tig with tig missing = %v, want the not-installed error\", err)\n\t}\n}\n\n// TestTigExeOverrideFailure: with tig available but the mg binary unresolvable\n// (ExeOverride fails), Tig must surface that resolution error — mirroring\n// Agent/Quick's own \"locate mg binary\" error path.\nfunc TestTigExeOverrideFailure(t *testing.T) {\n\tstubTigLookPath(t, func(name string) (string, error) {\n\t\treturn \"/usr/bin/tig\", nil\n\t})\n\told := ExeOverride\n\tt.Cleanup(func() { ExeOverride = old })\n\tExeOverride = func() (string, error) { return \"\", errors.New(\"boom\") }\n\n\t_, err := Tig(\"term_tig-in-tui\", t.TempDir(), \"\")\n\tif err == nil || !strings.Contains(err.Error(), \"boom\") {\n\t\tt.Errorf(\"Tig with ExeOverride failure = %v, want the resolution error\", err)\n\t}\n}\n\n// TestTigSuccessThroughTmuxStub exercises the full Tig launch through the\n// existing tmuxStub, mirroring TestAgentAndQuickShareOneTrackedPane: with\n// $TMUX set and a stubbed tmux on PATH, the split-window invocation must carry\n// the tig inner command, the pane must be tagged/recorded, and the returned\n// description must be \"tmux pane\".\nfunc TestTigSuccessThroughTmuxStub(t *testing.T) {\n\tstub := newTmuxStub(t)\n\tstubTigLookPath(t, func(name string) (string, error) {\n\t\treturn \"/usr/bin/tig\", nil\n\t})\n\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n\ttmuxLastPaneID = \"\"\n\n\troot := t.TempDir()\n\tdesc, err := Tig(\"t5oc4j\", root, \"\")\n\tif err != nil {\n\t\tt.Fatalf(\"Tig: %v\", err)\n\t}\n\tif desc != \"tmux pane\" {\n\t\tt.Errorf(\"desc = %q, want %q\", desc, \"tmux pane\")\n\t}\n\tif tmuxLastPaneID == \"\" {\n\t\tt.Error(\"Tig launch did not record a pane id\")\n\t}\n\tcalls := stub.calls()\n\tif !strings.Contains(calls, \"diff 't5oc4j' --tig\") {\n\t\tt.Errorf(\"tmux split-window not invoked with the tig inner command:\\n%s\", calls)\n\t}\n\tif !strings.Contains(calls, \"select-pane -t %100 -T manigot\") {\n\t\tt.Errorf(\"select-pane tagging of the new pane missing:\\n%s\", calls)\n\t}\n}\n\n// --- tail (log tailing) launcher ---------------------------------------------\n\nfunc TestTailShellCommandFormat(t *testing.T) {\n\tgot := tailShellCommand(\"/home/me/proj/.manigot/jdi-status/irw320/run.log\")\n\twant := \"tail -f '/home/me/proj/.manigot/jdi-status/irw320/run.log'\"\n\tif got != want {\n\t\tt.Errorf(\"tailShellCommand =\\n %q\\nwant\\n %q\", got, want)\n\t}\n\t// Deliberately NOT wrapped in holdOnFailure: a user ends a tail pane with\n\t// Ctrl+C (exit 130, non-zero), so holding on a non-zero exit would leave\n\t// a \"press enter to close\" prompt every single time.\n\tif strings.Contains(got, \"ec=$?\") {\n\t\tt.Errorf(\"tailShellCommand must not wrap its inner command with holdOnFailure:\\n%q\", got)\n\t}\n}\n\n// A log path in a directory with spaces must still produce a single word for\n// the inner command, since the string is re-parsed by osascript / bash -lc.\nfunc TestTailShellCommandQuotesPathWithSpaces(t *testing.T) {\n\tgot := tailShellCommand(\"/Users/me/My Projects/manigot/.manigot/jdi-status/irw320/run.log\")\n\tif !strings.Contains(got, `'/Users/me/My Projects/manigot/.manigot/jdi-status/irw320/run.log'`) {\n\t\tt.Errorf(\"log path not quoted as one word in %q\", got)\n\t}\n}\n\n// Embedded quotes in the log path must be escaped, not close the quote.\nfunc TestTailShellCommandQuoteEscape(t *testing.T) {\n\tgot := tailShellCommand(\"/path/with'quote/run.log\")\n\tif !strings.Contains(got, `'/path/with'\\''quote/run.log'`) {\n\t\tt.Errorf(\"log path quote not escaped in %q\", got)\n\t}\n}\n\n// TestTailSuccessThroughTmuxStub exercises the full Tail launch through the\n// existing tmuxStub, mirroring TestTigSuccessThroughTmuxStub: with $TMUX set\n// and a stubbed tmux on PATH, the split-window invocation must carry the tail\n// inner command, the pane must be tagged/recorded, and the returned\n// description must be \"tmux pane\". Unlike Tig there is no ExeOverride /\n// TigLookPath seam to stub — Tail is a plain host command with no mg-binary\n// hop.\nfunc TestTailSuccessThroughTmuxStub(t *testing.T) {\n\tstub := newTmuxStub(t)\n\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n\ttmuxLastPaneID = \"\"\n\n\tdesc, err := Tail(\"/home/me/proj/.manigot/jdi-status/t5oc4j/run.log\", \"\")\n\tif err != nil {\n\t\tt.Fatalf(\"Tail: %v\", err)\n\t}\n\tif desc != \"tmux pane\" {\n\t\tt.Errorf(\"desc = %q, want %q\", desc, \"tmux pane\")\n\t}\n\tif tmuxLastPaneID == \"\" {\n\t\tt.Error(\"Tail launch did not record a pane id\")\n\t}\n\tcalls := stub.calls()\n\tif !strings.Contains(calls, \"tail -f '/home/me/proj/.manigot/jdi-status/t5oc4j/run.log'\") {\n\t\tt.Errorf(\"tmux split-window not invoked with the tail inner command:\\n%s\", calls)\n\t}\n\tif !strings.Contains(calls, \"select-pane -t %100 -T manigot\") {\n\t\tt.Errorf(\"select-pane tagging of the new pane missing:\\n%s\", calls)\n\t}\n}\n","numLines":228,"startLine":1160,"totalLines":1387}}}
