{"type":"tool_use","timestamp":1787938934991,"sessionID":"ses_fb6891103ffeJz653vCFao7FeS","part":{"type":"tool","tool":"read","callID":"call_4ec100328d2642c4aab12300","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/launch/launch_test.go"},"output":"<path>/workspace/src/internal/launch/launch_test.go</path>\n<type>file</type>\n<content>\n1: package launch\n2: \n3: import (\n4: \t\"errors\"\n5: \t\"os\"\n6: \t\"os/exec\"\n7: \t\"path/filepath\"\n8: \t\"strings\"\n9: \t\"testing\"\n10: \t\"time\"\n11: \n12: \t\"github.com/lmuskalla/manigot/internal/config\"\n13: )\n14: \n15: func TestShellCommandFormat(t *testing.T) {\n16: \tgot := shellCommand(\"/usr/local/bin/manigot\", \"developer\", \"irw320\", \"/home/me/proj\", \"claude-pro\")\n17: \twantInner := \"cd '/home/me/proj' && '/usr/local/bin/manigot' --profile 'claude-pro' --agent 'developer' --job 'irw320'\"\n18: \tif !strings.HasPrefix(got, wantInner) {\n19: \t\tt.Errorf(\"shellCommand =\\n %q\\nwant prefix\\n %q\", got, wantInner)\n20: \t}\n21: \t// The inner command must be wrapped so a failure holds the window open\n22: \t// (TASK-6) rather than the terminal closing immediately.\n23: \tif got != holdOnFailure(wantInner) {\n24: \t\tt.Errorf(\"shellCommand does not wrap its inner command with holdOnFailure:\\n%q\", got)\n25: \t}\n26: }\n27: \n28: // --- quick (bare-session) launcher ------------------------------------------\n29: \n30: func TestQuickShellCommandFormat(t *testing.T) {\n31: \tgot := quickShellCommand(\"/usr/local/bin/manigot\", \"/home/me/proj\", \"claude-pro\")\n32: \twantInner := \"cd '/home/me/proj' && '/usr/local/bin/manigot' --profile 'claude-pro'\"\n33: \tif !strings.HasPrefix(got, wantInner) {\n34: \t\tt.Errorf(\"quickShellCommand =\\n %q\\nwant prefix\\n %q\", got, wantInner)\n35: \t}\n36: \t// Must be wrapped by holdOnFailure, exactly like the agent path.\n37: \tif got != holdOnFailure(wantInner) {\n38: \t\tt.Errorf(\"quickShellCommand does not wrap its inner command with holdOnFailure:\\n%q\", got)\n39: \t}\n40: }\n41: \n42: // A bare session must never carry --agent or --job — that's the whole point of\n43: // the quick launch path.\n44: func TestQuickShellCommandOmitsAgentAndJob(t *testing.T) {\n45: \tgot := quickShellCommand(\"/usr/local/bin/manigot\", \"/home/me/proj\", \"claude-pro\")\n46: \tif strings.Contains(got, \"--agent\") {\n47: \t\tt.Errorf(\"quickShellCommand unexpectedly contains --agent: %q\", got)\n48: \t}\n49: \tif strings.Contains(got, \"--job\") {\n50: \t\tt.Errorf(\"quickShellCommand unexpectedly contains --job: %q\", got)\n51: \t}\n52: }\n53: \n54: // An empty profile must default to claude-pro, mirroring the agent path and\n55: // scripts/run.sh's own default.\n56: func TestQuickShellCommandDefaultsEmptyProfile(t *testing.T) {\n57: \tgot := quickShellCommand(\"/bin/manigot\", \"/home/me/proj\", \"\")\n58: \tif !strings.Contains(got, \"--profile 'claude-pro'\") {\n59: \t\tt.Errorf(\"quickShellCommand with empty profile = %q, want it to default to claude-pro\", got)\n60: \t}\n61: }\n62: \n63: func TestQuickShellCommandPassesZAIProfile(t *testing.T) {\n64: \tgot := quickShellCommand(\"/bin/manigot\", \"/home/me/proj\", \"zai\")\n65: \tif !strings.Contains(got, \"--profile 'zai'\") {\n66: \t\tt.Errorf(\"quickShellCommand with zai profile = %q, want --profile 'zai'\", got)\n67: \t}\n68: }\n69: \n70: // A checkout in a directory with spaces must still produce a single word for\n71: // the manigot path, since the string is re-parsed by osascript / bash -lc.\n72: func TestQuickShellCommandQuotesPathWithSpaces(t *testing.T) {\n73: \tgot := quickShellCommand(\"/Users/me/My Projects/manigot/scripts/run.sh\", \"/tmp/p\", \"claude-pro\")\n74: \tif !strings.Contains(got, `'/Users/me/My Projects/manigot/scripts/run.sh'`) {\n75: \t\tt.Errorf(\"manigot path not quoted as one word in %q\", got)\n76: \t}\n77: }\n78: \n79: // --- agent-quick (jobless agent session) launcher ---------------------------\n80: \n81: func TestAgentQuickShellCommandFormat(t *testing.T) {\n82: \tgot := agentQuickShellCommand(\"/usr/local/bin/manigot\", \"developer\", \"/home/me/proj\", \"claude-pro\")\n83: \twantInner := \"cd '/home/me/proj' && '/usr/local/bin/manigot' --profile 'claude-pro' --agent 'developer'\"\n84: \tif !strings.HasPrefix(got, wantInner) {\n85: \t\tt.Errorf(\"agentQuickShellCommand =\\n %q\\nwant prefix\\n %q\", got, wantInner)\n86: \t}\n87: \t// Must be wrapped by holdOnFailure, exactly like the other launch paths.\n88: \tif got != holdOnFailure(wantInner) {\n89: \t\tt.Errorf(\"agentQuickShellCommand does not wrap its inner command with holdOnFailure:\\n%q\", got)\n90: \t}\n91: }\n92: \n93: // An agent-quick session must never carry --job — that's what distinguishes\n94: // it from the job-scoped Agent launch path.\n95: func TestAgentQuickShellCommandOmitsJob(t *testing.T) {\n96: \tgot := agentQuickShellCommand(\"/usr/local/bin/manigot\", \"developer\", \"/home/me/proj\", \"claude-pro\")\n97: \tif strings.Contains(got, \"--job\") {\n98: \t\tt.Errorf(\"agentQuickShellCommand unexpectedly contains --job: %q\", got)\n99: \t}\n100: }\n101: \n102: func TestAgentQuickShellCommandDefaultsEmptyProfile(t *testing.T) {\n103: \tgot := agentQuickShellCommand(\"/bin/manigot\", \"developer\", \"/home/me/proj\", \"\")\n104: \tif !strings.Contains(got, \"--profile 'claude-pro'\") {\n105: \t\tt.Errorf(\"agentQuickShellCommand with empty profile = %q, want it to default to claude-pro\", got)\n106: \t}\n107: }\n108: \n109: func TestAgentQuickShellCommandPassesZAIProfile(t *testing.T) {\n110: \tgot := agentQuickShellCommand(\"/bin/manigot\", \"developer\", \"/home/me/proj\", \"zai\")\n111: \tif !strings.Contains(got, \"--profile 'zai'\") {\n112: \t\tt.Errorf(\"agentQuickShellCommand with zai profile = %q, want --profile 'zai'\", got)\n113: \t}\n114: }\n115: \n116: // A checkout in a directory with spaces must still produce a single word for\n117: // the manigot path, since the string is re-parsed by osascript / bash -lc.\n118: func TestAgentQuickShellCommandQuotesPathWithSpaces(t *testing.T) {\n119: \tgot := agentQuickShellCommand(\"/Users/me/My Projects/manigot/scripts/run.sh\", \"developer\", \"/tmp/p\", \"claude-pro\")\n120: \tif !strings.Contains(got, `'/Users/me/My Projects/manigot/scripts/run.sh'`) {\n121: \t\tt.Errorf(\"manigot path not quoted as one word in %q\", got)\n122: \t}\n123: }\n124: \n125: // --- host-agent (host-mode agent session with an explicit prompt) -----------\n126: \n127: func TestHostAgentShellCommandFormat(t *testing.T) {\n128: \tgot := hostAgentShellCommand(\"/usr/local/bin/manigot\", \"git-solver\", \"resolve the conflict\", \"/home/me/proj\", \"claude-pro\")\n129: \twantInner := \"cd '/home/me/proj' && '/usr/local/bin/manigot' host --profile 'claude-pro' --agent 'git-solver' --prompt 'resolve the conflict'\"\n130: \tif !strings.HasPrefix(got, wantInner) {\n131: \t\tt.Errorf(\"hostAgentShellCommand =\\n %q\\nwant prefix\\n %q\", got, wantInner)\n132: \t}\n133: \t// Must be wrapped by holdOnFailure, exactly like the other launch paths.\n134: \tif got != holdOnFailure(wantInner) {\n135: \t\tt.Errorf(\"hostAgentShellCommand does not wrap its inner command with holdOnFailure:\\n%q\", got)\n136: \t}\n137: }\n138: \n139: // A host-mode session must never carry --job: it runs against the project\n140: // root itself (where the failed merge lives), not a job worktree.\n141: func TestHostAgentShellCommandOmitsJob(t *testing.T) {\n142: \tgot := hostAgentShellCommand(\"/usr/local/bin/manigot\", \"git-solver\", \"p\", \"/home/me/proj\", \"claude-pro\")\n143: \tif strings.Contains(got, \"--job\") {\n144: \t\tt.Errorf(\"hostAgentShellCommand unexpectedly contains --job: %q\", got)\n145: \t}\n146: }\n147: \n148: func TestHostAgentShellCommandDefaultsEmptyProfile(t *testing.T) {\n149: \tgot := hostAgentShellCommand(\"/bin/manigot\", \"git-solver\", \"p\", \"/home/me/proj\", \"\")\n150: \tif !strings.Contains(got, \"--profile 'claude-pro'\") {\n151: \t\tt.Errorf(\"hostAgentShellCommand with empty profile = %q, want it to default to claude-pro\", got)\n152: \t}\n153: }\n154: \n155: func TestHostAgentShellCommandPassesZAIProfile(t *testing.T) {\n156: \tgot := hostAgentShellCommand(\"/bin/manigot\", \"git-solver\", \"p\", \"/home/me/proj\", \"zai\")\n157: \tif !strings.Contains(got, \"--profile 'zai'\") {\n158: \t\tt.Errorf(\"hostAgentShellCommand with zai profile = %q, want --profile 'zai'\", got)\n159: \t}\n160: }\n161: \n162: // The prompt is a free-form sentence with quotes/parens — it must survive as\n163: // a single quoted word so the session launcher receives it verbatim.\n164: func TestHostAgentShellCommandQuotesPrompt(t *testing.T) {\n165: \tprompt := `An interrupted mg done: merge feature/ab12cd_x into main (conflicted). \"Don't push.\"`\n166: \tgot := hostAgentShellCommand(\"/bin/manigot\", \"git-solver\", prompt, \"/home/me/proj\", \"claude-pro\")\n167: \tif !strings.Contains(got, \"--prompt 'An interrupted mg done: merge feature/ab12cd_x into main (conflicted). \\\"Don'\\\\''t push.\\\"'\") {\n168: \t\tt.Errorf(\"prompt not quoted as one word in %q\", got)\n169: \t}\n170: }\n171: \n172: // A checkout in a directory with spaces must still produce a single word for\n173: // the manigot path, since the string is re-parsed by osascript / bash -lc.\n174: func TestHostAgentShellCommandQuotesPathWithSpaces(t *testing.T) {\n175: \tgot := hostAgentShellCommand(\"/Users/me/My Projects/manigot/scripts/run.sh\", \"git-solver\", \"p\", \"/tmp/p\", \"claude-pro\")\n176: \tif !strings.Contains(got, `'/Users/me/My Projects/manigot/scripts/run.sh'`) {\n177: \t\tt.Errorf(\"manigot path not quoted as one word in %q\", got)\n178: \t}\n179: }\n180: \n181: // An empty profile must default to claude-pro, matching scripts/run.sh's own\n182: // default, rather than passing an empty --profile value through.\n183: func TestShellCommandDefaultsEmptyProfile(t *testing.T) {\n184: \tgot := shellCommand(\"/bin/manigot\", \"developer\", \"irw320\", \"/home/me/proj\", \"\")\n185: \tif !strings.Contains(got, \"--profile 'claude-pro'\") {\n186: \t\tt.Errorf(\"shellCommand with empty profile = %q, want it to default to claude-pro\", got)\n187: \t}\n188: }\n189: \n190: func TestShellCommandPassesZAIProfile(t *testing.T) {\n191: \tgot := shellCommand(\"/bin/manigot\", \"developer\", \"irw320\", \"/home/me/proj\", \"zai\")\n192: \tif !strings.Contains(got, \"--profile 'zai'\") {\n193: \t\tt.Errorf(\"shellCommand with zai profile = %q, want --profile 'zai'\", got)\n194: \t}\n195: }\n196: \n197: // TestHoldOnFailureExitsCleanlyOnSuccess documents the intended shape of the\n198: // wrapper: it must not alter the wrapped command itself, only append\n199: // exit-code-conditional hold logic after it.\n200: func TestHoldOnFailureExitsCleanlyOnSuccess(t *testing.T) {\n201: \tgot := holdOnFailure(\"true\")\n202: \tif !strings.HasPrefix(got, \"true;\") {\n203: \t\tt.Errorf(\"holdOnFailure should prefix the wrapped command unchanged, got %q\", got)\n204: \t}\n205: \tif !strings.Contains(got, `ec=$?`) {\n206: \t\tt.Errorf(\"holdOnFailure should capture the exit code, got %q\", got)\n207: \t}\n208: \tif !strings.Contains(got, `if [ \"$ec\" -ne 0 ]`) {\n209: \t\tt.Errorf(\"holdOnFailure should only hold on a non-zero exit, got %q\", got)\n210: \t}\n211: \tif !strings.Contains(got, `exit \"$ec\"`) {\n212: \t\tt.Errorf(\"holdOnFailure should preserve the original exit code, got %q\", got)\n213: \t}\n214: }\n215: \n216: // A checkout in a directory with spaces must still produce a single word for\n217: // the manigot path, since the string is re-parsed by osascript / bash -lc.\n218: func TestShellCommandQuotesPathWithSpaces(t *testing.T) {\n219: \tgot := shellCommand(\"/Users/me/My Projects/manigot/scripts/run.sh\", \"reviewer\", \"abc123\", \"/tmp/p\", \"claude-code\")\n220: \tif !strings.Contains(got, `'/Users/me/My Projects/manigot/scripts/run.sh'`) {\n221: \t\tt.Errorf(\"manigot path not quoted as one word in %q\", got)\n222: \t}\n223: }\n224: \n225: func TestShellQuote(t *testing.T) {\n226: \tcases := map[string]string{\n227: \t\t\"\":           \"''\",\n228: \t\t\"plain\":      \"'plain'\",\n229: \t\t\"with space\": \"'with space'\",\n230: \t\t\"a'b\":        \"'a'\\\\''b'\", // embedded quote escaped via '\\''\n231: \t\t`back\\slash`: `'back\\slash'`,\n232: \t}\n233: \tfor in, want := range cases {\n234: \t\tgot := shellQuote(in)\n235: \t\tif got != want {\n236: \t\t\tt.Errorf(\"shellQuote(%q) = %q, want %q\", in, got, want)\n237: \t\t}\n238: \t}\n239: }\n240: \n241: // TestShellQuoteNeutralizesInjection ensures a value engineered to break out of\n242: // its quotes cannot inject shell metacharacters: after quoting, the dangerous\n243: // substring must be contained inside the escaped sequence, not terminate the\n244: // outer single-quoted word.\n245: func TestShellQuoteNeutralizesInjection(t *testing.T) {\n246: \tmal := \"'; rm -rf /; '\"\n247: \tq := shellQuote(mal)\n248: \t// The result must start and end with a single quote and contain no raw\n249: \t// unescaped \"; rm -rf\" outside of quotes — i.e. the only way \"rm\" appears\n250: \t// is inside the escaped inner segment.\n251: \tif !strings.HasPrefix(q, \"'\") || !strings.HasSuffix(q, \"'\") {\n252: \t\tt.Fatalf(\"quoted value not single-quote wrapped: %q\", q)\n253: \t}\n254: \t// Re-splitting on the escape idiom, no segment should be a bare shell\n255: \t// command. Concretely: there must be no occurrence of \"; '\" (close+open\n256: \t// without the escape) which would indicate breakout.\n257: \tif strings.Contains(q, \"; '\") && !strings.Contains(q, `'\\''`) {\n258: \t\tt.Errorf(\"quoting allowed breakout in %q\", q)\n259: \t}\n260: \t// And the canonical escaped form must be present.\n261: \tif !strings.Contains(q, `'\\''`) {\n262: \t\tt.Errorf(\"expected the \\\\'' escape idiom in %q\", q)\n263: \t}\n264: }\n265: \n266: func TestShellCommandQuoteEscape(t *testing.T) {\n267: \t// A projectRoot with a quote still ends up as one safe argument.\n268: \tgot := shellCommand(\"/bin/manigot\", \"a\", \"b\", \"/path/with'quote\", \"claude-pro\")\n269: \t// The root must appear escaped, not as a raw close-quote.\n270: \tif !strings.Contains(got, `'/path/with'\\''quote'`) {\n271: \t\tt.Errorf(\"root quote not escaped in %q\", got)\n272: \t}\n273: }\n274: \n275: // --- tmux split-pane construction (TASK-2) -----------------------------\n276: \n277: // TestBuildCmdTmuxUsesSplitWindow confirms buildCmd's tmux branch runs\n278: // `tmux split-window -h -l 35%` (side-by-side, new pane sized to 35% of the\n279: // window so the TUI's own pane keeps the majority share — TASK-1 scope\n280: // decision) rather than `tmux new-window`, and describes the result as a\n281: // \"tmux pane\". The -P -F '#{pane_id}' flags are TASK-3's replace-policy\n282: // plumbing: they make the split-window client print the new pane's id, which\n283: // launchTmuxPane records and tags (select-pane -T — split-window itself has\n284: // no -T on any released tmux, so tagging is deliberately not constructed\n285: // here). This only exercises the command *construction*; it stubs `tmux` on\n286: // PATH rather than running a real tmux server, so it cannot verify the pane\n287: // actually lands next to the TUI at runtime — see TASK-2's own risk note and\n288: // TASK-4/TASK-5's manual-verification caveat for that gap.\n289: func TestBuildCmdTmuxUsesSplitWindow(t *testing.T) {\n290: \tdir := t.TempDir()\n291: \tstub := filepath.Join(dir, \"tmux\")\n292: \tif err := os.WriteFile(stub, []byte(\"#!/bin/sh\\nexit 0\\n\"), 0o755); err != nil {\n293: \t\tt.Fatal(err)\n294: \t}\n295: \tt.Setenv(\"PATH\", dir)\n296: \tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,12345,0\")\n297: \n298: \tcmd, desc, err := buildCmd(\"echo hi\", \"\")\n299: \tif err != nil {\n300: \t\tt.Fatalf(\"buildCmd: %v\", err)\n301: \t}\n302: \tif desc != \"tmux pane\" {\n303: \t\tt.Errorf(\"desc = %q, want %q\", desc, \"tmux pane\")\n304: \t}\n305: \tif cmd.Path != stub {\n306: \t\tt.Errorf(\"cmd.Path = %q, want %q (resolved tmux binary)\", cmd.Path, stub)\n307: \t}\n308: \twant := []string{\"tmux\", \"split-window\", \"-h\", \"-l\", \"35%\", \"-P\", \"-F\", \"#{pane_id}\", \"bash\", \"-lc\", \"echo hi\"}\n309: \tif len(cmd.Args) != len(want) {\n310: \t\tt.Fatalf(\"cmd.Args = %v, want %v\", cmd.Args, want)\n311: \t}\n312: \tfor i, a := range want {\n313: \t\tif cmd.Args[i] != a {\n314: \t\t\tt.Errorf(\"cmd.Args[%d] = %q, want %q (full: %v)\", i, cmd.Args[i], a, cmd.Args)\n315: \t\t}\n316: \t}\n317: }\n318: \n319: // --- tmux replace/reuse tracking (TASK-3, TASK-5) ----------------------\n320: \n321: // tmuxStub is a fake `tmux` binary used to exercise the replace/reuse\n322: // tracking logic without a real tmux server. It records every invocation to a\n323: // log file (so tests can assert both the content and the order of the commands\n324: // manigot *runs*) and answers like a minimal tmux:\n325: //\n326: //   - list-panes prints the contents of panesFile verbatim — each line is one\n327: //     \"<pane_id> <pane_title>\", matching what `list-panes -s -F '#{pane_id}\n328: //     #{pane_title}'` prints in a real tmux.\n329: //   - split-window prints the next \"%N\" pane id (from an incrementing\n330: //     counterFile, starting at %100 so ids never collide with the listed\n331: //     panes), matching what `-P -F '#{pane_id}'` prints for a real split.\n332: //   - select-pane does nothing, unless TMUX_STUB_SELECT_PANE_FAIL (exit 1 —\n333: //     the \"tagging failed but the pane is live\" case) is set.\n334: //   - kill-pane does nothing, unless TMUX_STUB_KILL_FAIL (exit 1 — the \"user\n335: //     already closed the pane\" case) or TMUX_STUB_SPLIT_FAIL (exit 1 — the\n336: //     \"tmux is broken\" case for split-window) is set.\n337: //\n338: // Like the existing TestJdiStartsResolvedCommandDetached stub, this can only\n339: // confirm that the commands manigot runs are the right ones — real tmux\n340: // session behavior (actual pane creation/listing/killing) cannot be verified\n341: // without a live tmux server, which this environment does not have (TASK-5\n342: // risk note).\n343: type tmuxStub struct {\n344: \tlog     string\n345: \tpanes   string\n346: \tcounter string\n347: \tpath    string\n348: }\n349: \n350: func newTmuxStub(t *testing.T) *tmuxStub {\n351: \tt.Helper()\n352: \tdir := t.TempDir()\n353: \ts := &tmuxStub{\n354: \t\tlog:     filepath.Join(dir, \"calls.log\"),\n355: \t\tpanes:   filepath.Join(dir, \"panes.txt\"),\n356: \t\tcounter: filepath.Join(dir, \"counter.txt\"),\n357: \t\tpath:    filepath.Join(dir, \"tmux\"),\n358: \t}\n359: \tscript := \"#!/bin/sh\\n\" +\n360: \t\t\"echo \\\"$@\\\" >> '\" + s.log + \"'\\n\" +\n361: \t\t\"case \\\"$1\\\" in\\n\" +\n362: \t\t// Only shell builtins below: PATH is set to the stub dir alone (so\n363: \t\t// exec.LookPath(\"tmux\") resolves the stub, not a real tmux), so any\n364: \t\t// external command would not be found.\n365: \t\t\"  list-panes) while read -r line; do echo \\\"$line\\\"; done < '\" + s.panes + \"' ;;\\n\" +\n366: \t\t\"  split-window) [ -n \\\"$TMUX_STUB_SPLIT_FAIL\\\" ] && exit 1; n=0; [ -f '\" + s.counter + \"' ] && read -r n < '\" + s.counter + \"'; n=$((n+1)); echo \\\"$n\\\" > '\" + s.counter + \"'; echo \\\"%$n\\\" ;;\\n\" +\n367: \t\t\"  kill-pane) [ -n \\\"$TMUX_STUB_KILL_FAIL\\\" ] && exit 1 ;;\\n\" +\n368: \t\t\"  select-pane) [ -n \\\"$TMUX_STUB_SELECT_PANE_FAIL\\\" ] && exit 1 ;;\\n\" +\n369: \t\t\"esac\\n\"\n370: \tif err := os.WriteFile(s.path, []byte(script), 0o755); err != nil {\n371: \t\tt.Fatal(err)\n372: \t}\n373: \t// Empty panes file (list-panes succeeds but lists nothing) and a counter\n374: \t// starting at 99, so the first split prints %100 — never colliding with\n375: \t// the small ids tests use for the panes they list.\n376: \tif err := os.WriteFile(s.panes, nil, 0o644); err != nil {\n377: \t\tt.Fatal(err)\n378: \t}\n379: \tif err := os.WriteFile(s.counter, []byte(\"99\"), 0o644); err != nil {\n380: \t\tt.Fatal(err)\n381: \t}\n382: \tt.Setenv(\"PATH\", dir)\n383: \tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,12345,0\")\n384: \treturn s\n385: }\n386: \n387: // setPanes replaces the pane listing list-panes will print. Each line is one\n388: // pane: \"<pane_id> <pane_title>\".\n389: func (s *tmuxStub) setPanes(lines ...string) {\n390: \tcontent := strings.Join(lines, \"\\n\")\n391: \tif content != \"\" {\n392: \t\tcontent += \"\\n\"\n393: \t}\n394: \tif err := os.WriteFile(s.panes, []byte(content), 0o644); err != nil {\n395: \t\tpanic(err)\n396: \t}\n397: }\n398: \n399: // calls returns the recorded invocation log, one `tmux ...` line per call.\n400: func (s *tmuxStub) calls() string {\n401: \traw, err := os.ReadFile(s.log)\n402: \tif err != nil {\n403: \t\treturn \"\"\n404: \t}\n405: \treturn string(raw)\n406: }\n407: \n408: // indexCalls returns the byte offset of needle in the invocation log, or -1.\n409: func (s *tmuxStub) indexCalls(needle string) int {\n410: \treturn strings.Index(s.calls(), needle)\n411: }\n412: \n413: // TestKillPreviousTmuxPaneKillsTrackedAndTaggedOnly is the core safety test\n414: // for the replace policy's \"must never kill a pane it didn't itself open\":\n415: // the previously tracked pane id and every pane whose title is tmuxPaneTag\n416: // are killed, and nothing else in the session is touched.\n417: func TestKillPreviousTmuxPaneKillsTrackedAndTaggedOnly(t *testing.T) {\n418: \tstub := newTmuxStub(t)\n419: \tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n420: \ttmuxLastPaneID = \"%1\" // tracked from a previous launch in this TUI process\n421: \tstub.setPanes(\n422: \t\t\"%2 \"+tmuxPaneTag, // tagged — must be killed\n423: \t\t\"%3 other pane\",   // untagged — must be left alone\n424: \t\t\"%4\",              // no title at all — must be left alone\n425: \t)\n426: \n427: \tif err := killPreviousTmuxPane(); err != nil {\n428: \t\tt.Fatalf(\"killPreviousTmuxPane: %v\", err)\n429: \t}\n430: \tcalls := stub.calls()\n431: \tfor _, want := range []string{\n432: \t\t\"list-panes -s -F #{pane_id} #{pane_title}\",\n433: \t\t\"kill-pane -t %1\",\n434: \t\t\"kill-pane -t %2\",\n435: \t} {\n436: \t\tif !strings.Contains(calls, want) {\n437: \t\t\tt.Errorf(\"missing %q in stub call log:\\n%s\", want, calls)\n438: \t\t}\n439: \t}\n440: \tfor _, not := range []string{\"kill-pane -t %3\", \"kill-pane -t %4\"} {\n441: \t\tif strings.Contains(calls, not) {\n442: \t\t\tt.Errorf(\"unexpectedly killed a pane manigot did not open (%q):\\n%s\", not, calls)\n443: \t\t}\n444: \t}\n445: }\n446: \n447: // TestKillPreviousTmuxPaneSkipsWhenNothingToReplace: with no tracked pane and\n448: // no tagged pane in the session, replace must be a complete no-op — not a\n449: // single kill-pane. Also exercises the empty list-panes output edge case.\n450: func TestKillPreviousTmuxPaneSkipsWhenNothingToReplace(t *testing.T) {\n451: \tstub := newTmuxStub(t)\n452: \tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n453: \ttmuxLastPaneID = \"\"\n454: \tstub.setPanes(\"%9 unrelated\")\n455: \n456: \tif err := killPreviousTmuxPane(); err != nil {\n457: \t\tt.Fatalf(\"killPreviousTmuxPane: %v\", err)\n458: \t}\n459: \tif strings.Contains(stub.calls(), \"kill-pane\") {\n460: \t\tt.Errorf(\"kill-pane called with nothing to replace:\\n%s\", stub.calls())\n461: \t}\n462: }\n463: \n464: // TestKillPreviousTmuxPaneToleratesAlreadyClosedPane: a kill-pane failure\n465: // (the user closed the pane themselves in the meantime) is not an error — it\n466: // is the tolerated no-op case from TASK-3.\n467: func TestKillPreviousTmuxPaneToleratesAlreadyClosedPane(t *testing.T) {\n468: \tnewTmuxStub(t) // sets up the stubbed tmux on PATH + $TMUX; no panes listed\n469: \tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n470: \ttmuxLastPaneID = \"%1\"\n471: \tt.Setenv(\"TMUX_STUB_KILL_FAIL\", \"1\")\n472: \n473: \tif err := killPreviousTmuxPane(); err != nil {\n474: \t\tt.Fatalf(\"killPreviousTmuxPane should tolerate a missing pane, got: %v\", err)\n475: \t}\n476: }\n477: \n478: // TestKillPreviousTmuxPaneListFailure: when tmux cannot list panes at all,\n479: // the error is surfaced so the caller can decide — launchTmuxPane continues\n480: // anyway (see TestLaunchTmuxPaneContinuesAfterListFailure).\n481: func TestKillPreviousTmuxPaneListFailure(t *testing.T) {\n482: \tstub := newTmuxStub(t)\n483: \tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n484: \ttmuxLastPaneID = \"\"\n485: \tif err := os.Remove(stub.panes); err != nil {\n486: \t\tt.Fatal(err) // a missing file makes the stub's `cat` fail, like a real tmux error\n487: \t}\n488: \n489: \terr := killPreviousTmuxPane()\n490: \tif err == nil {\n491: \t\tt.Fatal(\"expected an error when list-panes fails\")\n492: \t}\n493: \tif !strings.Contains(err.Error(), \"list-panes\") {\n494: \t\tt.Errorf(\"error should mention list-panes, got: %v\", err)\n495: \t}\n496: }\n497: \n498: // TestLaunchTmuxPaneReplacesBeforeSplittingAndRecordsPaneID exercises the\n499: // whole TASK-3 sequence: the previous manigot pane (identified by its title\n500: // tag — a fresh TUI process has no tracked id) is killed before the new\n501: // split, the new pane's id (printed by split-window -P) is tagged via\n502: // select-pane -T (the replace-policy tag survives a TUI restart) and recorded\n503: // for the next replace. The log's ordering proves kill-before-split and\n504: // tag-after-split, and that select-pane targets only the pane just created.\n505: func TestLaunchTmuxPaneReplacesBeforeSplittingAndRecordsPaneID(t *testing.T) {\n506: \tstub := newTmuxStub(t)\n507: \tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n508: \ttmuxLastPaneID = \"\" // fresh TUI process: only the tag identifies the old pane\n509: \tstub.setPanes(\"%1 \" + tmuxPaneTag)\n510: \n511: \tdesc, err := launchTmuxPane(\"echo hi\")\n512: \tif err != nil {\n513: \t\tt.Fatalf(\"launchTmuxPane: %v\", err)\n514: \t}\n515: \tif desc != \"tmux pane\" {\n516: \t\tt.Errorf(\"desc = %q, want %q\", desc, \"tmux pane\")\n517: \t}\n518: \tif tmuxLastPaneID != \"%100\" {\n519: \t\tt.Errorf(\"tmuxLastPaneID = %q, want %q (the id split-window printed)\", tmuxLastPaneID, \"%100\")\n520: \t}\n521: \tcalls := stub.calls()\n522: \tif !strings.Contains(calls, \"kill-pane -t %1\") {\n523: \t\tt.Errorf(\"previous tagged pane not killed:\\n%s\", calls)\n524: \t}\n525: \tif !strings.Contains(calls, \"split-window -h -l 35% -P -F #{pane_id} bash -lc echo hi\") {\n526: \t\tt.Errorf(\"split-window invocation missing or wrong:\\n%s\", calls)\n527: \t}\n528: \t// The tag must be applied with select-pane (split-window has no -T on any\n529: \t// released tmux), to the pane the split just created — %100 — and to no\n530: \t// other pane. (\"-t %1 -T\" rather than \"-t %1\" so the %100 line cannot\n531: \t// false-positive the check.)\n532: \tif !strings.Contains(calls, \"select-pane -t %100 -T manigot\") {\n533: \t\tt.Errorf(\"select-pane tagging of the new pane missing or wrong:\\n%s\", calls)\n534: \t}\n535: \tif strings.Contains(calls, \"select-pane -t %1 -T\") {\n536: \t\tt.Errorf(\"select-pane tagged the previous pane instead of the new one:\\n%s\", calls)\n537: \t}\n538: \tif i, j := stub.indexCalls(\"kill-pane -t %1\"), stub.indexCalls(\"split-window\"); i < 0 || j < 0 || i > j {\n539: \t\tt.Errorf(\"kill-pane (%d) must precede split-window (%d):\\n%s\", i, j, calls)\n540: \t}\n541: \tif i, j := stub.indexCalls(\"split-window\"), stub.indexCalls(\"select-pane\"); i < 0 || j < 0 || i > j {\n542: \t\tt.Errorf(\"split-window (%d) must precede select-pane (%d):\\n%s\", i, j, calls)\n543: \t}\n544: }\n545: \n546: // TestLaunchTmuxPaneSecondLaunchReplacesRecordedPane: two launches through\n547: // launchTmuxPane — the second must kill the pane the first recorded (by id).\n548: // This is the case the in-memory tracking exists for: the running agent may\n549: // have overwritten the pane title in the meantime, so the tag alone could not\n550: // find it.\n551: func TestLaunchTmuxPaneSecondLaunchReplacesRecordedPane(t *testing.T) {\n552: \tstub := newTmuxStub(t)\n553: \tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n554: \ttmuxLastPaneID = \"\"\n555: \n556: \tif _, err := launchTmuxPane(\"echo one\"); err != nil {\n557: \t\tt.Fatalf(\"first launchTmuxPane: %v\", err)\n558: \t}\n559: \tfirst := tmuxLastPaneID\n560: \tif first == \"\" {\n561: \t\tt.Fatal(\"first launch did not record a pane id\")\n562: \t}\n563: \n564: \t// The old pane no longer appears tagged in list-panes (as if the running\n565: \t// agent retitled it) — only the in-memory id can find it now.\n566: \tstub.setPanes(\"%9 unrelated\")\n567: \tif _, err := launchTmuxPane(\"echo two\"); err != nil {\n568: \t\tt.Fatalf(\"second launchTmuxPane: %v\", err)\n569: \t}\n570: \tif want := \"kill-pane -t \" + first; !strings.Contains(stub.calls(), want) {\n571: \t\tt.Errorf(\"second launch did not kill the recorded pane %s:\\n%s\", first, stub.calls())\n572: \t}\n573: }\n574: \n575: // TestLaunchTmuxPaneContinuesAfterListFailure documents the best-effort\n576: // replace decision from TASK-3: a list-panes failure must not abort the new\n577: // launch — if tmux is in a state where list-panes fails, the split below will\n578: // fail with the accurate error instead.\n579: func TestLaunchTmuxPaneContinuesAfterListFailure(t *testing.T) {\n580: \tstub := newTmuxStub(t)\n581: \tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n582: \ttmuxLastPaneID = \"\"\n583: \tif err := os.Remove(stub.panes); err != nil {\n584: \t\tt.Fatal(err)\n585: \t}\n586: \n587: \tdesc, err := launchTmuxPane(\"echo hi\")\n588: \tif err != nil {\n589: \t\tt.Fatalf(\"launchTmuxPane should continue after list-panes failure, got: %v\", err)\n590: \t}\n591: \tif desc != \"tmux pane\" {\n592: \t\tt.Errorf(\"desc = %q, want %q\", desc, \"tmux pane\")\n593: \t}\n594: \tif tmuxLastPaneID == \"\" {\n595: \t\tt.Error(\"launch succeeded but no pane id was recorded\")\n596: \t}\n597: }\n598: \n599: // TestLaunchTmuxPaneSplitFailureReturnsError: a split-window failure (the\n600: // tmux server is gone, say) is surfaced as the launch error.\n601: func TestLaunchTmuxPaneSplitFailureReturnsError(t *testing.T) {\n602: \tnewTmuxStub(t) // sets up the stubbed tmux on PATH + $TMUX; no panes listed\n603: \tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n604: \ttmuxLastPaneID = \"\"\n605: \tt.Setenv(\"TMUX_STUB_SPLIT_FAIL\", \"1\")\n606: \n607: \t_, err := launchTmuxPane(\"echo hi\")\n608: \tif err == nil {\n609: \t\tt.Fatal(\"expected an error when split-window fails\")\n610: \t}\n611: \tif !strings.Contains(err.Error(), \"tmux pane\") {\n612: \t\tt.Errorf(\"error should say where the launch was attempted, got: %v\", err)\n613: \t}\n614: }\n615: \n616: // TestLaunchDetachedRoutesToTmuxPane: with $TMUX set and a tmux binary on\n617: // PATH, launchDetached (the shared tail of Agent and Quick) must route to the\n618: // synchronous tmux-pane path rather than the detached terminal-emulator tail.\n619: func TestLaunchDetachedRoutesToTmuxPane(t *testing.T) {\n620: \tstub := newTmuxStub(t)\n621: \tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n622: \ttmuxLastPaneID = \"\"\n623: \n624: \tdesc, err := launchDetached(\"echo hi\", \"\")\n625: \tif err != nil {\n626: \t\tt.Fatalf(\"launchDetached: %v\", err)\n627: \t}\n628: \tif desc != \"tmux pane\" {\n629: \t\tt.Errorf(\"desc = %q, want %q\", desc, \"tmux pane\")\n630: \t}\n631: \tif !strings.Contains(stub.calls(), \"split-window -h -l 35% -P -F #{pane_id} bash -lc echo hi\") {\n632: \t\tt.Errorf(\"tmux split-window not invoked via launchDetached:\\n%s\", stub.calls())\n633: \t}\n634: }\n635: \n636: // TestLaunchDetachedFallsBackToTerminalSetting verifies that an empty\n637: // terminal falls back to the user's configured override (TerminalSetting)\n638: // before auto-detect: with the setting naming a nonexistent binary, the\n639: // launch fails naming that binary — proving the setting was consulted and\n640: // used. The candidate table is stubbed empty so the test is hermetic on any\n641: // machine (no real terminal is ever spawned).\n642: func TestLaunchDetachedFallsBackToTerminalSetting(t *testing.T) {\n643: \tt.Setenv(\"TMUX\", \"\")\n644: \torigSetting := TerminalSetting\n645: \torigCands := terminalCandidates\n646: \tTerminalSetting = func() string { return \"definitely-not-a-terminal-9x7z\" }\n647: \tterminalCandidates = nil\n648: \tt.Cleanup(func() {\n649: \t\tTerminalSetting = origSetting\n650: \t\tterminalCandidates = origCands\n651: \t})\n652: \n653: \t_, err := launchDetached(\"echo hi\", \"\")\n654: \tif err == nil || !strings.Contains(err.Error(), \"definitely-not-a-terminal-9x7z\") {\n655: \t\tt.Errorf(\"launchDetached with an empty terminal = %v, want it to fall back to TerminalSetting\", err)\n656: \t}\n657: }\n658: \n659: // TestLaunchDetachedExplicitTerminalWinsOverSetting verifies a caller's\n660: // explicit terminal still beats the configured override.\n661: func TestLaunchDetachedExplicitTerminalWinsOverSetting(t *testing.T) {\n662: \tt.Setenv(\"TMUX\", \"\")\n663: \torigSetting := TerminalSetting\n664: \tTerminalSetting = func() string { return \"configured-terminal-9x7z\" }\n665: \tt.Cleanup(func() { TerminalSetting = origSetting })\n666: \n667: \t_, err := launchDetached(\"echo hi\", \"explicit-terminal-9x7z\")\n668: \tif err == nil || !strings.Contains(err.Error(), \"explicit-terminal-9x7z\") {\n669: \t\tt.Errorf(\"launchDetached with an explicit terminal = %v, want the explicit value to win\", err)\n670: \t}\n671: \tif strings.Contains(err.Error(), \"configured-terminal-9x7z\") {\n672: \t\tt.Errorf(\"configured override leaked through despite an explicit terminal: %v\", err)\n673: \t}\n674: }\n675: \n676: // TestLaunchTmuxPaneContinuesAfterSelectPaneFailure documents the best-effort\n677: // tagging decision from the TASK-2/TASK-3 rework: the pane is already live and\n678: // the in-memory tmuxLastPaneID covers replacement within this TUI process, so\n679: // a select-pane -T failure (the tag that would survive a TUI restart) must not\n680: // abort a launch that already succeeded.\n681: func TestLaunchTmuxPaneContinuesAfterSelectPaneFailure(t *testing.T) {\n682: \tnewTmuxStub(t) // sets up the stubbed tmux on PATH + $TMUX; no panes listed\n683: \tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n684: \ttmuxLastPaneID = \"\"\n685: \tt.Setenv(\"TMUX_STUB_SELECT_PANE_FAIL\", \"1\")\n686: \n687: \tdesc, err := launchTmuxPane(\"echo hi\")\n688: \tif err != nil {\n689: \t\tt.Fatalf(\"launchTmuxPane should continue after select-pane failure, got: %v\", err)\n690: \t}\n691: \tif desc != \"tmux pane\" {\n692: \t\tt.Errorf(\"desc = %q, want %q\", desc, \"tmux pane\")\n693: \t}\n694: \tif tmuxLastPaneID == \"\" {\n695: \t\tt.Error(\"launch succeeded but no pane id was recorded\")\n696: \t}\n697: }\n698: \n699: // TestAgentAndQuickShareOneTrackedPane is the requirement behind \"a single\n700: // shared tracked pane across both launch.Agent and launch.Quick\": a Quick\n701: // launch after an Agent launch must replace the pane the Agent opened, so at\n702: // most one manigot pane exists regardless of which entry point opened it.\n703: func TestAgentAndQuickShareOneTrackedPane(t *testing.T) {\n704: \tstub := newTmuxStub(t)\n705: \tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n706: \ttmuxLastPaneID = \"\"\n707: \n708: \t// The inner command is the running binary itself (os.Executable) — in a\n709: \t// test that's the test binary, which never actually runs because the tmux\n710: \t// stub intercepts split-window before the pane command executes.\n711: \troot := t.TempDir()\n712: \n713: \tif _, err := Agent(\"developer\", \"t5oc4j\", root, \"claude-pro\", \"\"); err != nil {\n714: \t\tt.Fatalf(\"Agent: %v\", err)\n715: \t}\n716: \tagentPane := tmuxLastPaneID\n717: \tif agentPane == \"\" {\n718: \t\tt.Fatal(\"Agent launch did not record a pane id\")\n719: \t}\n720: \n721: \tif _, err := Quick(root, \"claude-pro\", \"\"); err != nil {\n722: \t\tt.Fatalf(\"Quick: %v\", err)\n723: \t}\n724: \tif want := \"kill-pane -t \" + agentPane; !strings.Contains(stub.calls(), want) {\n725: \t\tt.Errorf(\"Quick launch did not replace the pane Agent opened (%s):\\n%s\", agentPane, stub.calls())\n726: \t}\n727: }\n728: \n729: func TestBuildCmdSmoke(t *testing.T) {\n730: \t// buildCmd must not panic and must return either a runnable command or a\n731: \t// descriptive error, depending on what is installed in this environment.\n732: \tcmd, desc, err := buildCmd(\"echo hi\", \"\")\n733: \tif err != nil {\n734: \t\tif !strings.Contains(err.Error(), \"terminal launcher\") {\n735: \t\t\tt.Errorf(\"unexpected error: %v\", err)\n736: \t\t}\n737: \t\t// desc should be empty on error.\n738: \t\tif desc != \"\" {\n739: \t\t\tt.Errorf(\"on error, desc = %q, want empty\", desc)\n740: \t\t}\n741: \t\treturn\n742: \t}\n743: \tif cmd == nil {\n744: \t\tt.Fatal(\"buildCmd returned nil cmd and nil error\")\n745: \t}\n746: \tif cmd.Path == \"\" {\n747: \t\tt.Error(\"returned cmd has empty Path\")\n748: \t}\n749: \tif desc == \"\" {\n750: \t\tt.Error(\"returned cmd has empty description\")\n751: \t}\n752: }\n753: \n754: // --- terminal override (config.Settings.Terminal, TASK-3) ------------------\n755: \n756: // stubBinary writes an executable no-op shell script at dir/name and returns\n757: // its path, so exec.LookPath(name) resolves it when dir is on $PATH.\n758: func stubBinary(t *testing.T, dir, name string) string {\n759: \tt.Helper()\n760: \tpath := filepath.Join(dir, name)\n761: \tif err := os.WriteFile(path, []byte(\"#!/bin/sh\\nexit 0\\n\"), 0o755); err != nil {\n762: \t\tt.Fatal(err)\n763: \t}\n764: \treturn path\n765: }\n766: \n767: // TestBuildCmdTmuxWinsOverOverrideInsideTmux confirms the new precedence\n768: // (TASK-2): with $TMUX set and a tmux binary on PATH, buildCmd must invoke the\n769: // tmux split-pane branch even when an override is set — the override no longer\n770: // bypasses tmux, so a session launched from a TUI inside tmux lands in a tmux\n771: // pane, never in a separate window.\n772: func TestBuildCmdTmuxWinsOverOverrideInsideTmux(t *testing.T) {\n773: \tdir := t.TempDir()\n774: \ttmuxBin := stubBinary(t, dir, \"tmux\")\n775: \tstubBinary(t, dir, \"kitty\")\n776: \tt.Setenv(\"PATH\", dir)\n777: \tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,12345,0\")\n778: \n779: \tcmd, desc, err := buildCmd(\"echo hi\", \"kitty\")\n780: \tif err != nil {\n781: \t\tt.Fatalf(\"buildCmd: %v\", err)\n782: \t}\n783: \tif desc != \"tmux pane\" {\n784: \t\tt.Errorf(\"desc = %q, want %q (tmux pane wins inside tmux)\", desc, \"tmux pane\")\n785: \t}\n786: \tif cmd.Path != tmuxBin {\n787: \t\tt.Errorf(\"cmd.Path = %q, want %q (resolved tmux binary, not the override)\", cmd.Path, tmuxBin)\n788: \t}\n789: }\n790: \n791: // TestLaunchDetachedTmuxWinsOverOverrideInsideTmux confirms the same at the\n792: // launchDetached level, which is what actually decides whether to route to\n793: // launchTmuxPane at all: with an override set, $TMUX set and a tmux binary on\n794: // PATH, the kill/split/tag sequence runs and the override is not invoked.\n795: func TestLaunchDetachedTmuxWinsOverOverrideInsideTmux(t *testing.T) {\n796: \tstub := newTmuxStub(t)\n797: \tstubBinary(t, filepath.Dir(stub.path), \"kitty\") // override on the same PATH\n798: \tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n799: \ttmuxLastPaneID = \"\"\n800: \n801: \tdesc, err := launchDetached(\"echo hi\", \"kitty\")\n802: \tif err != nil {\n803: \t\tt.Fatalf(\"launchDetached: %v\", err)\n804: \t}\n805: \tif desc != \"tmux pane\" {\n806: \t\tt.Errorf(\"desc = %q, want %q (tmux pane wins inside tmux)\", desc, \"tmux pane\")\n807: \t}\n808: \tif tmuxLastPaneID == \"\" {\n809: \t\tt.Error(\"tmux path did not run (no pane id recorded)\")\n810: \t}\n811: \tcalls := stub.calls()\n812: \tif !strings.Contains(calls, \"split-window -h -l 35% -P -F #{pane_id} bash -lc echo hi\") {\n813: \t\tt.Errorf(\"tmux split-window not invoked via launchDetached:\\n%s\", calls)\n814: \t}\n815: \tif !strings.Contains(calls, \"select-pane -t %100 -T manigot\") {\n816: \t\tt.Errorf(\"select-pane tagging of the new pane missing:\\n%s\", calls)\n817: \t}\n818: \t// The override (kitty) must not be invoked at all.\n819: \tif strings.Contains(calls, \"kitty\") {\n820: \t\tt.Errorf(\"override unexpectedly invoked inside tmux:\\n%s\", calls)\n821: \t}\n822: }\n823: \n824: // TestBuildCmdOverrideWinsOutsideTmux guards the outside-tmux precedence from\n825: // TASK-2: with an override set but the TUI NOT inside tmux ($TMUX unset),\n826: // buildCmd must still invoke the override — the r5x2a7 feature is preserved\n827: // for non-tmux users.\n828: func TestBuildCmdOverrideWinsOutsideTmux(t *testing.T) {\n829: \tdir := t.TempDir()\n830: \tstubBinary(t, dir, \"tmux\")\n831: \tkitty := stubBinary(t, dir, \"kitty\")\n832: \tt.Setenv(\"PATH\", dir)\n833: \tt.Setenv(\"TMUX\", \"\") // NOT inside tmux\n834: \n835: \tcmd, desc, err := buildCmd(\"echo hi\", \"kitty\")\n836: \tif err != nil {\n837: \t\tt.Fatalf(\"buildCmd: %v\", err)\n838: \t}\n839: \tif desc != \"kitty\" {\n840: \t\tt.Errorf(\"desc = %q, want %q (override wins outside tmux)\", desc, \"kitty\")\n841: \t}\n842: \tif cmd.Path != kitty {\n843: \t\tt.Errorf(\"cmd.Path = %q, want %q (the override binary)\", cmd.Path, kitty)\n844: \t}\n845: }\n846: \n847: // TestLaunchDetachedOverrideWinsOutsideTmux confirms the same at the\n848: // launchDetached level: with an override set and the TUI NOT inside tmux, the\n849: // override is invoked and the tmux path does not run.\n850: func TestLaunchDetachedOverrideWinsOutsideTmux(t *testing.T) {\n851: \tdir := t.TempDir()\n852: \tstubBinary(t, dir, \"tmux\")\n853: \tstubBinary(t, dir, \"kitty\")\n854: \tt.Setenv(\"PATH\", dir)\n855: \tt.Setenv(\"TMUX\", \"\") // NOT inside tmux\n856: \tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n857: \ttmuxLastPaneID = \"\"\n858: \n859: \tdesc, err := launchDetached(\"echo hi\", \"kitty\")\n860: \tif err != nil {\n861: \t\tt.Fatalf(\"launchDetached: %v\", err)\n862: \t}\n863: \tif desc != \"kitty\" {\n864: \t\tt.Errorf(\"desc = %q, want %q (override wins outside tmux)\", desc, \"kitty\")\n865: \t}\n866: \tif tmuxLastPaneID != \"\" {\n867: \t\tt.Errorf(\"tmuxLastPaneID = %q, want empty (tmux path must not have run)\", tmuxLastPaneID)\n868: \t}\n869: }\n870: \n871: // TestBuildCmdOverrideFallsThroughWhenTmuxMissing: with $TMUX set but no tmux\n872: // binary on PATH, buildCmd must fall through to the override — inside tmux\n873: // only wins when tmux is actually available.\n874: func TestBuildCmdOverrideFallsThroughWhenTmuxMissing(t *testing.T) {\n875: \tdir := t.TempDir()\n876: \tkitty := stubBinary(t, dir, \"kitty\")\n877: \tt.Setenv(\"PATH\", dir) // no tmux binary on PATH\n878: \tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,12345,0\")\n879: \n880: \tcmd, desc, err := buildCmd(\"echo hi\", \"kitty\")\n881: \tif err != nil {\n882: \t\tt.Fatalf(\"buildCmd: %v\", err)\n883: \t}\n884: \tif desc != \"kitty\" {\n885: \t\tt.Errorf(\"desc = %q, want %q (fall through to the override)\", desc, \"kitty\")\n886: \t}\n887: \tif cmd.Path != kitty {\n888: \t\tt.Errorf(\"cmd.Path = %q, want %q (the override binary)\", cmd.Path, kitty)\n889: \t}\n890: }\n891: \n892: // TestLaunchDetachedOverrideFallsThroughWhenTmuxMissing confirms the same at\n893: // the launchDetached level: with $TMUX set but no tmux binary on PATH, the\n894: // tmux branch cannot win and the override is used instead.\n895: func TestLaunchDetachedOverrideFallsThroughWhenTmuxMissing(t *testing.T) {\n896: \tdir := t.TempDir()\n897: \tstubBinary(t, dir, \"kitty\") // the override binary launchDetached will spawn\n898: \tt.Setenv(\"PATH\", dir)       // no tmux binary on PATH\n899: \tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,12345,0\")\n900: \tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n901: \ttmuxLastPaneID = \"\"\n902: \n903: \tdesc, err := launchDetached(\"echo hi\", \"kitty\")\n904: \tif err != nil {\n905: \t\tt.Fatalf(\"launchDetached: %v\", err)\n906: \t}\n907: \tif desc != \"kitty\" {\n908: \t\tt.Errorf(\"desc = %q, want %q (fall through to the override)\", desc, \"kitty\")\n909: \t}\n910: \tif tmuxLastPaneID != \"\" {\n911: \t\tt.Errorf(\"tmuxLastPaneID = %q, want empty (tmux path must not have run)\", tmuxLastPaneID)\n912: \t}\n913: }\n914: \n915: // TestBuildOverrideCmdKnownNameReusesConvention confirms an override whose\n916: // binary matches one of terminalCandidates' own names reuses that name's\n917: // existing flag convention rather than defaulting to -e (TASK-1 point 3).\n918: func TestBuildOverrideCmdKnownNameReusesConvention(t *testing.T) {\n919: \tdir := t.TempDir()\n920: \tkonsole := stubBinary(t, dir, \"konsole\")\n921: \tgnomeTerminal := stubBinary(t, dir, \"gnome-terminal\")\n922: \tt.Setenv(\"PATH\", dir)\n923: \n924: \tcmd, desc, err := buildOverrideCmd(\"echo hi\", \"konsole\")\n925: \tif err != nil {\n926: \t\tt.Fatalf(\"buildOverrideCmd: %v\", err)\n927: \t}\n928: \tif desc != \"konsole\" {\n929: \t\tt.Errorf(\"desc = %q, want %q\", desc, \"konsole\")\n930: \t}\n931: \twant := []string{\"konsole\", \"-e\", \"bash\", \"-lc\", \"echo hi\"}\n932: \tif len(cmd.Args) != len(want) {\n933: \t\tt.Fatalf(\"cmd.Args = %v, want %v\", cmd.Args, want)\n934: \t}\n935: \tfor i, a := range want {\n936: \t\tif cmd.Args[i] != a {\n937: \t\t\tt.Errorf(\"cmd.Args[%d] = %q, want %q (full: %v)\", i, cmd.Args[i], a, cmd.Args)\n938: \t\t}\n939: \t}\n940: \tif cmd.Path != konsole {\n941: \t\tt.Errorf(\"cmd.Path = %q, want %q\", cmd.Path, konsole)\n942: \t}\n943: \n944: \tcmd, desc, err = buildOverrideCmd(\"echo hi\", \"gnome-terminal\")\n945: \tif err != nil {\n946: \t\tt.Fatalf(\"buildOverrideCmd: %v\", err)\n947: \t}\n948: \tif desc != \"gnome-terminal\" {\n949: \t\tt.Errorf(\"desc = %q, want %q\", desc, \"gnome-terminal\")\n950: \t}\n951: \twant = []string{\"gnome-terminal\", \"--\", \"bash\", \"-lc\", \"echo hi\"}\n952: \tif len(cmd.Args) != len(want) {\n953: \t\tt.Fatalf(\"cmd.Args = %v, want %v\", cmd.Args, want)\n954: \t}\n955: \tfor i, a := range want {\n956: \t\tif cmd.Args[i] != a {\n957: \t\t\tt.Errorf(\"cmd.Args[%d] = %q, want %q (full: %v)\", i, cmd.Args[i], a, cmd.Args)\n958: \t\t}\n959: \t}\n960: \tif cmd.Path != gnomeTerminal {\n961: \t\tt.Errorf(\"cmd.Path = %q, want %q\", cmd.Path, gnomeTerminal)\n962: \t}\n963: }\n964: \n965: // TestBuildOverrideCmdKnownNameCaseInsensitive confirms the known-name match\n966: // is case-insensitive.\n967: func TestBuildOverrideCmdKnownNameCaseInsensitive(t *testing.T) {\n968: \tdir := t.TempDir()\n969: \tstubBinary(t, dir, \"Xterm\")\n970: \tt.Setenv(\"PATH\", dir)\n971: \n972: \tcmd, _, err := buildOverrideCmd(\"echo hi\", \"Xterm\")\n973: \tif err != nil {\n974: \t\tt.Fatalf(\"buildOverrideCmd: %v\", err)\n975: \t}\n976: \tif len(cmd.Args) < 2 || cmd.Args[1] != \"-e\" {\n977: \t\tt.Errorf(\"cmd.Args = %v, want [Xterm -e ...] (case-insensitive known-name match)\", cmd.Args)\n978: \t}\n979: }\n980: \n981: // TestBuildOverrideCmdUnknownNameDefaultsToDashE confirms an override binary\n982: // not in terminalCandidates falls back to the -e convention (TASK-1 point 3).\n983: func TestBuildOverrideCmdUnknownNameDefaultsToDashE(t *testing.T) {\n984: \tdir := t.TempDir()\n985: \tstubBinary(t, dir, \"alacritty\")\n986: \tt.Setenv(\"PATH\", dir)\n987: \n988: \tcmd, desc, err := buildOverrideCmd(\"echo hi\", \"alacritty\")\n989: \tif err != nil {\n990: \t\tt.Fatalf(\"buildOverrideCmd: %v\", err)\n991: \t}\n992: \tif desc != \"alacritty\" {\n993: \t\tt.Errorf(\"desc = %q, want %q\", desc, \"alacritty\")\n994: \t}\n995: \twant := []string{\"alacritty\", \"-e\", \"bash\", \"-lc\", \"echo hi\"}\n996: \tif len(cmd.Args) != len(want) {\n997: \t\tt.Fatalf(\"cmd.Args = %v, want %v\", cmd.Args, want)\n998: \t}\n999: \tfor i, a := range want {\n1000: \t\tif cmd.Args[i] != a {\n1001: \t\t\tt.Errorf(\"cmd.Args[%d] = %q, want %q (full: %v)\", i, cmd.Args[i], a, cmd.Args)\n1002: \t\t}\n1003: \t}\n1004: }\n1005: \n1006: // TestBuildOverrideCmdPassesLeadingArgs confirms trailing tokens in the\n1007: // override value (e.g. \"alacritty --some-flag\") are passed through as leading\n1008: // args before the flag convention, mirroring config.Settings.Editor's own\n1009: // \"trailing args\" allowance.\n1010: func TestBuildOverrideCmdPassesLeadingArgs(t *testing.T) {\n1011: \tdir := t.TempDir()\n1012: \tstubBinary(t, dir, \"alacritty\")\n1013: \tt.Setenv(\"PATH\", dir)\n1014: \n1015: \tcmd, _, err := buildOverrideCmd(\"echo hi\", \"alacritty --some-flag\")\n1016: \tif err != nil {\n1017: \t\tt.Fatalf(\"buildOverrideCmd: %v\", err)\n1018: \t}\n1019: \twant := []string{\"alacritty\", \"--some-flag\", \"-e\", \"bash\", \"-lc\", \"echo hi\"}\n1020: \tif len(cmd.Args) != len(want) {\n1021: \t\tt.Fatalf(\"cmd.Args = %v, want %v\", cmd.Args, want)\n1022: \t}\n1023: \tfor i, a := range want {\n1024: \t\tif cmd.Args[i] != a {\n1025: \t\t\tt.Errorf(\"cmd.Args[%d] = %q, want %q (full: %v)\", i, cmd.Args[i], a, cmd.Args)\n1026: \t\t}\n1027: \t}\n1028: }\n1029: \n1030: // TestBuildOverrideCmdMissingBinaryErrors confirms a typo'd/missing override\n1031: // binary surfaces a clear error instead of silently falling back to\n1032: // auto-detect (TASK-1 point 3).\n1033: func TestBuildOverrideCmdMissingBinaryErrors(t *testing.T) {\n1034: \tt.Setenv(\"PATH\", t.TempDir()) // empty PATH: nothing resolves\n1035: \n1036: \t_, _, err := buildOverrideCmd(\"echo hi\", \"not-a-real-terminal\")\n1037: \tif err == nil {\n1038: \t\tt.Fatal(\"expected an error for a missing override binary\")\n1039: \t}\n1040: \tif !strings.Contains(err.Error(), \"not-a-real-terminal\") {\n1041: \t\tt.Errorf(\"error should name the missing binary, got: %v\", err)\n1042: \t}\n1043: }\n1044: \n1045: // TestBuildCmdUnsetTerminalUnchanged is a smoke check that buildCmd with an\n1046: // empty terminal still goes through the auto-detect chain (not the override\n1047: // path) — the substantive coverage is TestBuildCmdSmoke/TestBuildCmdTmux*,\n1048: // this just confirms an empty string doesn't accidentally match\n1049: // buildOverrideCmd's \"blank\" guard as a real override.\n1050: func TestBuildCmdUnsetTerminalUnchanged(t *testing.T) {\n1051: \tcmd, desc, err := buildCmd(\"echo hi\", \"\")\n1052: \tif err != nil {\n1053: \t\tif !strings.Contains(err.Error(), \"terminal launcher\") {\n1054: \t\t\tt.Errorf(\"unexpected error for empty terminal: %v\", err)\n1055: \t\t}\n1056: \t\treturn\n1057: \t}\n1058: \tif cmd == nil || desc == \"\" {\n1059: \t\tt.Errorf(\"buildCmd with empty terminal returned incomplete result: cmd=%v desc=%q\", cmd, desc)\n1060: \t}\n1061: }\n1062: \n1063: // --- Jdi (detached, no terminal window — Decision 7a) -----------------------\n1064: \n1065: // stubJdiExe points the launch package's executable lookup at stub and\n1066: // restores it after the test.\n1067: func stubJdiExe(t *testing.T, stub string) {\n1068: \tt.Helper()\n1069: \told := JdiExe\n1070: \tJdiExe = func() (string, error) { return stub, nil }\n1071: \tt.Cleanup(func() { JdiExe = old })\n1072: }\n1073: \n1074: func TestJdiExeLookupFailure(t *testing.T) {\n1075: \told := JdiExe\n1076: \tdefer func() { JdiExe = old }()\n1077: \tJdiExe = func() (string, error) { return \"\", errors.New(\"boom\") }\n1078: \n1079: \terr := Jdi(\"ab0001_x\", t.TempDir(), \"\")\n1080: \tif err == nil || !strings.Contains(err.Error(), \"boom\") {\n1081: \t\tt.Errorf(\"expected the executable lookup error, got: %v\", err)\n1082: \t}\n1083: }\n1084: \n1085: // The jdi subcommand must be started detached (no terminal emulator involved\n1086: // at all, unlike Agent/Quick), by absolute path, in projectRoot — the same\n1087: // invocation contract the one binary's `mg jdi` subcommand satisfies.\n1088: func TestJdiStartsResolvedCommandDetached(t *testing.T) {\n1089: \troot := t.TempDir()\n1090: \tout := filepath.Join(root, \"args.txt\")\n1091: \n1092: \tstub := filepath.Join(t.TempDir(), \"stub.sh\")\n1093: \tscript := \"#!/bin/sh\\n\" +\n1094: \t\t\"{ echo \\\"argv0=$0\\\"; echo \\\"pwd=$PWD\\\"; echo \\\"cwd=$(pwd)\\\"; \" +\n1095: \t\t\"for a in \\\"$@\\\"; do echo \\\"arg=$a\\\"; done; } > \" + out + \"\\n\"\n1096: \tif err := os.WriteFile(stub, []byte(script), 0o755); err != nil {\n1097: \t\tt.Fatal(err)\n1098: \t}\n1099: \tstubJdiExe(t, stub)\n1100: \n1101: \tif err := Jdi(\"ab0001_x\", root, \"\"); err != nil {\n1102: \t\tt.Fatalf(\"Jdi: %v\", err)\n1103: \t}\n1104: \n1105: \t// Jdi starts the process detached and reaps it asynchronously — Start()\n1106: \t// only guarantees the process began, not that it has finished writing\n1107: \t// its marker file yet, so poll briefly rather than reading immediately.\n1108: \tvar raw []byte\n1109: \tdeadline := time.Now().Add(2 * time.Second)\n1110: \tfor time.Now().Before(deadline) {\n1111: \t\tif data, err := os.ReadFile(out); err == nil {\n1112: \t\t\traw = data\n1113: \t\t\tbreak\n1114: \t\t}\n1115: \t\ttime.Sleep(10 * time.Millisecond)\n1116: \t}\n1117: \tif raw == nil {\n1118: \t\tt.Fatal(\"stub did not run within the timeout\")\n1119: \t}\n1120: \n1121: \trecorded := string(raw)\n1122: \tfor _, want := range []string{\n1123: \t\t\"argv0=\" + stub, // invoked by absolute path, not by bare name\n1124: \t\t\"pwd=\" + root,   // $PWD explicitly set for job.FindProjectRoot\n1125: \t\t\"cwd=\" + root,   // and the real cwd agrees\n1126: \t\t\"arg=jdi\",       // the mg jdi subcommand\n1127: \t\t\"arg=--job\",\n1128: \t\t\"arg=ab0001_x\",\n1129: \t\t\"arg=--profile\",\n1130: \t\t\"arg=\" + config.ProfileClaudePro, // empty profile defaults to claude-pro, matching Agent/Quick\n1131: \t} {\n1132: \t\tif !strings.Contains(recorded, want) {\n1133: \t\t\tt.Errorf(\"missing %q in stub record:\\n%s\", want, recorded)\n1134: \t\t}\n1135: \t}\n1136: }\n1137: \n1138: // TestJdiForwardsGivenProfile confirms a non-empty profile (TASK-6) is\n1139: // forwarded to the mg jdi subcommand as its own --profile flag unchanged, not\n1140: // overridden by the claude-pro default TestJdiStartsResolvedCommandDetached\n1141: // exercises.\n1142: func TestJdiForwardsGivenProfile(t *testing.T) {\n1143: \troot := t.TempDir()\n1144: \tout := filepath.Join(root, \"args.txt\")\n1145: \n1146: \tstub := filepath.Join(t.TempDir(), \"stub.sh\")\n1147: \tscript := \"#!/bin/sh\\nfor a in \\\"$@\\\"; do echo \\\"arg=$a\\\"; done > \" + out + \"\\n\"\n1148: \tif err := os.WriteFile(stub, []byte(script), 0o755); err != nil {\n1149: \t\tt.Fatal(err)\n1150: \t}\n1151: \tstubJdiExe(t, stub)\n1152: \n1153: \tif err := Jdi(\"ab0001_x\", root, config.ProfileZAI); err != nil {\n1154: \t\tt.Fatalf(\"Jdi: %v\", err)\n1155: \t}\n1156: \n1157: \tvar raw []byte\n1158: \tdeadline := time.Now().Add(2 * time.Second)\n1159: \tfor time.Now().Before(deadline) {\n1160: \t\tif data, err := os.ReadFile(out); err == nil {\n1161: \t\t\traw = data\n1162: \t\t\tbreak\n1163: \t\t}\n1164: \t\ttime.Sleep(10 * time.Millisecond)\n1165: \t}\n1166: \tif raw == nil {\n1167: \t\tt.Fatal(\"stub did not run within the timeout\")\n1168: \t}\n1169: \n1170: \trecorded := string(raw)\n1171: \tfor _, want := range []string{\"arg=--profile\", \"arg=\" + config.ProfileZAI} {\n1172: \t\tif !strings.Contains(recorded, want) {\n1173: \t\t\tt.Errorf(\"missing %q in stub record:\\n%s\", want, recorded)\n1174: \t\t}\n1175: \t}\n1176: }\n1177: \n1178: // --- tig (diff browsing) launcher -------------------------------------------\n1179: \n1180: // stubTigLookPath points the launch package's tig lookup at fn and restores\n1181: // it after the test, so tig availability can be controlled without a real\n1182: // tig on the test machine.\n1183: func stubTigLookPath(t *testing.T, fn func(string) (string, error)) {\n1184: \tt.Helper()\n1185: \told := TigLookPath\n1186: \tTigLookPath = fn\n1187: \tt.Cleanup(func() { TigLookPath = old })\n1188: }\n1189: \n1190: func TestTigShellCommandFormat(t *testing.T) {\n1191: \tgot := tigShellCommand(\"/usr/local/bin/manigot\", \"term_tig-in-tui\", \"/home/me/proj\")\n1192: \twantInner := \"cd '/home/me/proj' && '/usr/local/bin/manigot' diff 'term_tig-in-tui' --tig\"\n1193: \tif !strings.HasPrefix(got, wantInner) {\n1194: \t\tt.Errorf(\"tigShellCommand =\\n %q\\nwant prefix\\n %q\", got, wantInner)\n1195: \t}\n1196: \t// The inner command must be wrapped so a failure holds the window open,\n1197: \t// exactly like every other launch path.\n1198: \tif got != holdOnFailure(wantInner) {\n1199: \t\tt.Errorf(\"tigShellCommand does not wrap its inner command with holdOnFailure:\\n%q\", got)\n1200: \t}\n1201: }\n1202: \n1203: // A tig launch must never carry --profile, --agent or --job — `mg diff`\n1204: // takes none of them (it is a host git command, not a session launch).\n1205: func TestTigShellCommandOmitsSessionFlags(t *testing.T) {\n1206: \tgot := tigShellCommand(\"/usr/local/bin/manigot\", \"term_tig-in-tui\", \"/home/me/proj\")\n1207: \tfor _, flag := range []string{\"--profile\", \"--agent\", \"--job\"} {\n1208: \t\tif strings.Contains(got, flag) {\n1209: \t\t\tt.Errorf(\"tigShellCommand unexpectedly contains %s: %q\", flag, got)\n1210: \t\t}\n1211: \t}\n1212: }\n1213: \n1214: // A checkout in a directory with spaces must still produce a single word for\n1215: // the manigot path, since the string is re-parsed by osascript / bash -lc.\n1216: func TestTigShellCommandQuotesPathWithSpaces(t *testing.T) {\n1217: \tgot := tigShellCommand(\"/Users/me/My Projects/manigot/scripts/run.sh\", \"term_tig-in-tui\", \"/tmp/p\")\n1218: \tif !strings.Contains(got, `'/Users/me/My Projects/manigot/scripts/run.sh'`) {\n1219: \t\tt.Errorf(\"manigot path not quoted as one word in %q\", got)\n1220: \t}\n1221: }\n1222: \n1223: // Embedded quotes in either value must be escaped, not close the quote.\n1224: func TestTigShellCommandQuoteEscape(t *testing.T) {\n1225: \tgot := tigShellCommand(\"/bin/manigot\", \"a'b\", \"/path/with'quote\")\n1226: \tif !strings.Contains(got, `'/path/with'\\''quote'`) {\n1227: \t\tt.Errorf(\"root quote not escaped in %q\", got)\n1228: \t}\n1229: \tif !strings.Contains(got, `'a'\\''b'`) {\n1230: \t\tt.Errorf(\"jobID quote not escaped in %q\", got)\n1231: \t}\n1232: }\n1233: \n1234: func TestTigAvailableTrueWhenTigResolves(t *testing.T) {\n1235: \tstubTigLookPath(t, func(name string) (string, error) {\n1236: \t\tif name != \"tig\" {\n1237: \t\t\tt.Errorf(\"TigLookPath called with %q, want %q\", name, \"tig\")\n1238: \t\t}\n1239: \t\treturn \"/usr/bin/tig\", nil\n1240: \t})\n1241: \tif !TigAvailable() {\n1242: \t\tt.Error(\"TigAvailable() = false, want true when tig resolves\")\n1243: \t}\n1244: }\n1245: \n1246: func TestTigAvailableFalseWhenTigMissing(t *testing.T) {\n1247: \tstubTigLookPath(t, func(name string) (string, error) {\n1248: \t\treturn \"\", exec.ErrNotFound\n1249: \t})\n1250: \tif TigAvailable() {\n1251: \t\tt.Error(\"TigAvailable() = true, want false when tig does not resolve\")\n1252: \t}\n1253: }\n1254: \n1255: // TestTigMissingErrorsBeforeSpawn: with tig unresolvable, Tig must return the\n1256: // not-installed error synchronously without consulting ExeOverride at all —\n1257: // the availability check is the authoritative backstop that runs first, so a\n1258: // stale cached gate can never open a doomed pane. ExeOverride is pointed at a\n1259: // marker that fails loudly: reaching it would change the error.\n1260: func TestTigMissingErrorsBeforeSpawn(t *testing.T) {\n1261: \tstubTigLookPath(t, func(name string) (string, error) {\n1262: \t\treturn \"\", exec.ErrNotFound\n1263: \t})\n1264: \told := ExeOverride\n1265: \tt.Cleanup(func() { ExeOverride = old })\n1266: \tExeOverride = func() (string, error) { return \"\", errors.New(\"exe override should not be consulted\") }\n1267: \n1268: \t_, err := Tig(\"term_tig-in-tui\", t.TempDir(), \"\")\n1269: \tif err == nil || !strings.Contains(err.Error(), \"tig is not installed\") {\n1270: \t\tt.Errorf(\"Tig with tig missing = %v, want the not-installed error\", err)\n1271: \t}\n1272: }\n1273: \n1274: // TestTigExeOverrideFailure: with tig available but the mg binary unresolvable\n1275: // (ExeOverride fails), Tig must surface that resolution error — mirroring\n1276: // Agent/Quick's own \"locate mg binary\" error path.\n1277: func TestTigExeOverrideFailure(t *testing.T) {\n1278: \tstubTigLookPath(t, func(name string) (string, error) {\n1279: \t\treturn \"/usr/bin/tig\", nil\n1280: \t})\n1281: \told := ExeOverride\n1282: \tt.Cleanup(func() { ExeOverride = old })\n1283: \tExeOverride = func() (string, error) { return \"\", errors.New(\"boom\") }\n1284: \n1285: \t_, err := Tig(\"term_tig-in-tui\", t.TempDir(), \"\")\n1286: \tif err == nil || !strings.Contains(err.Error(), \"boom\") {\n1287: \t\tt.Errorf(\"Tig with ExeOverride failure = %v, want the resolution error\", err)\n1288: \t}\n1289: }\n1290: \n1291: // TestTigSuccessThroughTmuxStub exercises the full Tig launch through the\n1292: // existing tmuxStub, mirroring TestAgentAndQuickShareOneTrackedPane: with\n1293: // $TMUX set and a stubbed tmux on PATH, the split-window invocation must carry\n1294: // the tig inner command, the pane must be tagged/recorded, and the returned\n1295: // description must be \"tmux pane\".\n1296: func TestTigSuccessThroughTmuxStub(t *testing.T) {\n1297: \tstub := newTmuxStub(t)\n1298: \tstubTigLookPath(t, func(name string) (string, error) {\n1299: \t\treturn \"/usr/bin/tig\", nil\n1300: \t})\n1301: \tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n1302: \ttmuxLastPaneID = \"\"\n1303: \n1304: \troot := t.TempDir()\n1305: \tdesc, err := Tig(\"t5oc4j\", root, \"\")\n1306: \tif err != nil {\n1307: \t\tt.Fatalf(\"Tig: %v\", err)\n1308: \t}\n1309: \tif desc != \"tmux pane\" {\n1310: \t\tt.Errorf(\"desc = %q, want %q\", desc, \"tmux pane\")\n1311: \t}\n1312: \tif tmuxLastPaneID == \"\" {\n1313: \t\tt.Error(\"Tig launch did not record a pane id\")\n1314: \t}\n1315: \tcalls := stub.calls()\n1316: \tif !strings.Contains(calls, \"diff 't5oc4j' --tig\") {\n1317: \t\tt.Errorf(\"tmux split-window not invoked with the tig inner command:\\n%s\", calls)\n1318: \t}\n1319: \tif !strings.Contains(calls, \"select-pane -t %100 -T manigot\") {\n\n(Output capped at 50 KB. Showing lines 1-1319. Use offset=1320 to continue.)\n</content>","metadata":{"preview":"package launch\n\nimport (\n\t\"errors\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n)\n\nfunc TestShellCommandFormat(t *testing.T) {\n\tgot := shellCommand(\"/usr/local/bin/manigot\", \"developer\", \"irw320\", \"/home/me/proj\", \"claude-pro\")\n\twantInner := \"cd '/home/me/proj' && '/usr/local/bin/manigot' --profile 'claude-pro' --agent 'developer' --job 'irw320'\"\n\tif !strings.HasPrefix(got, wantInner) {\n\t\tt.Errorf(\"shellCommand =\\n %q\\nwant prefix\\n %q\", got, wantInner)\n\t}","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/launch/launch_test.go","text":"package launch\n\nimport (\n\t\"errors\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n)\n\nfunc TestShellCommandFormat(t *testing.T) {\n\tgot := shellCommand(\"/usr/local/bin/manigot\", \"developer\", \"irw320\", \"/home/me/proj\", \"claude-pro\")\n\twantInner := \"cd '/home/me/proj' && '/usr/local/bin/manigot' --profile 'claude-pro' --agent 'developer' --job 'irw320'\"\n\tif !strings.HasPrefix(got, wantInner) {\n\t\tt.Errorf(\"shellCommand =\\n %q\\nwant prefix\\n %q\", got, wantInner)\n\t}\n\t// The inner command must be wrapped so a failure holds the window open\n\t// (TASK-6) rather than the terminal closing immediately.\n\tif got != holdOnFailure(wantInner) {\n\t\tt.Errorf(\"shellCommand does not wrap its inner command with holdOnFailure:\\n%q\", got)\n\t}\n}\n\n// --- quick (bare-session) launcher ------------------------------------------\n\nfunc TestQuickShellCommandFormat(t *testing.T) {\n\tgot := quickShellCommand(\"/usr/local/bin/manigot\", \"/home/me/proj\", \"claude-pro\")\n\twantInner := \"cd '/home/me/proj' && '/usr/local/bin/manigot' --profile 'claude-pro'\"\n\tif !strings.HasPrefix(got, wantInner) {\n\t\tt.Errorf(\"quickShellCommand =\\n %q\\nwant prefix\\n %q\", got, wantInner)\n\t}\n\t// Must be wrapped by holdOnFailure, exactly like the agent path.\n\tif got != holdOnFailure(wantInner) {\n\t\tt.Errorf(\"quickShellCommand does not wrap its inner command with holdOnFailure:\\n%q\", got)\n\t}\n}\n\n// A bare session must never carry --agent or --job — that's the whole point of\n// the quick launch path.\nfunc TestQuickShellCommandOmitsAgentAndJob(t *testing.T) {\n\tgot := quickShellCommand(\"/usr/local/bin/manigot\", \"/home/me/proj\", \"claude-pro\")\n\tif strings.Contains(got, \"--agent\") {\n\t\tt.Errorf(\"quickShellCommand unexpectedly contains --agent: %q\", got)\n\t}\n\tif strings.Contains(got, \"--job\") {\n\t\tt.Errorf(\"quickShellCommand unexpectedly contains --job: %q\", got)\n\t}\n}\n\n// An empty profile must default to claude-pro, mirroring the agent path and\n// scripts/run.sh's own default.\nfunc TestQuickShellCommandDefaultsEmptyProfile(t *testing.T) {\n\tgot := quickShellCommand(\"/bin/manigot\", \"/home/me/proj\", \"\")\n\tif !strings.Contains(got, \"--profile 'claude-pro'\") {\n\t\tt.Errorf(\"quickShellCommand with empty profile = %q, want it to default to claude-pro\", got)\n\t}\n}\n\nfunc TestQuickShellCommandPassesZAIProfile(t *testing.T) {\n\tgot := quickShellCommand(\"/bin/manigot\", \"/home/me/proj\", \"zai\")\n\tif !strings.Contains(got, \"--profile 'zai'\") {\n\t\tt.Errorf(\"quickShellCommand with zai profile = %q, want --profile 'zai'\", got)\n\t}\n}\n\n// A checkout in a directory with spaces must still produce a single word for\n// the manigot path, since the string is re-parsed by osascript / bash -lc.\nfunc TestQuickShellCommandQuotesPathWithSpaces(t *testing.T) {\n\tgot := quickShellCommand(\"/Users/me/My Projects/manigot/scripts/run.sh\", \"/tmp/p\", \"claude-pro\")\n\tif !strings.Contains(got, `'/Users/me/My Projects/manigot/scripts/run.sh'`) {\n\t\tt.Errorf(\"manigot path not quoted as one word in %q\", got)\n\t}\n}\n\n// --- agent-quick (jobless agent session) launcher ---------------------------\n\nfunc TestAgentQuickShellCommandFormat(t *testing.T) {\n\tgot := agentQuickShellCommand(\"/usr/local/bin/manigot\", \"developer\", \"/home/me/proj\", \"claude-pro\")\n\twantInner := \"cd '/home/me/proj' && '/usr/local/bin/manigot' --profile 'claude-pro' --agent 'developer'\"\n\tif !strings.HasPrefix(got, wantInner) {\n\t\tt.Errorf(\"agentQuickShellCommand =\\n %q\\nwant prefix\\n %q\", got, wantInner)\n\t}\n\t// Must be wrapped by holdOnFailure, exactly like the other launch paths.\n\tif got != holdOnFailure(wantInner) {\n\t\tt.Errorf(\"agentQuickShellCommand does not wrap its inner command with holdOnFailure:\\n%q\", got)\n\t}\n}\n\n// An agent-quick session must never carry --job — that's what distinguishes\n// it from the job-scoped Agent launch path.\nfunc TestAgentQuickShellCommandOmitsJob(t *testing.T) {\n\tgot := agentQuickShellCommand(\"/usr/local/bin/manigot\", \"developer\", \"/home/me/proj\", \"claude-pro\")\n\tif strings.Contains(got, \"--job\") {\n\t\tt.Errorf(\"agentQuickShellCommand unexpectedly contains --job: %q\", got)\n\t}\n}\n\nfunc TestAgentQuickShellCommandDefaultsEmptyProfile(t *testing.T) {\n\tgot := agentQuickShellCommand(\"/bin/manigot\", \"developer\", \"/home/me/proj\", \"\")\n\tif !strings.Contains(got, \"--profile 'claude-pro'\") {\n\t\tt.Errorf(\"agentQuickShellCommand with empty profile = %q, want it to default to claude-pro\", got)\n\t}\n}\n\nfunc TestAgentQuickShellCommandPassesZAIProfile(t *testing.T) {\n\tgot := agentQuickShellCommand(\"/bin/manigot\", \"developer\", \"/home/me/proj\", \"zai\")\n\tif !strings.Contains(got, \"--profile 'zai'\") {\n\t\tt.Errorf(\"agentQuickShellCommand with zai profile = %q, want --profile 'zai'\", got)\n\t}\n}\n\n// A checkout in a directory with spaces must still produce a single word for\n// the manigot path, since the string is re-parsed by osascript / bash -lc.\nfunc TestAgentQuickShellCommandQuotesPathWithSpaces(t *testing.T) {\n\tgot := agentQuickShellCommand(\"/Users/me/My Projects/manigot/scripts/run.sh\", \"developer\", \"/tmp/p\", \"claude-pro\")\n\tif !strings.Contains(got, `'/Users/me/My Projects/manigot/scripts/run.sh'`) {\n\t\tt.Errorf(\"manigot path not quoted as one word in %q\", got)\n\t}\n}\n\n// --- host-agent (host-mode agent session with an explicit prompt) -----------\n\nfunc TestHostAgentShellCommandFormat(t *testing.T) {\n\tgot := hostAgentShellCommand(\"/usr/local/bin/manigot\", \"git-solver\", \"resolve the conflict\", \"/home/me/proj\", \"claude-pro\")\n\twantInner := \"cd '/home/me/proj' && '/usr/local/bin/manigot' host --profile 'claude-pro' --agent 'git-solver' --prompt 'resolve the conflict'\"\n\tif !strings.HasPrefix(got, wantInner) {\n\t\tt.Errorf(\"hostAgentShellCommand =\\n %q\\nwant prefix\\n %q\", got, wantInner)\n\t}\n\t// Must be wrapped by holdOnFailure, exactly like the other launch paths.\n\tif got != holdOnFailure(wantInner) {\n\t\tt.Errorf(\"hostAgentShellCommand does not wrap its inner command with holdOnFailure:\\n%q\", got)\n\t}\n}\n\n// A host-mode session must never carry --job: it runs against the project\n// root itself (where the failed merge lives), not a job worktree.\nfunc TestHostAgentShellCommandOmitsJob(t *testing.T) {\n\tgot := hostAgentShellCommand(\"/usr/local/bin/manigot\", \"git-solver\", \"p\", \"/home/me/proj\", \"claude-pro\")\n\tif strings.Contains(got, \"--job\") {\n\t\tt.Errorf(\"hostAgentShellCommand unexpectedly contains --job: %q\", got)\n\t}\n}\n\nfunc TestHostAgentShellCommandDefaultsEmptyProfile(t *testing.T) {\n\tgot := hostAgentShellCommand(\"/bin/manigot\", \"git-solver\", \"p\", \"/home/me/proj\", \"\")\n\tif !strings.Contains(got, \"--profile 'claude-pro'\") {\n\t\tt.Errorf(\"hostAgentShellCommand with empty profile = %q, want it to default to claude-pro\", got)\n\t}\n}\n\nfunc TestHostAgentShellCommandPassesZAIProfile(t *testing.T) {\n\tgot := hostAgentShellCommand(\"/bin/manigot\", \"git-solver\", \"p\", \"/home/me/proj\", \"zai\")\n\tif !strings.Contains(got, \"--profile 'zai'\") {\n\t\tt.Errorf(\"hostAgentShellCommand with zai profile = %q, want --profile 'zai'\", got)\n\t}\n}\n\n// The prompt is a free-form sentence with quotes/parens — it must survive as\n// a single quoted word so the session launcher receives it verbatim.\nfunc TestHostAgentShellCommandQuotesPrompt(t *testing.T) {\n\tprompt := `An interrupted mg done: merge feature/ab12cd_x into main (conflicted). \"Don't push.\"`\n\tgot := hostAgentShellCommand(\"/bin/manigot\", \"git-solver\", prompt, \"/home/me/proj\", \"claude-pro\")\n\tif !strings.Contains(got, \"--prompt 'An interrupted mg done: merge feature/ab12cd_x into main (conflicted). \\\"Don'\\\\''t push.\\\"'\") {\n\t\tt.Errorf(\"prompt not quoted as one word in %q\", got)\n\t}\n}\n\n// A checkout in a directory with spaces must still produce a single word for\n// the manigot path, since the string is re-parsed by osascript / bash -lc.\nfunc TestHostAgentShellCommandQuotesPathWithSpaces(t *testing.T) {\n\tgot := hostAgentShellCommand(\"/Users/me/My Projects/manigot/scripts/run.sh\", \"git-solver\", \"p\", \"/tmp/p\", \"claude-pro\")\n\tif !strings.Contains(got, `'/Users/me/My Projects/manigot/scripts/run.sh'`) {\n\t\tt.Errorf(\"manigot path not quoted as one word in %q\", got)\n\t}\n}\n\n// An empty profile must default to claude-pro, matching scripts/run.sh's own\n// default, rather than passing an empty --profile value through.\nfunc TestShellCommandDefaultsEmptyProfile(t *testing.T) {\n\tgot := shellCommand(\"/bin/manigot\", \"developer\", \"irw320\", \"/home/me/proj\", \"\")\n\tif !strings.Contains(got, \"--profile 'claude-pro'\") {\n\t\tt.Errorf(\"shellCommand with empty profile = %q, want it to default to claude-pro\", got)\n\t}\n}\n\nfunc TestShellCommandPassesZAIProfile(t *testing.T) {\n\tgot := shellCommand(\"/bin/manigot\", \"developer\", \"irw320\", \"/home/me/proj\", \"zai\")\n\tif !strings.Contains(got, \"--profile 'zai'\") {\n\t\tt.Errorf(\"shellCommand with zai profile = %q, want --profile 'zai'\", got)\n\t}\n}\n\n// TestHoldOnFailureExitsCleanlyOnSuccess documents the intended shape of the\n// wrapper: it must not alter the wrapped command itself, only append\n// exit-code-conditional hold logic after it.\nfunc TestHoldOnFailureExitsCleanlyOnSuccess(t *testing.T) {\n\tgot := holdOnFailure(\"true\")\n\tif !strings.HasPrefix(got, \"true;\") {\n\t\tt.Errorf(\"holdOnFailure should prefix the wrapped command unchanged, got %q\", got)\n\t}\n\tif !strings.Contains(got, `ec=$?`) {\n\t\tt.Errorf(\"holdOnFailure should capture the exit code, got %q\", got)\n\t}\n\tif !strings.Contains(got, `if [ \"$ec\" -ne 0 ]`) {\n\t\tt.Errorf(\"holdOnFailure should only hold on a non-zero exit, got %q\", got)\n\t}\n\tif !strings.Contains(got, `exit \"$ec\"`) {\n\t\tt.Errorf(\"holdOnFailure should preserve the original exit code, got %q\", got)\n\t}\n}\n\n// A checkout in a directory with spaces must still produce a single word for\n// the manigot path, since the string is re-parsed by osascript / bash -lc.\nfunc TestShellCommandQuotesPathWithSpaces(t *testing.T) {\n\tgot := shellCommand(\"/Users/me/My Projects/manigot/scripts/run.sh\", \"reviewer\", \"abc123\", \"/tmp/p\", \"claude-code\")\n\tif !strings.Contains(got, `'/Users/me/My Projects/manigot/scripts/run.sh'`) {\n\t\tt.Errorf(\"manigot path not quoted as one word in %q\", got)\n\t}\n}\n\nfunc TestShellQuote(t *testing.T) {\n\tcases := map[string]string{\n\t\t\"\":           \"''\",\n\t\t\"plain\":      \"'plain'\",\n\t\t\"with space\": \"'with space'\",\n\t\t\"a'b\":        \"'a'\\\\''b'\", // embedded quote escaped via '\\''\n\t\t`back\\slash`: `'back\\slash'`,\n\t}\n\tfor in, want := range cases {\n\t\tgot := shellQuote(in)\n\t\tif got != want {\n\t\t\tt.Errorf(\"shellQuote(%q) = %q, want %q\", in, got, want)\n\t\t}\n\t}\n}\n\n// TestShellQuoteNeutralizesInjection ensures a value engineered to break out of\n// its quotes cannot inject shell metacharacters: after quoting, the dangerous\n// substring must be contained inside the escaped sequence, not terminate the\n// outer single-quoted word.\nfunc TestShellQuoteNeutralizesInjection(t *testing.T) {\n\tmal := \"'; rm -rf /; '\"\n\tq := shellQuote(mal)\n\t// The result must start and end with a single quote and contain no raw\n\t// unescaped \"; rm -rf\" outside of quotes — i.e. the only way \"rm\" appears\n\t// is inside the escaped inner segment.\n\tif !strings.HasPrefix(q, \"'\") || !strings.HasSuffix(q, \"'\") {\n\t\tt.Fatalf(\"quoted value not single-quote wrapped: %q\", q)\n\t}\n\t// Re-splitting on the escape idiom, no segment should be a bare shell\n\t// command. Concretely: there must be no occurrence of \"; '\" (close+open\n\t// without the escape) which would indicate breakout.\n\tif strings.Contains(q, \"; '\") && !strings.Contains(q, `'\\''`) {\n\t\tt.Errorf(\"quoting allowed breakout in %q\", q)\n\t}\n\t// And the canonical escaped form must be present.\n\tif !strings.Contains(q, `'\\''`) {\n\t\tt.Errorf(\"expected the \\\\'' escape idiom in %q\", q)\n\t}\n}\n\nfunc TestShellCommandQuoteEscape(t *testing.T) {\n\t// A projectRoot with a quote still ends up as one safe argument.\n\tgot := shellCommand(\"/bin/manigot\", \"a\", \"b\", \"/path/with'quote\", \"claude-pro\")\n\t// The root must appear escaped, not as a raw close-quote.\n\tif !strings.Contains(got, `'/path/with'\\''quote'`) {\n\t\tt.Errorf(\"root quote not escaped in %q\", got)\n\t}\n}\n\n// --- tmux split-pane construction (TASK-2) -----------------------------\n\n// TestBuildCmdTmuxUsesSplitWindow confirms buildCmd's tmux branch runs\n// `tmux split-window -h -l 35%` (side-by-side, new pane sized to 35% of the\n// window so the TUI's own pane keeps the majority share — TASK-1 scope\n// decision) rather than `tmux new-window`, and describes the result as a\n// \"tmux pane\". The -P -F '#{pane_id}' flags are TASK-3's replace-policy\n// plumbing: they make the split-window client print the new pane's id, which\n// launchTmuxPane records and tags (select-pane -T — split-window itself has\n// no -T on any released tmux, so tagging is deliberately not constructed\n// here). This only exercises the command *construction*; it stubs `tmux` on\n// PATH rather than running a real tmux server, so it cannot verify the pane\n// actually lands next to the TUI at runtime — see TASK-2's own risk note and\n// TASK-4/TASK-5's manual-verification caveat for that gap.\nfunc TestBuildCmdTmuxUsesSplitWindow(t *testing.T) {\n\tdir := t.TempDir()\n\tstub := filepath.Join(dir, \"tmux\")\n\tif err := os.WriteFile(stub, []byte(\"#!/bin/sh\\nexit 0\\n\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Setenv(\"PATH\", dir)\n\tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,12345,0\")\n\n\tcmd, desc, err := buildCmd(\"echo hi\", \"\")\n\tif err != nil {\n\t\tt.Fatalf(\"buildCmd: %v\", err)\n\t}\n\tif desc != \"tmux pane\" {\n\t\tt.Errorf(\"desc = %q, want %q\", desc, \"tmux pane\")\n\t}\n\tif cmd.Path != stub {\n\t\tt.Errorf(\"cmd.Path = %q, want %q (resolved tmux binary)\", cmd.Path, stub)\n\t}\n\twant := []string{\"tmux\", \"split-window\", \"-h\", \"-l\", \"35%\", \"-P\", \"-F\", \"#{pane_id}\", \"bash\", \"-lc\", \"echo hi\"}\n\tif len(cmd.Args) != len(want) {\n\t\tt.Fatalf(\"cmd.Args = %v, want %v\", cmd.Args, want)\n\t}\n\tfor i, a := range want {\n\t\tif cmd.Args[i] != a {\n\t\t\tt.Errorf(\"cmd.Args[%d] = %q, want %q (full: %v)\", i, cmd.Args[i], a, cmd.Args)\n\t\t}\n\t}\n}\n\n// --- tmux replace/reuse tracking (TASK-3, TASK-5) ----------------------\n\n// tmuxStub is a fake `tmux` binary used to exercise the replace/reuse\n// tracking logic without a real tmux server. It records every invocation to a\n// log file (so tests can assert both the content and the order of the commands\n// manigot *runs*) and answers like a minimal tmux:\n//\n//   - list-panes prints the contents of panesFile verbatim — each line is one\n//     \"<pane_id> <pane_title>\", matching what `list-panes -s -F '#{pane_id}\n//     #{pane_title}'` prints in a real tmux.\n//   - split-window prints the next \"%N\" pane id (from an incrementing\n//     counterFile, starting at %100 so ids never collide with the listed\n//     panes), matching what `-P -F '#{pane_id}'` prints for a real split.\n//   - select-pane does nothing, unless TMUX_STUB_SELECT_PANE_FAIL (exit 1 —\n//     the \"tagging failed but the pane is live\" case) is set.\n//   - kill-pane does nothing, unless TMUX_STUB_KILL_FAIL (exit 1 — the \"user\n//     already closed the pane\" case) or TMUX_STUB_SPLIT_FAIL (exit 1 — the\n//     \"tmux is broken\" case for split-window) is set.\n//\n// Like the existing TestJdiStartsResolvedCommandDetached stub, this can only\n// confirm that the commands manigot runs are the right ones — real tmux\n// session behavior (actual pane creation/listing/killing) cannot be verified\n// without a live tmux server, which this environment does not have (TASK-5\n// risk note).\ntype tmuxStub struct {\n\tlog     string\n\tpanes   string\n\tcounter string\n\tpath    string\n}\n\nfunc newTmuxStub(t *testing.T) *tmuxStub {\n\tt.Helper()\n\tdir := t.TempDir()\n\ts := &tmuxStub{\n\t\tlog:     filepath.Join(dir, \"calls.log\"),\n\t\tpanes:   filepath.Join(dir, \"panes.txt\"),\n\t\tcounter: filepath.Join(dir, \"counter.txt\"),\n\t\tpath:    filepath.Join(dir, \"tmux\"),\n\t}\n\tscript := \"#!/bin/sh\\n\" +\n\t\t\"echo \\\"$@\\\" >> '\" + s.log + \"'\\n\" +\n\t\t\"case \\\"$1\\\" in\\n\" +\n\t\t// Only shell builtins below: PATH is set to the stub dir alone (so\n\t\t// exec.LookPath(\"tmux\") resolves the stub, not a real tmux), so any\n\t\t// external command would not be found.\n\t\t\"  list-panes) while read -r line; do echo \\\"$line\\\"; done < '\" + s.panes + \"' ;;\\n\" +\n\t\t\"  split-window) [ -n \\\"$TMUX_STUB_SPLIT_FAIL\\\" ] && exit 1; n=0; [ -f '\" + s.counter + \"' ] && read -r n < '\" + s.counter + \"'; n=$((n+1)); echo \\\"$n\\\" > '\" + s.counter + \"'; echo \\\"%$n\\\" ;;\\n\" +\n\t\t\"  kill-pane) [ -n \\\"$TMUX_STUB_KILL_FAIL\\\" ] && exit 1 ;;\\n\" +\n\t\t\"  select-pane) [ -n \\\"$TMUX_STUB_SELECT_PANE_FAIL\\\" ] && exit 1 ;;\\n\" +\n\t\t\"esac\\n\"\n\tif err := os.WriteFile(s.path, []byte(script), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// Empty panes file (list-panes succeeds but lists nothing) and a counter\n\t// starting at 99, so the first split prints %100 — never colliding with\n\t// the small ids tests use for the panes they list.\n\tif err := os.WriteFile(s.panes, nil, 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(s.counter, []byte(\"99\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Setenv(\"PATH\", dir)\n\tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,12345,0\")\n\treturn s\n}\n\n// setPanes replaces the pane listing list-panes will print. Each line is one\n// pane: \"<pane_id> <pane_title>\".\nfunc (s *tmuxStub) setPanes(lines ...string) {\n\tcontent := strings.Join(lines, \"\\n\")\n\tif content != \"\" {\n\t\tcontent += \"\\n\"\n\t}\n\tif err := os.WriteFile(s.panes, []byte(content), 0o644); err != nil {\n\t\tpanic(err)\n\t}\n}\n\n// calls returns the recorded invocation log, one `tmux ...` line per call.\nfunc (s *tmuxStub) calls() string {\n\traw, err := os.ReadFile(s.log)\n\tif err != nil {\n\t\treturn \"\"\n\t}\n\treturn string(raw)\n}\n\n// indexCalls returns the byte offset of needle in the invocation log, or -1.\nfunc (s *tmuxStub) indexCalls(needle string) int {\n\treturn strings.Index(s.calls(), needle)\n}\n\n// TestKillPreviousTmuxPaneKillsTrackedAndTaggedOnly is the core safety test\n// for the replace policy's \"must never kill a pane it didn't itself open\":\n// the previously tracked pane id and every pane whose title is tmuxPaneTag\n// are killed, and nothing else in the session is touched.\nfunc TestKillPreviousTmuxPaneKillsTrackedAndTaggedOnly(t *testing.T) {\n\tstub := newTmuxStub(t)\n\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n\ttmuxLastPaneID = \"%1\" // tracked from a previous launch in this TUI process\n\tstub.setPanes(\n\t\t\"%2 \"+tmuxPaneTag, // tagged — must be killed\n\t\t\"%3 other pane\",   // untagged — must be left alone\n\t\t\"%4\",              // no title at all — must be left alone\n\t)\n\n\tif err := killPreviousTmuxPane(); err != nil {\n\t\tt.Fatalf(\"killPreviousTmuxPane: %v\", err)\n\t}\n\tcalls := stub.calls()\n\tfor _, want := range []string{\n\t\t\"list-panes -s -F #{pane_id} #{pane_title}\",\n\t\t\"kill-pane -t %1\",\n\t\t\"kill-pane -t %2\",\n\t} {\n\t\tif !strings.Contains(calls, want) {\n\t\t\tt.Errorf(\"missing %q in stub call log:\\n%s\", want, calls)\n\t\t}\n\t}\n\tfor _, not := range []string{\"kill-pane -t %3\", \"kill-pane -t %4\"} {\n\t\tif strings.Contains(calls, not) {\n\t\t\tt.Errorf(\"unexpectedly killed a pane manigot did not open (%q):\\n%s\", not, calls)\n\t\t}\n\t}\n}\n\n// TestKillPreviousTmuxPaneSkipsWhenNothingToReplace: with no tracked pane and\n// no tagged pane in the session, replace must be a complete no-op — not a\n// single kill-pane. Also exercises the empty list-panes output edge case.\nfunc TestKillPreviousTmuxPaneSkipsWhenNothingToReplace(t *testing.T) {\n\tstub := newTmuxStub(t)\n\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n\ttmuxLastPaneID = \"\"\n\tstub.setPanes(\"%9 unrelated\")\n\n\tif err := killPreviousTmuxPane(); err != nil {\n\t\tt.Fatalf(\"killPreviousTmuxPane: %v\", err)\n\t}\n\tif strings.Contains(stub.calls(), \"kill-pane\") {\n\t\tt.Errorf(\"kill-pane called with nothing to replace:\\n%s\", stub.calls())\n\t}\n}\n\n// TestKillPreviousTmuxPaneToleratesAlreadyClosedPane: a kill-pane failure\n// (the user closed the pane themselves in the meantime) is not an error — it\n// is the tolerated no-op case from TASK-3.\nfunc TestKillPreviousTmuxPaneToleratesAlreadyClosedPane(t *testing.T) {\n\tnewTmuxStub(t) // sets up the stubbed tmux on PATH + $TMUX; no panes listed\n\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n\ttmuxLastPaneID = \"%1\"\n\tt.Setenv(\"TMUX_STUB_KILL_FAIL\", \"1\")\n\n\tif err := killPreviousTmuxPane(); err != nil {\n\t\tt.Fatalf(\"killPreviousTmuxPane should tolerate a missing pane, got: %v\", err)\n\t}\n}\n\n// TestKillPreviousTmuxPaneListFailure: when tmux cannot list panes at all,\n// the error is surfaced so the caller can decide — launchTmuxPane continues\n// anyway (see TestLaunchTmuxPaneContinuesAfterListFailure).\nfunc TestKillPreviousTmuxPaneListFailure(t *testing.T) {\n\tstub := newTmuxStub(t)\n\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n\ttmuxLastPaneID = \"\"\n\tif err := os.Remove(stub.panes); err != nil {\n\t\tt.Fatal(err) // a missing file makes the stub's `cat` fail, like a real tmux error\n\t}\n\n\terr := killPreviousTmuxPane()\n\tif err == nil {\n\t\tt.Fatal(\"expected an error when list-panes fails\")\n\t}\n\tif !strings.Contains(err.Error(), \"list-panes\") {\n\t\tt.Errorf(\"error should mention list-panes, got: %v\", err)\n\t}\n}\n\n// TestLaunchTmuxPaneReplacesBeforeSplittingAndRecordsPaneID exercises the\n// whole TASK-3 sequence: the previous manigot pane (identified by its title\n// tag — a fresh TUI process has no tracked id) is killed before the new\n// split, the new pane's id (printed by split-window -P) is tagged via\n// select-pane -T (the replace-policy tag survives a TUI restart) and recorded\n// for the next replace. The log's ordering proves kill-before-split and\n// tag-after-split, and that select-pane targets only the pane just created.\nfunc TestLaunchTmuxPaneReplacesBeforeSplittingAndRecordsPaneID(t *testing.T) {\n\tstub := newTmuxStub(t)\n\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n\ttmuxLastPaneID = \"\" // fresh TUI process: only the tag identifies the old pane\n\tstub.setPanes(\"%1 \" + tmuxPaneTag)\n\n\tdesc, err := launchTmuxPane(\"echo hi\")\n\tif err != nil {\n\t\tt.Fatalf(\"launchTmuxPane: %v\", err)\n\t}\n\tif desc != \"tmux pane\" {\n\t\tt.Errorf(\"desc = %q, want %q\", desc, \"tmux pane\")\n\t}\n\tif tmuxLastPaneID != \"%100\" {\n\t\tt.Errorf(\"tmuxLastPaneID = %q, want %q (the id split-window printed)\", tmuxLastPaneID, \"%100\")\n\t}\n\tcalls := stub.calls()\n\tif !strings.Contains(calls, \"kill-pane -t %1\") {\n\t\tt.Errorf(\"previous tagged pane not killed:\\n%s\", calls)\n\t}\n\tif !strings.Contains(calls, \"split-window -h -l 35% -P -F #{pane_id} bash -lc echo hi\") {\n\t\tt.Errorf(\"split-window invocation missing or wrong:\\n%s\", calls)\n\t}\n\t// The tag must be applied with select-pane (split-window has no -T on any\n\t// released tmux), to the pane the split just created — %100 — and to no\n\t// other pane. (\"-t %1 -T\" rather than \"-t %1\" so the %100 line cannot\n\t// false-positive the check.)\n\tif !strings.Contains(calls, \"select-pane -t %100 -T manigot\") {\n\t\tt.Errorf(\"select-pane tagging of the new pane missing or wrong:\\n%s\", calls)\n\t}\n\tif strings.Contains(calls, \"select-pane -t %1 -T\") {\n\t\tt.Errorf(\"select-pane tagged the previous pane instead of the new one:\\n%s\", calls)\n\t}\n\tif i, j := stub.indexCalls(\"kill-pane -t %1\"), stub.indexCalls(\"split-window\"); i < 0 || j < 0 || i > j {\n\t\tt.Errorf(\"kill-pane (%d) must precede split-window (%d):\\n%s\", i, j, calls)\n\t}\n\tif i, j := stub.indexCalls(\"split-window\"), stub.indexCalls(\"select-pane\"); i < 0 || j < 0 || i > j {\n\t\tt.Errorf(\"split-window (%d) must precede select-pane (%d):\\n%s\", i, j, calls)\n\t}\n}\n\n// TestLaunchTmuxPaneSecondLaunchReplacesRecordedPane: two launches through\n// launchTmuxPane — the second must kill the pane the first recorded (by id).\n// This is the case the in-memory tracking exists for: the running agent may\n// have overwritten the pane title in the meantime, so the tag alone could not\n// find it.\nfunc TestLaunchTmuxPaneSecondLaunchReplacesRecordedPane(t *testing.T) {\n\tstub := newTmuxStub(t)\n\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n\ttmuxLastPaneID = \"\"\n\n\tif _, err := launchTmuxPane(\"echo one\"); err != nil {\n\t\tt.Fatalf(\"first launchTmuxPane: %v\", err)\n\t}\n\tfirst := tmuxLastPaneID\n\tif first == \"\" {\n\t\tt.Fatal(\"first launch did not record a pane id\")\n\t}\n\n\t// The old pane no longer appears tagged in list-panes (as if the running\n\t// agent retitled it) — only the in-memory id can find it now.\n\tstub.setPanes(\"%9 unrelated\")\n\tif _, err := launchTmuxPane(\"echo two\"); err != nil {\n\t\tt.Fatalf(\"second launchTmuxPane: %v\", err)\n\t}\n\tif want := \"kill-pane -t \" + first; !strings.Contains(stub.calls(), want) {\n\t\tt.Errorf(\"second launch did not kill the recorded pane %s:\\n%s\", first, stub.calls())\n\t}\n}\n\n// TestLaunchTmuxPaneContinuesAfterListFailure documents the best-effort\n// replace decision from TASK-3: a list-panes failure must not abort the new\n// launch — if tmux is in a state where list-panes fails, the split below will\n// fail with the accurate error instead.\nfunc TestLaunchTmuxPaneContinuesAfterListFailure(t *testing.T) {\n\tstub := newTmuxStub(t)\n\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n\ttmuxLastPaneID = \"\"\n\tif err := os.Remove(stub.panes); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tdesc, err := launchTmuxPane(\"echo hi\")\n\tif err != nil {\n\t\tt.Fatalf(\"launchTmuxPane should continue after list-panes failure, got: %v\", err)\n\t}\n\tif desc != \"tmux pane\" {\n\t\tt.Errorf(\"desc = %q, want %q\", desc, \"tmux pane\")\n\t}\n\tif tmuxLastPaneID == \"\" {\n\t\tt.Error(\"launch succeeded but no pane id was recorded\")\n\t}\n}\n\n// TestLaunchTmuxPaneSplitFailureReturnsError: a split-window failure (the\n// tmux server is gone, say) is surfaced as the launch error.\nfunc TestLaunchTmuxPaneSplitFailureReturnsError(t *testing.T) {\n\tnewTmuxStub(t) // sets up the stubbed tmux on PATH + $TMUX; no panes listed\n\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n\ttmuxLastPaneID = \"\"\n\tt.Setenv(\"TMUX_STUB_SPLIT_FAIL\", \"1\")\n\n\t_, err := launchTmuxPane(\"echo hi\")\n\tif err == nil {\n\t\tt.Fatal(\"expected an error when split-window fails\")\n\t}\n\tif !strings.Contains(err.Error(), \"tmux pane\") {\n\t\tt.Errorf(\"error should say where the launch was attempted, got: %v\", err)\n\t}\n}\n\n// TestLaunchDetachedRoutesToTmuxPane: with $TMUX set and a tmux binary on\n// PATH, launchDetached (the shared tail of Agent and Quick) must route to the\n// synchronous tmux-pane path rather than the detached terminal-emulator tail.\nfunc TestLaunchDetachedRoutesToTmuxPane(t *testing.T) {\n\tstub := newTmuxStub(t)\n\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n\ttmuxLastPaneID = \"\"\n\n\tdesc, err := launchDetached(\"echo hi\", \"\")\n\tif err != nil {\n\t\tt.Fatalf(\"launchDetached: %v\", err)\n\t}\n\tif desc != \"tmux pane\" {\n\t\tt.Errorf(\"desc = %q, want %q\", desc, \"tmux pane\")\n\t}\n\tif !strings.Contains(stub.calls(), \"split-window -h -l 35% -P -F #{pane_id} bash -lc echo hi\") {\n\t\tt.Errorf(\"tmux split-window not invoked via launchDetached:\\n%s\", stub.calls())\n\t}\n}\n\n// TestLaunchDetachedFallsBackToTerminalSetting verifies that an empty\n// terminal falls back to the user's configured override (TerminalSetting)\n// before auto-detect: with the setting naming a nonexistent binary, the\n// launch fails naming that binary — proving the setting was consulted and\n// used. The candidate table is stubbed empty so the test is hermetic on any\n// machine (no real terminal is ever spawned).\nfunc TestLaunchDetachedFallsBackToTerminalSetting(t *testing.T) {\n\tt.Setenv(\"TMUX\", \"\")\n\torigSetting := TerminalSetting\n\torigCands := terminalCandidates\n\tTerminalSetting = func() string { return \"definitely-not-a-terminal-9x7z\" }\n\tterminalCandidates = nil\n\tt.Cleanup(func() {\n\t\tTerminalSetting = origSetting\n\t\tterminalCandidates = origCands\n\t})\n\n\t_, err := launchDetached(\"echo hi\", \"\")\n\tif err == nil || !strings.Contains(err.Error(), \"definitely-not-a-terminal-9x7z\") {\n\t\tt.Errorf(\"launchDetached with an empty terminal = %v, want it to fall back to TerminalSetting\", err)\n\t}\n}\n\n// TestLaunchDetachedExplicitTerminalWinsOverSetting verifies a caller's\n// explicit terminal still beats the configured override.\nfunc TestLaunchDetachedExplicitTerminalWinsOverSetting(t *testing.T) {\n\tt.Setenv(\"TMUX\", \"\")\n\torigSetting := TerminalSetting\n\tTerminalSetting = func() string { return \"configured-terminal-9x7z\" }\n\tt.Cleanup(func() { TerminalSetting = origSetting })\n\n\t_, err := launchDetached(\"echo hi\", \"explicit-terminal-9x7z\")\n\tif err == nil || !strings.Contains(err.Error(), \"explicit-terminal-9x7z\") {\n\t\tt.Errorf(\"launchDetached with an explicit terminal = %v, want the explicit value to win\", err)\n\t}\n\tif strings.Contains(err.Error(), \"configured-terminal-9x7z\") {\n\t\tt.Errorf(\"configured override leaked through despite an explicit terminal: %v\", err)\n\t}\n}\n\n// TestLaunchTmuxPaneContinuesAfterSelectPaneFailure documents the best-effort\n// tagging decision from the TASK-2/TASK-3 rework: the pane is already live and\n// the in-memory tmuxLastPaneID covers replacement within this TUI process, so\n// a select-pane -T failure (the tag that would survive a TUI restart) must not\n// abort a launch that already succeeded.\nfunc TestLaunchTmuxPaneContinuesAfterSelectPaneFailure(t *testing.T) {\n\tnewTmuxStub(t) // sets up the stubbed tmux on PATH + $TMUX; no panes listed\n\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n\ttmuxLastPaneID = \"\"\n\tt.Setenv(\"TMUX_STUB_SELECT_PANE_FAIL\", \"1\")\n\n\tdesc, err := launchTmuxPane(\"echo hi\")\n\tif err != nil {\n\t\tt.Fatalf(\"launchTmuxPane should continue after select-pane failure, got: %v\", err)\n\t}\n\tif desc != \"tmux pane\" {\n\t\tt.Errorf(\"desc = %q, want %q\", desc, \"tmux pane\")\n\t}\n\tif tmuxLastPaneID == \"\" {\n\t\tt.Error(\"launch succeeded but no pane id was recorded\")\n\t}\n}\n\n// TestAgentAndQuickShareOneTrackedPane is the requirement behind \"a single\n// shared tracked pane across both launch.Agent and launch.Quick\": a Quick\n// launch after an Agent launch must replace the pane the Agent opened, so at\n// most one manigot pane exists regardless of which entry point opened it.\nfunc TestAgentAndQuickShareOneTrackedPane(t *testing.T) {\n\tstub := newTmuxStub(t)\n\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n\ttmuxLastPaneID = \"\"\n\n\t// The inner command is the running binary itself (os.Executable) — in a\n\t// test that's the test binary, which never actually runs because the tmux\n\t// stub intercepts split-window before the pane command executes.\n\troot := t.TempDir()\n\n\tif _, err := Agent(\"developer\", \"t5oc4j\", root, \"claude-pro\", \"\"); err != nil {\n\t\tt.Fatalf(\"Agent: %v\", err)\n\t}\n\tagentPane := tmuxLastPaneID\n\tif agentPane == \"\" {\n\t\tt.Fatal(\"Agent launch did not record a pane id\")\n\t}\n\n\tif _, err := Quick(root, \"claude-pro\", \"\"); err != nil {\n\t\tt.Fatalf(\"Quick: %v\", err)\n\t}\n\tif want := \"kill-pane -t \" + agentPane; !strings.Contains(stub.calls(), want) {\n\t\tt.Errorf(\"Quick launch did not replace the pane Agent opened (%s):\\n%s\", agentPane, stub.calls())\n\t}\n}\n\nfunc TestBuildCmdSmoke(t *testing.T) {\n\t// buildCmd must not panic and must return either a runnable command or a\n\t// descriptive error, depending on what is installed in this environment.\n\tcmd, desc, err := buildCmd(\"echo hi\", \"\")\n\tif err != nil {\n\t\tif !strings.Contains(err.Error(), \"terminal launcher\") {\n\t\t\tt.Errorf(\"unexpected error: %v\", err)\n\t\t}\n\t\t// desc should be empty on error.\n\t\tif desc != \"\" {\n\t\t\tt.Errorf(\"on error, desc = %q, want empty\", desc)\n\t\t}\n\t\treturn\n\t}\n\tif cmd == nil {\n\t\tt.Fatal(\"buildCmd returned nil cmd and nil error\")\n\t}\n\tif cmd.Path == \"\" {\n\t\tt.Error(\"returned cmd has empty Path\")\n\t}\n\tif desc == \"\" {\n\t\tt.Error(\"returned cmd has empty description\")\n\t}\n}\n\n// --- terminal override (config.Settings.Terminal, TASK-3) ------------------\n\n// stubBinary writes an executable no-op shell script at dir/name and returns\n// its path, so exec.LookPath(name) resolves it when dir is on $PATH.\nfunc stubBinary(t *testing.T, dir, name string) string {\n\tt.Helper()\n\tpath := filepath.Join(dir, name)\n\tif err := os.WriteFile(path, []byte(\"#!/bin/sh\\nexit 0\\n\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn path\n}\n\n// TestBuildCmdTmuxWinsOverOverrideInsideTmux confirms the new precedence\n// (TASK-2): with $TMUX set and a tmux binary on PATH, buildCmd must invoke the\n// tmux split-pane branch even when an override is set — the override no longer\n// bypasses tmux, so a session launched from a TUI inside tmux lands in a tmux\n// pane, never in a separate window.\nfunc TestBuildCmdTmuxWinsOverOverrideInsideTmux(t *testing.T) {\n\tdir := t.TempDir()\n\ttmuxBin := stubBinary(t, dir, \"tmux\")\n\tstubBinary(t, dir, \"kitty\")\n\tt.Setenv(\"PATH\", dir)\n\tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,12345,0\")\n\n\tcmd, desc, err := buildCmd(\"echo hi\", \"kitty\")\n\tif err != nil {\n\t\tt.Fatalf(\"buildCmd: %v\", err)\n\t}\n\tif desc != \"tmux pane\" {\n\t\tt.Errorf(\"desc = %q, want %q (tmux pane wins inside tmux)\", desc, \"tmux pane\")\n\t}\n\tif cmd.Path != tmuxBin {\n\t\tt.Errorf(\"cmd.Path = %q, want %q (resolved tmux binary, not the override)\", cmd.Path, tmuxBin)\n\t}\n}\n\n// TestLaunchDetachedTmuxWinsOverOverrideInsideTmux confirms the same at the\n// launchDetached level, which is what actually decides whether to route to\n// launchTmuxPane at all: with an override set, $TMUX set and a tmux binary on\n// PATH, the kill/split/tag sequence runs and the override is not invoked.\nfunc TestLaunchDetachedTmuxWinsOverOverrideInsideTmux(t *testing.T) {\n\tstub := newTmuxStub(t)\n\tstubBinary(t, filepath.Dir(stub.path), \"kitty\") // override on the same PATH\n\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n\ttmuxLastPaneID = \"\"\n\n\tdesc, err := launchDetached(\"echo hi\", \"kitty\")\n\tif err != nil {\n\t\tt.Fatalf(\"launchDetached: %v\", err)\n\t}\n\tif desc != \"tmux pane\" {\n\t\tt.Errorf(\"desc = %q, want %q (tmux pane wins inside tmux)\", desc, \"tmux pane\")\n\t}\n\tif tmuxLastPaneID == \"\" {\n\t\tt.Error(\"tmux path did not run (no pane id recorded)\")\n\t}\n\tcalls := stub.calls()\n\tif !strings.Contains(calls, \"split-window -h -l 35% -P -F #{pane_id} bash -lc echo hi\") {\n\t\tt.Errorf(\"tmux split-window not invoked via launchDetached:\\n%s\", calls)\n\t}\n\tif !strings.Contains(calls, \"select-pane -t %100 -T manigot\") {\n\t\tt.Errorf(\"select-pane tagging of the new pane missing:\\n%s\", calls)\n\t}\n\t// The override (kitty) must not be invoked at all.\n\tif strings.Contains(calls, \"kitty\") {\n\t\tt.Errorf(\"override unexpectedly invoked inside tmux:\\n%s\", calls)\n\t}\n}\n\n// TestBuildCmdOverrideWinsOutsideTmux guards the outside-tmux precedence from\n// TASK-2: with an override set but the TUI NOT inside tmux ($TMUX unset),\n// buildCmd must still invoke the override — the r5x2a7 feature is preserved\n// for non-tmux users.\nfunc TestBuildCmdOverrideWinsOutsideTmux(t *testing.T) {\n\tdir := t.TempDir()\n\tstubBinary(t, dir, \"tmux\")\n\tkitty := stubBinary(t, dir, \"kitty\")\n\tt.Setenv(\"PATH\", dir)\n\tt.Setenv(\"TMUX\", \"\") // NOT inside tmux\n\n\tcmd, desc, err := buildCmd(\"echo hi\", \"kitty\")\n\tif err != nil {\n\t\tt.Fatalf(\"buildCmd: %v\", err)\n\t}\n\tif desc != \"kitty\" {\n\t\tt.Errorf(\"desc = %q, want %q (override wins outside tmux)\", desc, \"kitty\")\n\t}\n\tif cmd.Path != kitty {\n\t\tt.Errorf(\"cmd.Path = %q, want %q (the override binary)\", cmd.Path, kitty)\n\t}\n}\n\n// TestLaunchDetachedOverrideWinsOutsideTmux confirms the same at the\n// launchDetached level: with an override set and the TUI NOT inside tmux, the\n// override is invoked and the tmux path does not run.\nfunc TestLaunchDetachedOverrideWinsOutsideTmux(t *testing.T) {\n\tdir := t.TempDir()\n\tstubBinary(t, dir, \"tmux\")\n\tstubBinary(t, dir, \"kitty\")\n\tt.Setenv(\"PATH\", dir)\n\tt.Setenv(\"TMUX\", \"\") // NOT inside tmux\n\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n\ttmuxLastPaneID = \"\"\n\n\tdesc, err := launchDetached(\"echo hi\", \"kitty\")\n\tif err != nil {\n\t\tt.Fatalf(\"launchDetached: %v\", err)\n\t}\n\tif desc != \"kitty\" {\n\t\tt.Errorf(\"desc = %q, want %q (override wins outside tmux)\", desc, \"kitty\")\n\t}\n\tif tmuxLastPaneID != \"\" {\n\t\tt.Errorf(\"tmuxLastPaneID = %q, want empty (tmux path must not have run)\", tmuxLastPaneID)\n\t}\n}\n\n// TestBuildCmdOverrideFallsThroughWhenTmuxMissing: with $TMUX set but no tmux\n// binary on PATH, buildCmd must fall through to the override — inside tmux\n// only wins when tmux is actually available.\nfunc TestBuildCmdOverrideFallsThroughWhenTmuxMissing(t *testing.T) {\n\tdir := t.TempDir()\n\tkitty := stubBinary(t, dir, \"kitty\")\n\tt.Setenv(\"PATH\", dir) // no tmux binary on PATH\n\tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,12345,0\")\n\n\tcmd, desc, err := buildCmd(\"echo hi\", \"kitty\")\n\tif err != nil {\n\t\tt.Fatalf(\"buildCmd: %v\", err)\n\t}\n\tif desc != \"kitty\" {\n\t\tt.Errorf(\"desc = %q, want %q (fall through to the override)\", desc, \"kitty\")\n\t}\n\tif cmd.Path != kitty {\n\t\tt.Errorf(\"cmd.Path = %q, want %q (the override binary)\", cmd.Path, kitty)\n\t}\n}\n\n// TestLaunchDetachedOverrideFallsThroughWhenTmuxMissing confirms the same at\n// the launchDetached level: with $TMUX set but no tmux binary on PATH, the\n// tmux branch cannot win and the override is used instead.\nfunc TestLaunchDetachedOverrideFallsThroughWhenTmuxMissing(t *testing.T) {\n\tdir := t.TempDir()\n\tstubBinary(t, dir, \"kitty\") // the override binary launchDetached will spawn\n\tt.Setenv(\"PATH\", dir)       // no tmux binary on PATH\n\tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,12345,0\")\n\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n\ttmuxLastPaneID = \"\"\n\n\tdesc, err := launchDetached(\"echo hi\", \"kitty\")\n\tif err != nil {\n\t\tt.Fatalf(\"launchDetached: %v\", err)\n\t}\n\tif desc != \"kitty\" {\n\t\tt.Errorf(\"desc = %q, want %q (fall through to the override)\", desc, \"kitty\")\n\t}\n\tif tmuxLastPaneID != \"\" {\n\t\tt.Errorf(\"tmuxLastPaneID = %q, want empty (tmux path must not have run)\", tmuxLastPaneID)\n\t}\n}\n\n// TestBuildOverrideCmdKnownNameReusesConvention confirms an override whose\n// binary matches one of terminalCandidates' own names reuses that name's\n// existing flag convention rather than defaulting to -e (TASK-1 point 3).\nfunc TestBuildOverrideCmdKnownNameReusesConvention(t *testing.T) {\n\tdir := t.TempDir()\n\tkonsole := stubBinary(t, dir, \"konsole\")\n\tgnomeTerminal := stubBinary(t, dir, \"gnome-terminal\")\n\tt.Setenv(\"PATH\", dir)\n\n\tcmd, desc, err := buildOverrideCmd(\"echo hi\", \"konsole\")\n\tif err != nil {\n\t\tt.Fatalf(\"buildOverrideCmd: %v\", err)\n\t}\n\tif desc != \"konsole\" {\n\t\tt.Errorf(\"desc = %q, want %q\", desc, \"konsole\")\n\t}\n\twant := []string{\"konsole\", \"-e\", \"bash\", \"-lc\", \"echo hi\"}\n\tif len(cmd.Args) != len(want) {\n\t\tt.Fatalf(\"cmd.Args = %v, want %v\", cmd.Args, want)\n\t}\n\tfor i, a := range want {\n\t\tif cmd.Args[i] != a {\n\t\t\tt.Errorf(\"cmd.Args[%d] = %q, want %q (full: %v)\", i, cmd.Args[i], a, cmd.Args)\n\t\t}\n\t}\n\tif cmd.Path != konsole {\n\t\tt.Errorf(\"cmd.Path = %q, want %q\", cmd.Path, konsole)\n\t}\n\n\tcmd, desc, err = buildOverrideCmd(\"echo hi\", \"gnome-terminal\")\n\tif err != nil {\n\t\tt.Fatalf(\"buildOverrideCmd: %v\", err)\n\t}\n\tif desc != \"gnome-terminal\" {\n\t\tt.Errorf(\"desc = %q, want %q\", desc, \"gnome-terminal\")\n\t}\n\twant = []string{\"gnome-terminal\", \"--\", \"bash\", \"-lc\", \"echo hi\"}\n\tif len(cmd.Args) != len(want) {\n\t\tt.Fatalf(\"cmd.Args = %v, want %v\", cmd.Args, want)\n\t}\n\tfor i, a := range want {\n\t\tif cmd.Args[i] != a {\n\t\t\tt.Errorf(\"cmd.Args[%d] = %q, want %q (full: %v)\", i, cmd.Args[i], a, cmd.Args)\n\t\t}\n\t}\n\tif cmd.Path != gnomeTerminal {\n\t\tt.Errorf(\"cmd.Path = %q, want %q\", cmd.Path, gnomeTerminal)\n\t}\n}\n\n// TestBuildOverrideCmdKnownNameCaseInsensitive confirms the known-name match\n// is case-insensitive.\nfunc TestBuildOverrideCmdKnownNameCaseInsensitive(t *testing.T) {\n\tdir := t.TempDir()\n\tstubBinary(t, dir, \"Xterm\")\n\tt.Setenv(\"PATH\", dir)\n\n\tcmd, _, err := buildOverrideCmd(\"echo hi\", \"Xterm\")\n\tif err != nil {\n\t\tt.Fatalf(\"buildOverrideCmd: %v\", err)\n\t}\n\tif len(cmd.Args) < 2 || cmd.Args[1] != \"-e\" {\n\t\tt.Errorf(\"cmd.Args = %v, want [Xterm -e ...] (case-insensitive known-name match)\", cmd.Args)\n\t}\n}\n\n// TestBuildOverrideCmdUnknownNameDefaultsToDashE confirms an override binary\n// not in terminalCandidates falls back to the -e convention (TASK-1 point 3).\nfunc TestBuildOverrideCmdUnknownNameDefaultsToDashE(t *testing.T) {\n\tdir := t.TempDir()\n\tstubBinary(t, dir, \"alacritty\")\n\tt.Setenv(\"PATH\", dir)\n\n\tcmd, desc, err := buildOverrideCmd(\"echo hi\", \"alacritty\")\n\tif err != nil {\n\t\tt.Fatalf(\"buildOverrideCmd: %v\", err)\n\t}\n\tif desc != \"alacritty\" {\n\t\tt.Errorf(\"desc = %q, want %q\", desc, \"alacritty\")\n\t}\n\twant := []string{\"alacritty\", \"-e\", \"bash\", \"-lc\", \"echo hi\"}\n\tif len(cmd.Args) != len(want) {\n\t\tt.Fatalf(\"cmd.Args = %v, want %v\", cmd.Args, want)\n\t}\n\tfor i, a := range want {\n\t\tif cmd.Args[i] != a {\n\t\t\tt.Errorf(\"cmd.Args[%d] = %q, want %q (full: %v)\", i, cmd.Args[i], a, cmd.Args)\n\t\t}\n\t}\n}\n\n// TestBuildOverrideCmdPassesLeadingArgs confirms trailing tokens in the\n// override value (e.g. \"alacritty --some-flag\") are passed through as leading\n// args before the flag convention, mirroring config.Settings.Editor's own\n// \"trailing args\" allowance.\nfunc TestBuildOverrideCmdPassesLeadingArgs(t *testing.T) {\n\tdir := t.TempDir()\n\tstubBinary(t, dir, \"alacritty\")\n\tt.Setenv(\"PATH\", dir)\n\n\tcmd, _, err := buildOverrideCmd(\"echo hi\", \"alacritty --some-flag\")\n\tif err != nil {\n\t\tt.Fatalf(\"buildOverrideCmd: %v\", err)\n\t}\n\twant := []string{\"alacritty\", \"--some-flag\", \"-e\", \"bash\", \"-lc\", \"echo hi\"}\n\tif len(cmd.Args) != len(want) {\n\t\tt.Fatalf(\"cmd.Args = %v, want %v\", cmd.Args, want)\n\t}\n\tfor i, a := range want {\n\t\tif cmd.Args[i] != a {\n\t\t\tt.Errorf(\"cmd.Args[%d] = %q, want %q (full: %v)\", i, cmd.Args[i], a, cmd.Args)\n\t\t}\n\t}\n}\n\n// TestBuildOverrideCmdMissingBinaryErrors confirms a typo'd/missing override\n// binary surfaces a clear error instead of silently falling back to\n// auto-detect (TASK-1 point 3).\nfunc TestBuildOverrideCmdMissingBinaryErrors(t *testing.T) {\n\tt.Setenv(\"PATH\", t.TempDir()) // empty PATH: nothing resolves\n\n\t_, _, err := buildOverrideCmd(\"echo hi\", \"not-a-real-terminal\")\n\tif err == nil {\n\t\tt.Fatal(\"expected an error for a missing override binary\")\n\t}\n\tif !strings.Contains(err.Error(), \"not-a-real-terminal\") {\n\t\tt.Errorf(\"error should name the missing binary, got: %v\", err)\n\t}\n}\n\n// TestBuildCmdUnsetTerminalUnchanged is a smoke check that buildCmd with an\n// empty terminal still goes through the auto-detect chain (not the override\n// path) — the substantive coverage is TestBuildCmdSmoke/TestBuildCmdTmux*,\n// this just confirms an empty string doesn't accidentally match\n// buildOverrideCmd's \"blank\" guard as a real override.\nfunc TestBuildCmdUnsetTerminalUnchanged(t *testing.T) {\n\tcmd, desc, err := buildCmd(\"echo hi\", \"\")\n\tif err != nil {\n\t\tif !strings.Contains(err.Error(), \"terminal launcher\") {\n\t\t\tt.Errorf(\"unexpected error for empty terminal: %v\", err)\n\t\t}\n\t\treturn\n\t}\n\tif cmd == nil || desc == \"\" {\n\t\tt.Errorf(\"buildCmd with empty terminal returned incomplete result: cmd=%v desc=%q\", cmd, desc)\n\t}\n}\n\n// --- Jdi (detached, no terminal window — Decision 7a) -----------------------\n\n// stubJdiExe points the launch package's executable lookup at stub and\n// restores it after the test.\nfunc stubJdiExe(t *testing.T, stub string) {\n\tt.Helper()\n\told := JdiExe\n\tJdiExe = func() (string, error) { return stub, nil }\n\tt.Cleanup(func() { JdiExe = old })\n}\n\nfunc TestJdiExeLookupFailure(t *testing.T) {\n\told := JdiExe\n\tdefer func() { JdiExe = old }()\n\tJdiExe = func() (string, error) { return \"\", errors.New(\"boom\") }\n\n\terr := Jdi(\"ab0001_x\", t.TempDir(), \"\")\n\tif err == nil || !strings.Contains(err.Error(), \"boom\") {\n\t\tt.Errorf(\"expected the executable lookup error, got: %v\", err)\n\t}\n}\n\n// The jdi subcommand must be started detached (no terminal emulator involved\n// at all, unlike Agent/Quick), by absolute path, in projectRoot — the same\n// invocation contract the one binary's `mg jdi` subcommand satisfies.\nfunc TestJdiStartsResolvedCommandDetached(t *testing.T) {\n\troot := t.TempDir()\n\tout := filepath.Join(root, \"args.txt\")\n\n\tstub := filepath.Join(t.TempDir(), \"stub.sh\")\n\tscript := \"#!/bin/sh\\n\" +\n\t\t\"{ echo \\\"argv0=$0\\\"; echo \\\"pwd=$PWD\\\"; echo \\\"cwd=$(pwd)\\\"; \" +\n\t\t\"for a in \\\"$@\\\"; do echo \\\"arg=$a\\\"; done; } > \" + out + \"\\n\"\n\tif err := os.WriteFile(stub, []byte(script), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstubJdiExe(t, stub)\n\n\tif err := Jdi(\"ab0001_x\", root, \"\"); err != nil {\n\t\tt.Fatalf(\"Jdi: %v\", err)\n\t}\n\n\t// Jdi starts the process detached and reaps it asynchronously — Start()\n\t// only guarantees the process began, not that it has finished writing\n\t// its marker file yet, so poll briefly rather than reading immediately.\n\tvar raw []byte\n\tdeadline := time.Now().Add(2 * time.Second)\n\tfor time.Now().Before(deadline) {\n\t\tif data, err := os.ReadFile(out); err == nil {\n\t\t\traw = data\n\t\t\tbreak\n\t\t}\n\t\ttime.Sleep(10 * time.Millisecond)\n\t}\n\tif raw == nil {\n\t\tt.Fatal(\"stub did not run within the timeout\")\n\t}\n\n\trecorded := string(raw)\n\tfor _, want := range []string{\n\t\t\"argv0=\" + stub, // invoked by absolute path, not by bare name\n\t\t\"pwd=\" + root,   // $PWD explicitly set for job.FindProjectRoot\n\t\t\"cwd=\" + root,   // and the real cwd agrees\n\t\t\"arg=jdi\",       // the mg jdi subcommand\n\t\t\"arg=--job\",\n\t\t\"arg=ab0001_x\",\n\t\t\"arg=--profile\",\n\t\t\"arg=\" + config.ProfileClaudePro, // empty profile defaults to claude-pro, matching Agent/Quick\n\t} {\n\t\tif !strings.Contains(recorded, want) {\n\t\t\tt.Errorf(\"missing %q in stub record:\\n%s\", want, recorded)\n\t\t}\n\t}\n}\n\n// TestJdiForwardsGivenProfile confirms a non-empty profile (TASK-6) is\n// forwarded to the mg jdi subcommand as its own --profile flag unchanged, not\n// overridden by the claude-pro default TestJdiStartsResolvedCommandDetached\n// exercises.\nfunc TestJdiForwardsGivenProfile(t *testing.T) {\n\troot := t.TempDir()\n\tout := filepath.Join(root, \"args.txt\")\n\n\tstub := filepath.Join(t.TempDir(), \"stub.sh\")\n\tscript := \"#!/bin/sh\\nfor a in \\\"$@\\\"; do echo \\\"arg=$a\\\"; done > \" + out + \"\\n\"\n\tif err := os.WriteFile(stub, []byte(script), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstubJdiExe(t, stub)\n\n\tif err := Jdi(\"ab0001_x\", root, config.ProfileZAI); err != nil {\n\t\tt.Fatalf(\"Jdi: %v\", err)\n\t}\n\n\tvar raw []byte\n\tdeadline := time.Now().Add(2 * time.Second)\n\tfor time.Now().Before(deadline) {\n\t\tif data, err := os.ReadFile(out); err == nil {\n\t\t\traw = data\n\t\t\tbreak\n\t\t}\n\t\ttime.Sleep(10 * time.Millisecond)\n\t}\n\tif raw == nil {\n\t\tt.Fatal(\"stub did not run within the timeout\")\n\t}\n\n\trecorded := string(raw)\n\tfor _, want := range []string{\"arg=--profile\", \"arg=\" + config.ProfileZAI} {\n\t\tif !strings.Contains(recorded, want) {\n\t\t\tt.Errorf(\"missing %q in stub record:\\n%s\", want, recorded)\n\t\t}\n\t}\n}\n\n// --- tig (diff browsing) launcher -------------------------------------------\n\n// stubTigLookPath points the launch package's tig lookup at fn and restores\n// it after the test, so tig availability can be controlled without a real\n// tig on the test machine.\nfunc stubTigLookPath(t *testing.T, fn func(string) (string, error)) {\n\tt.Helper()\n\told := TigLookPath\n\tTigLookPath = fn\n\tt.Cleanup(func() { TigLookPath = old })\n}\n\nfunc TestTigShellCommandFormat(t *testing.T) {\n\tgot := tigShellCommand(\"/usr/local/bin/manigot\", \"term_tig-in-tui\", \"/home/me/proj\")\n\twantInner := \"cd '/home/me/proj' && '/usr/local/bin/manigot' diff 'term_tig-in-tui' --tig\"\n\tif !strings.HasPrefix(got, wantInner) {\n\t\tt.Errorf(\"tigShellCommand =\\n %q\\nwant prefix\\n %q\", got, wantInner)\n\t}\n\t// The inner command must be wrapped so a failure holds the window open,\n\t// exactly like every other launch path.\n\tif got != holdOnFailure(wantInner) {\n\t\tt.Errorf(\"tigShellCommand does not wrap its inner command with holdOnFailure:\\n%q\", got)\n\t}\n}\n\n// A tig launch must never carry --profile, --agent or --job — `mg diff`\n// takes none of them (it is a host git command, not a session launch).\nfunc TestTigShellCommandOmitsSessionFlags(t *testing.T) {\n\tgot := tigShellCommand(\"/usr/local/bin/manigot\", \"term_tig-in-tui\", \"/home/me/proj\")\n\tfor _, flag := range []string{\"--profile\", \"--agent\", \"--job\"} {\n\t\tif strings.Contains(got, flag) {\n\t\t\tt.Errorf(\"tigShellCommand unexpectedly contains %s: %q\", flag, got)\n\t\t}\n\t}\n}\n\n// A checkout in a directory with spaces must still produce a single word for\n// the manigot path, since the string is re-parsed by osascript / bash -lc.\nfunc TestTigShellCommandQuotesPathWithSpaces(t *testing.T) {\n\tgot := tigShellCommand(\"/Users/me/My Projects/manigot/scripts/run.sh\", \"term_tig-in-tui\", \"/tmp/p\")\n\tif !strings.Contains(got, `'/Users/me/My Projects/manigot/scripts/run.sh'`) {\n\t\tt.Errorf(\"manigot path not quoted as one word in %q\", got)\n\t}\n}\n\n// Embedded quotes in either value must be escaped, not close the quote.\nfunc TestTigShellCommandQuoteEscape(t *testing.T) {\n\tgot := tigShellCommand(\"/bin/manigot\", \"a'b\", \"/path/with'quote\")\n\tif !strings.Contains(got, `'/path/with'\\''quote'`) {\n\t\tt.Errorf(\"root quote not escaped in %q\", got)\n\t}\n\tif !strings.Contains(got, `'a'\\''b'`) {\n\t\tt.Errorf(\"jobID quote not escaped in %q\", got)\n\t}\n}\n\nfunc TestTigAvailableTrueWhenTigResolves(t *testing.T) {\n\tstubTigLookPath(t, func(name string) (string, error) {\n\t\tif name != \"tig\" {\n\t\t\tt.Errorf(\"TigLookPath called with %q, want %q\", name, \"tig\")\n\t\t}\n\t\treturn \"/usr/bin/tig\", nil\n\t})\n\tif !TigAvailable() {\n\t\tt.Error(\"TigAvailable() = false, want true when tig resolves\")\n\t}\n}\n\nfunc TestTigAvailableFalseWhenTigMissing(t *testing.T) {\n\tstubTigLookPath(t, func(name string) (string, error) {\n\t\treturn \"\", exec.ErrNotFound\n\t})\n\tif TigAvailable() {\n\t\tt.Error(\"TigAvailable() = true, want false when tig does not resolve\")\n\t}\n}\n\n// TestTigMissingErrorsBeforeSpawn: with tig unresolvable, Tig must return the\n// not-installed error synchronously without consulting ExeOverride at all —\n// the availability check is the authoritative backstop that runs first, so a\n// stale cached gate can never open a doomed pane. ExeOverride is pointed at a\n// marker that fails loudly: reaching it would change the error.\nfunc TestTigMissingErrorsBeforeSpawn(t *testing.T) {\n\tstubTigLookPath(t, func(name string) (string, error) {\n\t\treturn \"\", exec.ErrNotFound\n\t})\n\told := ExeOverride\n\tt.Cleanup(func() { ExeOverride = old })\n\tExeOverride = func() (string, error) { return \"\", errors.New(\"exe override should not be consulted\") }\n\n\t_, err := Tig(\"term_tig-in-tui\", t.TempDir(), \"\")\n\tif err == nil || !strings.Contains(err.Error(), \"tig is not installed\") {\n\t\tt.Errorf(\"Tig with tig missing = %v, want the not-installed error\", err)\n\t}\n}\n\n// TestTigExeOverrideFailure: with tig available but the mg binary unresolvable\n// (ExeOverride fails), Tig must surface that resolution error — mirroring\n// Agent/Quick's own \"locate mg binary\" error path.\nfunc TestTigExeOverrideFailure(t *testing.T) {\n\tstubTigLookPath(t, func(name string) (string, error) {\n\t\treturn \"/usr/bin/tig\", nil\n\t})\n\told := ExeOverride\n\tt.Cleanup(func() { ExeOverride = old })\n\tExeOverride = func() (string, error) { return \"\", errors.New(\"boom\") }\n\n\t_, err := Tig(\"term_tig-in-tui\", t.TempDir(), \"\")\n\tif err == nil || !strings.Contains(err.Error(), \"boom\") {\n\t\tt.Errorf(\"Tig with ExeOverride failure = %v, want the resolution error\", err)\n\t}\n}\n\n// TestTigSuccessThroughTmuxStub exercises the full Tig launch through the\n// existing tmuxStub, mirroring TestAgentAndQuickShareOneTrackedPane: with\n// $TMUX set and a stubbed tmux on PATH, the split-window invocation must carry\n// the tig inner command, the pane must be tagged/recorded, and the returned\n// description must be \"tmux pane\".\nfunc TestTigSuccessThroughTmuxStub(t *testing.T) {\n\tstub := newTmuxStub(t)\n\tstubTigLookPath(t, func(name string) (string, error) {\n\t\treturn \"/usr/bin/tig\", nil\n\t})\n\tt.Cleanup(func() { tmuxLastPaneID = \"\" })\n\ttmuxLastPaneID = \"\"\n\n\troot := t.TempDir()\n\tdesc, err := Tig(\"t5oc4j\", root, \"\")\n\tif err != nil {\n\t\tt.Fatalf(\"Tig: %v\", err)\n\t}\n\tif desc != \"tmux pane\" {\n\t\tt.Errorf(\"desc = %q, want %q\", desc, \"tmux pane\")\n\t}\n\tif tmuxLastPaneID == \"\" {\n\t\tt.Error(\"Tig launch did not record a pane id\")\n\t}\n\tcalls := stub.calls()\n\tif !strings.Contains(calls, \"diff 't5oc4j' --tig\") {\n\t\tt.Errorf(\"tmux split-window not invoked with the tig inner command:\\n%s\", calls)\n\t}\n\tif !strings.Contains(calls, \"select-pane -t %100 -T manigot\") {","lineStart":1,"lineEnd":1319,"totalLines":1320,"truncated":true}},"title":"src/internal/launch/launch_test.go","time":{"start":1787938934983,"end":1787938934988}},"id":"prt_049771049001dIOi2M44yTXbP8","sessionID":"ses_fb6891103ffeJz653vCFao7FeS","messageID":"msg_049770c2b001dUGOfUBumtq41O"}}
