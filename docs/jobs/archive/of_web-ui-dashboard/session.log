{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WTLphrdYTfJqpEzkn2NQ4G","type":"tool_result","content":"1\timport { describe, expect, it } from 'vitest'\n2\timport { aggregateCounts, attentionJobs, type ProjectLoad } from '$lib/dashboard'\n3\timport type { JobRow } from '$lib/api/types'\n4\t\n5\tconst job = (over: Partial<JobRow>): JobRow => ({\n6\t  id: 'x',\n7\t  name: 'x_job',\n8\t  status: 'open',\n9\t  stage: 'implement',\n10\t  type: 'feature',\n11\t  date: '2026-08-28',\n12\t  title: 't',\n13\t  jdi: null,\n14\t  ...over,\n15\t})\n16\t\n17\tdescribe('aggregateCounts', () => {\n18\t  it('counts open jobs, needs-human and running across every loaded project', () => {\n19\t    const loads: ProjectLoad[] = [\n20\t      {\n21\t        project: 'a',\n22\t        jobs: [\n23\t          job({ id: '1', name: '1_x', status: 'open' }),\n24\t          job({\n25\t            id: '2',\n26\t            name: '2_x',\n27\t            status: 'open',\n28\t            jdi: { state: 'stopped:needs-human', agent: 'reviewer', updated: '' },\n29\t          }),\n30\t        ],\n31\t      },\n32\t      {\n33\t        project: 'b',\n34\t        jobs: [\n35\t          job({ id: '3', name: '3_x', status: 'done' }),\n36\t          job({ id: '4', name: '4_x', status: 'open', jdi: { state: 'running', agent: 'developer', updated: '' } }),\n37\t        ],\n38\t      },\n39\t    ]\n40\t    expect(aggregateCounts(loads)).toEqual({ projects: 2, openJobs: 3, needsHuman: 1, running: 1 })\n41\t  })\n42\t\n43\t  it('skips failed loads instead of counting them as zero', () => {\n44\t    const loads: ProjectLoad[] = [\n45\t      { project: 'a', jobs: null },\n46\t      { project: 'b', jobs: [job({ status: 'open' })] },\n47\t    ]\n48\t    const counts = aggregateCounts(loads)\n49\t    expect(counts.projects).toBe(2)\n50\t    expect(counts.openJobs).toBe(1)\n51\t  })\n52\t})\n53\t\n54\tdescribe('attentionJobs', () => {\n55\t  it('flattens every project, tags each job with its project, and sorts by attention', () => {\n56\t    const loads: ProjectLoad[] = [\n57\t      {\n58\t        project: 'a',\n59\t        jobs: [job({ id: 'quiet', name: 'quiet_x' })],\n60\t      },\n61\t      {\n62\t        project: 'b',\n63\t        jobs: [\n64\t          job({ id: 'running', name: 'running_x', jdi: { state: 'running', agent: 'a', updated: '' } }),\n65\t          job({ id: 'human', name: 'human_x', jdi: { state: 'stopped:needs-human', agent: 'a', updated: '' } }),\n66\t        ],\n67\t      },\n68\t    ]\n69\t    const sorted = attentionJobs(loads)\n70\t    expect(sorted.map((j) => [j.project, j.id])).toEqual([\n71\t      ['b', 'human'],\n72\t      ['b', 'running'],\n73\t      ['a', 'quiet'],\n74\t    ])\n75\t  })\n76\t\n77\t  it('skips failed loads', () => {\n78\t    const loads: ProjectLoad[] = [\n79\t      { project: 'a', jobs: null },\n80\t      { project: 'b', jobs: [job({ id: 'x', name: 'x_x' })] },\n81\t    ]\n82\t    expect(attentionJobs(loads).map((j) => j.project)).toEqual(['b'])\n83\t  })\n84\t})\n85\t"}]},"parent_tool_use_id":null,"session_id":"922db0ba-8634-4cea-a4ec-b27bd027a32b","uuid":"ec862f84-fd5c-4837-ac2f-7be812cabbcc","timestamp":"2026-08-29T12:58:27.798Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/web-ui/src/lib/dashboard.test.ts","content":"import { describe, expect, it } from 'vitest'\nimport { aggregateCounts, attentionJobs, type ProjectLoad } from '$lib/dashboard'\nimport type { JobRow } from '$lib/api/types'\n\nconst job = (over: Partial<JobRow>): JobRow => ({\n  id: 'x',\n  name: 'x_job',\n  status: 'open',\n  stage: 'implement',\n  type: 'feature',\n  date: '2026-08-28',\n  title: 't',\n  jdi: null,\n  ...over,\n})\n\ndescribe('aggregateCounts', () => {\n  it('counts open jobs, needs-human and running across every loaded project', () => {\n    const loads: ProjectLoad[] = [\n      {\n        project: 'a',\n        jobs: [\n          job({ id: '1', name: '1_x', status: 'open' }),\n          job({\n            id: '2',\n            name: '2_x',\n            status: 'open',\n            jdi: { state: 'stopped:needs-human', agent: 'reviewer', updated: '' },\n          }),\n        ],\n      },\n      {\n        project: 'b',\n        jobs: [\n          job({ id: '3', name: '3_x', status: 'done' }),\n          job({ id: '4', name: '4_x', status: 'open', jdi: { state: 'running', agent: 'developer', updated: '' } }),\n        ],\n      },\n    ]\n    expect(aggregateCounts(loads)).toEqual({ projects: 2, openJobs: 3, needsHuman: 1, running: 1 })\n  })\n\n  it('skips failed loads instead of counting them as zero', () => {\n    const loads: ProjectLoad[] = [\n      { project: 'a', jobs: null },\n      { project: 'b', jobs: [job({ status: 'open' })] },\n    ]\n    const counts = aggregateCounts(loads)\n    expect(counts.projects).toBe(2)\n    expect(counts.openJobs).toBe(1)\n  })\n})\n\ndescribe('attentionJobs', () => {\n  it('flattens every project, tags each job with its project, and sorts by attention', () => {\n    const loads: ProjectLoad[] = [\n      {\n        project: 'a',\n        jobs: [job({ id: 'quiet', name: 'quiet_x' })],\n      },\n      {\n        project: 'b',\n        jobs: [\n          job({ id: 'running', name: 'running_x', jdi: { state: 'running', agent: 'a', updated: '' } }),\n          job({ id: 'human', name: 'human_x', jdi: { state: 'stopped:needs-human', agent: 'a', updated: '' } }),\n        ],\n      },\n    ]\n    const sorted = attentionJobs(loads)\n    expect(sorted.map((j) => [j.project, j.id])).toEqual([\n      ['b', 'human'],\n      ['b', 'running'],\n      ['a', 'quiet'],\n    ])\n  })\n\n  it('skips failed loads', () => {\n    const loads: ProjectLoad[] = [\n      { project: 'a', jobs: null },\n      { project: 'b', jobs: [job({ id: 'x', name: 'x_x' })] },\n    ]\n    expect(attentionJobs(loads).map((j) => j.project)).toEqual(['b'])\n  })\n})\n","numLines":85,"startLine":1,"totalLines":85}}}
