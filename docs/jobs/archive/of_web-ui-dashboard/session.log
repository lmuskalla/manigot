{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EsEL1uo8QTz4aeMx2MunNS","type":"tool_result","content":"1\t<script lang=\"ts\">\n2\t  import { onMount } from 'svelte'\n3\t  import { connection } from '$lib/state/connection.svelte'\n4\t  import { toasts } from '$lib/state/toasts.svelte'\n5\t  import SettingsModal from '$lib/components/SettingsModal.svelte'\n6\t  import Confirm from '$lib/components/Confirm.svelte'\n7\t  import { pruneContainers } from '$lib/api/client'\n8\t\n9\t  let showSettings = $state(false)\n10\t  let confirmPrune = $state(false)\n11\t  let pruning = $state(false)\n12\t\n13\t  onMount(() => {\n14\t    void connection.check()\n15\t  })\n16\t\n17\t  async function doPrune() {\n18\t    pruning = true\n19\t    try {\n20\t      const res = await pruneContainers()\n21\t      toasts.ok(\n22\t        `Removed ${res.removed} exited container${res.removed === 1 ? '' : 's'} — ${res.running} manigot container${res.running === 1 ? '' : 's'} running`,\n23\t      )\n24\t      confirmPrune = false\n25\t    } catch (e) {\n26\t      const msg =\n27\t        e instanceof Error &&\n28\t        'capabilityMiss' in e &&\n29\t        (e as { capabilityMiss: boolean }).capabilityMiss\n30\t          ? 'Container pruning lands with job two of the control plane.'\n31\t          : e instanceof Error\n32\t            ? e.message\n33\t            : String(e)\n34\t      toasts.error(msg)\n35\t      confirmPrune = false\n36\t    } finally {\n37\t      pruning = false\n38\t    }\n39\t  }\n40\t</script>\n41\t\n42\t<div class=\"page\">\n43\t  <header class=\"head\">\n44\t    <div>\n45\t      <p class=\"eyebrow\">daemon</p>\n46\t      <h1>mg serve</h1>\n47\t    </div>\n48\t    <button class=\"btn\" onclick={() => (showSettings = true)}>Connection…</button>\n49\t  </header>\n50\t\n51\t  {#if connection.status === 'up' && connection.health}\n52\t    <section class=\"panel\">\n53\t      <div class=\"row\">\n54\t        <span class=\"k\">version</span>\n55\t        <span class=\"v mono\">{connection.health.version || '—'}</span>\n56\t      </div>\n57\t      <div class=\"row\">\n58\t        <span class=\"k\">docker image</span>\n59\t        <span class=\"v\">\n60\t          {#if connection.health.imagePresent}\n61\t            <span class=\"chip chip-done\"><span class=\"dot\"></span> present</span>\n62\t          {:else}\n63\t            <span class=\"chip chip-human\"><span class=\"dot\"></span> missing — run make build</span>\n64\t          {/if}\n65\t        </span>\n66\t      </div>\n67\t      <div class=\"row\">\n68\t        <span class=\"k\">connection</span>\n69\t        <span class=\"v mono\">{connection.baseUrl || '(same origin)'} · {connection.token ? 'bearer token' : 'tokenless'}</span>\n70\t      </div>\n71\t    </section>\n72\t\n73\t    <section class=\"panel\">\n74\t      <header class=\"panel-head\">\n75\t        <h2>Profiles</h2>\n76\t        <p class=\"sub\">Which subscription profiles have credentials ready — booleans only, never the credentials.</p>\n77\t      </header>\n78\t      <ul class=\"profiles\">\n79\t        {#each connection.health.profiles ?? [] as p (p.id)}\n80\t          <li class=\"profile\" class:ready={p.ready}>\n81\t            <span class=\"p-dot\"></span>\n82\t            <span class=\"p-name mono\">{p.id}</span>\n83\t            <span class=\"p-state\">{p.ready ? 'ready' : 'not configured'}</span>\n84\t          </li>\n85\t        {/each}\n86\t      </ul>\n87\t    </section>\n88\t  {:else if connection.status === 'connecting'}\n89\t    <p class=\"loading\">Checking the daemon…</p>\n90\t  {:else}\n91\t    <section class=\"panel down\">\n92\t      <h2>Daemon unreachable</h2>\n93\t      <p class=\"sub\">{connection.lastError}</p>\n94\t      <p class=\"sub\">\n95\t        Start it with <code>mg serve</code> (localhost, tokenless) or point the connection at the\n96\t        right URL and token.\n97\t      </p>\n98\t    </section>\n99\t  {/if}\n100\t\n101\t  <section class=\"panel\">\n102\t    <header class=\"panel-head\">\n103\t      <h2>Maintenance</h2>\n104\t      <p class=\"sub\">The cleanup a headless daemon needs — no terminal required.</p>\n105\t    </header>\n106\t    <div class=\"maint\">\n107\t      <div>\n108\t        <p class=\"m-k\">Prune containers</p>\n109\t        <p class=\"m-d\">Remove exited manigot containers — the residue of abnormal session ends.</p>\n110\t      </div>\n111\t      <button class=\"btn\" onclick={() => (confirmPrune = true)}>Prune…</button>\n112\t    </div>\n113\t    <p class=\"fine\">\n114\t      Orphaned-worktree cleanup lives in each project's jobs view.\n115\t    </p>\n116\t  </section>\n117\t</div>\n118\t\n119\t{#if showSettings}\n120\t  <SettingsModal onclose={() => (showSettings = false)} />\n121\t{/if}\n122\t\n123\t{#if confirmPrune}\n124\t  <Confirm\n125\t    title=\"Prune containers\"\n126\t    body=\"Remove exited manigot containers?\\nRunning containers are never touched.\"\n127\t    confirmLabel=\"Prune\"\n128\t    onconfirm={doPrune}\n129\t    busy={pruning}\n130\t    onclose={() => (confirmPrune = false)}\n131\t  />\n132\t{/if}\n133\t\n134\t<style>\n135\t  .page {\n136\t    max-width: 720px;\n137\t    margin: 0 auto;\n138\t    padding: var(--r-6) var(--r-6) var(--r-7);\n139\t    width: 100%;\n140\t    display: flex;\n141\t    flex-direction: column;\n142\t    gap: var(--r-4);\n143\t  }\n144\t  .head {\n145\t    display: flex;\n146\t    justify-content: space-between;\n147\t    align-items: flex-end;\n148\t    gap: var(--r-4);\n149\t  }\n150\t  h1 {\n151\t    font-size: 24px;\n152\t    letter-spacing: -0.02em;\n153\t  }\n154\t\n155\t  .panel {\n156\t    background: var(--bg-1);\n157\t    border: 1px solid var(--line);\n158\t    border-radius: var(--radius-m);\n159\t    padding: var(--r-4) var(--r-5);\n160\t  }\n161\t  .panel-head h2 {\n162\t    font-size: 15.5px;\n163\t    margin-bottom: 2px;\n164\t  }\n165\t  .panel-head {\n166\t    margin-bottom: var(--r-3);\n167\t  }\n168\t  .sub {\n169\t    co