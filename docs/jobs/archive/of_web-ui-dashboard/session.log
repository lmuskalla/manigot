onents/EmptyState.svelte","content":"<script lang=\"ts\">\n  import type { Snippet } from 'svelte'\n\n  let {\n    title,\n    hint = '',\n    children,\n    action,\n  }: {\n    title: string\n    hint?: string\n    children?: Snippet\n    action?: Snippet\n  } = $props()\n</script>\n\n<div class=\"empty\">\n  <div class=\"mark\" aria-hidden=\"true\">\n    <svg width=\"40\" height=\"16\" viewBox=\"0 0 40 16\" fill=\"none\">\n      <rect x=\"1\" y=\"4\" width=\"8\" height=\"8\" rx=\"2\" stroke=\"var(--line-strong)\" stroke-width=\"1.5\" />\n      <rect x=\"16\" y=\"4\" width=\"8\" height=\"8\" rx=\"2\" stroke=\"var(--line-strong)\" stroke-width=\"1.5\" />\n      <rect x=\"31\" y=\"4\" width=\"8\" height=\"8\" rx=\"2\" stroke=\"var(--line-strong)\" stroke-width=\"1.5\" stroke-dasharray=\"2.5 2.5\" />\n    </svg>\n  </div>\n  <h3>{title}</h3>\n  {#if hint}<p class=\"hint\">{hint}</p>{/if}\n  {#if children}{@render children()}{/if}\n  {#if action}\n    <div class=\"action\">\n      {@render action()}\n    </div>\n  {/if}\n</div>\n\n<style>\n  .empty {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    padding: var(--r-7) var(--r-5);\n    gap: var(--r-2);\n  }\n  h3 {\n    font-size: 16px;\n    color: var(--ink-1);\n  }\n  .hint {\n    color: var(--ink-2);\n    font-size: 13.5px;\n    max-width: 40ch;\n  }\n  .action {\n    margin-top: var(--r-3);\n  }\n</style>\n","numLines":57,"startLine":1,"totalLines":57}}}
