{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AVDS1g3jaEhxucDbg4a54d","type":"tool_result","content":"1\t// API types — pinned to the daemon's actual JSON shapes.\n2\t//\n3\t// Part 1 (shipped, read-only — src/internal/serve/api.go) shapes are exact.\n4\t// Part 2 (mutating + run supervision, per the job-two brief) shapes are the\n5\t// agreed contract; the endpoint paths live in endpoints.ts so they can be\n6\t// re-pinned in one place when the pipeline job lands.\n7\t\n8\t// ── Part 1: read-only (exact) ────────────────────────────────────────────────\n9\t\n10\texport interface HealthProfile {\n11\t  id: string\n12\t  ready: boolean\n13\t}\n14\t\n15\texport interface Health {\n16\t  version: string\n17\t  imagePresent: boolean\n18\t  profiles: HealthProfile[] | null // Go emits null for an empty slice\n19\t}\n20\t\n21\texport interface ProjectRow {\n22\t  name: string\n23\t  path: string\n24\t}\n25\t\n26\texport interface ProjectsResponse {\n27\t  projects: ProjectRow[]\n28\t}\n29\t\n30\t/** mg-jdi activity state for a job, from the status sidecar. */\n31\texport interface JdiStatus {\n32\t  state: 'running' | 'stopped:finished' | 'stopped:needs-human'\n33\t  agent: string\n34\t  updated: string // RFC3339\n35\t}\n36\t\n37\t/** One row in the jobs response — the info design: id/status/stage/type/date/title. */\n38\texport interface JobRow {\n39\t  id: string\n40\t  name: string\n41\t  status: string // \"open\" | \"done\"\n42\t  stage: 'define' | 'plan' | 'implement' | 'review' | 'finished' | string\n43\t  type: string // \"feature\" | \"fix\" | \"chore\"\n44\t  date: string // YYYY-MM-DD\n45\t  title: string\n46\t  branch?: string\n47\t  jdi?: JdiStatus | null\n48\t}\n49\t\n50\texport interface JobsResponse {\n51\t  jobs: JobRow[]\n52\t}\n53\t\n54\texport type JobFileKind = 'brief' | 'tasks' | 'implementation' | 'verdict'\n55\t\n56\t/** GET /projects/{p}/jobs/{j}/jdi — status + captured log tails (null = absent). */\n57\texport interface JobJdiResponse {\n58\t  status: JdiStatus | null\n59\t  runLog: string | null\n60\t  sessionLog: string | null\n61\t}\n62\t\n63\t/** GET /projects/{p}/jobs/{j}/diff — quick eyeball (log+stat) or ?full=1 patch. */\n64\texport interface JobDiffResponse {\n65\t  log?: string | null\n66\t  stat?: string | null\n67\t  patch?: string | null\n68\t}\n69\t\n70\texport interface AgentRow {\n71\t  name: string\n72\t  description: string\n73\t}\n74\t\n75\texport interface AgentsResponse {\n76\t  agents: AgentRow[]\n77\t}\n78\t\n79\t// ── Part 2: mutating + run supervision (per the job-two brief) ───────────────\n80\t\n81\t/** An orphaned worktree surfaced for cleanup (name is what mg delete resolves). */\n82\texport interface OrphanRow {\n83\t  name: string\n84\t  dir?: string\n85\t}\n86\t\n87\texport interface OrphansResponse {\n88\t  orphans: OrphanRow[] | null\n89\t}\n90\t\n91\texport interface PruneResponse {\n92\t  removed: number\n93\t  running: number\n94\t}\n95\t\n96\t/** Result of a detached launch (agent one-shot or mg jdi). */\n97\texport interface LaunchResponse {\n98\t  started: boolean\n99\t  message?: string\n100\t}\n101\t"}]},"parent_tool_use_id":null,"session_id":"7611c08a-6f39-4d7e-9a7e-2c914821d329","uuid":"a9418ba8-e5f7-469d-bca3-d419b96f78cf","timestamp":"2026-08-29T12:50:45.796Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/web-ui/src/lib/api/types.ts","content":"// API types — pinned to the daemon's actual JSON shapes.\n//\n// Part 1 (shipped, read-only — src/internal/serve/api.go) shapes are exact.\n// Part 2 (mutating + run supervision, per the job-two brief) shapes are the\n// agreed contract; the endpoint paths live in endpoints.ts so they can be\n// re-pinned in one place when the pipeline job lands.\n\n// ── Part 1: read-only (exact) ────────────────────────────────────────────────\n\nexport interface HealthProfile {\n  id: string\n  ready: boolean\n}\n\nexport interface Health {\n  version: string\n  imagePresent: boolean\n  profiles: HealthProfile[] | null // Go emits null for an empty slice\n}\n\nexport interface ProjectRow {\n  name: string\n  path: string\n}\n\nexport interface ProjectsResponse {\n  projects: ProjectRow[]\n}\n\n/** mg-jdi activity state for a job, from the status sidecar. */\nexport interface JdiStatus {\n  state: 'running' | 'stopped:finished' | 'stopped:needs-human'\n  agent: string\n  updated: string // RFC3339\n}\n\n/** One row in the jobs response — the info design: id/status/stage/type/date/title. */\nexport interface JobRow {\n  id: string\n  name: string\n  status: string // \"open\" | \"done\"\n  stage: 'define' | 'plan' | 'implement' | 'review' | 'finished' | string\n  type: string // \"feature\" | \"fix\" | \"chore\"\n  date: string // YYYY-MM-DD\n  title: string\n  branch?: string\n  jdi?: JdiStatus | null\n}\n\nexport interface JobsResponse {\n  jobs: JobRow[]\n}\n\nexport type JobFileKind = 'brief' | 'tasks' | 'implementation' | 'verdict'\n\n/** GET /projects/{p}/jobs/{j}/jdi — status + captured log tails (null = absent). */\nexport interface JobJdiResponse {\n  status: JdiStatus | null\n  runLog: string | null\n  sessionLog: string | null\n}\n\n/** GET /projects/{p}/jobs/{j}/diff — quick eyeball (log+stat) or ?full=1 patch. */\nexport interface JobDiffResponse {\n  log?: string | null\n  stat?: string | null\n  patch?: string | null\n}\n\nexport interface AgentRow {\n  name: string\n  description: string\n}\n\nexport interface AgentsResponse {\n  agents: AgentRow[]\n}\n\n// ── Part 2: mutating + run supervision (per the job-two brief) ───────────────\n\n/** An orphaned worktree surfaced for cleanup (name is what mg delete resolves). */\nexport interface OrphanRow {\n  name: string\n  dir?: string\n}\n\nexport interface OrphansResponse {\n  orphans: OrphanRow[] | null\n}\n\nexport interface PruneResponse {\n  removed: number\n  running: number\n}\n\n/** Result of a detached launch (agent one-shot or mg jdi). */\nexport interface LaunchResponse {\n  started: boolean\n  message?: string\n}\n","numLines":101,"startLine":1,"totalLines":101}}}
