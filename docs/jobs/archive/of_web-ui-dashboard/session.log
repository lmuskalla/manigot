{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KL7BAqiN2va7Xgp7H17yZi","type":"tool_result","content":"1\t// Cross-project aggregation for the dashboard (DashboardView.svelte) — pure\n2\t// functions over the per-project job lists the view fans out for with\n3\t// Promise.allSettled, kept separate from the component so the counting and\n4\t// attention-sorting logic is unit-testable without rendering anything\n5\t// (mirrors stage.ts's own attention()/sortByAttention()).\n6\t\n7\timport { attention, sortByAttention } from '$lib/stage'\n8\timport type { JobRow } from '$lib/api/types'\n9\t\n10\t/** One project's job list — `jobs: null` marks a failed per-project fetch. */\n11\texport interface ProjectLoad {\n12\t  project: string\n13\t  jobs: JobRow[] | null\n14\t}\n15\t\n16\t/** A job flattened out of its project, for the cross-project attention list. */\n17\texport interface DashboardJob extends JobRow {\n18\t  project: string\n19\t}\n20\t\n21\texport interface DashboardCounts {\n22\t  /** Projects the dashboard has (attempted to) load jobs for. */\n23\t  projects: number\n24\t  openJobs: number\n25\t  needsHuman: number\n26\t  running: number\n27\t}\n28\t\n29\t/** Aggregate counts across every successfully-loaded project. Failed loads\n30\t * (`jobs: null`) are skipped, not counted as zero — a project that couldn't\n31\t * load must not silently look \"all clear\". */\n32\texport function aggregateCounts(loads: ProjectLoad[]): DashboardCounts {\n33\t  let openJobs = 0\n34\t  let needsHuman = 0\n35\t  let running = 0\n36\t  for (const load of loads) {\n37\t    if (!load.jobs) continue\n38\t    for (const job of load.jobs) {\n39\t      if (job.status === 'open') openJobs++\n40\t      const level = attention(job).level\n41\t      if (level === 0) needsHuman++\n42\t      else if (level === 1) running++\n43\t    }\n44\t  }\n45\t  return { projects: loads.length, openJobs, needsHuman, running }\n46\t}\n47\t\n48\t/** Every job across every successfully-loaded project, tagged with its\n49\t * project and attention-sorted (needs-human, then running, then quiet). */\n50\texport function attentionJobs(loads: ProjectLoad[]): DashboardJob[] {\n51\t  const flat: DashboardJob[] = []\n52\t  for (const load of loads) {\n53\t    if (!load.jobs) continue\n54\t    for (const job of load.jobs) flat.push({ ...job, project: load.project })\n55\t  }\n56\t  return sortByAttention(flat)\n57\t}\n58\t"}]},"parent_tool_use_id":null,"session_id":"922db0ba-8634-4cea-a4ec-b27bd027a32b","uuid":"183a4b9d-553b-47f8-b717-01ab9b607792","timestamp":"2026-08-29T12:58:27.600Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/web-ui/src/lib/dashboard.ts","content":"// Cross-project aggregation for the dashboard (DashboardView.svelte) — pure\n// functions over the per-project job lists the view fans out for with\n// Promise.allSettled, kept separate from the component so the counting and\n// attention-sorting logic is unit-testable without rendering anything\n// (mirrors stage.ts's own attention()/sortByAttention()).\n\nimport { attention, sortByAttention } from '$lib/stage'\nimport type { JobRow } from '$lib/api/types'\n\n/** One project's job list — `jobs: null` marks a failed per-project fetch. */\nexport interface ProjectLoad {\n  project: string\n  jobs: JobRow[] | null\n}\n\n/** A job flattened out of its project, for the cross-project attention list. */\nexport interface DashboardJob extends JobRow {\n  project: string\n}\n\nexport interface DashboardCounts {\n  /** Projects the dashboard has (attempted to) load jobs for. */\n  projects: number\n  openJobs: number\n  needsHuman: number\n  running: number\n}\n\n/** Aggregate counts across every successfully-loaded project. Failed loads\n * (`jobs: null`) are skipped, not counted as zero — a project that couldn't\n * load must not silently look \"all clear\". */\nexport function aggregateCounts(loads: ProjectLoad[]): DashboardCounts {\n  let openJobs = 0\n  let needsHuman = 0\n  let running = 0\n  for (const load of loads) {\n    if (!load.jobs) continue\n    for (const job of load.jobs) {\n      if (job.status === 'open') openJobs++\n      const level = attention(job).level\n      if (level === 0) needsHuman++\n      else if (level === 1) running++\n    }\n  }\n  return { projects: loads.length, openJobs, needsHuman, running }\n}\n\n/** Every job across every successfully-loaded project, tagged with its\n * project and attention-sorted (needs-human, then running, then quiet). */\nexport function attentionJobs(loads: ProjectLoad[]): DashboardJob[] {\n  const flat: DashboardJob[] = []\n  for (const load of loads) {\n    if (!load.jobs) continue\n    for (const job of load.jobs) flat.push({ ...job, project: load.project })\n  }\n  return sortByAttention(flat)\n}\n","numLines":58,"startLine":1,"totalLines":58}}}
