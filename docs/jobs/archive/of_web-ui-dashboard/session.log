{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KTHYKMH36wUj8NGJwbXhU8","type":"tool_result","content":"1\t<script lang=\"ts\">\n2\t  import { onMount } from 'svelte'\n3\t  import Pipeline from '$lib/components/Pipeline.svelte'\n4\t  import EmptyState from '$lib/components/EmptyState.svelte'\n5\t  import Modal from '$lib/components/Modal.svelte'\n6\t  import Confirm from '$lib/components/Confirm.svelte'\n7\t  import { data } from '$lib/state/data.svelte'\n8\t  import { toasts } from '$lib/state/toasts.svelte'\n9\t  import { attention } from '$lib/stage'\n10\t  import { relativeTime } from '$lib/time'\n11\t  import { href } from '$lib/router'\n12\t  import * as api from '$lib/api/client'\n13\t  import type { JobRow, OrphanRow } from '$lib/api/types'\n14\t\n15\t  let { project }: { project: string } = $props()\n16\t\n17\t  let filter = $state<'all' | 'human' | 'running'>('all')\n18\t  let typeFilter = $state('')\n19\t  let search = $state('')\n20\t  let showNew = $state(false)\n21\t\n22\t  // new-job form\n23\t  let newTitle = $state('')\n24\t  let newType = $state('feature')\n25\t  let creating = $state(false)\n26\t\n27\t  // orphans (Part 2 — silently absent on a read-only daemon)\n28\t  let orphans = $state<OrphanRow[]>([])\n29\t  let orphansAvailable = $state(true)\n30\t  let confirmOrphans = $state(false)\n31\t  let removingOrphans = $state(false)\n32\t\n33\t  $effect(() => {\n34\t    // reload the list when the route's project changes\n35\t    project\n36\t    void data.refreshJobs()\n37\t    void loadOrphans()\n38\t  })\n39\t\n40\t  onMount(() => {\n41\t    data.startPolling()\n42\t    return () => data.stopPolling()\n43\t  })\n44\t\n45\t  async function loadOrphans() {\n46\t    try {\n47\t      const res = await api.getOrphans(project)\n48\t      orphans = res.orphans ?? []\n49\t      orphansAvailable = true\n50\t    } catch {\n51\t      orphans = []\n52\t      orphansAvailable = false\n53\t    }\n54\t  }\n55\t\n56\t  const filtered = $derived.by(() => {\n57\t    let jobs = data.active === project ? data.jobs : []\n58\t    if (filter === 'human') jobs = jobs.filter((j) => j.jdi?.state === 'stopped:needs-human')\n59\t    if (filter === 'running') jobs = jobs.filter((j) => j.jdi?.state === 'running')\n60\t    if (typeFilter) jobs = jobs.filter((j) => j.type === typeFilter)\n61\t    const needle = search.trim().toLowerCase()\n62\t    if (needle) {\n63\t      jobs = jobs.filter(\n64\t        (j) =>\n65\t          j.title.toLowerCase().includes(needle) ||\n66\t          j.name.toLowerCase().includes(needle) ||\n67\t          j.id.toLowerCase().includes(needle),\n68\t      )\n69\t    }\n70\t    return [...jobs].sort((a, b) => attention(a).level - attention(b).level)\n71\t  })\n72\t\n73\t  const counts = $derived.by(() => {\n74\t    const jobs = data.active === project ? data.jobs : []\n75\t    return {\n76\t      all: jobs.length,\n77\t      human: jobs.filter((j) => j.jdi?.state === 'stopped:needs-human').length,\n78\t      running: jobs.filter((j) => j.jdi?.state === 'running').length,\n79\t    }\n80\t  })\n81\t\n82\t  async function createJob() {\n83\t    creating = true\n84\t    try {\n85\t      const res = await api.createJob(project, newTitle.trim(), newType)\n86\t      toasts.ok(`Job scaffolded — ${typeof res.job === 'string' ? res.job : res.job?.name ?? newTitle}`)\n87\t      showNew = false\n88\t      newTitle = ''\n89\t      newType = 'feature'\n90\t      await data.refreshJobs()\n91\t    } catch (e) {\n92\t      toasts.error(actionError(e, 'create jobs'))\n93\t    } finally {\n94\t      creating = false\n95\t    }\n96\t  }\n97\t\n98\t  async function removeOrphans() {\n99\t    removingOrphans = true\n100\t    try {\n101\t      const res = await api.removeOrphans(project)\n102\t      toasts.ok(res.message ?? 'Orphaned worktrees removed')\n103\t      confirmOrphans = false\n104\t      await loadOrphans()\n105\t    } catch (e) {\n106\t      toasts.error(actionError(e, 'remove orphans'))\n107\t    } finally {\n108\t      removingOrphans = false\n109\t    }\n110\t  }\n111\t\n112\t  /** Degrade path: Part 2 calls on a Part 1 daemon read as a clear miss. */\n113\t  function actionError(e: unknown, what: string): string {\n114\t    if (e instanceof api.ApiError && e.capabilityMiss) {\n115\t      return `This daemon does not expose ${what} yet — mutating endpoints land with job two of the control plane.`\n116\t    }\n117\t    return e instanceof Error ? e.message : String(e)\n118\t  }\n119\t</script>\n120\t\n121\t<div class=\"page\">\n122\t  <header class=\"head\">\n123\t    <div>\n124\t      <p class=\"eyebrow\">jobs</p>\n125\t      <h1>{project}</h1>\n126\t    </div>\n127\t    <div class=\"head-actions\">\n128\t      <input\n129\t        class=\"input search\"\n130\t        placeholder=\"Filter by title, name, id…\"\n131\t        bind:value={search}\n132\t        spellcheck=\"false\"\n133\t        aria-label=\"Filter jobs\"\n134\t      />\n135\t      <button class=\"btn btn-primary\" onclick={() => (showNew = true)}>＋ New job</button>\n136\t    </div>\n137\t  </header>\n138\t\n139\t  <div class=\"filters\">\n140\t    <div class=\"seg-group\" role=\"group\" aria-label=\"Filter by run state\">\n141\t      <button aria-pressed={filter === 'all'} onclick={() => (filter = 'all')}>\n142\t        All {counts.all}\n143\t      </button>\n144\t      <button aria-pressed={filter === 'human'} onclick={() => (filter = 'human')}>\n145\t        Needs human {counts.human}\n146\t      </button>\n147\t      <button aria-pressed={filter === 'running'} onclick={() => (filter = 'running')}>\n148\t        Running {counts.running}\n149\t      </button>\n150\t    </div>\n151\t    <div class=\"seg-group\" role=\"group\" aria-label=\"Filter by type\">\n152\t      <button aria-pressed={typeFilter === ''} onclick={() => (typeFilter = '')}>any type</button>\n153\t      {#each ['feature', 'fix', 'chore'] as t (t)}\n154\t        <button aria-pressed={typeFilter === t} onclick={() => (typeFilter = t)}>{t}</button>\n155\t      {/each}\n156\t    </div>\n157\t  </div>\n158\t\n159\t  {#if data.jobsError}\n160\t    <div class=\"error\" role=\"alert\">{data.jobsError}</div>\n161\t  {/if}\n162\t\n163\t  {#if filtered.length === 0 && !data.loadingJobs && !data.jobsError}\n164\t    <EmptyState\n165\t      title={data.jobs.length === 0 ? 'No open jobs' : 'Nothing matches'}\n166\t      hint={data.jobs.length === 0\n167\t        ? 'A job scaffolds brief.md, a branch and its own worktree — everything the crew needs to start.'\n168\t        : 'Loosen the filters or clear the search.'}\n169\t    >\n170\t      {#snippet children()}\n171\t        {#if data.jobs.length === 0}\n172\t          <button class=\"btn\" onclick={() => (showNew = true)}>Scaffold the first job</button>\n173\t        {/if}\n174\t      {/snippet}\n175\t    </EmptyState>\n176\t  {:else}\n177\t    <ul class=\"jobs\" role=\"list\">\n178\t      {#each filtered as job (job.name)}\n179\t        <li>\n180\t          <a\n181\t            class=\"job\"\n182\t            class:needs-human={job.jdi?.state === 'stopped:needs-human'}\n183\t            href={href({ name: 'job', project, job: job.name })}\n184\t          >\n185\t            <div class=\"left\">\n186\t              <Pipeline stage={job.stage} jdi={job.jdi} variant=\"mini\" />\n187\t              <div class=\"ident\">\n188\t                <span class=\"title\">{job.title}</span>\n189\t                <span class=\"name\">{job.name}</span>\n190\t              </div>\n191\t            </div>\n192\t            <div class=\"meta\">\n193\t              {#if job.jdi?.state === 'stopped:needs-human'}\n194\t                <span class=\"chip chip-human\"><span class=\"dot\"></span> needs human</span>\n195\t              {:else if job.jdi?.state === 'running'}\n196\t                <span class=\"chip chip-running\"><span class=\"dot\"></span> {job.jdi.agent} running</span>\n197\t              {/if}\n198\t              <span class=\"chip\" class:chip-open={job.status === 'open'} class:chip-done={job.status === 'done'}>\n199\t                <span class=\"dot\"></span> {job.status}\n200\t              </span>\n201\t              <span class=\"chip chip-neutral\">{job.type}</span>\n202\t              <span class=\"when\" title={job.jdi ? job.jdi.updated : job.date}>\n203\t                {job.jdi ? relativeTime(job.jdi.updated) : job.date}\n204\t              </span>\n205\t            </div>\n206\t          </a>\n207\t        </li>\n208\t      {/each}\n209\t    </ul>\n210\t  {/if}\n211\t\n212\t  {#if orphans.length > 0}\n213\t    <section class=\"orphans\" aria-label=\"Orphaned worktrees\">\n214\t      <div class=\"orphans-head\">\n215\t        <div>\n216\t          <p class=\"eyebrow\">leftovers</p>\n217\t          <h2>Orphaned worktrees</h2>\n218\t          <p class=\"hint\">\n219\t            Directories whose git registration is gone — safe to remove; their jobs are already abandoned.\n220\t          </p>\n221\t        </div>\n222\t        <button class=\"btn\" onclick={() => (confirmOrphans = true)}>Clean up…</button>\n223\t      </div>\n224\t      <ul>\n225\t        {#each orphans as o (o.name)}\n226\t          <li><code>{o.name}</code></li>\n227\t        {/each}\n228\t      </ul>\n229\t    </section>\n230\t  {:else if !orphansAvailable}\n231\t    <!-- Part 2 endpoint absent on this daemon — nothing to show. -->\n232\t  {/if}\n233\t</div>\n234\t\n235\t{#if showNew}\n236\t  <Modal title=\"New job\" busy={creating} onclose={() => (showNew = false)} width=\"480px\">\n237\t    <div class=\"field\">\n238\t      <label for=\"nj-title\">title</label>\n239\t      <input\n240\t        id=\"nj-title\"\n241\t        class=\"input\"\n242\t        bind:value={newTitle}\n243\t        placeholder=\"What is this job about?\"\n244\t        onkeydown={(e) => e.key === 'Enter' && newTitle.trim() && createJob()}\n245\t      />\n246\t      <p class=\"hint\">The title seeds the slug — keep it short and plain.</p>\n247\t    </div>\n248\t    <div class=\"field\">\n249\t      <label for=\"nj-type\">type</label>\n250\t      <select id=\"nj-type\" class=\"select\" bind:value={newType}>\n251\t        <option value=\"feature\">feature — new capability</option>\n252\t        <option value=\"fix\">fix — something is broken</option>\n253\t        <option value=\"chore\">chore — cleanup, deps, tooling</option>\n254\t      </select>\n255\t    </div>\n256\t    {#snippet footer()}\n257\t      <button class=\"btn\" onclick={() => (showNew = false)} disabled={creating}>Cancel</button>\n258\t      <button class=\"btn btn-primary\" onclick={createJob} disabled={creating || !newTitle.trim()}>\n259\t        {#if creating}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n260\t        Scaffold job\n261\t      </button>\n262\t    {/snippet}\n263\t  </Modal>\n264\t{/if}\n265\t\n266\t{#if confirmOrphans}\n267\t  <Confirm\n268\t    title=\"Remove orphaned worktrees\"\n269\t    body={'Remove ' +\n270\t      orphans.length +\n271\t      ' orphaned worktree' +\n272\t      (orphans.length === 1 ? '' : 's') +\n273\t      '?\\nThis cannot be undone.'}\n274\t    confirmLabel=\"Remove\"\n275\t    confirmKind=\"danger\"\n276\t    busy={removingOrphans}\n277\t    onconfirm={removeOrphans}\n278\t    onclose={() => (confirmOrphans = false)}\n279\t  />\n280\t{/if}\n281\t\n282\t<style>\n283\t  .page {\n284\t    padding: var(--r-6) var(--r-6) var(--r-7);\n285\t    max-width: 1060px;\n286\t    margin: 0 auto;\n287\t    width: 100%;\n288\t  }\n289\t\n290\t  .head {\n291\t    display: flex;\n292\t    align-items: flex-end;\n293\t    justify-content: space-between;\n294\t    gap: var(--r-4);\n295\t    flex-wrap: wrap;\n296\t    margin-bottom: var(--r-4);\n297\t  }\n298\t  h1 {\n299\t    font-size: 24px;\n300\t    letter-spacing: -0.02em;\n301\t  }\n302\t  .head .eyebrow {\n303\t    margin: 0 0 2px;\n304\t  }\n305\t  .head-actions {\n306\t    display: flex;\n307\t    gap: var(--r-2);\n308\t    align-items: center;\n309\t  }\n310\t  .search {\n311\t    width: min(280px, 60vw);\n312\t  }\n313\t\n314\t  .filters {\n315\t    display: flex;\n316\t    gap: var(--r-3);\n317\t    flex-wrap: wrap;\n318\t    margin-bottom: var(--r-4);\n319\t  }\n320\t\n321\t  .error {\n322\t    background: var(--st-human-dim);\n323\t    border: 1px solid rgba(242, 85, 90, 0.4);\n324\t    color: #ffb3b6;\n325\t    padding: var(--r-3) var(--r-4);\n326\t    border-radius: var(--radius-m);\n327\t    font-size: 13.5px;\n328\t    margin-bottom: var(--r-4);\n329\t  }\n330\t\n331\t  .jobs {\n332\t    list-style: none;\n333\t    margin: 0;\n334\t    padding: 0;\n335\t    display: flex;\n336\t    flex-direction: column;\n337\t    gap: 8px;\n338\t  }\n339\t\n340\t  .job {\n341\t    display: flex;\n342\t    align-items: center;\n343\t    justify-content: space-between;\n344\t    gap: var(--r-3) var(--r-4);\n345\t    flex-wrap: wrap;\n346\t    padding: 14px 18px;\n347\t    background: var(--bg-1);\n348\t    border: 1px solid var(--line);\n349\t    border-radius: var(--radius-m);\n350\t    text-decoration: none;\n351\t    color: var(--ink-0);\n352\t    transition:\n353\t      border-color var(--t-fast),\n354\t      background var(--t-fast),\n355\t      transform var(--t-fast);\n356\t  }\n357\t  .job:hover {\n358\t    border-color: var(--line-strong);\n359\t    background: var(--bg-2);\n360\t    text-decoration: none;\n361\t    transform: translateY(-1px);\n362\t  }\n363\t  .job.needs-human {\n364\t    border-color: rgba(242, 85, 90, 0.4);\n365\t    background: linear-gradient(90deg, rgba(242, 85, 90, 0.05), transparent 200px), var(--bg-1);\n366\t  }\n367\t\n368\t  .left {\n369\t    display: flex;\n370\t    align-items: center;\n371\t    gap: var(--r-5);\n372\t    min-width: 0;\n373\t    flex: 1 1 240px; /* below 240px of text room, the meta column wraps under */\n374\t  }\n375\t  .ident {\n376\t    display: flex;\n377\t    flex-direction: column;\n378\t    min-width: 0;\n379\t  }\n380\t  .title {\n381\t    font-weight: 590;\n382\t    font-size: 15px;\n383\t    white-space: nowrap;\n384\t    overflow: hidden;\n385\t    text-overflow: ellipsis;\n386\t  }\n387\t  .name {\n388\t    font-family: var(--font-mono);\n389\t    font-size: 12px;\n390\t    color: var(--ink-2);\n391\t    white-space: nowrap;\n392\t    overflow: hidden;\n393\t    text-overflow: ellipsis;\n394\t  }\n395\t\n396\t  .meta {\n397\t    display: flex;\n398\t    align-items: center;\n399\t    gap: 8px;\n400\t    flex: 0 1 auto;\n401\t    flex-wrap: wrap;\n402\t  }\n403\t  .when {\n404\t    font-size: 12px;\n405\t    color: var(--ink-2);\n406\t    min-width: 70px;\n407\t    text-align: right;\n408\t  }\n409\t\n410\t  .orphans {\n411\t    margin-top: var(--r-6);\n412\t    border: 1px dashed var(--line-strong);\n413\t    border-radius: var(--radius-m);\n414\t    padding: var(--r-4) var(--r-5);\n415\t  }\n416\t  .orphans-head {\n417\t    display: flex;\n418\t    justify-content: space-between;\n419\t    align-items: flex-start;\n420\t    gap: var(--r-4);\n421\t  }\n422\t  .orphans h2 {\n423\t    font-size: 16px;\n424\t  }\n425\t  .hint {\n426\t    color: var(--ink-2);\n427\t    font-size: 13px;\n428\t    max-width: 52ch;\n429\t  }\n430\t  .orphans ul {\n431\t    list-style: none;\n432\t    margin: var(--r-3) 0 0;\n433\t    padding: 0;\n434\t    display: flex;\n435\t    flex-direction: column;\n436\t    gap: 4px;\n437\t  }\n438\t  .orphans code {\n439\t    color: var(--st-open);\n440\t    font-size: 12.5px;\n441\t  }\n442\t\n443\t  @media (max-width: 760px) {\n444\t    .page {\n445\t      padding: var(--r-4) var(--r-4) var(--r-6);\n446\t    }\n447\t    .job {\n448\t      flex-direction: column;\n449\t      align-items: flex-start;\n450\t      gap: var(--r-3);\n451\t    }\n452\t    .left {\n453\t      flex-direction: column;\n454\t      align-items: flex-start;\n455\t      gap: var(--r-2);\n456\t      flex: none;\n457\t      width: 100%;\n458\t    }\n459\t    .ident {\n460\t      width: 100%;\n461\t    }\n462\t    .meta {\n463\t      flex-wrap: wrap;\n464\t    }\n465\t    .when {\n466\t      text-align: left;\n467\t      min-width: 0;\n468\t    }\n469\t    .search {\n470\t      width: 100%;\n471\t    }\n472\t    .head-actions {\n473\t      width: 100%;\n474\t    }\n475\t  }\n476\t</style>\n477\t"}]},"parent_tool_use_id":null,"session_id":"7611c08a-6f39-4d7e-9a7e-2c914821d329","uuid":"8cb7e1e1-eab2-4dc5-9996-0cad1e79eaf0","timestamp":"2026-08-29T12:50:50.636Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/web-ui/src/lib/views/JobsView.svelte","content":"<script lang=\"ts\">\n  import { onMount } from 'svelte'\n  import Pipeline from '$lib/components/Pipeline.svelte'\n  import EmptyState from '$lib/components/EmptyState.svelte'\n  import Modal from '$lib/components/Modal.svelte'\n  import Confirm from '$lib/components/Confirm.svelte'\n  import { data } from '$lib/state/data.svelte'\n  import { toasts } from '$lib/state/toasts.svelte'\n  import { attention } from '$lib/stage'\n  import { relativeTime } from '$lib/time'\n  import { href } from '$lib/router'\n  import * as api from '$lib/api/client'\n  import type { JobRow, OrphanRow } from '$lib/api/types'\n\n  let { project }: { project: string } = $props()\n\n  let filter = $state<'all' | 'human' | 'running'>('all')\n  let typeFilter = $state('')\n  let search = $state('')\n  let showNew = $state(false)\n\n  // new-job form\n  let newTitle = $state('')\n  let newType = $state('feature')\n  let creating = $state(false)\n\n  // orphans (Part 2 — silently absent on a read-only daemon)\n  let orphans = $state<OrphanRow[]>([])\n  let orphansAvailable = $state(true)\n  let confirmOrphans = $state(false)\n  let removingOrphans = $state(false)\n\n  $effect(() => {\n    // reload the list when the route's project changes\n    project\n    void data.refreshJobs()\n    void loadOrphans()\n  })\n\n  onMount(() => {\n    data.startPolling()\n    return () => data.stopPolling()\n  })\n\n  async function loadOrphans() {\n    try {\n      const res = await api.getOrphans(project)\n      orphans = res.orphans ?? []\n      orphansAvailable = true\n    } catch {\n      orphans = []\n      orphansAvailable = false\n    }\n  }\n\n  const filtered = $derived.by(() => {\n    let jobs = data.active === project ? data.jobs : []\n    if (filter === 'human') jobs = jobs.filter((j) => j.jdi?.state === 'stopped:needs-human')\n    if (filter === 'running') jobs = jobs.filter((j) => j.jdi?.state === 'running')\n    if (typeFilter) jobs = jobs.filter((j) => j.type === typeFilter)\n    const needle = search.trim().toLowerCase()\n    if (needle) {\n      jobs = jobs.filter(\n        (j) =>\n          j.title.toLowerCase().includes(needle) ||\n          j.name.toLowerCase().includes(needle) ||\n          j.id.toLowerCase().includes(needle),\n      )\n    }\n    return [...jobs].sort((a, b) => attention(a).level - attention(b).level)\n  })\n\n  const counts = $derived.by(() => {\n    const jobs = data.active === project ? data.jobs : []\n    return {\n      all: jobs.length,\n      human: jobs.filter((j) => j.jdi?.state === 'stopped:needs-human').length,\n      running: jobs.filter((j) => j.jdi?.state === 'running').length,\n    }\n  })\n\n  async function createJob() {\n    creating = true\n    try {\n      const res = await api.createJob(project, newTitle.trim(), newType)\n      toasts.ok(`Job scaffolded — ${typeof res.job === 'string' ? res.job : res.job?.name ?? newTitle}`)\n      showNew = false\n      newTitle = ''\n      newType = 'feature'\n      await data.refreshJobs()\n    } catch (e) {\n      toasts.error(actionError(e, 'create jobs'))\n    } finally {\n      creating = false\n    }\n  }\n\n  async function removeOrphans() {\n    removingOrphans = true\n    try {\n      const res = await api.removeOrphans(project)\n      toasts.ok(res.message ?? 'Orphaned worktrees removed')\n      confirmOrphans = false\n      await loadOrphans()\n    } catch (e) {\n      toasts.error(actionError(e, 'remove orphans'))\n    } finally {\n      removingOrphans = false\n    }\n  }\n\n  /** Degrade path: Part 2 calls on a Part 1 daemon read as a clear miss. */\n  function actionError(e: unknown, what: string): string {\n    if (e instanceof api.ApiError && e.capabilityMiss) {\n      return `This daemon does not expose ${what} yet — mutating endpoints land with job two of the control plane.`\n    }\n    return e instanceof Error ? e.message : String(e)\n  }\n</script>\n\n<div class=\"page\">\n  <header class=\"head\">\n    <div>\n      <p class=\"eyebrow\">jobs</p>\n      <h1>{project}</h1>\n    </div>\n    <div class=\"head-actions\">\n      <input\n        class=\"input search\"\n        placeholder=\"Filter by title, name, id…\"\n        bind:value={search}\n        spellcheck=\"false\"\n        aria-label=\"Filter jobs\"\n      />\n      <button class=\"btn btn-primary\" onclick={() => (showNew = true)}>＋ New job</button>\n    </div>\n  </header>\n\n  <div class=\"filters\">\n    <div class=\"seg-group\" role=\"group\" aria-label=\"Filter by run state\">\n      <button aria-pressed={filter === 'all'} onclick={() => (filter = 'all')}>\n        All {counts.all}\n      </button>\n      <button aria-pressed={filter === 'human'} onclick={() => (filter = 'human')}>\n        Needs human {counts.human}\n      </button>\n      <button aria-pressed={filter === 'running'} onclick={() => (filter = 'running')}>\n        Running {counts.running}\n      </button>\n    </div>\n    <div class=\"seg-group\" role=\"group\" aria-label=\"Filter by type\">\n      <button aria-pressed={typeFilter === ''} onclick={() => (typeFilter = '')}>any type</button>\n      {#each ['feature', 'fix', 'chore'] as t (t)}\n        <button aria-pressed={typeFilter === t} onclick={() => (typeFilter = t)}>{t}</button>\n      {/each}\n    </div>\n  </div>\n\n  {#if data.jobsError}\n    <div class=\"error\" role=\"alert\">{data.jobsError}</div>\n  {/if}\n\n  {#if filtered.length === 0 && !data.loadingJobs && !data.jobsError}\n    <EmptyState\n      title={data.jobs.length === 0 ? 'No open jobs' : 'Nothing matches'}\n      hint={data.jobs.length === 0\n        ? 'A job scaffolds brief.md, a branch and its own worktree — everything the crew needs to start.'\n        : 'Loosen the filters or clear the search.'}\n    >\n      {#snippet children()}\n        {#if data.jobs.length === 0}\n          <button class=\"btn\" onclick={() => (showNew = true)}>Scaffold the first job</button>\n        {/if}\n      {/snippet}\n    </EmptyState>\n  {:else}\n    <ul class=\"jobs\" role=\"list\">\n      {#each filtered as job (job.name)}\n        <li>\n          <a\n            class=\"job\"\n            class:needs-human={job.jdi?.state === 'stopped:needs-human'}\n            href={href({ name: 'job', project, job: job.name })}\n          >\n            <div class=\"left\">\n              <Pipeline stage={job.stage} jdi={job.jdi} variant=\"mini\" />\n              <div class=\"ident\">\n                <span class=\"title\">{job.title}</span>\n                <span class=\"name\">{job.name}</span>\n              </div>\n            </div>\n            <div class=\"meta\">\n              {#if job.jdi?.state === 'stopped:needs-human'}\n                <span class=\"chip chip-human\"><span class=\"dot\"></span> needs human</span>\n              {:else if job.jdi?.state === 'running'}\n                <span class=\"chip chip-running\"><span class=\"dot\"></span> {job.jdi.agent} running</span>\n              {/if}\n              <span class=\"chip\" class:chip-open={job.status === 'open'} class:chip-done={job.status === 'done'}>\n                <span class=\"dot\"></span> {job.status}\n              </span>\n              <span class=\"chip chip-neutral\">{job.type}</span>\n              <span class=\"when\" title={job.jdi ? job.jdi.updated : job.date}>\n                {job.jdi ? relativeTime(job.jdi.updated) : job.date}\n              </span>\n            </div>\n          </a>\n        </li>\n      {/each}\n    </ul>\n  {/if}\n\n  {#if orphans.length > 0}\n    <section class=\"orphans\" aria-label=\"Orphaned worktrees\">\n      <div class=\"orphans-head\">\n        <div>\n          <p class=\"eyebrow\">leftovers</p>\n          <h2>Orphaned worktrees</h2>\n          <p class=\"hint\">\n            Directories whose git registration is gone — safe to remove; their jobs are already abandoned.\n          </p>\n        </div>\n        <button class=\"btn\" onclick={() => (confirmOrphans = true)}>Clean up…</button>\n      </div>\n      <ul>\n        {#each orphans as o (o.name)}\n          <li><code>{o.name}</code></li>\n        {/each}\n      </ul>\n    </section>\n  {:else if !orphansAvailable}\n    <!-- Part 2 endpoint absent on this daemon — nothing to show. -->\n  {/if}\n</div>\n\n{#if showNew}\n  <Modal title=\"New job\" busy={creating} onclose={() => (showNew = false)} width=\"480px\">\n    <div class=\"field\">\n      <label for=\"nj-title\">title</label>\n      <input\n        id=\"nj-title\"\n        class=\"input\"\n        bind:value={newTitle}\n        placeholder=\"What is this job about?\"\n        onkeydown={(e) => e.key === 'Enter' && newTitle.trim() && createJob()}\n      />\n      <p class=\"hint\">The title seeds the slug — keep it short and plain.</p>\n    </div>\n    <div class=\"field\">\n      <label for=\"nj-type\">type</label>\n      <select id=\"nj-type\" class=\"select\" bind:value={newType}>\n        <option value=\"feature\">feature — new capability</option>\n        <option value=\"fix\">fix — something is broken</option>\n        <option value=\"chore\">chore — cleanup, deps, tooling</option>\n      </select>\n    </div>\n    {#snippet footer()}\n      <button class=\"btn\" onclick={() => (showNew = false)} disabled={creating}>Cancel</button>\n      <button class=\"btn btn-primary\" onclick={createJob} disabled={creating || !newTitle.trim()}>\n        {#if creating}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n        Scaffold job\n      </button>\n    {/snippet}\n  </Modal>\n{/if}\n\n{#if confirmOrphans}\n  <Confirm\n    title=\"Remove orphaned worktrees\"\n    body={'Remove ' +\n      orphans.length +\n      ' orphaned worktree' +\n      (orphans.length === 1 ? '' : 's') +\n      '?\\nThis cannot be undone.'}\n    confirmLabel=\"Remove\"\n    confirmKind=\"danger\"\n    busy={removingOrphans}\n    onconfirm={removeOrphans}\n    onclose={() => (confirmOrphans = false)}\n  />\n{/if}\n\n<style>\n  .page {\n    padding: var(--r-6) var(--r-6) var(--r-7);\n    max-width: 1060px;\n    margin: 0 auto;\n    width: 100%;\n  }\n\n  .head {\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    gap: var(--r-4);\n    flex-wrap: wrap;\n    margin-bottom: var(--r-4);\n  }\n  h1 {\n    font-size: 24px;\n    letter-spacing: -0.02em;\n  }\n  .head .eyebrow {\n    margin: 0 0 2px;\n  }\n  .head-actions {\n    display: flex;\n    gap: var(--r-2);\n    align-items: center;\n  }\n  .search {\n    width: min(280px, 60vw);\n  }\n\n  .filters {\n    display: flex;\n    gap: var(--r-3);\n    flex-wrap: wrap;\n    margin-bottom: var(--r-4);\n  }\n\n  .error {\n    background: var(--st-human-dim);\n    border: 1px solid rgba(242, 85, 90, 0.4);\n    color: #ffb3b6;\n    padding: var(--r-3) var(--r-4);\n    border-radius: var(--radius-m);\n    font-size: 13.5px;\n    margin-bottom: var(--r-4);\n  }\n\n  .jobs {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n\n  .job {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: var(--r-3) var(--r-4);\n    flex-wrap: wrap;\n    padding: 14px 18px;\n    background: var(--bg-1);\n    border: 1px solid var(--line);\n    border-radius: var(--radius-m);\n    text-decoration: none;\n    color: var(--ink-0);\n    transition:\n      border-color var(--t-fast),\n      background var(--t-fast),\n      transform var(--t-fast);\n  }\n  .job:hover {\n    border-color: var(--line-strong);\n    background: var(--bg-2);\n    text-decoration: none;\n    transform: translateY(-1px);\n  }\n  .job.needs-human {\n    border-color: rgba(242, 85, 90, 0.4);\n    background: linear-gradient(90deg, rgba(242, 85, 90, 0.05), transparent 200px), var(--bg-1);\n  }\n\n  .left {\n    display: flex;\n    align-items: center;\n    gap: var(--r-5);\n    min-width: 0;\n    flex: 1 1 240px; /* below 240px of text room, the meta column wraps under */\n  }\n  .ident {\n    display: flex;\n    flex-direction: column;\n    min-width: 0;\n  }\n  .title {\n    font-weight: 590;\n    font-size: 15px;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n  .name {\n    font-family: var(--font-mono);\n    font-size: 12px;\n    color: var(--ink-2);\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n\n  .meta {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex: 0 1 auto;\n    flex-wrap: wrap;\n  }\n  .when {\n    font-size: 12px;\n    color: var(--ink-2);\n    min-width: 70px;\n    text-align: right;\n  }\n\n  .orphans {\n    margin-top: var(--r-6);\n    border: 1px dashed var(--line-strong);\n    border-radius: var(--radius-m);\n    padding: var(--r-4) var(--r-5);\n  }\n  .orphans-head {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    gap: var(--r-4);\n  }\n  .orphans h2 {\n    font-size: 16px;\n  }\n  .hint {\n    color: var(--ink-2);\n    font-size: 13px;\n    max-width: 52ch;\n  }\n  .orphans ul {\n    list-style: none;\n    margin: var(--r-3) 0 0;\n    padding: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n  }\n  .orphans code {\n    color: var(--st-open);\n    font-size: 12.5px;\n  }\n\n  @media (max-width: 760px) {\n    .page {\n      padding: var(--r-4) var(--r-4) var(--r-6);\n    }\n    .job {\n      flex-direction: column;\n      align-items: flex-start;\n      gap: var(--r-3);\n    }\n    .left {\n      flex-direction: column;\n      align-items: flex-start;\n      gap: var(--r-2);\n      flex: none;\n      width: 100%;\n    }\n    .ident {\n      width: 100%;\n    }\n    .meta {\n      flex-wrap: wrap;\n    }\n    .when {\n      text-align: left;\n      min-width: 0;\n    }\n    .search {\n      width: 100%;\n    }\n    .head-actions {\n      width: 100%;\n    }\n  }\n</style>\n","numLines":477,"startLine":1,"totalLines":477}}}
