{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WrDfW2x9hkCdUbif2t3EtF","type":"tool_result","content":"1\t// Data store — projects + the active project's jobs, polled while visible.\n2\t// The TUI re-reads state on a 1s timer; the web client polls every 2s while\n3\t// the tab is visible and pauses when hidden (an SSE future replaces the\n4\t// job-level polling only — the list stays a snapshot API by design).\n5\t\n6\timport * as api from '$lib/api/client'\n7\timport type { JobRow, ProjectRow } from '$lib/api/types'\n8\t\n9\tconst POLL_MS = 2000\n10\t\n11\tclass DataStore {\n12\t  projects = $state<ProjectRow[]>([])\n13\t  active = $state<string>('')\n14\t  jobs = $state<JobRow[]>([])\n15\t  loadingProjects = $state(false)\n16\t  loadingJobs = $state(false)\n17\t  projectsError = $state('')\n18\t  jobsError = $state('')\n19\t\n20\t  #jobsTimer: ReturnType<typeof setInterval> | null = null\n21\t\n22\t  async loadProjects(): Promise<void> {\n23\t    this.loadingProjects = true\n24\t    try {\n25\t      const res = await api.getProjects()\n26\t      this.projects = res.projects ?? []\n27\t      this.projectsError = ''\n28\t      if (this.active && this.projects.some((p) => p.name === this.active)) return\n29\t      const remembered = localStorage.getItem('mg-control.project')\n30\t      this.active =\n31\t        this.projects.find((p) => p.name === remembered)?.name ?? this.projects[0]?.name ?? ''\n32\t      if (this.active) localStorage.setItem('mg-control.project', this.active)\n33\t    } catch (e) {\n34\t      // A failed load must reach the user — a silent empty dropdown reads as\n35\t      // \"no projects\". Unlike refreshJobs's tight 2s poll, this only fires\n36\t      // once per connection establishment, so there's no flicker to guard\n37\t      // against — a status-0 failure (unreachable, or a 2xx that isn't JSON)\n38\t      // must still surface, since that's exactly the \"daemon answers but not\n39\t      // with JSON\" case the brief called out.\n40\t      this.projectsError = e instanceof Error ? e.message : String(e)\n41\t    } finally {\n42\t      this.loadingProjects = false\n43\t    }\n44\t  }\n45\t\n46\t  setActive(project: string) {\n47\t    if (!project || project === this.active) return\n48\t    this.active = project\n49\t    localStorage.setItem('mg-control.project', project)\n50\t    void this.refreshJobs()\n51\t  }\n52\t\n53\t  async refreshJobs(): Promise<void> {\n54\t    if (!this.active) return\n55\t    this.loadingJobs = true\n56\t    try {\n57\t      const res = await api.getJobs(this.active)\n58\t      this.jobs = res.jobs ?? []\n59\t      this.jobsError = ''\n60\t    } catch (e) {\n61\t      if (e instanceof api.ApiError && e.status === 0) return // aborted / offline — keep last\n62\t      this.jobsError = e instanceof Error ? e.message : String(e)\n63\t    } finally {\n64\t      this.loadingJobs = false\n65\t    }\n66\t  }\n67\t\n68\t  startPolling() {\n69\t    this.stopPolling()\n70\t    const tick = () => {\n71\t      if (document.visibilityState === 'visible') void this.refreshJobs()\n72\t    }\n73\t    this.#jobsTimer = setInterval(tick, POLL_MS)\n74\t  }\n75\t\n76\t  stopPolling() {\n77\t    if (this.#jobsTimer) clearInterval(this.#jobsTimer)\n78\t    this.#jobsTimer = null\n79\t  }\n80\t}\n81\t\n82\texport const data = new DataStore()\n83\t"}]},"parent_tool_use_id":null,"session_id":"7611c08a-6f39-4d7e-9a7e-2c914821d329","uuid":"8f9065a2-72ab-4c8c-8f89-33f7b4fcebef","timestamp":"2026-08-29T12:50:45.280Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/web-ui/src/lib/state/data.svelte.ts","content":"// Data store — projects + the active project's jobs, polled while visible.\n// The TUI re-reads state on a 1s timer; the web client polls every 2s while\n// the tab is visible and pauses when hidden (an SSE future replaces the\n// job-level polling only — the list stays a snapshot API by design).\n\nimport * as api from '$lib/api/client'\nimport type { JobRow, ProjectRow } from '$lib/api/types'\n\nconst POLL_MS = 2000\n\nclass DataStore {\n  projects = $state<ProjectRow[]>([])\n  active = $state<string>('')\n  jobs = $state<JobRow[]>([])\n  loadingProjects = $state(false)\n  loadingJobs = $state(false)\n  projectsError = $state('')\n  jobsError = $state('')\n\n  #jobsTimer: ReturnType<typeof setInterval> | null = null\n\n  async loadProjects(): Promise<void> {\n    this.loadingProjects = true\n    try {\n      const res = await api.getProjects()\n      this.projects = res.projects ?? []\n      this.projectsError = ''\n      if (this.active && this.projects.some((p) => p.name === this.active)) return\n      const remembered = localStorage.getItem('mg-control.project')\n      this.active =\n        this.projects.find((p) => p.name === remembered)?.name ?? this.projects[0]?.name ?? ''\n      if (this.active) localStorage.setItem('mg-control.project', this.active)\n    } catch (e) {\n      // A failed load must reach the user — a silent empty dropdown reads as\n      // \"no projects\". Unlike refreshJobs's tight 2s poll, this only fires\n      // once per connection establishment, so there's no flicker to guard\n      // against — a status-0 failure (unreachable, or a 2xx that isn't JSON)\n      // must still surface, since that's exactly the \"daemon answers but not\n      // with JSON\" case the brief called out.\n      this.projectsError = e instanceof Error ? e.message : String(e)\n    } finally {\n      this.loadingProjects = false\n    }\n  }\n\n  setActive(project: string) {\n    if (!project || project === this.active) return\n    this.active = project\n    localStorage.setItem('mg-control.project', project)\n    void this.refreshJobs()\n  }\n\n  async refreshJobs(): Promise<void> {\n    if (!this.active) return\n    this.loadingJobs = true\n    try {\n      const res = await api.getJobs(this.active)\n      this.jobs = res.jobs ?? []\n      this.jobsError = ''\n    } catch (e) {\n      if (e instanceof api.ApiError && e.status === 0) return // aborted / offline — keep last\n      this.jobsError = e instanceof Error ? e.message : String(e)\n    } finally {\n      this.loadingJobs = false\n    }\n  }\n\n  startPolling() {\n    this.stopPolling()\n    const tick = () => {\n      if (document.visibilityState === 'visible') void this.refreshJobs()\n    }\n    this.#jobsTimer = setInterval(tick, POLL_MS)\n  }\n\n  stopPolling() {\n    if (this.#jobsTimer) clearInterval(this.#jobsTimer)\n    this.#jobsTimer = null\n  }\n}\n\nexport const data = new DataStore()\n","numLines":83,"startLine":1,"totalLines":83}}}
