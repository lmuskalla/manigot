{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014VimeRgp9D4MVL7ecp4gzp","type":"tool_result","content":"1\t// Small time helpers — the control plane shows \"3 minutes ago\" more often\n2\t// than timestamps, but exact RFC3339 is one title-attr away.\n3\t\n4\texport function relativeTime(iso: string, nowMs = Date.now()): string {\n5\t  const t = Date.parse(iso)\n6\t  if (Number.isNaN(t)) return ''\n7\t  const s = Math.max(0, Math.round((nowMs - t) / 1000))\n8\t  if (s < 45) return 'just now'\n9\t  const m = Math.round(s / 60)\n10\t  if (m < 60) return `${m} min ago`\n11\t  const h = Math.round(m / 60)\n12\t  if (h < 24) return `${h} h ago`\n13\t  const d = Math.round(h / 24)\n14\t  if (d < 14) return `${d} d ago`\n15\t  return new Date(t).toLocaleDateString(undefined, { month: 'short', day: 'numeric' })\n16\t}\n17\t\n18\t/** mm:ss elapsed for a running state's `updated` timestamp. */\n19\texport function sinceLabel(iso: string, nowMs = Date.now()): string {\n20\t  const t = Date.parse(iso)\n21\t  if (Number.isNaN(t)) return ''\n22\t  const s = Math.max(0, Math.round((nowMs - t) / 1000))\n23\t  if (s < 90) return `${s}s`\n24\t  return `${Math.floor(s / 60)}m ${s % 60}s`\n25\t}\n26\t"}]},"parent_tool_use_id":null,"session_id":"381ee64a-7af5-490a-b26d-06d8f9dd7d92","uuid":"90fa52f1-e84a-44fd-b7ed-5d6d77a70336","timestamp":"2026-08-29T12:53:15.796Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/web-ui/src/lib/time.ts","content":"// Small time helpers — the control plane shows \"3 minutes ago\" more often\n// than timestamps, but exact RFC3339 is one title-attr away.\n\nexport function relativeTime(iso: string, nowMs = Date.now()): string {\n  const t = Date.parse(iso)\n  if (Number.isNaN(t)) return ''\n  const s = Math.max(0, Math.round((nowMs - t) / 1000))\n  if (s < 45) return 'just now'\n  const m = Math.round(s / 60)\n  if (m < 60) return `${m} min ago`\n  const h = Math.round(m / 60)\n  if (h < 24) return `${h} h ago`\n  const d = Math.round(h / 24)\n  if (d < 14) return `${d} d ago`\n  return new Date(t).toLocaleDateString(undefined, { month: 'short', day: 'numeric' })\n}\n\n/** mm:ss elapsed for a running state's `updated` timestamp. */\nexport function sinceLabel(iso: string, nowMs = Date.now()): string {\n  const t = Date.parse(iso)\n  if (Number.isNaN(t)) return ''\n  const s = Math.max(0, Math.round((nowMs - t) / 1000))\n  if (s < 90) return `${s}s`\n  return `${Math.floor(s / 60)}m ${s % 60}s`\n}\n","numLines":26,"startLine":1,"totalLines":26}}}
