{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016tCnwKYrvyH1Zq6qnFDn8D","type":"tool_result","content":"1\t// The API client — one fetch wrapper with the daemon's conventions:\n2\t//   · JSON everywhere except job files (raw markdown bodies)\n3\t//   · errors as `{ \"error\": \"…\" }` envelopes on every non-2xx\n4\t//   · optional bearer token (localhost daemon is tokenless; a remote bind\n5\t//     requires one — tokens are configured out-of-band, the API never issues)\n6\t//\n7\t// Part 2 capability probing: mutating endpoints answer 404/405 on a Part 1\n8\t// daemon. The client records that as a capability miss so the UI can render\n9\t// \"not available on this daemon\" instead of a raw error — the same frontend\n10\t// must work against both daemon generations while job two lands.\n11\t\n12\timport { ep, seg } from './endpoints'\n13\timport type {\n14\t  AgentsResponse,\n15\t  Health,\n16\t  JobDiffResponse,\n17\t  JobJdiResponse,\n18\t  JobRow,\n19\t  JobsResponse,\n20\t  LaunchResponse,\n21\t  OrphansResponse,\n22\t  ProjectsResponse,\n23\t  PruneResponse,\n24\t} from './types'\n25\t\n26\texport interface Connection {\n27\t  baseUrl: string\n28\t  token: string\n29\t}\n30\t\n31\texport class ApiError extends Error {\n32\t  status: number\n33\t  /** True when the daemon answered \"no such route\" — a Part 2 call on a Part 1 daemon. */\n34\t  capabilityMiss: boolean\n35\t\n36\t  constructor(status: number, message: string) {\n37\t    super(message)\n38\t    this.name = 'ApiError'\n39\t    this.status = status\n40\t    this.capabilityMiss = status === 404 || status === 405\n41\t  }\n42\t}\n43\t\n44\texport function normalizeBaseUrl(url: string): string {\n45\t  const trimmed = url.trim().replace(/\\/+$/, '')\n46\t  if (!trimmed) return ''\n47\t  if (/^https?:\\/\\//i.test(trimmed)) return trimmed\n48\t  // Same-origin (e.g. served by the daemon itself, or behind the vite proxy).\n49\t  return trimmed.startsWith('/') ? trimmed : `http://${trimmed}`\n50\t}\n51\t\n52\tlet conn: Connection = { baseUrl: '', token: '' }\n53\t\n54\texport function setConnection(c: Connection) {\n55\t  conn = { baseUrl: normalizeBaseUrl(c.baseUrl), token: c.token }\n56\t}\n57\t\n58\texport function getConnection(): Connection {\n59\t  return { ...conn }\n60\t}\n61\t\n62\t// ── fetch plumbing ──────────────────────────────────────────────────────────\n63\t\n64\ttype BodyInitLike = string | undefined\n65\t\n66\tinterface ReqOpts {\n67\t  body?: BodyInitLike\n68\t  contentType?: string\n69\t  signal?: AbortSignal\n70\t}\n71\t\n72\tasync function request(method: string, path: string, opts: ReqOpts = {}): Promise<string> {\n73\t  const headers: Record<string, string> = {}\n74\t  if (conn.token) headers['Authorization'] = `Bearer ${conn.token}`\n75\t  if (opts.body !== undefined && opts.contentType) headers['Content-Type'] = opts.contentType\n76\t\n77\t  let res: Response\n78\t  try {\n79\t    res = await fetch(conn.baseUrl + path, {\n80\t      method,\n81\t      headers,\n82\t      body: opts.body,\n83\t      signal: opts.signal,\n84\t    })\n85\t  } catch (e) {\n86\t    if (e instanceof Error && e.name === 'AbortError') throw e\n87\t    // A fetch that throws before any response is either a network failure or\n88\t    // a CORS block — the two look identical to JS (TypeError \"Failed to\n89\t    // fetch\"). The daemon is deliberately CORS-less (same-origin JSON API),\n90\t    // so a cross-origin absolute URL can never work from a browser: the\n91\t    // request dies in the preflight with no response at all. Surface that\n92\t    // as the likely cause so the user reaches for the proxy path (/api)\n93\t    // instead of hunting a nonexistent URL typo.\n94\t    const target = conn.baseUrl || location.origin\n95\t    try {\n96\t      if (new URL(target, location.href).origin !== location.origin) {\n97\t        throw new ApiError(\n98\t          0,\n99\t          `cross-origin URL blocked by the browser — the daemon sends no CORS headers by design; in dev set the URL to /api (vite proxies it to 127.0.0.1:8080)`,\n100\t        )\n101\t      }\n102\t    } catch (err) {\n103\t      if (err instanceof ApiError) throw err\n104\t      /* unparseable base — fall through to the raw fetch error */\n105\t    }\n106\t    throw new ApiError(\n107\t      0,\n108\t      `cannot reach the daemon at ${conn.baseUrl || '(same origin)'} — ${e instanceof Error ? e.message : String(e)}`,\n109\t    )\n110\t  }\n111\t\n112\t  if (res.status === 401) {\n113\t    throw new ApiError(401, 'the daemon rejected the token (401) — check the connection settings')\n114\t  }\n115\t  if (!res.ok) {\n116\t    let msg = `HTTP ${res.status}`\n117\t    try {\n118\t      const data = (await res.json()) as { error?: string }\n119\t      if (data && typeof data.error === 'string' && data.error) msg = data.error\n120\t    } catch {\n121\t      /* non-JSON error body — keep the status line */\n122\t    }\n123\t    throw new ApiError(res.status, msg)\n124\t  }\n125\t  return res.text()\n126\t}\n127\t\n128\tasync function json<T>(method: string, path: string, opts: ReqOpts = {}): Promise<T> {\n129\t  const text = await request(method, path, opts)\n130\t  if (text === '') return undefined as T\n131\t  try {\n132\t    return JSON.parse(text) as T\n133\t  } catch {\n134\t    // A 2xx that is not JSON is a mis-pointed connection: the vite dev\n135\t    // server (or any static host) happily serves index.html for GET\n136\t    // /health. Name it so the user lands on the connection settings\n137\t    // instead of a JSON parse error.\n138\t    const where = conn.baseUrl || '(same origin)'\n139\t    const looksHtml = /^\\s*<(?:!doctype|html|head)\\b/i.test(text)\n140\t    throw new ApiError(\n141\t      0,\n142\t      looksHtml\n143\t        ? `${where} served an HTML page, not the daemon's JSON — point the connection at the daemon (in dev: /api)`\n144\t        : `${where} answered with a non-JSON body (${JSON.stringify(text.slice(0, 40))})`,\n145\t    )\n146\t  }\n147\t}\n148\t\n149\tfunction post<T>(path: string, body?: unknown): Promise<T> {\n150\t  return json<T>('POST', path, {\n151\t    body: body === undefined ? undefined : JSON.stringify(body),\n152\t    contentType: 'application/json',\n153\t  })\n154\t}\n155\t\n156\t// ── Part 1: read-only ───────────────────────────────────────────────────────\n157\t\n158\texport function getHealth(signal?: AbortSignal): Promise<Health> {\n159\t  return json<Health>('GET', ep.health, { signal })\n160\t}\n161\t\n162\texport function getProjects(signal?: AbortSignal): Promise<ProjectsResponse> {\n163\t  return json<ProjectsResponse>('GET', ep.projects, { signal })\n164\t}\n165\t\n166\texport function getJobs(project: string, signal?: AbortSignal): Promise<JobsResponse> {\n167\t  return json<JobsResponse>('GET', `${ep.jobs(seg(project))}`, { signal })\n168\t}\n169\t\n170\t// The daemon's file route takes the on-disk filename (brief.md, not brief) —\n171\t// job one's shipped whitelist keys are the full file names. Map the UI's\n172\t// logical tab id to the real filename so the client matches the daemon.\n173\tconst JOB_FILENAMES: Record<string, string> = {\n174\t  brief: 'brief.md',\n175\t  tasks: 'tasks.md',\n176\t  implementation: 'implementation.md',\n177\t  verdict: 'verdict.md',\n178\t}\n179\t\n180\texport function getJobFile(project: string, job: string, file: string, signal?: AbortSignal): Promise<string> {\n181\t  const filename = JOB_FILENAMES[file] ?? file\n182\t  return request('GET', ep.file(seg(project), seg(job), seg(filename)), { signal })\n183\t}\n184\t\n185\texport function getJobJdi(project: string, job: string, signal?: AbortSignal): Promise<JobJdiResponse> {\n186\t  return json<JobJdiResponse>('GET', ep.jdi(seg(project), seg(job)), { signal })\n187\t}\n188\t\n189\texport function getJobDiff(project: string, job: string, full = false, signal?: AbortSignal): Promise<JobDiffResponse> {\n190\t  return json<JobDiffResponse>('GET', `${ep.diff(seg(project), seg(job))}${full ? '?full=1' : ''}`, { signal })\n191\t}\n192\t\n193\texport function getAgents(project: string, signal?: AbortSignal): Promise<AgentsResponse> {\n194\t  return json<AgentsResponse>('GET', ep.agents(seg(project)), { signal })\n195\t}\n196\t\n197\t// ── Part 2: mutating + supervision ──────────────────────────────────────────\n198\t\n199\texport function createJob(project: string, title: string, type: string): Promise<{ job: JobRow | string }> {\n200\t  return post(ep.createJob(seg(project)), { title, type })\n201\t}\n202\t\n203\texport function saveBrief(project: string, job: string, content: string): Promise<{ ok: boolean }> {\n204\t  return json<{ ok: boolean }>('PUT', ep.saveBrief(seg(project), seg(job)), {\n205\t    body: content,\n206\t    contentType: 'text/markdown; charset=utf-8',\n207\t  })\n208\t}\n209\t\n210\texport function launchAgent(project: string, job: string, agent: string, profile?: string): Promise<LaunchResponse> {\n211\t  return post(ep.launchAgent(seg(project), seg(job), seg(agent)), profile ? { profile } : {})\n212\t}\n213\t\n214\texport function startJdi(project: string, job: string, profile?: string): Promise<LaunchResponse> {\n215\t  return post(ep.startJdi(seg(project), seg(job)), profile ? { profile } : {})\n216\t}\n217\t\n218\texport function doneJob(project: string, job: string): Promise<{ message?: string }> {\n219\t  return post(ep.doneJob(seg(project), seg(job)))\n220\t}\n221\t\n222\texport function deleteJob(project: string, job: string): Promise<{ message?: string }> {\n223\t  return post(ep.deleteJob(seg(project), seg(job)))\n224\t}\n225\t\n226\texport function pushJob(project: string, job: string): Promise<{ message?: string }> {\n227\t  return post(ep.pushJob(seg(project), seg(job)))\n228\t}\n229\t\n230\texport function getOrphans(project: string, signal?: AbortSignal): Promise<OrphansResponse> {\n231\t  return json<OrphansResponse>('GET', ep.orphans(seg(project)), { signal })\n232\t}\n233\t\n234\texport function removeOrphans(project: string): Promise<{ message?: string }> {\n235\t  return post(ep.removeOrphans(seg(project)))\n236\t}\n237\t\n238\texport function pruneContainers(): Promise<PruneResponse> {\n239\t  return post(ep.pruneContainers())\n240\t}\n241\t"}]},"parent_tool_use_id":null,"session_id":"381ee64a-7af5-490a-b26d-06d8f9dd7d92","uuid":"77bb010b-e27b-4861-8e5b-2415b75979be","timestamp":"2026-08-29T12:53:14.150Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/web-ui/src/lib/api/client.ts","content":"// The API client — one fetch wrapper with the daemon's conventions:\n//   · JSON everywhere except job files (raw markdown bodies)\n//   · errors as `{ \"error\": \"…\" }` envelopes on every non-2xx\n//   · optional bearer token (localhost daemon is tokenless; a remote bind\n//     requires one — tokens are configured out-of-band, the API never issues)\n//\n// Part 2 capability probing: mutating endpoints answer 404/405 on a Part 1\n// daemon. The client records that as a capability miss so the UI can render\n// \"not available on this daemon\" instead of a raw error — the same frontend\n// must work against both daemon generations while job two lands.\n\nimport { ep, seg } from './endpoints'\nimport type {\n  AgentsResponse,\n  Health,\n  JobDiffResponse,\n  JobJdiResponse,\n  JobRow,\n  JobsResponse,\n  LaunchResponse,\n  OrphansResponse,\n  ProjectsResponse,\n  PruneResponse,\n} from './types'\n\nexport interface Connection {\n  baseUrl: string\n  token: string\n}\n\nexport class ApiError extends Error {\n  status: number\n  /** True when the daemon answered \"no such route\" — a Part 2 call on a Part 1 daemon. */\n  capabilityMiss: boolean\n\n  constructor(status: number, message: string) {\n    super(message)\n    this.name = 'ApiError'\n    this.status = status\n    this.capabilityMiss = status === 404 || status === 405\n  }\n}\n\nexport function normalizeBaseUrl(url: string): string {\n  const trimmed = url.trim().replace(/\\/+$/, '')\n  if (!trimmed) return ''\n  if (/^https?:\\/\\//i.test(trimmed)) return trimmed\n  // Same-origin (e.g. served by the daemon itself, or behind the vite proxy).\n  return trimmed.startsWith('/') ? trimmed : `http://${trimmed}`\n}\n\nlet conn: Connection = { baseUrl: '', token: '' }\n\nexport function setConnection(c: Connection) {\n  conn = { baseUrl: normalizeBaseUrl(c.baseUrl), token: c.token }\n}\n\nexport function getConnection(): Connection {\n  return { ...conn }\n}\n\n// ── fetch plumbing ──────────────────────────────────────────────────────────\n\ntype BodyInitLike = string | undefined\n\ninterface ReqOpts {\n  body?: BodyInitLike\n  contentType?: string\n  signal?: AbortSignal\n}\n\nasync function request(method: string, path: string, opts: ReqOpts = {}): Promise<string> {\n  const headers: Record<string, string> = {}\n  if (conn.token) headers['Authorization'] = `Bearer ${conn.token}`\n  if (opts.body !== undefined && opts.contentType) headers['Content-Type'] = opts.contentType\n\n  let res: Response\n  try {\n    res = await fetch(conn.baseUrl + path, {\n      method,\n      headers,\n      body: opts.body,\n      signal: opts.signal,\n    })\n  } catch (e) {\n    if (e instanceof Error && e.name === 'AbortError') throw e\n    // A fetch that throws before any response is either a network failure or\n    // a CORS block — the two look identical to JS (TypeError \"Failed to\n    // fetch\"). The daemon is deliberately CORS-less (same-origin JSON API),\n    // so a cross-origin absolute URL can never work from a browser: the\n    // request dies in the preflight with no response at all. Surface that\n    // as the likely cause so the user reaches for the proxy path (/api)\n    // instead of hunting a nonexistent URL typo.\n    const target = conn.baseUrl || location.origin\n    try {\n      if (new URL(target, location.href).origin !== location.origin) {\n        throw new ApiError(\n          0,\n          `cross-origin URL blocked by the browser — the daemon sends no CORS headers by design; in dev set the URL to /api (vite proxies it to 127.0.0.1:8080)`,\n        )\n      }\n    } catch (err) {\n      if (err instanceof ApiError) throw err\n      /* unparseable base — fall through to the raw fetch error */\n    }\n    throw new ApiError(\n      0,\n      `cannot reach the daemon at ${conn.baseUrl || '(same origin)'} — ${e instanceof Error ? e.message : String(e)}`,\n    )\n  }\n\n  if (res.status === 401) {\n    throw new ApiError(401, 'the daemon rejected the token (401) — check the connection settings')\n  }\n  if (!res.ok) {\n    let msg = `HTTP ${res.status}`\n    try {\n      const data = (await res.json()) as { error?: string }\n      if (data && typeof data.error === 'string' && data.error) msg = data.error\n    } catch {\n      /* non-JSON error body — keep the status line */\n    }\n    throw new ApiError(res.status, msg)\n  }\n  return res.text()\n}\n\nasync function json<T>(method: string, path: string, opts: ReqOpts = {}): Promise<T> {\n  const text = await request(method, path, opts)\n  if (text === '') return undefined as T\n  try {\n    return JSON.parse(text) as T\n  } catch {\n    // A 2xx that is not JSON is a mis-pointed connection: the vite dev\n    // server (or any static host) happily serves index.html for GET\n    // /health. Name it so the user lands on the connection settings\n    // instead of a JSON parse error.\n    const where = conn.baseUrl || '(same origin)'\n    const looksHtml = /^\\s*<(?:!doctype|html|head)\\b/i.test(text)\n    throw new ApiError(\n      0,\n      looksHtml\n        ? `${where} served an HTML page, not the daemon's JSON — point the connection at the daemon (in dev: /api)`\n        : `${where} answered with a non-JSON body (${JSON.stringify(text.slice(0, 40))})`,\n    )\n  }\n}\n\nfunction post<T>(path: string, body?: unknown): Promise<T> {\n  return json<T>('POST', path, {\n    body: body === undefined ? undefined : JSON.stringify(body),\n    contentType: 'application/json',\n  })\n}\n\n// ── Part 1: read-only ───────────────────────────────────────────────────────\n\nexport function getHealth(signal?: AbortSignal): Promise<Health> {\n  return json<Health>('GET', ep.health, { signal })\n}\n\nexport function getProjects(signal?: AbortSignal): Promise<ProjectsResponse> {\n  return json<ProjectsResponse>('GET', ep.projects, { signal })\n}\n\nexport function getJobs(project: string, signal?: AbortSignal): Promise<JobsResponse> {\n  return json<JobsResponse>('GET', `${ep.jobs(seg(project))}`, { signal })\n}\n\n// The daemon's file route takes the on-disk filename (brief.md, not brief) —\n// job one's shipped whitelist keys are the full file names. Map the UI's\n// logical tab id to the real filename so the client matches the daemon.\nconst JOB_FILENAMES: Record<string, string> = {\n  brief: 'brief.md',\n  tasks: 'tasks.md',\n  implementation: 'implementation.md',\n  verdict: 'verdict.md',\n}\n\nexport function getJobFile(project: string, job: string, file: string, signal?: AbortSignal): Promise<string> {\n  const filename = JOB_FILENAMES[file] ?? file\n  return request('GET', ep.file(seg(project), seg(job), seg(filename)), { signal })\n}\n\nexport function getJobJdi(project: string, job: string, signal?: AbortSignal): Promise<JobJdiResponse> {\n  return json<JobJdiResponse>('GET', ep.jdi(seg(project), seg(job)), { signal })\n}\n\nexport function getJobDiff(project: string, job: string, full = false, signal?: AbortSignal): Promise<JobDiffResponse> {\n  return json<JobDiffResponse>('GET', `${ep.diff(seg(project), seg(job))}${full ? '?full=1' : ''}`, { signal })\n}\n\nexport function getAgents(project: string, signal?: AbortSignal): Promise<AgentsResponse> {\n  return json<AgentsResponse>('GET', ep.agents(seg(project)), { signal })\n}\n\n// ── Part 2: mutating + supervision ──────────────────────────────────────────\n\nexport function createJob(project: string, title: string, type: string): Promise<{ job: JobRow | string }> {\n  return post(ep.createJob(seg(project)), { title, type })\n}\n\nexport function saveBrief(project: string, job: string, content: string): Promise<{ ok: boolean }> {\n  return json<{ ok: boolean }>('PUT', ep.saveBrief(seg(project), seg(job)), {\n    body: content,\n    contentType: 'text/markdown; charset=utf-8',\n  })\n}\n\nexport function launchAgent(project: string, job: string, agent: string, profile?: string): Promise<LaunchResponse> {\n  return post(ep.launchAgent(seg(project), seg(job), seg(agent)), profile ? { profile } : {})\n}\n\nexport function startJdi(project: string, job: string, profile?: string): Promise<LaunchResponse> {\n  return post(ep.startJdi(seg(project), seg(job)), profile ? { profile } : {})\n}\n\nexport function doneJob(project: string, job: string): Promise<{ message?: string }> {\n  return post(ep.doneJob(seg(project), seg(job)))\n}\n\nexport function deleteJob(project: string, job: string): Promise<{ message?: string }> {\n  return post(ep.deleteJob(seg(project), seg(job)))\n}\n\nexport function pushJob(project: string, job: string): Promise<{ message?: string }> {\n  return post(ep.pushJob(seg(project), seg(job)))\n}\n\nexport function getOrphans(project: string, signal?: AbortSignal): Promise<OrphansResponse> {\n  return json<OrphansResponse>('GET', ep.orphans(seg(project)), { signal })\n}\n\nexport function removeOrphans(project: string): Promise<{ message?: string }> {\n  return post(ep.removeOrphans(seg(project)))\n}\n\nexport function pruneContainers(): Promise<PruneResponse> {\n  return post(ep.pruneContainers())\n}\n","numLines":241,"startLine":1,"totalLines":241}}}
