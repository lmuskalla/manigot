', project })}>detail view</a>.\n54\t  </p>\n55\t\n56\t  {#if error}\n57\t    <p class=\"error\" role=\"alert\">{error}</p>\n58\t  {:else if loading}\n59\t    <p class=\"loading\">Listing the crew…</p>\n60\t  {:else if filtered.length === 0}\n61\t    <EmptyState title=\"No agents match\" hint=\"Clear the filter to see the whole crew.\" />\n62\t  {:else}\n63\t    <ul class=\"grid\">\n64\t      {#each filtered as a (a.name)}\n65\t        <li class=\"agent\" data-crew={crewOf(a.name)}>\n66\t          <div class=\"agent-head\">\n67\t            <span class=\"agent-name\">{\"@\" + a.name}</span>\n68\t            {#if crewOf(a.name) === 'jdi'}\n69\t              <span class=\"chip chip-running\"><span class=\"dot\"></span> jdi crew</span>\n70\t            {:else}\n71\t              <span class=\"chip chip-neutral\">manual</span>\n72\t            {/if}\n73\t          </div>\n74\t          <p class=\"agent-desc\">{a.description}</p>\n75\t        </li>\n76\t      {/each}\n77\t    </ul>\n78\t  {/if}\n79\t</div>\n80\t\n81\t<style>\n82\t  .page {\n83\t    max-width: 900px;\n84\t    margin: 0 auto;\n85\t    padding: var(--r-6) var(--r-6) var(--r-7);\n86\t    width: 100%;\n87\t  }\n88\t  .head {\n89\t    display: flex;\n90\t    justify-content: space-between;\n91\t    align-items: flex-end;\n92\t    gap: var(--r-4);\n93\t    flex-wrap: wrap;\n94\t    margin-bottom: var(--r-3);\n95\t  }\n96\t  h1 {\n97\t    font-size: 24px;\n98\t    letter-spacing: -0.02em;\n99\t  }\n100\t  .search {\n101\t    width: min(260px, 60vw);\n102\t  }\n103\t  .lead {\n104\t    color: var(--ink-2);\n105\t    font-size: 13.5px;\n106\t    margin-bottom: var(--r-5);\n107\t    max-width: 70ch;\n108\t  }\n109\t  .lead code {\n110\t    color: var(--accent-bright);\n111\t    font-size: 0.9em;\n112\t  }\n113\t\n114\t  .grid {\n115\t    list-style: none;\n116\t    margin: 0;\n117\t    padding: 0;\n118\t    display: grid;\n119\t    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n120\t    gap: var(--r-3);\n121\t  }\n122\t  .agent {\n123\t    background: var(--bg-1);\n124\t    border: 1px solid var(--line);\n125\t    border-radius: var(--radius-m);\n126\t    padding: var(--r-4);\n127\t    transition: border-color var(--t-fast);\n128\t  }\n129\t  .agent:hover {\n130\t    border-color: var(--line-strong);\n131\t  }\n132\t  .agent[data-crew='jdi'] {\n133\t    border-left: 2px solid var(--accent);\n134\t  }\n135\t  .agent-head {\n136\t    display: flex;\n137\t    justify-content: space-between;\n138\t    align-items: center;\n139\t    gap: var(--r-2);\n140\t    margin-bottom: 8px;\n141\t  }\n142\t  .agent-name {\n143\t    font-family: var(--font-mono);\n144\t    font-size: 13.5px;\n145\t    color: var(--ink-0);\n146\t    font-weight: 500;\n147\t  }\n148\t  .agent[data-crew='jdi'] .agent-name {\n149\t    color: var(--accent-bright);\n150\t  }\n151\t  .agent-desc {\n152\t    font-size: 13px;\n153\t    color: var(--ink-2);\n154\t    line-height: 1.55;\n155\t  }\n156\t  .error {\n157\t    color: #ffb3b6;\n158\t  }\n159\t  .loading {\n160\t    color: var(--ink-2);\n161\t  }\n162\t\n163\t  @media (max-width: 760px) {\n164\t    .page {\n165\t      padding: var(--r-4) var(--r-4) var(--r-6);\n166\t    }\n167\t    .search {\n168\t      width: 100%;\n169\t    }\n170\t  }\n171\t</style>\n172\t"}]},"parent_tool_use_id":null,"session_id":"381ee64a-7af5-490a-b26d-06d8f9dd7d92","uuid":"7fbd2e07-5713-44e5-8eed-abda6d60f3de","timestamp":"2026-08-29T12:53:18.770Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/web-ui/src/lib/views/AgentsView.svelte","content":"<script lang=\"ts\">\n  import { onMount } from 'svelte'\n  import EmptyState from '$lib/components/EmptyState.svelte'\n  import { getAgents } from '$lib/api/client'\n  import { href } from '$lib/router'\n  import type { AgentRow } from '$lib/api/types'\n\n  let { project }: { project: string } = $props()\n\n  let agents = $state<AgentRow[]>([])\n  let loading = $state(true)\n  let error = $state('')\n  let q = $state('')\n\n  onMount(async () => {\n    try {\n      const res = await getAgents(project)\n      agents = res.agents ?? []\n    } catch (e) {\n      error = e instanceof Error ? e.message : String(e)\n    } finally {\n      loading = false\n    }\n  })\n\n  const filtered = $derived.by(() => {\n    const needle = q.trim().toLowerCase()\n    if (!needle) return agents\n    return agents.filter(\n      (a) => a.name.toLowerCase().includes(needle) || a.description.toLowerCase().includes(needle),\n    )\n  })\n\n  const JDI_CREW = ['analyst', 'developer', 'reviewer']\n\n  function crewOf(name: string): 'jdi' | 'launchable' {\n    return JDI_CREW.includes(name) ? 'jdi' : 'launchable'\n  }\n</script>\n\n<div class=\"page\">\n  <header class=\"head\">\n    <div>\n      <p class=\"eyebrow\">crew</p>\n      <h1>Agents on {project}</h1>\n    </div>\n    <input class=\"input search\" placeholder=\"Filter the crew…\" bind:value={q} spellcheck=\"false\" aria-label=\"Filter agents\" />\n  </header>\n\n  <p class=\"lead\">\n    The autonomous sequence is fixed — <code>@analyst → @developer → @reviewer</code> — that is what\n    <code>mg jdi</code> runs. Every agent can also be fired once, detached, from a job's\n    <a href={href({ name: 'jobs', project })}>detail view</a>.\n  </p>\n\n  {#if error}\n    <p class=\"error\" role=\"alert\">{error}</p>\n  {:else if loading}\n    <p class=\"loading\">Listing the crew…</p>\n  {:else if filtered.length === 0}\n    <EmptyState title=\"No agents match\" hint=\"Clear the filter to see the whole crew.\" />\n  {:else}\n    <ul class=\"grid\">\n      {#each filtered as a (a.name)}\n        <li class=\"agent\" data-crew={crewOf(a.name)}>\n          <div class=\"agent-head\">\n            <span class=\"agent-name\">{\"@\" + a.name}</span>\n            {#if crewOf(a.name) === 'jdi'}\n              <span class=\"chip chip-running\"><span class=\"dot\"></span> jdi crew</span>\n            {:else}\n              <span class=\"chip chip-neutral\">manual</span>\n            {/if}\n          </div>\n          <p class=\"agent-desc\">{a.description}</p>\n        </li>\n      {/each}\n    </ul>\n  {/if}\n</div>\n\n<style>\n  .page {\n    max-width: 900px;\n    margin: 0 auto;\n    padding: var(--r-6) var(--r-6) var(--r-7);\n    width: 100%;\n  }\n  .head {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n    gap: var(--r-4);\n    flex-wrap: wrap;\n    margin-bottom: var(--r-3);\n  }\n  h1 {\n    font-size: 24px;\n    letter-spacing: -0.02em;\n  }\n  .search {\n    width: min(260px, 60vw);\n  }\n  .lead {\n    color: var(--ink-2);\n    font-size: 13.5px;\n    margin-bottom: var(--r-5);\n    max-width: 70ch;\n  }\n  .lead code {\n    color: var(--accent-bright);\n    font-size: 0.9em;\n  }\n\n  .grid {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n    gap: var(--r-3);\n  }\n  .agent {\n    background: var(--bg-1);\n    border: 1px solid var(--line);\n    border-radius: var(--radius-m);\n    padding: var(--r-4);\n    transition: border-color var(--t-fast);\n  }\n  .agent:hover {\n    border-color: var(--line-strong);\n  }\n  .agent[data-crew='jdi'] {\n    border-left: 2px solid var(--accent);\n  }\n  .agent-head {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: var(--r-2);\n    margin-bottom: 8px;\n  }\n  .agent-name {\n    font-family: var(--font-mono);\n    font-size: 13.5px;\n    color: var(--ink-0);\n    font-weight: 500;\n  }\n  .agent[data-crew='jdi'] .agent-name {\n    color: var(--accent-bright);\n  }\n  .agent-desc {\n    font-size: 13px;\n    color: var(--ink-2);\n    line-height: 1.55;\n  }\n  .error {\n    color: #ffb3b6;\n  }\n  .loading {\n    color: var(--ink-2);\n  }\n\n  @media (max-width: 760px) {\n    .page {\n      padding: var(--r-4) var(--r-4) var(--r-6);\n    }\n    .search {\n      width: 100%;\n    }\n  }\n</style>\n","numLines":172,"startLine":1,"totalLines":172}}}
