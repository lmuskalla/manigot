{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0196QA7UJEtrNeC1tMvESgjx","type":"tool_result","content":"1\t// App-level connection flows — the scenarios from the \"connecting to the\n2\t// daemon\" bug report: the dropdown must populate after a settings change\n3\t// (no reload), the landing must tell the truth about the connection state,\n4\t// and API errors must reach the user instead of an eternal \"connecting\".\n5\t//\n6\t// Each test builds fresh singletons (vi.resetModules) so the stores\n7\t// reconstruct from a controlled localStorage, exactly like a page load.\n8\t\n9\timport { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'\n10\t\n11\tconst html = (body = '') => `<!doctype html><html><head></head><body>${body}</body></html>`\n12\tconst json = (v: unknown) => JSON.stringify(v)\n13\t\n14\tconst HEALTH = { version: '1.2.3', imagePresent: true, profiles: [] }\n15\tconst PROJECTS = { projects: [{ name: 'manigot', path: '/srv/manigot' }] }\n16\t\n17\tinterface Stubbed {\n18\t  status: number\n19\t  body: string\n20\t  type?: string\n21\t}\n22\t\n23\t/** A fetch stub dispatching on the URL — HTML for anything unconfigured. */\n24\tfunction stubFetch(handler: (url: string) => Stubbed) {\n25\t  vi.stubGlobal(\n26\t    'fetch',\n27\t    vi.fn(async (input: RequestInfo | URL) => {\n28\t      const r = handler(String(input))\n29\t      return new Response(r.body, {\n30\t        status: r.status,\n31\t        headers: { 'Content-Type': r.type ?? 'application/json' },\n32\t      })\n33\t    }),\n34\t  )\n35\t}\n36\t\n37\t/** Everything unproxied (same-origin) is HTML — the vite dev server fallback. */\n38\tconst devServer: (urls: Record<string, Stubbed>) => (url: string) => Stubbed =\n39\t  (urls) =>\n40\t  (url) =>\n41\t    urls[url] ?? { status: 200, body: html(), type: 'text/html' }\n42\t\n43\t/** Fresh singletons AND a matching render() from the same module registry —\n44\t * mixing a statically-imported testing library with a reset-registry App\n45\t * gives two Svelte runtimes and orphaned effects. The registry's own\n46\t * cleanup() is stashed so afterEach can unmount what it rendered (the\n47\t * setup file's static cleanup cannot see these components).\n48\t */\n49\tasync function freshApp() {\n50\t  vi.resetModules()\n51\t  const { render, screen, waitFor, cleanup } = await import('@testing-library/svelte')\n52\t  const { connection } = await import('$lib/state/connection.svelte')\n53\t  const { data } = await import('$lib/state/data.svelte')\n54\t  const { default: App } = await import('./App.svelte')\n55\t  cleanupFn = cleanup\n56\t  return { render, screen, waitFor, connection, data, App }\n57\t}\n58\t\n59\tlet cleanupFn: (() => void) | null = null\n60\t\n61\tbeforeEach(() => {\n62\t  localStorage.clear()\n63\t  location.hash = '#/'\n64\t})\n65\t\n66\tafterEach(() => {\n67\t  cleanupFn?.()\n68\t  cleanupFn = null\n69\t  vi.unstubAllGlobals()\n70\t})\n71\t\n72\tdescribe('App connection flows', () => {\n73\t  it('populates the project dropdown after connecting via settings, without a reload', async () => {\n74\t    stubFetch(\n75\t      devServer({\n76\t        '/api/health': { status: 200, body: json(HEALTH) },\n77\t        '/api/projects': { status: 200, body: json(PROJECTS) },\n78\t      }),\n79\t    )\n80\t    const { render, screen, waitFor, connection, App } = await freshApp()\n81\t    render(App)\n82\t    await waitFor(() => expect(connection.status).toBe('down'))\n83\t\n84\t    // the user opens the settings modal and points the connection at /api\n85\t    connection.set('/api', '')\n86\t    await waitFor(() => expect(connection.status).toBe('up'))\n87\t\n88\t    const select = await waitFor(() => screen.getByLabelText('project') as HTMLSelectElement)\n89\t    await waitFor(() => {\n90\t      expect(select.options.length).toBe(1)\n91\t      expect(select.options[0]?.textContent).toBe('manigot')\n92\t    })\n93\t  })\n94\t\n95\t  it('does not claim \"Connecting to the daemon\" once the check has failed', async () => {\n96\t    stubFetch(devServer({}))\n97\t    const { render, screen, waitFor, connection, App } = await freshApp()\n98\t    render(App)\n99\t    await waitFor(() => expect(connection.status).toBe('down'))\n100\t    await waitFor(() => {\n101\t      const landing = document.querySelector('.landing')\n102\t      expect(landing).toBeTruthy()\n103\t      expect(landing!.textContent).not.toMatch(/Connecting to the daemon/)\n104\t    })\n105\t  })\n106\t\n107\t  it('says no projects are registered when a reachable daemon has none', async () => {\n108\t    stubFetch(\n109\t      devServer({\n110\t        '/health': { status: 200, body: json(HEALTH) },\n111\t        '/projects': { status: 200, body: json({ projects: [] }) },\n112\t      }),\n113\t    )\n114\t    const { render, screen, waitFor, connection, App } = await freshApp()\n115\t    render(App)\n116\t    await waitFor(() => expect(connection.status).toBe('up'))\n117\t    await waitFor(() => {\n118\t      const landing = document.querySelector('.landing')\n119\t      expect(landing?.textContent).toMatch(/No projects registered/)\n120\t    })\n121\t  })\n122\t\n123\t  it('stops fetching /projects once an empty registry has loaded — no reload loop', async () => {\n124\t    let projectsCalls = 0\n125\t    stubFetch((url) => {\n126\t      if (url.includes('/projects')) {\n127\t        projectsCalls++\n128\t        return { status: 200, body: json({ projects: [] }) }\n129\t      }\n130\t      if (url.endsWith('/health')) return { status: 200, body: json(HEALTH) }\n131\t      return { status: 200, body: html(), type: 'text/html' }\n132\t    })\n133\t    const { render, waitFor, connection, App } = await freshApp()\n134\t    render(App)\n135\t    await waitFor(() => expect(connection.status).toBe('up'))\n136\t    await waitFor(() => expect(projectsCalls).toBeGreaterThan(0))\n137\t    await new Promise((r) => setTimeout(r, 150))\n138\t    const settled = projectsCalls\n139\t    await new Promise((r) => setTimeout(r, 150))\n140\t    // Regression: keying the reload on \"list is empty\" refetched forever\n141\t    // (and OOMed the tab) whenever the daemon had zero projects.\n142\t    expect(projectsCalls).toBe(settled)\n143\t  })\n144\t\n145\t  it('shows the projects error instead of an empty dropdown when /projects fails', async () => {\n146\t    stubFetch(\n147\t      devServer({\n148\t        '/health': { status: 200, body: json(HEALTH) },\n149\t        '/projects': { status: 500, body: json({ error: 'registry exploded' }) },\n150\t      }),\n151\t    )\n152\t    const { render, screen, waitFor, connection, App } = await freshApp()\n153\t    render(App)\n154\t    await waitFor(() => expect(connection.status).toBe('up'))\n155\t    await waitFor(() => {\n156\t      const landing = document.querySelector('.landing')\n157\t      expect(landing?.textContent).toMatch(/registry exploded/)\n158\t    })\n159\t  })\n160\t\n161\t  it('leaves the landing once a project is active — the redirect hash must be single', async () => {\n162\t    // Regression: navigate(href(...)) double-prefixed the fragment\n163\t    // ('##/p/manigot'), which parseHash cannot parse, so the app stayed on\n164\t    // the landing (\"Connecting to the daemon…\") with a connected daemon.\n165\t    stubFetch(\n166\t      devServer({\n167\t        '/api/health': { status: 200, body: json(HEALTH) },\n168\t        '/api/projects': { status: 200, body: json(PROJECTS) },\n169\t        '/api/projects/manigot/jobs': { status: 200, body: json({ jobs: [] }) },\n170\t      }),\n171\t    )\n172\t    const { render, screen, waitFor, connection, App } = await freshApp()\n173\t    render(App)\n174\t    await waitFor(() => expect(connection.status).toBe('down'))\n175\t\n176\t    connection.set('/api', '')\n177\t    await waitFor(() => expect(connection.status).toBe('up'))\n178\t    await waitFor(() => expect(screen.getByLabelText('project')).toBeTruthy())\n179\t\n180\t    // The landing must be gone: the redirect landed on the jobs page.\n181\t    await waitFor(() => {\n182\t      expect(location.hash).toBe('#/p/manigot')\n183\t      expect(document.querySelector('.landing')).toBeNull()\n184\t      expect(document.querySelector('h1')?.textContent).toBe('manigot')\n185\t    })\n186\t  })\n187\t\n188\t  it('renders the daemon health panel on #/health when /health answers', async () => {\n189\t    localStorage.setItem('mg-control.connection', JSON.stringify({ baseUrl: '/api', token: '' }))\n190\t    location.hash = '#/health'\n191\t    stubFetch(\n192\t      devServer({\n193\t        '/api/health': { status: 200, body: json(HEALTH) },\n194\t      }),\n195\t    )\n196\t    const { render, screen, waitFor, connection, App } = await freshApp()\n197\t    render(App)\n198\t    await waitFor(() => expect(connection.status).toBe('up'))\n199\t    await waitFor(() => expect(screen.getByText('1.2.3')).toBeTruthy())\n200\t  })\n201\t})\n202\t"}]},"parent_tool_use_id":null,"session_id":"7611c08a-6f39-4d7e-9a7e-2c914821d329","uuid":"b7e831f4-25bb-4549-9e7e-c3480dcedf7f","timestamp":"2026-08-29T12:51:39.728Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/web-ui/src/App.test.ts","content":"// App-level connection flows — the scenarios from the \"connecting to the\n// daemon\" bug report: the dropdown must populate after a settings change\n// (no reload), the landing must tell the truth about the connection state,\n// and API errors must reach the user instead of an eternal \"connecting\".\n//\n// Each test builds fresh singletons (vi.resetModules) so the stores\n// reconstruct from a controlled localStorage, exactly like a page load.\n\nimport { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'\n\nconst html = (body = '') => `<!doctype html><html><head></head><body>${body}</body></html>`\nconst json = (v: unknown) => JSON.stringify(v)\n\nconst HEALTH = { version: '1.2.3', imagePresent: true, profiles: [] }\nconst PROJECTS = { projects: [{ name: 'manigot', path: '/srv/manigot' }] }\n\ninterface Stubbed {\n  status: number\n  body: string\n  type?: string\n}\n\n/** A fetch stub dispatching on the URL — HTML for anything unconfigured. */\nfunction stubFetch(handler: (url: string) => Stubbed) {\n  vi.stubGlobal(\n    'fetch',\n    vi.fn(async (input: RequestInfo | URL) => {\n      const r = handler(String(input))\n      return new Response(r.body, {\n        status: r.status,\n        headers: { 'Content-Type': r.type ?? 'application/json' },\n      })\n    }),\n  )\n}\n\n/** Everything unproxied (same-origin) is HTML — the vite dev server fallback. */\nconst devServer: (urls: Record<string, Stubbed>) => (url: string) => Stubbed =\n  (urls) =>\n  (url) =>\n    urls[url] ?? { status: 200, body: html(), type: 'text/html' }\n\n/** Fresh singletons AND a matching render() from the same module registry —\n * mixing a statically-imported testing library with a reset-registry App\n * gives two Svelte runtimes and orphaned effects. The registry's own\n * cleanup() is stashed so afterEach can unmount what it rendered (the\n * setup file's static cleanup cannot see these components).\n */\nasync function freshApp() {\n  vi.resetModules()\n  const { render, screen, waitFor, cleanup } = await import('@testing-library/svelte')\n  const { connection } = await import('$lib/state/connection.svelte')\n  const { data } = await import('$lib/state/data.svelte')\n  const { default: App } = await import('./App.svelte')\n  cleanupFn = cleanup\n  return { render, screen, waitFor, connection, data, App }\n}\n\nlet cleanupFn: (() => void) | null = null\n\nbeforeEach(() => {\n  localStorage.clear()\n  location.hash = '#/'\n})\n\nafterEach(() => {\n  cleanupFn?.()\n  cleanupFn = null\n  vi.unstubAllGlobals()\n})\n\ndescribe('App connection flows', () => {\n  it('populates the project dropdown after connecting via settings, without a reload', async () => {\n    stubFetch(\n      devServer({\n        '/api/health': { status: 200, body: json(HEALTH) },\n        '/api/projects': { status: 200, body: json(PROJECTS) },\n      }),\n    )\n    const { render, screen, waitFor, connection, App } = await freshApp()\n    render(App)\n    await waitFor(() => expect(connection.status).toBe('down'))\n\n    // the user opens the settings modal and points the connection at /api\n    connection.set('/api', '')\n    await waitFor(() => expect(connection.status).toBe('up'))\n\n    const select = await waitFor(() => screen.getByLabelText('project') as HTMLSelectElement)\n    await waitFor(() => {\n      expect(select.options.length).toBe(1)\n      expect(select.options[0]?.textContent).toBe('manigot')\n    })\n  })\n\n  it('does not claim \"Connecting to the daemon\" once the check has failed', async () => {\n    stubFetch(devServer({}))\n    const { render, screen, waitFor, connection, App } = await freshApp()\n    render(App)\n    await waitFor(() => expect(connection.status).toBe('down'))\n    await waitFor(() => {\n      const landing = document.querySelector('.landing')\n      expect(landing).toBeTruthy()\n      expect(landing!.textContent).not.toMatch(/Connecting to the daemon/)\n    })\n  })\n\n  it('says no projects are registered when a reachable daemon has none', async () => {\n    stubFetch(\n      devServer({\n        '/health': { status: 200, body: json(HEALTH) },\n        '/projects': { status: 200, body: json({ projects: [] }) },\n      }),\n    )\n    const { render, screen, waitFor, connection, App } = await freshApp()\n    render(App)\n    await waitFor(() => expect(connection.status).toBe('up'))\n    await waitFor(() => {\n      const landing = document.querySelector('.landing')\n      expect(landing?.textContent).toMatch(/No projects registered/)\n    })\n  })\n\n  it('stops fetching /projects once an empty registry has loaded — no reload loop', async () => {\n    let projectsCalls = 0\n    stubFetch((url) => {\n      if (url.includes('/projects')) {\n        projectsCalls++\n        return { status: 200, body: json({ projects: [] }) }\n      }\n      if (url.endsWith('/health')) return { status: 200, body: json(HEALTH) }\n      return { status: 200, body: html(), type: 'text/html' }\n    })\n    const { render, waitFor, connection, App } = await freshApp()\n    render(App)\n    await waitFor(() => expect(connection.status).toBe('up'))\n    await waitFor(() => expect(projectsCalls).toBeGreaterThan(0))\n    await new Promise((r) => setTimeout(r, 150))\n    const settled = projectsCalls\n    await new Promise((r) => setTimeout(r, 150))\n    // Regression: keying the reload on \"list is empty\" refetched forever\n    // (and OOMed the tab) whenever the daemon had zero projects.\n    expect(projectsCalls).toBe(settled)\n  })\n\n  it('shows the projects error instead of an empty dropdown when /projects fails', async () => {\n    stubFetch(\n      devServer({\n        '/health': { status: 200, body: json(HEALTH) },\n        '/projects': { status: 500, body: json({ error: 'registry exploded' }) },\n      }),\n    )\n    const { render, screen, waitFor, connection, App } = await freshApp()\n    render(App)\n    await waitFor(() => expect(connection.status).toBe('up'))\n    await waitFor(() => {\n      const landing = document.querySelector('.landing')\n      expect(landing?.textContent).toMatch(/registry exploded/)\n    })\n  })\n\n  it('leaves the landing once a project is active — the redirect hash must be single', async () => {\n    // Regression: navigate(href(...)) double-prefixed the fragment\n    // ('##/p/manigot'), which parseHash cannot parse, so the app stayed on\n    // the landing (\"Connecting to the daemon…\") with a connected daemon.\n    stubFetch(\n      devServer({\n        '/api/health': { status: 200, body: json(HEALTH) },\n        '/api/projects': { status: 200, body: json(PROJECTS) },\n        '/api/projects/manigot/jobs': { status: 200, body: json({ jobs: [] }) },\n      }),\n    )\n    const { render, screen, waitFor, connection, App } = await freshApp()\n    render(App)\n    await waitFor(() => expect(connection.status).toBe('down'))\n\n    connection.set('/api', '')\n    await waitFor(() => expect(connection.status).toBe('up'))\n    await waitFor(() => expect(screen.getByLabelText('project')).toBeTruthy())\n\n    // The landing must be gone: the redirect landed on the jobs page.\n    await waitFor(() => {\n      expect(location.hash).toBe('#/p/manigot')\n      expect(document.querySelector('.landing')).toBeNull()\n      expect(document.querySelector('h1')?.textContent).toBe('manigot')\n    })\n  })\n\n  it('renders the daemon health panel on #/health when /health answers', async () => {\n    localStorage.setItem('mg-control.connection', JSON.stringify({ baseUrl: '/api', token: '' }))\n    location.hash = '#/health'\n    stubFetch(\n      devServer({\n        '/api/health': { status: 200, body: json(HEALTH) },\n      }),\n    )\n    const { render, screen, waitFor, connection, App } = await freshApp()\n    render(App)\n    await waitFor(() => expect(connection.status).toBe('up'))\n    await waitFor(() => expect(screen.getByText('1.2.3')).toBeTruthy())\n  })\n})\n","numLines":202,"startLine":1,"totalLines":202}}}
