solved","+}","+","+// claudeMCPConfig serializes the resolved server set into Claude Code's","+// native .mcp.json shape: {\"mcpServers\": {\"<name>\": {...}}}. The canonical","+// schema (type/url/headers or type/command/args/env) already matches","+// Claude's own per-server shape field-for-field, so this is a wholesale","+// wrap, not a field remap. Returns (nil, false, nil) when servers is empty —","+// nothing to generate.","+func claudeMCPConfig(servers MCPServers) ([]byte, bool, error) {","+  if len(servers) == 0 {","+    return nil, false, nil","+  }","+  doc := struct {","+    MCPServers MCPServers `json:\"mcpServers\"`","+  }{MCPServers: servers}","+  data, err := json.MarshalIndent(doc, \"\", \"  \")","+  if err != nil {","+    return nil, false, err","+  }","+  return data, true, nil","+}"]}],"userModified":false,"replaceAll":false}}
