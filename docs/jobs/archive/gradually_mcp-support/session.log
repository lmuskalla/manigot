{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J7rnEsrFhiQSFxpqntwRHS","type":"tool_result","content":"789\tfunc TestBuildClaudeGlobalMetaMountedReadOnly(t *testing.T) {\n790\t\t_, home := docProject(t)\n791\t\twriteMeta(t, home, \"# manigot meta\\n\\nSystem-wide guidance.\\n\")\n792\t\tinfo, err := ResolveProfile(Options{})\n793\t\tif err != nil {\n794\t\t\tt.Fatalf(\"ResolveProfile: %v\", err)\n795\t\t}\n796\t\tif err := info.CheckAuth(); err != nil {\n797\t\t\tt.Fatalf(\"CheckAuth: %v\", err)\n798\t\t}\n799\t\tr, err := ResolveRoot(Options{})\n800\t\tif err != nil {\n801\t\t\tt.Fatalf(\"ResolveRoot: %v\", err)\n802\t\t}\n803\t\tinv, err := BuildDockerInvocation(Options{}, info, r, false, &strings.Builder{})\n804\t\tif err != nil {\n805\t\t\tt.Fatalf(\"BuildDockerInvocation: %v\", err)\n806\t\t}\n807\t\tcontainsAll(t, inv.Argv,\n808\t\t\t\"-v\", filepath.Join(home, \"prompts\", \"meta.md\")+\":/home/claude/.claude/CLAUDE.md:ro\",\n809\t\t)\n810\t\t// No temp dir was created for the Claude mount, so no cleanup is needed.\n811\t\tif inv.Cleanup != nil {\n812\t\t\tt.Error(\"claude global-meta mount must not carry a Cleanup hook\")\n813\t\t}\n814\t}\n815\t\n816\t// TestBuildOpenCodeGlobalMetaMountedReadOnly: OpenCode reads its global rules\n817\t// from ~/.config/opencode/AGENTS.md, so the global meta prompt is mounted\n818\t// read-only at that path. No conversion, no temp dir, no Cleanup hook.\n819\tfunc TestBuildOpenCodeGlobalMetaMountedReadOnly(t *testing.T) {\n820\t\t_, _ = docProject(t)\n821\t\t// A zai checkout whose prompts/meta.md carries the system-wide meta prompt.\n822\t\thome := checkout(t, \"MANIGOT_PROFILE=zai\\nZHIPU_API_KEY=z-secret\\n\")\n823\t\twriteMeta(t, home, \"# manigot meta\\n\\nSystem-wide guidance.\\n\")\n824\t\tinfo, err := ResolveProfile(Options{})\n825\t\tif err != nil {\n826\t\t\tt.Fatalf(\"ResolveProfile: %v\", err)\n827\t\t}\n828\t\tif err := info.CheckAuth(); err != nil {\n829\t\t\tt.Fatalf(\"CheckAuth: %v\