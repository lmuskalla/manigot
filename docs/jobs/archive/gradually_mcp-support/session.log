{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NUVvCHjSaUdSFnVE8iro9g","type":"tool_result","content":"1\tpackage session\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"reflect\"\n8\t\t\"testing\"\n9\t)\n10\t\n11\t// writeMCPServer writes a canonical MCP server definition file at\n12\t// <dir>/<name>.json.\n13\tfunc writeMCPServer(t *testing.T, dir, name string, content string) {\n14\t\tt.Helper()\n15\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n16\t\t\tt.Fatal(err)\n17\t\t}\n18\t\tif err := os.WriteFile(filepath.Join(dir, name+\".json\"), []byte(content), 0o644); err != nil {\n19\t\t\tt.Fatal(err)\n20\t\t}\n21\t}\n22\t\n23\tfunc TestLoadMCPServersMissingDir(t *testing.T) {\n24\t\tservers, err := loadMCPServers(filepath.Join(t.TempDir(), \"does-not-exist\"))\n25\t\tif err != nil {\n26\t\t\tt.Fatalf(\"loadMCPServers: %v\", err)\n27\t\t}\n28\t\tif servers != nil {\n29\t\t\tt.Errorf(\"loadMCPServers on a missing dir = %v, want nil\", servers)\n30\t\t}\n31\t}\n32\t\n33\tfunc TestLoadMCPServersEmptyDir(t *testing.T) {\n34\t\tdir := t.TempDir()\n35\t\tservers, err := loadMCPServers(dir)\n36\t\tif err != nil {\n37\t\t\tt.Fatalf(\"loadMCPServers: %v\", err)\n38\t\t}\n39\t\tif servers != nil {\n40\t\t\tt.Errorf(\"loadMCPServers on an empty dir = %v, want nil\", servers)\n41\t\t}\n42\t}\n43\t\n44\tfunc TestLoadMCPServersHTTP(t *testing.T) {\n45\t\tdir := t.TempDir()\n46\t\twriteMCPServer(t, dir, \"context7\", `{\"type\": \"http\", \"url\": \"https://mcp.context7.com/mcp\", \"headers\": {\"CONTEXT7_API_KEY\": \"$CONTEXT7_API_KEY\"}}`)\n47\t\tservers, err := loadMCPServers(dir)\n48\t\tif err != nil {\n49\t\t\tt.Fatalf(\"loadMCPServers: %v\", err)\n50\t\t}\n51\t\twant := MCPServers{\n52\t\t\t\"context7\": {\n53\t\t\t\tType:    \"http\",\n54\t\t\t\tURL:     \"https://mcp.context7.com/mcp\",\n55\t\t\t\tHeaders: map[string]string{\"CONTEXT7_API_KEY\": \"$CONTEXT7_API_KEY\"},\n56\t\t\t},\n57\t\t}\n58\t\tif !reflect.DeepEqual(servers, want) {\n59\t\t\tt.Errorf(\"loadMCPServers = %+v, want %+v\", servers, want)\n60\t\t}\n61\t}\n62\t\n63\tfunc TestLoadMCPServersStdio(t *testing.T) {\n64\t\tdir := t.TempDir()\n65\t\twriteMCPServer(t, dir, \"local-thing\", `{\"type\": \"stdio\", \"command\": \"some-mcp\", \"args\": [\"--flag\"], \"env\": {\"TOKEN\": \"$SOME_TOKEN\"}}`)\n66\t\tservers, err := loadMCPServers(dir)\n67\t\tif err != nil {\n68\t\t\tt.Fatalf(\"loadMCPServers: %v\", err)\n69\t\t}\n70\t\twant := MCPServers{\n71\t\t\t\"local-thing\": {\n72\t\t\t\tType:    \"stdio\",\n73\t\t\t\tCommand: \"some-mcp\",\n74\t\t\t\tArgs:    []string{\"--flag\"},\n75\t\t\t\tEnv:     map[string]string{\"TOKEN\": \"$SOME_TOKEN\"},\n76\t\t\t},\n77\t\t}\n78\t\tif !reflect.DeepEqual(servers, want) {\n79\t\t\tt.Errorf(\"loadMCPServers = %+v, want %+v\", servers, want)\n80\t\t}\n81\t}\n82\t\n83\t// TestLoadMCPServersIgnoresNonJSON: only *.json files at the top level of\n84\t// the dir are considered — a stray non-JSON file or a subdirectory is\n85\t// skipped, mirroring listSkills/convertAgents's own filtering.\n86\tfunc TestLoadMCPServersIgnoresNonJSON(t *testing.T) {\n87\t\tdir := t.TempDir()\n88\t\twriteMCPServer(t, dir, \"context7\", `{\"type\": \"http\", \"url\": \"https://mcp.context7.com/mcp\"}`)\n89\t\tif err := os.WriteFile(filepath.Join(dir, \"README.md\"), []byte(\"not json\"), 0o644); err != nil {\n90\t\t\tt.Fatal(err)\n91\t\t}\n92\t\tif err := os.MkdirAll(filepath.Join(dir, \"subdir.json\"), 0o755); err != nil {\n93\t\t\tt.Fatal(err)\n94\t\t}\n95\t\tservers, err := loadMCPServers(dir)\n96\t\tif err != nil {\n97\t\t\tt.Fatalf(\"loadMCPServers: %v\", err)\n98\t\t}\n99\t\tif len(servers) != 1 {\n100\t\t\tt.Errorf(\"loadMCPServers = %+v, want exactly one entry (context7)\", servers)\n101\t\t}\n102\t}\n103\t\n104\tfunc TestLoadMCPServersUnknownTypeErrors(t *testing.T) {\n105\t\tdir := t.TempDir()\n106\t\twriteMCPServer(t, dir, \"bogus\", `{\"type\": \"websocket\", \"url\": \"wss://example.com\"}`)\n107\t\tif _, err := loadMCPServers(dir); err == nil {\n108\t\t\tt.Error(\"loadMCPServers with an unknown type must error, got nil\")\n109\t\t}\n110\t}\n111\t\n112\tfunc TestLoadMCPServersInvalidJSONErrors(t *testing.T) {\n113\t\tdir := t.TempDir()\n114\t\twriteMCPServer(t, dir, \"bogus\", `{not valid json`)\n115\t\tif _, err := loadMCPServers(dir); err == nil {\n116\t\t\tt.Error(\"loadMCPServers with invalid JSON must error, got nil\")\n117\t\t}\n118\t}\n119\t\n120\tfunc TestMergeMCPServersProjectWinsByFilename(t *testing.T) {\n121\t\tglobal := MCPServers{\n122\t\t\t\"context7\":    {Type: \"http\", URL: \"https://mcp.context7.com/mcp\"},\n123\t\t\t\"only-global\": {Type: \"http\", URL: \"https://global.example.com/mcp\"},\n124\t\t}\n125\t\tproject := MCPServers{\n126\t\t\t\"context7\":     {Type: \"http\", URL: \"https://project-override.example.com/mcp\"},\n127\t\t\t\"only-project\": {Type: \"http\", URL: \"https://project.example.com/mcp\"},\n128\t\t}\n129\t\tmerged := mergeMCPServers(global, project)\n130\t\twant := MCPServers{\n131\t\t\t\"context7\":     {Type: \"http\", URL: \"https://project-override.example.com/mcp\"},\n132\t\t\t\"only-global\":  {Type: \"http\", URL: \"https://global.example.com/mcp\"},\n133\t\t\t\"only-project\": {Type: \"http\", URL: \"https://project.example.com/mcp\"},\n134\t\t}\n135\t\tif !reflect.DeepEqual(merged, want) {\n136\t\t\tt.Errorf(\"mergeMCPServers = %+v, want %+v\", merged, want)\n137\t\t}\n138\t}\n139\t\n140\tfunc TestMergeMCPServersBothEmptyIsNil(t *testing.T) {\n141\t\tif merged := mergeMCPServers(nil, nil); merged != nil {\n142\t\t\tt.Errorf(\"mergeMCPServers(nil, nil) = %+v, want nil\", merged)\n143\t\t}\n144\t}\n145\t\n146\tfunc TestDiscoverMCPServersGlobalAndProject(t *testing.T) {\n147\t\thome := t.TempDir()\n148\t\twriteMCPServer(t, filepath.Join(home, \"mcp\"), \"context7\", `{\"type\": \"http\", \"url\": \"https://mcp.context7.com/mcp\"}`)\n149\t\n150\t\tdocs := t.TempDir()\n151\t\twriteMCPServer(t, filepath.Join(docs, \"mcp\"), \"project-only\", `{\"type\": \"http\", \"url\": \"https://project.example.com/mcp\"}`)\n152\t\n153\t\tmerged, err := discoverMCPServers(home, docs)\n154\t\tif err != nil {\n155\t\t\tt.Fatalf(\"discoverMCPServers: %v\", err)\n156\t\t}\n157\t\tif len(merged) != 2 || merged[\"context7\"].URL != \"https://mcp.context7.com/mcp\" || merged[\"project-only\"].URL != \"https://project.example.com/mcp\" {\n158\t\t\tt.Errorf(\"discoverMCPServers = %+v\", merged)\n159\t\t}\n160\t}\n161\t\n162\tfunc TestDiscoverMCPServersNoneConfigured(t *testing.T) {\n163\t\tmerged, err := discoverMCPServers(t.TempDir(), t.TempDir())\n164\t\tif err != nil {\n165\t\t\tt.Fatalf(\"discoverMCPServers: %v\", err)\n166\t\t}\n167\t\tif merged != nil {\n168\t\t\tt.Errorf(\"discoverMCPServers with nothing configured = %+v, want nil\", merged)\n169\t\t}\n170\t}\n171\t\n172\tfunc TestDiscoverMCPServersEmptyHomeAndDocs(t *testing.T) {\n173\t\tmerged, err := discoverMCPServers(\"\", \"\")\n174\t\tif err != nil {\n175\t\t\tt.Fatalf(\"discoverMCPServers: %v\", err)\n176\t\t}\n177\t\tif merged != nil {\n178\t\t\tt.Errorf(\"discoverMCPServers(\\\"\\\", \\\"\\\") = %+v, want nil\", merged)\n179\t\t}\n180\t}\n181\t\n182\t// TestResolveMCPServersSubstitutesVar: a $VARNAME token in a header value is\n183\t// replaced with that key's value from manigot's own .env.\n184\tfunc TestResolveMCPServersSubstitutesVar(t *testing.T) {\n185\t\tcheckout(t, \"CONTEXT7_API_KEY=ctx7-secret\\n\")\n186\t\tservers := MCPServers{\n187\t\t\t\"context7\": {\n188\t\t\t\tType:    \"http\",\n189\t\t\t\tURL:     \"https://mcp.context7.com/mcp\",\n190\t\t\t\tHeaders: map[string]string{\"CONTEXT7_API_KEY\": \"$CONTEXT7_API_KEY\"},\n191\t\t\t},\n192\t\t}\n193\t\tresolved := resolveMCPServers(servers)\n194\t\twant := MCPServers{\n195\t\t\t\"context7\": {\n196\t\t\t\tType:    \"http\",\n197\t\t\t\tURL:     \"https://mcp.context7.com/mcp\",\n198\t\t\t\tHeaders: map[string]string{\"CONTEXT7_API_KEY\": \"ctx7-secret\"},\n199\t\t\t},\n200\t\t}\n201\t\tif !reflect.DeepEqual(resolved, want) {\n202\t\t\tt.Errorf(\"resolveMCPServers = %+v, want %+v\", resolved, want)\n203\t\t}\n204\t}\n205\t\n206\t// TestResolveMCPServersUnsetVarDropsHeader: an unset $VARNAME resolves to\n207\t// \"\", and the whole header/env entry is dropped rather than sent empty —\n208\t// Context7 works unauthenticated at a lower rate limit when\n209\t// CONTEXT7_API_KEY isn't configured.\n210\tfunc TestResolveMCPServersUnsetVarDropsHeader(t *testing.T) {\n211\t\tcheckout(t, \"\")\n212\t\tservers := MCPServers{\n213\t\t\t\"context7\": {\n214\t\t\t\tType:    \"http\",\n215\t\t\t\tURL:     \"https://mcp.context7.com/mcp\",\n216\t\t\t\tHeaders: map[string]string{\"CONTEXT7_API_KEY\": \"$CONTEXT7_API_KEY\"},\n217\t\t\t},\n218\t\t}\n219\t\tresolved := resolveMCPServers(servers)\n220\t\twant := MCPServers{\n221\t\t\t\"context7\": {\n222\t\t\t\tType: \"http\",\n223\t\t\t\tURL:  \"https://mcp.context7.com/mcp\",\n224\t\t\t},\n225\t\t}\n226\t\tif !reflect.DeepEqual(resolved, want) {\n227\t\t\tt.Errorf(\"resolveMCPServers = %+v, want %+v\", resolved, want)\n228\t\t}\n229\t}\n230\t\n231\t// TestResolveMCPServersStdioEnvAndArgs: $VARNAME substitution also applies\n232\t// to a stdio server's command, args, and env values.\n233\tfunc TestResolveMCPServersStdioEnvAndArgs(t *testing.T) {\n234\t\tcheckout(t, \"SOME_TOKEN=tok-123\\n\")\n235\t\tservers := MCPServers{\n236\t\t\t\"local\": {\n237\t\t\t\tType:    \"stdio\",\n238\t\t\t\tCommand: \"some-mcp\",\n239\t\t\t\tArgs:    []string{\"--token=$SOME_TOKEN\"},\n240\t\t\t\tEnv:     map[string]string{\"TOKEN\": \"$SOME_TOKEN\"},\n241\t\t\t},\n242\t\t}\n243\t\tresolved := resolveMCPServers(servers)\n244\t\twant := MCPServers{\n245\t\t\t\"local\": {\n246\t\t\t\tType:    \"stdio\",\n247\t\t\t\tCommand: \"some-mcp\",\n248\t\t\t\tArgs:    []string{\"--token=tok-123\"},\n249\t\t\t\tEnv:     map[string]string{\"TOKEN\": \"tok-123\"},\n250\t\t\t},\n251\t\t}\n252\t\tif !reflect.DeepEqual(resolved, want) {\n253\t\t\tt.Errorf(\"resolveMCPServers = %+v, want %+v\", resolved, want)\n254\t\t}\n255\t}\n256\t\n257\tfunc TestResolveMCPServersEmptyIsNil(t *testing.T) {\n258\t\tif resolved := resolveMCPServers(nil); resolved != nil {\n259\t\t\tt.Errorf(\"resolveMCPServers(nil) = %+v, want nil\", resolved)\n260\t\t}\n261\t}\n262\t\n263\t// TestClaudeMCPConfigWrapsServers: the resolved server set serializes into\n264\t// Claude Code's native {\"mcpServers\": {...}} shape, field-for-field\n265\t// identical to the canonical schema.\n266\tfunc TestClaudeMCPConfigWrapsServers(t *testing.T) {\n267\t\tservers := MCPServers{\n268\t\t\t\"context7\": {\n269\t\t\t\tType:    \"http\",\n270\t\t\t\tURL:     \"https://mcp.context7.com/mcp\",\n271\t\t\t\tHeaders: map[string]string{\"CONTEXT7_API_KEY\": \"ctx7-secret\"},\n272\t\t\t},\n273\t\t}\n274\t\tdata, ok, err := claudeMCPConfig(servers)\n275\t\tif err != nil {\n276\t\t\tt.Fatalf(\"claudeMCPConfig: %v\", err)\n277\t\t}\n278\t\tif !ok {\n279\t\t\tt.Fatal(\"claudeMCPConfig ok = false, want true\")\n280\t\t}\n281\t\tvar doc struct {\n282\t\t\tMCPServers MCPServers `json:\"mcpServers\"`\n283\t\t}\n284\t\tif err := json.Unmarshal(data, &doc); err != nil {\n285\t\t\tt.Fatalf(\"unmarshal generated .mcp.json: %v\", err)\n286\t\t}\n287\t\tif !reflect.DeepEqual(doc.MCPServers, servers) {\n288\t\t\tt.Errorf(\"claudeMCPConfig round-trip = %+v, want %+v\", doc.MCPServers, servers)\n289\t\t}\n290\t}\n291\t\n292\tfunc TestClaudeMCPConfigEmptyServers(t *testing.T) {\n293\t\tdata, ok, err := claudeMCPConfig(nil)\n294\t\tif err != nil {\n295\t\t\tt.Fatalf(\"claudeMCPConfig: %v\", err)\n296\t\t}\n297\t\tif ok || data != nil {\n298\t\t\tt.Errorf(\"claudeMCPConfig(nil) = (%q, %v), want (nil, false)\", data, ok)\n299\t\t}\n300\t}\n301\t\n302\t// TestOpenCodeMCPBlockHTTPBecomesRemote: a canonical \"http\" server converts\n303\t// to OpenCode's \"remote\" type, url/headers carried through unchanged.\n304\tfunc TestOpenCodeMCPBlockHTTPBecomesRemote(t *testing.T) {\n305\t\tservers := MCPServers{\n306\t\t\t\"context7\": {\n307\t\t\t\tType:    \"http\",\n308\t\t\t\tURL:     \"https://mcp.context7.com/mcp\",\n309\t\t\t\tHeaders: map[string]string{\"CONTEXT7_API_KEY\": \"ctx7-secret\"},\n310\t\t\t},\n311\t\t}\n312\t\tblock := openCodeMCPBlock(servers)\n313\t\twant := map[string]openCodeMCPServer{\n314\t\t\t\"context7\": {\n315\t\t\t\tType:    \"remote\",\n316\t\t\t\tURL:     \"https://mcp.context7.com/mcp\",\n317\t\t\t\tHeaders: map[string]string{\"CONTEXT7_API_KEY\": \"ctx7-secret\"},\n318\t\t\t},\n319\t\t}\n320\t\tif !reflect.DeepEqual(block, want) {\n321\t\t\tt.Errorf(\"openCodeMCPBlock = %+v, want %+v\", block, want)\n322\t\t}\n323\t}\n324\t\n325\t// TestOpenCodeMCPBlockStdioBecomesLocal: a canonical \"stdio\" server converts\n326\t// to OpenCode's \"local\" type, command+args merged into a single command\n327\t// array and env renamed to environment.\n328\tfunc TestOpenCodeMCPBlockStdioBecomesLocal(t *testing.T) {\n329\t\tservers := MCPServers{\n330\t\t\t\"local-thing\": {\n331\t\t\t\tType:    \"stdio\",\n332\t\t\t\tCommand: \"some-mcp\",\n333\t\t\t\tArgs:    []string{\"--flag\", \"value\"},\n334\t\t\t\tEnv:     map[string]string{\"TOKEN\": \"tok-123\"},\n335\t\t\t},\n336\t\t}\n337\t\tblock := openCodeMCPBlock(servers)\n338\t\twant := map[string]openCodeMCPServer{\n339\t\t\t\"local-thing\": {\n340\t\t\t\tType:        \"local\",\n341\t\t\t\tCommand:     []string{\"some-mcp\", \"--flag\", \"value\"},\n342\t\t\t\tEnvironment: map[string]string{\"TOKEN\": \"tok-123\"},\n343\t\t\t},\n344\t\t}\n345\t\tif !reflect.DeepEqual(block, want) {\n346\t\t\tt.Errorf(\"openCodeMCPBlock = %+v, want %+v\", block, want)\n347\t\t}\n348\t}\n349\t\n350\tfunc TestOpenCodeMCPBlockEmptyIsNil(t *testing.T) {\n351\t\tif block := openCodeMCPBlock(nil); block != nil {\n352\t\t\tt.Errorf(\"openCodeMCPBlock(nil) = %+v, want nil\", block)\n353\t\t}\n354\t}\n355\t\n356\t// TestBuildOpenCodeConfigModelOnly pins TASK-4's model migration: with no\n357\t// MCP servers configured, the generated opencode.json still carries the\n358\t// resolved model — the logic scripts/entrypoint.sh used to write via\n359\t// {env:OPENCODE_MODEL} substitution, now resolved and written directly.\n360\tfunc TestBuildOpenCodeConfigModelOnly(t *testing.T) {\n361\t\tdata, ok, err := buildOpenCodeConfig(\"zai-coding-plan/glm-5.2\", nil)\n362\t\tif err != nil {\n363\t\t\tt.Fatalf(\"buildOpenCodeConfig: %v\", err)\n364\t\t}\n365\t\tif !ok {\n366\t\t\tt.Fatal(\"buildOpenCodeConfig ok = false, want true\")\n367\t\t}\n368\t\tvar cfg openCodeConfig\n369\t\tif err := json.Unmarshal(data, &cfg); err != nil {\n370\t\t\tt.Fatalf(\"unmarshal generated opencode.json: %v\", err)\n371\t\t}\n372\t\tif cfg.Schema != openCodeConfigSchema || cfg.Model != \"zai-coding-plan/glm-5.2\" || len(cfg.MCP) != 0 {\n373\t\t\tt.Errorf(\"buildOpenCodeConfig = %+v\", cfg)\n374\t\t}\n375\t}\n376\t\n377\t// TestBuildOpenCodeConfigModelAndMCP: model and mcp compose into one\n378\t// generated file.\n379\tfunc TestBuildOpenCodeConfigModelAndMCP(t *testing.T) {\n380\t\tservers := MCPServers{\"context7\": {Type: \"http\", URL: \"https://mcp.context7.com/mcp\"}}\n381\t\tdata, ok, err := buildOpenCodeConfig(\"zai-coding-plan/glm-5.2\", servers)\n382\t\tif err != nil {\n383\t\t\tt.Fatalf(\"buildOpenCodeConfig: %v\", err)\n384\t\t}\n385\t\tif !ok {\n386\t\t\tt.Fatal(\"buildOpenCodeConfig ok = false, want true\")\n387\t\t}\n388\t\tvar cfg openCodeConfig\n389\t\tif err := json.Unmarshal(data, &cfg); err != nil {\n390\t\t\tt.Fatalf(\"unmarshal generated opencode.json: %v\", err)\n391\t\t}\n392\t\tif cfg.Model != \"zai-coding-plan/glm-5.2\" {\n393\t\t\tt.Errorf(\"buildOpenCodeConfig Model = %q\", cfg.Model)\n394\t\t}\n395\t\tif got := cfg.MCP[\"context7\"]; got.Type != \"remote\" || got.URL != \"https://mcp.context7.com/mcp\" {\n396\t\t\tt.Errorf(\"buildOpenCodeConfig MCP[context7] = %+v\", got)\n397\t\t}\n398\t}\n399\t\n400\t// TestBuildOpenCodeConfigNothingConfigured: no model, no servers — nothing\n401\t// is generated at all, matching the pre-this-job behavior of\n402\t// entrypoint.sh's guarded write.\n403\tfunc TestBuildOpenCodeConfigNothingConfigured(t *testing.T) {\n404\t\tdata, ok, err := buildOpenCodeConfig(\"\", nil)\n405\t\tif err != nil {\n406\t\t\tt.Fatalf(\"buildOpenCodeConfig: %v\", err)\n407\t\t}\n408\t\tif ok || data != nil {\n409\t\t\tt.Errorf(\"buildOpenCodeConfig(\\\"\\\", nil) = (%q, %v), want (nil, false)\", data, ok)\n410\t\t}\n411\t}\n412\t\n413\t// TestBuildOpenCodeConfigMCPOnlyNoModel: MCP servers configured but no\n414\t// model resolved — the file is still generated (mcp alone is enough).\n415\tfunc TestBuildOpenCodeConfigMCPOnlyNoModel(t *testing.T) {\n416\t\tservers := MCPServers{\"context7\": {Type: \"http\", URL: \"https://mcp.context7.com/mcp\"}}\n417\t\tdata, ok, err := buildOpenCodeConfig(\"\", servers)\n418\t\tif err != nil {\n419\t\t\tt.Fatalf(\"buildOpenCodeConfig: %v\", err)\n420\t\t}\n421\t\tif !ok || data == nil {\n422\t\t\tt.Fatal(\"buildOpenCodeConfig with mcp servers but no model must still generate a file\")\n423\t\t}\n424\t\tvar cfg openCodeConfig\n425\t\tif err := json.Unmarshal(data, &cfg); err != nil {\n426\t\t\tt.Fatalf(\"unmarshal generated opencode.json: %v\", err)\n427\t\t}\n428\t\tif cfg.Model != \"\" {\n429\t\t\tt.Errorf(\"buildOpenCodeConfig Model = %q, want empty\", cfg.Model)\n430\t\t}\n431\t}\n432\t"}]},"parent_tool_use_id":null,"session_id":"758c6919-115b-46e4-8bbb-430b2fbed028","uuid":"aa35e050-b658-4830-8ca6-afaf79357039","timestamp":"2026-08-31T14:07:18.175Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/session/mcp_test.go","content":"package session\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"reflect\"\n\t\"testing\"\n)\n\n// writeMCPServer writes a canonical MCP server definition file at\n// <dir>/<name>.json.\nfunc writeMCPServer(t *testing.T, dir, name string, content string) {\n\tt.Helper()\n\tif err := os.MkdirAll(dir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(dir, name+\".json\"), []byte(content), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\nfunc TestLoadMCPServersMissingDir(t *testing.T) {\n\tservers, err := loadMCPServers(filepath.Join(t.TempDir(), \"does-not-exist\"))\n\tif err != nil {\n\t\tt.Fatalf(\"loadMCPServers: %v\", err)\n\t}\n\tif servers != nil {\n\t\tt.Errorf(\"loadMCPServers on a missing dir = %v, want nil\", servers)\n\t}\n}\n\nfunc TestLoadMCPServersEmptyDir(t *testing.T) {\n\tdir := t.TempDir()\n\tservers, err := loadMCPServers(dir)\n\tif err != nil {\n\t\tt.Fatalf(\"loadMCPServers: %v\", err)\n\t}\n\tif servers != nil {\n\t\tt.Errorf(\"loadMCPServers on an empty dir = %v, want nil\", servers)\n\t}\n}\n\nfunc TestLoadMCPServersHTTP(t *testing.T) {\n\tdir := t.TempDir()\n\twriteMCPServer(t, dir, \"context7\", `{\"type\": \"http\", \"url\": \"https://mcp.context7.com/mcp\", \"headers\": {\"CONTEXT7_API_KEY\": \"$CONTEXT7_API_KEY\"}}`)\n\tservers, err := loadMCPServers(dir)\n\tif err != nil {\n\t\tt.Fatalf(\"loadMCPServers: %v\", err)\n\t}\n\twant := MCPServers{\n\t\t\"context7\": {\n\t\t\tType:    \"http\",\n\t\t\tURL:     \"https://mcp.context7.com/mcp\",\n\t\t\tHeaders: map[string]string{\"CONTEXT7_API_KEY\": \"$CONTEXT7_API_KEY\"},\n\t\t},\n\t}\n\tif !reflect.DeepEqual(servers, want) {\n\t\tt.Errorf(\"loadMCPServers = %+v, want %+v\", servers, want)\n\t}\n}\n\nfunc TestLoadMCPServersStdio(t *testing.T) {\n\tdir := t.TempDir()\n\twriteMCPServer(t, dir, \"local-thing\", `{\"type\": \"stdio\", \"command\": \"some-mcp\", \"args\": [\"--flag\"], \"env\": {\"TOKEN\": \"$SOME_TOKEN\"}}`)\n\tservers, err := loadMCPServers(dir)\n\tif err != nil {\n\t\tt.Fatalf(\"loadMCPServers: %v\", err)\n\t}\n\twant := MCPServers{\n\t\t\"local-thing\": {\n\t\t\tType:    \"stdio\",\n\t\t\tCommand: \"some-mcp\",\n\t\t\tArgs:    []string{\"--flag\"},\n\t\t\tEnv:     map[string]string{\"TOKEN\": \"$SOME_TOKEN\"},\n\t\t},\n\t}\n\tif !reflect.DeepEqual(servers, want) {\n\t\tt.Errorf(\"loadMCPServers = %+v, want %+v\", servers, want)\n\t}\n}\n\n// TestLoadMCPServersIgnoresNonJSON: only *.json files at the top level of\n// the dir are considered — a stray non-JSON file or a subdirectory is\n// skipped, mirroring listSkills/convertAgents's own filtering.\nfunc TestLoadMCPServersIgnoresNonJSON(t *testing.T) {\n\tdir := t.TempDir()\n\twriteMCPServer(t, dir, \"context7\", `{\"type\": \"http\", \"url\": \"https://mcp.context7.com/mcp\"}`)\n\tif err := os.WriteFile(filepath.Join(dir, \"README.md\"), []byte(\"not json\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.MkdirAll(filepath.Join(dir, \"subdir.json\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tservers, err := loadMCPServers(dir)\n\tif err != nil {\n\t\tt.Fatalf(\"loadMCPServers: %v\", err)\n\t}\n\tif len(servers) != 1 {\n\t\tt.Errorf(\"loadMCPServers = %+v, want exactly one entry (context7)\", servers)\n\t}\n}\n\nfunc TestLoadMCPServersUnknownTypeErrors(t *testing.T) {\n\tdir := t.TempDir()\n\twriteMCPServer(t, dir, \"bogus\", `{\"type\": \"websocket\", \"url\": \"wss://example.com\"}`)\n\tif _, err := loadMCPServers(dir); err == nil {\n\t\tt.Error(\"loadMCPServers with an unknown type must error, got nil\")\n\t}\n}\n\nfunc TestLoadMCPServersInvalidJSONErrors(t *testing.T) {\n\tdir := t.TempDir()\n\twriteMCPServer(t, dir, \"bogus\", `{not valid json`)\n\tif _, err := loadMCPServers(dir); err == nil {\n\t\tt.Error(\"loadMCPServers with invalid JSON must error, got nil\")\n\t}\n}\n\nfunc TestMergeMCPServersProjectWinsByFilename(t *testing.T) {\n\tglobal := MCPServers{\n\t\t\"context7\":    {Type: \"http\", URL: \"https://mcp.context7.com/mcp\"},\n\t\t\"only-global\": {Type: \"http\", URL: \"https://global.example.com/mcp\"},\n\t}\n\tproject := MCPServers{\n\t\t\"context7\":     {Type: \"http\", URL: \"https://project-override.example.com/mcp\"},\n\t\t\"only-project\": {Type: \"http\", URL: \"https://project.example.com/mcp\"},\n\t}\n\tmerged := mergeMCPServers(global, project)\n\twant := MCPServers{\n\t\t\"context7\":     {Type: \"http\", URL: \"https://project-override.example.com/mcp\"},\n\t\t\"only-global\":  {Type: \"http\", URL: \"https://global.example.com/mcp\"},\n\t\t\"only-project\": {Type: \"http\", URL: \"https://project.example.com/mcp\"},\n\t}\n\tif !reflect.DeepEqual(merged, want) {\n\t\tt.Errorf(\"mergeMCPServers = %+v, want %+v\", merged, want)\n\t}\n}\n\nfunc TestMergeMCPServersBothEmptyIsNil(t *testing.T) {\n\tif merged := mergeMCPServers(nil, nil); merged != nil {\n\t\tt.Errorf(\"mergeMCPServers(nil, nil) = %+v, want nil\", merged)\n\t}\n}\n\nfunc TestDiscoverMCPServersGlobalAndProject(t *testing.T) {\n\thome := t.TempDir()\n\twriteMCPServer(t, filepath.Join(home, \"mcp\"), \"context7\", `{\"type\": \"http\", \"url\": \"https://mcp.context7.com/mcp\"}`)\n\n\tdocs := t.TempDir()\n\twriteMCPServer(t, filepath.Join(docs, \"mcp\"), \"project-only\", `{\"type\": \"http\", \"url\": \"https://project.example.com/mcp\"}`)\n\n\tmerged, err := discoverMCPServers(home, docs)\n\tif err != nil {\n\t\tt.Fatalf(\"discoverMCPServers: %v\", err)\n\t}\n\tif len(merged) != 2 || merged[\"context7\"].URL != \"https://mcp.context7.com/mcp\" || merged[\"project-only\"].URL != \"https://project.example.com/mcp\" {\n\t\tt.Errorf(\"discoverMCPServers = %+v\", merged)\n\t}\n}\n\nfunc TestDiscoverMCPServersNoneConfigured(t *testing.T) {\n\tmerged, err := discoverMCPServers(t.TempDir(), t.TempDir())\n\tif err != nil {\n\t\tt.Fatalf(\"discoverMCPServers: %v\", err)\n\t}\n\tif merged != nil {\n\t\tt.Errorf(\"discoverMCPServers with nothing configured = %+v, want nil\", merged)\n\t}\n}\n\nfunc TestDiscoverMCPServersEmptyHomeAndDocs(t *testing.T) {\n\tmerged, err := discoverMCPServers(\"\", \"\")\n\tif err != nil {\n\t\tt.Fatalf(\"discoverMCPServers: %v\", err)\n\t}\n\tif merged != nil {\n\t\tt.Errorf(\"discoverMCPServers(\\\"\\\", \\\"\\\") = %+v, want nil\", merged)\n\t}\n}\n\n// TestResolveMCPServersSubstitutesVar: a $VARNAME token in a header value is\n// replaced with that key's value from manigot's own .env.\nfunc TestResolveMCPServersSubstitutesVar(t *testing.T) {\n\tcheckout(t, \"CONTEXT7_API_KEY=ctx7-secret\\n\")\n\tservers := MCPServers{\n\t\t\"context7\": {\n\t\t\tType:    \"http\",\n\t\t\tURL:     \"https://mcp.context7.com/mcp\",\n\t\t\tHeaders: map[string]string{\"CONTEXT7_API_KEY\": \"$CONTEXT7_API_KEY\"},\n\t\t},\n\t}\n\tresolved := resolveMCPServers(servers)\n\twant := MCPServers{\n\t\t\"context7\": {\n\t\t\tType:    \"http\",\n\t\t\tURL:     \"https://mcp.context7.com/mcp\",\n\t\t\tHeaders: map[string]string{\"CONTEXT7_API_KEY\": \"ctx7-secret\"},\n\t\t},\n\t}\n\tif !reflect.DeepEqual(resolved, want) {\n\t\tt.Errorf(\"resolveMCPServers = %+v, want %+v\", resolved, want)\n\t}\n}\n\n// TestResolveMCPServersUnsetVarDropsHeader: an unset $VARNAME resolves to\n// \"\", and the whole header/env entry is dropped rather than sent empty —\n// Context7 works unauthenticated at a lower rate limit when\n// CONTEXT7_API_KEY isn't configured.\nfunc TestResolveMCPServersUnsetVarDropsHeader(t *testing.T) {\n\tcheckout(t, \"\")\n\tservers := MCPServers{\n\t\t\"context7\": {\n\t\t\tType:    \"http\",\n\t\t\tURL:     \"https://mcp.context7.com/mcp\",\n\t\t\tHeaders: map[string]string{\"CONTEXT7_API_KEY\": \"$CONTEXT7_API_KEY\"},\n\t\t},\n\t}\n\tresolved := resolveMCPServers(servers)\n\twant := MCPServers{\n\t\t\"context7\": {\n\t\t\tType: \"http\",\n\t\t\tURL:  \"https://mcp.context7.com/mcp\",\n\t\t},\n\t}\n\tif !reflect.DeepEqual(resolved, want) {\n\t\tt.Errorf(\"resolveMCPServers = %+v, want %+v\", resolved, want)\n\t}\n}\n\n// TestResolveMCPServersStdioEnvAndArgs: $VARNAME substitution also applies\n// to a stdio server's command, args, and env values.\nfunc TestResolveMCPServersStdioEnvAndArgs(t *testing.T) {\n\tcheckout(t, \"SOME_TOKEN=tok-123\\n\")\n\tservers := MCPServers{\n\t\t\"local\": {\n\t\t\tType:    \"stdio\",\n\t\t\tCommand: \"some-mcp\",\n\t\t\tArgs:    []string{\"--token=$SOME_TOKEN\"},\n\t\t\tEnv:     map[string]string{\"TOKEN\": \"$SOME_TOKEN\"},\n\t\t},\n\t}\n\tresolved := resolveMCPServers(servers)\n\twant := MCPServers{\n\t\t\"local\": {\n\t\t\tType:    \"stdio\",\n\t\t\tCommand: \"some-mcp\",\n\t\t\tArgs:    []string{\"--token=tok-123\"},\n\t\t\tEnv:     map[string]string{\"TOKEN\": \"tok-123\"},\n\t\t},\n\t}\n\tif !reflect.DeepEqual(resolved, want) {\n\t\tt.Errorf(\"resolveMCPServers = %+v, want %+v\", resolved, want)\n\t}\n}\n\nfunc TestResolveMCPServersEmptyIsNil(t *testing.T) {\n\tif resolved := resolveMCPServers(nil); resolved != nil {\n\t\tt.Errorf(\"resolveMCPServers(nil) = %+v, want nil\", resolved)\n\t}\n}\n\n// TestClaudeMCPConfigWrapsServers: the resolved server set serializes into\n// Claude Code's native {\"mcpServers\": {...}} shape, field-for-field\n// identical to the canonical schema.\nfunc TestClaudeMCPConfigWrapsServers(t *testing.T) {\n\tservers := MCPServers{\n\t\t\"context7\": {\n\t\t\tType:    \"http\",\n\t\t\tURL:     \"https://mcp.context7.com/mcp\",\n\t\t\tHeaders: map[string]string{\"CONTEXT7_API_KEY\": \"ctx7-secret\"},\n\t\t},\n\t}\n\tdata, ok, err := claudeMCPConfig(servers)\n\tif err != nil {\n\t\tt.Fatalf(\"claudeMCPConfig: %v\", err)\n\t}\n\tif !ok {\n\t\tt.Fatal(\"claudeMCPConfig ok = false, want true\")\n\t}\n\tvar doc struct {\n\t\tMCPServers MCPServers `json:\"mcpServers\"`\n\t}\n\tif err := json.Unmarshal(data, &doc); err != nil {\n\t\tt.Fatalf(\"unmarshal generated .mcp.json: %v\", err)\n\t}\n\tif !reflect.DeepEqual(doc.MCPServers, servers) {\n\t\tt.Errorf(\"claudeMCPConfig round-trip = %+v, want %+v\", doc.MCPServers, servers)\n\t}\n}\n\nfunc TestClaudeMCPConfigEmptyServers(t *testing.T) {\n\tdata, ok, err := claudeMCPConfig(nil)\n\tif err != nil {\n\t\tt.Fatalf(\"claudeMCPConfig: %v\", err)\n\t}\n\tif ok || data != nil {\n\t\tt.Errorf(\"claudeMCPConfig(nil) = (%q, %v), want (nil, false)\", data, ok)\n\t}\n}\n\n// TestOpenCodeMCPBlockHTTPBecomesRemote: a canonical \"http\" server converts\n// to OpenCode's \"remote\" type, url/headers carried through unchanged.\nfunc TestOpenCodeMCPBlockHTTPBecomesRemote(t *testing.T) {\n\tservers := MCPServers{\n\t\t\"context7\": {\n\t\t\tType:    \"http\",\n\t\t\tURL:     \"https://mcp.context7.com/mcp\",\n\t\t\tHeaders: map[string]string{\"CONTEXT7_API_KEY\": \"ctx7-secret\"},\n\t\t},\n\t}\n\tblock := openCodeMCPBlock(servers)\n\twant := map[string]openCodeMCPServer{\n\t\t\"context7\": {\n\t\t\tType:    \"remote\",\n\t\t\tURL:     \"https://mcp.context7.com/mcp\",\n\t\t\tHeaders: map[string]string{\"CONTEXT7_API_KEY\": \"ctx7-secret\"},\n\t\t},\n\t}\n\tif !reflect.DeepEqual(block, want) {\n\t\tt.Errorf(\"openCodeMCPBlock = %+v, want %+v\", block, want)\n\t}\n}\n\n// TestOpenCodeMCPBlockStdioBecomesLocal: a canonical \"stdio\" server converts\n// to OpenCode's \"local\" type, command+args merged into a single command\n// array and env renamed to environment.\nfunc TestOpenCodeMCPBlockStdioBecomesLocal(t *testing.T) {\n\tservers := MCPServers{\n\t\t\"local-thing\": {\n\t\t\tType:    \"stdio\",\n\t\t\tCommand: \"some-mcp\",\n\t\t\tArgs:    []string{\"--flag\", \"value\"},\n\t\t\tEnv:     map[string]string{\"TOKEN\": \"tok-123\"},\n\t\t},\n\t}\n\tblock := openCodeMCPBlock(servers)\n\twant := map[string]openCodeMCPServer{\n\t\t\"local-thing\": {\n\t\t\tType:        \"local\",\n\t\t\tCommand:     []string{\"some-mcp\", \"--flag\", \"value\"},\n\t\t\tEnvironment: map[string]string{\"TOKEN\": \"tok-123\"},\n\t\t},\n\t}\n\tif !reflect.DeepEqual(block, want) {\n\t\tt.Errorf(\"openCodeMCPBlock = %+v, want %+v\", block, want)\n\t}\n}\n\nfunc TestOpenCodeMCPBlockEmptyIsNil(t *testing.T) {\n\tif block := openCodeMCPBlock(nil); block != nil {\n\t\tt.Errorf(\"openCodeMCPBlock(nil) = %+v, want nil\", block)\n\t}\n}\n\n// TestBuildOpenCodeConfigModelOnly pins TASK-4's model migration: with no\n// MCP servers configured, the generated opencode.json still carries the\n// resolved model — the logic scripts/entrypoint.sh used to write via\n// {env:OPENCODE_MODEL} substitution, now resolved and written directly.\nfunc TestBuildOpenCodeConfigModelOnly(t *testing.T) {\n\tdata, ok, err := buildOpenCodeConfig(\"zai-coding-plan/glm-5.2\", nil)\n\tif err != nil {\n\t\tt.Fatalf(\"buildOpenCodeConfig: %v\", err)\n\t}\n\tif !ok {\n\t\tt.Fatal(\"buildOpenCodeConfig ok = false, want true\")\n\t}\n\tvar cfg openCodeConfig\n\tif err := json.Unmarshal(data, &cfg); err != nil {\n\t\tt.Fatalf(\"unmarshal generated opencode.json: %v\", err)\n\t}\n\tif cfg.Schema != openCodeConfigSchema || cfg.Model != \"zai-coding-plan/glm-5.2\" || len(cfg.MCP) != 0 {\n\t\tt.Errorf(\"buildOpenCodeConfig = %+v\", cfg)\n\t}\n}\n\n// TestBuildOpenCodeConfigModelAndMCP: model and mcp compose into one\n// generated file.\nfunc TestBuildOpenCodeConfigModelAndMCP(t *testing.T) {\n\tservers := MCPServers{\"context7\": {Type: \"http\", URL: \"https://mcp.context7.com/mcp\"}}\n\tdata, ok, err := buildOpenCodeConfig(\"zai-coding-plan/glm-5.2\", servers)\n\tif err != nil {\n\t\tt.Fatalf(\"buildOpenCodeConfig: %v\", err)\n\t}\n\tif !ok {\n\t\tt.Fatal(\"buildOpenCodeConfig ok = false, want true\")\n\t}\n\tvar cfg openCodeConfig\n\tif err := json.Unmarshal(data, &cfg); err != nil {\n\t\tt.Fatalf(\"unmarshal generated opencode.json: %v\", err)\n\t}\n\tif cfg.Model != \"zai-coding-plan/glm-5.2\" {\n\t\tt.Errorf(\"buildOpenCodeConfig Model = %q\", cfg.Model)\n\t}\n\tif got := cfg.MCP[\"context7\"]; got.Type != \"remote\" || got.URL != \"https://mcp.context7.com/mcp\" {\n\t\tt.Errorf(\"buildOpenCodeConfig MCP[context7] = %+v\", got)\n\t}\n}\n\n// TestBuildOpenCodeConfigNothingConfigured: no model, no servers — nothing\n// is generated at all, matching the pre-this-job behavior of\n// entrypoint.sh's guarded write.\nfunc TestBuildOpenCodeConfigNothingConfigured(t *testing.T) {\n\tdata, ok, err := buildOpenCodeConfig(\"\", nil)\n\tif err != nil {\n\t\tt.Fatalf(\"buildOpenCodeConfig: %v\", err)\n\t}\n\tif ok || data != nil {\n\t\tt.Errorf(\"buildOpenCodeConfig(\\\"\\\", nil) = (%q, %v), want (nil, false)\", data, ok)\n\t}\n}\n\n// TestBuildOpenCodeConfigMCPOnlyNoModel: MCP servers configured but no\n// model resolved — the file is still generated (mcp alone is enough).\nfunc TestBuildOpenCodeConfigMCPOnlyNoModel(t *testing.T) {\n\tservers := MCPServers{\"context7\": {Type: \"http\", URL: \"https://mcp.context7.com/mcp\"}}\n\tdata, ok, err := buildOpenCodeConfig(\"\", servers)\n\tif err != nil {\n\t\tt.Fatalf(\"buildOpenCodeConfig: %v\", err)\n\t}\n\tif !ok || data == nil {\n\t\tt.Fatal(\"buildOpenCodeConfig with mcp servers but no model must still generate a file\")\n\t}\n\tvar cfg openCodeConfig\n\tif err := json.Unmarshal(data, &cfg); err != nil {\n\t\tt.Fatalf(\"unmarshal generated opencode.json: %v\", err)\n\t}\n\tif cfg.Model != \"\" {\n\t\tt.Errorf(\"buildOpenCodeConfig Model = %q, want empty\", cfg.Model)\n\t}\n}\n","numLines":432,"startLine":1,"totalLines":432}}}
