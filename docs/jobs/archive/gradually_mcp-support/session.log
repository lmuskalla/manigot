{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vs7Vov4Q72HX13vr5UqAxq","type":"tool_result","content":"1\t// Package session ports scripts/run.sh — the docker session launcher — into Go.\n2\t// It is the single host-side seam between the orchestrator and the agent\n3\t// environment: profile/tool resolution, project-root + --job worktree\n4\t// resolution, docker argv/mount/env construction, and the actual run.\n5\t//\n6\t// Behavior is a 1:1 port of run.sh, including its exact diagnostic wording.\n7\t// One deliberate divergence per the consolidation brief (note 1): all\n8\t// diagnostics go to stderr. The script's fd-3 juggling existed only to keep\n9\t// the agent's stdout clean in --print mode; Go separates stdout/stderr\n10\t// natively, so there is nothing to juggle.\n11\tpackage session\n12\t\n13\timport (\n14\t\t\"errors\"\n15\t\t\"flag\"\n16\t\t\"fmt\"\n17\t\t\"io\"\n18\t\t\"strings\"\n19\t\n20\t\t\"github.com/lmuskalla/manigot/internal/config\"\n21\t)\n22\t\n23\t// Options carries the parsed session flag set.\n24\ttype Options struct {\n25\t\tAgent   string // --agent (or -a)\n26\t\tJob     string // --job (or -j)\n27\t\tPrompt  string // --prompt\n28\t\tTool    string // --tool (legacy alias)\n29\t\tProfile string // --profile\n30\t\tPrint   bool   // --print\n31\t\tPass    []string\n32\t}\n33\t\n34\t// ParseArgs parses the session flags: known --flags (and the -a/-j short\n35\t// forms of --agent/--job) consume their value, --print is a bare flag,\n36\t// anything else — an unknown flag or a bare word — is passthrough, handed\n37\t// verbatim to the container CLI (run.sh's semantics).\n38\t//\n39\t// The passthrough rule is why the known flags are extracted first (splitFlags)\n40\t// and parsed with a flag.FlagSet, rather than feeding flag the raw args:\n41\t// flag stops at the first non-flag argument and treats unknown flags as\n42\t// errors, neither of which matches \"everything unknown goes through\".\n43\tfunc ParseArgs(args []string) Options {\n44\t\tvar o Options\n45\t\tfs := flag.NewFlagSet(\"mg\", flag.ContinueOnError)\n46\t\tfs.SetOutput(io.Discard)\n47\t\tfs.StringVar(&o.Agent, \"agent\", \"\", \"\")\n48\t\tfs.StringVar(&o.Job, \"job\", \"\", \"\")\n49\t\tfs.StringVar(&o.Agent, \"a\", \"\", \"\") // short form of --agent\n50\t\tfs.StringVar(&o.Job, \"j\", \"\", \"\")   // short form of --job\n51\t\tfs.StringVar(&o.Prompt, \"prompt\", \"\", \"\")\n52\t\tfs.StringVar(&o.Tool, \"tool\", \"\", \"\")\n53\t\tfs.StringVar(&o.Profile, \"profile\", \"\", \"\")\n54\t\tfs.BoolVar(&o.Print, \"print\", false, \"\")\n55\t\n56\t\tvar flagArgs []string\n57\t\tflagArgs, o.Pass = splitFlags(args, sessionValueFlags, sessionBareFlags)\n58\t\t// The only parse error possible is a known flag left without its value at\n59\t\t// the end (e.g. a bare \"--agent\"); flag leaves the field unset, which is\n60\t\t// the loop's old silent-ignore behavior. There is no error path to the\n61\t\t// caller.\n62\t\t_ = fs.Parse(flagArgs)\n63\t\treturn o\n64\t}\n65\t\n66\t// sessionValueFlags / sessionBareFlags name the session's own flags for\n67\t// ParseArgs's splitFlags extraction. The short forms -a/-j are aliases of\n68\t// --agent/--job and are registered in the flag.FlagSet the same way.\n69\tvar (\n70\t\tsessionValueFlags = map[string]bool{\"--agent\": true, \"--job\": true, \"--prompt\": true, \"--tool\": true, \"--profile\": true, \"-a\": true, \"-j\": true}\n71\t\tsessionBareFlags  = map[string]bool{\"--print\": true}\n72\t)\n73\t\n74\t// splitFlags separates args into the known flag tokens (with their values)\n75\t// and everything else, preserving order within each group: the pieces the\n76\t// flag.FlagSet parses, and the passthrough remainder. valueFlags take one\n77\t// value each; bareFlags take none. Any other token — an unknown flag or a\n78\t// bare word — lands in rest.\n79\tfunc splitFlags(args []string, valueFlags, bareFlags map[string]bool) (flagArgs, rest []string) {\n80\t\tfor i := 0; i < len(args); i++ {\n81\t\t\tswitch {\n82\t\t\tcase bareFlags[args[i]]:\n83\t\t\t\tflagArgs = append(flagArgs, args[i])\n84\t\t\tcase valueFlags[args[i]]:\n85\t\t\t\tflagArgs = append(flagArgs, args[i])\n86\t\t\t\tif i+1 < len(args) {\n87\t\t\t\t\ti++\n88\t\t\t\t\tflagArgs = append(flagArgs, args[i])\n89\t\t\t\t}\n90\t\t\tdefault:\n91\t\t\t\trest = append(rest, args[i])\n92\t\t\t}\n93\t\t}\n94\t\treturn flagArgs, rest\n95\t}\n96\t\n97\t// legacyOpenCodeKeys is the nine-key list the legacy profile-less `--tool\n98\t// opencode` path forwards. Kept in sync with scripts/entrypoint.sh (the\n99\t// container-side safety net); Go pre-validates these keys before launch, so\n100\t// drift between the two is harmless.\n101\tvar legacyOpenCodeKeys = []string{\n102\t\t\"ANTHROPIC_API_KEY\",\n103\t\t\"OPENAI_API_KEY\",\n104\t\t\"OPENROUTER_API_KEY\",\n105\t\t\"GOOGLE_GENERATIVE_AI_API_KEY\",\n106\t\t\"GROQ_API_KEY\",\n107\t\t\"XAI_API_KEY\",\n108\t\t\"DEEPSEEK_API_KEY\",\n109\t\t\"OPENCODE_API_KEY\",\n110\t\t\"ZHIPU_API_KEY\",\n111\t}\n112\t\n113\t// ProfileInfo is the outcome of profile/tool resolution. Credential\n114\t// validation is a separate step (CheckAuth) so the session flow can match\n115\t// run.sh's ordering, where the auth checks run after --job resolution.\n116\ttype ProfileInfo struct {\n117\t\t// Profile is the resolved profile id: claude-pro, zai, opencode-go,\n118\t\t// opencode-zen, opencode-zen-free — or \"\" for the legacy profile-less\n119\t\t// --tool opencode path.\n120\t\tProfile string\n121\t\n122\t\t// Tool is the agent CLI to launch: config.ToolClaudeCode or\n123\t\t// config.ToolOpenCode.\n124\t\tTool string\n125\t\n126\t\t// AuthKeys are the profile's credential env keys, resolved from\n127\t\t// config.ProfileByID (the profile's AuthKeys). The claude branch of\n128\t\t// CheckAuth validates and forwards exactly these; for opencode profiles\n129\t\t// it is the same set as OpenCodeKeys.\n130\t\tAuthKeys []string\n131\t\n132\t\t// OpenCodeKeys lists the provider keys this opencode run forwards.\n133\t\tOpenCodeKeys []string\n134\t\n135\t\t// OpenCodeModel is the effective OPENCODE_MODEL value for opencode runs\n136\t\t// (\"\" when none — only the legacy path can leave it unset).\n137\t\tOpenCodeModel string\n138\t\n139\t\t// ClaudeModel is the effective model override for claude-code runs,\n140\t\t// resolved the same way as OpenCodeModel (envDefault(p.ModelEnv,\n141\t\t// p.ModelDefault)) — \"\" when the profile defines neither, which is what\n142\t\t// keeps claude-pro's behavior unchanged (no ModelEnv/ModelDefault, so\n143\t\t// nothing is forwarded and the CLI uses its own default).\n144\t\tClaudeModel string\n145\t\n146\t\t// OpenCodeTheme is the effective OPENCODE_THEME value for opencode runs\n147\t\t// (\"\" when unset — the global theme setting, config.Settings.Theme, is\n148\t\t// shared across every opencode profile, unlike OpenCodeModel).\n149\t\tOpenCodeTheme string\n150\t\n151\t\t// KeyEnv holds the docker -e arguments for the forwarded credential keys\n152\t\t// (and the opencode model/theme), e.g. [\"-e\", \"CLAUDE_CODE_OAUTH_TOKEN=...\",\n153\t\t// \"-e\", \"ZHIPU_API_KEY=...\", \"-e\", \"OPENCODE_MODEL=...\", \"-e\",\n154\t\t// \"OPENCODE_THEME=...\"]. Filled by CheckAuth.\n155\t\tKeyEnv []string\n156\t}\n157\t\n158\t// ResolveProfile implements run.sh's profile resolution block verbatim in\n159\t// behavior: precedence is --profile > --tool (legacy map:\n160\t// claude-code→claude-pro, opencode→legacy empty-profile mode) >\n161\t// $MANIGOT_PROFILE (validated) > claude-pro; then the profile→tool/key/model\n162\t// mapping and the --print + legacy-opencode rejection. Values are read via\n163\t// config.EnvValue, which mirrors the script's `set -a; source .env` (the .env\n164\t// file wins, then the process environment). Every error's wording matches the\n165\t// script's output.\n166\t//\n167\t// The credential auth checks are NOT part of this step — call CheckAuth after\n168\t// the root/--job resolution, mirroring run.sh's own ordering (the script\n169\t// resolves the job before it checks keys, so a job error takes precedence\n170\t// over a missing-key error when both apply).\n171\tfunc ResolveProfile(opts Options) (ProfileInfo, error) {\n172\t\tprofile := opts.Profile\n173\t\tswitch {\n174\t\tcase profile != \"\":\n175\t\t\tif _, ok := config.ProfileByID(profile); !ok {\n176\t\t\t\treturn ProfileInfo{}, fmt.Errorf(\"--profile must be one of: %s (got '%s').\", profileValidList(), profile)\n177\t\t\t}\n178\t\tcase opts.Tool != \"\":\n179\t\t\tswitch opts.Tool {\n180\t\t\tcase config.ToolClaudeCode:\n181\t\t\t\tprofile = config.ProfileClaudePro\n182\t\t\tcase config.ToolOpenCode:\n183\t\t\t\tprofile = \"\" // legacy opencode mode, handled below\n184\t\t\tdefault:\n185\t\t\t\treturn ProfileInfo{}, fmt.Errorf(\"--tool must be 'claude-code' or 'opencode' (got '%s').\", opts.Tool)\n186\t\t\t}\n187\t\tdefault:\n188\t\t\tprofile = config.EnvValue(\"MANIGOT_PROFILE\")\n189\t\t\tif profile == \"\" {\n190\t\t\t\tprofile = config.ProfileClaudePro\n191\t\t\t}\n192\t\t\tif _, ok := config.ProfileByID(profile); !ok {\n193\t\t\t\treturn ProfileInfo{}, fmt.Errorf(\"MANIGOT_PROFILE in %s is not a valid profile (got '%s').\\nValid profiles: %s\", config.EnvFile(), profile, profileValidList())\n194\t\t\t}\n195\t\t}\n196\t\n197\t\tinfo := ProfileInfo{Profile: profile}\n198\t\tif profile != \"\" {\n199\t\t\t// Data-driven: the tool, auth keys, and model env/default all come\n200\t\t\t// from the profile's definition in config, so a user-defined profile\n201\t\t\t// resolves exactly like the built-in ones.\n202\t\t\tif p, ok := config.ProfileByID(profile); ok {\n203\t\t\t\tinfo.Tool = p.Tool\n204\t\t\t\tinfo.AuthKeys = append([]string(nil), p.AuthKeys...)\n205\t\t\t\tif p.Tool == config.ToolOpenCode {\n206\t\t\t\t\tinfo.OpenCodeKeys = append([]string(nil), p.AuthKeys...)\n207\t\t\t\t\tinfo.OpenCodeModel = envDefault(p.ModelEnv, p.ModelDefault)\n208\t\t\t\t} else if p.Tool == config.ToolClaudeCode {\n209\t\t\t\t\tinfo.ClaudeModel = envDefault(p.ModelEnv, p.ModelDefault)\n210\t\t\t\t}\n211\t\t\t}\n212\t\t} else {\n213\t\t\tinfo.Tool = config.ToolOpenCode\n214\t\t\tinfo.OpenCodeKeys = legacyOpenCodeKeys\n215\t\t\tinfo.AuthKeys = legacyOpenCodeKeys\n216\t\t\tinfo.OpenCodeModel = config.EnvValue(\"OPENCODE_MODEL\") // forwarded as-is\n217\t\t}\n218\t\n219\t\t// The theme setting is global — one value shared across every opencode\n220\t\t// profile (config.Settings.Theme/OPENCODE_THEME), unlike the per-profile\n221\t\t// model — so it's read once here rather than per-profile above.\n222\t\tif info.Tool == config.ToolOpenCode {\n223\t\t\tinfo.OpenCodeTheme = config.EnvValue(\"OPENCODE_THEME\")\n224\t\t}\n225\t\n226\t\t// --print is a non-interactive, one-shot invocation built for automated\n227\t\t// callers like mg-jdi. The legacy, profile-less --tool opencode path is\n228\t\t// intentionally left rejected here — it predates the profile system.\n229\t\tif opts.Print && info.Tool == config.ToolOpenCode && info.Profile == \"\" {\n230\t\t\treturn ProfileInfo{}, fmt.Errorf(\"--print is not supported with the legacy --tool opencode (no --profile).\\nUse --profile zai, --profile opencode-go, --profile opencode-zen or --profile opencode-zen-free instead.\")\n231\t\t}\n232\t\n233\t\treturn info, nil\n234\t}\n235\t\n236\t// CheckAuth validates the resolved profile's credentials (run.sh's auth\n237\t// block, which ran after --job resolution) and fills in KeyEnv — the docker\n238\t// -e arguments for the forwarded opencode keys and model.\n239\tfunc (info *ProfileInfo) CheckAuth() error {\n240\t\tif info.Tool == config.ToolClaudeCode {\n241\t\t\t// The first auth key is the OAuth token every claude profile requires\n242\t\t\t// (the built-in's is CLAUDE_CODE_OAUTH_TOKEN); the rest are optional\n243\t\t\t// account details. The message keeps the built-in's exact wording.\n244\t\t\ttokenKey := \"CLAUDE_CODE_OAUTH_TOKEN\"\n245\t\t\tif len(info.AuthKeys) > 0 {\n246\t\t\t\ttokenKey = info.AuthKeys[0]\n247\t\t\t}\n248\t\t\tif config.EnvValue(tokenKey) == \"\" {\n249\t\t\t\treturn fmt.Errorf(\"%s is not set.\\nAdd it to %s, or run 'mg setup %s' for help:\\n  %s=sk-ant-oat01-...\", tokenKey, config.EnvFile(), info.Profile, tokenKey)\n250\t\t\t}\n251\t\t\t// Subscription protection: an API key would override the mounted\n252\t\t\t// OAuth credentials and bill per token.\n253\t\t\tif v := config.EnvValue(\"ANTHROPIC_API_KEY\"); v != \"\" {\n254\t\t\t\treturn fmt.Errorf(\"ANTHROPIC_API_KEY is set — this overrides your subscription and bills per token.\\nRemove it from your environment before running mg with the claude-pro profile.\")\n255\t\t\t}\n256\t\t\t// Forward the subscription credentials into the container. The\n257\t\t\t// empty-value filter matches the opencode handling below, so a\n258\t\t\t// non-claude profile's docker argv never carries -e CLAUDE_*==\"\"\n259\t\t\t// noise (the token was just validated; the other three are optional).\n260\t\t\tfor _, key := range info.AuthKeys {\n261\t\t\t\tif v := config.EnvValue(key); v != \"\" {\n262\t\t\t\t\tinfo.KeyEnv = append(info.KeyEnv, \"-e\", key+\"=\"+v)\n263\t\t\t\t}\n264\t\t\t}\n265\t\t\treturn nil\n266\t\t}\n267\t\n268\t\t// OpenCode is multi-provider: forward exactly the key(s) the profile is\n269\t\t// billed against; any one of them is enough to start.\n270\t\tfor _, key := range info.OpenCodeKeys {\n271\t\t\tif v := config.EnvValue(key); v != \"\" {\n272\t\t\t\tinfo.KeyEnv = append(info.KeyEnv, \"-e\", key+\"=\"+v)\n273\t\t\t}\n274\t\t}\n275\t\tif len(info.KeyEnv) == 0 {\n276\t\t\tvar msg string\n277\t\t\tif info.Profile != \"\" {\n278\t\t\t\tmsg = fmt.Sprintf(\"profile '%s' is missing its API key.\\nAdd it to %s, or run 'mg setup %s' for help:\", info.Profile, config.EnvFile(), info.Profile)\n279\t\t\t} else {\n280\t\t\t\tmsg = fmt.Sprintf(\"--tool opencode needs at least one provider API key.\\nAdd one of these to %s:\", config.EnvFile())\n281\t\t\t}\n282\t\t\tfor _, k := range info.OpenCodeKeys {\n283\t\t\t\tmsg += \"\\n  \" + k\n284\t\t\t}\n285\t\t\treturn errors.New(msg)\n286\t\t}\n287\t\n288\t\t// The model each profile defaults to, consumed by scripts/entrypoint.sh\n289\t\t// via the {env:OPENCODE_MODEL} config substitution.\n290\t\tif info.OpenCodeModel != \"\" {\n291\t\t\tinfo.KeyEnv = append(info.KeyEnv, \"-e\", \"OPENCODE_MODEL=\"+info.OpenCodeModel)\n292\t\t}\n293\t\t// The global theme setting, forwarded independent of which profile/API\n294\t\t// key is in use, consumed by scripts/entrypoint.sh via the\n295\t\t// {env:OPENCODE_THEME} config substitution.\n296\t\tif info.OpenCodeTheme != \"\" {\n297\t\t\tinfo.KeyEnv = append(info.KeyEnv, \"-e\", \"OPENCODE_THEME=\"+info.OpenCodeTheme)\n298\t\t}\n299\t\treturn nil\n300\t}\n301\t\n302\t// profileValidList is the pipe-joined list of known profile ids used in error\n303\t// messages, derived from config.Profiles() so a user-defined profile is\n304\t// reported as valid too. For the default (built-ins only) store it is exactly\n305\t// \"claude-pro|zai|opencode-go|opencode-zen|opencode-zen-free\".\n306\tfunc profileValidList() string {\n307\t\tps := config.Profiles()\n308\t\tids := make([]string, len(ps))\n309\t\tfor i, p := range ps {\n310\t\t\tids[i] = p.ID\n311\t\t}\n312\t\treturn strings.Join(ids, \"|\")\n313\t}\n314\t\n315\t// envDefault returns the effective value of key, or def when it is unset —\n316\t// the Go form of bash's ${VAR:-default}.\n317\tfunc envDefault(key, def string) string {\n318\t\tif v := config.EnvValue(key); v != \"\" {\n319\t\t\treturn v\n320\t\t}\n321\t\treturn def\n322\t}\n323\t"}]},"parent_tool_use_id":null,"session_id":"4e2afcf5-7fc0-4a90-a6a6-e82e43a08449","uuid":"fb762247-2b5f-4b35-bac4-a5d97a0a9ceb","timestamp":"2026-08-31T13:46:20.714Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/session/session.go","content":"// Package session ports scripts/run.sh — the docker session launcher — into Go.\n// It is the single host-side seam between the orchestrator and the agent\n// environment: profile/tool resolution, project-root + --job worktree\n// resolution, docker argv/mount/env construction, and the actual run.\n//\n// Behavior is a 1:1 port of run.sh, including its exact diagnostic wording.\n// One deliberate divergence per the consolidation brief (note 1): all\n// diagnostics go to stderr. The script's fd-3 juggling existed only to keep\n// the agent's stdout clean in --print mode; Go separates stdout/stderr\n// natively, so there is nothing to juggle.\npackage session\n\nimport (\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n)\n\n// Options carries the parsed session flag set.\ntype Options struct {\n\tAgent   string // --agent (or -a)\n\tJob     string // --job (or -j)\n\tPrompt  string // --prompt\n\tTool    string // --tool (legacy alias)\n\tProfile string // --profile\n\tPrint   bool   // --print\n\tPass    []string\n}\n\n// ParseArgs parses the session flags: known --flags (and the -a/-j short\n// forms of --agent/--job) consume their value, --print is a bare flag,\n// anything else — an unknown flag or a bare word — is passthrough, handed\n// verbatim to the container CLI (run.sh's semantics).\n//\n// The passthrough rule is why the known flags are extracted first (splitFlags)\n// and parsed with a flag.FlagSet, rather than feeding flag the raw args:\n// flag stops at the first non-flag argument and treats unknown flags as\n// errors, neither of which matches \"everything unknown goes through\".\nfunc ParseArgs(args []string) Options {\n\tvar o Options\n\tfs := flag.NewFlagSet(\"mg\", flag.ContinueOnError)\n\tfs.SetOutput(io.Discard)\n\tfs.StringVar(&o.Agent, \"agent\", \"\", \"\")\n\tfs.StringVar(&o.Job, \"job\", \"\", \"\")\n\tfs.StringVar(&o.Agent, \"a\", \"\", \"\") // short form of --agent\n\tfs.StringVar(&o.Job, \"j\", \"\", \"\")   // short form of --job\n\tfs.StringVar(&o.Prompt, \"prompt\", \"\", \"\")\n\tfs.StringVar(&o.Tool, \"tool\", \"\", \"\")\n\tfs.StringVar(&o.Profile, \"profile\", \"\", \"\")\n\tfs.BoolVar(&o.Print, \"print\", false, \"\")\n\n\tvar flagArgs []string\n\tflagArgs, o.Pass = splitFlags(args, sessionValueFlags, sessionBareFlags)\n\t// The only parse error possible is a known flag left without its value at\n\t// the end (e.g. a bare \"--agent\"); flag leaves the field unset, which is\n\t// the loop's old silent-ignore behavior. There is no error path to the\n\t// caller.\n\t_ = fs.Parse(flagArgs)\n\treturn o\n}\n\n// sessionValueFlags / sessionBareFlags name the session's own flags for\n// ParseArgs's splitFlags extraction. The short forms -a/-j are aliases of\n// --agent/--job and are registered in the flag.FlagSet the same way.\nvar (\n\tsessionValueFlags = map[string]bool{\"--agent\": true, \"--job\": true, \"--prompt\": true, \"--tool\": true, \"--profile\": true, \"-a\": true, \"-j\": true}\n\tsessionBareFlags  = map[string]bool{\"--print\": true}\n)\n\n// splitFlags separates args into the known flag tokens (with their values)\n// and everything else, preserving order within each group: the pieces the\n// flag.FlagSet parses, and the passthrough remainder. valueFlags take one\n// value each; bareFlags take none. Any other token — an unknown flag or a\n// bare word — lands in rest.\nfunc splitFlags(args []string, valueFlags, bareFlags map[string]bool) (flagArgs, rest []string) {\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch {\n\t\tcase bareFlags[args[i]]:\n\t\t\tflagArgs = append(flagArgs, args[i])\n\t\tcase valueFlags[args[i]]:\n\t\t\tflagArgs = append(flagArgs, args[i])\n\t\t\tif i+1 < len(args) {\n\t\t\t\ti++\n\t\t\t\tflagArgs = append(flagArgs, args[i])\n\t\t\t}\n\t\tdefault:\n\t\t\trest = append(rest, args[i])\n\t\t}\n\t}\n\treturn flagArgs, rest\n}\n\n// legacyOpenCodeKeys is the nine-key list the legacy profile-less `--tool\n// opencode` path forwards. Kept in sync with scripts/entrypoint.sh (the\n// container-side safety net); Go pre-validates these keys before launch, so\n// drift between the two is harmless.\nvar legacyOpenCodeKeys = []string{\n\t\"ANTHROPIC_API_KEY\",\n\t\"OPENAI_API_KEY\",\n\t\"OPENROUTER_API_KEY\",\n\t\"GOOGLE_GENERATIVE_AI_API_KEY\",\n\t\"GROQ_API_KEY\",\n\t\"XAI_API_KEY\",\n\t\"DEEPSEEK_API_KEY\",\n\t\"OPENCODE_API_KEY\",\n\t\"ZHIPU_API_KEY\",\n}\n\n// ProfileInfo is the outcome of profile/tool resolution. Credential\n// validation is a separate step (CheckAuth) so the session flow can match\n// run.sh's ordering, where the auth checks run after --job resolution.\ntype ProfileInfo struct {\n\t// Profile is the resolved profile id: claude-pro, zai, opencode-go,\n\t// opencode-zen, opencode-zen-free — or \"\" for the legacy profile-less\n\t// --tool opencode path.\n\tProfile string\n\n\t// Tool is the agent CLI to launch: config.ToolClaudeCode or\n\t// config.ToolOpenCode.\n\tTool string\n\n\t// AuthKeys are the profile's credential env keys, resolved from\n\t// config.ProfileByID (the profile's AuthKeys). The claude branch of\n\t// CheckAuth validates and forwards exactly these; for opencode profiles\n\t// it is the same set as OpenCodeKeys.\n\tAuthKeys []string\n\n\t// OpenCodeKeys lists the provider keys this opencode run forwards.\n\tOpenCodeKeys []string\n\n\t// OpenCodeModel is the effective OPENCODE_MODEL value for opencode runs\n\t// (\"\" when none — only the legacy path can leave it unset).\n\tOpenCodeModel string\n\n\t// ClaudeModel is the effective model override for claude-code runs,\n\t// resolved the same way as OpenCodeModel (envDefault(p.ModelEnv,\n\t// p.ModelDefault)) — \"\" when the profile defines neither, which is what\n\t// keeps claude-pro's behavior unchanged (no ModelEnv/ModelDefault, so\n\t// nothing is forwarded and the CLI uses its own default).\n\tClaudeModel string\n\n\t// OpenCodeTheme is the effective OPENCODE_THEME value for opencode runs\n\t// (\"\" when unset — the global theme setting, config.Settings.Theme, is\n\t// shared across every opencode profile, unlike OpenCodeModel).\n\tOpenCodeTheme string\n\n\t// KeyEnv holds the docker -e arguments for the forwarded credential keys\n\t// (and the opencode model/theme), e.g. [\"-e\", \"CLAUDE_CODE_OAUTH_TOKEN=...\",\n\t// \"-e\", \"ZHIPU_API_KEY=...\", \"-e\", \"OPENCODE_MODEL=...\", \"-e\",\n\t// \"OPENCODE_THEME=...\"]. Filled by CheckAuth.\n\tKeyEnv []string\n}\n\n// ResolveProfile implements run.sh's profile resolution block verbatim in\n// behavior: precedence is --profile > --tool (legacy map:\n// claude-code→claude-pro, opencode→legacy empty-profile mode) >\n// $MANIGOT_PROFILE (validated) > claude-pro; then the profile→tool/key/model\n// mapping and the --print + legacy-opencode rejection. Values are read via\n// config.EnvValue, which mirrors the script's `set -a; source .env` (the .env\n// file wins, then the process environment). Every error's wording matches the\n// script's output.\n//\n// The credential auth checks are NOT part of this step — call CheckAuth after\n// the root/--job resolution, mirroring run.sh's own ordering (the script\n// resolves the job before it checks keys, so a job error takes precedence\n// over a missing-key error when both apply).\nfunc ResolveProfile(opts Options) (ProfileInfo, error) {\n\tprofile := opts.Profile\n\tswitch {\n\tcase profile != \"\":\n\t\tif _, ok := config.ProfileByID(profile); !ok {\n\t\t\treturn ProfileInfo{}, fmt.Errorf(\"--profile must be one of: %s (got '%s').\", profileValidList(), profile)\n\t\t}\n\tcase opts.Tool != \"\":\n\t\tswitch opts.Tool {\n\t\tcase config.ToolClaudeCode:\n\t\t\tprofile = config.ProfileClaudePro\n\t\tcase config.ToolOpenCode:\n\t\t\tprofile = \"\" // legacy opencode mode, handled below\n\t\tdefault:\n\t\t\treturn ProfileInfo{}, fmt.Errorf(\"--tool must be 'claude-code' or 'opencode' (got '%s').\", opts.Tool)\n\t\t}\n\tdefault:\n\t\tprofile = config.EnvValue(\"MANIGOT_PROFILE\")\n\t\tif profile == \"\" {\n\t\t\tprofile = config.ProfileClaudePro\n\t\t}\n\t\tif _, ok := config.ProfileByID(profile); !ok {\n\t\t\treturn ProfileInfo{}, fmt.Errorf(\"MANIGOT_PROFILE in %s is not a valid profile (got '%s').\\nValid profiles: %s\", config.EnvFile(), profile, profileValidList())\n\t\t}\n\t}\n\n\tinfo := ProfileInfo{Profile: profile}\n\tif profile != \"\" {\n\t\t// Data-driven: the tool, auth keys, and model env/default all come\n\t\t// from the profile's definition in config, so a user-defined profile\n\t\t// resolves exactly like the built-in ones.\n\t\tif p, ok := config.ProfileByID(profile); ok {\n\t\t\tinfo.Tool = p.Tool\n\t\t\tinfo.AuthKeys = append([]string(nil), p.AuthKeys...)\n\t\t\tif p.Tool == config.ToolOpenCode {\n\t\t\t\tinfo.OpenCodeKeys = append([]string(nil), p.AuthKeys...)\n\t\t\t\tinfo.OpenCodeModel = envDefault(p.ModelEnv, p.ModelDefault)\n\t\t\t} else if p.Tool == config.ToolClaudeCode {\n\t\t\t\tinfo.ClaudeModel = envDefault(p.ModelEnv, p.ModelDefault)\n\t\t\t}\n\t\t}\n\t} else {\n\t\tinfo.Tool = config.ToolOpenCode\n\t\tinfo.OpenCodeKeys = legacyOpenCodeKeys\n\t\tinfo.AuthKeys = legacyOpenCodeKeys\n\t\tinfo.OpenCodeModel = config.EnvValue(\"OPENCODE_MODEL\") // forwarded as-is\n\t}\n\n\t// The theme setting is global — one value shared across every opencode\n\t// profile (config.Settings.Theme/OPENCODE_THEME), unlike the per-profile\n\t// model — so it's read once here rather than per-profile above.\n\tif info.Tool == config.ToolOpenCode {\n\t\tinfo.OpenCodeTheme = config.EnvValue(\"OPENCODE_THEME\")\n\t}\n\n\t// --print is a non-interactive, one-shot invocation built for automated\n\t// callers like mg-jdi. The legacy, profile-less --tool opencode path is\n\t// intentionally left rejected here — it predates the profile system.\n\tif opts.Print && info.Tool == config.ToolOpenCode && info.Profile == \"\" {\n\t\treturn ProfileInfo{}, fmt.Errorf(\"--print is not supported with the legacy --tool opencode (no --profile).\\nUse --profile zai, --profile opencode-go, --profile opencode-zen or --profile opencode-zen-free instead.\")\n\t}\n\n\treturn info, nil\n}\n\n// CheckAuth validates the resolved profile's credentials (run.sh's auth\n// block, which ran after --job resolution) and fills in KeyEnv — the docker\n// -e arguments for the forwarded opencode keys and model.\nfunc (info *ProfileInfo) CheckAuth() error {\n\tif info.Tool == config.ToolClaudeCode {\n\t\t// The first auth key is the OAuth token every claude profile requires\n\t\t// (the built-in's is CLAUDE_CODE_OAUTH_TOKEN); the rest are optional\n\t\t// account details. The message keeps the built-in's exact wording.\n\t\ttokenKey := \"CLAUDE_CODE_OAUTH_TOKEN\"\n\t\tif len(info.AuthKeys) > 0 {\n\t\t\ttokenKey = info.AuthKeys[0]\n\t\t}\n\t\tif config.EnvValue(tokenKey) == \"\" {\n\t\t\treturn fmt.Errorf(\"%s is not set.\\nAdd it to %s, or run 'mg setup %s' for help:\\n  %s=sk-ant-oat01-...\", tokenKey, config.EnvFile(), info.Profile, tokenKey)\n\t\t}\n\t\t// Subscription protection: an API key would override the mounted\n\t\t// OAuth credentials and bill per token.\n\t\tif v := config.EnvValue(\"ANTHROPIC_API_KEY\"); v != \"\" {\n\t\t\treturn fmt.Errorf(\"ANTHROPIC_API_KEY is set — this overrides your subscription and bills per token.\\nRemove it from your environment before running mg with the claude-pro profile.\")\n\t\t}\n\t\t// Forward the subscription credentials into the container. The\n\t\t// empty-value filter matches the opencode handling below, so a\n\t\t// non-claude profile's docker argv never carries -e CLAUDE_*==\"\"\n\t\t// noise (the token was just validated; the other three are optional).\n\t\tfor _, key := range info.AuthKeys {\n\t\t\tif v := config.EnvValue(key); v != \"\" {\n\t\t\t\tinfo.KeyEnv = append(info.KeyEnv, \"-e\", key+\"=\"+v)\n\t\t\t}\n\t\t}\n\t\treturn nil\n\t}\n\n\t// OpenCode is multi-provider: forward exactly the key(s) the profile is\n\t// billed against; any one of them is enough to start.\n\tfor _, key := range info.OpenCodeKeys {\n\t\tif v := config.EnvValue(key); v != \"\" {\n\t\t\tinfo.KeyEnv = append(info.KeyEnv, \"-e\", key+\"=\"+v)\n\t\t}\n\t}\n\tif len(info.KeyEnv) == 0 {\n\t\tvar msg string\n\t\tif info.Profile != \"\" {\n\t\t\tmsg = fmt.Sprintf(\"profile '%s' is missing its API key.\\nAdd it to %s, or run 'mg setup %s' for help:\", info.Profile, config.EnvFile(), info.Profile)\n\t\t} else {\n\t\t\tmsg = fmt.Sprintf(\"--tool opencode needs at least one provider API key.\\nAdd one of these to %s:\", config.EnvFile())\n\t\t}\n\t\tfor _, k := range info.OpenCodeKeys {\n\t\t\tmsg += \"\\n  \" + k\n\t\t}\n\t\treturn errors.New(msg)\n\t}\n\n\t// The model each profile defaults to, consumed by scripts/entrypoint.sh\n\t// via the {env:OPENCODE_MODEL} config substitution.\n\tif info.OpenCodeModel != \"\" {\n\t\tinfo.KeyEnv = append(info.KeyEnv, \"-e\", \"OPENCODE_MODEL=\"+info.OpenCodeModel)\n\t}\n\t// The global theme setting, forwarded independent of which profile/API\n\t// key is in use, consumed by scripts/entrypoint.sh via the\n\t// {env:OPENCODE_THEME} config substitution.\n\tif info.OpenCodeTheme != \"\" {\n\t\tinfo.KeyEnv = append(info.KeyEnv, \"-e\", \"OPENCODE_THEME=\"+info.OpenCodeTheme)\n\t}\n\treturn nil\n}\n\n// profileValidList is the pipe-joined list of known profile ids used in error\n// messages, derived from config.Profiles() so a user-defined profile is\n// reported as valid too. For the default (built-ins only) store it is exactly\n// \"claude-pro|zai|opencode-go|opencode-zen|opencode-zen-free\".\nfunc profileValidList() string {\n\tps := config.Profiles()\n\tids := make([]string, len(ps))\n\tfor i, p := range ps {\n\t\tids[i] = p.ID\n\t}\n\treturn strings.Join(ids, \"|\")\n}\n\n// envDefault returns the effective value of key, or def when it is unset —\n// the Go form of bash's ${VAR:-default}.\nfunc envDefault(key, def string) string {\n\tif v := config.EnvValue(key); v != \"\" {\n\t\treturn v\n\t}\n\treturn def\n}\n","numLines":323,"startLine":1,"totalLines":323}}}
