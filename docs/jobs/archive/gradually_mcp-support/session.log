{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015Xh26SksjX6c1GMWjjH4pE","type":"tool_result","content":"1\tpackage session\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\t\"path/filepath\"\n6\t\t\"sort\"\n7\t\n8\t\t\"github.com/lmuskalla/manigot/internal/fs\"\n9\t)\n10\t\n11\t// SkillDir is one discovered skill: the skill's name (its directory name, the\n12\t// identifier both CLIs use to address the skill) and the path to that\n13\t// directory (which holds the SKILL.md plus any support files).\n14\ttype SkillDir struct {\n15\t\t// Name is the skill's directory name — the name both CLIs derive the\n16\t\t// skill's identifier from.\n17\t\tName string\n18\t\n19\t\t// Dir is the absolute path to the skill's directory.\n20\t\tDir string\n21\t}\n22\t\n23\t// listSkills enumerates the skill folders under srcDir — every immediate\n24\t// subdirectory that contains a SKILL.md — returning them as <name>/ → dir\n25\t// pairs sorted by name. A missing srcDir, or one with no skill folders,\n26\t// yields an empty slice, not an error (skills are optional; every caller\n27\t// skips cleanly when there is nothing to deliver).\n28\tfunc listSkills(srcDir string) ([]SkillDir, error) {\n29\t\tentries, err := os.ReadDir(srcDir)\n30\t\tif err != nil {\n31\t\t\tif os.IsNotExist(err) {\n32\t\t\t\treturn nil, nil\n33\t\t\t}\n34\t\t\treturn nil, err\n35\t\t}\n36\t\tvar skills []SkillDir\n37\t\tfor _, e := range entries {\n38\t\t\tif !e.IsDir() {\n39\t\t\t\tcontinue\n40\t\t\t}\n41\t\t\tdir := filepath.Join(srcDir, e.Name())\n42\t\t\tif !fs.IsFile(filepath.Join(dir, \"SKILL.md\")) {\n43\t\t\t\tcontinue\n44\t\t\t}\n45\t\t\tskills = append(skills, SkillDir{Name: e.Name(), Dir: dir})\n46\t\t}\n47\t\tsort.Slice(skills, func(i, j int) bool { return skills[i].Name < skills[j].Name })\n48\t\treturn skills, nil\n49\t}\n50\t\n51\t// stageGlobalSkills copies every skill under srcDir into a fresh temp\n52\t// directory — the directory-level counterpart of convertAgents (which stages\n53\t// single converted agent files). Skills need no frontmatter conversion: both\n54\t// CLIs read SKILL.md and its frontmatter (name:, description:, ...) natively,\n55\t// so the copy is a plain recursive copy preserving each skill's directory and\n56\t// its support files. The staged dir is meant for a read-only container mount\n57\t// (see BuildDockerInvocation's global-skills block) and is removed by the\n58\t// caller via the invocation's Cleanup hook — the host's skills/ source tree\n59\t// is never modified.\n60\t//\n61\t// It returns the temp dir path and true when srcDir contained at least one\n62\t// skill; (\"\", false, nil) when srcDir is missing or has no skills (nothing to\n63\t// stage); and (\"\", false, err) on any failure, after removing any temp dir it\n64\t// already created.\n65\tfunc stageGlobalSkills(srcDir string) (string, bool, error) {\n66\t\tskills, err := listSkills(srcDir)\n67\t\tif err != nil {\n68\t\t\treturn \"\", false, err\n69\t\t}\n70\t\tif len(skills) == 0 {\n71\t\t\treturn \"\", false, nil\n72\t\t}\n73\t\ttmp, err := os.MkdirTemp(\"\", \"manigot-skills-*\")\n74\t\tif err != nil {\n75\t\t\treturn \"\", false, err\n76\t\t}\n77\t\tfor _, s := range skills {\n78\t\t\tif err := copyDir(filepath.Join(tmp, s.Name), s.Dir); err != nil {\n79\t\t\t\tos.RemoveAll(tmp)\n80\t\t\t\treturn \"\", false, err\n81\t\t\t}\n82\t\t}\n83\t\treturn tmp, true, nil\n84\t}\n85\t\n86\t// copyDir recursively copies the directory src to dst, recreating the\n87\t// directory structure and copying file contents. It is the directory-level\n88\t// equivalent of convertAgents' single-file writes — a skill is a directory\n89\t// (SKILL.md plus optional support files), so the whole tree must move.\n90\t// Symlinked entries are copied by content (the link target's data), not\n91\t// recreated as links, so a staged/host copy can never carry a symlink that\n92\t// points outside the copied tree.\n93\tfunc copyDir(dst, src string) error {\n94\t\treturn filepath.WalkDir(src, func(path string, d os.DirEntry, err error) error {\n95\t\t\tif err != nil {\n96\t\t\t\treturn err\n97\t\t\t}\n98\t\t\trel, err := filepath.Rel(src, path)\n99\t\t\tif err != nil {\n100\t\t\t\treturn err\n101\t\t\t}\n102\t\t\ttarget := filepath.Join(dst, rel)\n103\t\t\tif d.IsDir() {\n104\t\t\t\treturn os.MkdirAll(target, 0o755)\n105\t\t\t}\n106\t\t\tdata, err := os.ReadFile(path)\n107\t\t\tif err != nil {\n108\t\t\t\treturn err\n109\t\t\t}\n110\t\t\treturn os.WriteFile(target, data, 0o644)\n111\t\t})\n112\t}\n113\t"}]},"parent_tool_use_id":null,"session_id":"4e2afcf5-7fc0-4a90-a6a6-e82e43a08449","uuid":"ec48bc9c-e2d1-4c03-a9ad-f88112730595","timestamp":"2026-08-31T13:45:58.740Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/session/skillconv.go","content":"package session\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\n\t\"github.com/lmuskalla/manigot/internal/fs\"\n)\n\n// SkillDir is one discovered skill: the skill's name (its directory name, the\n// identifier both CLIs use to address the skill) and the path to that\n// directory (which holds the SKILL.md plus any support files).\ntype SkillDir struct {\n\t// Name is the skill's directory name — the name both CLIs derive the\n\t// skill's identifier from.\n\tName string\n\n\t// Dir is the absolute path to the skill's directory.\n\tDir string\n}\n\n// listSkills enumerates the skill folders under srcDir — every immediate\n// subdirectory that contains a SKILL.md — returning them as <name>/ → dir\n// pairs sorted by name. A missing srcDir, or one with no skill folders,\n// yields an empty slice, not an error (skills are optional; every caller\n// skips cleanly when there is nothing to deliver).\nfunc listSkills(srcDir string) ([]SkillDir, error) {\n\tentries, err := os.ReadDir(srcDir)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn nil, nil\n\t\t}\n\t\treturn nil, err\n\t}\n\tvar skills []SkillDir\n\tfor _, e := range entries {\n\t\tif !e.IsDir() {\n\t\t\tcontinue\n\t\t}\n\t\tdir := filepath.Join(srcDir, e.Name())\n\t\tif !fs.IsFile(filepath.Join(dir, \"SKILL.md\")) {\n\t\t\tcontinue\n\t\t}\n\t\tskills = append(skills, SkillDir{Name: e.Name(), Dir: dir})\n\t}\n\tsort.Slice(skills, func(i, j int) bool { return skills[i].Name < skills[j].Name })\n\treturn skills, nil\n}\n\n// stageGlobalSkills copies every skill under srcDir into a fresh temp\n// directory — the directory-level counterpart of convertAgents (which stages\n// single converted agent files). Skills need no frontmatter conversion: both\n// CLIs read SKILL.md and its frontmatter (name:, description:, ...) natively,\n// so the copy is a plain recursive copy preserving each skill's directory and\n// its support files. The staged dir is meant for a read-only container mount\n// (see BuildDockerInvocation's global-skills block) and is removed by the\n// caller via the invocation's Cleanup hook — the host's skills/ source tree\n// is never modified.\n//\n// It returns the temp dir path and true when srcDir contained at least one\n// skill; (\"\", false, nil) when srcDir is missing or has no skills (nothing to\n// stage); and (\"\", false, err) on any failure, after removing any temp dir it\n// already created.\nfunc stageGlobalSkills(srcDir string) (string, bool, error) {\n\tskills, err := listSkills(srcDir)\n\tif err != nil {\n\t\treturn \"\", false, err\n\t}\n\tif len(skills) == 0 {\n\t\treturn \"\", false, nil\n\t}\n\ttmp, err := os.MkdirTemp(\"\", \"manigot-skills-*\")\n\tif err != nil {\n\t\treturn \"\", false, err\n\t}\n\tfor _, s := range skills {\n\t\tif err := copyDir(filepath.Join(tmp, s.Name), s.Dir); err != nil {\n\t\t\tos.RemoveAll(tmp)\n\t\t\treturn \"\", false, err\n\t\t}\n\t}\n\treturn tmp, true, nil\n}\n\n// copyDir recursively copies the directory src to dst, recreating the\n// directory structure and copying file contents. It is the directory-level\n// equivalent of convertAgents' single-file writes — a skill is a directory\n// (SKILL.md plus optional support files), so the whole tree must move.\n// Symlinked entries are copied by content (the link target's data), not\n// recreated as links, so a staged/host copy can never carry a symlink that\n// points outside the copied tree.\nfunc copyDir(dst, src string) error {\n\treturn filepath.WalkDir(src, func(path string, d os.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\trel, err := filepath.Rel(src, path)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\ttarget := filepath.Join(dst, rel)\n\t\tif d.IsDir() {\n\t\t\treturn os.MkdirAll(target, 0o755)\n\t\t}\n\t\tdata, err := os.ReadFile(path)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn os.WriteFile(target, data, 0o644)\n\t})\n}\n","numLines":113,"startLine":1,"totalLines":113}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012w5tofzUbXNn1CVNBi37bk","type":"tool_result","content":"1\tpackage session\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\t\"path/filepath\"\n6\t\t\"strings\"\n7\t\n8\t\t\"github.com/lmuskalla/manigot/internal/config\"\n9\t)\n10\t\n11\t// convertAgents converts every agent markdown file in srcDir (a project's\n12\t// docs/agents/) into the target tool's agent format, writing the converted\n13\t// files into a fresh temp directory. It returns the temp dir path and true\n14\t// when srcDir contained at least one *.md file; (\"\", false, nil) when srcDir\n15\t// is missing or empty (nothing to convert); and (\"\", false, err) on any\n16\t// failure, after removing any temp dir it already created.\n17\t//\n18\t// For ToolClaudeCode no conversion is needed at all — the list-form\n19\t// frontmatter (name:/description:/tools: Read, Grep, ...) is Claude's native\n20\t// subagent schema — so it always returns (\"\", false, nil).\n21\t//\n22\t// For ToolOpenCode the conversion mirrors the Dockerfile's bake-time awk for\n23\t// the built-in agents (which strips the `name:`, `tools:` and `commit:`\n24\t// frontmatter keys from the OpenCode copies of agents/*.md): `name:` is\n25\t// dropped because OpenCode derives the agent name from the filename, and\n26\t// `tools:` is dropped because OpenCode requires tools as a map and would\n27\t// hard-error on the list form (\"Expected object | undefined, got ...\").\n28\t// `commit:` is dropped because it is manigot's own git-mount-mode marker (see\n29\t// agentgit.go), unknown to OpenCode's agent schema — left in, OpenCode\n30\t// forwards it as an extra top-level field into the chat completions request,\n31\t// which OpenCode Zen's strict validator rejects outright (\"Extra inputs are\n32\t// not permitted, field: 'commit'\"). A `permission:` block — the OpenCode\n33\t// schema the read-only agents (reviewer/security/analyst/owner) use to\n34\t// express their restriction — passes through untouched, since OpenCode\n35\t// itself recognizes that key. The strip also handles multi-line map-form\n36\t// `tools:` blocks, so a custom agent written as an object today converts\n37\t// cleanly instead of leaving orphaned indented keys.\n38\t//\n39\t// The caller shadows the docs mount's agents/ subpath with the returned temp\n40\t// dir for OpenCode sessions (see BuildDockerInvocation) and removes it via\n41\t// the invocation's Cleanup hook (see DockerInvocation.Run) — the host's\n42\t// docs/agents/ source tree is never modified.\n43\tfunc convertAgents(srcDir, tool string) (string, bool, error) {\n44\t\tif tool != config.ToolOpenCode {\n45\t\t\treturn \"\", false, nil\n46\t\t}\n47\t\tentries, err := os.ReadDir(srcDir)\n48\t\tif err != nil {\n49\t\t\tif os.IsNotExist(err) {\n50\t\t\t\treturn \"\", false, nil\n51\t\t\t}\n52\t\t\treturn \"\", false, err\n53\t\t}\n54\t\tvar names []string\n55\t\tfor _, e := range entries {\n56\t\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".md\") {\n57\t\t\t\tcontinue\n58\t\t\t}\n59\t\t\tnames = append(names, e.Name()) // os.ReadDir sorts by name\n60\t\t}\n61\t\tif len(names) == 0 {\n62\t\t\treturn \"\", false, nil\n63\t\t}\n64\t\n65\t\ttmp, err := os.MkdirTemp(\"\", \"manigot-agents-*\")\n66\t\tif err != nil {\n67\t\t\treturn \"\", false, err\n68\t\t}\n69\t\tfor _, name := range names {\n70\t\t\tdata, err := os.ReadFile(filepath.Join(srcDir, name))\n71\t\t\tif err != nil {\n72\t\t\t\tos.RemoveAll(tmp)\n73\t\t\t\treturn \"\", false, err\n74\t\t\t}\n75\t\t\tif err := os.WriteFile(filepath.Join(tmp, name), convertAgentFile(data), 0o644); err != nil {\n76\t\t\t\tos.RemoveAll(tmp)\n77\t\t\t\treturn \"\", false, err\n78\t\t\t}\n79\t\t}\n80\t\treturn tmp, true, nil\n81\t}\n82\t\n83\t// convertAgentFile strips the frontmatter `name:`, `tools:` and `commit:`\n84\t// keys from an agent file, preserving the rest of the frontmatter and the\n85\t// body verbatim — the Go equivalent of the Dockerfile's bake-time awk:\n86\t//\n87\t//\tawk 'BEGIN{fm=0} /^---$/{fm++; print; next} fm==1 && /^(name|tools|commit):/{next} {print}'\n88\t//\n89\t// One deliberate extension over the awk: a multi-line map-form `tools:` block\n90\t// (tools: followed by indented entries) is dropped whole, not just its header\n91\t// line, so object-form agent files convert to clean frontmatter instead of\n92\t// leaving orphaned indented keys behind.\n93\tfunc convertAgentFile(src []byte) []byte {\n94\t\tlines := strings.Split(string(src), \"\\n\")\n95\t\tout := make([]string, 0, len(lines))\n96\t\tinFrontmatter := false\n97\t\tdroppingToolsBlock := false\n98\t\tfor _, line := range lines {\n99\t\t\tif line == \"---\" {\n100\t\t\t\tinFrontmatter = !inFrontmatter\n101\t\t\t\tdroppingToolsBlock = false\n102\t\t\t\tout = append(out, line)\n103\t\t\t\tcontinue\n104\t\t\t}\n105\t\t\tif !inFrontmatter {\n106\t\t\t\tout = append(out, line)\n107\t\t\t\tcontinue\n108\t\t\t}\n109\t\t\tif droppingToolsBlock {\n110\t\t\t\t// Indented continuation of a map-form tools: block — drop it\n111\t\t\t\t// until the first non-indented line (a new key, or the closing\n112\t\t\t\t// --- handled above).\n113\t\t\t\tif line == \"\" || line[0] == ' ' || line[0] == '\\t' {\n114\t\t\t\t\tcontinue\n115\t\t\t\t}\n116\t\t\t\tdroppingToolsBlock = false\n117\t\t\t}\n118\t\t\tif strings.HasPrefix(line, \"name:\") || strings.HasPrefix(line, \"tools:\") || strings.HasPrefix(line, \"commit:\") {\n119\t\t\t\tif strings.HasPrefix(line, \"tools:\") {\n120\t\t\t\t\tdroppingToolsBlock = true\n121\t\t\t\t}\n122\t\t\t\tcontinue\n123\t\t\t}\n124\t\t\tout = append(out, line)\n125\t\t}\n126\t\treturn []byte(strings.Join(out, \"\\n\"))\n127\t}\n128\t"}]},"parent_tool_use_id":null,"session_id":"4e2afcf5-7fc0-4a90-a6a6-e82e43a08449","uuid":"bae538ab-237a-4c44-854c-609eddd3fab9","timestamp":"2026-08-31T13:45:58.741Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/session/agentconv.go","content":"package session\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n)\n\n// convertAgents converts every agent markdown file in srcDir (a project's\n// docs/agents/) into the target tool's agent format, writing the converted\n// files into a fresh temp directory. It returns the temp dir path and true\n// when srcDir contained at least one *.md file; (\"\", false, nil) when srcDir\n// is missing or empty (nothing to convert); and (\"\", false, err) on any\n// failure, after removing any temp dir it already created.\n//\n// For ToolClaudeCode no conversion is needed at all — the list-form\n// frontmatter (name:/description:/tools: Read, Grep, ...) is Claude's native\n// subagent schema — so it always returns (\"\", false, nil).\n//\n// For ToolOpenCode the conversion mirrors the Dockerfile's bake-time awk for\n// the built-in agents (which strips the `name:`, `tools:` and `commit:`\n// frontmatter keys from the OpenCode copies of agents/*.md): `name:` is\n// dropped because OpenCode derives the agent name from the filename, and\n// `tools:` is dropped because OpenCode requires tools as a map and would\n// hard-error on the list form (\"Expected object | undefined, got ...\").\n// `commit:` is dropped because it is manigot's own git-mount-mode marker (see\n// agentgit.go), unknown to OpenCode's agent schema — left in, OpenCode\n// forwards it as an extra top-level field into the chat completions request,\n// which OpenCode Zen's strict validator rejects outright (\"Extra inputs are\n// not permitted, field: 'commit'\"). A `permission:` block — the OpenCode\n// schema the read-only agents (reviewer/security/analyst/owner) use to\n// express their restriction — passes through untouched, since OpenCode\n// itself recognizes that key. The strip also handles multi-line map-form\n// `tools:` blocks, so a custom agent written as an object today converts\n// cleanly instead of leaving orphaned indented keys.\n//\n// The caller shadows the docs mount's agents/ subpath with the returned temp\n// dir for OpenCode sessions (see BuildDockerInvocation) and removes it via\n// the invocation's Cleanup hook (see DockerInvocation.Run) — the host's\n// docs/agents/ source tree is never modified.\nfunc convertAgents(srcDir, tool string) (string, bool, error) {\n\tif tool != config.ToolOpenCode {\n\t\treturn \"\", false, nil\n\t}\n\tentries, err := os.ReadDir(srcDir)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn \"\", false, nil\n\t\t}\n\t\treturn \"\", false, err\n\t}\n\tvar names []string\n\tfor _, e := range entries {\n\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".md\") {\n\t\t\tcontinue\n\t\t}\n\t\tnames = append(names, e.Name()) // os.ReadDir sorts by name\n\t}\n\tif len(names) == 0 {\n\t\treturn \"\", false, nil\n\t}\n\n\ttmp, err := os.MkdirTemp(\"\", \"manigot-agents-*\")\n\tif err != nil {\n\t\treturn \"\", false, err\n\t}\n\tfor _, name := range names {\n\t\tdata, err := os.ReadFile(filepath.Join(srcDir, name))\n\t\tif err != nil {\n\t\t\tos.RemoveAll(tmp)\n\t\t\treturn \"\", false, err\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(tmp, name), convertAgentFile(data), 0o644); err != nil {\n\t\t\tos.RemoveAll(tmp)\n\t\t\treturn \"\", false, err\n\t\t}\n\t}\n\treturn tmp, true, nil\n}\n\n// convertAgentFile strips the frontmatter `name:`, `tools:` and `commit:`\n// keys from an agent file, preserving the rest of the frontmatter and the\n// body verbatim — the Go equivalent of the Dockerfile's bake-time awk:\n//\n//\tawk 'BEGIN{fm=0} /^---$/{fm++; print; next} fm==1 && /^(name|tools|commit):/{next} {print}'\n//\n// One deliberate extension over the awk: a multi-line map-form `tools:` block\n// (tools: followed by indented entries) is dropped whole, not just its header\n// line, so object-form agent files convert to clean frontmatter instead of\n// leaving orphaned indented keys behind.\nfunc convertAgentFile(src []byte) []byte {\n\tlines := strings.Split(string(src), \"\\n\")\n\tout := make([]string, 0, len(lines))\n\tinFrontmatter := false\n\tdroppingToolsBlock := false\n\tfor _, line := range lines {\n\t\tif line == \"---\" {\n\t\t\tinFrontmatter = !inFrontmatter\n\t\t\tdroppingToolsBlock = false\n\t\t\tout = append(out, line)\n\t\t\tcontinue\n\t\t}\n\t\tif !inFrontmatter {\n\t\t\tout = append(out, line)\n\t\t\tcontinue\n\t\t}\n\t\tif droppingToolsBlock {\n\t\t\t// Indented continuation of a map-form tools: block — drop it\n\t\t\t// until the first non-indented line (a new key, or the closing\n\t\t\t// --- handled above).\n\t\t\tif line == \"\" || line[0] == ' ' || line[0] == '\\t' {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tdroppingToolsBlock = false\n\t\t}\n\t\tif strings.HasPrefix(line, \"name:\") || strings.HasPrefix(line, \"tools:\") || strings.HasPrefix(line, \"commit:\") {\n\t\t\tif strings.HasPrefix(line, \"tools:\") {\n\t\t\t\tdroppingToolsBlock = true\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, line)\n\t}\n\treturn []byte(strings.Join(out, \"\\n\"))\n}\n","numLines":128,"startLine":1,"totalLines":128}}}
