{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RK6s2hZcxD2xoR4oXdPYMR","type":"tool_result","content":"1\tpackage session\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"strings\"\n8\t\t\"testing\"\n9\t\n10\t\t\"github.com/lmuskalla/manigot/internal/config\"\n11\t\t\"github.com/lmuskalla/manigot/internal/fs\"\n12\t)\n13\t\n14\t// docProject builds a docs-initialized scratch project (with an AGENTS.md) and\n15\t// a session checkout with full claude-pro credentials, then chdirs into the\n16\t// project so ResolveRoot resolves it.\n17\tfunc docProject(t *testing.T) (root, home string) {\n18\t\tt.Helper()\n19\t\troot = projectCheckout(t, t.TempDir(), true)\n20\t\tif err := os.WriteFile(filepath.Join(root, \"docs\", \"AGENTS.md\"), []byte(\"# ctx\\n\"), 0o644); err != nil {\n21\t\t\tt.Fatal(err)\n22\t\t}\n23\t\thome = checkout(t, \"CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-token\\nCLAUDE_ACCOUNT_UUID=uuid-1\\nCLAUDE_EMAIL=me@x.io\\nCLAUDE_ORG_UUID=org-1\\n\")\n24\t\tt.Chdir(root)\n25\t\treturn root, home\n26\t}\n27\t\n28\tfunc containsAll(t *testing.T, argv []string, wants ...string) {\n29\t\tt.Helper()\n30\t\tjoined := strings.Join(argv, \"\\n\")\n31\t\tfor _, w := range wants {\n32\t\t\tif !strings.Contains(joined, w) {\n33\t\t\t\tt.Errorf(\"argv missing %q\\nargv:\\n%s\", w, joined)\n34\t\t\t}\n35\t\t}\n36\t}\n37\t\n38\tfunc TestBuildPlainClaudeSession(t *testing.T) {\n39\t\troot, _ := docProject(t)\n40\t\tinfo, err := ResolveProfile(Options{})\n41\t\tif err != nil {\n42\t\t\tt.Fatalf(\"ResolveProfile: %v\", err)\n43\t\t}\n44\t\t// The real session flow runs CheckAuth before building the argv — the\n45\t\t// credential -e flags come from the resulting KeyEnv.\n46\t\tif err := info.CheckAuth(); err != nil {\n47\t\t\tt.Fatalf(\"CheckAuth: %v\", err)\n48\t\t}\n49\t\tr, err := ResolveRoot(Options{})\n50\t\tif err != nil {\n51\t\t\tt.Fatalf(\"ResolveRoot: %v\", err)\n52\t\t}\n53\t\tvar diag strings.Builder\n54\t\tinv, err := BuildDockerInvocation(Options{}, info, r, false, &diag)\n55\t\tif err != nil {\n56\t\t\tt.Fatalf(\"BuildDockerInvocation: %v\", err)\n57\t\t}\n58\t\tcontainsAll(t, inv.Argv,\n59\t\t\t\"docker\", \"run\", \"--rm\",\n60\t\t\t\"--name\", \"manigot-\"+filepath.Base(root)+\"-\",\n61\t\t\t\"--user\",\n62\t\t\t\"-v\", root+\":/workspace:z\",\n63\t\t\t\"-v\", filepath.Join(root, \"docs\")+\":/workspace/.claude:z\",\n64\t\t\t\"-v\", filepath.Join(root, \"docs\", \"AGENTS.md\")+\":/workspace/.claude/CLAUDE.md:ro\",\n65\t\t\t\"-e\", \"CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-token\",\n66\t\t\t\"-e\", \"CLAUDE_ACCOUNT_UUID=uuid-1\",\n67\t\t\t\"-e\", \"CLAUDE_EMAIL=me@x.io\",\n68\t\t\t\"-e\", \"CLAUDE_ORG_UUID=org-1\",\n69\t\t\t\"-e\", \"GIT_AUTHOR_NAME_CFG=Test\",\n70\t\t\t\"-e\", \"GIT_AUTHOR_EMAIL_CFG=test@x.io\",\n71\t\t\t\"-e\", \"MANIGOT_TOOL=claude-code\",\n72\t\t\t\"-e\", \"MANIGOT_PRINT=false\",\n73\t\t\t\"-e\", \"MANIGOT_QUOTE=\",\n74\t\t\t\"--network=bridge\", \"--memory=2g\", \"--security-opt=no-new-privileges\",\n75\t\t\t\"manigot\",\n76\t\t)\n77\t\t// Non-interactive stdin → no -it.\n78\t\tif strings.Contains(strings.Join(inv.Argv, \"\\n\"), \"-it\") {\n79\t\t\tt.Errorf(\"non-interactive build must not pass -it:\\n%s\", strings.Join(inv.Argv, \"\\n\"))\n80\t\t}"}]},"parent_tool_use_id":null,"session_id":"4e2afcf5-7fc0-4a90-a6a6-e82e43a08449","uuid":"f625adb6-28fb-499f-aee8-3dc69c0e261b","timestamp":"2026-08-31T13:49:20.323Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/session/docker_test.go","content":"package session\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/fs\"\n)\n\n// docProject builds a docs-initialized scratch project (with an AGENTS.md) and\n// a session checkout with full claude-pro credentials, then chdirs into the\n// project so ResolveRoot resolves it.\nfunc docProject(t *testing.T) (root, home string) {\n\tt.Helper()\n\troot = projectCheckout(t, t.TempDir(), true)\n\tif err := os.WriteFile(filepath.Join(root, \"docs\", \"AGENTS.md\"), []byte(\"# ctx\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\thome = checkout(t, \"CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-token\\nCLAUDE_ACCOUNT_UUID=uuid-1\\nCLAUDE_EMAIL=me@x.io\\nCLAUDE_ORG_UUID=org-1\\n\")\n\tt.Chdir(root)\n\treturn root, home\n}\n\nfunc containsAll(t *testing.T, argv []string, wants ...string) {\n\tt.Helper()\n\tjoined := strings.Join(argv, \"\\n\")\n\tfor _, w := range wants {\n\t\tif !strings.Contains(joined, w) {\n\t\t\tt.Errorf(\"argv missing %q\\nargv:\\n%s\", w, joined)\n\t\t}\n\t}\n}\n\nfunc TestBuildPlainClaudeSession(t *testing.T) {\n\troot, _ := docProject(t)\n\tinfo, err := ResolveProfile(Options{})\n\tif err != nil {\n\t\tt.Fatalf(\"ResolveProfile: %v\", err)\n\t}\n\t// The real session flow runs CheckAuth before building the argv — the\n\t// credential -e flags come from the resulting KeyEnv.\n\tif err := info.CheckAuth(); err != nil {\n\t\tt.Fatalf(\"CheckAuth: %v\", err)\n\t}\n\tr, err := ResolveRoot(Options{})\n\tif err != nil {\n\t\tt.Fatalf(\"ResolveRoot: %v\", err)\n\t}\n\tvar diag strings.Builder\n\tinv, err := BuildDockerInvocation(Options{}, info, r, false, &diag)\n\tif err != nil {\n\t\tt.Fatalf(\"BuildDockerInvocation: %v\", err)\n\t}\n\tcontainsAll(t, inv.Argv,\n\t\t\"docker\", \"run\", \"--rm\",\n\t\t\"--name\", \"manigot-\"+filepath.Base(root)+\"-\",\n\t\t\"--user\",\n\t\t\"-v\", root+\":/workspace:z\",\n\t\t\"-v\", filepath.Join(root, \"docs\")+\":/workspace/.claude:z\",\n\t\t\"-v\", filepath.Join(root, \"docs\", \"AGENTS.md\")+\":/workspace/.claude/CLAUDE.md:ro\",\n\t\t\"-e\", \"CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-token\",\n\t\t\"-e\", \"CLAUDE_ACCOUNT_UUID=uuid-1\",\n\t\t\"-e\", \"CLAUDE_EMAIL=me@x.io\",\n\t\t\"-e\", \"CLAUDE_ORG_UUID=org-1\",\n\t\t\"-e\", \"GIT_AUTHOR_NAME_CFG=Test\",\n\t\t\"-e\", \"GIT_AUTHOR_EMAIL_CFG=test@x.io\",\n\t\t\"-e\", \"MANIGOT_TOOL=claude-code\",\n\t\t\"-e\", \"MANIGOT_PRINT=false\",\n\t\t\"-e\", \"MANIGOT_QUOTE=\",\n\t\t\"--network=bridge\", \"--memory=2g\", \"--security-opt=no-new-privileges\",\n\t\t\"manigot\",\n\t)\n\t// Non-interactive stdin → no -it.\n\tif strings.Contains(strings.Join(inv.Argv, \"\\n\"), \"-it\") {\n\t\tt.Errorf(\"non-interactive build must not pass -it:\\n%s\", strings.Join(inv.Argv, \"\\n\"))\n\t}","numLines":80,"startLine":1,"totalLines":1653}}}
