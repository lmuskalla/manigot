rompt != \"hello\" || o.Tool != \"claude-code\" || o.Profile != \"zai\" || !o.Print {\n\t\tt.Errorf(\"ParseArgs = %+v\", o)\n\t}\n\tif len(o.Pass) != 1 || o.Pass[0] != \"extra\" {","numLines":45,"startLine":1,"totalLines":682}}}
