{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018xE8gtySnqZgD7xtCDx3gc","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\tset -euo pipefail\n3\t\n4\t# Which agent CLI to start — set by run.sh from the resolved session profile\n5\t# (MANIGOT_TOOL: claude-code or opencode).\n6\tTOOL=\"${MANIGOT_TOOL:-claude-code}\"\n7\t\n8\tif [[ \"$TOOL\" == \"claude-code\" ]]; then\n9\t    # Write ~/.claude.json to bypass the onboarding wizard.\n10\t    # Without this, Claude Code opens a browser OAuth flow on every container start.\n11\t    # Values come from environment variables set by run.sh from your .env file.\n12\t    CLAUDE_JSON=\"$HOME/.claude.json\"\n13\t\n14\t    if [[ ! -f \"$CLAUDE_JSON\" ]]; then\n15\t        if [[ -z \"${CLAUDE_ACCOUNT_UUID:-}\" ]] || [[ -z \"${CLAUDE_EMAIL:-}\" ]] || [[ -z \"${CLAUDE_ORG_UUID:-}\" ]]; then\n16\t            echo \"Error: CLAUDE_ACCOUNT_UUID, CLAUDE_EMAIL, and CLAUDE_ORG_UUID must be set.\"\n17\t            echo \"Extract them from your host with:\"\n18\t            echo \"  cat ~/.claude.json | python3 -c \\\"import json,sys; d=json.load(sys.stdin); print(json.dumps(d.get('oauthAccount'), indent=2))\\\"\"\n19\t            echo \"Then add them to your manigot/.env file.\"\n20\t            exit 1\n21\t        fi\n22\t\n23\t        # Get Claude Code version for lastOnboardingVersion\n24\t        CLAUDE_VERSION=$(claude --version 2>/dev/null | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' | head -1 || echo \"2.1.0\")\n25\t\n26\t        # `projects[\"/workspace\"].hasTrustDialogAccepted` pre-accepts the\n27\t        # folder-trust dialog for the container's fixed WORKDIR, so the \"do you\n28\t        # trust the files in this folder?\" prompt never appears on first start.\n29\t        # `bypassPermissionsModeAccepted` pre-accepts the one-time bypass\n30\t        # disclaimer so `--dangerously-skip-permissions` (passed to the exec\n31\t        # below) actually takes effect in interactive sessions — without it\n32\t        # Claude Code downgrades bypass mode to default with \"bypass requires\n33\t        # accepting the disclaimer interactively first\".\n34\t        cat > \"$CLAUDE_JSON\" <<EOF\n35\t{\n36\t  \"hasCompletedOnboarding\": true,\n37\t  \"lastOnboardingVersion\": \"$CLAUDE_VERSION\",\n38\t  \"bypassPermissionsModeAccepted\": true,\n39\t  \"oauthAccount\": {\n40\t    \"accountUuid\": \"$CLAUDE_ACCOUNT_UUID\",\n41\t    \"emailAddress\": \"$CLAUDE_EMAIL\",\n42\t    \"organizationUuid\": \"$CLAUDE_ORG_UUID\"\n43\t  },\n44\t  \"projects\": {\n45\t    \"/workspace\": {\n46\t      \"hasTrustDialogAccepted\": true\n47\t    }\n48\t  }\n49\t}\n50\tEOF\n51\t    fi\n52\telse\n53\t    # OpenCode has no onboarding wizard to bypass — it reads provider keys from\n54\t    # the environment on startup. Just make sure at least one of them is here,\n55\t    # otherwise it would start with no usable provider.\n56\t    OPENCODE_KEY_VARS=(\n57\t        ANTHROPIC_API_KEY\n58\t        OPENAI_API_KEY\n59\t        OPENROUTER_API_KEY\n60\t        GOOGLE_GENERATIVE_AI_API_KEY\n61\t        GROQ_API_KEY\n62\t        XAI_API_KEY\n63\t        DEEPSEEK_API_KEY\n64\t        OPENCODE_API_KEY\n65\t        ZHIPU_API_KEY\n66\t    )\n67\t\n68\t    HAVE_KEY=0\n69\t    for var in \"${OPENCODE_KEY_VARS[@]}\"; do\n70\t        [[ -n \"${!var:-}\" ]] && HAVE_KEY=1\n71\t    done\n72\t\n73\t    if [[ \"$HAVE_KEY\" -eq 0 ]]; then\n74\t        echo \"Error: no provider API key found for OpenCode.\"\n75\t        echo \"Set at least one of these in your manigot/.env file:\"\n76\t        printf '  %s\\n' \"${OPENCODE_KEY_VARS[@]}\"\n77\t        exit 1\n78\t    fi\n79\t\n80\t    # OpenCode doesn't read OPENCODE_MODEL directly — the model must come from a\n81\t    # config file. run.sh forwards OPENCODE_MODEL; emit a minimal global config\n82\t    # using {env:...} substitution so it actually takes effect. Without this\n83\t    # OpenCode boots with its built-in default model (often the wrong provider).\n84\t    OPENCODE_CFG=\"$HOME/.config/opencode/opencode.json\"\n85\t    if [[ -n \"${OPENCODE_MODEL:-}\" && ! -f \"$OPENCODE_CFG\" ]]; then\n86\t        mkdir -p \"$(dirname \"$OPENCODE_CFG\")\"\n87\t        cat > \"$OPENCODE_CFG\" <<'EOF'\n88\t{\n89\t  \"$schema\": \"https://opencode.ai/config.json\",\n90\t  \"model\": \"{env:OPENCODE_MODEL}\"\n91\t}\n92\tEOF\n93\t    fi\n94\t\n95\t    # The theme setting is TUI-specific and lives in its own tui.json, not\n96\t    # opencode.json — confirmed against https://opencode.ai/docs/config/,\n97\t    # which documents opencode.json's top-level \"theme\" key as legacy\n98\t    # (\"Legacy theme, keybinds, and tui keys in opencode.json are deprecated\n99\t    # and automatically migrated when possible\") and directs current users to\n100\t    # tui.json instead (https://opencode.ai/docs/themes/'s own example uses\n101\t    # tui.json). run.sh forwards OPENCODE_THEME when the user has set the\n102\t    # global theme (mg theme); emit a minimal tui.json using the same\n103\t    # {env:...} substitution the model config above relies on. Without this\n104\t    # OpenCode boots with its built-in default theme, ignoring the user's\n105\t    # choice.\n106\t    OPENCODE_TUI_CFG=\"$HOME/.config/opencode/tui.json\"\n107\t    if [[ -n \"${OPENCODE_THEME:-}\" && ! -f \"$OPENCODE_TUI_CFG\" ]]; then\n108\t        mkdir -p \"$(dirname \"$OPENCODE_TUI_CFG\")\"\n109\t        cat > \"$OPENCODE_TUI_CFG\" <<'EOF'\n110\t{\n111\t  \"$schema\": \"https://opencode.ai/tui.json\",\n112\t  \"theme\": \"{env:OPENCODE_THEME}\"\n113\t}\n114\tEOF\n115\t    fi\n116\tfi\n117\t\n118\t# ── Git config ──────────────────────────────────────────────────────────────────\n119\t# GIT_AUTHOR_NAME/EMAIL env vars override gitconfig when set — even when empty.\n120\t# Unset them first so gitconfig always wins, then configure gitconfig from\n121\t# whatever values we have available.\n122\tunset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL\n123\t\n124\tGIT_NAME=\"${GIT_AUTHOR_NAME_CFG:-manigot}\"\n125\tGIT_EMAIL=\"${GIT_AUTHOR_EMAIL_CFG:-manigot@localhost}\"\n126\t\n127\tgit config --global user.name  \"$GIT_NAME\"\n128\tgit config --global user.email \"$GIT_EMAIL\"\n129\t\n130\tgit config --global --add safe.directory /workspace\n131\t\n132\t# ── Git shim ──────────────────────────────────────────────────────────────────\n133\t# Agents may read git history and make commits, nothing more. A PATH-first git\n134\t# shim allowlists the read + commit subcommands and refuses everything else\n135\t# (worktree management, branch -d/-D, reset, clean, gc, prune, reflog, push,\n136\t# fetch, pull, checkout, switch, restore, stash, remote, tag writes,\n137\t# update-ref, merge, rebase, ...) with a clear message. It is a soft layer — a\n138\t# determined agent can exec the real git at its absolute path or write the\n139\t# mounted gitdir directly; the hard filesystem boundary for non-committing\n140\t# agents is the read-only git-common-dir mount the session launcher sets up.\n141\t# Installed after the git config --global calls above, so the shim never sees\n142\t# (and never blocks) the entrypoint's own configuration writes.\n143\tMANIGOT_BIN=\"$HOME/.manigot/bin\"\n144\tmkdir -p \"$MANIGOT_BIN\"\n145\tREAL_GIT=\"$(command -v git)\"\n146\t\n147\tcat > \"$MANIGOT_BIN/git\" <<'SHIM'\n148\t#!/usr/bin/env bash\n149\tset -euo pipefail\n150\t\n151\t# manigot git shim — agents may read git history and make commits, nothing\n152\t# more. See docs/AGENTS.md (\"Session git shim\").\n153\tREAL_GIT=\"@REAL_GIT@\"\n154\t\n155\t# Subcommands allowed: the read surface (history, index, refs, objects) plus\n156\t# add/commit. Everything else is refused below. The destructive forms of the\n157\t# allowed commands (branch -d/-D/-m/-M/-c/-C, config writes, symbolic-ref\n158\t# writes) are refused per-command.\n159\tALLOWED=\" add commit diff log show status rev-parse rev-list merge-base branch config grep ls-files ls-tree cat-file for-each-ref show-ref describe blame shortlog whatchanged name-rev check-ignore check-attr check-mailmap count-objects diff-index diff-tree diff-files symbolic-ref \"\n160\t\n161\tdeny() {\n162\t    echo \"manigot: git '$1' is not allowed in agent sessions.\" >&2\n163\t    echo \"manigot: agents may only read git history and make commits (git add, git commit, git log, git diff, git show, git status, ...).\" >&2\n164\t    exit 1\n165\t}\n166\t\n167\t# Locate the subcommand, skipping leading git global options and their values\n168\t# (git -C <dir>, git -c key=value, --git-dir, --work-tree, ...). Everything\n169\t# after the subcommand is collected in rest for the per-command checks below.\n170\tsubcmd=\"\"\n171\trest=()\n172\tskip_next=0\n173\tfor arg in \"$@\"; do\n174\t    if [[ -n \"$subcmd\" ]]; then\n175\t        rest+=(\"$arg\")\n176\t        continue\n177\t    fi\n178\t    if [[ \"$skip_next\" -eq 1 ]]; then\n179\t        skip_next=0\n180\t        continue\n181\t    fi\n182\t    case \"$arg\" in\n183\t        -C|-c|--git-dir|--work-tree|--namespace|--config-env)\n184\t            skip_next=1\n185\t            ;;\n186\t        --git-dir=*|--work-tree=*|--namespace=*|--config-env=*|-c?*)\n187\t            ;;\n188\t        -*)\n189\t            ;;\n190\t        *)\n191\t            subcmd=\"$arg\"\n192\t            ;;\n193\t    esac\n194\tdone\n195\t\n196\tif [[ -z \"$subcmd\" ]] || [[ \"$ALLOWED\" != *\" $subcmd \"* ]]; then\n197\t    deny \"${subcmd:-<no subcommand>}\"\n198\tfi\n199\t\n200\tcase \"$subcmd\" in\n201\t    add)\n202\t        # The container docs mounts collide with the repo paths .opencode/\n203\t        # (OpenCode) and .claude/ (Claude Code): inside the container those\n204\t        # are bind mounts of docs/, so an agent staging files through them\n205\t        # would commit a stale duplicate of docs/ under the colliding path.\n206\t        # info/exclude already makes git ignore both paths (host-side, via\n207\t        # git.ExcludeMountTargets at job creation and session launch) — this\n208\t        # is the belt-and-braces second layer for a worktree the exclusion\n209\t        # hasn't reached yet. Covers leading ./ variants and -f forces.\n210\t        for a in \"${rest[@]}\"; do\n211\t            case \"$a\" in\n212\t                .opencode*|./.opencode*|.claude*|./.claude*)\n213\t                    deny \"add $a\"\n214\t                    ;;\n215\t            esac\n216\t        done\n217\t        ;;\n218\t    branch)\n219\t        for a in \"${rest[@]}\"; do\n220\t            case \"$a\" in\n221\t                -d*|-D*|-m*|-M*|-c*|-C*|-f*|--delete*|--move*|--copy*|--track*|--no-track*|--set-upstream*|--unset-upstream*|--edit-description*)\n222\t                    deny \"branch $a\"\n223\t                    ;;\n224\t            esac\n225\t        done\n226\t        ;;\n227\t    config)\n228\t        positional=0\n229\t        write=0\n230\t        for a in \"${rest[@]}\"; do\n231\t            case \"$a\" in\n232\t                --add|--unset|--unset-all|--rename-section|--remove-section|--edit|--replace-all)\n233\t                    write=1\n234\t                    ;;\n235\t                -*)\n236\t                    ;;\n237\t                *)\n238\t                    positional=$((positional + 1))\n239\t                    ;;\n240\t            esac\n241\t        done\n242\t        if [[ \"$write\" -eq 1 || \"$positional\" -ge 2 ]]; then\n243\t            deny \"config write\"\n244\t        fi\n245\t        ;;\n246\t    symbolic-ref)\n247\t        positional=0\n248\t        for a in \"${rest[@]}\"; do\n249\t            case \"$a\" in\n250\t                -*) ;;\n251\t                *) positional=$((positional + 1)) ;;\n252\t            esac\n253\t        done\n254\t        if [[ \"$positional\" -ge 2 ]]; then\n255\t            deny \"symbolic-ref write\"\n256\t        fi\n257\t        ;;\n258\tesac\n259\t\n260\texec \"$REAL_GIT\" \"$@\"\n261\tSHIM\n262\t\n263\tsed -i \"s|@REAL_GIT@|$REAL_GIT|g\" \"$MANIGOT_BIN/git\"\n264\tchmod +x \"$MANIGOT_BIN/git\"\n265\texport PATH=\"$MANIGOT_BIN:$PATH\"\n266\t\n267\t# --print mode expects a clean stdout stream (see run.sh and the\n268\t# --output-format stream-json branch below) — this quote is purely cosmetic, so\n269\t# it's skipped there rather than risking a caller mis-parsing it as part\n270\t# of the agent's own output. Printed in italics (raw ANSI, not tput/ncurses\n271\t# — not guaranteed present in this slim image) with a trailing blank line.\n272\tif [[ \"${MANIGOT_PRINT:-false}\" != \"true\" && -n \"${MANIGOT_QUOTE:-}\" ]]; then\n273\t    printf '\\033[3m\"%s\"\\033[0m\\n\\n' \"$MANIGOT_QUOTE\"\n274\tfi\n275\t\n276\tif [[ \"$TOOL\" == \"opencode\" ]]; then\n277\t    if [[ \"${MANIGOT_PRINT:-false}\" == \"true\" ]]; then\n278\t        # Non-interactive, one-shot mode (run.sh's --print flag, e.g. for\n279\t        # mg-jdi) — mirrors the claude-code branch below. OpenCode's\n280\t        # interactive `opencode [project]` command (the \"$@\" passthrough\n281\t        # used otherwise) takes --agent/--prompt as flags, but has no\n282\t        # non-interactive equivalent of its own; the headless mode is a\n283\t        # separate subcommand, `opencode run [message..]`, which takes the\n284\t        # prompt as a positional argument instead and supports its own\n285\t        # --agent flag (confirmed via `opencode run --help` against the\n286\t        # opencode-ai version installed from the Dockerfile's unpinned `npm\n287\t        # install -g opencode-ai`). Translate the incoming --agent/--prompt\n288\t        # pair into that shape rather than passing \"$@\" through unchanged.\n289\t        # --format json makes it emit one JSON object per line (JSONL: a\n290\t        # stream of step_start/tool_use/text/step_finish events, each\n291\t        # reporting the assistant's response in a \"text\"-typed event's\n292\t        # part.text) instead of interactive TUI output — parsed by\n293\t        # tui/internal/orchestrate.ResultText/DetectSignal the same way\n294\t        # Claude's --output-format stream-json \"result\" event is.\n295\t        OC_AGENT=\"\"\n296\t        OC_PROMPT=\"\"\n297\t        OC_REST=()\n298\t        while [[ $# -gt 0 ]]; do\n299\t            case \"$1\" in\n300\t                --agent)  OC_AGENT=\"$2\";  shift 2 ;;\n301\t                --prompt) OC_PROMPT=\"$2\"; shift 2 ;;\n302\t                *)        OC_REST+=(\"$1\"); shift ;;\n303\t            esac\n304\t        done\n305\t\n306\t        OC_ARGS=(run)\n307\t        [[ -n \"$OC_PROMPT\" ]] && OC_ARGS+=(\"$OC_PROMPT\")\n308\t        [[ -n \"$OC_AGENT\" ]] && OC_ARGS+=(--agent \"$OC_AGENT\")\n309\t        # --auto makes the headless run explicitly auto-approved: the archived\n310\t        # foycfl job verified `opencode run` auto-executes bash/write tool\n311\t        # calls even without it, but the flag makes the intent explicit and\n312\t        # guards other tools (webfetch, task, lsp, mcp) against an unanswered\n313\t        # \"ask\" prompt stalling an unattended non-TTY run — the headless\n314\t        # counterpart of the interactive --auto above and of Claude's\n315\t        # --dangerously-skip-permissions on its own --print branch.\n316\t        OC_ARGS+=(--auto --format json)\n317\t        exec opencode \"${OC_ARGS[@]}\" \"${OC_REST[@]+\"${OC_REST[@]}\"}\"\n318\t    fi\n319\t    # --auto starts every OpenCode session in full auto mode (no per-tool\n320\t    # confirmation, e.g. \"can I run this python script?\"). Safe in this context\n321\t    # because manigot launches an isolated, ephemeral container specifically for\n322\t    # this purpose; the brief explicitly wants OpenCode to start in auto mode,\n323\t    # mirroring the claude-code branch's --dangerously-skip-permissions below.\n324\t    # Placed before \"$@\" so it composes with the passthrough (--agent <name>,\n325\t    # --prompt <text> and/or the positional job prompt).\n326\t    exec opencode --auto \"$@\"\n327\telse\n328\t    # --dangerously-skip-permissions starts every Claude Code session in full\n329\t    # auto mode (no per-tool-call confirmation). Safe in this context because\n330\t    # manigot launches an isolated, ephemeral container specifically for this\n331\t    # purpose; the brief explicitly wants Claude Code to start in auto mode.\n332\t    # Placed before \"$@\" so it composes with the passthrough (--agent <name>\n333\t    # and/or the positional job prompt).\n334\t    if [[ \"${MANIGOT_PRINT:-false}\" == \"true\" ]]; then\n335\t        # Non-interactive, one-shot mode (run.sh's --print flag, e.g. for\n336\t        # mg-jdi): no attached terminal, so the caller gets the agent's\n337\t        # output back on stdout instead. --verbose --output-format\n338\t        # stream-json emits a step-level JSONL event stream — system /\n339\t        # assistant / user / result events, one object per line — whose\n340\t        # final \"result\" event's \"result\" field carries the final response\n341\t        # text. That is strictly more than the old single-result json form:\n342\t        # the full stream is what mg-jdi streams live into the job's\n343\t        # session.log (see jdioutput.go's openSessionLog), not just the final\n344\t        # answer.\n345\t        # --verbose is required: claude rejects stream-json under --print\n346\t        # without it (\"--output-format=stream-json requires --verbose\"),\n347\t        # verified against the installed version (2.1.247). Stream-json has\n348\t        # been more version-volatile than the stable single-result shape, so\n349\t        # internal/orchestrate keeps the plain result parse as a defensive\n350\t        # fallback (see signal.go). Parsing the stream — instead of scanning\n351\t        # raw combined stdout — also keeps the marker text (see\n352\t        # docs/AGENTS.md) from false-positiving when it appears incidentally\n353\t        # inside a tool call's own output (e.g. a grep result).\n354\t        exec claude --dangerously-skip-permissions --print --verbose --output-format stream-json \"$@\"\n355\t    fi\n356\t    exec claude --dangerously-skip-permissions \"$@\"\n357\tfi"}]},"parent_tool_use_id":null,"session_id":"4e2afcf5-7fc0-4a90-a6a6-e82e43a08449","uuid":"d13ba09b-fd78-4e47-9c53-4f9767ae07cc","timestamp":"2026-08-31T13:46:02.490Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/scripts/entrypoint.sh","content":"#!/usr/bin/env bash\nset -euo pipefail\n\n# Which agent CLI to start — set by run.sh from the resolved session profile\n# (MANIGOT_TOOL: claude-code or opencode).\nTOOL=\"${MANIGOT_TOOL:-claude-code}\"\n\nif [[ \"$TOOL\" == \"claude-code\" ]]; then\n    # Write ~/.claude.json to bypass the onboarding wizard.\n    # Without this, Claude Code opens a browser OAuth flow on every container start.\n    # Values come from environment variables set by run.sh from your .env file.\n    CLAUDE_JSON=\"$HOME/.claude.json\"\n\n    if [[ ! -f \"$CLAUDE_JSON\" ]]; then\n        if [[ -z \"${CLAUDE_ACCOUNT_UUID:-}\" ]] || [[ -z \"${CLAUDE_EMAIL:-}\" ]] || [[ -z \"${CLAUDE_ORG_UUID:-}\" ]]; then\n            echo \"Error: CLAUDE_ACCOUNT_UUID, CLAUDE_EMAIL, and CLAUDE_ORG_UUID must be set.\"\n            echo \"Extract them from your host with:\"\n            echo \"  cat ~/.claude.json | python3 -c \\\"import json,sys; d=json.load(sys.stdin); print(json.dumps(d.get('oauthAccount'), indent=2))\\\"\"\n            echo \"Then add them to your manigot/.env file.\"\n            exit 1\n        fi\n\n        # Get Claude Code version for lastOnboardingVersion\n        CLAUDE_VERSION=$(claude --version 2>/dev/null | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' | head -1 || echo \"2.1.0\")\n\n        # `projects[\"/workspace\"].hasTrustDialogAccepted` pre-accepts the\n        # folder-trust dialog for the container's fixed WORKDIR, so the \"do you\n        # trust the files in this folder?\" prompt never appears on first start.\n        # `bypassPermissionsModeAccepted` pre-accepts the one-time bypass\n        # disclaimer so `--dangerously-skip-permissions` (passed to the exec\n        # below) actually takes effect in interactive sessions — without it\n        # Claude Code downgrades bypass mode to default with \"bypass requires\n        # accepting the disclaimer interactively first\".\n        cat > \"$CLAUDE_JSON\" <<EOF\n{\n  \"hasCompletedOnboarding\": true,\n  \"lastOnboardingVersion\": \"$CLAUDE_VERSION\",\n  \"bypassPermissionsModeAccepted\": true,\n  \"oauthAccount\": {\n    \"accountUuid\": \"$CLAUDE_ACCOUNT_UUID\",\n    \"emailAddress\": \"$CLAUDE_EMAIL\",\n    \"organizationUuid\": \"$CLAUDE_ORG_UUID\"\n  },\n  \"projects\": {\n    \"/workspace\": {\n      \"hasTrustDialogAccepted\": true\n    }\n  }\n}\nEOF\n    fi\nelse\n    # OpenCode has no onboarding wizard to bypass — it reads provider keys from\n    # the environment on startup. Just make sure at least one of them is here,\n    # otherwise it would start with no usable provider.\n    OPENCODE_KEY_VARS=(\n        ANTHROPIC_API_KEY\n        OPENAI_API_KEY\n        OPENROUTER_API_KEY\n        GOOGLE_GENERATIVE_AI_API_KEY\n        GROQ_API_KEY\n        XAI_API_KEY\n        DEEPSEEK_API_KEY\n        OPENCODE_API_KEY\n        ZHIPU_API_KEY\n    )\n\n    HAVE_KEY=0\n    for var in \"${OPENCODE_KEY_VARS[@]}\"; do\n        [[ -n \"${!var:-}\" ]] && HAVE_KEY=1\n    done\n\n    if [[ \"$HAVE_KEY\" -eq 0 ]]; then\n        echo \"Error: no provider API key found for OpenCode.\"\n        echo \"Set at least one of these in your manigot/.env file:\"\n        printf '  %s\\n' \"${OPENCODE_KEY_VARS[@]}\"\n        exit 1\n    fi\n\n    # OpenCode doesn't read OPENCODE_MODEL directly — the model must come from a\n    # config file. run.sh forwards OPENCODE_MODEL; emit a minimal global config\n    # using {env:...} substitution so it actually takes effect. Without this\n    # OpenCode boots with its built-in default model (often the wrong provider).\n    OPENCODE_CFG=\"$HOME/.config/opencode/opencode.json\"\n    if [[ -n \"${OPENCODE_MODEL:-}\" && ! -f \"$OPENCODE_CFG\" ]]; then\n        mkdir -p \"$(dirname \"$OPENCODE_CFG\")\"\n        cat > \"$OPENCODE_CFG\" <<'EOF'\n{\n  \"$schema\": \"https://opencode.ai/config.json\",\n  \"model\": \"{env:OPENCODE_MODEL}\"\n}\nEOF\n    fi\n\n    # The theme setting is TUI-specific and lives in its own tui.json, not\n    # opencode.json — confirmed against https://opencode.ai/docs/config/,\n    # which documents opencode.json's top-level \"theme\" key as legacy\n    # (\"Legacy theme, keybinds, and tui keys in opencode.json are deprecated\n    # and automatically migrated when possible\") and directs current users to\n    # tui.json instead (https://opencode.ai/docs/themes/'s own example uses\n    # tui.json). run.sh forwards OPENCODE_THEME when the user has set the\n    # global theme (mg theme); emit a minimal tui.json using the same\n    # {env:...} substitution the model config above relies on. Without this\n    # OpenCode boots with its built-in default theme, ignoring the user's\n    # choice.\n    OPENCODE_TUI_CFG=\"$HOME/.config/opencode/tui.json\"\n    if [[ -n \"${OPENCODE_THEME:-}\" && ! -f \"$OPENCODE_TUI_CFG\" ]]; then\n        mkdir -p \"$(dirname \"$OPENCODE_TUI_CFG\")\"\n        cat > \"$OPENCODE_TUI_CFG\" <<'EOF'\n{\n  \"$schema\": \"https://opencode.ai/tui.json\",\n  \"theme\": \"{env:OPENCODE_THEME}\"\n}\nEOF\n    fi\nfi\n\n# ── Git config ──────────────────────────────────────────────────────────────────\n# GIT_AUTHOR_NAME/EMAIL env vars override gitconfig when set — even when empty.\n# Unset them first so gitconfig always wins, then configure gitconfig from\n# whatever values we have available.\nunset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL\n\nGIT_NAME=\"${GIT_AUTHOR_NAME_CFG:-manigot}\"\nGIT_EMAIL=\"${GIT_AUTHOR_EMAIL_CFG:-manigot@localhost}\"\n\ngit config --global user.name  \"$GIT_NAME\"\ngit config --global user.email \"$GIT_EMAIL\"\n\ngit config --global --add safe.directory /workspace\n\n# ── Git shim ──────────────────────────────────────────────────────────────────\n# Agents may read git history and make commits, nothing more. A PATH-first git\n# shim allowlists the read + commit subcommands and refuses everything else\n# (worktree management, branch -d/-D, reset, clean, gc, prune, reflog, push,\n# fetch, pull, checkout, switch, restore, stash, remote, tag writes,\n# update-ref, merge, rebase, ...) with a clear message. It is a soft layer — a\n# determined agent can exec the real git at its absolute path or write the\n# mounted gitdir directly; the hard filesystem boundary for non-committing\n# agents is the read-only git-common-dir mount the session launcher sets up.\n# Installed after the git config --global calls above, so the shim never sees\n# (and never blocks) the entrypoint's own configuration writes.\nMANIGOT_BIN=\"$HOME/.manigot/bin\"\nmkdir -p \"$MANIGOT_BIN\"\nREAL_GIT=\"$(command -v git)\"\n\ncat > \"$MANIGOT_BIN/git\" <<'SHIM'\n#!/usr/bin/env bash\nset -euo pipefail\n\n# manigot git shim — agents may read git history and make commits, nothing\n# more. See docs/AGENTS.md (\"Session git shim\").\nREAL_GIT=\"@REAL_GIT@\"\n\n# Subcommands allowed: the read surface (history, index, refs, objects) plus\n# add/commit. Everything else is refused below. The destructive forms of the\n# allowed commands (branch -d/-D/-m/-M/-c/-C, config writes, symbolic-ref\n# writes) are refused per-command.\nALLOWED=\" add commit diff log show status rev-parse rev-list merge-base branch config grep ls-files ls-tree cat-file for-each-ref show-ref describe blame shortlog whatchanged name-rev check-ignore check-attr check-mailmap count-objects diff-index diff-tree diff-files symbolic-ref \"\n\ndeny() {\n    echo \"manigot: git '$1' is not allowed in agent sessions.\" >&2\n    echo \"manigot: agents may only read git history and make commits (git add, git commit, git log, git diff, git show, git status, ...).\" >&2\n    exit 1\n}\n\n# Locate the subcommand, skipping leading git global options and their values\n# (git -C <dir>, git -c key=value, --git-dir, --work-tree, ...). Everything\n# after the subcommand is collected in rest for the per-command checks below.\nsubcmd=\"\"\nrest=()\nskip_next=0\nfor arg in \"$@\"; do\n    if [[ -n \"$subcmd\" ]]; then\n        rest+=(\"$arg\")\n        continue\n    fi\n    if [[ \"$skip_next\" -eq 1 ]]; then\n        skip_next=0\n        continue\n    fi\n    case \"$arg\" in\n        -C|-c|--git-dir|--work-tree|--namespace|--config-env)\n            skip_next=1\n            ;;\n        --git-dir=*|--work-tree=*|--namespace=*|--config-env=*|-c?*)\n            ;;\n        -*)\n            ;;\n        *)\n            subcmd=\"$arg\"\n            ;;\n    esac\ndone\n\nif [[ -z \"$subcmd\" ]] || [[ \"$ALLOWED\" != *\" $subcmd \"* ]]; then\n    deny \"${subcmd:-<no subcommand>}\"\nfi\n\ncase \"$subcmd\" in\n    add)\n        # The container docs mounts collide with the repo paths .opencode/\n        # (OpenCode) and .claude/ (Claude Code): inside the container those\n        # are bind mounts of docs/, so an agent staging files through them\n        # would commit a stale duplicate of docs/ under the colliding path.\n        # info/exclude already makes git ignore both paths (host-side, via\n        # git.ExcludeMountTargets at job creation and session launch) — this\n        # is the belt-and-braces second layer for a worktree the exclusion\n        # hasn't reached yet. Covers leading ./ variants and -f forces.\n        for a in \"${rest[@]}\"; do\n            case \"$a\" in\n                .opencode*|./.opencode*|.claude*|./.claude*)\n                    deny \"add $a\"\n                    ;;\n            esac\n        done\n        ;;\n    branch)\n        for a in \"${rest[@]}\"; do\n            case \"$a\" in\n                -d*|-D*|-m*|-M*|-c*|-C*|-f*|--delete*|--move*|--copy*|--track*|--no-track*|--set-upstream*|--unset-upstream*|--edit-description*)\n                    deny \"branch $a\"\n                    ;;\n            esac\n        done\n        ;;\n    config)\n        positional=0\n        write=0\n        for a in \"${rest[@]}\"; do\n            case \"$a\" in\n                --add|--unset|--unset-all|--rename-section|--remove-section|--edit|--replace-all)\n                    write=1\n                    ;;\n                -*)\n                    ;;\n                *)\n                    positional=$((positional + 1))\n                    ;;\n            esac\n        done\n        if [[ \"$write\" -eq 1 || \"$positional\" -ge 2 ]]; then\n            deny \"config write\"\n        fi\n        ;;\n    symbolic-ref)\n        positional=0\n        for a in \"${rest[@]}\"; do\n            case \"$a\" in\n                -*) ;;\n                *) positional=$((positional + 1)) ;;\n            esac\n        done\n        if [[ \"$positional\" -ge 2 ]]; then\n            deny \"symbolic-ref write\"\n        fi\n        ;;\nesac\n\nexec \"$REAL_GIT\" \"$@\"\nSHIM\n\nsed -i \"s|@REAL_GIT@|$REAL_GIT|g\" \"$MANIGOT_BIN/git\"\nchmod +x \"$MANIGOT_BIN/git\"\nexport PATH=\"$MANIGOT_BIN:$PATH\"\n\n# --print mode expects a clean stdout stream (see run.sh and the\n# --output-format stream-json branch below) — this quote is purely cosmetic, so\n# it's skipped there rather than risking a caller mis-parsing it as part\n# of the agent's own output. Printed in italics (raw ANSI, not tput/ncurses\n# — not guaranteed present in this slim image) with a trailing blank line.\nif [[ \"${MANIGOT_PRINT:-false}\" != \"true\" && -n \"${MANIGOT_QUOTE:-}\" ]]; then\n    printf '\\033[3m\"%s\"\\033[0m\\n\\n' \"$MANIGOT_QUOTE\"\nfi\n\nif [[ \"$TOOL\" == \"opencode\" ]]; then\n    if [[ \"${MANIGOT_PRINT:-false}\" == \"true\" ]]; then\n        # Non-interactive, one-shot mode (run.sh's --print flag, e.g. for\n        # mg-jdi) — mirrors the claude-code branch below. OpenCode's\n        # interactive `opencode [project]` command (the \"$@\" passthrough\n        # used otherwise) takes --agent/--prompt as flags, but has no\n        # non-interactive equivalent of its own; the headless mode is a\n        # separate subcommand, `opencode run [message..]`, which takes the\n        # prompt as a positional argument instead and supports its own\n        # --agent flag (confirmed via `opencode run --help` against the\n        # opencode-ai version installed from the Dockerfile's unpinned `npm\n        # install -g opencode-ai`). Translate the incoming --agent/--prompt\n        # pair into that shape rather than passing \"$@\" through unchanged.\n        # --format json makes it emit one JSON object per line (JSONL: a\n        # stream of step_start/tool_use/text/step_finish events, each\n        # reporting the assistant's response in a \"text\"-typed event's\n        # part.text) instead of interactive TUI output — parsed by\n        # tui/internal/orchestrate.ResultText/DetectSignal the same way\n        # Claude's --output-format stream-json \"result\" event is.\n        OC_AGENT=\"\"\n        OC_PROMPT=\"\"\n        OC_REST=()\n        while [[ $# -gt 0 ]]; do\n            case \"$1\" in\n                --agent)  OC_AGENT=\"$2\";  shift 2 ;;\n                --prompt) OC_PROMPT=\"$2\"; shift 2 ;;\n                *)        OC_REST+=(\"$1\"); shift ;;\n            esac\n        done\n\n        OC_ARGS=(run)\n        [[ -n \"$OC_PROMPT\" ]] && OC_ARGS+=(\"$OC_PROMPT\")\n        [[ -n \"$OC_AGENT\" ]] && OC_ARGS+=(--agent \"$OC_AGENT\")\n        # --auto makes the headless run explicitly auto-approved: the archived\n        # foycfl job verified `opencode run` auto-executes bash/write tool\n        # calls even without it, but the flag makes the intent explicit and\n        # guards other tools (webfetch, task, lsp, mcp) against an unanswered\n        # \"ask\" prompt stalling an unattended non-TTY run — the headless\n        # counterpart of the interactive --auto above and of Claude's\n        # --dangerously-skip-permissions on its own --print branch.\n        OC_ARGS+=(--auto --format json)\n        exec opencode \"${OC_ARGS[@]}\" \"${OC_REST[@]+\"${OC_REST[@]}\"}\"\n    fi\n    # --auto starts every OpenCode session in full auto mode (no per-tool\n    # confirmation, e.g. \"can I run this python script?\"). Safe in this context\n    # because manigot launches an isolated, ephemeral container specifically for\n    # this purpose; the brief explicitly wants OpenCode to start in auto mode,\n    # mirroring the claude-code branch's --dangerously-skip-permissions below.\n    # Placed before \"$@\" so it composes with the passthrough (--agent <name>,\n    # --prompt <text> and/or the positional job prompt).\n    exec opencode --auto \"$@\"\nelse\n    # --dangerously-skip-permissions starts every Claude Code session in full\n    # auto mode (no per-tool-call confirmation). Safe in this context because\n    # manigot launches an isolated, ephemeral container specifically for this\n    # purpose; the brief explicitly wants Claude Code to start in auto mode.\n    # Placed before \"$@\" so it composes with the passthrough (--agent <name>\n    # and/or the positional job prompt).\n    if [[ \"${MANIGOT_PRINT:-false}\" == \"true\" ]]; then\n        # Non-interactive, one-shot mode (run.sh's --print flag, e.g. for\n        # mg-jdi): no attached terminal, so the caller gets the agent's\n        # output back on stdout instead. --verbose --output-format\n        # stream-json emits a step-level JSONL event stream — system /\n        # assistant / user / result events, one object per line — whose\n        # final \"result\" event's \"result\" field carries the final response\n        # text. That is strictly more than the old single-result json form:\n        # the full stream is what mg-jdi streams live into the job's\n        # session.log (see jdioutput.go's openSessionLog), not just the final\n        # answer.\n        # --verbose is required: claude rejects stream-json under --print\n        # without it (\"--output-format=stream-json requires --verbose\"),\n        # verified against the installed version (2.1.247). Stream-json has\n        # been more version-volatile than the stable single-result shape, so\n        # internal/orchestrate keeps the plain result parse as a defensive\n        # fallback (see signal.go). Parsing the stream — instead of scanning\n        # raw combined stdout — also keeps the marker text (see\n        # docs/AGENTS.md) from false-positiving when it appears incidentally\n        # inside a tool call's own output (e.g. a grep result).\n        exec claude --dangerously-skip-permissions --print --verbose --output-format stream-json \"$@\"\n    fi\n    exec claude --dangerously-skip-permissions \"$@\"\nfi","numLines":357,"startLine":1,"totalLines":357}}}
