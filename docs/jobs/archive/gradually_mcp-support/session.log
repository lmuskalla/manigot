{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PkugTRJS3TbU3q3evNa3zb","type":"tool_result","content":"1\tpackage session\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"strings\"\n8\t\n9\t\t\"github.com/lmuskalla/manigot/internal/fs\"\n10\t\t\"github.com/lmuskalla/manigot/internal/git\"\n11\t\t\"github.com/lmuskalla/manigot/internal/job\"\n12\t)\n13\t\n14\t// Root holds the resolved project-root state (run.sh's PROJECT_ROOT /\n15\t// DOCS_INITIALIZED / INVOCATION_ROOT / GIT_COMMON_DIR block).\n16\ttype Root struct {\n17\t\t// ProjectRoot is the mount root: the project root, or the job's own\n18\t\t// worktree path once --job has resolved one.\n19\t\tProjectRoot string\n20\t\n21\t\t// InvocationRoot is the original project root, captured before any --job\n22\t\t// reassignment — used for the banner's \"Project\" line and the container\n23\t\t// name.\n24\t\tInvocationRoot string\n25\t\n26\t\t// DocsInitialized reports whether a docs/ directory was found (the walk-up\n27\t\t// gate that marks an initialized project).\n28\t\tDocsInitialized bool\n29\t\n30\t\t// DocsDir is PROJECT_ROOT/docs (only meaningful when DocsInitialized).\n31\t\tDocsDir string\n32\t\n33\t\t// Job is the resolved job name (\"\" when no --job was given). For the\n34\t\t// worktree path this is the branch's id_slug tail segment; for the\n35\t\t// no-branches fallback, the matched directory's basename.\n36\t\tJob string\n37\t\n38\t\t// GitCommonDir is the main repo's git dir for a job worktree mount (\"\" for\n39\t\t// a plain session, where the project's own .git is already mounted).\n40\t\tGitCommonDir string\n41\t}\n42\t\n43\t// ResolveRoot implements run.sh's root resolution and --job worktree\n44\t// resolution, walking up from the process working\n45\t// directory. The docs walk-up reuses job.FindProjectRoot (the same logic the\n46\t// TUI uses); the --job branch scan reuses git.LocalBranches and\n47\t// git.WorktreeForBranch rather than re-implementing them. Every error's\n48\t// wording matches the script's.\n49\tfunc ResolveRoot(opts Options) (Root, error) {\n50\t\tdir, err := os.Getwd()\n51\t\tif err != nil {\n52\t\t\treturn Root{}, fmt.Errorf(\"cannot read working directory: %w\", err)\n53\t\t}\n54\t\treturn ResolveRootFrom(opts, dir)\n55\t}\n56\t\n57\t// ResolveRootFrom is ResolveRoot's parameterized form: it walks up from\n58\t// startDir instead of the process cwd. mg-jdi's --print invocations resolve\n59\t// against the project it was started in, the same way run.sh used $PWD.\n60\tfunc ResolveRootFrom(opts Options, startDir string) (Root, error) {\n61\t\troot, err := job.FindProjectRootFrom(startDir)\n62\t\tif err != nil {\n63\t\t\treturn Root{}, fmt.Errorf(\"cannot read working directory: %w\", err)\n64\t\t}\n65\t\n66\t\tr := Root{DocsInitialized: root != \"\"}\n67\t\tif root == \"\" {\n68\t\t\t// No docs/: the container boundary falls back to the git root, else\n69\t\t\t// $PWD — a plain session, no project context or job workflow.\n70\t\t\ttoplevel, terr := git.RevParseToplevel(\".\")\n71\t\t\tif terr == nil {\n72\t\t\t\troot = toplevel\n73\t\t\t} else {\n74\t\t\t\tcwd, err := os.Getwd()\n75\t\t\t\tif err != nil {\n76\t\t\t\t\treturn Root{}, fmt.Errorf(\"cannot read working directory: %w\", err)\n77\t\t\t\t}\n78\t\t\t\troot = cwd\n79\t\t\t}\n80\t\t}\n81\t\troot = filepath.Clean(root)\n82\t\tr.ProjectRoot = root\n83\t\tr.InvocationRoot = root\n84\t\tr.DocsDir = filepath.Join(root, \"docs\")\n85\t\n86\t\tif opts.Job == \"\" {\n87\t\t\t// Plain session: the resolved root is the worktree the container will\n88\t\t\t// mount docs/ into, so keep git from ever tracking the mount target\n89\t\t\t// path (.opencode/.claude) in it — an agent staging job files through\n90\t\t\t// the mount would otherwise commit a stale duplicate of docs/ (see\n91\t\t\t// docs/BUG_report-mg-done-dirty-worktree-stale-job-copy.md).\n92\t\t\tif err := git.ExcludeMountTargets(r.ProjectRoot); err != nil {\n93\t\t\t\treturn Root{}, err\n94\t\t\t}\n95\t\t\treturn r, nil\n96\t\t}\n97\t\tif !r.DocsInitialized {\n98\t\t\treturn Root{}, fmt.Errorf(\"--job requires an initialized project (no docs/ found).\\nSee 'Per-project setup' in the manigot README, then 'mg job' to create one.\")\n99\t\t}\n100\t\n101\t\tbranches, berr := git.LocalBranches(root)\n102\t\tif berr != nil || len(branches) == 0 {\n103\t\t\t// Non-git / no-branches fallback: no worktrees are possible, so the\n104\t\t\t// job's files live directly in PROJECT_ROOT/docs/jobs/. Exact match\n105\t\t\t// first, then a prefix scan of the directory names, excluding archive/.\n106\t\t\tjobDir := filepath.Join(root, \"docs\", \"jobs\", opts.Job)\n107\t\t\tif fs.IsDir(jobDir) {\n108\t\t\t\tr.Job = opts.Job\n109\t\t\t} else {\n110\t\t\t\tmatch := job.PrefixJobDirName(root, opts.Job)\n111\t\t\t\tif match == \"\" {\n112\t\t\t\t\treturn Root{}, fmt.Errorf(\"job '%s' not found under docs/jobs/\", opts.Job)\n113\t\t\t\t}\n114\t\t\t\tr.Job = match\n115\t\t\t}\n116\t\t\tif err := git.ExcludeMountTargets(r.ProjectRoot); err != nil {\n117\t\t\t\treturn Root{}, err\n118\t\t\t}\n119\t\t\treturn r, nil\n120\t\t}\n121\t\n122\t\t// A job's branch embeds its id_slug as the tail segment: exact match\n123\t\t// first, then a prefix match, with an ambiguity error for multiple hits.\n124\t\tbranch := git.ExactBranchMatch(branches, opts.Job)\n125\t\tif branch == \"\" {\n126\t\t\tprefixMatches := git.PrefixBranchMatches(branches, opts.Job)\n127\t\t\tswitch len(prefixMatches) {\n128\t\t\tcase 0:\n129\t\t\t\treturn Root{}, fmt.Errorf(\"job '%s' not found among local branches.\", opts.Job)\n130\t\t\tcase 1:\n131\t\t\t\tbranch = prefixMatches[0]\n132\t\t\tdefault:\n133\t\t\t\treturn Root{}, fmt.Errorf(\"job '%s' is ambiguous — matches branches: %s\", opts.Job, strings.Join(prefixMatches, \" \"))\n134\t\t\t}\n135\t\t}\n136\t\n137\t\twtPath, ok, werr := git.WorktreeForBranch(root, branch)\n138\t\tif werr != nil {\n139\t\t\treturn Root{}, fmt.Errorf(\"git worktree lookup for branch '%s': %w\", branch, werr)\n140\t\t}\n141\t\tif !ok {\n142\t\t\t// A branch match with no registered worktree is a hard error — never\n143\t\t\t// silently fall back to PROJECT_ROOT, which would show the wrong job's\n144\t\t\t// content.\n145\t\t\treturn Root{}, fmt.Errorf(\"branch '%s' has no git worktree.\\nA job's worktree is created by 'mg job' and should always exist for an open job — this is an inconsistent state (worktree creation may have failed, or the worktree was removed by hand).\\nRefusing to fall back to mounting %s instead: that would show the wrong job's content.\", branch, root)\n146\t\t}\n147\t\n148\t\tr.Job = git.BranchTail(branch)\n149\t\tr.ProjectRoot = filepath.Clean(wtPath)\n150\t\tr.DocsDir = filepath.Join(r.ProjectRoot, \"docs\")\n151\t\tr.GitCommonDir = git.GitCommonDir(r.ProjectRoot)\n152\t\t// Defensive consistency check: the resolved worktree must actually carry\n153\t\t// the job directory (new-job.sh always creates it alongside the worktree).\n154\t\tif !fs.IsDir(filepath.Join(r.ProjectRoot, \"docs\", \"jobs\", r.Job)) {\n155\t\t\treturn Root{}, fmt.Errorf(\"resolved job worktree at %s has no docs/jobs/%s directory — inconsistent worktree state.\", r.ProjectRoot, r.Job)\n156\t\t}\n157\t\t// Same exclusion as the plain-session path: the container mounts docs/\n158\t\t// into this worktree at the colliding repo path, so git must never track\n159\t\t// it (see the plain-session comment above).\n160\t\tif err := git.ExcludeMountTargets(r.ProjectRoot); err != nil {\n161\t\t\treturn Root{}, err\n162\t\t}\n163\t\treturn r, nil\n164\t}\n165\t"}]},"parent_tool_use_id":null,"session_id":"4e2afcf5-7fc0-4a90-a6a6-e82e43a08449","uuid":"004dd805-452a-4041-84ce-9ebe6859b18b","timestamp":"2026-08-31T13:46:18.122Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/session/root.go","content":"package session\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/fs\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// Root holds the resolved project-root state (run.sh's PROJECT_ROOT /\n// DOCS_INITIALIZED / INVOCATION_ROOT / GIT_COMMON_DIR block).\ntype Root struct {\n\t// ProjectRoot is the mount root: the project root, or the job's own\n\t// worktree path once --job has resolved one.\n\tProjectRoot string\n\n\t// InvocationRoot is the original project root, captured before any --job\n\t// reassignment — used for the banner's \"Project\" line and the container\n\t// name.\n\tInvocationRoot string\n\n\t// DocsInitialized reports whether a docs/ directory was found (the walk-up\n\t// gate that marks an initialized project).\n\tDocsInitialized bool\n\n\t// DocsDir is PROJECT_ROOT/docs (only meaningful when DocsInitialized).\n\tDocsDir string\n\n\t// Job is the resolved job name (\"\" when no --job was given). For the\n\t// worktree path this is the branch's id_slug tail segment; for the\n\t// no-branches fallback, the matched directory's basename.\n\tJob string\n\n\t// GitCommonDir is the main repo's git dir for a job worktree mount (\"\" for\n\t// a plain session, where the project's own .git is already mounted).\n\tGitCommonDir string\n}\n\n// ResolveRoot implements run.sh's root resolution and --job worktree\n// resolution, walking up from the process working\n// directory. The docs walk-up reuses job.FindProjectRoot (the same logic the\n// TUI uses); the --job branch scan reuses git.LocalBranches and\n// git.WorktreeForBranch rather than re-implementing them. Every error's\n// wording matches the script's.\nfunc ResolveRoot(opts Options) (Root, error) {\n\tdir, err := os.Getwd()\n\tif err != nil {\n\t\treturn Root{}, fmt.Errorf(\"cannot read working directory: %w\", err)\n\t}\n\treturn ResolveRootFrom(opts, dir)\n}\n\n// ResolveRootFrom is ResolveRoot's parameterized form: it walks up from\n// startDir instead of the process cwd. mg-jdi's --print invocations resolve\n// against the project it was started in, the same way run.sh used $PWD.\nfunc ResolveRootFrom(opts Options, startDir string) (Root, error) {\n\troot, err := job.FindProjectRootFrom(startDir)\n\tif err != nil {\n\t\treturn Root{}, fmt.Errorf(\"cannot read working directory: %w\", err)\n\t}\n\n\tr := Root{DocsInitialized: root != \"\"}\n\tif root == \"\" {\n\t\t// No docs/: the container boundary falls back to the git root, else\n\t\t// $PWD — a plain session, no project context or job workflow.\n\t\ttoplevel, terr := git.RevParseToplevel(\".\")\n\t\tif terr == nil {\n\t\t\troot = toplevel\n\t\t} else {\n\t\t\tcwd, err := os.Getwd()\n\t\t\tif err != nil {\n\t\t\t\treturn Root{}, fmt.Errorf(\"cannot read working directory: %w\", err)\n\t\t\t}\n\t\t\troot = cwd\n\t\t}\n\t}\n\troot = filepath.Clean(root)\n\tr.ProjectRoot = root\n\tr.InvocationRoot = root\n\tr.DocsDir = filepath.Join(root, \"docs\")\n\n\tif opts.Job == \"\" {\n\t\t// Plain session: the resolved root is the worktree the container will\n\t\t// mount docs/ into, so keep git from ever tracking the mount target\n\t\t// path (.opencode/.claude) in it — an agent staging job files through\n\t\t// the mount would otherwise commit a stale duplicate of docs/ (see\n\t\t// docs/BUG_report-mg-done-dirty-worktree-stale-job-copy.md).\n\t\tif err := git.ExcludeMountTargets(r.ProjectRoot); err != nil {\n\t\t\treturn Root{}, err\n\t\t}\n\t\treturn r, nil\n\t}\n\tif !r.DocsInitialized {\n\t\treturn Root{}, fmt.Errorf(\"--job requires an initialized project (no docs/ found).\\nSee 'Per-project setup' in the manigot README, then 'mg job' to create one.\")\n\t}\n\n\tbranches, berr := git.LocalBranches(root)\n\tif berr != nil || len(branches) == 0 {\n\t\t// Non-git / no-branches fallback: no worktrees are possible, so the\n\t\t// job's files live directly in PROJECT_ROOT/docs/jobs/. Exact match\n\t\t// first, then a prefix scan of the directory names, excluding archive/.\n\t\tjobDir := filepath.Join(root, \"docs\", \"jobs\", opts.Job)\n\t\tif fs.IsDir(jobDir) {\n\t\t\tr.Job = opts.Job\n\t\t} else {\n\t\t\tmatch := job.PrefixJobDirName(root, opts.Job)\n\t\t\tif match == \"\" {\n\t\t\t\treturn Root{}, fmt.Errorf(\"job '%s' not found under docs/jobs/\", opts.Job)\n\t\t\t}\n\t\t\tr.Job = match\n\t\t}\n\t\tif err := git.ExcludeMountTargets(r.ProjectRoot); err != nil {\n\t\t\treturn Root{}, err\n\t\t}\n\t\treturn r, nil\n\t}\n\n\t// A job's branch embeds its id_slug as the tail segment: exact match\n\t// first, then a prefix match, with an ambiguity error for multiple hits.\n\tbranch := git.ExactBranchMatch(branches, opts.Job)\n\tif branch == \"\" {\n\t\tprefixMatches := git.PrefixBranchMatches(branches, opts.Job)\n\t\tswitch len(prefixMatches) {\n\t\tcase 0:\n\t\t\treturn Root{}, fmt.Errorf(\"job '%s' not found among local branches.\", opts.Job)\n\t\tcase 1:\n\t\t\tbranch = prefixMatches[0]\n\t\tdefault:\n\t\t\treturn Root{}, fmt.Errorf(\"job '%s' is ambiguous — matches branches: %s\", opts.Job, strings.Join(prefixMatches, \" \"))\n\t\t}\n\t}\n\n\twtPath, ok, werr := git.WorktreeForBranch(root, branch)\n\tif werr != nil {\n\t\treturn Root{}, fmt.Errorf(\"git worktree lookup for branch '%s': %w\", branch, werr)\n\t}\n\tif !ok {\n\t\t// A branch match with no registered worktree is a hard error — never\n\t\t// silently fall back to PROJECT_ROOT, which would show the wrong job's\n\t\t// content.\n\t\treturn Root{}, fmt.Errorf(\"branch '%s' has no git worktree.\\nA job's worktree is created by 'mg job' and should always exist for an open job — this is an inconsistent state (worktree creation may have failed, or the worktree was removed by hand).\\nRefusing to fall back to mounting %s instead: that would show the wrong job's content.\", branch, root)\n\t}\n\n\tr.Job = git.BranchTail(branch)\n\tr.ProjectRoot = filepath.Clean(wtPath)\n\tr.DocsDir = filepath.Join(r.ProjectRoot, \"docs\")\n\tr.GitCommonDir = git.GitCommonDir(r.ProjectRoot)\n\t// Defensive consistency check: the resolved worktree must actually carry\n\t// the job directory (new-job.sh always creates it alongside the worktree).\n\tif !fs.IsDir(filepath.Join(r.ProjectRoot, \"docs\", \"jobs\", r.Job)) {\n\t\treturn Root{}, fmt.Errorf(\"resolved job worktree at %s has no docs/jobs/%s directory — inconsistent worktree state.\", r.ProjectRoot, r.Job)\n\t}\n\t// Same exclusion as the plain-session path: the container mounts docs/\n\t// into this worktree at the colliding repo path, so git must never track\n\t// it (see the plain-session comment above).\n\tif err := git.ExcludeMountTargets(r.ProjectRoot); err != nil {\n\t\treturn Root{}, err\n\t}\n\treturn r, nil\n}\n","numLines":165,"startLine":1,"totalLines":165}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MufDjXk2GkoDM6Rs6d78Ub","type":"tool_result","content":"1\tpackage session\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"fmt\"\n6\t\t\"io\"\n7\t\t\"path/filepath\"\n8\t\t\"strings\"\n9\t\n10\t\t\"github.com/lmuskalla/manigot/internal/job\"\n11\t)\n12\t\n13\t// AgentRunner runs one non-interactive agent invocation for job j and\n14\t// returns its captured raw output. live receives the exact same bytes as\n15\t// they arrive, so a caller can tee them into a live log. Mirrors cmd/mg/\n16\t// jdi.go's own AgentRunner interface — that package cannot be imported here\n17\t// (cmd/mg already depends on internal/session, not the other way around),\n18\t// so the shape is duplicated rather than shared; CommandAgentRunner below is\n19\t// this package's own concrete implementation, independent of cmd/mg's\n20\t// private commandAgentRunner.\n21\ttype AgentRunner interface {\n22\t\tRun(agent string, j job.Job, live io.Writer) ([]byte, error)\n23\t}\n24\t\n25\t// CommandAgentRunner is the real AgentRunner for callers outside mg-jdi\n26\t// (internal/serve's detached one-shot agent launch, today): a single --print\n27\t// invocation via this package's own ResolveProfile → ResolveRootFrom →\n28\t// CheckAuth → BuildDockerInvocation → DockerInvocation.Run path, ending with\n29\t// the same post-run worktree sweep (SweepJobWorktree) mg-jdi's own runner\n30\t// performs so nothing an agent (or this invocation's own session.log\n31\t// section) left uncommitted lingers in the job's worktree.\n32\ttype CommandAgentRunner struct {\n33\t\t// ProjectRoot is where --job resolution starts from (mirrors\n34\t\t// cmd/mg/jdi.go's commandAgentRunner.projectRoot).\n35\t\tProjectRoot string\n36\t\t// Profile is the subscription profile every invocation runs under.\n37\t\tProfile string\n38\t}\n39\t\n40\t// Run invokes the session launcher's --print path synchronously and returns\n41\t// its captured stdout. live receives the exact same bytes as they arrive —\n42\t// the io.MultiWriter tee that lets a caller grow a live log during the\n43\t// invocation. j.Name (the exact job directory name) is passed rather than\n44\t// j.ID to remove any ambiguity in the --job resolution.\n45\tfunc (r *CommandAgentRunner) Run(agent string, j job.Job, live io.Writer) ([]byte, error) {\n46\t\topts := Options{Print: true, Profile: r.Profile, Agent: agent, Job: j.Name}\n47\t\tinfo, err := ResolveProfile(opts)\n48\t\tif err != nil {\n49\t\t\treturn nil, err\n50\t\t}\n51\t\troot, err := ResolveRootFrom(opts, r.ProjectRoot)\n52\t\tif err != nil {\n53\t\t\treturn nil, err\n54\t\t}\n55\t\tif err := info.CheckAuth(); err != nil {\n56\t\t\treturn nil, err\n57\t\t}\n58\t\n59\t\tvar diag bytes.Buffer\n60\t\tinv, err := BuildDockerInvocation(opts, info, root, false, &diag)\n61\t\tif err != nil {\n62\t\t\treturn nil, err\n63\t\t}\n64\t\n65\t\t// Prune orphaned manigot containers before the run — the same fail-soft\n66\t\t// self-healing cleanup as every other launch path. A prune failure never\n67\t\t// aborts the invocation.\n68\t\tif _, err := PruneOrphans(&diag); err != nil {\n69\t\t\tfmt.Fprintf(&diag, \"mg: warning: could not prune orphaned containers: %v\\n\", err)\n70\t\t}\n71\t\n72\t\tvar stdout bytes.Buffer\n73\t\t// No interactive stdin: this runner is only ever used for a detached,\n74\t\t// one-shot --print invocation with nobody at a terminal to type into it.\n75\t\tcode, ran := inv.Run(nil, io.MultiWriter(&stdout, live), &diag)\n76\t\t// Same host-side sweep as every other --print invocation: commits\n77\t\t// whatever the agent (and this invocation's own session.log section) left\n78\t\t// uncommitted. Sweep only when the container actually ran.\n79\t\tif ran {\n80\t\t\tSweepJobWorktree(root, &diag)\n81\t\t}\n82\t\tif code != 0 {\n83\t\t\treturn stdout.Bytes(), fmt.Errorf(\"mg --print --agent %s --job %s: exit code %d: %s\", agent, j.Name, code, strings.TrimSpace(diag.String()))\n84\t\t}\n85\t\treturn stdout.Bytes(), nil\n86\t}\n87\t\n88\t// RunOneShot runs one agent invocation for job j via runner, opening a\n89\t// job.OpenSessionLog section (attempt fixed at 1 — this is not part of an\n90\t// mg-jdi run, so there is no per-agent attempt counter to thread through)\n91\t// before the invocation and closing it after, tee-ing the invocation's raw\n92\t// output into it live exactly as mg-jdi's own loop does.\n93\t//\n94\t// It is meant to be started in its own goroutine by an HTTP handler that\n95\t// returns immediately instead of blocking for the invocation's full duration\n96\t// (see internal/serve's detached agent-launch endpoint) — the goroutine's\n97\t// own errors have nowhere to report back to an already-returned HTTP\n98\t// response, so RunOneShot writes a failure into the same session.log section\n99\t// rather than dropping it silently, in addition to returning it (for a\n100\t// caller — chiefly a test — that runs it synchronously and wants the error\n101\t// directly).\n102\t//\n103\t// A failure to even open the session.log is best-effort, matching mg-jdi's\n104\t// own loop: the invocation still runs (with live output simply discarded),\n105\t// and only the open failure itself is returned/reported.\n106\t//\n107\t// KNOWN LIMITATION (documented, not solved here — see the brief's own\n108\t// callout): a concurrently-running mg-jdi loop against the SAME job would\n109\t// also be writing to the same session.log file at the same time. That is\n110\t// safe against file corruption — both are append-only,\n111\t// single-writer-per-section — but the underlying git worktree itself would\n112\t// have two independent processes touching it (container invocations,\n113\t// worktree sweeps), which this function does not detect or prevent.\n114\tfunc RunOneShot(runner AgentRunner, agent string, j job.Job) error {\n115\t\tsess, sessErr := job.OpenSessionLog(filepath.Join(j.Dir, \"session.log\"), agent, 1)\n116\t\tvar live io.Writer = io.Discard\n117\t\tif sess != nil {\n118\t\t\tlive = sess\n119\t\t}\n120\t\n121\t\t_, runErr := runner.Run(agent, j, live)\n122\t\n123\t\tif runErr != nil && sess != nil {\n124\t\t\tfmt.Fprintf(sess, \"\\nmg serve: agent invocation failed: %v\\n\", runErr)\n125\t\t}\n126\t\tif sess != nil {\n127\t\t\tif cerr := sess.Close(); cerr != nil && runErr == nil {\n128\t\t\t\trunErr = fmt.Errorf(\"could not finalize session log: %w\", cerr)\n129\t\t\t}\n130\t\t}\n131\t\tif runErr != nil {\n132\t\t\treturn runErr\n133\t\t}\n134\t\tif sessErr != nil {\n135\t\t\treturn fmt.Errorf(\"could not open session log: %w\", sessErr)\n136\t\t}\n137\t\treturn nil\n138\t}\n139\t"}]},"parent_tool_use_id":null,"session_id":"4e2afcf5-7fc0-4a90-a6a6-e82e43a08449","uuid":"a90a3df0-0cdd-4e41-b7f2-af58f21465f7","timestamp":"2026-08-31T13:46:18.124Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/session/oneshot.go","content":"package session\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"io\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// AgentRunner runs one non-interactive agent invocation for job j and\n// returns its captured raw output. live receives the exact same bytes as\n// they arrive, so a caller can tee them into a live log. Mirrors cmd/mg/\n// jdi.go's own AgentRunner interface — that package cannot be imported here\n// (cmd/mg already depends on internal/session, not the other way around),\n// so the shape is duplicated rather than shared; CommandAgentRunner below is\n// this package's own concrete implementation, independent of cmd/mg's\n// private commandAgentRunner.\ntype AgentRunner interface {\n\tRun(agent string, j job.Job, live io.Writer) ([]byte, error)\n}\n\n// CommandAgentRunner is the real AgentRunner for callers outside mg-jdi\n// (internal/serve's detached one-shot agent launch, today): a single --print\n// invocation via this package's own ResolveProfile → ResolveRootFrom →\n// CheckAuth → BuildDockerInvocation → DockerInvocation.Run path, ending with\n// the same post-run worktree sweep (SweepJobWorktree) mg-jdi's own runner\n// performs so nothing an agent (or this invocation's own session.log\n// section) left uncommitted lingers in the job's worktree.\ntype CommandAgentRunner struct {\n\t// ProjectRoot is where --job resolution starts from (mirrors\n\t// cmd/mg/jdi.go's commandAgentRunner.projectRoot).\n\tProjectRoot string\n\t// Profile is the subscription profile every invocation runs under.\n\tProfile string\n}\n\n// Run invokes the session launcher's --print path synchronously and returns\n// its captured stdout. live receives the exact same bytes as they arrive —\n// the io.MultiWriter tee that lets a caller grow a live log during the\n// invocation. j.Name (the exact job directory name) is passed rather than\n// j.ID to remove any ambiguity in the --job resolution.\nfunc (r *CommandAgentRunner) Run(agent string, j job.Job, live io.Writer) ([]byte, error) {\n\topts := Options{Print: true, Profile: r.Profile, Agent: agent, Job: j.Name}\n\tinfo, err := ResolveProfile(opts)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\troot, err := ResolveRootFrom(opts, r.ProjectRoot)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif err := info.CheckAuth(); err != nil {\n\t\treturn nil, err\n\t}\n\n\tvar diag bytes.Buffer\n\tinv, err := BuildDockerInvocation(opts, info, root, false, &diag)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\t// Prune orphaned manigot containers before the run — the same fail-soft\n\t// self-healing cleanup as every other launch path. A prune failure never\n\t// aborts the invocation.\n\tif _, err := PruneOrphans(&diag); err != nil {\n\t\tfmt.Fprintf(&diag, \"mg: warning: could not prune orphaned containers: %v\\n\", err)\n\t}\n\n\tvar stdout bytes.Buffer\n\t// No interactive stdin: this runner is only ever used for a detached,\n\t// one-shot --print invocation with nobody at a terminal to type into it.\n\tcode, ran := inv.Run(nil, io.MultiWriter(&stdout, live), &diag)\n\t// Same host-side sweep as every other --print invocation: commits\n\t// whatever the agent (and this invocation's own session.log section) left\n\t// uncommitted. Sweep only when the container actually ran.\n\tif ran {\n\t\tSweepJobWorktree(root, &diag)\n\t}\n\tif code != 0 {\n\t\treturn stdout.Bytes(), fmt.Errorf(\"mg --print --agent %s --job %s: exit code %d: %s\", agent, j.Name, code, strings.TrimSpace(diag.String()))\n\t}\n\treturn stdout.Bytes(), nil\n}\n\n// RunOneShot runs one agent invocation for job j via runner, opening a\n// job.OpenSessionLog section (attempt fixed at 1 — this is not part of an\n// mg-jdi run, so there is no per-agent attempt counter to thread through)\n// before the invocation and closing it after, tee-ing the invocation's raw\n// output into it live exactly as mg-jdi's own loop does.\n//\n// It is meant to be started in its own goroutine by an HTTP handler that\n// returns immediately instead of blocking for the invocation's full duration\n// (see internal/serve's detached agent-launch endpoint) — the goroutine's\n// own errors have nowhere to report back to an already-returned HTTP\n// response, so RunOneShot writes a failure into the same session.log section\n// rather than dropping it silently, in addition to returning it (for a\n// caller — chiefly a test — that runs it synchronously and wants the error\n// directly).\n//\n// A failure to even open the session.log is best-effort, matching mg-jdi's\n// own loop: the invocation still runs (with live output simply discarded),\n// and only the open failure itself is returned/reported.\n//\n// KNOWN LIMITATION (documented, not solved here — see the brief's own\n// callout): a concurrently-running mg-jdi loop against the SAME job would\n// also be writing to the same session.log file at the same time. That is\n// safe against file corruption — both are append-only,\n// single-writer-per-section — but the underlying git worktree itself would\n// have two independent processes touching it (container invocations,\n// worktree sweeps), which this function does not detect or prevent.\nfunc RunOneShot(runner AgentRunner, agent string, j job.Job) error {\n\tsess, sessErr := job.OpenSessionLog(filepath.Join(j.Dir, \"session.log\"), agent, 1)\n\tvar live io.Writer = io.Discard\n\tif sess != nil {\n\t\tlive = sess\n\t}\n\n\t_, runErr := runner.Run(agent, j, live)\n\n\tif runErr != nil && sess != nil {\n\t\tfmt.Fprintf(sess, \"\\nmg serve: agent invocation failed: %v\\n\", runErr)\n\t}\n\tif sess != nil {\n\t\tif cerr := sess.Close(); cerr != nil && runErr == nil {\n\t\t\trunErr = fmt.Errorf(\"could not finalize session log: %w\", cerr)\n\t\t}\n\t}\n\tif runErr != nil {\n\t\treturn runErr\n\t}\n\tif sessErr != nil {\n\t\treturn fmt.Errorf(\"could not open session log: %w\", sessErr)\n\t}\n\treturn nil\n}\n","numLines":139,"startLine":1,"totalLines":139}}}
