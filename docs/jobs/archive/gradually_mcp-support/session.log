9\t\tif err := info2.CheckAuth(); err != nil {\n880\t\t\tt.Fatalf(\"CheckAuth: %v\", err)\n881\t\t}\n882\t\tr2, err := ResolveRoot(Options{})\n883\t\tif err != nil {\n884\t\t\tt.Fatalf(\"ResolveRoot: %v\", err)\n885\t\t}\n886\t\tinv2, err := BuildDockerInvocation(Options{}, info2, r2, false, &strings.Builder{})\n887\t\tif err != nil {\n888\t\t\tt.Fatalf(\"BuildDockerInvocation: %v\", err)\n889\t\t}\n890\t\tjoined2 := strings.Join(inv2.Argv, \"\\n\")\n891\t\tif strings.Contains(joined2, \"/home/claude/.config/opencode/AGENTS.md\") {\n892\t\t\tt.Errorf(\"opencode invocation must not mount the global meta when prompts/meta.md is absent:\\n%s\", joined2)\n893\t\t}\n894\t}\n895\t\n896\t// writeMeta writes a prompts/meta.md in the checkout, creating the dir/file.\n897\tfunc writeMeta(t *testing.T, dir, content string) {\n898\t\tt.Helper()\n899\t\tif err := os.MkdirAll(filepath.Join(dir, \"prompts\"), 0o755); err != nil {\n900\t\t\tt.Fatal(err)\n901\t\t}\n902\t\tif err := os.WriteFile(filepath.Join(dir, \"prompts\", \"meta.md\"), []byte(content), 0o644); err != nil {\n903\t\t\tt.Fatal(err)\n904\t\t}\n905\t}\n906\t\n907\t// TestBuildProjectSkillsRideDocsMount: project skills (docs/skills/) need no\n908\t// staging or shadow mount — the docs bind mount maps the whole docs/ dir, so\n909\t// docs/skills/ already lands at the project skills location inside the\n910\t// container (/workspace/.claude/skills for Claude Code,\n911\t// /workspace/.opencode/skills for OpenCode), where both CLIs natively prefer a\n912\t// project skill over a global one of the same name. The pin: the invocation\n913\t// carries the plain docs mount (which carries docs/skills/) and no separate\n914\t// skills mount.\n915\tfunc TestBuildProjectSkillsRideDocsMount(t *testing.T) {\n916\t\t// Claude Code: docs/skills/ rides the docs mount at /workspace/.claude.\n917\t\troot, _ := docProject(t)\n918\t\twriteSkill(t, filepath.Join(root, \"docs\"), \"mine\", map[string]string{\"SKILL.md\": \"---\\nname: mine\