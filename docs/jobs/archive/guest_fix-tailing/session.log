{"type":"tool_use","timestamp":1787920076602,"sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","part":{"type":"tool","tool":"read","callID":"call_00_pAH56KJBTpvBjp9OXs4E7334","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/ui/app.go","offset":1214},"output":"<path>/workspace/src/internal/ui/app.go</path>\n<type>file</type>\n<content>\n1214: \t\tif st, running := a.jdiAlreadyRunning(a.detail.job); running {\n1215: \t\t\tlabel := \"mg jdi is already running for this job\"\n1216: \t\t\tif st.Agent != \"\" {\n1217: \t\t\t\tlabel += \" @\" + st.Agent\n1218: \t\t\t}\n1219: \t\t\ta.detail.setStatus(label)\n1220: \t\t\treturn a, a.armStatusExpiry()\n1221: \t\t}\n1222: \t\tif err := launch.Jdi(a.detail.job.ID, a.root, a.settings.ProfileValue()); err != nil {\n1223: \t\t\ta.detail.setStatus(cmdErrorText(err))\n1224: \t\t\treturn a, a.armStatusExpiry()\n1225: \t\t}\n1226: \t\t// Seed the stop-notification dedup as \"running\" right\n1227: \t\t// away rather than waiting for the first poll to discover it —\n1228: \t\t// otherwise a run that finishes before the next refresh would\n1229: \t\t// look like a first-ever observation of an already-stopped job\n1230: \t\t// and never ring.\n1231: \t\ta.jdiSeen[a.detail.job.Name] = job.JDIRunning\n1232: \t\ta.jdiSeenAt[a.detail.job.Name] = jdiNow()\n1233: \t\ta.detail.setStatus(\"→ mg jdi started in the background — see the log tab or list badge\")\n1234: \t\t// Start the activity-indicator tick chain so the just-launched run\n1235: \t\t// animates immediately — the sidecar doesn't exist yet, but the\n1236: \t\t// jdiSeen entry seeded above is enough for anyJDIRunning (via\n1237: \t\t// jdiAlreadyRunning's fallback). startSpinnerIfRunning is a no-op\n1238: \t\t// (nil cmd) when a chain is already going, batched with the status's\n1239: \t\t// own arming cmd (also nil when a chain is already going).\n1240: \t\treturn a, tea.Batch(a.startSpinnerIfRunning(), a.armStatusExpiry())\n1241: \tcase \"delete\", \"x\":\n1242: \t\t// Permanently delete the job. Bound to both the physical Delete/Entf\n1243: \t\t// key and \"x\": the forward-delete key's escape sequence (CSI 3~) is\n1244: \t\t// not decoded consistently across every terminal emulator/keyboard\n1245: \t\t// layout, so \"x\" (same mnemonic tmux/ranger use for a destructive\n1246: \t\t// remove) is a reliable fallback rather than a hidden alias — it's\n1247: \t\t// named in the footer hint too (see renderFooter). The destructive\n1248: \t\t// confirmation itself is the TUI-side confirm view (replacing\n1249: \t\t// delete-job.sh's subprocess prompt).\n1250: \t\ta.openConfirm(confirmDelete)\n1251: \t\treturn a, nil\n1252: \tcase \"P\":\n1253: \t\t// Push this job's branch to origin — the \"quick way to push feature\n1254: \t\t// branches\". git.Push\n1255: \t\t// pushes the named branch ref directly (git push origin <branch>),\n1256: \t\t// which does not require that branch to be checked out in the\n1257: \t\t// working tree.\n1258: \t\tif a.detail.job.Branch == \"\" {\n1259: \t\t\ta.detail.setStatus(\"no branch known for this job\")\n1260: \t\t\treturn a, a.armStatusExpiry()\n1261: \t\t}\n1262: \t\treturn a, a.pushCmd(a.detail.job.Branch)\n1263: \tcase \"t\":\n1264: \t\t// Open the job's branch diff in tig — a host-side TUI launched just\n1265: \t\t// like an agent session (tmux split pane / new terminal, see\n1266: \t\t// launch.Tig), not a background process like \"j\". The availability\n1267: \t\t// gate is cached on the detail view at open time (tigAvailable); the\n1268: \t\t// launch path re-checks it itself as an authoritative backstop, so a\n1269: \t\t// stale cached gate surfaces a synchronous error here rather than a\n1270: \t\t// doomed pane.\n1271: \t\tif !a.detail.tigAvailable {\n1272: \t\t\ta.detail.setStatus(\"tig is not installed on the host — install it, or use the diff tab\")\n1273: \t\t\treturn a, a.armStatusExpiry()\n1274: \t\t}\n1275: \t\tif a.detail.job.Branch == \"\" {\n1276: \t\t\ta.detail.setStatus(\"no branch known for this job\")\n1277: \t\t\treturn a, a.armStatusExpiry()\n1278: \t\t}\n1279: \t\t// The job is passed by Name (id_slug), not ID: `mg diff` resolves the\n1280: \t\t// job's branch via an exact match on that tail segment (see launch.\n1281: \t\t// Tig's own doc), and there is no profile flag — mg diff is a host\n1282: \t\t// git command, not a session launch.\n1283: \t\tdesc, err := launch.Tig(a.detail.job.Name, a.root, a.settings.Terminal)\n1284: \t\tif err != nil {\n1285: \t\t\ta.detail.setStatus(cmdErrorText(err))\n1286: \t\t} else {\n1287: \t\t\ta.detail.setStatus(\"→ tig in \" + desc)\n1288: \t\t}\n1289: \t\treturn a, a.armStatusExpiry()\n1290: \tcase \"l\":\n1291: \t\t// Tail the job's mg-jdi run.log in a tmux split pane / new terminal —\n1292: \t\t// a live `tail -f` of the same sidecar the log tab (key 5) reads, so a\n1293: \t\t// user can watch the currently running agent's output grow without\n1294: \t\t// pressing ctrl+r. Like \"t\" it spawns a host-side pane (see\n1295: \t\t// launch.Tail), unlike \"j\" which stays background-only. Gated on a\n1296: \t\t// run.log existing for this job — the same condition under which the\n1297: \t\t// log tab shows real content — and deliberately with no branch guard\n1298: \t\t// (unlike \"t\"/\"P\"/\"c\"/\"g\"): the log sidecar is job-name-keyed, not\n1299: \t\t// branch-keyed, so a branch-less working-tree job can tail too.\n1300: \t\tif !a.detail.runLogExists() {\n1301: \t\t\ta.detail.setStatus(\"no mg jdi run has happened for this job yet\")\n1302: \t\t\treturn a, a.armStatusExpiry()\n1303: \t\t}\n1304: \t\t// The launch path takes the absolute run.log path directly — no\n1305: \t\t// mg-binary hop, no profile flag: `tail -f` is a plain host command.\n1306: \t\t// Same job.Root the gate just checked, so the two can never disagree.\n1307: \t\tdesc, err := launch.Tail(job.JDIRunLogPath(a.detail.job.Root, a.detail.job.Name), a.settings.Terminal)\n1308: \t\tif err != nil {\n1309: \t\t\ta.detail.setStatus(cmdErrorText(err))\n1310: \t\t} else {\n1311: \t\t\ta.detail.setStatus(\"→ tailing run.log in \" + desc)\n1312: \t\t}\n1313: \t\treturn a, a.armStatusExpiry()\n1314: \tcase \"c\":\n1315: \t\t// Commit all uncommitted changes in this job's worktree — a\n1316: \t\t// catch-all sweep for the files agents sometimes leave behind, which\n1317: \t\t// would otherwise trip mg done's clean-tree check. A host-side git\n1318: \t\t// action like \"P\", not an agent launch: the commit runs in the job's\n1319: \t\t// own worktree so it lands on the job branch (see commitAllCmd).\n1320: \t\tif a.detail.job.Branch == \"\" {\n1321: \t\t\ta.detail.setStatus(\"no branch known for this job\")\n1322: \t\t\treturn a, a.armStatusExpiry()\n1323: \t\t}\n1324: \t\treturn a, a.commitAllCmd()\n1325: \tcase \"g\":\n1326: \t\t// Open the git panel: the discoverable entry for the detail view's\n1327: \t\t// git commands (commit all / push to origin / merge default branch).\n1328: \t\t// \"g\" used to be the file viewer's scroll-to-top key (shared with\n1329: \t\t// \"home\"); the panel takes it over, and scroll-to-top stays\n1330: \t\t// reachable via \"home\" (see detail.go's scroll). The \"P\"/\"c\" direct\n1331: \t\t// accelerators stay bound too — the panel is the discoverable\n1332: \t\t// surface, not a removal of the old keys. Gated on the job having a\n1333: \t\t// branch like \"P\"/\"c\"/\"t\": every action in the panel targets the\n1334: \t\t// job's worktree branch.\n1335: \t\tif a.detail.job.Branch == \"\" {\n1336: \t\t\ta.detail.setStatus(\"no branch known for this job\")\n1337: \t\t\treturn a, a.armStatusExpiry()\n1338: \t\t}\n1339: \t\ta.gitPanel = newGitPanelView(a.width, a.height)\n1340: \t\ta.state = stateGitPanel\n1341: \t\treturn a, nil\n1342: \t}\n1343: \t// Action bar: fire the agent whose key matches, if it is valid for the\n1344: \t// current job's stage.\n1345: \tif agent := a.agentForKey(msg.String()); agent != \"\" {\n1346: \t\tdesc, err := launch.Agent(agent, a.detail.job.ID, a.root, a.settings.ProfileValue(), a.settings.Terminal)\n1347: \t\tif err != nil {\n1348: \t\t\ta.detail.setStatus(cmdErrorText(err))\n1349: \t\t} else {\n1350: \t\t\ta.detail.setStatus(\"→ \" + agent + \" in \" + desc)\n1351: \t\t}\n1352: \t\treturn a, a.armStatusExpiry()\n1353: \t}\n1354: \ta.detail.setStatus(\"\")\n1355: \ta.detail.update(msg)\n1356: \treturn a, nil\n1357: }\n1358: \n1359: // editCmd resolves an editor and returns the tea.Cmd that opens it on the\n1360: // active tab's file. tea.ExecProcess suspends the Bubble Tea renderer (unlike\n1361: // launch.Agent's detached new-window spawn) and runs the child in the same\n1362: // terminal, resuming the TUI once it exits; the result is delivered back as\n1363: // an editorDoneMsg. An error here means the editor itself could not be\n1364: // resolved (see editor.Resolve) — the caller surfaces it directly.\n1365: func (a *App) editCmd() (tea.Cmd, error) {\n1366: \tpath := a.detail.current().path\n1367: \tcmd, err := editor.Command(path, a.settings.Editor)\n1368: \tif err != nil {\n1369: \t\treturn nil, err\n1370: \t}\n1371: \treturn tea.ExecProcess(cmd, func(err error) tea.Msg {\n1372: \t\treturn editorDoneMsg{path: path, err: err}\n1373: \t}), nil\n1374: }\n1375: \n1376: // openConfirm switches to the confirmation view for the given action on the\n1377: // open job (called by the \"D\" / \"delete\" / \"x\" keys in the detail view).\n1378: func (a *App) openConfirm(action confirmAction) {\n1379: \ta.confirm = newConfirmView(action, a.root, a.detail.job)\n1380: \ta.confirm.resize(a.width, a.height)\n1381: \ta.state = stateConfirm\n1382: }\n1383: \n1384: // updateConfirm handles keys in the confirmation view: y/enter runs the\n1385: // confirmed lifecycle action in the background (a tea.Cmd goroutine), n/esc/q\n1386: // cancels back to the detail view.\n1387: func (a *App) updateConfirm(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n1388: \tswitch msg.String() {\n1389: \tcase \"y\", \"Y\", \"enter\":\n1390: \t\taction := a.confirm.action\n1391: \t\ta.confirm = nil\n1392: \t\ta.state = stateDetail\n1393: \t\tswitch action {\n1394: \t\tcase confirmDone:\n1395: \t\t\treturn a, a.runDoneCmd()\n1396: \t\tcase confirmDelete:\n1397: \t\t\treturn a, a.runDeleteCmd()\n1398: \t\t}\n1399: \tcase \"n\", \"N\", \"esc\", \"q\":\n1400: \t\ta.confirm = nil\n1401: \t\ta.state = stateDetail\n1402: \t}\n1403: \treturn a, nil\n1404: }\n1405: \n1406: // runDoneCmd runs job.FinishJob in the background and reports the outcome as\n1407: // a doneMsg. The user has already confirmed in the confirm view, so every\n1408: // internal prompt is pre-approved; informational output is discarded — the\n1409: // TUI renders its own status lines.\n1410: func (a *App) runDoneCmd() tea.Cmd {\n1411: \troot := a.root\n1412: \tjobName := a.detail.job.Name\n1413: \treturn func() tea.Msg {\n1414: \t\t_, err := job.FinishJob(root, jobName, yesConfirm, io.Discard)\n1415: \t\treturn doneMsg{err: err}\n1416: \t}\n1417: }\n1418: \n1419: // runDeleteCmd runs job.DeleteJob in the background and reports the outcome\n1420: // as a deleteMsg — the same pre-approved shape as runDoneCmd.\n1421: func (a *App) runDeleteCmd() tea.Cmd {\n1422: \troot := a.root\n1423: \tjobName := a.detail.job.Name\n1424: \treturn func() tea.Msg {\n1425: \t\t_, err := job.DeleteJob(root, jobName, yesConfirm, io.Discard)\n1426: \t\treturn deleteMsg{err: err}\n1427: \t}\n1428: }\n1429: \n1430: // yesConfirm pre-approves every lifecycle confirmation prompt — used once the\n1431: // user has already confirmed the action in the TUI's confirm view.\n1432: func yesConfirm(prompt string) (bool, error) { return true, nil }\n1433: \n1434: // pushCmd returns the tea.Cmd behind the \"P\" push-to-origin action: a plain\n1435: // git call off the UI goroutine — no interactive process, just a git push —\n1436: // and reports the outcome as a pushMsg once it returns. The call is bounded\n1437: // by a timeout (see hostGitTimeout) so a stalled network can't hang the TUI's\n1438: // command channel forever; the timeout surfaces as an ordinary pushMsg error.\n1439: func (a *App) pushCmd(branch string) tea.Cmd {\n1440: \troot := a.root\n1441: \treturn func() tea.Msg {\n1442: \t\tctx, cancel := context.WithTimeout(context.Background(), hostGitTimeout)\n1443: \t\tdefer cancel()\n1444: \t\terr := git.PushWithContext(ctx, root, branch)\n1445: \t\treturn pushMsg{branch: branch, err: err}\n1446: \t}\n1447: }\n1448: \n1449: // commitAllCmd returns the tea.Cmd behind the \"c\" commit-all action: a plain\n1450: // git call off the UI goroutine — no interactive process — staging every\n1451: // change in the job's own worktree (git add -A) and committing it, reporting\n1452: // the outcome as a commitAllMsg once it returns. The call is bounded by a\n1453: // timeout (see hostGitTimeout) so a stalled git can't hang the app's command\n1454: // channel forever.\n1455: //\n1456: // The commit runs inside the job's own worktree (git -C <job-worktree>), not\n1457: // a.root — the same reasoning commitBriefCmd documents: a job's files live in\n1458: // its own worktree, a sibling of the project root, so a pathspec relative to\n1459: // a.root would escape the main worktree (\"outside repository\"), and the\n1460: // commit must land on the *job branch*, not the base branch. The worktree\n1461: // root is derived from the job dir exactly as commitBriefCmd derives it: a\n1462: // job lives at <worktree>/docs/jobs/<id>_<slug>/, so two Dir() hops up lands\n1463: // on the worktree root. The message follows the shared \"[ID] <type>:\n1464: // <summary>\" convention with the fixed chore-type label \"commit all\" (a\n1465: // catch-all sweep commit is a chore regardless of the job's own type).\n1466: func (a *App) commitAllCmd() tea.Cmd {\n1467: \tworktreeRoot := filepath.Dir(filepath.Dir(a.detail.job.Dir))\n1468: \tid := a.detail.job.ID\n1469: \treturn func() tea.Msg {\n1470: \t\tctx, cancel := context.WithTimeout(context.Background(), hostGitTimeout)\n1471: \t\tdefer cancel()\n1472: \t\terr := git.CommitAllWithContext(ctx, worktreeRoot, fmt.Sprintf(\"[%s] chore: commit all\", id))\n1473: \t\treturn commitAllMsg{err: err}\n1474: \t}\n1475: }\n1476: \n1477: // mergeCmd returns the tea.Cmd behind the \"merge default branch\" action: a\n1478: // plain git call off the UI goroutine — no interactive process — merging the\n1479: // resolved base branch into the job's own worktree (git merge --no-edit\n1480: // <base>, see git.MergeBranch), reporting the outcome as a mergeMsg once it\n1481: // returns. The call is bounded by a timeout (see hostGitTimeout) so a stalled\n1482: // git can't hang the app's command channel forever.\n1483: //\n1484: // The base branch resolves through the same chain diffBaseBranch and\n1485: // doneConfirmLines use — the project's configured baseBranch\n1486: // (.manigot/manigot.json, read from the project root via job.Root), falling\n1487: // back to git.SymbolicRefHead (origin/HEAD → \"main\") — so \"merge default\n1488: // branch\" merges the same ref the diff tab diffs against and mg done merges\n1489: // into. The merge itself runs inside the job's own worktree (git -C\n1490: // <job-worktree>), not a.root — the job's files and branch live there, and a\n1491: // merge targeting the job branch must run where that branch is checked out.\n1492: // The worktree root is derived from the job dir exactly as commitAllCmd\n1493: // derives it: a job lives at <worktree>/docs/jobs/<id>_<slug>/, so two Dir()\n1494: // hops up lands on the worktree root.\n1495: func (a *App) mergeCmd() tea.Cmd {\n1496: \tworktreeRoot := filepath.Dir(filepath.Dir(a.detail.job.Dir))\n1497: \tsettings, _ := project.Load(a.detail.job.Root)\n1498: \tbase := settings.BaseBranch\n1499: \tif base == \"\" {\n1500: \t\tbase = git.SymbolicRefHead(a.detail.job.Root)\n1501: \t}\n1502: \treturn func() tea.Msg {\n1503: \t\tctx, cancel := context.WithTimeout(context.Background(), hostGitTimeout)\n1504: \t\tdefer cancel()\n1505: \t\terr := git.MergeBranchWithContext(ctx, worktreeRoot, base)\n1506: \t\treturn mergeMsg{base: base, err: err}\n1507: \t}\n1508: }\n1509: \n1510: // commitBriefCmd returns the tea.Cmd that auto-commits brief.md right after a\n1511: // successful \"e\" edit (see the editorDoneMsg case above), following the same\n1512: // \"[ID] <type>: <summary>\" subject convention every agent's own commits use\n1513: // (agents/developer.md, agents/reviewer.md, agents/quality.md). A plain git\n1514: // call off the UI goroutine — no interactive terminal is needed. The path is\n1515: // rebuilt from a.detail.job rather than threaded through editorDoneMsg since\n1516: // only brief.md ever reaches here.\n1517: //\n1518: // The commit runs inside the job's own worktree (git -C <job-worktree>), not\n1519: // a.root: since the worktree model a job's files live in its own worktree,\n1520: // a sibling of the project root, so a pathspec relative to a.root would\n1521: // escape the main worktree (\"outside repository\") — and even if it didn't, it\n1522: // would stage/commit against the main worktree's branch and index instead of\n1523: // the job's branch. The worktree root is derived from the job dir: a job\n1524: // lives at <worktree>/docs/jobs/<id>_<slug>/, so two Dir() hops up lands on\n1525: // the worktree root. The non-repo working-tree fallback (no worktrees at\n1526: // all) degrades to the same derivation with job dirs under a.root itself.\n1527: func (a *App) commitBriefCmd() tea.Cmd {\n1528: \tworktreeRoot := filepath.Dir(filepath.Dir(a.detail.job.Dir))\n1529: \tid := a.detail.job.ID\n1530: \tpath := filepath.Join(a.detail.job.Dir, \"brief.md\")\n1531: \treturn func() tea.Msg {\n1532: \t\trel, err := filepath.Rel(worktreeRoot, path)\n1533: \t\tif err != nil {\n1534: \t\t\treturn commitMsg{err: err}\n1535: \t\t}\n1536: \t\tctx, cancel := context.WithTimeout(context.Background(), hostGitTimeout)\n1537: \t\tdefer cancel()\n1538: \t\terr = git.CommitFileWithContext(ctx, worktreeRoot, rel, fmt.Sprintf(\"[%s] brief: edit via TUI\", id))\n1539: \t\treturn commitMsg{err: err}\n1540: \t}\n1541: }\n1542: \n1543: // agentForKey returns the agent name whose action-bar key equals k (\"\" if no\n1544: // agent uses that key). All five agents are always eligible, regardless of\n1545: // the open job's current stage: the brief this shipped under\n1546: // (\"launch agents without workflow\") is explicitly about not forcing the\n1547: // ideal-workflow stage order — a user may write brief.md and tasks.md by hand\n1548: // and go straight to @developer, for example.\n1549: func (a *App) agentForKey(k string) string {\n1550: \tif a.detail == nil {\n1551: \t\treturn \"\"\n1552: \t}\n1553: \tfor _, agent := range agentOrder {\n1554: \t\tif m, ok := agentMeta[agent]; ok && m.key == k {\n1555: \t\t\treturn agent\n1556: \t\t}\n1557: \t}\n1558: \treturn \"\"\n1559: }\n1560: \n1561: // jdiStatusBadge renders a short \"[...]\" tag for a job's list row\n1562: // when an autonomous run has something to report:\n1563: // running (naming the active agent), or one of the two stop reasons.\n1564: // Renders \"\" when there's nothing to show — no sidecar status file for this\n1565: // job, or one job.ReadJDIStatus itself degrades away (a missing/unparseable\n1566: // file, or a \"running\" status stale enough to mean mg-jdi was killed\n1567: // mid-run — see job.ReadJDIStatus's own doc, which is the sole gate here;\n1568: // this function only formats what it returns, on the same\n1569: // derived-from-polling-job-files basis every other list-row element uses).\n1570: //\n1571: // spinnerStep drives the animated activity-indicator frame prefixed to the\n1572: // running badge (`⠋ [running @<agent>]`) — see activity.go. It is threaded\n1573: // from the App (list row) or the open detailView (action bar) so both badge\n1574: // call sites animate off the same counter and can't drift apart. The\n1575: // [finished] / [needs human] variants render no frame: nothing is happening.\n1576: func jdiStatusBadge(root string, j job.Job, spinnerStep int) string {\n1577: \tst, ok := job.ReadJDIStatus(root, j.Name)\n1578: \tif !ok {\n1579: \t\treturn \"\"\n1580: \t}\n1581: \tswitch st.State {\n1582: \tcase job.JDIRunning:\n1583: \t\tlabel := \"running\"\n1584: \t\tif st.Agent != \"\" {\n1585: \t\t\tlabel += \" @\" + st.Agent\n1586: \t\t}\n1587: \t\t// The frame goes *around* the label, not inside it: tests assert on\n1588: \t\t// the \"running @developer\" substring, so the glyph must not replace\n1589: \t\t// the label's own text. Styled with the badge's own accentStyle so\n1590: \t\t// the whole tag reads as one unit.\n1591: \t\treturn accentStyle.Render(activityFrame(spinnerStep) + \" [\" + label + \"]\")\n1592: \tcase job.JDIStoppedFinished:\n1593: \t\treturn statusDoneStyle.Render(\"[finished]\")\n1594: \tcase job.JDIStoppedNeedsHuman:\n1595: \t\treturn warnStyle.Render(\"[needs human]\")\n1596: \tdefault:\n1597: \t\treturn \"\"\n1598: \t}\n1599: }\n1600: \n1601: // footer is the App's bottom help/status line — the list view's footer,\n1602: // rendering the dim key hint and, when a.status is set and currently visible\n1603: // (e.g. right after \"ctrl+r\", and not in a blink-off toggle), the status\n1604: // alongside it rather than replacing it. Kept on App because status is\n1605: // cross-view state; the list view renders the same footer via listFooter.\n1606: func (a *App) footer() string {\n1607: \treturn listFooter(a.status, a.statusVisible())\n1608: }\n1609: \n1610: // --- helpers ----------------------------------------------------------------\n1611: \n1612: // cmdErrorText formats an error from a host command for a status line.\n1613: //\n1614: // Everything here now comes from the in-process Go lifecycle/session (the\n1615: // scripts and their resolution machinery are gone), so every error is a\n1616: // one-liner.\n1617: func cmdErrorText(err error) string {\n1618: \tif err == nil {\n1619: \t\treturn \"\"\n1620: \t}\n1621: \treturn \"error: \" + err.Error()\n1622: }\n1623: \n1624: func shortRoot(root string) string {\n1625: \tif i := strings.LastIndex(root, \"/\"); i >= 0 {\n1626: \t\treturn root[i+1:]\n1627: \t}\n1628: \treturn root\n1629: }\n1630: \n1631: func pad(s string, n int) string {\n1632: \tif len(s) > n {\n1633: \t\treturn s[:n]\n1634: \t}\n1635: \treturn s + strings.Repeat(\" \", n-len(s))\n1636: }\n1637: \n1638: // AgentDescriptionWidth is the shared cap for rendering an agent's\n1639: // description in every surface that lists agents — the `mg agents` plain\n1640: // listing, the `mg agents` interactive picker, and the TUI's \"a\" agents\n1641: // picker — so all three truncate identically (via Truncate's ellipsis)\n1642: // instead of running the full 100–200 char description into a wall of text.\n1643: // The full description is deliberately kept out of the truncation: the\n1644: // pickers' SearchKey still carries it, so type-to-filter keeps matching on\n1645: // the whole description.\n1646: const AgentDescriptionWidth = 60\n1647: \n1648: // Truncate shortens s to at most n characters when it is longer: n-1\n1649: // characters plus an ellipsis (\"…\"). Strings at or under n characters are\n1650: // returned unchanged, and n <= 0 leaves s untouched. This is the shared\n1651: // truncation used by every agents-list surface (see AgentDescriptionWidth)\n1652: // and the internal building block behind truncate.\n1653: func Truncate(s string, n int) string {\n1654: \tif n > 0 && len(s) > n {\n1655: \t\treturn s[:n-1] + \"…\"\n1656: \t}\n1657: \treturn s\n1658: }\n1659: \n1660: func truncate(s string, n int) string {\n1661: \treturn Truncate(s, n)\n1662: }\n\n(End of file - total 1662 lines)\n</content>","metadata":{"preview":"\t\tif st, running := a.jdiAlreadyRunning(a.detail.job); running {\n\t\t\tlabel := \"mg jdi is already running for this job\"\n\t\t\tif st.Agent != \"\" {\n\t\t\t\tlabel += \" @\" + st.Agent\n\t\t\t}\n\t\t\ta.detail.setStatus(label)\n\t\t\treturn a, a.armStatusExpiry()\n\t\t}\n\t\tif err := launch.Jdi(a.detail.job.ID, a.root, a.settings.ProfileValue()); err != nil {\n\t\t\ta.detail.setStatus(cmdErrorText(err))\n\t\t\treturn a, a.armStatusExpiry()\n\t\t}\n\t\t// Seed the stop-notification dedup as \"running\" right\n\t\t// away rather than waiting for the first poll to discover it —\n\t\t// otherwise a run that finishes before the next refresh would\n\t\t// look like a first-ever observation of an already-stopped job\n\t\t// and never ring.\n\t\ta.jdiSeen[a.detail.job.Name] = job.JDIRunning\n\t\ta.jdiSeenAt[a.detail.job.Name] = jdiNow()\n\t\ta.detail.setStatus(\"→ mg jdi started in the background — see the log tab or list badge\")","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/ui/app.go","text":"\t\tif st, running := a.jdiAlreadyRunning(a.detail.job); running {\n\t\t\tlabel := \"mg jdi is already running for this job\"\n\t\t\tif st.Agent != \"\" {\n\t\t\t\tlabel += \" @\" + st.Agent\n\t\t\t}\n\t\t\ta.detail.setStatus(label)\n\t\t\treturn a, a.armStatusExpiry()\n\t\t}\n\t\tif err := launch.Jdi(a.detail.job.ID, a.root, a.settings.ProfileValue()); err != nil {\n\t\t\ta.detail.setStatus(cmdErrorText(err))\n\t\t\treturn a, a.armStatusExpiry()\n\t\t}\n\t\t// Seed the stop-notification dedup as \"running\" right\n\t\t// away rather than waiting for the first poll to discover it —\n\t\t// otherwise a run that finishes before the next refresh would\n\t\t// look like a first-ever observation of an already-stopped job\n\t\t// and never ring.\n\t\ta.jdiSeen[a.detail.job.Name] = job.JDIRunning\n\t\ta.jdiSeenAt[a.detail.job.Name] = jdiNow()\n\t\ta.detail.setStatus(\"→ mg jdi started in the background — see the log tab or list badge\")\n\t\t// Start the activity-indicator tick chain so the just-launched run\n\t\t// animates immediately — the sidecar doesn't exist yet, but the\n\t\t// jdiSeen entry seeded above is enough for anyJDIRunning (via\n\t\t// jdiAlreadyRunning's fallback). startSpinnerIfRunning is a no-op\n\t\t// (nil cmd) when a chain is already going, batched with the status's\n\t\t// own arming cmd (also nil when a chain is already going).\n\t\treturn a, tea.Batch(a.startSpinnerIfRunning(), a.armStatusExpiry())\n\tcase \"delete\", \"x\":\n\t\t// Permanently delete the job. Bound to both the physical Delete/Entf\n\t\t// key and \"x\": the forward-delete key's escape sequence (CSI 3~) is\n\t\t// not decoded consistently across every terminal emulator/keyboard\n\t\t// layout, so \"x\" (same mnemonic tmux/ranger use for a destructive\n\t\t// remove) is a reliable fallback rather than a hidden alias — it's\n\t\t// named in the footer hint too (see renderFooter). The destructive\n\t\t// confirmation itself is the TUI-side confirm view (replacing\n\t\t// delete-job.sh's subprocess prompt).\n\t\ta.openConfirm(confirmDelete)\n\t\treturn a, nil\n\tcase \"P\":\n\t\t// Push this job's branch to origin — the \"quick way to push feature\n\t\t// branches\". git.Push\n\t\t// pushes the named branch ref directly (git push origin <branch>),\n\t\t// which does not require that branch to be checked out in the\n\t\t// working tree.\n\t\tif a.detail.job.Branch == \"\" {\n\t\t\ta.detail.setStatus(\"no branch known for this job\")\n\t\t\treturn a, a.armStatusExpiry()\n\t\t}\n\t\treturn a, a.pushCmd(a.detail.job.Branch)\n\tcase \"t\":\n\t\t// Open the job's branch diff in tig — a host-side TUI launched just\n\t\t// like an agent session (tmux split pane / new terminal, see\n\t\t// launch.Tig), not a background process like \"j\". The availability\n\t\t// gate is cached on the detail view at open time (tigAvailable); the\n\t\t// launch path re-checks it itself as an authoritative backstop, so a\n\t\t// stale cached gate surfaces a synchronous error here rather than a\n\t\t// doomed pane.\n\t\tif !a.detail.tigAvailable {\n\t\t\ta.detail.setStatus(\"tig is not installed on the host — install it, or use the diff tab\")\n\t\t\treturn a, a.armStatusExpiry()\n\t\t}\n\t\tif a.detail.job.Branch == \"\" {\n\t\t\ta.detail.setStatus(\"no branch known for this job\")\n\t\t\treturn a, a.armStatusExpiry()\n\t\t}\n\t\t// The job is passed by Name (id_slug), not ID: `mg diff` resolves the\n\t\t// job's branch via an exact match on that tail segment (see launch.\n\t\t// Tig's own doc), and there is no profile flag — mg diff is a host\n\t\t// git command, not a session launch.\n\t\tdesc, err := launch.Tig(a.detail.job.Name, a.root, a.settings.Terminal)\n\t\tif err != nil {\n\t\t\ta.detail.setStatus(cmdErrorText(err))\n\t\t} else {\n\t\t\ta.detail.setStatus(\"→ tig in \" + desc)\n\t\t}\n\t\treturn a, a.armStatusExpiry()\n\tcase \"l\":\n\t\t// Tail the job's mg-jdi run.log in a tmux split pane / new terminal —\n\t\t// a live `tail -f` of the same sidecar the log tab (key 5) reads, so a\n\t\t// user can watch the currently running agent's output grow without\n\t\t// pressing ctrl+r. Like \"t\" it spawns a host-side pane (see\n\t\t// launch.Tail), unlike \"j\" which stays background-only. Gated on a\n\t\t// run.log existing for this job — the same condition under which the\n\t\t// log tab shows real content — and deliberately with no branch guard\n\t\t// (unlike \"t\"/\"P\"/\"c\"/\"g\"): the log sidecar is job-name-keyed, not\n\t\t// branch-keyed, so a branch-less working-tree job can tail too.\n\t\tif !a.detail.runLogExists() {\n\t\t\ta.detail.setStatus(\"no mg jdi run has happened for this job yet\")\n\t\t\treturn a, a.armStatusExpiry()\n\t\t}\n\t\t// The launch path takes the absolute run.log path directly — no\n\t\t// mg-binary hop, no profile flag: `tail -f` is a plain host command.\n\t\t// Same job.Root the gate just checked, so the two can never disagree.\n\t\tdesc, err := launch.Tail(job.JDIRunLogPath(a.detail.job.Root, a.detail.job.Name), a.settings.Terminal)\n\t\tif err != nil {\n\t\t\ta.detail.setStatus(cmdErrorText(err))\n\t\t} else {\n\t\t\ta.detail.setStatus(\"→ tailing run.log in \" + desc)\n\t\t}\n\t\treturn a, a.armStatusExpiry()\n\tcase \"c\":\n\t\t// Commit all uncommitted changes in this job's worktree — a\n\t\t// catch-all sweep for the files agents sometimes leave behind, which\n\t\t// would otherwise trip mg done's clean-tree check. A host-side git\n\t\t// action like \"P\", not an agent launch: the commit runs in the job's\n\t\t// own worktree so it lands on the job branch (see commitAllCmd).\n\t\tif a.detail.job.Branch == \"\" {\n\t\t\ta.detail.setStatus(\"no branch known for this job\")\n\t\t\treturn a, a.armStatusExpiry()\n\t\t}\n\t\treturn a, a.commitAllCmd()\n\tcase \"g\":\n\t\t// Open the git panel: the discoverable entry for the detail view's\n\t\t// git commands (commit all / push to origin / merge default branch).\n\t\t// \"g\" used to be the file viewer's scroll-to-top key (shared with\n\t\t// \"home\"); the panel takes it over, and scroll-to-top stays\n\t\t// reachable via \"home\" (see detail.go's scroll). The \"P\"/\"c\" direct\n\t\t// accelerators stay bound too — the panel is the discoverable\n\t\t// surface, not a removal of the old keys. Gated on the job having a\n\t\t// branch like \"P\"/\"c\"/\"t\": every action in the panel targets the\n\t\t// job's worktree branch.\n\t\tif a.detail.job.Branch == \"\" {\n\t\t\ta.detail.setStatus(\"no branch known for this job\")\n\t\t\treturn a, a.armStatusExpiry()\n\t\t}\n\t\ta.gitPanel = newGitPanelView(a.width, a.height)\n\t\ta.state = stateGitPanel\n\t\treturn a, nil\n\t}\n\t// Action bar: fire the agent whose key matches, if it is valid for the\n\t// current job's stage.\n\tif agent := a.agentForKey(msg.String()); agent != \"\" {\n\t\tdesc, err := launch.Agent(agent, a.detail.job.ID, a.root, a.settings.ProfileValue(), a.settings.Terminal)\n\t\tif err != nil {\n\t\t\ta.detail.setStatus(cmdErrorText(err))\n\t\t} else {\n\t\t\ta.detail.setStatus(\"→ \" + agent + \" in \" + desc)\n\t\t}\n\t\treturn a, a.armStatusExpiry()\n\t}\n\ta.detail.setStatus(\"\")\n\ta.detail.update(msg)\n\treturn a, nil\n}\n\n// editCmd resolves an editor and returns the tea.Cmd that opens it on the\n// active tab's file. tea.ExecProcess suspends the Bubble Tea renderer (unlike\n// launch.Agent's detached new-window spawn) and runs the child in the same\n// terminal, resuming the TUI once it exits; the result is delivered back as\n// an editorDoneMsg. An error here means the editor itself could not be\n// resolved (see editor.Resolve) — the caller surfaces it directly.\nfunc (a *App) editCmd() (tea.Cmd, error) {\n\tpath := a.detail.current().path\n\tcmd, err := editor.Command(path, a.settings.Editor)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn tea.ExecProcess(cmd, func(err error) tea.Msg {\n\t\treturn editorDoneMsg{path: path, err: err}\n\t}), nil\n}\n\n// openConfirm switches to the confirmation view for the given action on the\n// open job (called by the \"D\" / \"delete\" / \"x\" keys in the detail view).\nfunc (a *App) openConfirm(action confirmAction) {\n\ta.confirm = newConfirmView(action, a.root, a.detail.job)\n\ta.confirm.resize(a.width, a.height)\n\ta.state = stateConfirm\n}\n\n// updateConfirm handles keys in the confirmation view: y/enter runs the\n// confirmed lifecycle action in the background (a tea.Cmd goroutine), n/esc/q\n// cancels back to the detail view.\nfunc (a *App) updateConfirm(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n\tswitch msg.String() {\n\tcase \"y\", \"Y\", \"enter\":\n\t\taction := a.confirm.action\n\t\ta.confirm = nil\n\t\ta.state = stateDetail\n\t\tswitch action {\n\t\tcase confirmDone:\n\t\t\treturn a, a.runDoneCmd()\n\t\tcase confirmDelete:\n\t\t\treturn a, a.runDeleteCmd()\n\t\t}\n\tcase \"n\", \"N\", \"esc\", \"q\":\n\t\ta.confirm = nil\n\t\ta.state = stateDetail\n\t}\n\treturn a, nil\n}\n\n// runDoneCmd runs job.FinishJob in the background and reports the outcome as\n// a doneMsg. The user has already confirmed in the confirm view, so every\n// internal prompt is pre-approved; informational output is discarded — the\n// TUI renders its own status lines.\nfunc (a *App) runDoneCmd() tea.Cmd {\n\troot := a.root\n\tjobName := a.detail.job.Name\n\treturn func() tea.Msg {\n\t\t_, err := job.FinishJob(root, jobName, yesConfirm, io.Discard)\n\t\treturn doneMsg{err: err}\n\t}\n}\n\n// runDeleteCmd runs job.DeleteJob in the background and reports the outcome\n// as a deleteMsg — the same pre-approved shape as runDoneCmd.\nfunc (a *App) runDeleteCmd() tea.Cmd {\n\troot := a.root\n\tjobName := a.detail.job.Name\n\treturn func() tea.Msg {\n\t\t_, err := job.DeleteJob(root, jobName, yesConfirm, io.Discard)\n\t\treturn deleteMsg{err: err}\n\t}\n}\n\n// yesConfirm pre-approves every lifecycle confirmation prompt — used once the\n// user has already confirmed the action in the TUI's confirm view.\nfunc yesConfirm(prompt string) (bool, error) { return true, nil }\n\n// pushCmd returns the tea.Cmd behind the \"P\" push-to-origin action: a plain\n// git call off the UI goroutine — no interactive process, just a git push —\n// and reports the outcome as a pushMsg once it returns. The call is bounded\n// by a timeout (see hostGitTimeout) so a stalled network can't hang the TUI's\n// command channel forever; the timeout surfaces as an ordinary pushMsg error.\nfunc (a *App) pushCmd(branch string) tea.Cmd {\n\troot := a.root\n\treturn func() tea.Msg {\n\t\tctx, cancel := context.WithTimeout(context.Background(), hostGitTimeout)\n\t\tdefer cancel()\n\t\terr := git.PushWithContext(ctx, root, branch)\n\t\treturn pushMsg{branch: branch, err: err}\n\t}\n}\n\n// commitAllCmd returns the tea.Cmd behind the \"c\" commit-all action: a plain\n// git call off the UI goroutine — no interactive process — staging every\n// change in the job's own worktree (git add -A) and committing it, reporting\n// the outcome as a commitAllMsg once it returns. The call is bounded by a\n// timeout (see hostGitTimeout) so a stalled git can't hang the app's command\n// channel forever.\n//\n// The commit runs inside the job's own worktree (git -C <job-worktree>), not\n// a.root — the same reasoning commitBriefCmd documents: a job's files live in\n// its own worktree, a sibling of the project root, so a pathspec relative to\n// a.root would escape the main worktree (\"outside repository\"), and the\n// commit must land on the *job branch*, not the base branch. The worktree\n// root is derived from the job dir exactly as commitBriefCmd derives it: a\n// job lives at <worktree>/docs/jobs/<id>_<slug>/, so two Dir() hops up lands\n// on the worktree root. The message follows the shared \"[ID] <type>:\n// <summary>\" convention with the fixed chore-type label \"commit all\" (a\n// catch-all sweep commit is a chore regardless of the job's own type).\nfunc (a *App) commitAllCmd() tea.Cmd {\n\tworktreeRoot := filepath.Dir(filepath.Dir(a.detail.job.Dir))\n\tid := a.detail.job.ID\n\treturn func() tea.Msg {\n\t\tctx, cancel := context.WithTimeout(context.Background(), hostGitTimeout)\n\t\tdefer cancel()\n\t\terr := git.CommitAllWithContext(ctx, worktreeRoot, fmt.Sprintf(\"[%s] chore: commit all\", id))\n\t\treturn commitAllMsg{err: err}\n\t}\n}\n\n// mergeCmd returns the tea.Cmd behind the \"merge default branch\" action: a\n// plain git call off the UI goroutine — no interactive process — merging the\n// resolved base branch into the job's own worktree (git merge --no-edit\n// <base>, see git.MergeBranch), reporting the outcome as a mergeMsg once it\n// returns. The call is bounded by a timeout (see hostGitTimeout) so a stalled\n// git can't hang the app's command channel forever.\n//\n// The base branch resolves through the same chain diffBaseBranch and\n// doneConfirmLines use — the project's configured baseBranch\n// (.manigot/manigot.json, read from the project root via job.Root), falling\n// back to git.SymbolicRefHead (origin/HEAD → \"main\") — so \"merge default\n// branch\" merges the same ref the diff tab diffs against and mg done merges\n// into. The merge itself runs inside the job's own worktree (git -C\n// <job-worktree>), not a.root — the job's files and branch live there, and a\n// merge targeting the job branch must run where that branch is checked out.\n// The worktree root is derived from the job dir exactly as commitAllCmd\n// derives it: a job lives at <worktree>/docs/jobs/<id>_<slug>/, so two Dir()\n// hops up lands on the worktree root.\nfunc (a *App) mergeCmd() tea.Cmd {\n\tworktreeRoot := filepath.Dir(filepath.Dir(a.detail.job.Dir))\n\tsettings, _ := project.Load(a.detail.job.Root)\n\tbase := settings.BaseBranch\n\tif base == \"\" {\n\t\tbase = git.SymbolicRefHead(a.detail.job.Root)\n\t}\n\treturn func() tea.Msg {\n\t\tctx, cancel := context.WithTimeout(context.Background(), hostGitTimeout)\n\t\tdefer cancel()\n\t\terr := git.MergeBranchWithContext(ctx, worktreeRoot, base)\n\t\treturn mergeMsg{base: base, err: err}\n\t}\n}\n\n// commitBriefCmd returns the tea.Cmd that auto-commits brief.md right after a\n// successful \"e\" edit (see the editorDoneMsg case above), following the same\n// \"[ID] <type>: <summary>\" subject convention every agent's own commits use\n// (agents/developer.md, agents/reviewer.md, agents/quality.md). A plain git\n// call off the UI goroutine — no interactive terminal is needed. The path is\n// rebuilt from a.detail.job rather than threaded through editorDoneMsg since\n// only brief.md ever reaches here.\n//\n// The commit runs inside the job's own worktree (git -C <job-worktree>), not\n// a.root: since the worktree model a job's files live in its own worktree,\n// a sibling of the project root, so a pathspec relative to a.root would\n// escape the main worktree (\"outside repository\") — and even if it didn't, it\n// would stage/commit against the main worktree's branch and index instead of\n// the job's branch. The worktree root is derived from the job dir: a job\n// lives at <worktree>/docs/jobs/<id>_<slug>/, so two Dir() hops up lands on\n// the worktree root. The non-repo working-tree fallback (no worktrees at\n// all) degrades to the same derivation with job dirs under a.root itself.\nfunc (a *App) commitBriefCmd() tea.Cmd {\n\tworktreeRoot := filepath.Dir(filepath.Dir(a.detail.job.Dir))\n\tid := a.detail.job.ID\n\tpath := filepath.Join(a.detail.job.Dir, \"brief.md\")\n\treturn func() tea.Msg {\n\t\trel, err := filepath.Rel(worktreeRoot, path)\n\t\tif err != nil {\n\t\t\treturn commitMsg{err: err}\n\t\t}\n\t\tctx, cancel := context.WithTimeout(context.Background(), hostGitTimeout)\n\t\tdefer cancel()\n\t\terr = git.CommitFileWithContext(ctx, worktreeRoot, rel, fmt.Sprintf(\"[%s] brief: edit via TUI\", id))\n\t\treturn commitMsg{err: err}\n\t}\n}\n\n// agentForKey returns the agent name whose action-bar key equals k (\"\" if no\n// agent uses that key). All five agents are always eligible, regardless of\n// the open job's current stage: the brief this shipped under\n// (\"launch agents without workflow\") is explicitly about not forcing the\n// ideal-workflow stage order — a user may write brief.md and tasks.md by hand\n// and go straight to @developer, for example.\nfunc (a *App) agentForKey(k string) string {\n\tif a.detail == nil {\n\t\treturn \"\"\n\t}\n\tfor _, agent := range agentOrder {\n\t\tif m, ok := agentMeta[agent]; ok && m.key == k {\n\t\t\treturn agent\n\t\t}\n\t}\n\treturn \"\"\n}\n\n// jdiStatusBadge renders a short \"[...]\" tag for a job's list row\n// when an autonomous run has something to report:\n// running (naming the active agent), or one of the two stop reasons.\n// Renders \"\" when there's nothing to show — no sidecar status file for this\n// job, or one job.ReadJDIStatus itself degrades away (a missing/unparseable\n// file, or a \"running\" status stale enough to mean mg-jdi was killed\n// mid-run — see job.ReadJDIStatus's own doc, which is the sole gate here;\n// this function only formats what it returns, on the same\n// derived-from-polling-job-files basis every other list-row element uses).\n//\n// spinnerStep drives the animated activity-indicator frame prefixed to the\n// running badge (`⠋ [running @<agent>]`) — see activity.go. It is threaded\n// from the App (list row) or the open detailView (action bar) so both badge\n// call sites animate off the same counter and can't drift apart. The\n// [finished] / [needs human] variants render no frame: nothing is happening.\nfunc jdiStatusBadge(root string, j job.Job, spinnerStep int) string {\n\tst, ok := job.ReadJDIStatus(root, j.Name)\n\tif !ok {\n\t\treturn \"\"\n\t}\n\tswitch st.State {\n\tcase job.JDIRunning:\n\t\tlabel := \"running\"\n\t\tif st.Agent != \"\" {\n\t\t\tlabel += \" @\" + st.Agent\n\t\t}\n\t\t// The frame goes *around* the label, not inside it: tests assert on\n\t\t// the \"running @developer\" substring, so the glyph must not replace\n\t\t// the label's own text. Styled with the badge's own accentStyle so\n\t\t// the whole tag reads as one unit.\n\t\treturn accentStyle.Render(activityFrame(spinnerStep) + \" [\" + label + \"]\")\n\tcase job.JDIStoppedFinished:\n\t\treturn statusDoneStyle.Render(\"[finished]\")\n\tcase job.JDIStoppedNeedsHuman:\n\t\treturn warnStyle.Render(\"[needs human]\")\n\tdefault:\n\t\treturn \"\"\n\t}\n}\n\n// footer is the App's bottom help/status line — the list view's footer,\n// rendering the dim key hint and, when a.status is set and currently visible\n// (e.g. right after \"ctrl+r\", and not in a blink-off toggle), the status\n// alongside it rather than replacing it. Kept on App because status is\n// cross-view state; the list view renders the same footer via listFooter.\nfunc (a *App) footer() string {\n\treturn listFooter(a.status, a.statusVisible())\n}\n\n// --- helpers ----------------------------------------------------------------\n\n// cmdErrorText formats an error from a host command for a status line.\n//\n// Everything here now comes from the in-process Go lifecycle/session (the\n// scripts and their resolution machinery are gone), so every error is a\n// one-liner.\nfunc cmdErrorText(err error) string {\n\tif err == nil {\n\t\treturn \"\"\n\t}\n\treturn \"error: \" + err.Error()\n}\n\nfunc shortRoot(root string) string {\n\tif i := strings.LastIndex(root, \"/\"); i >= 0 {\n\t\treturn root[i+1:]\n\t}\n\treturn root\n}\n\nfunc pad(s string, n int) string {\n\tif len(s) > n {\n\t\treturn s[:n]\n\t}\n\treturn s + strings.Repeat(\" \", n-len(s))\n}\n\n// AgentDescriptionWidth is the shared cap for rendering an agent's\n// description in every surface that lists agents — the `mg agents` plain\n// listing, the `mg agents` interactive picker, and the TUI's \"a\" agents\n// picker — so all three truncate identically (via Truncate's ellipsis)\n// instead of running the full 100–200 char description into a wall of text.\n// The full description is deliberately kept out of the truncation: the\n// pickers' SearchKey still carries it, so type-to-filter keeps matching on\n// the whole description.\nconst AgentDescriptionWidth = 60\n\n// Truncate shortens s to at most n characters when it is longer: n-1\n// characters plus an ellipsis (\"…\"). Strings at or under n characters are\n// returned unchanged, and n <= 0 leaves s untouched. This is the shared\n// truncation used by every agents-list surface (see AgentDescriptionWidth)\n// and the internal building block behind truncate.\nfunc Truncate(s string, n int) string {\n\tif n > 0 && len(s) > n {\n\t\treturn s[:n-1] + \"…\"\n\t}\n\treturn s\n}\n\nfunc truncate(s string, n int) string {\n\treturn Truncate(s, n)\n}","lineStart":1214,"lineEnd":1662,"totalLines":1662,"truncated":false}},"title":"src/internal/ui/app.go","time":{"start":1787920076596,"end":1787920076601}},"id":"prt_048574e7b0012o2I4jn8lrL4sG","sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","messageID":"msg_04857433f001LOXsGE7cXn8Mr0"}}
