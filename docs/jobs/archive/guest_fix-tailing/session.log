{"type":"tool_use","timestamp":1787920066069,"sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","part":{"type":"tool","tool":"read","callID":"call_00_zQtAFNx9OtZIOpmSWDFE4647","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/session/docker.go"},"output":"<path>/workspace/src/internal/session/docker.go</path>\n<type>file</type>\n<content>\n1: package session\n2: \n3: import (\n4: \t\"encoding/json\"\n5: \t\"fmt\"\n6: \t\"io\"\n7: \t\"math/rand/v2\"\n8: \t\"os\"\n9: \t\"os/exec\"\n10: \t\"path/filepath\"\n11: \t\"strconv\"\n12: \t\"strings\"\n13: \n14: \t\"github.com/lmuskalla/manigot/internal/config\"\n15: \t\"github.com/lmuskalla/manigot/internal/fs\"\n16: \t\"github.com/lmuskalla/manigot/internal/git\"\n17: \t\"github.com/lmuskalla/manigot/internal/home\"\n18: )\n19: \n20: // DockerInvocation is a fully assembled `docker run` command.\n21: type DockerInvocation struct {\n22: \t// Argv is the complete argument vector: [\"docker\", \"run\", ...].\n23: \tArgv []string\n24: \n25: \t// Cleanup removes any host-side resources the invocation created (e.g.\n26: \t// the converted-project-agents temp dir shadow-mounted over the docs\n27: \t// mount's agents/ subpath — see BuildDockerInvocation's agentMount\n28: \t// block). Run defers it so every caller — the interactive `mg` session\n29: \t// path and `mg jdi`'s --print runs alike — gets the cleanup for free\n30: \t// without having to know about it. nil when there is nothing to clean\n31: \t// up.\n32: \tCleanup func()\n33: }\n34: \n35: // dockerImageName is the container image run.sh launched.\n36: const dockerImageName = \"manigot\"\n37: \n38: // terminalEnvVars lists the host terminal-identity variables forwarded into\n39: // the container so the in-container agent TUIs see the real terminal. TUIs\n40: // gate their copy/clipboard behavior on these: OSC 52 emission is decided\n41: // from terminal identity/capability vars (TERM, COLORTERM, TERM_PROGRAM,\n42: // TERM_PROGRAM_VERSION, VTE_VERSION, KITTY_WINDOW_ID, TMUX, TMUX_PANE,\n43: // WT_SESSION — plus the WEZTERM_* family, which WezTerm sets several of).\n44: // None of these were forwarded before, so the in-container TUIs saw an\n45: // unrecognized terminal and copying from agent output silently failed (see\n46: // the \"Clipboard / copying from agent sessions\" docs section).\n47: //\n48: // TMUX/TMUX_PANE are deliberately NOT forwarded for OpenCode sessions\n49: // (terminalEnvArgs skips them when the tool is OpenCode): when OpenCode sees\n50: // TMUX set it wraps its OSC 52 clipboard write in tmux's DCS-passthrough\n51: // escape, which default tmux configuration discards entirely\n52: // (allow-passthrough defaults to off), so the host clipboard is never\n53: // touched. Stripping TMUX makes OpenCode emit plain OSC 52, which tmux's\n54: // set-clipboard on handles correctly. Claude Code's container env stays\n55: // byte-identical — TMUX/TMUX_PANE are still forwarded for it.\n56: //\n57: // Each var is forwarded only when set and non-empty on the host — never an\n58: // empty value — so a session launched outside a terminal (CI, a script)\n59: // keeps a byte-identical argv to a build without this feature.\n60: var terminalEnvVars = []string{\n61: \t\"TERM\",\n62: \t\"COLORTERM\",\n63: \t\"TERM_PROGRAM\",\n64: \t\"TERM_PROGRAM_VERSION\",\n65: \t\"VTE_VERSION\",\n66: \t\"KITTY_WINDOW_ID\",\n67: \t\"TMUX\",\n68: \t\"TMUX_PANE\",\n69: \t\"WT_SESSION\",\n70: }\n71: \n72: // tmuxEnvVars are the terminal-identity vars whose forwarding is gated on\n73: // the resolved tool: they are sent only to Claude Code, never to OpenCode\n74: // (see the comment on terminalEnvVars for why).\n75: var tmuxEnvVars = map[string]bool{\n76: \t\"TMUX\":      true,\n77: \t\"TMUX_PANE\": true,\n78: }\n79: \n80: // terminalEnvArgs returns the docker -e entries forwarding the host's\n81: // terminal identity into the container: every terminalEnvVars entry that is\n82: // set and non-empty on the host, plus every WEZTERM_* variable (also only\n83: // when set to a non-empty value). TMUX/TMUX_PANE are skipped when tool is\n84: // OpenCode (see terminalEnvVars). No var set → an empty slice, keeping the\n85: // docker argv byte-identical to a session built without terminal forwarding.\n86: func terminalEnvArgs(tool string) []string {\n87: \tvar args []string\n88: \tfor _, key := range terminalEnvVars {\n89: \t\tif tmuxEnvVars[key] && tool == config.ToolOpenCode {\n90: \t\t\tcontinue\n91: \t\t}\n92: \t\tif v := os.Getenv(key); v != \"\" {\n93: \t\t\targs = append(args, \"-e\", key+\"=\"+v)\n94: \t\t}\n95: \t}\n96: \tfor _, kv := range os.Environ() {\n97: \t\tname, value, ok := strings.Cut(kv, \"=\")\n98: \t\tif ok && strings.HasPrefix(name, \"WEZTERM_\") && value != \"\" {\n99: \t\t\targs = append(args, \"-e\", kv)\n100: \t\t}\n101: \t}\n102: \treturn args\n103: }\n104: \n105: // warnTmuxClipboard detects the tmux clipboard-interception failure mode at\n106: // session start and warns on diag (stderr — the diagnostics stream): when the\n107: // session is interactive (a TUI to copy from — --print/mg-jdi runs capture\n108: // JSON output instead, so the check is skipped), the host is inside tmux\n109: // ($TMUX set) and tmux is on PATH, `tmux show-options -g set-clipboard` is\n110: // run; if it reports off, tmux will strip the OSC 52 clipboard writes the\n111: // in-container TUIs emit, so copying from the agent shows \"copied\" but never\n112: // reaches the host clipboard. Strictly read-only: no tmux state is mutated,\n113: // and any tmux failure (not installed, no server, an option query error)\n114: // silently skips the check — no launch path can break because of it.\n115: func warnTmuxClipboard(diag io.Writer, interactive, print bool) {\n116: \tif !interactive || print {\n117: \t\treturn\n118: \t}\n119: \tif os.Getenv(\"TMUX\") == \"\" {\n120: \t\treturn\n121: \t}\n122: \tif _, err := exec.LookPath(\"tmux\"); err != nil {\n123: \t\treturn\n124: \t}\n125: \tout, err := exec.Command(\"tmux\", \"show-options\", \"-g\", \"set-clipboard\").Output()\n126: \tif err != nil {\n127: \t\treturn\n128: \t}\n129: \tif strings.TrimSpace(string(out)) == \"set-clipboard off\" {\n130: \t\tfmt.Fprintln(diag, \"Warning: your tmux has set-clipboard off — it will swallow OSC 52 clipboard writes from the agent, so copying inside the session won't reach your host clipboard.\")\n131: \t\tfmt.Fprintln(diag, \"         Run 'tmux set -g set-clipboard on' to fix it (see the 'Clipboard / copying from agent sessions' docs section).\")\n132: \t}\n133: }\n134: \n135: // BuildDockerInvocation assembles the docker run argv, mirroring run.sh's\n136: // launch construction — every flag, mount, and env\n137: // var is load-bearing, so the argument order and exact strings are pinned by\n138: // the tests. Diagnostics (banner, warnings, shadowing lines) are written to\n139: // diag — always stderr, per the brief's note 1 (the script's fd-3 juggling\n140: // existed only to keep --print stdout clean; Go separates the streams\n141: // natively). interactive controls the -it flag (stdin is a terminal).\n142: func BuildDockerInvocation(opts Options, info ProfileInfo, root Root, interactive bool, diag io.Writer) (DockerInvocation, error) {\n143: \t// The .env warning run.sh printed when the file was missing.\n144: \tif envFile := config.EnvFile(); envFile != \"\" {\n145: \t\tif _, err := os.Stat(envFile); err != nil {\n146: \t\t\tfmt.Fprintf(diag, \"Warning: no .env found at %s\\n\", envFile)\n147: \t\t}\n148: \t}\n149: \n150: \t// The tmux OSC 52 clipboard-interception warning (TASK-2 of the clipboard\n151: \t// job): strictly read-only, failures silently skipped.\n152: \twarnTmuxClipboard(diag, interactive, opts.Print)\n153: \n154: \t// ── Git identity ─────────────────────────────────────────────────────────\n155: \t// Host GIT_AUTHOR_NAME/EMAIL env vars win; otherwise fall back to the\n156: \t// project's git config (local overrides global, matching git behavior).\n157: \tgitName := os.Getenv(\"GIT_AUTHOR_NAME\")\n158: \tif gitName == \"\" {\n159: \t\tgitName = git.ConfigUserName(root.ProjectRoot)\n160: \t}\n161: \tgitEmail := os.Getenv(\"GIT_AUTHOR_EMAIL\")\n162: \tif gitEmail == \"\" {\n163: \t\tgitEmail = git.ConfigEmail(root.ProjectRoot)\n164: \t}\n165: \tif gitName == \"\" || gitEmail == \"\" {\n166: \t\tfmt.Fprintln(diag, \"Warning: no git user.name/user.email configured for this project — container commits will fall back to a generic 'manigot' identity.\")\n167: \t}\n168: \n169: \t// ── Docs mount target + context file ────────────────────────────────────\n170: \tdocsMountTarget := \"/workspace/.claude\"\n171: \tif info.Tool == config.ToolOpenCode {\n172: \t\tdocsMountTarget = \"/workspace/.opencode\"\n173: \t}\n174: \n175: \tcontextFile := \"\"\n176: \tif fs.IsFile(filepath.Join(root.DocsDir, \"AGENTS.md\")) {\n177: \t\tcontextFile = filepath.Join(root.DocsDir, \"AGENTS.md\")\n178: \t} else if fs.IsFile(filepath.Join(root.DocsDir, \"CLAUDE.md\")) {\n179: \t\tcontextFile = filepath.Join(root.DocsDir, \"CLAUDE.md\")\n180: \t}\n181: \n182: \tvar contextMount []string\n183: \tcontextTarget := \"\"\n184: \tif contextFile != \"\" {\n185: \t\tif info.Tool == config.ToolOpenCode {\n186: \t\t\tcontextTarget = \"/workspace/AGENTS.md\"\n187: \t\t} else {\n188: \t\t\tcontextTarget = \"/workspace/.claude/CLAUDE.md\"\n189: \t\t}\n190: \t\tcontextMount = []string{\"-v\", contextFile + \":\" + contextTarget + \":ro\"}\n191: \t} else if root.DocsInitialized {\n192: \t\tfmt.Fprintf(diag, \"Warning: no docs/AGENTS.md found — the agent will start without project context.\\n\")\n193: \t} else {\n194: \t\tfmt.Fprintln(diag, \"Note: no docs/ directory — starting a plain session with no project context or job workflow.\")\n195: \t\tfmt.Fprintln(diag, \"      See 'Per-project setup' in the manigot README to enable them.\")\n196: \t}\n197: \n198: \tvar docsMount []string\n199: \tif fs.IsDir(root.DocsDir) {\n200: \t\tdocsMount = []string{\"-v\", root.DocsDir + \":\" + docsMountTarget + \":z\"}\n201: \t}\n202: \n203: \t// ── Project agents ─────────────────────────────────────────────────────\n204: \t// docs/agents/ rides along inside the docs mount above — fine for Claude\n205: \t// Code, whose subagent schema the list-form frontmatter already is, but\n206: \t// OpenCode hard-errors on the list-form tools: key (see convertAgents),\n207: \t// so custom project agents must be converted before the container sees\n208: \t// them. The converted copies land in a temp dir shadow-mounted over the\n209: \t// docs mount's agents/ subpath; the host's docs/agents/ source tree is\n210: \t// never modified. The temp dir is removed via the invocation's Cleanup\n211: \t// hook (see DockerInvocation.Run).\n212: \tvar agentMount []string\n213: \tvar agentCleanup func()\n214: \tif tmp, hasAgents, err := convertAgents(filepath.Join(root.DocsDir, \"agents\"), info.Tool); err != nil {\n215: \t\treturn DockerInvocation{}, fmt.Errorf(\"convert project agents: %w\", err)\n216: \t} else if hasAgents {\n217: \t\tagentMount = []string{\"-v\", tmp + \":/workspace/.opencode/agents:z\"}\n218: \t\tagentCleanup = func() { os.RemoveAll(tmp) }\n219: \t}\n220: \n221: \t// ── Global agents ─────────────────────────────────────────────────────\n222: \t// The global agents dir (<home>/agents/) is no longer baked into the\n223: \t// image — it lives on the host in the manigot checkout and is mounted\n224: \t// read-only into the container at the CLI's global agent location, so the\n225: \t// container can use the host's agents but cannot modify them. This keeps\n226: \t// the image purely isolation for workspaces and makes the same agents\n227: \t// available to `mg host` (see host.go). Project agents (docs/agents/,\n228: \t// above) still ride the docs mount and override global agents of the same\n229: \t// name, exactly as before.\n230: \t//\n231: \t// Claude Code reads global subagents from ~/.claude/agents/ and takes the\n232: \t// list-form frontmatter natively, so the host's files mount verbatim.\n233: \t// OpenCode reads global agents from ~/.config/opencode/agents/ and\n234: \t// hard-errors on the list-form tools: key, so the mounted files are\n235: \t// converted first (name:/tools: stripped, permission: passed through —\n236: \t// see convertAgents) into a temp dir shadow-mounted over the CLI's global\n237: \t// agents path, cleaned up via the invocation's Cleanup hook.\n238: \tvar globalAgentMount []string\n239: \tvar globalAgentCleanup func()\n240: \tif homeDir := home.Root(); homeDir != \"\" {\n241: \t\tglobalAgentsDir := filepath.Join(homeDir, \"agents\")\n242: \t\tif fs.IsDir(globalAgentsDir) {\n243: \t\t\tif info.Tool == config.ToolOpenCode {\n244: \t\t\t\tif tmp, hasAgents, err := convertAgents(globalAgentsDir, info.Tool); err != nil {\n245: \t\t\t\t\treturn DockerInvocation{}, fmt.Errorf(\"convert global agents: %w\", err)\n246: \t\t\t\t} else if hasAgents {\n247: \t\t\t\t\tglobalAgentMount = []string{\"-v\", tmp + \":/home/claude/.config/opencode/agents:ro\"}\n248: \t\t\t\t\tglobalAgentCleanup = func() { os.RemoveAll(tmp) }\n249: \t\t\t\t}\n250: \t\t\t} else {\n251: \t\t\t\tglobalAgentMount = []string{\"-v\", globalAgentsDir + \":/home/claude/.claude/agents:ro\"}\n252: \t\t\t}\n253: \t\t}\n254: \t}\n255: \n256: \t// ── Global skills ─────────────────────────────────────────────────────\n257: \t// Skills follow the same global + project model as agents, applied to a\n258: \t// different unit: a skill is a directory (SKILL.md plus support files),\n259: \t// not a single file. Global skills live in the manigot checkout\n260: \t// (<home>/skills/) and are mounted read-only into the container at the\n261: \t// CLI's global skills location — ~/.claude/skills for Claude Code,\n262: \t// ~/.config/opencode/skills for OpenCode — where both CLIs load skills at\n263: \t// startup, independent of the active agent. That single global location is\n264: \t// exactly what makes a skill available to every agent and to invocations\n265: \t// that name no agent; project skills (docs/skills/, below) ride the docs\n266: \t// mount and override global skills of the same name.\n267: \t//\n268: \t// Unlike agents, skills need no frontmatter conversion — both CLIs read\n269: \t// SKILL.md and its frontmatter natively — so Claude Code gets the host's\n270: \t// skills dir verbatim (a read-only bind, like its agents mount). OpenCode\n271: \t// gets a staged copy instead (see stageGlobalSkills), mounted read-only\n272: \t// and cleaned up via the invocation's Cleanup hook, so the CLI's skills\n273: \t// dir is a fresh, disposable snapshot and the host's skills/ source tree\n274: \t// is never touched. Skipped cleanly when the checkout has no skills dir.\n275: \tvar globalSkillMount []string\n276: \tvar globalSkillCleanup func()\n277: \tif homeDir := home.Root(); homeDir != \"\" {\n278: \t\tglobalSkillsDir := filepath.Join(homeDir, \"skills\")\n279: \t\tif fs.IsDir(globalSkillsDir) {\n280: \t\t\tif info.Tool == config.ToolOpenCode {\n281: \t\t\t\tif tmp, hasSkills, err := stageGlobalSkills(globalSkillsDir); err != nil {\n282: \t\t\t\t\treturn DockerInvocation{}, fmt.Errorf(\"stage global skills: %w\", err)\n283: \t\t\t\t} else if hasSkills {\n284: \t\t\t\t\tglobalSkillMount = []string{\"-v\", tmp + \":/home/claude/.config/opencode/skills:ro\"}\n285: \t\t\t\t\tglobalSkillCleanup = func() { os.RemoveAll(tmp) }\n286: \t\t\t\t}\n287: \t\t\t} else {\n288: \t\t\t\tglobalSkillMount = []string{\"-v\", globalSkillsDir + \":/home/claude/.claude/skills:ro\"}\n289: \t\t\t}\n290: \t\t}\n291: \t}\n292: \n293: \t// ── Global meta prompt ─────────────────────────────────────────────────\n294: \t// The meta prompt (<home>/prompts/meta.md) is a system-wide instruction file that\n295: \t// sits *above* agents and skills in the instruction hierarchy: it is\n296: \t// injected into every session, regardless of agent, project, or\n297: \t// interactive/--print mode. Each CLI loads it from its *global\n298: \t// instruction* location — ~/.claude/CLAUDE.md for Claude Code (the\n299: \t// user-global memory file, loaded before the project context at\n300: \t// /workspace/.claude/CLAUDE.md) and ~/.config/opencode/AGENTS.md for\n301: \t// OpenCode (the global rules file, loaded alongside the project context\n302: \t// mount) — so the project context still wins on conflict.\n303: \t//\n304: \t// Like skills, the file is plain markdown native to both CLIs, so no\n305: \t// conversion and no temp dir are needed (and thus no Cleanup hook): the\n306: \t// checkout file is mounted read-only at the per-tool target. A checkout\n307: \t// without prompts/meta.md yields no mount (it is optional, like skills).\n308: \tvar globalMetaMount []string\n309: \tif homeDir := home.Root(); homeDir != \"\" {\n310: \t\tmetaFile := filepath.Join(homeDir, \"prompts\", \"meta.md\")\n311: \t\tif fs.IsFile(metaFile) {\n312: \t\t\tif info.Tool == config.ToolOpenCode {\n313: \t\t\t\tglobalMetaMount = []string{\"-v\", metaFile + \":/home/claude/.config/opencode/AGENTS.md:ro\"}\n314: \t\t\t} else {\n315: \t\t\t\tglobalMetaMount = []string{\"-v\", metaFile + \":/home/claude/.claude/CLAUDE.md:ro\"}\n316: \t\t\t}\n317: \t\t}\n318: \t}\n319: \n320: \t// ── Project skills ────────────────────────────────────────────────────\n321: \t// Project skills (docs/skills/<name>/SKILL.md) need no staging or shadow\n322: \t// mount: the docs bind mount above maps the whole docs/ dir, so\n323: \t// docs/skills/ already lands at the project skills location inside the\n324: \t// container (/workspace/.claude/skills for Claude Code,\n325: \t// /workspace/.opencode/skills for OpenCode), and both CLIs natively prefer\n326: \t// a project skill over a global skill of the same name. Skills differ from\n327: \t// project agents here — agents needed a converted shadow mount over the\n328: \t// docs mount's agents/ subpath for OpenCode (it hard-errors on the\n329: \t// list-form tools: key), while skills need no conversion, so the plain\n330: \t// docs mount is sufficient.\n331: \n332: \t// ── Job prompt ──────────────────────────────────────────────────────────\n333: \tinitialPrompt := \"\"\n334: \tif root.Job != \"\" {\n335: \t\tcontainerJobDir := \"/workspace/docs/jobs/\" + root.Job\n336: \t\tinitialPrompt = \"Please work on the job at \" + containerJobDir + \" — start by reading brief.md\"\n337: \t\tif opts.Print {\n338: \t\t\t// --print sessions are non-interactive and unattended, so they get\n339: \t\t\t// the NEEDS-HUMAN-INPUT marker definition (interactive sessions\n340: \t\t\t// never see this — a human is there to answer questions).\n341: \t\t\tinitialPrompt += \"\\n\\nYou are running non-interactively and unattended — no human is watching this session or able to answer questions. If you cannot proceed without a human decision, stop immediately and print a line starting with exactly `NEEDS-HUMAN-INPUT:` followed by a one-sentence reason, and make no further changes.\"\n342: \t\t}\n343: \t} else if opts.Prompt != \"\" {\n344: \t\tinitialPrompt = opts.Prompt\n345: \t}\n346: \n347: \tvar agentFlag []string\n348: \tif opts.Agent != \"\" {\n349: \t\tagentFlag = []string{\"--agent\", opts.Agent}\n350: \t}\n351: \n352: \t// Claude takes the prompt positionally; OpenCode as --prompt.\n353: \tvar promptArgs []string\n354: \tif initialPrompt != \"\" {\n355: \t\tif info.Tool == config.ToolOpenCode {\n356: \t\t\tpromptArgs = []string{\"--prompt\", initialPrompt}\n357: \t\t} else {\n358: \t\t\tpromptArgs = []string{initialPrompt}\n359: \t\t}\n360: \t}\n361: \n362: \t// ── .env shadow mounts ──────────────────────────────────────────────────\n363: \tvar envMounts []string\n364: \tfor _, envFile := range findEnvFiles(root.ProjectRoot) {\n365: \t\trel := strings.TrimPrefix(envFile, root.ProjectRoot)\n366: \t\tcontainerPath := \"/workspace\" + rel\n367: \t\tfmt.Fprintf(diag, \"  Shadowing: %s → /dev/null inside container\\n\", envFile)\n368: \t\tenvMounts = append(envMounts, \"--mount\", \"type=bind,source=/dev/null,target=\"+containerPath+\",readonly\")\n369: \t}\n370: \tif len(envMounts) == 0 {\n371: \t\tfmt.Fprintln(diag, \"  Shadowed : none (no .env files found)\")\n372: \t}\n373: \n374: \t// ── Flavor quote ────────────────────────────────────────────────────────\n375: \t// Picked once per session from assets/quotes.json; skipped in --print mode\n376: \t// (the entrypoint wouldn't print it anyway). Missing/empty is not an error.\n377: \tquote := \"\"\n378: \tif !opts.Print {\n379: \t\tquote = pickQuote()\n380: \t}\n381: \n382: \t// ── Info banner ─────────────────────────────────────────────────────────\n383: \tfmt.Fprintln(diag, \"╔══════════════════════════════════════╗\")\n384: \tfmt.Fprintln(diag, \"║           manigot                   ║\")\n385: \tfmt.Fprintln(diag, \"╠══════════════════════════════════════╣\")\n386: \tfmt.Fprintln(diag, \"║  Entering safehouse (isolated session)...\")\n387: \tfmt.Fprintf(diag, \"║  Project : %s\\n\", filepath.Base(root.InvocationRoot))\n388: \tfmt.Fprintf(diag, \"║  Root    : %s\\n\", root.ProjectRoot)\n389: \tif root.DocsInitialized {\n390: \t\tfmt.Fprintf(diag, \"║  Docs    : %s\\n\", root.DocsDir)\n391: \t} else {\n392: \t\tfmt.Fprintln(diag, \"║  Docs    : (none — job workflow unavailable, running off the books)\")\n393: \t}\n394: \tif contextFile != \"\" {\n395: \t\tfmt.Fprintf(diag, \"║  Context : %s → %s\\n\", contextFile, contextTarget)\n396: \t}\n397: \tif info.Profile != \"\" {\n398: \t\tfmt.Fprintf(diag, \"║  Profile : %s\\n\", info.Profile)\n399: \t}\n400: \tif info.Tool != \"\" {\n401: \t\tfmt.Fprintf(diag, \"║  Tool    : %s\\n\", info.Tool)\n402: \t}\n403: \tif opts.Agent != \"\" {\n404: \t\tfmt.Fprintf(diag, \"║  Agent   : %s\\n\", opts.Agent)\n405: \t}\n406: \tif root.Job != \"\" {\n407: \t\tfmt.Fprintf(diag, \"║  Job     : %s\\n\", root.Job)\n408: \t}\n409: \tif opts.Print {\n410: \t\tfmt.Fprintln(diag, \"║  Print   : yes (non-interactive)\")\n411: \t}\n412: \tfmt.Fprintln(diag, \"╚══════════════════════════════════════╝\")\n413: \tfmt.Fprintln(diag, \"\")\n414: \n415: \t// ── Assemble the argv ───────────────────────────────────────────────────\n416: \tvar ttyFlags []string\n417: \tif interactive && !opts.Print {\n418: \t\tttyFlags = []string{\"-it\"}\n419: \t}\n420: \n421: \t// ── Git common-dir mount ────────────────────────────────────────────────\n422: \t// Committing agents need the gitdir writable (they commit their work);\n423: \t// non-committing agents get it read-only so they physically cannot touch\n424: \t// git metadata — the hard filesystem boundary behind the soft git shim —\n425: \t// with GIT_OPTIONAL_LOCKS=0 so read commands that would refresh the index\n426: \t// (git status, git diff) don't fail on the ro mount.\n427: \tvar gitDirMount []string\n428: \tvar gitDirEnv []string\n429: \tcommits := agentCommits(opts, root)\n430: \tif root.GitCommonDir != \"\" {\n431: \t\tmode := \"z\"\n432: \t\tif !commits {\n433: \t\t\tmode = \"ro\"\n434: \t\t\tgitDirEnv = []string{\"-e\", \"GIT_OPTIONAL_LOCKS=0\"}\n435: \t\t}\n436: \t\tgitDirMount = []string{\"-v\", root.GitCommonDir + \":\" + root.GitCommonDir + \":\" + mode}\n437: \t}\n438: \n439: \t// ── Gitdir overlay mounts (job-worktree sessions) ───────────────────────\n440: \t// The gitdir mount exposes the whole repository's git metadata; read-only\n441: \t// overlay mounts shadow the sensitive subpaths so an agent cannot corrupt\n442: \t// them. Each overlay skips a missing source — docker would otherwise\n443: \t// create an empty, root-owned directory at the target path.\n444: \tvar gitOverlayMounts []string\n445: \tif root.GitCommonDir != \"\" {\n446: \t\t// hooks/: an agent must not plant a hook that would later execute on\n447: \t\t// host-side git operations (mg done, mg delete) with host privileges.\n448: \t\tif hooksDir := filepath.Join(root.GitCommonDir, \"hooks\"); fs.IsDir(hooksDir) {\n449: \t\t\tgitOverlayMounts = append(gitOverlayMounts, \"-v\", hooksDir+\":\"+hooksDir+\":ro\")\n450: \t\t}\n451: \t\t// worktrees/: every OTHER job's worktree gitdir, so a misbehaving\n452: \t\t// agent cannot delete or corrupt another job's worktree registration.\n453: \t\t// The current job's own worktree gitdir is excluded by the helper —\n454: \t\t// it must stay writable for commits.\n455: \t\tif wtDirs, err := git.WorktreeGitDirs(root.ProjectRoot, root.ProjectRoot); err == nil {\n456: \t\t\tfor _, wtDir := range wtDirs {\n457: \t\t\t\tif !fs.IsDir(wtDir) {\n458: \t\t\t\t\tcontinue\n459: \t\t\t\t}\n460: \t\t\t\tgitOverlayMounts = append(gitOverlayMounts, \"-v\", wtDir+\":\"+wtDir+\":ro\")\n461: \t\t\t}\n462: \t\t}\n463: \t}\n464: \n465: \targv := []string{\"run\"}\n466: \targv = append(argv, ttyFlags...)\n467: \targv = append(argv, \"--rm\")\n468: \targv = append(argv, \"--name\", fmt.Sprintf(\"manigot-%s-%d\", filepath.Base(root.ProjectRoot), os.Getpid()))\n469: \targv = append(argv, \"--user\", fmt.Sprintf(\"%d:%d\", os.Getuid(), os.Getgid()))\n470: \targv = append(argv, \"-v\", root.ProjectRoot+\":/workspace:z\")\n471: \targv = append(argv, gitDirMount...)\n472: \targv = append(argv, gitOverlayMounts...)\n473: \targv = append(argv, docsMount...)\n474: \targv = append(argv, agentMount...)\n475: \targv = append(argv, globalAgentMount...)\n476: \targv = append(argv, globalSkillMount...)\n477: \targv = append(argv, globalMetaMount...)\n478: \targv = append(argv, contextMount...)\n479: \targv = append(argv, envMounts...)\n480: \targv = append(argv, gitDirEnv...)\n481: \targv = append(argv, terminalEnvArgs(info.Tool)...)\n482: \targv = append(argv, info.KeyEnv...)\n483: \targv = append(argv, \"-e\", \"GIT_AUTHOR_NAME_CFG=\"+gitName)\n484: \targv = append(argv, \"-e\", \"GIT_AUTHOR_EMAIL_CFG=\"+gitEmail)\n485: \targv = append(argv, \"-e\", \"MANIGOT_TOOL=\"+info.Tool)\n486: \targv = append(argv, \"-e\", \"MANIGOT_PRINT=\"+strconv.FormatBool(opts.Print))\n487: \targv = append(argv, \"-e\", \"MANIGOT_QUOTE=\"+quote)\n488: \t// MANIGOT_AGENT_COMMITS tells container-side tooling which agent is\n489: \t// running: the `shot` render tool's wrapper guard refuses to run for\n490: \t// non-committing agents (the Claude Code gating layer — OpenCode enforces\n491: \t// the same via permission: blocks), mirroring the git shim's soft layer.\n492: \t// Defaults to true when unset, matching agentCommits' own default so a\n493: \t// missing marker never breaks a committing agent.\n494: \targv = append(argv, \"-e\", \"MANIGOT_AGENT_COMMITS=\"+strconv.FormatBool(commits))\n495: \targv = append(argv, \"--network=bridge\")\n496: \targv = append(argv, \"--memory=2g\")\n497: \targv = append(argv, \"--security-opt=no-new-privileges\")\n498: \targv = append(argv, dockerImageName)\n499: \targv = append(argv, agentFlag...)\n500: \targv = append(argv, promptArgs...)\n501: \targv = append(argv, opts.Pass...)\n502: \n503: \t// Combine the project-agent, global-agent and global-skill temp-dir\n504: \t// cleanups (whichever are non-nil) into a single hook run after the\n505: \t// container exits.\n506: \tvar cleanup func()\n507: \tif agentCleanup != nil || globalAgentCleanup != nil || globalSkillCleanup != nil {\n508: \t\tcleanup = func() {\n509: \t\t\tif agentCleanup != nil {\n510: \t\t\t\tagentCleanup()\n511: \t\t\t}\n512: \t\t\tif globalAgentCleanup != nil {\n513: \t\t\t\tglobalAgentCleanup()\n514: \t\t\t}\n515: \t\t\tif globalSkillCleanup != nil {\n516: \t\t\t\tglobalSkillCleanup()\n517: \t\t\t}\n518: \t\t}\n519: \t}\n520: \n521: \treturn DockerInvocation{Argv: append([]string{\"docker\"}, argv...), Cleanup: cleanup}, nil\n522: }\n523: \n524: // Run executes the assembled docker invocation, wiring stdin/stdout/stderr\n525: // through so Ctrl+C reaches the container, and returns docker's exit code.\n526: // The second return value reports whether docker was actually exec'd — false\n527: // only when the launch itself failed before docker ran (docker missing on\n528: // PATH, permission denied, ...). It is the \"did the container session\n529: // happen\" signal the job-worktree sweep keys off (see SweepJobWorktree): an\n530: // agent that never ran must not trigger a sweep commit. An ExitError — docker\n531: // ran and exited non-zero — still counts as ran=true: the session happened,\n532: // even when the agent's exit code was non-zero.\n533: // The invocation's Cleanup hook (if any) runs after the container exits.\n534: func (d DockerInvocation) Run(stdin *os.File, stdout, stderr io.Writer) (int, bool) {\n535: \tif d.Cleanup != nil {\n536: \t\tdefer d.Cleanup()\n537: \t}\n538: \tcmd := exec.Command(d.Argv[0], d.Argv[1:]...)\n539: \tcmd.Stdin = stdin\n540: \tcmd.Stdout = stdout\n541: \tcmd.Stderr = stderr\n542: \tif err := cmd.Run(); err != nil {\n543: \t\tif exitErr, ok := err.(*exec.ExitError); ok {\n544: \t\t\treturn exitErr.ExitCode(), true\n545: \t\t}\n546: \t\tfmt.Fprintf(stderr, \"mg: %v\\n\", err)\n547: \t\treturn 1, false\n548: \t}\n549: \treturn 0, true\n550: }\n551: \n552: // findEnvFiles lists every .env / .env.* file under root (recursively),\n553: // excluding *.example and *.sample — the shadow-mount targets of run.sh.\n554: func findEnvFiles(root string) []string {\n555: \tvar files []string\n556: \tfilepath.WalkDir(root, func(path string, d os.DirEntry, err error) error {\n557: \t\tif err != nil {\n558: \t\t\treturn nil\n559: \t\t}\n560: \t\tif d.IsDir() {\n561: \t\t\treturn nil\n562: \t\t}\n563: \t\tname := d.Name()\n564: \t\tif name != \".env\" && !strings.HasPrefix(name, \".env.\") {\n565: \t\t\treturn nil\n566: \t\t}\n567: \t\tif strings.HasSuffix(name, \".example\") || strings.HasSuffix(name, \".sample\") {\n568: \t\t\treturn nil\n569: \t\t}\n570: \t\tfiles = append(files, path)\n571: \t\treturn nil\n572: \t})\n573: \treturn files\n574: }\n575: \n576: // pickQuote parses assets/quotes.json (a JSON array of strings) and returns a\n577: // random entry, or \"\" when the file is missing or unparseable — missing/empty\n578: // just means no quote this session, not an error.\n579: func pickQuote() string {\n580: \thome := home.Root()\n581: \tif home == \"\" {\n582: \t\treturn \"\"\n583: \t}\n584: \tdata, err := os.ReadFile(filepath.Join(home, \"assets\", \"quotes.json\"))\n585: \tif err != nil {\n586: \t\treturn \"\"\n587: \t}\n588: \tvar quotes []string\n589: \tif err := json.Unmarshal(data, &quotes); err != nil {\n590: \t\treturn \"\"\n591: \t}\n592: \tif len(quotes) == 0 {\n593: \t\treturn \"\"\n594: \t}\n595: \treturn quotes[rand.IntN(len(quotes))]\n596: }\n\n(End of file - total 596 lines)\n</content>","metadata":{"preview":"package session\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"math/rand/v2\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/fs\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/home\"\n)\n\n// DockerInvocation is a fully assembled `docker run` command.","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/session/docker.go","text":"package session\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"math/rand/v2\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/fs\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/home\"\n)\n\n// DockerInvocation is a fully assembled `docker run` command.\ntype DockerInvocation struct {\n\t// Argv is the complete argument vector: [\"docker\", \"run\", ...].\n\tArgv []string\n\n\t// Cleanup removes any host-side resources the invocation created (e.g.\n\t// the converted-project-agents temp dir shadow-mounted over the docs\n\t// mount's agents/ subpath — see BuildDockerInvocation's agentMount\n\t// block). Run defers it so every caller — the interactive `mg` session\n\t// path and `mg jdi`'s --print runs alike — gets the cleanup for free\n\t// without having to know about it. nil when there is nothing to clean\n\t// up.\n\tCleanup func()\n}\n\n// dockerImageName is the container image run.sh launched.\nconst dockerImageName = \"manigot\"\n\n// terminalEnvVars lists the host terminal-identity variables forwarded into\n// the container so the in-container agent TUIs see the real terminal. TUIs\n// gate their copy/clipboard behavior on these: OSC 52 emission is decided\n// from terminal identity/capability vars (TERM, COLORTERM, TERM_PROGRAM,\n// TERM_PROGRAM_VERSION, VTE_VERSION, KITTY_WINDOW_ID, TMUX, TMUX_PANE,\n// WT_SESSION — plus the WEZTERM_* family, which WezTerm sets several of).\n// None of these were forwarded before, so the in-container TUIs saw an\n// unrecognized terminal and copying from agent output silently failed (see\n// the \"Clipboard / copying from agent sessions\" docs section).\n//\n// TMUX/TMUX_PANE are deliberately NOT forwarded for OpenCode sessions\n// (terminalEnvArgs skips them when the tool is OpenCode): when OpenCode sees\n// TMUX set it wraps its OSC 52 clipboard write in tmux's DCS-passthrough\n// escape, which default tmux configuration discards entirely\n// (allow-passthrough defaults to off), so the host clipboard is never\n// touched. Stripping TMUX makes OpenCode emit plain OSC 52, which tmux's\n// set-clipboard on handles correctly. Claude Code's container env stays\n// byte-identical — TMUX/TMUX_PANE are still forwarded for it.\n//\n// Each var is forwarded only when set and non-empty on the host — never an\n// empty value — so a session launched outside a terminal (CI, a script)\n// keeps a byte-identical argv to a build without this feature.\nvar terminalEnvVars = []string{\n\t\"TERM\",\n\t\"COLORTERM\",\n\t\"TERM_PROGRAM\",\n\t\"TERM_PROGRAM_VERSION\",\n\t\"VTE_VERSION\",\n\t\"KITTY_WINDOW_ID\",\n\t\"TMUX\",\n\t\"TMUX_PANE\",\n\t\"WT_SESSION\",\n}\n\n// tmuxEnvVars are the terminal-identity vars whose forwarding is gated on\n// the resolved tool: they are sent only to Claude Code, never to OpenCode\n// (see the comment on terminalEnvVars for why).\nvar tmuxEnvVars = map[string]bool{\n\t\"TMUX\":      true,\n\t\"TMUX_PANE\": true,\n}\n\n// terminalEnvArgs returns the docker -e entries forwarding the host's\n// terminal identity into the container: every terminalEnvVars entry that is\n// set and non-empty on the host, plus every WEZTERM_* variable (also only\n// when set to a non-empty value). TMUX/TMUX_PANE are skipped when tool is\n// OpenCode (see terminalEnvVars). No var set → an empty slice, keeping the\n// docker argv byte-identical to a session built without terminal forwarding.\nfunc terminalEnvArgs(tool string) []string {\n\tvar args []string\n\tfor _, key := range terminalEnvVars {\n\t\tif tmuxEnvVars[key] && tool == config.ToolOpenCode {\n\t\t\tcontinue\n\t\t}\n\t\tif v := os.Getenv(key); v != \"\" {\n\t\t\targs = append(args, \"-e\", key+\"=\"+v)\n\t\t}\n\t}\n\tfor _, kv := range os.Environ() {\n\t\tname, value, ok := strings.Cut(kv, \"=\")\n\t\tif ok && strings.HasPrefix(name, \"WEZTERM_\") && value != \"\" {\n\t\t\targs = append(args, \"-e\", kv)\n\t\t}\n\t}\n\treturn args\n}\n\n// warnTmuxClipboard detects the tmux clipboard-interception failure mode at\n// session start and warns on diag (stderr — the diagnostics stream): when the\n// session is interactive (a TUI to copy from — --print/mg-jdi runs capture\n// JSON output instead, so the check is skipped), the host is inside tmux\n// ($TMUX set) and tmux is on PATH, `tmux show-options -g set-clipboard` is\n// run; if it reports off, tmux will strip the OSC 52 clipboard writes the\n// in-container TUIs emit, so copying from the agent shows \"copied\" but never\n// reaches the host clipboard. Strictly read-only: no tmux state is mutated,\n// and any tmux failure (not installed, no server, an option query error)\n// silently skips the check — no launch path can break because of it.\nfunc warnTmuxClipboard(diag io.Writer, interactive, print bool) {\n\tif !interactive || print {\n\t\treturn\n\t}\n\tif os.Getenv(\"TMUX\") == \"\" {\n\t\treturn\n\t}\n\tif _, err := exec.LookPath(\"tmux\"); err != nil {\n\t\treturn\n\t}\n\tout, err := exec.Command(\"tmux\", \"show-options\", \"-g\", \"set-clipboard\").Output()\n\tif err != nil {\n\t\treturn\n\t}\n\tif strings.TrimSpace(string(out)) == \"set-clipboard off\" {\n\t\tfmt.Fprintln(diag, \"Warning: your tmux has set-clipboard off — it will swallow OSC 52 clipboard writes from the agent, so copying inside the session won't reach your host clipboard.\")\n\t\tfmt.Fprintln(diag, \"         Run 'tmux set -g set-clipboard on' to fix it (see the 'Clipboard / copying from agent sessions' docs section).\")\n\t}\n}\n\n// BuildDockerInvocation assembles the docker run argv, mirroring run.sh's\n// launch construction — every flag, mount, and env\n// var is load-bearing, so the argument order and exact strings are pinned by\n// the tests. Diagnostics (banner, warnings, shadowing lines) are written to\n// diag — always stderr, per the brief's note 1 (the script's fd-3 juggling\n// existed only to keep --print stdout clean; Go separates the streams\n// natively). interactive controls the -it flag (stdin is a terminal).\nfunc BuildDockerInvocation(opts Options, info ProfileInfo, root Root, interactive bool, diag io.Writer) (DockerInvocation, error) {\n\t// The .env warning run.sh printed when the file was missing.\n\tif envFile := config.EnvFile(); envFile != \"\" {\n\t\tif _, err := os.Stat(envFile); err != nil {\n\t\t\tfmt.Fprintf(diag, \"Warning: no .env found at %s\\n\", envFile)\n\t\t}\n\t}\n\n\t// The tmux OSC 52 clipboard-interception warning (TASK-2 of the clipboard\n\t// job): strictly read-only, failures silently skipped.\n\twarnTmuxClipboard(diag, interactive, opts.Print)\n\n\t// ── Git identity ─────────────────────────────────────────────────────────\n\t// Host GIT_AUTHOR_NAME/EMAIL env vars win; otherwise fall back to the\n\t// project's git config (local overrides global, matching git behavior).\n\tgitName := os.Getenv(\"GIT_AUTHOR_NAME\")\n\tif gitName == \"\" {\n\t\tgitName = git.ConfigUserName(root.ProjectRoot)\n\t}\n\tgitEmail := os.Getenv(\"GIT_AUTHOR_EMAIL\")\n\tif gitEmail == \"\" {\n\t\tgitEmail = git.ConfigEmail(root.ProjectRoot)\n\t}\n\tif gitName == \"\" || gitEmail == \"\" {\n\t\tfmt.Fprintln(diag, \"Warning: no git user.name/user.email configured for this project — container commits will fall back to a generic 'manigot' identity.\")\n\t}\n\n\t// ── Docs mount target + context file ────────────────────────────────────\n\tdocsMountTarget := \"/workspace/.claude\"\n\tif info.Tool == config.ToolOpenCode {\n\t\tdocsMountTarget = \"/workspace/.opencode\"\n\t}\n\n\tcontextFile := \"\"\n\tif fs.IsFile(filepath.Join(root.DocsDir, \"AGENTS.md\")) {\n\t\tcontextFile = filepath.Join(root.DocsDir, \"AGENTS.md\")\n\t} else if fs.IsFile(filepath.Join(root.DocsDir, \"CLAUDE.md\")) {\n\t\tcontextFile = filepath.Join(root.DocsDir, \"CLAUDE.md\")\n\t}\n\n\tvar contextMount []string\n\tcontextTarget := \"\"\n\tif contextFile != \"\" {\n\t\tif info.Tool == config.ToolOpenCode {\n\t\t\tcontextTarget = \"/workspace/AGENTS.md\"\n\t\t} else {\n\t\t\tcontextTarget = \"/workspace/.claude/CLAUDE.md\"\n\t\t}\n\t\tcontextMount = []string{\"-v\", contextFile + \":\" + contextTarget + \":ro\"}\n\t} else if root.DocsInitialized {\n\t\tfmt.Fprintf(diag, \"Warning: no docs/AGENTS.md found — the agent will start without project context.\\n\")\n\t} else {\n\t\tfmt.Fprintln(diag, \"Note: no docs/ directory — starting a plain session with no project context or job workflow.\")\n\t\tfmt.Fprintln(diag, \"      See 'Per-project setup' in the manigot README to enable them.\")\n\t}\n\n\tvar docsMount []string\n\tif fs.IsDir(root.DocsDir) {\n\t\tdocsMount = []string{\"-v\", root.DocsDir + \":\" + docsMountTarget + \":z\"}\n\t}\n\n\t// ── Project agents ─────────────────────────────────────────────────────\n\t// docs/agents/ rides along inside the docs mount above — fine for Claude\n\t// Code, whose subagent schema the list-form frontmatter already is, but\n\t// OpenCode hard-errors on the list-form tools: key (see convertAgents),\n\t// so custom project agents must be converted before the container sees\n\t// them. The converted copies land in a temp dir shadow-mounted over the\n\t// docs mount's agents/ subpath; the host's docs/agents/ source tree is\n\t// never modified. The temp dir is removed via the invocation's Cleanup\n\t// hook (see DockerInvocation.Run).\n\tvar agentMount []string\n\tvar agentCleanup func()\n\tif tmp, hasAgents, err := convertAgents(filepath.Join(root.DocsDir, \"agents\"), info.Tool); err != nil {\n\t\treturn DockerInvocation{}, fmt.Errorf(\"convert project agents: %w\", err)\n\t} else if hasAgents {\n\t\tagentMount = []string{\"-v\", tmp + \":/workspace/.opencode/agents:z\"}\n\t\tagentCleanup = func() { os.RemoveAll(tmp) }\n\t}\n\n\t// ── Global agents ─────────────────────────────────────────────────────\n\t// The global agents dir (<home>/agents/) is no longer baked into the\n\t// image — it lives on the host in the manigot checkout and is mounted\n\t// read-only into the container at the CLI's global agent location, so the\n\t// container can use the host's agents but cannot modify them. This keeps\n\t// the image purely isolation for workspaces and makes the same agents\n\t// available to `mg host` (see host.go). Project agents (docs/agents/,\n\t// above) still ride the docs mount and override global agents of the same\n\t// name, exactly as before.\n\t//\n\t// Claude Code reads global subagents from ~/.claude/agents/ and takes the\n\t// list-form frontmatter natively, so the host's files mount verbatim.\n\t// OpenCode reads global agents from ~/.config/opencode/agents/ and\n\t// hard-errors on the list-form tools: key, so the mounted files are\n\t// converted first (name:/tools: stripped, permission: passed through —\n\t// see convertAgents) into a temp dir shadow-mounted over the CLI's global\n\t// agents path, cleaned up via the invocation's Cleanup hook.\n\tvar globalAgentMount []string\n\tvar globalAgentCleanup func()\n\tif homeDir := home.Root(); homeDir != \"\" {\n\t\tglobalAgentsDir := filepath.Join(homeDir, \"agents\")\n\t\tif fs.IsDir(globalAgentsDir) {\n\t\t\tif info.Tool == config.ToolOpenCode {\n\t\t\t\tif tmp, hasAgents, err := convertAgents(globalAgentsDir, info.Tool); err != nil {\n\t\t\t\t\treturn DockerInvocation{}, fmt.Errorf(\"convert global agents: %w\", err)\n\t\t\t\t} else if hasAgents {\n\t\t\t\t\tglobalAgentMount = []string{\"-v\", tmp + \":/home/claude/.config/opencode/agents:ro\"}\n\t\t\t\t\tglobalAgentCleanup = func() { os.RemoveAll(tmp) }\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tglobalAgentMount = []string{\"-v\", globalAgentsDir + \":/home/claude/.claude/agents:ro\"}\n\t\t\t}\n\t\t}\n\t}\n\n\t// ── Global skills ─────────────────────────────────────────────────────\n\t// Skills follow the same global + project model as agents, applied to a\n\t// different unit: a skill is a directory (SKILL.md plus support files),\n\t// not a single file. Global skills live in the manigot checkout\n\t// (<home>/skills/) and are mounted read-only into the container at the\n\t// CLI's global skills location — ~/.claude/skills for Claude Code,\n\t// ~/.config/opencode/skills for OpenCode — where both CLIs load skills at\n\t// startup, independent of the active agent. That single global location is\n\t// exactly what makes a skill available to every agent and to invocations\n\t// that name no agent; project skills (docs/skills/, below) ride the docs\n\t// mount and override global skills of the same name.\n\t//\n\t// Unlike agents, skills need no frontmatter conversion — both CLIs read\n\t// SKILL.md and its frontmatter natively — so Claude Code gets the host's\n\t// skills dir verbatim (a read-only bind, like its agents mount). OpenCode\n\t// gets a staged copy instead (see stageGlobalSkills), mounted read-only\n\t// and cleaned up via the invocation's Cleanup hook, so the CLI's skills\n\t// dir is a fresh, disposable snapshot and the host's skills/ source tree\n\t// is never touched. Skipped cleanly when the checkout has no skills dir.\n\tvar globalSkillMount []string\n\tvar globalSkillCleanup func()\n\tif homeDir := home.Root(); homeDir != \"\" {\n\t\tglobalSkillsDir := filepath.Join(homeDir, \"skills\")\n\t\tif fs.IsDir(globalSkillsDir) {\n\t\t\tif info.Tool == config.ToolOpenCode {\n\t\t\t\tif tmp, hasSkills, err := stageGlobalSkills(globalSkillsDir); err != nil {\n\t\t\t\t\treturn DockerInvocation{}, fmt.Errorf(\"stage global skills: %w\", err)\n\t\t\t\t} else if hasSkills {\n\t\t\t\t\tglobalSkillMount = []string{\"-v\", tmp + \":/home/claude/.config/opencode/skills:ro\"}\n\t\t\t\t\tglobalSkillCleanup = func() { os.RemoveAll(tmp) }\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tglobalSkillMount = []string{\"-v\", globalSkillsDir + \":/home/claude/.claude/skills:ro\"}\n\t\t\t}\n\t\t}\n\t}\n\n\t// ── Global meta prompt ─────────────────────────────────────────────────\n\t// The meta prompt (<home>/prompts/meta.md) is a system-wide instruction file that\n\t// sits *above* agents and skills in the instruction hierarchy: it is\n\t// injected into every session, regardless of agent, project, or\n\t// interactive/--print mode. Each CLI loads it from its *global\n\t// instruction* location — ~/.claude/CLAUDE.md for Claude Code (the\n\t// user-global memory file, loaded before the project context at\n\t// /workspace/.claude/CLAUDE.md) and ~/.config/opencode/AGENTS.md for\n\t// OpenCode (the global rules file, loaded alongside the project context\n\t// mount) — so the project context still wins on conflict.\n\t//\n\t// Like skills, the file is plain markdown native to both CLIs, so no\n\t// conversion and no temp dir are needed (and thus no Cleanup hook): the\n\t// checkout file is mounted read-only at the per-tool target. A checkout\n\t// without prompts/meta.md yields no mount (it is optional, like skills).\n\tvar globalMetaMount []string\n\tif homeDir := home.Root(); homeDir != \"\" {\n\t\tmetaFile := filepath.Join(homeDir, \"prompts\", \"meta.md\")\n\t\tif fs.IsFile(metaFile) {\n\t\t\tif info.Tool == config.ToolOpenCode {\n\t\t\t\tglobalMetaMount = []string{\"-v\", metaFile + \":/home/claude/.config/opencode/AGENTS.md:ro\"}\n\t\t\t} else {\n\t\t\t\tglobalMetaMount = []string{\"-v\", metaFile + \":/home/claude/.claude/CLAUDE.md:ro\"}\n\t\t\t}\n\t\t}\n\t}\n\n\t// ── Project skills ────────────────────────────────────────────────────\n\t// Project skills (docs/skills/<name>/SKILL.md) need no staging or shadow\n\t// mount: the docs bind mount above maps the whole docs/ dir, so\n\t// docs/skills/ already lands at the project skills location inside the\n\t// container (/workspace/.claude/skills for Claude Code,\n\t// /workspace/.opencode/skills for OpenCode), and both CLIs natively prefer\n\t// a project skill over a global skill of the same name. Skills differ from\n\t// project agents here — agents needed a converted shadow mount over the\n\t// docs mount's agents/ subpath for OpenCode (it hard-errors on the\n\t// list-form tools: key), while skills need no conversion, so the plain\n\t// docs mount is sufficient.\n\n\t// ── Job prompt ──────────────────────────────────────────────────────────\n\tinitialPrompt := \"\"\n\tif root.Job != \"\" {\n\t\tcontainerJobDir := \"/workspace/docs/jobs/\" + root.Job\n\t\tinitialPrompt = \"Please work on the job at \" + containerJobDir + \" — start by reading brief.md\"\n\t\tif opts.Print {\n\t\t\t// --print sessions are non-interactive and unattended, so they get\n\t\t\t// the NEEDS-HUMAN-INPUT marker definition (interactive sessions\n\t\t\t// never see this — a human is there to answer questions).\n\t\t\tinitialPrompt += \"\\n\\nYou are running non-interactively and unattended — no human is watching this session or able to answer questions. If you cannot proceed without a human decision, stop immediately and print a line starting with exactly `NEEDS-HUMAN-INPUT:` followed by a one-sentence reason, and make no further changes.\"\n\t\t}\n\t} else if opts.Prompt != \"\" {\n\t\tinitialPrompt = opts.Prompt\n\t}\n\n\tvar agentFlag []string\n\tif opts.Agent != \"\" {\n\t\tagentFlag = []string{\"--agent\", opts.Agent}\n\t}\n\n\t// Claude takes the prompt positionally; OpenCode as --prompt.\n\tvar promptArgs []string\n\tif initialPrompt != \"\" {\n\t\tif info.Tool == config.ToolOpenCode {\n\t\t\tpromptArgs = []string{\"--prompt\", initialPrompt}\n\t\t} else {\n\t\t\tpromptArgs = []string{initialPrompt}\n\t\t}\n\t}\n\n\t// ── .env shadow mounts ──────────────────────────────────────────────────\n\tvar envMounts []string\n\tfor _, envFile := range findEnvFiles(root.ProjectRoot) {\n\t\trel := strings.TrimPrefix(envFile, root.ProjectRoot)\n\t\tcontainerPath := \"/workspace\" + rel\n\t\tfmt.Fprintf(diag, \"  Shadowing: %s → /dev/null inside container\\n\", envFile)\n\t\tenvMounts = append(envMounts, \"--mount\", \"type=bind,source=/dev/null,target=\"+containerPath+\",readonly\")\n\t}\n\tif len(envMounts) == 0 {\n\t\tfmt.Fprintln(diag, \"  Shadowed : none (no .env files found)\")\n\t}\n\n\t// ── Flavor quote ────────────────────────────────────────────────────────\n\t// Picked once per session from assets/quotes.json; skipped in --print mode\n\t// (the entrypoint wouldn't print it anyway). Missing/empty is not an error.\n\tquote := \"\"\n\tif !opts.Print {\n\t\tquote = pickQuote()\n\t}\n\n\t// ── Info banner ─────────────────────────────────────────────────────────\n\tfmt.Fprintln(diag, \"╔══════════════════════════════════════╗\")\n\tfmt.Fprintln(diag, \"║           manigot                   ║\")\n\tfmt.Fprintln(diag, \"╠══════════════════════════════════════╣\")\n\tfmt.Fprintln(diag, \"║  Entering safehouse (isolated session)...\")\n\tfmt.Fprintf(diag, \"║  Project : %s\\n\", filepath.Base(root.InvocationRoot))\n\tfmt.Fprintf(diag, \"║  Root    : %s\\n\", root.ProjectRoot)\n\tif root.DocsInitialized {\n\t\tfmt.Fprintf(diag, \"║  Docs    : %s\\n\", root.DocsDir)\n\t} else {\n\t\tfmt.Fprintln(diag, \"║  Docs    : (none — job workflow unavailable, running off the books)\")\n\t}\n\tif contextFile != \"\" {\n\t\tfmt.Fprintf(diag, \"║  Context : %s → %s\\n\", contextFile, contextTarget)\n\t}\n\tif info.Profile != \"\" {\n\t\tfmt.Fprintf(diag, \"║  Profile : %s\\n\", info.Profile)\n\t}\n\tif info.Tool != \"\" {\n\t\tfmt.Fprintf(diag, \"║  Tool    : %s\\n\", info.Tool)\n\t}\n\tif opts.Agent != \"\" {\n\t\tfmt.Fprintf(diag, \"║  Agent   : %s\\n\", opts.Agent)\n\t}\n\tif root.Job != \"\" {\n\t\tfmt.Fprintf(diag, \"║  Job     : %s\\n\", root.Job)\n\t}\n\tif opts.Print {\n\t\tfmt.Fprintln(diag, \"║  Print   : yes (non-interactive)\")\n\t}\n\tfmt.Fprintln(diag, \"╚══════════════════════════════════════╝\")\n\tfmt.Fprintln(diag, \"\")\n\n\t// ── Assemble the argv ───────────────────────────────────────────────────\n\tvar ttyFlags []string\n\tif interactive && !opts.Print {\n\t\tttyFlags = []string{\"-it\"}\n\t}\n\n\t// ── Git common-dir mount ────────────────────────────────────────────────\n\t// Committing agents need the gitdir writable (they commit their work);\n\t// non-committing agents get it read-only so they physically cannot touch\n\t// git metadata — the hard filesystem boundary behind the soft git shim —\n\t// with GIT_OPTIONAL_LOCKS=0 so read commands that would refresh the index\n\t// (git status, git diff) don't fail on the ro mount.\n\tvar gitDirMount []string\n\tvar gitDirEnv []string\n\tcommits := agentCommits(opts, root)\n\tif root.GitCommonDir != \"\" {\n\t\tmode := \"z\"\n\t\tif !commits {\n\t\t\tmode = \"ro\"\n\t\t\tgitDirEnv = []string{\"-e\", \"GIT_OPTIONAL_LOCKS=0\"}\n\t\t}\n\t\tgitDirMount = []string{\"-v\", root.GitCommonDir + \":\" + root.GitCommonDir + \":\" + mode}\n\t}\n\n\t// ── Gitdir overlay mounts (job-worktree sessions) ───────────────────────\n\t// The gitdir mount exposes the whole repository's git metadata; read-only\n\t// overlay mounts shadow the sensitive subpaths so an agent cannot corrupt\n\t// them. Each overlay skips a missing source — docker would otherwise\n\t// create an empty, root-owned directory at the target path.\n\tvar gitOverlayMounts []string\n\tif root.GitCommonDir != \"\" {\n\t\t// hooks/: an agent must not plant a hook that would later execute on\n\t\t// host-side git operations (mg done, mg delete) with host privileges.\n\t\tif hooksDir := filepath.Join(root.GitCommonDir, \"hooks\"); fs.IsDir(hooksDir) {\n\t\t\tgitOverlayMounts = append(gitOverlayMounts, \"-v\", hooksDir+\":\"+hooksDir+\":ro\")\n\t\t}\n\t\t// worktrees/: every OTHER job's worktree gitdir, so a misbehaving\n\t\t// agent cannot delete or corrupt another job's worktree registration.\n\t\t// The current job's own worktree gitdir is excluded by the helper —\n\t\t// it must stay writable for commits.\n\t\tif wtDirs, err := git.WorktreeGitDirs(root.ProjectRoot, root.ProjectRoot); err == nil {\n\t\t\tfor _, wtDir := range wtDirs {\n\t\t\t\tif !fs.IsDir(wtDir) {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tgitOverlayMounts = append(gitOverlayMounts, \"-v\", wtDir+\":\"+wtDir+\":ro\")\n\t\t\t}\n\t\t}\n\t}\n\n\targv := []string{\"run\"}\n\targv = append(argv, ttyFlags...)\n\targv = append(argv, \"--rm\")\n\targv = append(argv, \"--name\", fmt.Sprintf(\"manigot-%s-%d\", filepath.Base(root.ProjectRoot), os.Getpid()))\n\targv = append(argv, \"--user\", fmt.Sprintf(\"%d:%d\", os.Getuid(), os.Getgid()))\n\targv = append(argv, \"-v\", root.ProjectRoot+\":/workspace:z\")\n\targv = append(argv, gitDirMount...)\n\targv = append(argv, gitOverlayMounts...)\n\targv = append(argv, docsMount...)\n\targv = append(argv, agentMount...)\n\targv = append(argv, globalAgentMount...)\n\targv = append(argv, globalSkillMount...)\n\targv = append(argv, globalMetaMount...)\n\targv = append(argv, contextMount...)\n\targv = append(argv, envMounts...)\n\targv = append(argv, gitDirEnv...)\n\targv = append(argv, terminalEnvArgs(info.Tool)...)\n\targv = append(argv, info.KeyEnv...)\n\targv = append(argv, \"-e\", \"GIT_AUTHOR_NAME_CFG=\"+gitName)\n\targv = append(argv, \"-e\", \"GIT_AUTHOR_EMAIL_CFG=\"+gitEmail)\n\targv = append(argv, \"-e\", \"MANIGOT_TOOL=\"+info.Tool)\n\targv = append(argv, \"-e\", \"MANIGOT_PRINT=\"+strconv.FormatBool(opts.Print))\n\targv = append(argv, \"-e\", \"MANIGOT_QUOTE=\"+quote)\n\t// MANIGOT_AGENT_COMMITS tells container-side tooling which agent is\n\t// running: the `shot` render tool's wrapper guard refuses to run for\n\t// non-committing agents (the Claude Code gating layer — OpenCode enforces\n\t// the same via permission: blocks), mirroring the git shim's soft layer.\n\t// Defaults to true when unset, matching agentCommits' own default so a\n\t// missing marker never breaks a committing agent.\n\targv = append(argv, \"-e\", \"MANIGOT_AGENT_COMMITS=\"+strconv.FormatBool(commits))\n\targv = append(argv, \"--network=bridge\")\n\targv = append(argv, \"--memory=2g\")\n\targv = append(argv, \"--security-opt=no-new-privileges\")\n\targv = append(argv, dockerImageName)\n\targv = append(argv, agentFlag...)\n\targv = append(argv, promptArgs...)\n\targv = append(argv, opts.Pass...)\n\n\t// Combine the project-agent, global-agent and global-skill temp-dir\n\t// cleanups (whichever are non-nil) into a single hook run after the\n\t// container exits.\n\tvar cleanup func()\n\tif agentCleanup != nil || globalAgentCleanup != nil || globalSkillCleanup != nil {\n\t\tcleanup = func() {\n\t\t\tif agentCleanup != nil {\n\t\t\t\tagentCleanup()\n\t\t\t}\n\t\t\tif globalAgentCleanup != nil {\n\t\t\t\tglobalAgentCleanup()\n\t\t\t}\n\t\t\tif globalSkillCleanup != nil {\n\t\t\t\tglobalSkillCleanup()\n\t\t\t}\n\t\t}\n\t}\n\n\treturn DockerInvocation{Argv: append([]string{\"docker\"}, argv...), Cleanup: cleanup}, nil\n}\n\n// Run executes the assembled docker invocation, wiring stdin/stdout/stderr\n// through so Ctrl+C reaches the container, and returns docker's exit code.\n// The second return value reports whether docker was actually exec'd — false\n// only when the launch itself failed before docker ran (docker missing on\n// PATH, permission denied, ...). It is the \"did the container session\n// happen\" signal the job-worktree sweep keys off (see SweepJobWorktree): an\n// agent that never ran must not trigger a sweep commit. An ExitError — docker\n// ran and exited non-zero — still counts as ran=true: the session happened,\n// even when the agent's exit code was non-zero.\n// The invocation's Cleanup hook (if any) runs after the container exits.\nfunc (d DockerInvocation) Run(stdin *os.File, stdout, stderr io.Writer) (int, bool) {\n\tif d.Cleanup != nil {\n\t\tdefer d.Cleanup()\n\t}\n\tcmd := exec.Command(d.Argv[0], d.Argv[1:]...)\n\tcmd.Stdin = stdin\n\tcmd.Stdout = stdout\n\tcmd.Stderr = stderr\n\tif err := cmd.Run(); err != nil {\n\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n\t\t\treturn exitErr.ExitCode(), true\n\t\t}\n\t\tfmt.Fprintf(stderr, \"mg: %v\\n\", err)\n\t\treturn 1, false\n\t}\n\treturn 0, true\n}\n\n// findEnvFiles lists every .env / .env.* file under root (recursively),\n// excluding *.example and *.sample — the shadow-mount targets of run.sh.\nfunc findEnvFiles(root string) []string {\n\tvar files []string\n\tfilepath.WalkDir(root, func(path string, d os.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treturn nil\n\t\t}\n\t\tif d.IsDir() {\n\t\t\treturn nil\n\t\t}\n\t\tname := d.Name()\n\t\tif name != \".env\" && !strings.HasPrefix(name, \".env.\") {\n\t\t\treturn nil\n\t\t}\n\t\tif strings.HasSuffix(name, \".example\") || strings.HasSuffix(name, \".sample\") {\n\t\t\treturn nil\n\t\t}\n\t\tfiles = append(files, path)\n\t\treturn nil\n\t})\n\treturn files\n}\n\n// pickQuote parses assets/quotes.json (a JSON array of strings) and returns a\n// random entry, or \"\" when the file is missing or unparseable — missing/empty\n// just means no quote this session, not an error.\nfunc pickQuote() string {\n\thome := home.Root()\n\tif home == \"\" {\n\t\treturn \"\"\n\t}\n\tdata, err := os.ReadFile(filepath.Join(home, \"assets\", \"quotes.json\"))\n\tif err != nil {\n\t\treturn \"\"\n\t}\n\tvar quotes []string\n\tif err := json.Unmarshal(data, &quotes); err != nil {\n\t\treturn \"\"\n\t}\n\tif len(quotes) == 0 {\n\t\treturn \"\"\n\t}\n\treturn quotes[rand.IntN(len(quotes))]\n}","lineStart":1,"lineEnd":596,"totalLines":596,"truncated":false}},"title":"src/internal/session/docker.go","time":{"start":1787920066061,"end":1787920066065}},"id":"prt_048572530001Qx87ctXCcdDI5v","sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","messageID":"msg_048571c7f001ARuZsDar8NxQTc"}}
{"type":"tool_use","timestamp":1787920066085,"sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","part":{"type":"tool","tool":"read","callID":"call_01_ouMl2Jk66jhEvbvIRkbT9815","state":{"status":"completed","input":{"filePath":"/workspace/src/cmd/mg/jdi_test.go"},"output":"<path>/workspace/src/cmd/mg/jdi_test.go</path>\n<type>file</type>\n<content>\n1: package main\n2: \n3: import (\n4: \t\"bytes\"\n5: \t\"errors\"\n6: \t\"fmt\"\n7: \t\"io\"\n8: \t\"net/http\"\n9: \t\"net/http/httptest\"\n10: \t\"os\"\n11: \t\"os/exec\"\n12: \t\"path/filepath\"\n13: \t\"strings\"\n14: \t\"testing\"\n15: \t\"time\"\n16: \n17: \t\"github.com/lmuskalla/manigot/internal/git\"\n18: \t\"github.com/lmuskalla/manigot/internal/job\"\n19: \t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n20: \t\"github.com/lmuskalla/manigot/internal/session\"\n21: )\n22: \n23: // runGit runs git -C dir args, failing the test on any error — mirrors\n24: // tui/internal/git's own test helper, duplicated here since it is\n25: // unexported in that package.\n26: func runGit(t *testing.T, dir string, args ...string) {\n27: \tt.Helper()\n28: \tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n29: \tif out, err := cmd.CombinedOutput(); err != nil {\n30: \t\tt.Fatalf(\"git %s in %s: %v\\n%s\", strings.Join(args, \" \"), dir, err, out)\n31: \t}\n32: }\n33: \n34: // initTestRepo creates a fresh git repo at a temp dir with a job scaffold\n35: // (brief.md only — tasks/implementation/verdict are written by the fake\n36: // runner as the loop progresses) on its own job branch, and returns the\n37: // job.Job ready to hand to Run.\n38: func initTestRepo(t *testing.T) (root string, j job.Job) {\n39: \tt.Helper()\n40: \troot = t.TempDir()\n41: \trunGit(t, root, \"init\", \"-q\")\n42: \trunGit(t, root, \"config\", \"user.email\", \"t@example.com\")\n43: \trunGit(t, root, \"config\", \"user.name\", \"Test\")\n44: \trunGit(t, root, \"config\", \"commit.gpgsign\", \"false\")\n45: \n46: \tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n47: \t\tt.Fatal(err)\n48: \t}\n49: \tif err := os.WriteFile(filepath.Join(root, \"README\"), []byte(\"init\\n\"), 0o644); err != nil {\n50: \t\tt.Fatal(err)\n51: \t}\n52: \trunGit(t, root, \"add\", \"README\")\n53: \trunGit(t, root, \"commit\", \"-q\", \"-m\", \"init\")\n54: \n55: \tconst jobName = \"aaaa01_test-job\"\n56: \tconst branch = \"feature/aaaa01_test-job\"\n57: \tjobDir := filepath.Join(root, \"docs\", \"jobs\", jobName)\n58: \tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n59: \t\tt.Fatal(err)\n60: \t}\n61: \tbrief := \"# Brief: test job\\n\\nstatus: open\\ntype: feature\\nid: aaaa01\\nbranch: \" + branch + \"\\n\\n\" +\n62: \t\t\"## What\\n\\nsomething substantial enough to count as written\\nand a second line so isWritten's rule is satisfied\\n\"\n63: \tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n64: \t\tt.Fatal(err)\n65: \t}\n66: \trunGit(t, root, \"checkout\", \"-q\", \"-b\", branch)\n67: \trunGit(t, root, \"add\", \"-A\")\n68: \trunGit(t, root, \"commit\", \"-q\", \"-m\", \"[aaaa01] scaffold job\")\n69: \n70: \tj = job.Job{\n71: \t\tName:   jobName,\n72: \t\tDir:    jobDir,\n73: \t\tRoot:   root,\n74: \t\tID:     \"aaaa01\",\n75: \t\tBranch: branch,\n76: \t}\n77: \treturn root, j\n78: }\n79: \n80: // initLinkedWorktreeRepo creates a fresh git repo whose job branch is checked\n81: // out in a REAL linked worktree — the production shape `mg job` produces —\n82: // unlike initTestRepo's pre-worktree shape (branch checked out in the main\n83: // worktree itself). Run-level session.log tests use this shape so the\n84: // loop-exit sweep's CommitAll runs against the job's own worktree and the\n85: // REQUIRED clean-tree assertion actually exercises it (in the pre-worktree\n86: // shape the sweep is gated off by design — see TestRunDoesNotSweepMainWorktree).\n87: //\n88: // Returns the main project root (matching job.Discover's semantics: a Job's\n89: // Root is always the main root, never its own worktree), the job's linked\n90: // worktree path, and the job.Job.\n91: func initLinkedWorktreeRepo(t *testing.T) (root, wt string, j job.Job) {\n92: \tt.Helper()\n93: \troot = t.TempDir()\n94: \trunGit(t, root, \"init\", \"-q\", \"-b\", \"main\")\n95: \trunGit(t, root, \"config\", \"user.email\", \"t@example.com\")\n96: \trunGit(t, root, \"config\", \"user.name\", \"Test\")\n97: \trunGit(t, root, \"config\", \"commit.gpgsign\", \"false\")\n98: \n99: \tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n100: \t\tt.Fatal(err)\n101: \t}\n102: \tif err := os.WriteFile(filepath.Join(root, \"README\"), []byte(\"init\\n\"), 0o644); err != nil {\n103: \t\tt.Fatal(err)\n104: \t}\n105: \trunGit(t, root, \"add\", \"README\")\n106: \trunGit(t, root, \"commit\", \"-q\", \"-m\", \"init\")\n107: \n108: \tconst jobName = \"aaaa01_test-job\"\n109: \tconst branch = \"feature/aaaa01_test-job\"\n110: \tjobDir := filepath.Join(root, \"docs\", \"jobs\", jobName)\n111: \tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n112: \t\tt.Fatal(err)\n113: \t}\n114: \tbrief := \"# Brief: test job\\n\\nstatus: open\\ntype: feature\\nid: aaaa01\\nbranch: \" + branch + \"\\n\\n\" +\n115: \t\t\"## What\\n\\nsomething substantial enough to count as written\\nand a second line so isWritten's rule is satisfied\\n\"\n116: \tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n117: \t\tt.Fatal(err)\n118: \t}\n119: \trunGit(t, root, \"checkout\", \"-q\", \"-b\", branch)\n120: \trunGit(t, root, \"add\", \"-A\")\n121: \trunGit(t, root, \"commit\", \"-q\", \"-m\", \"[aaaa01] scaffold job\")\n122: \n123: \t// Back to main, then add the job's own linked worktree — the shape mg\n124: \t// job creates for a normal (post-worktree) job.\n125: \trunGit(t, root, \"checkout\", \"-q\", \"main\")\n126: \twt = filepath.Join(root, \".manigot-worktrees\", jobName)\n127: \trunGit(t, root, \"worktree\", \"add\", \"-q\", wt, branch)\n128: \n129: \tj = job.Job{\n130: \t\tName:   jobName,\n131: \t\tDir:    filepath.Join(wt, \"docs\", \"jobs\", jobName),\n132: \t\tRoot:   root, // the main project root — job.Discover's semantics\n133: \t\tID:     \"aaaa01\",\n134: \t\tBranch: branch,\n135: \t}\n136: \treturn root, wt, j\n137: }\n138: \n139: // writeJobFile writes content to one of the job's four files.\n140: func writeJobFile(t *testing.T, j job.Job, filename, content string) {\n141: \tt.Helper()\n142: \tif err := os.WriteFile(filepath.Join(j.Dir, filename), []byte(content), 0o644); err != nil {\n143: \t\tt.Fatal(err)\n144: \t}\n145: }\n146: \n147: func commit(t *testing.T, root, msg string) {\n148: \tt.Helper()\n149: \trunGit(t, root, \"add\", \"-A\")\n150: \trunGit(t, root, \"commit\", \"-q\", \"-m\", msg)\n151: }\n152: \n153: // fakeRunner implements AgentRunner by calling fn, which simulates an agent\n154: // invocation's effect on disk/git — the same effect a real one would have\n155: // via its own file writes and commits — and returns canned output.\n156: type fakeRunner struct {\n157: \troot  string\n158: \tcalls []string\n159: \tfn    func(t *testing.T, root string, j job.Job, agent string, call int) []byte\n160: \tt     *testing.T\n161: }\n162: \n163: func (f *fakeRunner) Run(agent string, j job.Job) ([]byte, error) {\n164: \tf.calls = append(f.calls, agent)\n165: \treturn f.fn(f.t, f.root, j, agent, len(f.calls)), nil\n166: }\n167: \n168: // TestRunJDIJobShortFlagAccepted pins that `-j` is a recognized alias of\n169: // `--job` in runJDI's own flag set: with no docs/ directory anywhere above\n170: // the working dir, the run must get past flag parsing (an unknown flag would\n171: // exit 2) and fail cleanly at project resolution instead.\n172: func TestRunJDIJobShortFlagAccepted(t *testing.T) {\n173: \tt.Chdir(t.TempDir())\n174: \tvar out, errOut strings.Builder\n175: \tif code := runJDI([]string{\"-j\", \"somejob\"}, &out, &errOut); code != 1 {\n176: \t\tt.Errorf(\"-j exit code = %d, want 1 (no docs/ dir); stderr:\\n%s\", code, errOut.String())\n177: \t}\n178: \tif !strings.Contains(errOut.String(), \"could not find a docs/ directory\") {\n179: \t\tt.Errorf(\"expected the no-docs error, got:\\n%s\", errOut.String())\n180: \t}\n181: }\n182: \n183: func TestRunJDIUnknownFlagRejected(t *testing.T) {\n184: \tvar out, errOut strings.Builder\n185: \tif code := runJDI([]string{\"-x\", \"somejob\"}, &out, &errOut); code != 2 {\n186: \t\tt.Errorf(\"unknown flag exit code = %d, want 2\", code)\n187: \t}\n188: }\n189: \n190: func TestRunHappyPath(t *testing.T) {\n191: \troot, j := initTestRepo(t)\n192: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n193: \t\tswitch agent {\n194: \t\tcase \"analyst\":\n195: \t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n196: \t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n197: \t\tcase \"developer\":\n198: \t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n199: \t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n200: \t\tcase \"reviewer\":\n201: \t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n202: \t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n203: \t\t}\n204: \t\treturn []byte(\"ok\")\n205: \t}}\n206: \n207: \tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n208: \tif got.Kind != orchestrate.StopFinished {\n209: \t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n210: \t}\n211: \twantCalls := []string{\"analyst\", \"developer\", \"reviewer\"}\n212: \tif strings.Join(r.calls, \",\") != strings.Join(wantCalls, \",\") {\n213: \t\tt.Errorf(\"calls = %v, want %v\", r.calls, wantCalls)\n214: \t}\n215: }\n216: \n217: // TestRunLogsAgentInvoked confirms Run writes an \"invoked\" event to the log\n218: // immediately before each agent invocation (TASK-2), reusing the same\n219: // attempt number logInvocation's own post-run header uses. The attempt is\n220: // per agent: every agent's first call is attempt 1, so the happy path reads\n221: // analyst 1 -> developer 1 -> reviewer 1, not a run-wide 1/2/3.\n222: func TestRunLogsAgentInvoked(t *testing.T) {\n223: \troot, j := initTestRepo(t)\n224: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n225: \t\tswitch agent {\n226: \t\tcase \"analyst\":\n227: \t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n228: \t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n229: \t\tcase \"developer\":\n230: \t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n231: \t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n232: \t\tcase \"reviewer\":\n233: \t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n234: \t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n235: \t\t}\n236: \t\treturn []byte(\"ok\")\n237: \t}}\n238: \n239: \tvar log bytes.Buffer\n240: \tgot := Run(root, j, r, &log, nil)\n241: \tif got.Kind != orchestrate.StopFinished {\n242: \t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n243: \t}\n244: \tout := log.String()\n245: \tfor _, want := range []string{\n246: \t\t\"analyst invoked (attempt 1)\",\n247: \t\t\"developer invoked (attempt 1)\",\n248: \t\t\"reviewer invoked (attempt 1)\",\n249: \t} {\n250: \t\tif !strings.Contains(out, want) {\n251: \t\t\tt.Errorf(\"log missing %q, got:\\n%s\", want, out)\n252: \t\t}\n253: \t}\n254: }\n255: \n256: // TestRunReportsStatus exercises Run's StatusFunc callback (TASK-8): a\n257: // job.JDIRunning report before each invocation naming that invocation's\n258: // agent, and a final job.JDIStoppedFinished report naming the last agent\n259: // that ran.\n260: func TestRunReportsStatus(t *testing.T) {\n261: \troot, j := initTestRepo(t)\n262: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n263: \t\tswitch agent {\n264: \t\tcase \"analyst\":\n265: \t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n266: \t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n267: \t\tcase \"developer\":\n268: \t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n269: \t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n270: \t\tcase \"reviewer\":\n271: \t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n272: \t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n273: \t\t}\n274: \t\treturn []byte(\"ok\")\n275: \t}}\n276: \n277: \ttype report struct {\n278: \t\tstate job.JDIState\n279: \t\tagent string\n280: \t}\n281: \tvar reports []report\n282: \tstatus := func(state job.JDIState, agent string) {\n283: \t\treports = append(reports, report{state, agent})\n284: \t}\n285: \n286: \tgot := Run(root, j, r, &bytes.Buffer{}, status)\n287: \tif got.Kind != orchestrate.StopFinished {\n288: \t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n289: \t}\n290: \n291: \twant := []report{\n292: \t\t{job.JDIRunning, \"analyst\"},\n293: \t\t{job.JDIRunning, \"developer\"},\n294: \t\t{job.JDIRunning, \"reviewer\"},\n295: \t\t{job.JDIStoppedFinished, \"reviewer\"},\n296: \t}\n297: \tif len(reports) != len(want) {\n298: \t\tt.Fatalf(\"reports = %+v, want %+v\", reports, want)\n299: \t}\n300: \tfor i, w := range want {\n301: \t\tif reports[i] != w {\n302: \t\t\tt.Errorf(\"reports[%d] = %+v, want %+v\", i, reports[i], w)\n303: \t\t}\n304: \t}\n305: }\n306: \n307: // TestRunOneBounceThenApproved covers the bounce path: a rejected review\n308: // sends control back to the developer once, and a second approved review\n309: // ends the run. The log headers assert the per-agent attempt semantics that\n310: // motivated the brief — the developer's second call is that developer's\n311: // attempt 2, NOT attempt 4 as a run-wide counter would produce, and the\n312: // reviewer's first call is attempt 1 — with each invocation's invoked and\n313: // finished headers sharing the same number.\n314: func TestRunOneBounceThenApproved(t *testing.T) {\n315: \troot, j := initTestRepo(t)\n316: \twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n317: \tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n318: \n319: \treviewCalls := 0\n320: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n321: \t\tswitch agent {\n322: \t\tcase \"developer\":\n323: \t\t\twriteJobFile(t, j, \"implementation.md\", fmt.Sprintf(\"# Implementation\\n\\nTASK-1: attempt %d\\n\", call))\n324: \t\t\tcommit(t, root, fmt.Sprintf(\"[aaaa01] TASK-1: attempt %d\", call))\n325: \t\tcase \"reviewer\":\n326: \t\t\treviewCalls++\n327: \t\t\tif reviewCalls == 1 {\n328: \t\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: FAIL\\n\\n## Overall\\n\\nNEEDS WORK\\n\")\n329: \t\t\t\tcommit(t, root, \"[aaaa01] verdict: needs work\")\n330: \t\t\t} else {\n331: \t\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n332: \t\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n333: \t\t\t}\n334: \t\t}\n335: \t\treturn []byte(\"ok\")\n336: \t}}\n337: \n338: \tvar log bytes.Buffer\n339: \tgot := Run(root, j, r, &log, nil)\n340: \tif got.Kind != orchestrate.StopFinished {\n341: \t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n342: \t}\n343: \twantCalls := []string{\"developer\", \"reviewer\", \"developer\", \"reviewer\"}\n344: \tif strings.Join(r.calls, \",\") != strings.Join(wantCalls, \",\") {\n345: \t\tt.Errorf(\"calls = %v, want %v\", r.calls, wantCalls)\n346: \t}\n347: \n348: \t// Per-agent attempts on the bounce path: each agent's first call is\n349: \t// attempt 1 and the bounced-back developer's second call is attempt 2 —\n350: \t// not attempt 4 as the old run-wide i+1 counter produced. The invoked and\n351: \t// finished headers of one invocation share the same number.\n352: \tassertLogOrder(t, log.String(), []string{\n353: \t\t\"developer invoked (attempt 1)\",\n354: \t\t\"developer finished (attempt 1)\",\n355: \t\t\"reviewer invoked (attempt 1)\",\n356: \t\t\"reviewer finished (attempt 1)\",\n357: \t\t\"developer invoked (attempt 2)\",\n358: \t\t\"developer finished (attempt 2)\",\n359: \t\t\"reviewer invoked (attempt 2)\",\n360: \t\t\"reviewer finished (attempt 2)\",\n361: \t})\n362: }\n363: \n364: func TestRunStopsAfterOneBounceExhausted(t *testing.T) {\n365: \troot, j := initTestRepo(t)\n366: \twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n367: \tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n368: \n369: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n370: \t\tswitch agent {\n371: \t\tcase \"developer\":\n372: \t\t\twriteJobFile(t, j, \"implementation.md\", fmt.Sprintf(\"# Implementation\\n\\nTASK-1: attempt %d\\n\", call))\n373: \t\t\tcommit(t, root, fmt.Sprintf(\"[aaaa01] TASK-1: attempt %d\", call))\n374: \t\tcase \"reviewer\":\n375: \t\t\twriteJobFile(t, j, \"verdict.md\", fmt.Sprintf(\"# Verdict\\n\\nTASK-1: FAIL (attempt %d)\\n\\n## Overall\\n\\nREJECTED\\n\", call))\n376: \t\t\tcommit(t, root, fmt.Sprintf(\"[aaaa01] verdict: rejected (attempt %d)\", call))\n377: \t\t}\n378: \t\treturn []byte(\"ok\")\n379: \t}}\n380: \n381: \tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n382: \tif got.Kind != orchestrate.StopNeedsHuman {\n383: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman (reason: %s)\", got.Kind, got.Reason)\n384: \t}\n385: \tif !strings.Contains(got.Reason, \"review cycle\") {\n386: \t\tt.Errorf(\"Reason = %q, want it to contain \\\"review cycle\\\"\", got.Reason)\n387: \t}\n388: \t// developer, reviewer (round 1, rejected), developer (the one allowed\n389: \t// bounce), reviewer (round 2, rejected again) — then stop, no third\n390: \t// developer bounce.\n391: \twantCalls := []string{\"developer\", \"reviewer\", \"developer\", \"reviewer\"}\n392: \tif strings.Join(r.calls, \",\") != strings.Join(wantCalls, \",\") {\n393: \t\tt.Errorf(\"calls = %v, want %v\", r.calls, wantCalls)\n394: \t}\n395: \tcount, err := git.CountVerdictCommits(root, j.Branch, j.ID)\n396: \tif err != nil {\n397: \t\tt.Fatal(err)\n398: \t}\n399: \tif count != 2 {\n400: \t\tt.Errorf(\"verdict commit count = %d, want 2\", count)\n401: \t}\n402: }\n403: \n404: func TestRunStopsOnNeedsHumanMarker(t *testing.T) {\n405: \troot, j := initTestRepo(t)\n406: \n407: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n408: \t\treturn []byte(\"I looked at the brief.\\nNEEDS-HUMAN-INPUT: which auth provider should this use?\\n\")\n409: \t}}\n410: \n411: \tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n412: \tif got.Kind != orchestrate.StopNeedsHuman {\n413: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n414: \t}\n415: \tif !strings.Contains(got.Reason, \"which auth provider should this use?\") {\n416: \t\tt.Errorf(\"Reason = %q, want it to contain the marker's reason text\", got.Reason)\n417: \t}\n418: \tif len(r.calls) != 1 {\n419: \t\tt.Errorf(\"calls = %v, want exactly one invocation (stopped immediately)\", r.calls)\n420: \t}\n421: }\n422: \n423: // TestRunStopsOnNeedsHumanMarkerInOpenCodeJSONL proves the marker detection\n424: // holds at the loop level against the real `opencode run --format json`\n425: // JSONL shape — a stream of typed events whose response prose lives in a\n426: // \"text\"-event's part.text (see orchestrate.realOpenCodeJSONL) — not just\n427: // against the plain-text / Claude-JSON shapes the other marker tests use.\n428: // It also pins the run.log contract for an opencode-driven run: the log must\n429: // show the extracted prose (ResultText), never the raw JSONL blob.\n430: func TestRunStopsOnNeedsHumanMarkerInOpenCodeJSONL(t *testing.T) {\n431: \troot, j := initTestRepo(t)\n432: \n433: \t// A minimal but real `opencode run --format json` output (the 3-line\n434: \t// step_start/text/step_finish shape captured live in the 63quv2\n435: \t// verification), with the marker inside the text event's part.text.\n436: \tconst realShape = `{\"type\":\"step_start\",\"part\":{\"type\":\"step-start\"}}\n437: {\"type\":\"text\",\"part\":{\"type\":\"text\",\"text\":\"Looked at tasks.md.\\nNEEDS-HUMAN-INPUT: which auth provider should this use?\"}}\n438: {\"type\":\"step_finish\",\"part\":{\"type\":\"step-finish\",\"reason\":\"stop\"}}\n439: `\n440: \n441: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n442: \t\treturn []byte(realShape)\n443: \t}}\n444: \n445: \tvar log bytes.Buffer\n446: \tgot := Run(root, j, r, &log, nil)\n447: \tif got.Kind != orchestrate.StopNeedsHuman {\n448: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n449: \t}\n450: \tif !strings.Contains(got.Reason, \"which auth provider should this use?\") {\n451: \t\tt.Errorf(\"Reason = %q, want it to contain the marker's reason text\", got.Reason)\n452: \t}\n453: \tif len(r.calls) != 1 {\n454: \t\tt.Errorf(\"calls = %v, want exactly one invocation (stopped immediately)\", r.calls)\n455: \t}\n456: \tout := log.String()\n457: \tif strings.Contains(out, `\"type\":\"step_start\"`) || strings.Contains(out, `{\"type\":\"text\"`) {\n458: \t\tt.Errorf(\"run.log contains raw JSONL, want the extracted prose (ResultText):\\n%s\", out)\n459: \t}\n460: \tif !strings.Contains(out, \"which auth provider should this use?\") {\n461: \t\tt.Errorf(\"run.log missing the marker reason prose, got:\\n%s\", out)\n462: \t}\n463: }\n464: \n465: func TestRunStopsOnStall(t *testing.T) {\n466: \troot, j := initTestRepo(t)\n467: \n468: \t// analyst \"runs\" but writes/commits nothing at all — Stage() and HEAD\n469: \t// stay unchanged, so the second consecutive analyst invocation must\n470: \t// trip the stall backstop rather than loop forever.\n471: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n472: \t\treturn []byte(\"thinking out loud, not sure what to do\")\n473: \t}}\n474: \n475: \tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n476: \tif got.Kind != orchestrate.StopNeedsHuman {\n477: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n478: \t}\n479: \tif !strings.Contains(got.Reason, \"no progress\") {\n480: \t\tt.Errorf(\"Reason = %q, want it to mention no progress\", got.Reason)\n481: \t}\n482: \tif len(r.calls) != 2 {\n483: \t\tt.Errorf(\"calls = %v, want exactly two invocations (stall detected on the second)\", r.calls)\n484: \t}\n485: }\n486: \n487: // TestRunStallProbeUsesFreshContext pins the stall backstop against a\n488: // regression where the post-agent HEAD probe reused the pre-agent probe\n489: // context: an agent invocation (runner.Run) takes minutes in production, so\n490: // by the time the probe ran the 10s context was long expired and the probe\n491: // returned \"\" — headAfter never equaled headBefore, noChange was always\n492: // false, and a genuinely stuck agent ran to maxIterations instead of\n493: // stopping after two no-op invocations. The test simulates that by lowering\n494: // jdiProbeTimeout and making the fake runner's Run outlive it (but write\n495: // nothing), then asserting the backstop still fires: it can only if the\n496: // post-agent probe used a fresh context.\n497: func TestRunStallProbeUsesFreshContext(t *testing.T) {\n498: \troot, j := initTestRepo(t)\n499: \n500: \torig := jdiProbeTimeout\n501: \tjdiProbeTimeout = 200 * time.Millisecond\n502: \tt.Cleanup(func() { jdiProbeTimeout = orig })\n503: \n504: \t// The fake agent \"runs\" longer than the probe timeout and writes\n505: \t// nothing at all — exactly the production shape of a stuck agent. 600ms\n506: \t// comfortably outlives the 200ms probe timeout, and 200ms leaves the\n507: \t// pre-agent probes (three fast, real git execs sharing the loop-top\n508: \t// context) plenty of room to complete within it even on a loaded CI\n509: \t// machine.\n510: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n511: \t\ttime.Sleep(600 * time.Millisecond)\n512: \t\treturn []byte(\"thinking out loud, not sure what to do\")\n513: \t}}\n514: \n515: \tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n516: \tif got.Kind != orchestrate.StopNeedsHuman {\n517: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n518: \t}\n519: \tif !strings.Contains(got.Reason, \"no progress\") {\n520: \t\tt.Errorf(\"Reason = %q, want it to mention no progress\", got.Reason)\n521: \t}\n522: \tif len(r.calls) != 2 {\n523: \t\tt.Errorf(\"calls = %v, want exactly two invocations (stall detected on the second, not looped to maxIterations)\", r.calls)\n524: \t}\n525: }\n526: \n527: func TestRunStopsOnRunnerError(t *testing.T) {\n528: \troot, j := initTestRepo(t)\n529: \twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n530: \tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n531: \n532: \tr := &errRunner{}\n533: \tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n534: \tif got.Kind != orchestrate.StopNeedsHuman {\n535: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n536: \t}\n537: \tif !strings.Contains(got.Reason, \"boom\") {\n538: \t\tt.Errorf(\"Reason = %q, want it to mention the runner error\", got.Reason)\n539: \t}\n540: }\n541: \n542: // TestRunLogsImmediateStopReason confirms an immediate stop — Next()\n543: // returning a Stop* decision before any agent has ever run, e.g. a\n544: // genuinely-unwritten brief.md — writes its Reason to the log, not just to\n545: // mg jdi's own return value. Before this fix, this case left the log at 0\n546: // bytes, which read as \"mg jdi didn't do anything at all\" rather than \"mg\n547: // jdi correctly stopped immediately, here's why\".\n548: func TestRunLogsImmediateStopReason(t *testing.T) {\n549: \troot, j := initTestRepo(t)\n550: \t// Overwrite brief.md with the genuinely-unwritten scaffold shape (no\n551: \t// substantive content at all) so Stage() reports StageDefine and Next\n552: \t// stops before ever invoking an agent.\n553: \twriteJobFile(t, j, \"brief.md\", \"# Brief: test job\\n\\nstatus: open\\ntype: feature\\nid: aaaa01\\n\\n\"+\n554: \t\t\"## What\\n\\n<!-- placeholder -->\\n\")\n555: \tcommit(t, root, \"[aaaa01] brief: reset to scaffold\")\n556: \n557: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n558: \t\tt.Fatal(\"no agent should have been invoked for an immediate stop\")\n559: \t\treturn nil\n560: \t}}\n561: \n562: \tvar log bytes.Buffer\n563: \tgot := Run(root, j, r, &log, nil)\n564: \tif got.Kind != orchestrate.StopNeedsHuman {\n565: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman (reason: %s)\", got.Kind, got.Reason)\n566: \t}\n567: \tif len(r.calls) != 0 {\n568: \t\tt.Fatalf(\"calls = %v, want no invocations (immediate stop)\", r.calls)\n569: \t}\n570: \tif log.Len() == 0 {\n571: \t\tt.Fatal(\"run.log is empty, want it to contain the immediate-stop reason\")\n572: \t}\n573: \tif !strings.Contains(log.String(), got.Reason) {\n574: \t\tt.Errorf(\"log = %q, want it to contain the stop reason %q\", log.String(), got.Reason)\n575: \t}\n576: }\n577: \n578: // TestRunLogsJobFinishedOnNormalStop confirms Run writes a \"job finished\"\n579: // event to the log at loop exit (TASK-4) once an agent has actually run —\n580: // distinct from the immediate-stop case covered by\n581: // TestRunLogsImmediateStopReason below, which must not repeat the same\n582: // reason text twice in a row.\n583: func TestRunLogsJobFinishedOnNormalStop(t *testing.T) {\n584: \troot, j := initTestRepo(t)\n585: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n586: \t\tswitch agent {\n587: \t\tcase \"analyst\":\n588: \t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n589: \t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n590: \t\tcase \"developer\":\n591: \t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n592: \t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n593: \t\tcase \"reviewer\":\n594: \t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n595: \t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n596: \t\t}\n597: \t\treturn []byte(\"ok\")\n598: \t}}\n599: \n600: \tvar log bytes.Buffer\n601: \tgot := Run(root, j, r, &log, nil)\n602: \tif got.Kind != orchestrate.StopFinished {\n603: \t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n604: \t}\n605: \tout := log.String()\n606: \tif !strings.Contains(out, \"mg jdi finished: stop-finished\") {\n607: \t\tt.Errorf(\"log missing job-finished event, got:\\n%s\", out)\n608: \t}\n609: \tif !strings.Contains(out, got.Reason) {\n610: \t\tt.Errorf(\"log missing the finish reason %q, got:\\n%s\", got.Reason, out)\n611: \t}\n612: }\n613: \n614: // TestRunImmediateStopDoesNotDuplicateReason extends\n615: // TestRunLogsImmediateStopReason: TASK-4's \"job finished\" event must still\n616: // fire for the stop-before-any-agent-ran case, but must not print the same\n617: // reason text logImmediateStop already printed a second time.\n618: func TestRunImmediateStopDoesNotDuplicateReason(t *testing.T) {\n619: \troot, j := initTestRepo(t)\n620: \twriteJobFile(t, j, \"brief.md\", \"# Brief: test job\\n\\nstatus: open\\ntype: feature\\nid: aaaa01\\n\\n\"+\n621: \t\t\"## What\\n\\n<!-- placeholder -->\\n\")\n622: \tcommit(t, root, \"[aaaa01] brief: reset to scaffold\")\n623: \n624: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n625: \t\tt.Fatal(\"no agent should have been invoked for an immediate stop\")\n626: \t\treturn nil\n627: \t}}\n628: \n629: \tvar log bytes.Buffer\n630: \tgot := Run(root, j, r, &log, nil)\n631: \tif got.Kind != orchestrate.StopNeedsHuman {\n632: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman (reason: %s)\", got.Kind, got.Reason)\n633: \t}\n634: \tout := log.String()\n635: \tif !strings.Contains(out, \"mg jdi finished: stop-needs-human\") {\n636: \t\tt.Errorf(\"log missing job-finished event, got:\\n%s\", out)\n637: \t}\n638: \tif strings.Count(out, got.Reason) != 1 {\n639: \t\tt.Errorf(\"reason %q appears %d times in log, want exactly 1 (not duplicated between logImmediateStop and logJobFinished):\\n%s\", got.Reason, strings.Count(out, got.Reason), out)\n640: \t}\n641: }\n642: \n643: // assertLogOrder fails the test unless every substring in wantInOrder\n644: // appears in out, each strictly after the previous one — i.e. out reads as\n645: // wantInOrder describes, start to finish.\n646: func assertLogOrder(t *testing.T, out string, wantInOrder []string) {\n647: \tt.Helper()\n648: \tpos := 0\n649: \tfor _, want := range wantInOrder {\n650: \t\tidx := strings.Index(out[pos:], want)\n651: \t\tif idx == -1 {\n652: \t\t\tt.Fatalf(\"log missing %q after position %d, want it in order %v; full log:\\n%s\", want, pos, wantInOrder, out)\n653: \t\t}\n654: \t\tpos += idx + len(want)\n655: \t}\n656: }\n657: \n658: // TestRunFullLogSequenceHappyPath is TASK-6's end-to-end coverage: a full\n659: // mg-jdi run (mimicking main()'s own logStarted call ahead of Run) produces\n660: // the complete started -> invoked -> finished -> ... -> job finished\n661: // sequence the brief asked for, not just each event in isolation.\n662: func TestRunFullLogSequenceHappyPath(t *testing.T) {\n663: \troot, j := initTestRepo(t)\n664: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n665: \t\tswitch agent {\n666: \t\tcase \"analyst\":\n667: \t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n668: \t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n669: \t\t\treturn []byte(\"Wrote tasks.md with one task.\")\n670: \t\tcase \"developer\":\n671: \t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n672: \t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n673: \t\t\treturn []byte(\"Implemented TASK-1, all tests pass.\")\n674: \t\tcase \"reviewer\":\n675: \t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n676: \t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n677: \t\t\treturn []byte(\"Reviewed and approved.\")\n678: \t\t}\n679: \t\treturn nil\n680: \t}}\n681: \n682: \tvar log bytes.Buffer\n683: \tlogStarted(&log, j.Name, \"claude-pro\")\n684: \tgot := Run(root, j, r, &log, nil)\n685: \tif got.Kind != orchestrate.StopFinished {\n686: \t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n687: \t}\n688: \n689: \tassertLogOrder(t, log.String(), []string{\n690: \t\t\"mg jdi started\",\n691: \t\t\"analyst invoked (attempt 1)\",\n692: \t\t\"analyst finished (attempt 1)\",\n693: \t\t\"Wrote tasks.md with one task.\",\n694: \t\t\"developer invoked (attempt 1)\",\n695: \t\t\"developer finished (attempt 1)\",\n696: \t\t\"Implemented TASK-1, all tests pass.\",\n697: \t\t\"reviewer invoked (attempt 1)\",\n698: \t\t\"reviewer finished (attempt 1)\",\n699: \t\t\"Reviewed and approved.\",\n700: \t\t\"mg jdi finished: stop-finished\",\n701: \t})\n702: }\n703: \n704: // TestRunFullLogSequenceDedupsMatchingOutput is TASK-6's dedup-case\n705: // end-to-end coverage: when an agent's response text is just an echo of the\n706: // file it wrote (TASK-5), the full sequence still reads started -> invoked\n707: // -> finished -> ... -> job finished, but the finished body is the short\n708: // omission note instead of the file's full content repeated in the log.\n709: func TestRunFullLogSequenceDedupsMatchingOutput(t *testing.T) {\n710: \troot, j := initTestRepo(t)\n711: \tconst tasksContent = \"# Tasks\\n\\nTASK-1: do the thing\\n\"\n712: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n713: \t\tswitch agent {\n714: \t\tcase \"analyst\":\n715: \t\t\twriteJobFile(t, j, \"tasks.md\", tasksContent)\n716: \t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n717: \t\t\treturn []byte(tasksContent)\n718: \t\tcase \"developer\":\n719: \t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n720: \t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n721: \t\t\treturn []byte(\"done\")\n722: \t\tcase \"reviewer\":\n723: \t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n724: \t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n725: \t\t\treturn []byte(\"done\")\n726: \t\t}\n727: \t\treturn nil\n728: \t}}\n729: \n730: \tvar log bytes.Buffer\n731: \tlogStarted(&log, j.Name, \"claude-pro\")\n732: \tgot := Run(root, j, r, &log, nil)\n733: \tif got.Kind != orchestrate.StopFinished {\n734: \t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n735: \t}\n736: \n737: \tout := log.String()\n738: \tassertLogOrder(t, out, []string{\n739: \t\t\"mg jdi started\",\n740: \t\t\"analyst invoked (attempt 1)\",\n741: \t\t\"analyst finished (attempt 1)\",\n742: \t\t\"(output matches tasks.md, omitted)\",\n743: \t\t\"developer invoked (attempt 1)\",\n744: \t\t\"developer finished (attempt 1)\",\n745: \t\t\"reviewer invoked (attempt 1)\",\n746: \t\t\"reviewer finished (attempt 1)\",\n747: \t\t\"mg jdi finished: stop-finished\",\n748: \t})\n749: \tif strings.Contains(out, \"TASK-1: do the thing\") {\n750: \t\tt.Errorf(\"log = %q, want tasks.md's content not repeated verbatim (should be omitted)\", out)\n751: \t}\n752: }\n753: \n754: type errRunner struct{}\n755: \n756: func (errRunner) Run(agent string, j job.Job) ([]byte, error) {\n757: \treturn nil, errors.New(\"boom\")\n758: }\n759: \n760: // TestCommandAgentRunnerUsesGivenProfile confirms commandAgentRunner builds\n761: // its --print session invocation with the profile it was constructed with\n762: // (TASK-5), rather than the old hardcoded config.ProfileClaudePro pin —\n763: // exercised for a non-default profile so a stale pin would be caught. Since\n764: // the runner now calls the session package in-process (no run.sh exec), the\n765: // pinned profile is asserted on the constructed options, and a full Run\n766: // against the test repo must reach the docker launch (which fails with a\n767: // docker-not-found error here) rather than a profile/auth/resolution error.\n768: func TestCommandAgentRunnerUsesGivenProfile(t *testing.T) {\n769: \troot, j := initTestRepo(t)\n770: \n771: \tr := &commandAgentRunner{projectRoot: root, profile: \"zai\"}\n772: \topts := r.agentInvocation(\"developer\", j)\n773: \tif opts.Profile != \"zai\" {\n774: \t\tt.Errorf(\"invocation profile = %q, want zai\", opts.Profile)\n775: \t}\n776: \tif opts.Agent != \"developer\" || opts.Job != j.Name || !opts.Print {\n777: \t\tt.Errorf(\"invocation = %+v\", opts)\n778: \t}\n779: }\n780: \n781: // notifyRequest is one HTTP request the fake ntfy server captured.\n782: type notifyRequest struct {\n783: \tmethod  string\n784: \tpath    string\n785: \tbody    string\n786: \theaders http.Header\n787: }\n788: \n789: // newNotifyCapture starts an httptest server recording every request it\n790: // receives (method, path, headers, body) and replying with status, so tests\n791: // can assert on exactly what notifyStop/notifyCrashedRun sent.\n792: func newNotifyCapture(t *testing.T, status int) (*httptest.Server, *[]notifyRequest) {\n793: \tt.Helper()\n794: \tvar got []notifyRequest\n795: \tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n796: \t\tbody, _ := io.ReadAll(r.Body)\n797: \t\tgot = append(got, notifyRequest{method: r.Method, path: r.URL.Path, body: string(body), headers: r.Header.Clone()})\n798: \t\tw.WriteHeader(status)\n799: \t}))\n800: \tt.Cleanup(srv.Close)\n801: \treturn srv, &got\n802: }\n803: \n804: // configureNtfy points the ntfy config (internal/notify's FromConfig, which\n805: // reads config.EnvValue) at the test server by setting the process env the\n806: // .env-less fake checkout falls back to.\n807: func configureNtfy(t *testing.T, srvURL, topic, token string) {\n808: \tt.Helper()\n809: \tt.Setenv(\"NTFY_URL\", srvURL)\n810: \tt.Setenv(\"NTFY_TOPIC\", topic)\n811: \tt.Setenv(\"NTFY_TOKEN\", token)\n812: }\n813: \n814: func TestNotifyStopFinished(t *testing.T) {\n815: \tprofileCheckout(t, \"\")\n816: \tsrv, got := newNotifyCapture(t, http.StatusOK)\n817: \tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n818: \n819: \tvar stderr bytes.Buffer\n820: \tnotifyStop(&stderr, \"aaaa01_test-job\", LoopResult{Kind: orchestrate.StopFinished, Reason: \"verdict.md's Overall verdict is APPROVED\"})\n821: \n822: \tif len(*got) != 1 {\n823: \t\tt.Fatalf(\"received %d requests, want 1\", len(*got))\n824: \t}\n825: \treq := (*got)[0]\n826: \tif req.headers.Get(\"Tags\") != \"white_check_mark\" {\n827: \t\tt.Errorf(\"Tags header = %q, want white_check_mark\", req.headers.Get(\"Tags\"))\n828: \t}\n829: \tif req.headers.Get(\"Priority\") != \"\" {\n830: \t\tt.Errorf(\"Priority header = %q, want unset (default priority) for a success\", req.headers.Get(\"Priority\"))\n831: \t}\n832: \tif !strings.Contains(req.headers.Get(\"Title\"), \"aaaa01_test-job\") {\n833: \t\tt.Errorf(\"Title header = %q, want it to contain the job name\", req.headers.Get(\"Title\"))\n834: \t}\n835: \tif !strings.Contains(req.body, \"APPROVED\") {\n836: \t\tt.Errorf(\"body = %q, want it to contain the stop reason\", req.body)\n837: \t}\n838: \tif stderr.Len() != 0 {\n839: \t\tt.Errorf(\"stderr = %q, want empty\", stderr.String())\n840: \t}\n841: }\n842: \n843: func TestNotifyStopNeedsHuman(t *testing.T) {\n844: \tprofileCheckout(t, \"\")\n845: \tsrv, got := newNotifyCapture(t, http.StatusOK)\n846: \tconfigureNtfy(t, srv.URL, \"my-topic\", \"tok\")\n847: \n848: \tvar stderr bytes.Buffer\n849: \tnotifyStop(&stderr, \"aaaa01_test-job\", LoopResult{Kind: orchestrate.StopNeedsHuman, Reason: \"analyst made no progress on two consecutive runs\"})\n850: \n851: \tif len(*got) != 1 {\n852: \t\tt.Fatalf(\"received %d requests, want 1\", len(*got))\n853: \t}\n854: \treq := (*got)[0]\n855: \tif req.headers.Get(\"Tags\") != \"warning\" {\n856: \t\tt.Errorf(\"Tags header = %q, want warning\", req.headers.Get(\"Tags\"))\n857: \t}\n858: \tif req.headers.Get(\"Priority\") != \"4\" {\n859: \t\tt.Errorf(\"Priority header = %q, want 4 (high priority) for needs-human\", req.headers.Get(\"Priority\"))\n860: \t}\n861: \tif req.headers.Get(\"Authorization\") != \"Bearer tok\" {\n862: \t\tt.Errorf(\"Authorization header = %q, want %q\", req.headers.Get(\"Authorization\"), \"Bearer tok\")\n863: \t}\n864: \tif !strings.Contains(req.headers.Get(\"Title\"), \"needs attention\") {\n865: \t\tt.Errorf(\"Title header = %q, want it to say needs attention\", req.headers.Get(\"Title\"))\n866: \t}\n867: \tif !strings.Contains(req.body, \"no progress\") {\n868: \t\tt.Errorf(\"body = %q, want it to contain the stop reason\", req.body)\n869: \t}\n870: }\n871: \n872: func TestNotifyStopUnconfiguredSendsNothing(t *testing.T) {\n873: \tprofileCheckout(t, \"\")\n874: \tsrv, got := newNotifyCapture(t, http.StatusOK)\n875: \tconfigureNtfy(t, srv.URL, \"\", \"\") // no NTFY_TOPIC → feature off\n876: \n877: \tvar stderr bytes.Buffer\n878: \tnotifyStop(&stderr, \"aaaa01_test-job\", LoopResult{Kind: orchestrate.StopNeedsHuman, Reason: \"stalled\"})\n879: \n880: \tif len(*got) != 0 {\n881: \t\tt.Errorf(\"received %d requests, want 0 (unconfigured must be a strict no-op)\", len(*got))\n882: \t}\n883: \tif stderr.Len() != 0 {\n884: \t\tt.Errorf(\"stderr = %q, want empty\", stderr.String())\n885: \t}\n886: }\n887: \n888: func TestNotifyStopSendFailureWarnsButDoesNotAbort(t *testing.T) {\n889: \tprofileCheckout(t, \"\")\n890: \tsrv, _ := newNotifyCapture(t, http.StatusInternalServerError)\n891: \tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n892: \n893: \tvar stderr bytes.Buffer\n894: \tnotifyStop(&stderr, \"aaaa01_test-job\", LoopResult{Kind: orchestrate.StopFinished, Reason: \"done\"})\n895: \n896: \tout := stderr.String()\n897: \tif !strings.Contains(out, \"mg jdi: warning: could not send ntfy notification\") {\n898: \t\tt.Errorf(\"stderr = %q, want a 'could not send ntfy notification' warning\", out)\n899: \t}\n900: }\n901: \n902: // writeStaleRunningSidecar plants an old JDIRunning sidecar — the on-disk\n903: // signature of an mg-jdi run that was killed without ever reporting a stop\n904: // (job.jdiRunningStaleAfter is 30 minutes, so 2 hours is safely stale).\n905: func writeStaleRunningSidecar(t *testing.T, root, jobName string) {\n906: \tt.Helper()\n907: \tif err := os.MkdirAll(job.JDIStatusDir(root, jobName), 0o755); err != nil {\n908: \t\tt.Fatal(err)\n909: \t}\n910: \tstale := time.Now().Add(-2 * time.Hour).UTC().Format(time.RFC3339)\n911: \tbody := `{\"state\":\"running\",\"agent\":\"developer\",\"updated\":\"` + stale + `\"}`\n912: \tif err := os.WriteFile(job.JDIStatusPath(root, jobName), []byte(body), 0o644); err != nil {\n913: \t\tt.Fatal(err)\n914: \t}\n915: }\n916: \n917: func TestNotifyCrashedRunNotifiesAndDedups(t *testing.T) {\n918: \tprofileCheckout(t, \"\")\n919: \tsrv, got := newNotifyCapture(t, http.StatusOK)\n920: \tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n921: \troot := t.TempDir()\n922: \tconst jobName = \"aaaa01_test-job\"\n923: \twriteStaleRunningSidecar(t, root, jobName)\n924: \tj := job.Job{Name: jobName, Root: root}\n925: \n926: \tvar stderr bytes.Buffer\n927: \tnotifyCrashedRun(&stderr, root, j)\n928: \n929: \tif len(*got) != 1 {\n930: \t\tt.Fatalf(\"received %d requests, want 1 (the crash notification)\", len(*got))\n931: \t}\n932: \treq := (*got)[0]\n933: \tif req.headers.Get(\"Tags\") != \"warning\" {\n934: \t\tt.Errorf(\"Tags header = %q, want warning\", req.headers.Get(\"Tags\"))\n935: \t}\n936: \tif req.headers.Get(\"Priority\") != \"4\" {\n937: \t\tt.Errorf(\"Priority header = %q, want 4 (high priority) for a crash\", req.headers.Get(\"Priority\"))\n938: \t}\n939: \tif !strings.Contains(req.headers.Get(\"Title\"), jobName) {\n940: \t\tt.Errorf(\"Title header = %q, want it to contain the job name\", req.headers.Get(\"Title\"))\n941: \t}\n942: \tif !strings.Contains(req.body, \"crashed or been killed\") {\n943: \t\tt.Errorf(\"body = %q, want it to describe the crash\", req.body)\n944: \t}\n945: \tif !strings.Contains(req.body, \"Last agent: developer\") {\n946: \t\tt.Errorf(\"body = %q, want it to name the last agent\", req.body)\n947: \t}\n948: \tif stderr.Len() != 0 {\n949: \t\tt.Errorf(\"stderr = %q, want empty\", stderr.String())\n950: \t}\n951: \n952: \t// The stale sidecar is overwritten with a stopped state, so a second\n953: \t// start must not re-notify about the same already-known crash.\n954: \tnotifyCrashedRun(&stderr, root, j)\n955: \tif len(*got) != 1 {\n956: \t\tt.Errorf(\"received %d requests after dedup, want still 1\", len(*got))\n957: \t}\n958: \tif st, ok := job.ReadJDIStatus(root, jobName); !ok || st.State != job.JDIStoppedNeedsHuman {\n959: \t\tt.Errorf(\"sidecar after dedup = %+v (ok=%v), want stopped:needs-human\", st, ok)\n960: \t}\n961: }\n962: \n963: func TestNotifyCrashedRunFreshRunningDoesNotNotify(t *testing.T) {\n964: \tprofileCheckout(t, \"\")\n965: \tsrv, got := newNotifyCapture(t, http.StatusOK)\n966: \tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n967: \troot := t.TempDir()\n968: \tconst jobName = \"aaaa01_test-job\"\n969: \t// A fresh running status means a live mg-jdi run — must not be reported\n970: \t// as a crash.\n971: \tif err := job.WriteJDIStatus(root, jobName, job.JDIRunning, \"analyst\"); err != nil {\n972: \t\tt.Fatal(err)\n973: \t}\n974: \n975: \tvar stderr bytes.Buffer\n976: \tnotifyCrashedRun(&stderr, root, job.Job{Name: jobName, Root: root})\n977: \n978: \tif len(*got) != 0 {\n979: \t\tt.Errorf(\"received %d requests, want 0 (a live run is not a crash)\", len(*got))\n980: \t}\n981: \tif stderr.Len() != 0 {\n982: \t\tt.Errorf(\"stderr = %q, want empty\", stderr.String())\n983: \t}\n984: }\n985: \n986: func TestNotifyCrashedRunStoppedStatusDoesNotNotify(t *testing.T) {\n987: \tprofileCheckout(t, \"\")\n988: \tsrv, got := newNotifyCapture(t, http.StatusOK)\n989: \tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n990: \troot := t.TempDir()\n991: \tconst jobName = \"aaaa01_test-job\"\n992: \tif err := job.WriteJDIStatus(root, jobName, job.JDIStoppedFinished, \"reviewer\"); err != nil {\n993: \t\tt.Fatal(err)\n994: \t}\n995: \n996: \tvar stderr bytes.Buffer\n997: \tnotifyCrashedRun(&stderr, root, job.Job{Name: jobName, Root: root})\n998: \n999: \tif len(*got) != 0 {\n1000: \t\tt.Errorf(\"received %d requests, want 0 (a stopped run is not a crash)\", len(*got))\n1001: \t}\n1002: }\n1003: \n1004: func TestNotifyCrashedRunUnconfiguredLeavesSidecarUntouched(t *testing.T) {\n1005: \tprofileCheckout(t, \"\")\n1006: \tsrv, got := newNotifyCapture(t, http.StatusOK)\n1007: \tconfigureNtfy(t, srv.URL, \"\", \"\") // no NTFY_TOPIC → feature off\n1008: \troot := t.TempDir()\n1009: \tconst jobName = \"aaaa01_test-job\"\n1010: \twriteStaleRunningSidecar(t, root, jobName)\n1011: \n1012: \tvar stderr bytes.Buffer\n1013: \tnotifyCrashedRun(&stderr, root, job.Job{Name: jobName, Root: root})\n1014: \n1015: \tif len(*got) != 0 {\n1016: \t\tt.Errorf(\"received %d requests, want 0 (unconfigured must be a strict no-op)\", len(*got))\n1017: \t}\n1018: \t// Unconfigured behavior must be byte-for-byte identical: the stale sidecar\n1019: \t// is left exactly as it was (ReadJDIStatus still degrades it away).\n1020: \tif _, ok := job.StaleRunningJDI(root, jobName); !ok {\n1021: \t\tt.Error(\"sidecar was modified despite ntfy being unconfigured — unconfigured behavior must be unchanged\")\n1022: \t}\n1023: }\n1024: \n1025: // pruneTestJob builds a real worktree job (the mg job flow) for the\n1026: // commandAgentRunner prune-wiring tests — initTestRepo's job branch has no\n1027: // registered worktree, but commandAgentRunner.Run resolves its --job through\n1028: // the worktree path (ResolveRootFrom → WorktreeForBranch), so a real\n1029: // worktree job is required.\n1030: func pruneTestJob(t *testing.T) (dir string, j job.Job) {\n1031: \tt.Helper()\n1032: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n1033: \tdir = mgCheckout(t)\n1034: \tt.Chdir(dir)\n1035: \tprofileCheckout(t, \"MANIGOT_PROFILE=zai\\nZHIPU_API_KEY=k\\n\")\n1036: \n1037: \tvar out, errOut strings.Builder\n1038: \tif code := runJob([]string{\"Prune Job\"}, &out, &errOut); code != 0 {\n1039: \t\tt.Fatalf(\"runJob: %d %s\", code, errOut.String())\n1040: \t}\n1041: \tbranch := mgJobBranch(t, dir)\n1042: \tjobName := strings.TrimPrefix(branch, \"feature/\")\n1043: \twt := mgWorktreePath(t, dir, branch)\n1044: \tj = job.Job{\n1045: \t\tName:   jobName,\n1046: \t\tDir:    filepath.Join(wt, \"docs\", \"jobs\", jobName),\n1047: \t\tRoot:   wt,\n1048: \t\tID:     strings.Split(jobName, \"_\")[0],\n1049: \t\tBranch: branch,\n1050: \t}\n1051: \treturn dir, j\n1052: }\n1053: \n1054: // TestCommandAgentRunnerPrunesBeforeRun pins the mg-jdi launch-path wiring:\n1055: // commandAgentRunner.Run calls pruneOrphans (stubbed — docker is not on the\n1056: // test PATH) before its docker invocation, which then fails on the git-only\n1057: // PATH — proving the prune ran and did not replace the launch.\n1058: func TestCommandAgentRunnerPrunesBeforeRun(t *testing.T) {\n1059: \tdir, j := pruneTestJob(t)\n1060: \n1061: \tvar pruneCalls int\n1062: \told := pruneOrphans\n1063: \tpruneOrphans = func(diag io.Writer) (session.PruneResult, error) {\n1064: \t\tpruneCalls++\n1065: \t\treturn session.PruneResult{Removed: 2, Running: 0}, nil\n1066: \t}\n1067: \tt.Cleanup(func() { pruneOrphans = old })\n1068: \n1069: \tr := &commandAgentRunner{projectRoot: dir, profile: \"zai\"}\n1070: \t_, err := r.Run(\"analyst\", j)\n1071: \tif err == nil {\n1072: \t\tt.Fatal(\"Run = nil error, want the docker-launch failure (docker is not on the test PATH)\")\n1073: \t}\n1074: \tif pruneCalls != 1 {\n1075: \t\tt.Errorf(\"pruneOrphans called %d times, want 1\", pruneCalls)\n1076: \t}\n1077: \tif !strings.Contains(err.Error(), \"executable file not found\") {\n1078: \t\tt.Errorf(\"the invocation must have proceeded to the docker launch:\\n%v\", err)\n1079: \t}\n1080: }\n1081: \n1082: // TestCommandAgentRunnerPruneFailureDoesNotAbort: a prune failure only warns\n1083: // (into the diag buffer, which surfaces in the invocation error) and never\n1084: // aborts the invocation — the docker launch is still attempted.\n1085: func TestCommandAgentRunnerPruneFailureDoesNotAbort(t *testing.T) {\n1086: \tdir, j := pruneTestJob(t)\n1087: \n1088: \told := pruneOrphans\n1089: \tpruneOrphans = func(diag io.Writer) (session.PruneResult, error) {\n1090: \t\treturn session.PruneResult{}, errors.New(\"Cannot connect to the Docker daemon\")\n1091: \t}\n1092: \tt.Cleanup(func() { pruneOrphans = old })\n1093: \n1094: \tr := &commandAgentRunner{projectRoot: dir, profile: \"zai\"}\n1095: \t_, err := r.Run(\"analyst\", j)\n1096: \tif err == nil {\n1097: \t\tt.Fatal(\"Run = nil error, want the docker-launch failure (docker is not on the test PATH)\")\n1098: \t}\n1099: \tif !strings.Contains(err.Error(), \"could not prune orphaned containers\") {\n1100: \t\tt.Errorf(\"missing the prune warning in the invocation error:\\n%v\", err)\n1101: \t}\n1102: \tif !strings.Contains(err.Error(), \"executable file not found\") {\n1103: \t\tt.Errorf(\"the invocation must proceed past a prune failure (docker attempted):\\n%v\", err)\n1104: \t}\n1105: }\n1106: \n1107: // TestRunWritesSessionLogPerInvocation pins TASK-1's session.log persistence\n1108: // at the loop level: Run appends one section per invocation — header\n1109: // (agent + attempt + timestamp) followed by the raw captured output — to\n1110: // docs/jobs/<id>_<slug>/session.log, for every invocation in order. REQUIRED\n1111: // (TASK-5): the git-level assertion that the worktree is clean after Run —\n1112: // the final section must have been committed by the loop-exit sweep, or mg\n1113: // done's clean-tree check would refuse a just-finished run. The job runs in\n1114: // a REAL linked worktree (initLinkedWorktreeRepo), the production shape, so\n1115: // the sweep actually commits the final section into the job's own worktree\n1116: // and the clean-tree assertion exercises it meaningfully.\n1117: func TestRunWritesSessionLogPerInvocation(t *testing.T) {\n1118: \troot, wt, j := initLinkedWorktreeRepo(t)\n1119: \tr := &fakeRunner{t: t, root: wt, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n1120: \t\tswitch agent {\n1121: \t\tcase \"analyst\":\n1122: \t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n1123: \t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n1124: \t\tcase \"developer\":\n1125: \t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n1126: \t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n1127: \t\tcase \"reviewer\":\n1128: \t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n1129: \t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n1130: \t\t}\n1131: \t\treturn []byte(\"raw \" + agent + \" output\\n\")\n1132: \t}}\n1133: \n1134: \tvar log bytes.Buffer\n1135: \tgot := Run(root, j, r, &log, nil)\n1136: \tif got.Kind != orchestrate.StopFinished {\n1137: \t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n1138: \t}\n1139: \n1140: \tdata, err := os.ReadFile(filepath.Join(j.Dir, \"session.log\"))\n1141: \tif err != nil {\n1142: \t\tt.Fatalf(\"reading session.log: %v\", err)\n1143: \t}\n1144: \tout := string(data)\n1145: \t// Exactly one section per invocation, headers and raw content in order.\n1146: \tassertLogOrder(t, out, []string{\n1147: \t\t\"analyst (attempt 1)\",\n1148: \t\t\"raw analyst output\",\n1149: \t\t\"developer (attempt 1)\",\n1150: \t\t\"raw developer output\",\n1151: \t\t\"reviewer (attempt 1)\",\n1152: \t\t\"raw reviewer output\",\n1153: \t})\n1154: \tif n := sectionHeaderCount(out); n != 3 {\n1155: \t\tt.Errorf(\"session.log has %d section headers, want 3 (one per invocation)\", n)\n1156: \t}\n1157: \n1158: \t// REQUIRED: the loop-exit sweep must have committed the final session.log\n1159: \t// section in the job's linked worktree, so `git status --porcelain` is\n1160: \t// empty there — mg done's clean-tree check (git.WorkingTreeDirty) can\n1161: \t// never refuse a just-finished run.\n1162: \tif status := mgGit(t, wt, \"status\", \"--porcelain\"); status != \"\" {\n1163: \t\tt.Errorf(\"job worktree not clean after Run (final session.log section must be committed by the loop-exit sweep):\\n%s\", status)\n1164: \t}\n1165: }\n1166: \n1167: // TestRunDoesNotSweepMainWorktree pins the loop-exit sweep's main-worktree\n1168: // gate: for a pre-worktree job (the job branch checked out in the MAIN\n1169: // worktree itself — initTestRepo's shape, an explicitly supported state) the\n1170: // sweep must be skipped entirely. Without the gate, git.CommitAll on the\n1171: // main worktree would stage and commit the user's own uncommitted work — an\n1172: // unexcluded .env included — as [<id>] chore: commit all on the job branch:\n1173: // precisely the hazard session.SweepJobWorktree's\n1174: // ProjectRoot == InvocationRoot gate exists for. The test plants an\n1175: // untracked .env in the main worktree and runs a marker-stop loop (a single\n1176: // invocation whose output the fake runner never commits, so the ONLY thing\n1177: // that could commit the .env is the loop-exit sweep), then asserts the .env\n1178: // is still untracked with its content untouched and that no sweep commit\n1179: // landed on the branch. (The final session.log section staying uncommitted\n1180: // here is the accepted trade-off — the host never sweeps the main worktree,\n1181: // by design.)\n1182: func TestRunDoesNotSweepMainWorktree(t *testing.T) {\n1183: \troot, j := initTestRepo(t)\n1184: \n1185: \t// The user's own uncommitted work in the main worktree — the exact file\n1186: \t// the gate exists to keep off the job branch.\n1187: \tconst envContent = \"CLAUDE_CODE_OAUTH_TOKEN=secret-token\\n\"\n1188: \tif err := os.WriteFile(filepath.Join(root, \".env\"), []byte(envContent), 0o644); err != nil {\n1189: \t\tt.Fatal(err)\n1190: \t}\n1191: \n1192: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n1193: \t\treturn []byte(\"NEEDS-HUMAN-INPUT: which auth provider should this use?\\n\")\n1194: \t}}\n1195: \n1196: \tvar log bytes.Buffer\n1197: \tgot := Run(root, j, r, &log, nil)\n1198: \tif got.Kind != orchestrate.StopNeedsHuman {\n1199: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman (reason: %s)\", got.Kind, got.Reason)\n1200: \t}\n1201: \tif len(r.calls) != 1 {\n1202: \t\tt.Fatalf(\"calls = %v, want exactly one invocation (marker stop)\", r.calls)\n1203: \t}\n1204: \n1205: \t// The .env must still be untracked — the fake runner never runs\n1206: \t// `git add -A`, so the only thing that could have committed it is the\n1207: \t// loop-exit sweep, and the gate must have skipped it.\n1208: \tstatus := mgGit(t, root, \"status\", \"--porcelain\")\n1209: \tif !strings.Contains(status, \"?? .env\") {\n1210: \t\tt.Errorf(\"main worktree status does not show .env as untracked, want it left untouched (the loop-exit sweep must skip the main worktree):\\n%s\", status)\n1211: \t}\n1212: \tfor _, line := range strings.Split(mgGit(t, root, \"log\", \"--oneline\"), \"\\n\") {\n1213: \t\tif strings.Contains(line, \"chore: commit all\") {\n1214: \t\t\tt.Errorf(\"branch log contains a sweep commit the main-worktree gate should have prevented: %s\", line)\n1215: \t\t}\n1216: \t}\n1217: \tdata, err := os.ReadFile(filepath.Join(root, \".env\"))\n1218: \tif err != nil {\n1219: \t\tt.Fatalf(\"reading .env: %v\", err)\n1220: \t}\n1221: \tif string(data) != envContent {\n1222: \t\tt.Errorf(\".env content changed: %q, want %q\", data, envContent)\n1223: \t}\n1224: }\n1225: \n1226: // TestRunStopsOnNeedsHumanMarkerInClaudeStreamJSON proves the marker\n1227: // detection holds at the loop level against the real\n1228: // `claude --print --verbose --output-format stream-json` shape — a JSONL\n1229: // stream of system/assistant/user/result events whose response prose lives\n1230: // in assistant events' message.content text blocks (see\n1231: // orchestrate.realClaudeStreamJSONL, captured live against claude 2.1.247) —\n1232: // not just against the plain-text / Claude-JSON / opencode-JSONL shapes the\n1233: // other marker tests use. It also pins the run.log contract for a\n1234: // stream-json-driven run: the log shows the extracted prose (ResultText),\n1235: // never the raw JSONL, while session.log holds the raw stream — and the\n1236: // loop-exit sweep leaves the job's linked worktree clean (the marker stop is\n1237: // the first invocation, so ONLY the loop-exit sweep can have committed the\n1238: // section — the per-invocation sweep in commandAgentRunner.Run never runs\n1239: // for the fake runner).\n1240: func TestRunStopsOnNeedsHumanMarkerInClaudeStreamJSON(t *testing.T) {\n1241: \troot, wt, j := initLinkedWorktreeRepo(t)\n1242: \n1243: \t// A minimal but real stream-json output with the marker inside an\n1244: \t// assistant text event's message.content and the result event's result\n1245: \t// field (as a real marker response would carry it).\n1246: \tconst streamShape = `{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"ses_test\"}\n1247: {\"type\":\"assistant\",\"message\":{\"id\":\"msg_01\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Looked at tasks.md.\\nNEEDS-HUMAN-INPUT: which auth provider should this use?\"}]}}\n1248: {\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_01\",\"content\":\"TASK-1: do the thing\"}]}}\n1249: {\"type\":\"assistant\",\"message\":{\"id\":\"msg_02\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Asking the human.\"}]}}\n1250: {\"type\":\"result\",\"subtype\":\"success\",\"result\":\"Looked at tasks.md.\\nNEEDS-HUMAN-INPUT: which auth provider should this use?\"}\n1251: `\n1252: \n1253: \tr := &fakeRunner{t: t, root: wt, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n1254: \t\treturn []byte(streamShape)\n1255: \t}}\n1256: \n1257: \tvar log bytes.Buffer\n1258: \tgot := Run(root, j, r, &log, nil)\n1259: \tif got.Kind != orchestrate.StopNeedsHuman {\n1260: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n1261: \t}\n1262: \tif !strings.Contains(got.Reason, \"which auth provider should this use?\") {\n1263: \t\tt.Errorf(\"Reason = %q, want it to contain the marker's reason text\", got.Reason)\n1264: \t}\n1265: \tif len(r.calls) != 1 {\n1266: \t\tt.Errorf(\"calls = %v, want exactly one invocation (stopped immediately)\", r.calls)\n1267: \t}\n1268: \tout := log.String()\n1269: \tif strings.Contains(out, `\"type\":\"assistant\"`) || strings.Contains(out, `\"type\":\"result\"`) {\n1270: \t\tt.Errorf(\"run.log contains raw JSONL, want the extracted prose (ResultText):\\n%s\", out)\n1271: \t}\n\n(Output capped at 50 KB. Showing lines 1-1271. Use offset=1272 to continue.)\n</content>","metadata":{"preview":"package main\n\nimport (\n\t\"bytes\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n\t\"github.com/lmuskalla/manigot/internal/session\"","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/src/cmd/mg/jdi_test.go","text":"package main\n\nimport (\n\t\"bytes\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n\t\"github.com/lmuskalla/manigot/internal/session\"\n)\n\n// runGit runs git -C dir args, failing the test on any error — mirrors\n// tui/internal/git's own test helper, duplicated here since it is\n// unexported in that package.\nfunc runGit(t *testing.T, dir string, args ...string) {\n\tt.Helper()\n\tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"git %s in %s: %v\\n%s\", strings.Join(args, \" \"), dir, err, out)\n\t}\n}\n\n// initTestRepo creates a fresh git repo at a temp dir with a job scaffold\n// (brief.md only — tasks/implementation/verdict are written by the fake\n// runner as the loop progresses) on its own job branch, and returns the\n// job.Job ready to hand to Run.\nfunc initTestRepo(t *testing.T) (root string, j job.Job) {\n\tt.Helper()\n\troot = t.TempDir()\n\trunGit(t, root, \"init\", \"-q\")\n\trunGit(t, root, \"config\", \"user.email\", \"t@example.com\")\n\trunGit(t, root, \"config\", \"user.name\", \"Test\")\n\trunGit(t, root, \"config\", \"commit.gpgsign\", \"false\")\n\n\tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(root, \"README\"), []byte(\"init\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGit(t, root, \"add\", \"README\")\n\trunGit(t, root, \"commit\", \"-q\", \"-m\", \"init\")\n\n\tconst jobName = \"aaaa01_test-job\"\n\tconst branch = \"feature/aaaa01_test-job\"\n\tjobDir := filepath.Join(root, \"docs\", \"jobs\", jobName)\n\tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tbrief := \"# Brief: test job\\n\\nstatus: open\\ntype: feature\\nid: aaaa01\\nbranch: \" + branch + \"\\n\\n\" +\n\t\t\"## What\\n\\nsomething substantial enough to count as written\\nand a second line so isWritten's rule is satisfied\\n\"\n\tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGit(t, root, \"checkout\", \"-q\", \"-b\", branch)\n\trunGit(t, root, \"add\", \"-A\")\n\trunGit(t, root, \"commit\", \"-q\", \"-m\", \"[aaaa01] scaffold job\")\n\n\tj = job.Job{\n\t\tName:   jobName,\n\t\tDir:    jobDir,\n\t\tRoot:   root,\n\t\tID:     \"aaaa01\",\n\t\tBranch: branch,\n\t}\n\treturn root, j\n}\n\n// initLinkedWorktreeRepo creates a fresh git repo whose job branch is checked\n// out in a REAL linked worktree — the production shape `mg job` produces —\n// unlike initTestRepo's pre-worktree shape (branch checked out in the main\n// worktree itself). Run-level session.log tests use this shape so the\n// loop-exit sweep's CommitAll runs against the job's own worktree and the\n// REQUIRED clean-tree assertion actually exercises it (in the pre-worktree\n// shape the sweep is gated off by design — see TestRunDoesNotSweepMainWorktree).\n//\n// Returns the main project root (matching job.Discover's semantics: a Job's\n// Root is always the main root, never its own worktree), the job's linked\n// worktree path, and the job.Job.\nfunc initLinkedWorktreeRepo(t *testing.T) (root, wt string, j job.Job) {\n\tt.Helper()\n\troot = t.TempDir()\n\trunGit(t, root, \"init\", \"-q\", \"-b\", \"main\")\n\trunGit(t, root, \"config\", \"user.email\", \"t@example.com\")\n\trunGit(t, root, \"config\", \"user.name\", \"Test\")\n\trunGit(t, root, \"config\", \"commit.gpgsign\", \"false\")\n\n\tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(root, \"README\"), []byte(\"init\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGit(t, root, \"add\", \"README\")\n\trunGit(t, root, \"commit\", \"-q\", \"-m\", \"init\")\n\n\tconst jobName = \"aaaa01_test-job\"\n\tconst branch = \"feature/aaaa01_test-job\"\n\tjobDir := filepath.Join(root, \"docs\", \"jobs\", jobName)\n\tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tbrief := \"# Brief: test job\\n\\nstatus: open\\ntype: feature\\nid: aaaa01\\nbranch: \" + branch + \"\\n\\n\" +\n\t\t\"## What\\n\\nsomething substantial enough to count as written\\nand a second line so isWritten's rule is satisfied\\n\"\n\tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGit(t, root, \"checkout\", \"-q\", \"-b\", branch)\n\trunGit(t, root, \"add\", \"-A\")\n\trunGit(t, root, \"commit\", \"-q\", \"-m\", \"[aaaa01] scaffold job\")\n\n\t// Back to main, then add the job's own linked worktree — the shape mg\n\t// job creates for a normal (post-worktree) job.\n\trunGit(t, root, \"checkout\", \"-q\", \"main\")\n\twt = filepath.Join(root, \".manigot-worktrees\", jobName)\n\trunGit(t, root, \"worktree\", \"add\", \"-q\", wt, branch)\n\n\tj = job.Job{\n\t\tName:   jobName,\n\t\tDir:    filepath.Join(wt, \"docs\", \"jobs\", jobName),\n\t\tRoot:   root, // the main project root — job.Discover's semantics\n\t\tID:     \"aaaa01\",\n\t\tBranch: branch,\n\t}\n\treturn root, wt, j\n}\n\n// writeJobFile writes content to one of the job's four files.\nfunc writeJobFile(t *testing.T, j job.Job, filename, content string) {\n\tt.Helper()\n\tif err := os.WriteFile(filepath.Join(j.Dir, filename), []byte(content), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\nfunc commit(t *testing.T, root, msg string) {\n\tt.Helper()\n\trunGit(t, root, \"add\", \"-A\")\n\trunGit(t, root, \"commit\", \"-q\", \"-m\", msg)\n}\n\n// fakeRunner implements AgentRunner by calling fn, which simulates an agent\n// invocation's effect on disk/git — the same effect a real one would have\n// via its own file writes and commits — and returns canned output.\ntype fakeRunner struct {\n\troot  string\n\tcalls []string\n\tfn    func(t *testing.T, root string, j job.Job, agent string, call int) []byte\n\tt     *testing.T\n}\n\nfunc (f *fakeRunner) Run(agent string, j job.Job) ([]byte, error) {\n\tf.calls = append(f.calls, agent)\n\treturn f.fn(f.t, f.root, j, agent, len(f.calls)), nil\n}\n\n// TestRunJDIJobShortFlagAccepted pins that `-j` is a recognized alias of\n// `--job` in runJDI's own flag set: with no docs/ directory anywhere above\n// the working dir, the run must get past flag parsing (an unknown flag would\n// exit 2) and fail cleanly at project resolution instead.\nfunc TestRunJDIJobShortFlagAccepted(t *testing.T) {\n\tt.Chdir(t.TempDir())\n\tvar out, errOut strings.Builder\n\tif code := runJDI([]string{\"-j\", \"somejob\"}, &out, &errOut); code != 1 {\n\t\tt.Errorf(\"-j exit code = %d, want 1 (no docs/ dir); stderr:\\n%s\", code, errOut.String())\n\t}\n\tif !strings.Contains(errOut.String(), \"could not find a docs/ directory\") {\n\t\tt.Errorf(\"expected the no-docs error, got:\\n%s\", errOut.String())\n\t}\n}\n\nfunc TestRunJDIUnknownFlagRejected(t *testing.T) {\n\tvar out, errOut strings.Builder\n\tif code := runJDI([]string{\"-x\", \"somejob\"}, &out, &errOut); code != 2 {\n\t\tt.Errorf(\"unknown flag exit code = %d, want 2\", code)\n\t}\n}\n\nfunc TestRunHappyPath(t *testing.T) {\n\troot, j := initTestRepo(t)\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"analyst\":\n\t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n\t\tcase \"reviewer\":\n\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n\t\t}\n\t\treturn []byte(\"ok\")\n\t}}\n\n\tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n\tif got.Kind != orchestrate.StopFinished {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n\t}\n\twantCalls := []string{\"analyst\", \"developer\", \"reviewer\"}\n\tif strings.Join(r.calls, \",\") != strings.Join(wantCalls, \",\") {\n\t\tt.Errorf(\"calls = %v, want %v\", r.calls, wantCalls)\n\t}\n}\n\n// TestRunLogsAgentInvoked confirms Run writes an \"invoked\" event to the log\n// immediately before each agent invocation (TASK-2), reusing the same\n// attempt number logInvocation's own post-run header uses. The attempt is\n// per agent: every agent's first call is attempt 1, so the happy path reads\n// analyst 1 -> developer 1 -> reviewer 1, not a run-wide 1/2/3.\nfunc TestRunLogsAgentInvoked(t *testing.T) {\n\troot, j := initTestRepo(t)\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"analyst\":\n\t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n\t\tcase \"reviewer\":\n\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n\t\t}\n\t\treturn []byte(\"ok\")\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopFinished {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n\t}\n\tout := log.String()\n\tfor _, want := range []string{\n\t\t\"analyst invoked (attempt 1)\",\n\t\t\"developer invoked (attempt 1)\",\n\t\t\"reviewer invoked (attempt 1)\",\n\t} {\n\t\tif !strings.Contains(out, want) {\n\t\t\tt.Errorf(\"log missing %q, got:\\n%s\", want, out)\n\t\t}\n\t}\n}\n\n// TestRunReportsStatus exercises Run's StatusFunc callback (TASK-8): a\n// job.JDIRunning report before each invocation naming that invocation's\n// agent, and a final job.JDIStoppedFinished report naming the last agent\n// that ran.\nfunc TestRunReportsStatus(t *testing.T) {\n\troot, j := initTestRepo(t)\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"analyst\":\n\t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n\t\tcase \"reviewer\":\n\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n\t\t}\n\t\treturn []byte(\"ok\")\n\t}}\n\n\ttype report struct {\n\t\tstate job.JDIState\n\t\tagent string\n\t}\n\tvar reports []report\n\tstatus := func(state job.JDIState, agent string) {\n\t\treports = append(reports, report{state, agent})\n\t}\n\n\tgot := Run(root, j, r, &bytes.Buffer{}, status)\n\tif got.Kind != orchestrate.StopFinished {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n\t}\n\n\twant := []report{\n\t\t{job.JDIRunning, \"analyst\"},\n\t\t{job.JDIRunning, \"developer\"},\n\t\t{job.JDIRunning, \"reviewer\"},\n\t\t{job.JDIStoppedFinished, \"reviewer\"},\n\t}\n\tif len(reports) != len(want) {\n\t\tt.Fatalf(\"reports = %+v, want %+v\", reports, want)\n\t}\n\tfor i, w := range want {\n\t\tif reports[i] != w {\n\t\t\tt.Errorf(\"reports[%d] = %+v, want %+v\", i, reports[i], w)\n\t\t}\n\t}\n}\n\n// TestRunOneBounceThenApproved covers the bounce path: a rejected review\n// sends control back to the developer once, and a second approved review\n// ends the run. The log headers assert the per-agent attempt semantics that\n// motivated the brief — the developer's second call is that developer's\n// attempt 2, NOT attempt 4 as a run-wide counter would produce, and the\n// reviewer's first call is attempt 1 — with each invocation's invoked and\n// finished headers sharing the same number.\nfunc TestRunOneBounceThenApproved(t *testing.T) {\n\troot, j := initTestRepo(t)\n\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\n\treviewCalls := 0\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", fmt.Sprintf(\"# Implementation\\n\\nTASK-1: attempt %d\\n\", call))\n\t\t\tcommit(t, root, fmt.Sprintf(\"[aaaa01] TASK-1: attempt %d\", call))\n\t\tcase \"reviewer\":\n\t\t\treviewCalls++\n\t\t\tif reviewCalls == 1 {\n\t\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: FAIL\\n\\n## Overall\\n\\nNEEDS WORK\\n\")\n\t\t\t\tcommit(t, root, \"[aaaa01] verdict: needs work\")\n\t\t\t} else {\n\t\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\t\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n\t\t\t}\n\t\t}\n\t\treturn []byte(\"ok\")\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopFinished {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n\t}\n\twantCalls := []string{\"developer\", \"reviewer\", \"developer\", \"reviewer\"}\n\tif strings.Join(r.calls, \",\") != strings.Join(wantCalls, \",\") {\n\t\tt.Errorf(\"calls = %v, want %v\", r.calls, wantCalls)\n\t}\n\n\t// Per-agent attempts on the bounce path: each agent's first call is\n\t// attempt 1 and the bounced-back developer's second call is attempt 2 —\n\t// not attempt 4 as the old run-wide i+1 counter produced. The invoked and\n\t// finished headers of one invocation share the same number.\n\tassertLogOrder(t, log.String(), []string{\n\t\t\"developer invoked (attempt 1)\",\n\t\t\"developer finished (attempt 1)\",\n\t\t\"reviewer invoked (attempt 1)\",\n\t\t\"reviewer finished (attempt 1)\",\n\t\t\"developer invoked (attempt 2)\",\n\t\t\"developer finished (attempt 2)\",\n\t\t\"reviewer invoked (attempt 2)\",\n\t\t\"reviewer finished (attempt 2)\",\n\t})\n}\n\nfunc TestRunStopsAfterOneBounceExhausted(t *testing.T) {\n\troot, j := initTestRepo(t)\n\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", fmt.Sprintf(\"# Implementation\\n\\nTASK-1: attempt %d\\n\", call))\n\t\t\tcommit(t, root, fmt.Sprintf(\"[aaaa01] TASK-1: attempt %d\", call))\n\t\tcase \"reviewer\":\n\t\t\twriteJobFile(t, j, \"verdict.md\", fmt.Sprintf(\"# Verdict\\n\\nTASK-1: FAIL (attempt %d)\\n\\n## Overall\\n\\nREJECTED\\n\", call))\n\t\t\tcommit(t, root, fmt.Sprintf(\"[aaaa01] verdict: rejected (attempt %d)\", call))\n\t\t}\n\t\treturn []byte(\"ok\")\n\t}}\n\n\tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman (reason: %s)\", got.Kind, got.Reason)\n\t}\n\tif !strings.Contains(got.Reason, \"review cycle\") {\n\t\tt.Errorf(\"Reason = %q, want it to contain \\\"review cycle\\\"\", got.Reason)\n\t}\n\t// developer, reviewer (round 1, rejected), developer (the one allowed\n\t// bounce), reviewer (round 2, rejected again) — then stop, no third\n\t// developer bounce.\n\twantCalls := []string{\"developer\", \"reviewer\", \"developer\", \"reviewer\"}\n\tif strings.Join(r.calls, \",\") != strings.Join(wantCalls, \",\") {\n\t\tt.Errorf(\"calls = %v, want %v\", r.calls, wantCalls)\n\t}\n\tcount, err := git.CountVerdictCommits(root, j.Branch, j.ID)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif count != 2 {\n\t\tt.Errorf(\"verdict commit count = %d, want 2\", count)\n\t}\n}\n\nfunc TestRunStopsOnNeedsHumanMarker(t *testing.T) {\n\troot, j := initTestRepo(t)\n\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\treturn []byte(\"I looked at the brief.\\nNEEDS-HUMAN-INPUT: which auth provider should this use?\\n\")\n\t}}\n\n\tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n\t}\n\tif !strings.Contains(got.Reason, \"which auth provider should this use?\") {\n\t\tt.Errorf(\"Reason = %q, want it to contain the marker's reason text\", got.Reason)\n\t}\n\tif len(r.calls) != 1 {\n\t\tt.Errorf(\"calls = %v, want exactly one invocation (stopped immediately)\", r.calls)\n\t}\n}\n\n// TestRunStopsOnNeedsHumanMarkerInOpenCodeJSONL proves the marker detection\n// holds at the loop level against the real `opencode run --format json`\n// JSONL shape — a stream of typed events whose response prose lives in a\n// \"text\"-event's part.text (see orchestrate.realOpenCodeJSONL) — not just\n// against the plain-text / Claude-JSON shapes the other marker tests use.\n// It also pins the run.log contract for an opencode-driven run: the log must\n// show the extracted prose (ResultText), never the raw JSONL blob.\nfunc TestRunStopsOnNeedsHumanMarkerInOpenCodeJSONL(t *testing.T) {\n\troot, j := initTestRepo(t)\n\n\t// A minimal but real `opencode run --format json` output (the 3-line\n\t// step_start/text/step_finish shape captured live in the 63quv2\n\t// verification), with the marker inside the text event's part.text.\n\tconst realShape = `{\"type\":\"step_start\",\"part\":{\"type\":\"step-start\"}}\n{\"type\":\"text\",\"part\":{\"type\":\"text\",\"text\":\"Looked at tasks.md.\\nNEEDS-HUMAN-INPUT: which auth provider should this use?\"}}\n{\"type\":\"step_finish\",\"part\":{\"type\":\"step-finish\",\"reason\":\"stop\"}}\n`\n\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\treturn []byte(realShape)\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n\t}\n\tif !strings.Contains(got.Reason, \"which auth provider should this use?\") {\n\t\tt.Errorf(\"Reason = %q, want it to contain the marker's reason text\", got.Reason)\n\t}\n\tif len(r.calls) != 1 {\n\t\tt.Errorf(\"calls = %v, want exactly one invocation (stopped immediately)\", r.calls)\n\t}\n\tout := log.String()\n\tif strings.Contains(out, `\"type\":\"step_start\"`) || strings.Contains(out, `{\"type\":\"text\"`) {\n\t\tt.Errorf(\"run.log contains raw JSONL, want the extracted prose (ResultText):\\n%s\", out)\n\t}\n\tif !strings.Contains(out, \"which auth provider should this use?\") {\n\t\tt.Errorf(\"run.log missing the marker reason prose, got:\\n%s\", out)\n\t}\n}\n\nfunc TestRunStopsOnStall(t *testing.T) {\n\troot, j := initTestRepo(t)\n\n\t// analyst \"runs\" but writes/commits nothing at all — Stage() and HEAD\n\t// stay unchanged, so the second consecutive analyst invocation must\n\t// trip the stall backstop rather than loop forever.\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\treturn []byte(\"thinking out loud, not sure what to do\")\n\t}}\n\n\tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n\t}\n\tif !strings.Contains(got.Reason, \"no progress\") {\n\t\tt.Errorf(\"Reason = %q, want it to mention no progress\", got.Reason)\n\t}\n\tif len(r.calls) != 2 {\n\t\tt.Errorf(\"calls = %v, want exactly two invocations (stall detected on the second)\", r.calls)\n\t}\n}\n\n// TestRunStallProbeUsesFreshContext pins the stall backstop against a\n// regression where the post-agent HEAD probe reused the pre-agent probe\n// context: an agent invocation (runner.Run) takes minutes in production, so\n// by the time the probe ran the 10s context was long expired and the probe\n// returned \"\" — headAfter never equaled headBefore, noChange was always\n// false, and a genuinely stuck agent ran to maxIterations instead of\n// stopping after two no-op invocations. The test simulates that by lowering\n// jdiProbeTimeout and making the fake runner's Run outlive it (but write\n// nothing), then asserting the backstop still fires: it can only if the\n// post-agent probe used a fresh context.\nfunc TestRunStallProbeUsesFreshContext(t *testing.T) {\n\troot, j := initTestRepo(t)\n\n\torig := jdiProbeTimeout\n\tjdiProbeTimeout = 200 * time.Millisecond\n\tt.Cleanup(func() { jdiProbeTimeout = orig })\n\n\t// The fake agent \"runs\" longer than the probe timeout and writes\n\t// nothing at all — exactly the production shape of a stuck agent. 600ms\n\t// comfortably outlives the 200ms probe timeout, and 200ms leaves the\n\t// pre-agent probes (three fast, real git execs sharing the loop-top\n\t// context) plenty of room to complete within it even on a loaded CI\n\t// machine.\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\ttime.Sleep(600 * time.Millisecond)\n\t\treturn []byte(\"thinking out loud, not sure what to do\")\n\t}}\n\n\tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n\t}\n\tif !strings.Contains(got.Reason, \"no progress\") {\n\t\tt.Errorf(\"Reason = %q, want it to mention no progress\", got.Reason)\n\t}\n\tif len(r.calls) != 2 {\n\t\tt.Errorf(\"calls = %v, want exactly two invocations (stall detected on the second, not looped to maxIterations)\", r.calls)\n\t}\n}\n\nfunc TestRunStopsOnRunnerError(t *testing.T) {\n\troot, j := initTestRepo(t)\n\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\n\tr := &errRunner{}\n\tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n\t}\n\tif !strings.Contains(got.Reason, \"boom\") {\n\t\tt.Errorf(\"Reason = %q, want it to mention the runner error\", got.Reason)\n\t}\n}\n\n// TestRunLogsImmediateStopReason confirms an immediate stop — Next()\n// returning a Stop* decision before any agent has ever run, e.g. a\n// genuinely-unwritten brief.md — writes its Reason to the log, not just to\n// mg jdi's own return value. Before this fix, this case left the log at 0\n// bytes, which read as \"mg jdi didn't do anything at all\" rather than \"mg\n// jdi correctly stopped immediately, here's why\".\nfunc TestRunLogsImmediateStopReason(t *testing.T) {\n\troot, j := initTestRepo(t)\n\t// Overwrite brief.md with the genuinely-unwritten scaffold shape (no\n\t// substantive content at all) so Stage() reports StageDefine and Next\n\t// stops before ever invoking an agent.\n\twriteJobFile(t, j, \"brief.md\", \"# Brief: test job\\n\\nstatus: open\\ntype: feature\\nid: aaaa01\\n\\n\"+\n\t\t\"## What\\n\\n<!-- placeholder -->\\n\")\n\tcommit(t, root, \"[aaaa01] brief: reset to scaffold\")\n\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tt.Fatal(\"no agent should have been invoked for an immediate stop\")\n\t\treturn nil\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman (reason: %s)\", got.Kind, got.Reason)\n\t}\n\tif len(r.calls) != 0 {\n\t\tt.Fatalf(\"calls = %v, want no invocations (immediate stop)\", r.calls)\n\t}\n\tif log.Len() == 0 {\n\t\tt.Fatal(\"run.log is empty, want it to contain the immediate-stop reason\")\n\t}\n\tif !strings.Contains(log.String(), got.Reason) {\n\t\tt.Errorf(\"log = %q, want it to contain the stop reason %q\", log.String(), got.Reason)\n\t}\n}\n\n// TestRunLogsJobFinishedOnNormalStop confirms Run writes a \"job finished\"\n// event to the log at loop exit (TASK-4) once an agent has actually run —\n// distinct from the immediate-stop case covered by\n// TestRunLogsImmediateStopReason below, which must not repeat the same\n// reason text twice in a row.\nfunc TestRunLogsJobFinishedOnNormalStop(t *testing.T) {\n\troot, j := initTestRepo(t)\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"analyst\":\n\t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n\t\tcase \"reviewer\":\n\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n\t\t}\n\t\treturn []byte(\"ok\")\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopFinished {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n\t}\n\tout := log.String()\n\tif !strings.Contains(out, \"mg jdi finished: stop-finished\") {\n\t\tt.Errorf(\"log missing job-finished event, got:\\n%s\", out)\n\t}\n\tif !strings.Contains(out, got.Reason) {\n\t\tt.Errorf(\"log missing the finish reason %q, got:\\n%s\", got.Reason, out)\n\t}\n}\n\n// TestRunImmediateStopDoesNotDuplicateReason extends\n// TestRunLogsImmediateStopReason: TASK-4's \"job finished\" event must still\n// fire for the stop-before-any-agent-ran case, but must not print the same\n// reason text logImmediateStop already printed a second time.\nfunc TestRunImmediateStopDoesNotDuplicateReason(t *testing.T) {\n\troot, j := initTestRepo(t)\n\twriteJobFile(t, j, \"brief.md\", \"# Brief: test job\\n\\nstatus: open\\ntype: feature\\nid: aaaa01\\n\\n\"+\n\t\t\"## What\\n\\n<!-- placeholder -->\\n\")\n\tcommit(t, root, \"[aaaa01] brief: reset to scaffold\")\n\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tt.Fatal(\"no agent should have been invoked for an immediate stop\")\n\t\treturn nil\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman (reason: %s)\", got.Kind, got.Reason)\n\t}\n\tout := log.String()\n\tif !strings.Contains(out, \"mg jdi finished: stop-needs-human\") {\n\t\tt.Errorf(\"log missing job-finished event, got:\\n%s\", out)\n\t}\n\tif strings.Count(out, got.Reason) != 1 {\n\t\tt.Errorf(\"reason %q appears %d times in log, want exactly 1 (not duplicated between logImmediateStop and logJobFinished):\\n%s\", got.Reason, strings.Count(out, got.Reason), out)\n\t}\n}\n\n// assertLogOrder fails the test unless every substring in wantInOrder\n// appears in out, each strictly after the previous one — i.e. out reads as\n// wantInOrder describes, start to finish.\nfunc assertLogOrder(t *testing.T, out string, wantInOrder []string) {\n\tt.Helper()\n\tpos := 0\n\tfor _, want := range wantInOrder {\n\t\tidx := strings.Index(out[pos:], want)\n\t\tif idx == -1 {\n\t\t\tt.Fatalf(\"log missing %q after position %d, want it in order %v; full log:\\n%s\", want, pos, wantInOrder, out)\n\t\t}\n\t\tpos += idx + len(want)\n\t}\n}\n\n// TestRunFullLogSequenceHappyPath is TASK-6's end-to-end coverage: a full\n// mg-jdi run (mimicking main()'s own logStarted call ahead of Run) produces\n// the complete started -> invoked -> finished -> ... -> job finished\n// sequence the brief asked for, not just each event in isolation.\nfunc TestRunFullLogSequenceHappyPath(t *testing.T) {\n\troot, j := initTestRepo(t)\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"analyst\":\n\t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\t\t\treturn []byte(\"Wrote tasks.md with one task.\")\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n\t\t\treturn []byte(\"Implemented TASK-1, all tests pass.\")\n\t\tcase \"reviewer\":\n\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n\t\t\treturn []byte(\"Reviewed and approved.\")\n\t\t}\n\t\treturn nil\n\t}}\n\n\tvar log bytes.Buffer\n\tlogStarted(&log, j.Name, \"claude-pro\")\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopFinished {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n\t}\n\n\tassertLogOrder(t, log.String(), []string{\n\t\t\"mg jdi started\",\n\t\t\"analyst invoked (attempt 1)\",\n\t\t\"analyst finished (attempt 1)\",\n\t\t\"Wrote tasks.md with one task.\",\n\t\t\"developer invoked (attempt 1)\",\n\t\t\"developer finished (attempt 1)\",\n\t\t\"Implemented TASK-1, all tests pass.\",\n\t\t\"reviewer invoked (attempt 1)\",\n\t\t\"reviewer finished (attempt 1)\",\n\t\t\"Reviewed and approved.\",\n\t\t\"mg jdi finished: stop-finished\",\n\t})\n}\n\n// TestRunFullLogSequenceDedupsMatchingOutput is TASK-6's dedup-case\n// end-to-end coverage: when an agent's response text is just an echo of the\n// file it wrote (TASK-5), the full sequence still reads started -> invoked\n// -> finished -> ... -> job finished, but the finished body is the short\n// omission note instead of the file's full content repeated in the log.\nfunc TestRunFullLogSequenceDedupsMatchingOutput(t *testing.T) {\n\troot, j := initTestRepo(t)\n\tconst tasksContent = \"# Tasks\\n\\nTASK-1: do the thing\\n\"\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"analyst\":\n\t\t\twriteJobFile(t, j, \"tasks.md\", tasksContent)\n\t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\t\t\treturn []byte(tasksContent)\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n\t\t\treturn []byte(\"done\")\n\t\tcase \"reviewer\":\n\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n\t\t\treturn []byte(\"done\")\n\t\t}\n\t\treturn nil\n\t}}\n\n\tvar log bytes.Buffer\n\tlogStarted(&log, j.Name, \"claude-pro\")\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopFinished {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n\t}\n\n\tout := log.String()\n\tassertLogOrder(t, out, []string{\n\t\t\"mg jdi started\",\n\t\t\"analyst invoked (attempt 1)\",\n\t\t\"analyst finished (attempt 1)\",\n\t\t\"(output matches tasks.md, omitted)\",\n\t\t\"developer invoked (attempt 1)\",\n\t\t\"developer finished (attempt 1)\",\n\t\t\"reviewer invoked (attempt 1)\",\n\t\t\"reviewer finished (attempt 1)\",\n\t\t\"mg jdi finished: stop-finished\",\n\t})\n\tif strings.Contains(out, \"TASK-1: do the thing\") {\n\t\tt.Errorf(\"log = %q, want tasks.md's content not repeated verbatim (should be omitted)\", out)\n\t}\n}\n\ntype errRunner struct{}\n\nfunc (errRunner) Run(agent string, j job.Job) ([]byte, error) {\n\treturn nil, errors.New(\"boom\")\n}\n\n// TestCommandAgentRunnerUsesGivenProfile confirms commandAgentRunner builds\n// its --print session invocation with the profile it was constructed with\n// (TASK-5), rather than the old hardcoded config.ProfileClaudePro pin —\n// exercised for a non-default profile so a stale pin would be caught. Since\n// the runner now calls the session package in-process (no run.sh exec), the\n// pinned profile is asserted on the constructed options, and a full Run\n// against the test repo must reach the docker launch (which fails with a\n// docker-not-found error here) rather than a profile/auth/resolution error.\nfunc TestCommandAgentRunnerUsesGivenProfile(t *testing.T) {\n\troot, j := initTestRepo(t)\n\n\tr := &commandAgentRunner{projectRoot: root, profile: \"zai\"}\n\topts := r.agentInvocation(\"developer\", j)\n\tif opts.Profile != \"zai\" {\n\t\tt.Errorf(\"invocation profile = %q, want zai\", opts.Profile)\n\t}\n\tif opts.Agent != \"developer\" || opts.Job != j.Name || !opts.Print {\n\t\tt.Errorf(\"invocation = %+v\", opts)\n\t}\n}\n\n// notifyRequest is one HTTP request the fake ntfy server captured.\ntype notifyRequest struct {\n\tmethod  string\n\tpath    string\n\tbody    string\n\theaders http.Header\n}\n\n// newNotifyCapture starts an httptest server recording every request it\n// receives (method, path, headers, body) and replying with status, so tests\n// can assert on exactly what notifyStop/notifyCrashedRun sent.\nfunc newNotifyCapture(t *testing.T, status int) (*httptest.Server, *[]notifyRequest) {\n\tt.Helper()\n\tvar got []notifyRequest\n\tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\tbody, _ := io.ReadAll(r.Body)\n\t\tgot = append(got, notifyRequest{method: r.Method, path: r.URL.Path, body: string(body), headers: r.Header.Clone()})\n\t\tw.WriteHeader(status)\n\t}))\n\tt.Cleanup(srv.Close)\n\treturn srv, &got\n}\n\n// configureNtfy points the ntfy config (internal/notify's FromConfig, which\n// reads config.EnvValue) at the test server by setting the process env the\n// .env-less fake checkout falls back to.\nfunc configureNtfy(t *testing.T, srvURL, topic, token string) {\n\tt.Helper()\n\tt.Setenv(\"NTFY_URL\", srvURL)\n\tt.Setenv(\"NTFY_TOPIC\", topic)\n\tt.Setenv(\"NTFY_TOKEN\", token)\n}\n\nfunc TestNotifyStopFinished(t *testing.T) {\n\tprofileCheckout(t, \"\")\n\tsrv, got := newNotifyCapture(t, http.StatusOK)\n\tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n\n\tvar stderr bytes.Buffer\n\tnotifyStop(&stderr, \"aaaa01_test-job\", LoopResult{Kind: orchestrate.StopFinished, Reason: \"verdict.md's Overall verdict is APPROVED\"})\n\n\tif len(*got) != 1 {\n\t\tt.Fatalf(\"received %d requests, want 1\", len(*got))\n\t}\n\treq := (*got)[0]\n\tif req.headers.Get(\"Tags\") != \"white_check_mark\" {\n\t\tt.Errorf(\"Tags header = %q, want white_check_mark\", req.headers.Get(\"Tags\"))\n\t}\n\tif req.headers.Get(\"Priority\") != \"\" {\n\t\tt.Errorf(\"Priority header = %q, want unset (default priority) for a success\", req.headers.Get(\"Priority\"))\n\t}\n\tif !strings.Contains(req.headers.Get(\"Title\"), \"aaaa01_test-job\") {\n\t\tt.Errorf(\"Title header = %q, want it to contain the job name\", req.headers.Get(\"Title\"))\n\t}\n\tif !strings.Contains(req.body, \"APPROVED\") {\n\t\tt.Errorf(\"body = %q, want it to contain the stop reason\", req.body)\n\t}\n\tif stderr.Len() != 0 {\n\t\tt.Errorf(\"stderr = %q, want empty\", stderr.String())\n\t}\n}\n\nfunc TestNotifyStopNeedsHuman(t *testing.T) {\n\tprofileCheckout(t, \"\")\n\tsrv, got := newNotifyCapture(t, http.StatusOK)\n\tconfigureNtfy(t, srv.URL, \"my-topic\", \"tok\")\n\n\tvar stderr bytes.Buffer\n\tnotifyStop(&stderr, \"aaaa01_test-job\", LoopResult{Kind: orchestrate.StopNeedsHuman, Reason: \"analyst made no progress on two consecutive runs\"})\n\n\tif len(*got) != 1 {\n\t\tt.Fatalf(\"received %d requests, want 1\", len(*got))\n\t}\n\treq := (*got)[0]\n\tif req.headers.Get(\"Tags\") != \"warning\" {\n\t\tt.Errorf(\"Tags header = %q, want warning\", req.headers.Get(\"Tags\"))\n\t}\n\tif req.headers.Get(\"Priority\") != \"4\" {\n\t\tt.Errorf(\"Priority header = %q, want 4 (high priority) for needs-human\", req.headers.Get(\"Priority\"))\n\t}\n\tif req.headers.Get(\"Authorization\") != \"Bearer tok\" {\n\t\tt.Errorf(\"Authorization header = %q, want %q\", req.headers.Get(\"Authorization\"), \"Bearer tok\")\n\t}\n\tif !strings.Contains(req.headers.Get(\"Title\"), \"needs attention\") {\n\t\tt.Errorf(\"Title header = %q, want it to say needs attention\", req.headers.Get(\"Title\"))\n\t}\n\tif !strings.Contains(req.body, \"no progress\") {\n\t\tt.Errorf(\"body = %q, want it to contain the stop reason\", req.body)\n\t}\n}\n\nfunc TestNotifyStopUnconfiguredSendsNothing(t *testing.T) {\n\tprofileCheckout(t, \"\")\n\tsrv, got := newNotifyCapture(t, http.StatusOK)\n\tconfigureNtfy(t, srv.URL, \"\", \"\") // no NTFY_TOPIC → feature off\n\n\tvar stderr bytes.Buffer\n\tnotifyStop(&stderr, \"aaaa01_test-job\", LoopResult{Kind: orchestrate.StopNeedsHuman, Reason: \"stalled\"})\n\n\tif len(*got) != 0 {\n\t\tt.Errorf(\"received %d requests, want 0 (unconfigured must be a strict no-op)\", len(*got))\n\t}\n\tif stderr.Len() != 0 {\n\t\tt.Errorf(\"stderr = %q, want empty\", stderr.String())\n\t}\n}\n\nfunc TestNotifyStopSendFailureWarnsButDoesNotAbort(t *testing.T) {\n\tprofileCheckout(t, \"\")\n\tsrv, _ := newNotifyCapture(t, http.StatusInternalServerError)\n\tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n\n\tvar stderr bytes.Buffer\n\tnotifyStop(&stderr, \"aaaa01_test-job\", LoopResult{Kind: orchestrate.StopFinished, Reason: \"done\"})\n\n\tout := stderr.String()\n\tif !strings.Contains(out, \"mg jdi: warning: could not send ntfy notification\") {\n\t\tt.Errorf(\"stderr = %q, want a 'could not send ntfy notification' warning\", out)\n\t}\n}\n\n// writeStaleRunningSidecar plants an old JDIRunning sidecar — the on-disk\n// signature of an mg-jdi run that was killed without ever reporting a stop\n// (job.jdiRunningStaleAfter is 30 minutes, so 2 hours is safely stale).\nfunc writeStaleRunningSidecar(t *testing.T, root, jobName string) {\n\tt.Helper()\n\tif err := os.MkdirAll(job.JDIStatusDir(root, jobName), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstale := time.Now().Add(-2 * time.Hour).UTC().Format(time.RFC3339)\n\tbody := `{\"state\":\"running\",\"agent\":\"developer\",\"updated\":\"` + stale + `\"}`\n\tif err := os.WriteFile(job.JDIStatusPath(root, jobName), []byte(body), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\nfunc TestNotifyCrashedRunNotifiesAndDedups(t *testing.T) {\n\tprofileCheckout(t, \"\")\n\tsrv, got := newNotifyCapture(t, http.StatusOK)\n\tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n\troot := t.TempDir()\n\tconst jobName = \"aaaa01_test-job\"\n\twriteStaleRunningSidecar(t, root, jobName)\n\tj := job.Job{Name: jobName, Root: root}\n\n\tvar stderr bytes.Buffer\n\tnotifyCrashedRun(&stderr, root, j)\n\n\tif len(*got) != 1 {\n\t\tt.Fatalf(\"received %d requests, want 1 (the crash notification)\", len(*got))\n\t}\n\treq := (*got)[0]\n\tif req.headers.Get(\"Tags\") != \"warning\" {\n\t\tt.Errorf(\"Tags header = %q, want warning\", req.headers.Get(\"Tags\"))\n\t}\n\tif req.headers.Get(\"Priority\") != \"4\" {\n\t\tt.Errorf(\"Priority header = %q, want 4 (high priority) for a crash\", req.headers.Get(\"Priority\"))\n\t}\n\tif !strings.Contains(req.headers.Get(\"Title\"), jobName) {\n\t\tt.Errorf(\"Title header = %q, want it to contain the job name\", req.headers.Get(\"Title\"))\n\t}\n\tif !strings.Contains(req.body, \"crashed or been killed\") {\n\t\tt.Errorf(\"body = %q, want it to describe the crash\", req.body)\n\t}\n\tif !strings.Contains(req.body, \"Last agent: developer\") {\n\t\tt.Errorf(\"body = %q, want it to name the last agent\", req.body)\n\t}\n\tif stderr.Len() != 0 {\n\t\tt.Errorf(\"stderr = %q, want empty\", stderr.String())\n\t}\n\n\t// The stale sidecar is overwritten with a stopped state, so a second\n\t// start must not re-notify about the same already-known crash.\n\tnotifyCrashedRun(&stderr, root, j)\n\tif len(*got) != 1 {\n\t\tt.Errorf(\"received %d requests after dedup, want still 1\", len(*got))\n\t}\n\tif st, ok := job.ReadJDIStatus(root, jobName); !ok || st.State != job.JDIStoppedNeedsHuman {\n\t\tt.Errorf(\"sidecar after dedup = %+v (ok=%v), want stopped:needs-human\", st, ok)\n\t}\n}\n\nfunc TestNotifyCrashedRunFreshRunningDoesNotNotify(t *testing.T) {\n\tprofileCheckout(t, \"\")\n\tsrv, got := newNotifyCapture(t, http.StatusOK)\n\tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n\troot := t.TempDir()\n\tconst jobName = \"aaaa01_test-job\"\n\t// A fresh running status means a live mg-jdi run — must not be reported\n\t// as a crash.\n\tif err := job.WriteJDIStatus(root, jobName, job.JDIRunning, \"analyst\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tvar stderr bytes.Buffer\n\tnotifyCrashedRun(&stderr, root, job.Job{Name: jobName, Root: root})\n\n\tif len(*got) != 0 {\n\t\tt.Errorf(\"received %d requests, want 0 (a live run is not a crash)\", len(*got))\n\t}\n\tif stderr.Len() != 0 {\n\t\tt.Errorf(\"stderr = %q, want empty\", stderr.String())\n\t}\n}\n\nfunc TestNotifyCrashedRunStoppedStatusDoesNotNotify(t *testing.T) {\n\tprofileCheckout(t, \"\")\n\tsrv, got := newNotifyCapture(t, http.StatusOK)\n\tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n\troot := t.TempDir()\n\tconst jobName = \"aaaa01_test-job\"\n\tif err := job.WriteJDIStatus(root, jobName, job.JDIStoppedFinished, \"reviewer\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tvar stderr bytes.Buffer\n\tnotifyCrashedRun(&stderr, root, job.Job{Name: jobName, Root: root})\n\n\tif len(*got) != 0 {\n\t\tt.Errorf(\"received %d requests, want 0 (a stopped run is not a crash)\", len(*got))\n\t}\n}\n\nfunc TestNotifyCrashedRunUnconfiguredLeavesSidecarUntouched(t *testing.T) {\n\tprofileCheckout(t, \"\")\n\tsrv, got := newNotifyCapture(t, http.StatusOK)\n\tconfigureNtfy(t, srv.URL, \"\", \"\") // no NTFY_TOPIC → feature off\n\troot := t.TempDir()\n\tconst jobName = \"aaaa01_test-job\"\n\twriteStaleRunningSidecar(t, root, jobName)\n\n\tvar stderr bytes.Buffer\n\tnotifyCrashedRun(&stderr, root, job.Job{Name: jobName, Root: root})\n\n\tif len(*got) != 0 {\n\t\tt.Errorf(\"received %d requests, want 0 (unconfigured must be a strict no-op)\", len(*got))\n\t}\n\t// Unconfigured behavior must be byte-for-byte identical: the stale sidecar\n\t// is left exactly as it was (ReadJDIStatus still degrades it away).\n\tif _, ok := job.StaleRunningJDI(root, jobName); !ok {\n\t\tt.Error(\"sidecar was modified despite ntfy being unconfigured — unconfigured behavior must be unchanged\")\n\t}\n}\n\n// pruneTestJob builds a real worktree job (the mg job flow) for the\n// commandAgentRunner prune-wiring tests — initTestRepo's job branch has no\n// registered worktree, but commandAgentRunner.Run resolves its --job through\n// the worktree path (ResolveRootFrom → WorktreeForBranch), so a real\n// worktree job is required.\nfunc pruneTestJob(t *testing.T) (dir string, j job.Job) {\n\tt.Helper()\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\tdir = mgCheckout(t)\n\tt.Chdir(dir)\n\tprofileCheckout(t, \"MANIGOT_PROFILE=zai\\nZHIPU_API_KEY=k\\n\")\n\n\tvar out, errOut strings.Builder\n\tif code := runJob([]string{\"Prune Job\"}, &out, &errOut); code != 0 {\n\t\tt.Fatalf(\"runJob: %d %s\", code, errOut.String())\n\t}\n\tbranch := mgJobBranch(t, dir)\n\tjobName := strings.TrimPrefix(branch, \"feature/\")\n\twt := mgWorktreePath(t, dir, branch)\n\tj = job.Job{\n\t\tName:   jobName,\n\t\tDir:    filepath.Join(wt, \"docs\", \"jobs\", jobName),\n\t\tRoot:   wt,\n\t\tID:     strings.Split(jobName, \"_\")[0],\n\t\tBranch: branch,\n\t}\n\treturn dir, j\n}\n\n// TestCommandAgentRunnerPrunesBeforeRun pins the mg-jdi launch-path wiring:\n// commandAgentRunner.Run calls pruneOrphans (stubbed — docker is not on the\n// test PATH) before its docker invocation, which then fails on the git-only\n// PATH — proving the prune ran and did not replace the launch.\nfunc TestCommandAgentRunnerPrunesBeforeRun(t *testing.T) {\n\tdir, j := pruneTestJob(t)\n\n\tvar pruneCalls int\n\told := pruneOrphans\n\tpruneOrphans = func(diag io.Writer) (session.PruneResult, error) {\n\t\tpruneCalls++\n\t\treturn session.PruneResult{Removed: 2, Running: 0}, nil\n\t}\n\tt.Cleanup(func() { pruneOrphans = old })\n\n\tr := &commandAgentRunner{projectRoot: dir, profile: \"zai\"}\n\t_, err := r.Run(\"analyst\", j)\n\tif err == nil {\n\t\tt.Fatal(\"Run = nil error, want the docker-launch failure (docker is not on the test PATH)\")\n\t}\n\tif pruneCalls != 1 {\n\t\tt.Errorf(\"pruneOrphans called %d times, want 1\", pruneCalls)\n\t}\n\tif !strings.Contains(err.Error(), \"executable file not found\") {\n\t\tt.Errorf(\"the invocation must have proceeded to the docker launch:\\n%v\", err)\n\t}\n}\n\n// TestCommandAgentRunnerPruneFailureDoesNotAbort: a prune failure only warns\n// (into the diag buffer, which surfaces in the invocation error) and never\n// aborts the invocation — the docker launch is still attempted.\nfunc TestCommandAgentRunnerPruneFailureDoesNotAbort(t *testing.T) {\n\tdir, j := pruneTestJob(t)\n\n\told := pruneOrphans\n\tpruneOrphans = func(diag io.Writer) (session.PruneResult, error) {\n\t\treturn session.PruneResult{}, errors.New(\"Cannot connect to the Docker daemon\")\n\t}\n\tt.Cleanup(func() { pruneOrphans = old })\n\n\tr := &commandAgentRunner{projectRoot: dir, profile: \"zai\"}\n\t_, err := r.Run(\"analyst\", j)\n\tif err == nil {\n\t\tt.Fatal(\"Run = nil error, want the docker-launch failure (docker is not on the test PATH)\")\n\t}\n\tif !strings.Contains(err.Error(), \"could not prune orphaned containers\") {\n\t\tt.Errorf(\"missing the prune warning in the invocation error:\\n%v\", err)\n\t}\n\tif !strings.Contains(err.Error(), \"executable file not found\") {\n\t\tt.Errorf(\"the invocation must proceed past a prune failure (docker attempted):\\n%v\", err)\n\t}\n}\n\n// TestRunWritesSessionLogPerInvocation pins TASK-1's session.log persistence\n// at the loop level: Run appends one section per invocation — header\n// (agent + attempt + timestamp) followed by the raw captured output — to\n// docs/jobs/<id>_<slug>/session.log, for every invocation in order. REQUIRED\n// (TASK-5): the git-level assertion that the worktree is clean after Run —\n// the final section must have been committed by the loop-exit sweep, or mg\n// done's clean-tree check would refuse a just-finished run. The job runs in\n// a REAL linked worktree (initLinkedWorktreeRepo), the production shape, so\n// the sweep actually commits the final section into the job's own worktree\n// and the clean-tree assertion exercises it meaningfully.\nfunc TestRunWritesSessionLogPerInvocation(t *testing.T) {\n\troot, wt, j := initLinkedWorktreeRepo(t)\n\tr := &fakeRunner{t: t, root: wt, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"analyst\":\n\t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n\t\tcase \"reviewer\":\n\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n\t\t}\n\t\treturn []byte(\"raw \" + agent + \" output\\n\")\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopFinished {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n\t}\n\n\tdata, err := os.ReadFile(filepath.Join(j.Dir, \"session.log\"))\n\tif err != nil {\n\t\tt.Fatalf(\"reading session.log: %v\", err)\n\t}\n\tout := string(data)\n\t// Exactly one section per invocation, headers and raw content in order.\n\tassertLogOrder(t, out, []string{\n\t\t\"analyst (attempt 1)\",\n\t\t\"raw analyst output\",\n\t\t\"developer (attempt 1)\",\n\t\t\"raw developer output\",\n\t\t\"reviewer (attempt 1)\",\n\t\t\"raw reviewer output\",\n\t})\n\tif n := sectionHeaderCount(out); n != 3 {\n\t\tt.Errorf(\"session.log has %d section headers, want 3 (one per invocation)\", n)\n\t}\n\n\t// REQUIRED: the loop-exit sweep must have committed the final session.log\n\t// section in the job's linked worktree, so `git status --porcelain` is\n\t// empty there — mg done's clean-tree check (git.WorkingTreeDirty) can\n\t// never refuse a just-finished run.\n\tif status := mgGit(t, wt, \"status\", \"--porcelain\"); status != \"\" {\n\t\tt.Errorf(\"job worktree not clean after Run (final session.log section must be committed by the loop-exit sweep):\\n%s\", status)\n\t}\n}\n\n// TestRunDoesNotSweepMainWorktree pins the loop-exit sweep's main-worktree\n// gate: for a pre-worktree job (the job branch checked out in the MAIN\n// worktree itself — initTestRepo's shape, an explicitly supported state) the\n// sweep must be skipped entirely. Without the gate, git.CommitAll on the\n// main worktree would stage and commit the user's own uncommitted work — an\n// unexcluded .env included — as [<id>] chore: commit all on the job branch:\n// precisely the hazard session.SweepJobWorktree's\n// ProjectRoot == InvocationRoot gate exists for. The test plants an\n// untracked .env in the main worktree and runs a marker-stop loop (a single\n// invocation whose output the fake runner never commits, so the ONLY thing\n// that could commit the .env is the loop-exit sweep), then asserts the .env\n// is still untracked with its content untouched and that no sweep commit\n// landed on the branch. (The final session.log section staying uncommitted\n// here is the accepted trade-off — the host never sweeps the main worktree,\n// by design.)\nfunc TestRunDoesNotSweepMainWorktree(t *testing.T) {\n\troot, j := initTestRepo(t)\n\n\t// The user's own uncommitted work in the main worktree — the exact file\n\t// the gate exists to keep off the job branch.\n\tconst envContent = \"CLAUDE_CODE_OAUTH_TOKEN=secret-token\\n\"\n\tif err := os.WriteFile(filepath.Join(root, \".env\"), []byte(envContent), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\treturn []byte(\"NEEDS-HUMAN-INPUT: which auth provider should this use?\\n\")\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman (reason: %s)\", got.Kind, got.Reason)\n\t}\n\tif len(r.calls) != 1 {\n\t\tt.Fatalf(\"calls = %v, want exactly one invocation (marker stop)\", r.calls)\n\t}\n\n\t// The .env must still be untracked — the fake runner never runs\n\t// `git add -A`, so the only thing that could have committed it is the\n\t// loop-exit sweep, and the gate must have skipped it.\n\tstatus := mgGit(t, root, \"status\", \"--porcelain\")\n\tif !strings.Contains(status, \"?? .env\") {\n\t\tt.Errorf(\"main worktree status does not show .env as untracked, want it left untouched (the loop-exit sweep must skip the main worktree):\\n%s\", status)\n\t}\n\tfor _, line := range strings.Split(mgGit(t, root, \"log\", \"--oneline\"), \"\\n\") {\n\t\tif strings.Contains(line, \"chore: commit all\") {\n\t\t\tt.Errorf(\"branch log contains a sweep commit the main-worktree gate should have prevented: %s\", line)\n\t\t}\n\t}\n\tdata, err := os.ReadFile(filepath.Join(root, \".env\"))\n\tif err != nil {\n\t\tt.Fatalf(\"reading .env: %v\", err)\n\t}\n\tif string(data) != envContent {\n\t\tt.Errorf(\".env content changed: %q, want %q\", data, envContent)\n\t}\n}\n\n// TestRunStopsOnNeedsHumanMarkerInClaudeStreamJSON proves the marker\n// detection holds at the loop level against the real\n// `claude --print --verbose --output-format stream-json` shape — a JSONL\n// stream of system/assistant/user/result events whose response prose lives\n// in assistant events' message.content text blocks (see\n// orchestrate.realClaudeStreamJSONL, captured live against claude 2.1.247) —\n// not just against the plain-text / Claude-JSON / opencode-JSONL shapes the\n// other marker tests use. It also pins the run.log contract for a\n// stream-json-driven run: the log shows the extracted prose (ResultText),\n// never the raw JSONL, while session.log holds the raw stream — and the\n// loop-exit sweep leaves the job's linked worktree clean (the marker stop is\n// the first invocation, so ONLY the loop-exit sweep can have committed the\n// section — the per-invocation sweep in commandAgentRunner.Run never runs\n// for the fake runner).\nfunc TestRunStopsOnNeedsHumanMarkerInClaudeStreamJSON(t *testing.T) {\n\troot, wt, j := initLinkedWorktreeRepo(t)\n\n\t// A minimal but real stream-json output with the marker inside an\n\t// assistant text event's message.content and the result event's result\n\t// field (as a real marker response would carry it).\n\tconst streamShape = `{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"ses_test\"}\n{\"type\":\"assistant\",\"message\":{\"id\":\"msg_01\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Looked at tasks.md.\\nNEEDS-HUMAN-INPUT: which auth provider should this use?\"}]}}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_01\",\"content\":\"TASK-1: do the thing\"}]}}\n{\"type\":\"assistant\",\"message\":{\"id\":\"msg_02\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Asking the human.\"}]}}\n{\"type\":\"result\",\"subtype\":\"success\",\"result\":\"Looked at tasks.md.\\nNEEDS-HUMAN-INPUT: which auth provider should this use?\"}\n`\n\n\tr := &fakeRunner{t: t, root: wt, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\treturn []byte(streamShape)\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n\t}\n\tif !strings.Contains(got.Reason, \"which auth provider should this use?\") {\n\t\tt.Errorf(\"Reason = %q, want it to contain the marker's reason text\", got.Reason)\n\t}\n\tif len(r.calls) != 1 {\n\t\tt.Errorf(\"calls = %v, want exactly one invocation (stopped immediately)\", r.calls)\n\t}\n\tout := log.String()\n\tif strings.Contains(out, `\"type\":\"assistant\"`) || strings.Contains(out, `\"type\":\"result\"`) {\n\t\tt.Errorf(\"run.log contains raw JSONL, want the extracted prose (ResultText):\\n%s\", out)\n\t}","lineStart":1,"lineEnd":1271,"totalLines":1272,"truncated":true}},"title":"src/cmd/mg/jdi_test.go","time":{"start":1787920066074,"end":1787920066082}},"id":"prt_048572612001iyARPEFdR4UmGk","sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","messageID":"msg_048571c7f001ARuZsDar8NxQTc"}}
