{"type":"tool_use","timestamp":1787920331114,"sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","part":{"type":"tool","tool":"read","callID":"call_30cc9de0d12f4c249f971488","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/session/docker_test.go","offset":1175},"output":"<path>/workspace/src/internal/session/docker_test.go</path>\n<type>file</type>\n<content>\n1175: \t\tt.Errorf(\"missing shadowing diagnostics:\\n%s\", diag.String())\n1176: \t}\n1177: }\n1178: \n1179: func TestPickQuoteFromJSON(t *testing.T) {\n1180: \thome := t.TempDir()\n1181: \tif err := os.MkdirAll(filepath.Join(home, \"scripts\"), 0o755); err != nil {\n1182: \t\tt.Fatal(err)\n1183: \t}\n1184: \tif err := os.WriteFile(filepath.Join(home, \"scripts\", \"entrypoint.sh\"), []byte(\"#!/bin/sh\\n\"), 0o755); err != nil {\n1185: \t\tt.Fatal(err)\n1186: \t}\n1187: \tif err := os.MkdirAll(filepath.Join(home, \"assets\"), 0o755); err != nil {\n1188: \t\tt.Fatal(err)\n1189: \t}\n1190: \tif err := os.WriteFile(filepath.Join(home, \"assets\", \"quotes.json\"), []byte(\"[\\\"first\\\", \\\"second\\\", \\\"third\\\"]\\n\"), 0o644); err != nil {\n1191: \t\tt.Fatal(err)\n1192: \t}\n1193: \tt.Setenv(\"MANIGOT_HOME\", home)\n1194: \tq := pickQuote()\n1195: \tif q != \"first\" && q != \"second\" && q != \"third\" {\n1196: \t\tt.Errorf(\"pickQuote = %q, want one of the file's quotes\", q)\n1197: \t}\n1198: }\n1199: \n1200: func TestPickQuoteMissingFile(t *testing.T) {\n1201: \thome := t.TempDir()\n1202: \tif err := os.MkdirAll(filepath.Join(home, \"scripts\"), 0o755); err != nil {\n1203: \t\tt.Fatal(err)\n1204: \t}\n1205: \tif err := os.WriteFile(filepath.Join(home, \"scripts\", \"entrypoint.sh\"), []byte(\"#!/bin/sh\\n\"), 0o755); err != nil {\n1206: \t\tt.Fatal(err)\n1207: \t}\n1208: \tt.Setenv(\"MANIGOT_HOME\", home)\n1209: \tif q := pickQuote(); q != \"\" {\n1210: \t\tt.Errorf(\"pickQuote on missing file = %q, want empty\", q)\n1211: \t}\n1212: }\n1213: \n1214: func TestBuildOpenCodeModelForwardedAsIsLegacy(t *testing.T) {\n1215: \troot := projectCheckout(t, t.TempDir(), true)\n1216: \tt.Chdir(root)\n1217: \tcheckout(t, \"OPENAI_API_KEY=sk-oa\\nOPENCODE_MODEL=custom/model\\n\")\n1218: \tinfo, err := ResolveProfile(Options{Tool: \"opencode\"})\n1219: \tif err != nil {\n1220: \t\tt.Fatalf(\"ResolveProfile: %v\", err)\n1221: \t}\n1222: \tif err := info.CheckAuth(); err != nil {\n1223: \t\tt.Fatalf(\"CheckAuth: %v\", err)\n1224: \t}\n1225: \tr, err := ResolveRoot(Options{})\n1226: \tif err != nil {\n1227: \t\tt.Fatalf(\"ResolveRoot: %v\", err)\n1228: \t}\n1229: \tinv, err := BuildDockerInvocation(Options{}, info, r, false, &strings.Builder{})\n1230: \tif err != nil {\n1231: \t\tt.Fatalf(\"BuildDockerInvocation: %v\", err)\n1232: \t}\n1233: \tcontainsAll(t, inv.Argv, \"-e\", \"OPENCODE_MODEL=custom/model\", \"-e\", \"MANIGOT_TOOL=opencode\")\n1234: }\n1235: \n1236: // TestBuildTerminalEnvForwarding — the host's terminal-identity vars are\n1237: // forwarded into the container so the in-container TUIs see the real terminal\n1238: // (OSC 52 clipboard emission is gated on them). Forwarding is strictly\n1239: // conditional: only vars set to a non-empty value on the host are forwarded,\n1240: // so a build with none of them set stays byte-identical to one built without\n1241: // the feature.\n1242: func TestBuildTerminalEnvForwarding(t *testing.T) {\n1243: \t_, _ = docProject(t)\n1244: \tinfo, err := ResolveProfile(Options{})\n1245: \tif err != nil {\n1246: \t\tt.Fatalf(\"ResolveProfile: %v\", err)\n1247: \t}\n1248: \tif err := info.CheckAuth(); err != nil {\n1249: \t\tt.Fatalf(\"CheckAuth: %v\", err)\n1250: \t}\n1251: \tr, err := ResolveRoot(Options{})\n1252: \tif err != nil {\n1253: \t\tt.Fatalf(\"ResolveRoot: %v\", err)\n1254: \t}\n1255: \n1256: \t// Nothing set (or empty): no terminal env is forwarded at all — the argv\n1257: \t// is exactly what it would be without the feature.\n1258: \tfor _, k := range append(append([]string{}, terminalEnvVars...), \"WEZTERM_PANE\", \"WEZTERM_UNIX_SOCKET\") {\n1259: \t\tt.Setenv(k, \"\")\n1260: \t}\n1261: \tinv, err := BuildDockerInvocation(Options{}, info, r, false, &strings.Builder{})\n1262: \tif err != nil {\n1263: \t\tt.Fatalf(\"BuildDockerInvocation: %v\", err)\n1264: \t}\n1265: \tjoined := strings.Join(inv.Argv, \"\\n\")\n1266: \tfor _, k := range terminalEnvVars {\n1267: \t\tif strings.Contains(joined, \"-e\\n\"+k+\"=\") {\n1268: \t\t\tt.Errorf(\"unset %s must not be forwarded:\\n%s\", k, joined)\n1269: \t\t}\n1270: \t}\n1271: \tfor _, k := range []string{\"WEZTERM_PANE\", \"WEZTERM_UNIX_SOCKET\"} {\n1272: \t\tif strings.Contains(joined, \"-e\\n\"+k+\"=\") {\n1273: \t\t\tt.Errorf(\"unset %s must not be forwarded:\\n%s\", k, joined)\n1274: \t\t}\n1275: \t}\n1276: \n1277: \t// All set: each var is forwarded with its value, WEZTERM_* included.\n1278: \tt.Setenv(\"TERM\", \"xterm-256color\")\n1279: \tt.Setenv(\"COLORTERM\", \"truecolor\")\n1280: \tt.Setenv(\"TERM_PROGRAM\", \"WezTerm\")\n1281: \tt.Setenv(\"TERM_PROGRAM_VERSION\", \"20240203\")\n1282: \tt.Setenv(\"VTE_VERSION\", \"6800\")\n1283: \tt.Setenv(\"KITTY_WINDOW_ID\", \"42\")\n1284: \tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,1234,0\")\n1285: \tt.Setenv(\"TMUX_PANE\", \"%5\")\n1286: \tt.Setenv(\"WT_SESSION\", \"abc123\")\n1287: \tt.Setenv(\"WEZTERM_PANE\", \"%1\")\n1288: \tt.Setenv(\"WEZTERM_UNIX_SOCKET\", \"/tmp/wezterm.sock\")\n1289: \tinv, err = BuildDockerInvocation(Options{}, info, r, false, &strings.Builder{})\n1290: \tif err != nil {\n1291: \t\tt.Fatalf(\"BuildDockerInvocation: %v\", err)\n1292: \t}\n1293: \tcontainsAll(t, inv.Argv,\n1294: \t\t\"-e\", \"TERM=xterm-256color\",\n1295: \t\t\"-e\", \"COLORTERM=truecolor\",\n1296: \t\t\"-e\", \"TERM_PROGRAM=WezTerm\",\n1297: \t\t\"-e\", \"TERM_PROGRAM_VERSION=20240203\",\n1298: \t\t\"-e\", \"VTE_VERSION=6800\",\n1299: \t\t\"-e\", \"KITTY_WINDOW_ID=42\",\n1300: \t\t\"-e\", \"TMUX=/tmp/tmux-1000/default,1234,0\",\n1301: \t\t\"-e\", \"TMUX_PANE=%5\",\n1302: \t\t\"-e\", \"WT_SESSION=abc123\",\n1303: \t\t\"-e\", \"WEZTERM_PANE=%1\",\n1304: \t\t\"-e\", \"WEZTERM_UNIX_SOCKET=/tmp/wezterm.sock\",\n1305: \t)\n1306: }\n1307: \n1308: // TestBuildTerminalEnvForwardingOpenCodeStripsTmux — OpenCode sessions must\n1309: // NOT see TMUX/TMUX_PANE inside the container: when OpenCode sees TMUX set it\n1310: // wraps its OSC 52 clipboard write in tmux's DCS-passthrough escape, which\n1311: // default tmux configuration (allow-passthrough off) discards entirely — so\n1312: // the host clipboard is never touched even with set-clipboard on. Stripping\n1313: // TMUX makes OpenCode emit plain OSC 52, which tmux's set-clipboard on\n1314: // handles. Every other terminal-identity var (TERM/COLORTERM/... plus\n1315: // WEZTERM_*) is still forwarded, so the TUI still sees the real terminal.\n1316: func TestBuildTerminalEnvForwardingOpenCodeStripsTmux(t *testing.T) {\n1317: \t_, _ = docProject(t)\n1318: \tcheckout(t, \"MANIGOT_PROFILE=zai\\nZHIPU_API_KEY=z-secret\\n\")\n1319: \tinfo, err := ResolveProfile(Options{})\n1320: \tif err != nil {\n1321: \t\tt.Fatalf(\"ResolveProfile: %v\", err)\n1322: \t}\n1323: \tif info.Tool != config.ToolOpenCode {\n1324: \t\tt.Fatalf(\"zai profile tool = %q, want %q\", info.Tool, config.ToolOpenCode)\n1325: \t}\n1326: \tif err := info.CheckAuth(); err != nil {\n1327: \t\tt.Fatalf(\"CheckAuth: %v\", err)\n1328: \t}\n1329: \tr, err := ResolveRoot(Options{})\n1330: \tif err != nil {\n1331: \t\tt.Fatalf(\"ResolveRoot: %v\", err)\n1332: \t}\n1333: \n1334: \tt.Setenv(\"TERM\", \"xterm-256color\")\n1335: \tt.Setenv(\"COLORTERM\", \"truecolor\")\n1336: \tt.Setenv(\"TERM_PROGRAM\", \"WezTerm\")\n1337: \tt.Setenv(\"TERM_PROGRAM_VERSION\", \"20240203\")\n1338: \tt.Setenv(\"VTE_VERSION\", \"6800\")\n1339: \tt.Setenv(\"KITTY_WINDOW_ID\", \"42\")\n1340: \tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,1234,0\")\n1341: \tt.Setenv(\"TMUX_PANE\", \"%5\")\n1342: \tt.Setenv(\"WT_SESSION\", \"abc123\")\n1343: \tt.Setenv(\"WEZTERM_PANE\", \"%1\")\n1344: \tt.Setenv(\"WEZTERM_UNIX_SOCKET\", \"/tmp/wezterm.sock\")\n1345: \n1346: \tinv, err := BuildDockerInvocation(Options{}, info, r, false, &strings.Builder{})\n1347: \tif err != nil {\n1348: \t\tt.Fatalf(\"BuildDockerInvocation: %v\", err)\n1349: \t}\n1350: \t// The non-tmux identity vars are still forwarded.\n1351: \tcontainsAll(t, inv.Argv,\n1352: \t\t\"-e\", \"TERM=xterm-256color\",\n1353: \t\t\"-e\", \"COLORTERM=truecolor\",\n1354: \t\t\"-e\", \"TERM_PROGRAM=WezTerm\",\n1355: \t\t\"-e\", \"TERM_PROGRAM_VERSION=20240203\",\n1356: \t\t\"-e\", \"VTE_VERSION=6800\",\n1357: \t\t\"-e\", \"KITTY_WINDOW_ID=42\",\n1358: \t\t\"-e\", \"WT_SESSION=abc123\",\n1359: \t\t\"-e\", \"WEZTERM_PANE=%1\",\n1360: \t\t\"-e\", \"WEZTERM_UNIX_SOCKET=/tmp/wezterm.sock\",\n1361: \t)\n1362: \t// TMUX/TMUX_PANE are deliberately stripped for OpenCode.\n1363: \tjoined := strings.Join(inv.Argv, \"\\n\")\n1364: \tfor _, k := range []string{\"TMUX=\", \"TMUX_PANE=\"} {\n1365: \t\tif strings.Contains(joined, \"-e\\n\"+k) {\n1366: \t\t\tt.Errorf(\"opencode docker argv must not forward %s:\\n%s\", k, joined)\n1367: \t\t}\n1368: \t}\n1369: }\n1370: \n1371: // fakeTmux puts an executable `tmux` first on PATH that prints output (or,\n1372: // with fail=true, exits non-zero) — a stand-in for the host's real tmux so\n1373: // the clipboard-interception check can be exercised without one installed.\n1374: func fakeTmux(t *testing.T, output string, fail bool) {\n1375: \tt.Helper()\n1376: \tdir := t.TempDir()\n1377: \tscript := \"#!/bin/sh\\n\"\n1378: \tif fail {\n1379: \t\tscript += \"echo 'no server running on /tmp/tmux-1000/default' >&2\\n\"\n1380: \t\tscript += \"exit 1\\n\"\n1381: \t} else {\n1382: \t\tscript += \"echo '\" + output + \"'\\n\"\n1383: \t}\n1384: \tif err := os.WriteFile(filepath.Join(dir, \"tmux\"), []byte(script), 0o755); err != nil {\n1385: \t\tt.Fatal(err)\n1386: \t}\n1387: \tt.Setenv(\"PATH\", dir+string(os.PathListSeparator)+os.Getenv(\"PATH\"))\n1388: }\n1389: \n1390: // tmuxWarnDiag builds an interactive docker invocation with the ambient env\n1391: // (TMUX/print controlled by the caller) and returns the diagnostics output.\n1392: func tmuxWarnDiag(t *testing.T, opts Options, interactive bool) string {\n1393: \tt.Helper()\n1394: \t_, _ = docProject(t)\n1395: \tinfo, err := ResolveProfile(Options{})\n1396: \tif err != nil {\n1397: \t\tt.Fatalf(\"ResolveProfile: %v\", err)\n1398: \t}\n1399: \tif err := info.CheckAuth(); err != nil {\n1400: \t\tt.Fatalf(\"CheckAuth: %v\", err)\n1401: \t}\n1402: \tr, err := ResolveRoot(Options{})\n1403: \tif err != nil {\n1404: \t\tt.Fatalf(\"ResolveRoot: %v\", err)\n1405: \t}\n1406: \tvar diag strings.Builder\n1407: \tif _, err := BuildDockerInvocation(opts, info, r, interactive, &diag); err != nil {\n1408: \t\tt.Fatalf(\"BuildDockerInvocation: %v\", err)\n1409: \t}\n1410: \treturn diag.String()\n1411: }\n1412: \n1413: // TestWarnTmuxClipboardOff: inside tmux with set-clipboard off, an\n1414: // interactive session warns on stderr that OSC 52 clipboard writes will be\n1415: // swallowed — the diagnostics stream, so it can never corrupt --print stdout.\n1416: func TestWarnTmuxClipboardOff(t *testing.T) {\n1417: \tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,1234,0\")\n1418: \tfakeTmux(t, \"set-clipboard off\", false)\n1419: \tdiag := tmuxWarnDiag(t, Options{}, true)\n1420: \tif !strings.Contains(diag, \"set-clipboard off\") || !strings.Contains(diag, \"tmux set -g set-clipboard on\") {\n1421: \t\tt.Errorf(\"missing tmux set-clipboard warning:\\n%s\", diag)\n1422: \t}\n1423: }\n1424: \n1425: // TestWarnTmuxClipboardOn: set-clipboard on forwards OSC 52 — no warning.\n1426: func TestWarnTmuxClipboardOn(t *testing.T) {\n1427: \tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,1234,0\")\n1428: \tfakeTmux(t, \"set-clipboard on\", false)\n1429: \tif diag := tmuxWarnDiag(t, Options{}, true); strings.Contains(diag, \"set-clipboard off\") {\n1430: \t\tt.Errorf(\"set-clipboard on must not warn:\\n%s\", diag)\n1431: \t}\n1432: }\n1433: \n1434: // TestWarnTmuxClipboardExternal: set-clipboard external (tmux >= 3.2) also\n1435: // forwards OSC 52 to the outer terminal — no warning.\n1436: func TestWarnTmuxClipboardExternal(t *testing.T) {\n1437: \tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,1234,0\")\n1438: \tfakeTmux(t, \"set-clipboard external\", false)\n1439: \tif diag := tmuxWarnDiag(t, Options{}, true); strings.Contains(diag, \"set-clipboard off\") {\n1440: \t\tt.Errorf(\"set-clipboard external must not warn:\\n%s\", diag)\n1441: \t}\n1442: }\n1443: \n1444: // TestWarnTmuxClipboardNoTmuxBinary: tmux not on PATH silently skips the\n1445: // check — no warning, no error.\n1446: func TestWarnTmuxClipboardNoTmuxBinary(t *testing.T) {\n1447: \tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,1234,0\")\n1448: \tt.Setenv(\"PATH\", \"/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\")\n1449: \tif diag := tmuxWarnDiag(t, Options{}, true); strings.Contains(diag, \"set-clipboard\") {\n1450: \t\tt.Errorf(\"missing tmux binary must not warn:\\n%s\", diag)\n1451: \t}\n1452: }\n1453: \n1454: // TestWarnTmuxClipboardOutsideTmux: no $TMUX, even with tmux on PATH — no\n1455: // warning (the user is not inside tmux, nothing to intercept).\n1456: func TestWarnTmuxClipboardOutsideTmux(t *testing.T) {\n1457: \tt.Setenv(\"TMUX\", \"\")\n1458: \tfakeTmux(t, \"set-clipboard off\", false)\n1459: \tif diag := tmuxWarnDiag(t, Options{}, true); strings.Contains(diag, \"set-clipboard off\") {\n1460: \t\tt.Errorf(\"outside tmux must not warn:\\n%s\", diag)\n1461: \t}\n1462: }\n1463: \n1464: // TestWarnTmuxClipboardPrintMode: --print runs are non-interactive — the\n1465: // check is skipped even inside tmux with set-clipboard off.\n1466: func TestWarnTmuxClipboardPrintMode(t *testing.T) {\n1467: \tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,1234,0\")\n1468: \tfakeTmux(t, \"set-clipboard off\", false)\n1469: \tif diag := tmuxWarnDiag(t, Options{Print: true}, true); strings.Contains(diag, \"set-clipboard off\") {\n1470: \t\tt.Errorf(\"print mode must not warn:\\n%s\", diag)\n1471: \t}\n1472: }\n1473: \n1474: // TestWarnTmuxClipboardTmuxFailure: a failing tmux query (no server, option\n1475: // unknown) silently skips the check — no launch path can break because of it.\n1476: func TestWarnTmuxClipboardTmuxFailure(t *testing.T) {\n1477: \tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,1234,0\")\n1478: \tfakeTmux(t, \"\", true)\n1479: \tif diag := tmuxWarnDiag(t, Options{}, true); strings.Contains(diag, \"set-clipboard\") {\n1480: \t\tt.Errorf(\"failing tmux query must not warn:\\n%s\", diag)\n1481: \t}\n1482: }\n\n(End of file - total 1482 lines)\n</content>","metadata":{"preview":"\t\tt.Errorf(\"missing shadowing diagnostics:\\n%s\", diag.String())\n\t}\n}\n\nfunc TestPickQuoteFromJSON(t *testing.T) {\n\thome := t.TempDir()\n\tif err := os.MkdirAll(filepath.Join(home, \"scripts\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(home, \"scripts\", \"entrypoint.sh\"), []byte(\"#!/bin/sh\\n\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.MkdirAll(filepath.Join(home, \"assets\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(home, \"assets\", \"quotes.json\"), []byte(\"[\\\"first\\\", \\\"second\\\", \\\"third\\\"]\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Setenv(\"MANIGOT_HOME\", home)\n\tq := pickQuote()","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/session/docker_test.go","text":"\t\tt.Errorf(\"missing shadowing diagnostics:\\n%s\", diag.String())\n\t}\n}\n\nfunc TestPickQuoteFromJSON(t *testing.T) {\n\thome := t.TempDir()\n\tif err := os.MkdirAll(filepath.Join(home, \"scripts\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(home, \"scripts\", \"entrypoint.sh\"), []byte(\"#!/bin/sh\\n\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.MkdirAll(filepath.Join(home, \"assets\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(home, \"assets\", \"quotes.json\"), []byte(\"[\\\"first\\\", \\\"second\\\", \\\"third\\\"]\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Setenv(\"MANIGOT_HOME\", home)\n\tq := pickQuote()\n\tif q != \"first\" && q != \"second\" && q != \"third\" {\n\t\tt.Errorf(\"pickQuote = %q, want one of the file's quotes\", q)\n\t}\n}\n\nfunc TestPickQuoteMissingFile(t *testing.T) {\n\thome := t.TempDir()\n\tif err := os.MkdirAll(filepath.Join(home, \"scripts\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(home, \"scripts\", \"entrypoint.sh\"), []byte(\"#!/bin/sh\\n\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Setenv(\"MANIGOT_HOME\", home)\n\tif q := pickQuote(); q != \"\" {\n\t\tt.Errorf(\"pickQuote on missing file = %q, want empty\", q)\n\t}\n}\n\nfunc TestBuildOpenCodeModelForwardedAsIsLegacy(t *testing.T) {\n\troot := projectCheckout(t, t.TempDir(), true)\n\tt.Chdir(root)\n\tcheckout(t, \"OPENAI_API_KEY=sk-oa\\nOPENCODE_MODEL=custom/model\\n\")\n\tinfo, err := ResolveProfile(Options{Tool: \"opencode\"})\n\tif err != nil {\n\t\tt.Fatalf(\"ResolveProfile: %v\", err)\n\t}\n\tif err := info.CheckAuth(); err != nil {\n\t\tt.Fatalf(\"CheckAuth: %v\", err)\n\t}\n\tr, err := ResolveRoot(Options{})\n\tif err != nil {\n\t\tt.Fatalf(\"ResolveRoot: %v\", err)\n\t}\n\tinv, err := BuildDockerInvocation(Options{}, info, r, false, &strings.Builder{})\n\tif err != nil {\n\t\tt.Fatalf(\"BuildDockerInvocation: %v\", err)\n\t}\n\tcontainsAll(t, inv.Argv, \"-e\", \"OPENCODE_MODEL=custom/model\", \"-e\", \"MANIGOT_TOOL=opencode\")\n}\n\n// TestBuildTerminalEnvForwarding — the host's terminal-identity vars are\n// forwarded into the container so the in-container TUIs see the real terminal\n// (OSC 52 clipboard emission is gated on them). Forwarding is strictly\n// conditional: only vars set to a non-empty value on the host are forwarded,\n// so a build with none of them set stays byte-identical to one built without\n// the feature.\nfunc TestBuildTerminalEnvForwarding(t *testing.T) {\n\t_, _ = docProject(t)\n\tinfo, err := ResolveProfile(Options{})\n\tif err != nil {\n\t\tt.Fatalf(\"ResolveProfile: %v\", err)\n\t}\n\tif err := info.CheckAuth(); err != nil {\n\t\tt.Fatalf(\"CheckAuth: %v\", err)\n\t}\n\tr, err := ResolveRoot(Options{})\n\tif err != nil {\n\t\tt.Fatalf(\"ResolveRoot: %v\", err)\n\t}\n\n\t// Nothing set (or empty): no terminal env is forwarded at all — the argv\n\t// is exactly what it would be without the feature.\n\tfor _, k := range append(append([]string{}, terminalEnvVars...), \"WEZTERM_PANE\", \"WEZTERM_UNIX_SOCKET\") {\n\t\tt.Setenv(k, \"\")\n\t}\n\tinv, err := BuildDockerInvocation(Options{}, info, r, false, &strings.Builder{})\n\tif err != nil {\n\t\tt.Fatalf(\"BuildDockerInvocation: %v\", err)\n\t}\n\tjoined := strings.Join(inv.Argv, \"\\n\")\n\tfor _, k := range terminalEnvVars {\n\t\tif strings.Contains(joined, \"-e\\n\"+k+\"=\") {\n\t\t\tt.Errorf(\"unset %s must not be forwarded:\\n%s\", k, joined)\n\t\t}\n\t}\n\tfor _, k := range []string{\"WEZTERM_PANE\", \"WEZTERM_UNIX_SOCKET\"} {\n\t\tif strings.Contains(joined, \"-e\\n\"+k+\"=\") {\n\t\t\tt.Errorf(\"unset %s must not be forwarded:\\n%s\", k, joined)\n\t\t}\n\t}\n\n\t// All set: each var is forwarded with its value, WEZTERM_* included.\n\tt.Setenv(\"TERM\", \"xterm-256color\")\n\tt.Setenv(\"COLORTERM\", \"truecolor\")\n\tt.Setenv(\"TERM_PROGRAM\", \"WezTerm\")\n\tt.Setenv(\"TERM_PROGRAM_VERSION\", \"20240203\")\n\tt.Setenv(\"VTE_VERSION\", \"6800\")\n\tt.Setenv(\"KITTY_WINDOW_ID\", \"42\")\n\tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,1234,0\")\n\tt.Setenv(\"TMUX_PANE\", \"%5\")\n\tt.Setenv(\"WT_SESSION\", \"abc123\")\n\tt.Setenv(\"WEZTERM_PANE\", \"%1\")\n\tt.Setenv(\"WEZTERM_UNIX_SOCKET\", \"/tmp/wezterm.sock\")\n\tinv, err = BuildDockerInvocation(Options{}, info, r, false, &strings.Builder{})\n\tif err != nil {\n\t\tt.Fatalf(\"BuildDockerInvocation: %v\", err)\n\t}\n\tcontainsAll(t, inv.Argv,\n\t\t\"-e\", \"TERM=xterm-256color\",\n\t\t\"-e\", \"COLORTERM=truecolor\",\n\t\t\"-e\", \"TERM_PROGRAM=WezTerm\",\n\t\t\"-e\", \"TERM_PROGRAM_VERSION=20240203\",\n\t\t\"-e\", \"VTE_VERSION=6800\",\n\t\t\"-e\", \"KITTY_WINDOW_ID=42\",\n\t\t\"-e\", \"TMUX=/tmp/tmux-1000/default,1234,0\",\n\t\t\"-e\", \"TMUX_PANE=%5\",\n\t\t\"-e\", \"WT_SESSION=abc123\",\n\t\t\"-e\", \"WEZTERM_PANE=%1\",\n\t\t\"-e\", \"WEZTERM_UNIX_SOCKET=/tmp/wezterm.sock\",\n\t)\n}\n\n// TestBuildTerminalEnvForwardingOpenCodeStripsTmux — OpenCode sessions must\n// NOT see TMUX/TMUX_PANE inside the container: when OpenCode sees TMUX set it\n// wraps its OSC 52 clipboard write in tmux's DCS-passthrough escape, which\n// default tmux configuration (allow-passthrough off) discards entirely — so\n// the host clipboard is never touched even with set-clipboard on. Stripping\n// TMUX makes OpenCode emit plain OSC 52, which tmux's set-clipboard on\n// handles. Every other terminal-identity var (TERM/COLORTERM/... plus\n// WEZTERM_*) is still forwarded, so the TUI still sees the real terminal.\nfunc TestBuildTerminalEnvForwardingOpenCodeStripsTmux(t *testing.T) {\n\t_, _ = docProject(t)\n\tcheckout(t, \"MANIGOT_PROFILE=zai\\nZHIPU_API_KEY=z-secret\\n\")\n\tinfo, err := ResolveProfile(Options{})\n\tif err != nil {\n\t\tt.Fatalf(\"ResolveProfile: %v\", err)\n\t}\n\tif info.Tool != config.ToolOpenCode {\n\t\tt.Fatalf(\"zai profile tool = %q, want %q\", info.Tool, config.ToolOpenCode)\n\t}\n\tif err := info.CheckAuth(); err != nil {\n\t\tt.Fatalf(\"CheckAuth: %v\", err)\n\t}\n\tr, err := ResolveRoot(Options{})\n\tif err != nil {\n\t\tt.Fatalf(\"ResolveRoot: %v\", err)\n\t}\n\n\tt.Setenv(\"TERM\", \"xterm-256color\")\n\tt.Setenv(\"COLORTERM\", \"truecolor\")\n\tt.Setenv(\"TERM_PROGRAM\", \"WezTerm\")\n\tt.Setenv(\"TERM_PROGRAM_VERSION\", \"20240203\")\n\tt.Setenv(\"VTE_VERSION\", \"6800\")\n\tt.Setenv(\"KITTY_WINDOW_ID\", \"42\")\n\tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,1234,0\")\n\tt.Setenv(\"TMUX_PANE\", \"%5\")\n\tt.Setenv(\"WT_SESSION\", \"abc123\")\n\tt.Setenv(\"WEZTERM_PANE\", \"%1\")\n\tt.Setenv(\"WEZTERM_UNIX_SOCKET\", \"/tmp/wezterm.sock\")\n\n\tinv, err := BuildDockerInvocation(Options{}, info, r, false, &strings.Builder{})\n\tif err != nil {\n\t\tt.Fatalf(\"BuildDockerInvocation: %v\", err)\n\t}\n\t// The non-tmux identity vars are still forwarded.\n\tcontainsAll(t, inv.Argv,\n\t\t\"-e\", \"TERM=xterm-256color\",\n\t\t\"-e\", \"COLORTERM=truecolor\",\n\t\t\"-e\", \"TERM_PROGRAM=WezTerm\",\n\t\t\"-e\", \"TERM_PROGRAM_VERSION=20240203\",\n\t\t\"-e\", \"VTE_VERSION=6800\",\n\t\t\"-e\", \"KITTY_WINDOW_ID=42\",\n\t\t\"-e\", \"WT_SESSION=abc123\",\n\t\t\"-e\", \"WEZTERM_PANE=%1\",\n\t\t\"-e\", \"WEZTERM_UNIX_SOCKET=/tmp/wezterm.sock\",\n\t)\n\t// TMUX/TMUX_PANE are deliberately stripped for OpenCode.\n\tjoined := strings.Join(inv.Argv, \"\\n\")\n\tfor _, k := range []string{\"TMUX=\", \"TMUX_PANE=\"} {\n\t\tif strings.Contains(joined, \"-e\\n\"+k) {\n\t\t\tt.Errorf(\"opencode docker argv must not forward %s:\\n%s\", k, joined)\n\t\t}\n\t}\n}\n\n// fakeTmux puts an executable `tmux` first on PATH that prints output (or,\n// with fail=true, exits non-zero) — a stand-in for the host's real tmux so\n// the clipboard-interception check can be exercised without one installed.\nfunc fakeTmux(t *testing.T, output string, fail bool) {\n\tt.Helper()\n\tdir := t.TempDir()\n\tscript := \"#!/bin/sh\\n\"\n\tif fail {\n\t\tscript += \"echo 'no server running on /tmp/tmux-1000/default' >&2\\n\"\n\t\tscript += \"exit 1\\n\"\n\t} else {\n\t\tscript += \"echo '\" + output + \"'\\n\"\n\t}\n\tif err := os.WriteFile(filepath.Join(dir, \"tmux\"), []byte(script), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Setenv(\"PATH\", dir+string(os.PathListSeparator)+os.Getenv(\"PATH\"))\n}\n\n// tmuxWarnDiag builds an interactive docker invocation with the ambient env\n// (TMUX/print controlled by the caller) and returns the diagnostics output.\nfunc tmuxWarnDiag(t *testing.T, opts Options, interactive bool) string {\n\tt.Helper()\n\t_, _ = docProject(t)\n\tinfo, err := ResolveProfile(Options{})\n\tif err != nil {\n\t\tt.Fatalf(\"ResolveProfile: %v\", err)\n\t}\n\tif err := info.CheckAuth(); err != nil {\n\t\tt.Fatalf(\"CheckAuth: %v\", err)\n\t}\n\tr, err := ResolveRoot(Options{})\n\tif err != nil {\n\t\tt.Fatalf(\"ResolveRoot: %v\", err)\n\t}\n\tvar diag strings.Builder\n\tif _, err := BuildDockerInvocation(opts, info, r, interactive, &diag); err != nil {\n\t\tt.Fatalf(\"BuildDockerInvocation: %v\", err)\n\t}\n\treturn diag.String()\n}\n\n// TestWarnTmuxClipboardOff: inside tmux with set-clipboard off, an\n// interactive session warns on stderr that OSC 52 clipboard writes will be\n// swallowed — the diagnostics stream, so it can never corrupt --print stdout.\nfunc TestWarnTmuxClipboardOff(t *testing.T) {\n\tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,1234,0\")\n\tfakeTmux(t, \"set-clipboard off\", false)\n\tdiag := tmuxWarnDiag(t, Options{}, true)\n\tif !strings.Contains(diag, \"set-clipboard off\") || !strings.Contains(diag, \"tmux set -g set-clipboard on\") {\n\t\tt.Errorf(\"missing tmux set-clipboard warning:\\n%s\", diag)\n\t}\n}\n\n// TestWarnTmuxClipboardOn: set-clipboard on forwards OSC 52 — no warning.\nfunc TestWarnTmuxClipboardOn(t *testing.T) {\n\tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,1234,0\")\n\tfakeTmux(t, \"set-clipboard on\", false)\n\tif diag := tmuxWarnDiag(t, Options{}, true); strings.Contains(diag, \"set-clipboard off\") {\n\t\tt.Errorf(\"set-clipboard on must not warn:\\n%s\", diag)\n\t}\n}\n\n// TestWarnTmuxClipboardExternal: set-clipboard external (tmux >= 3.2) also\n// forwards OSC 52 to the outer terminal — no warning.\nfunc TestWarnTmuxClipboardExternal(t *testing.T) {\n\tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,1234,0\")\n\tfakeTmux(t, \"set-clipboard external\", false)\n\tif diag := tmuxWarnDiag(t, Options{}, true); strings.Contains(diag, \"set-clipboard off\") {\n\t\tt.Errorf(\"set-clipboard external must not warn:\\n%s\", diag)\n\t}\n}\n\n// TestWarnTmuxClipboardNoTmuxBinary: tmux not on PATH silently skips the\n// check — no warning, no error.\nfunc TestWarnTmuxClipboardNoTmuxBinary(t *testing.T) {\n\tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,1234,0\")\n\tt.Setenv(\"PATH\", \"/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\")\n\tif diag := tmuxWarnDiag(t, Options{}, true); strings.Contains(diag, \"set-clipboard\") {\n\t\tt.Errorf(\"missing tmux binary must not warn:\\n%s\", diag)\n\t}\n}\n\n// TestWarnTmuxClipboardOutsideTmux: no $TMUX, even with tmux on PATH — no\n// warning (the user is not inside tmux, nothing to intercept).\nfunc TestWarnTmuxClipboardOutsideTmux(t *testing.T) {\n\tt.Setenv(\"TMUX\", \"\")\n\tfakeTmux(t, \"set-clipboard off\", false)\n\tif diag := tmuxWarnDiag(t, Options{}, true); strings.Contains(diag, \"set-clipboard off\") {\n\t\tt.Errorf(\"outside tmux must not warn:\\n%s\", diag)\n\t}\n}\n\n// TestWarnTmuxClipboardPrintMode: --print runs are non-interactive — the\n// check is skipped even inside tmux with set-clipboard off.\nfunc TestWarnTmuxClipboardPrintMode(t *testing.T) {\n\tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,1234,0\")\n\tfakeTmux(t, \"set-clipboard off\", false)\n\tif diag := tmuxWarnDiag(t, Options{Print: true}, true); strings.Contains(diag, \"set-clipboard off\") {\n\t\tt.Errorf(\"print mode must not warn:\\n%s\", diag)\n\t}\n}\n\n// TestWarnTmuxClipboardTmuxFailure: a failing tmux query (no server, option\n// unknown) silently skips the check — no launch path can break because of it.\nfunc TestWarnTmuxClipboardTmuxFailure(t *testing.T) {\n\tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,1234,0\")\n\tfakeTmux(t, \"\", true)\n\tif diag := tmuxWarnDiag(t, Options{}, true); strings.Contains(diag, \"set-clipboard\") {\n\t\tt.Errorf(\"failing tmux query must not warn:\\n%s\", diag)\n\t}\n}","lineStart":1175,"lineEnd":1482,"totalLines":1482,"truncated":false}},"title":