{"type":"tool_use","timestamp":1787920070663,"sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","part":{"type":"tool","tool":"read","callID":"call_00_ET_RVoiHsFF5oKRZQ0tfIol1057","state":{"status":"completed","input":{"filePath":"/workspace/src/cmd/mg/jdioutput_test.go"},"output":"<path>/workspace/src/cmd/mg/jdioutput_test.go</path>\n<type>file</type>\n<content>\n1: package main\n2: \n3: import (\n4: \t\"bytes\"\n5: \t\"os\"\n6: \t\"os/exec\"\n7: \t\"path/filepath\"\n8: \t\"strings\"\n9: \t\"testing\"\n10: \t\"time\"\n11: \n12: \t\"github.com/lmuskalla/manigot/internal/job\"\n13: \t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n14: )\n15: \n16: func TestLogStarted(t *testing.T) {\n17: \tvar buf bytes.Buffer\n18: \tlogStarted(&buf, \"aaaa01_test-job\", \"claude-pro\")\n19: \tgot := buf.String()\n20: \tif !strings.Contains(got, \"mg jdi started\") {\n21: \t\tt.Errorf(\"logStarted output missing 'mg jdi started', got:\\n%s\", got)\n22: \t}\n23: \tif !strings.Contains(got, \"aaaa01_test-job\") {\n24: \t\tt.Errorf(\"logStarted output missing job name, got:\\n%s\", got)\n25: \t}\n26: \tif !strings.Contains(got, \"claude-pro\") {\n27: \t\tt.Errorf(\"logStarted output missing profile, got:\\n%s\", got)\n28: \t}\n29: }\n30: \n31: func TestLogAgentInvoked(t *testing.T) {\n32: \tvar buf bytes.Buffer\n33: \tlogAgentInvoked(&buf, \"developer\", 2)\n34: \tgot := buf.String()\n35: \tif !strings.Contains(got, \"developer invoked (attempt 2)\") {\n36: \t\tt.Errorf(\"logAgentInvoked output missing header, got:\\n%s\", got)\n37: \t}\n38: }\n39: \n40: func TestLogJobFinishedIncludesReasonByDefault(t *testing.T) {\n41: \tvar buf bytes.Buffer\n42: \tlogJobFinished(&buf, orchestrate.StopFinished, \"verdict.md's Overall verdict is APPROVED\", true)\n43: \tgot := buf.String()\n44: \tif !strings.Contains(got, \"mg jdi finished\") {\n45: \t\tt.Errorf(\"logJobFinished output missing 'mg jdi finished', got:\\n%s\", got)\n46: \t}\n47: \tif !strings.Contains(got, \"stop-finished\") {\n48: \t\tt.Errorf(\"logJobFinished output missing the outcome kind, got:\\n%s\", got)\n49: \t}\n50: \tif !strings.Contains(got, \"verdict.md's Overall verdict is APPROVED\") {\n51: \t\tt.Errorf(\"logJobFinished output missing reason, got:\\n%s\", got)\n52: \t}\n53: }\n54: \n55: func TestLogJobFinishedOmitsReasonWhenAlreadyLogged(t *testing.T) {\n56: \tvar buf bytes.Buffer\n57: \tlogJobFinished(&buf, orchestrate.StopNeedsHuman, \"brief.md is not written yet\", false)\n58: \tgot := buf.String()\n59: \tif !strings.Contains(got, \"mg jdi finished\") {\n60: \t\tt.Errorf(\"logJobFinished output missing 'mg jdi finished', got:\\n%s\", got)\n61: \t}\n62: \tif strings.Contains(got, \"brief.md is not written yet\") {\n63: \t\tt.Errorf(\"logJobFinished output repeats reason despite includeReason=false, got:\\n%s\", got)\n64: \t}\n65: }\n66: \n67: func TestLogInvocationPlainText(t *testing.T) {\n68: \tvar buf bytes.Buffer\n69: \tlogInvocation(&buf, \"developer\", 1, []byte(\"did the thing\\n\"), \"\", \"\")\n70: \tgot := buf.String()\n71: \tif !strings.Contains(got, \"developer finished (attempt 1)\") {\n72: \t\tt.Errorf(\"logInvocation output missing header, got:\\n%s\", got)\n73: \t}\n74: \tif !strings.Contains(got, \"did the thing\") {\n75: \t\tt.Errorf(\"logInvocation output missing agent text, got:\\n%s\", got)\n76: \t}\n77: }\n78: \n79: func TestLogInvocationExtractsJSONResult(t *testing.T) {\n80: \tvar buf bytes.Buffer\n81: \traw := []byte(`{\"type\":\"result\",\"result\":\"All done, committed TASK-1.\"}`)\n82: \tlogInvocation(&buf, \"developer\", 2, raw, \"\", \"\")\n83: \tgot := buf.String()\n84: \tif !strings.Contains(got, \"All done, committed TASK-1.\") {\n85: \t\tt.Errorf(\"logInvocation did not extract the JSON result field, got:\\n%s\", got)\n86: \t}\n87: \tif strings.Contains(got, `\"type\":\"result\"`) {\n88: \t\tt.Errorf(\"logInvocation leaked raw JSON into the log, got:\\n%s\", got)\n89: \t}\n90: }\n91: \n92: func TestLogInvocationEmptyOutput(t *testing.T) {\n93: \tvar buf bytes.Buffer\n94: \tlogInvocation(&buf, \"analyst\", 1, nil, \"\", \"\")\n95: \tgot := buf.String()\n96: \tif !strings.Contains(got, \"(no output)\") {\n97: \t\tt.Errorf(\"logInvocation on empty output = %q, want it to note there was no output\", got)\n98: \t}\n99: }\n100: \n101: // --- TASK-5: dedup already-committed file content -----------------------\n102: \n103: func TestLogInvocationOmitsDuplicateOutput(t *testing.T) {\n104: \tvar buf bytes.Buffer\n105: \tfileContent := \"# Tasks\\n\\nTASK-1: do the thing\\n\"\n106: \traw := []byte(\"Sure, here's what I wrote:\\n\\n\" + fileContent + \"\\nAll done!\")\n107: \tlogInvocation(&buf, \"analyst\", 1, raw, \"tasks.md\", fileContent)\n108: \tgot := buf.String()\n109: \tif !strings.Contains(got, \"(output matches tasks.md, omitted)\") {\n110: \t\tt.Errorf(\"logInvocation did not dedup matching output, got:\\n%s\", got)\n111: \t}\n112: \tif strings.Contains(got, \"TASK-1: do the thing\") {\n113: \t\tt.Errorf(\"logInvocation printed the full duplicated text instead of omitting it, got:\\n%s\", got)\n114: \t}\n115: }\n116: \n117: func TestLogInvocationKeepsDistinctOutput(t *testing.T) {\n118: \tvar buf bytes.Buffer\n119: \tfileContent := \"# Tasks\\n\\nTASK-1: do the thing\\n\"\n120: \traw := []byte(\"I analyzed the brief and decided on a different approach entirely.\")\n121: \tlogInvocation(&buf, \"analyst\", 1, raw, \"tasks.md\", fileContent)\n122: \tgot := buf.String()\n123: \tif strings.Contains(got, \"omitted\") {\n124: \t\tt.Errorf(\"logInvocation dedup'd distinct output, got:\\n%s\", got)\n125: \t}\n126: \tif !strings.Contains(got, \"I analyzed the brief\") {\n127: \t\tt.Errorf(\"logInvocation output missing agent text, got:\\n%s\", got)\n128: \t}\n129: }\n130: \n131: func TestLogInvocationSkipsDedupWhenTargetFileEmpty(t *testing.T) {\n132: \tvar buf bytes.Buffer\n133: \traw := []byte(\"some response text\")\n134: \tlogInvocation(&buf, \"analyst\", 1, raw, \"\", \"\")\n135: \tgot := buf.String()\n136: \tif strings.Contains(got, \"omitted\") {\n137: \t\tt.Errorf(\"logInvocation dedup'd with no target file, got:\\n%s\", got)\n138: \t}\n139: \tif !strings.Contains(got, \"some response text\") {\n140: \t\tt.Errorf(\"logInvocation output missing agent text, got:\\n%s\", got)\n141: \t}\n142: }\n143: \n144: func TestIsDuplicateOutput(t *testing.T) {\n145: \tcases := []struct {\n146: \t\tname        string\n147: \t\ttext        string\n148: \t\tfileContent string\n149: \t\twant        bool\n150: \t}{\n151: \t\t{\"exact substring\", \"prose\\n# Tasks\\nTASK-1\\nmore prose\", \"# Tasks\\nTASK-1\", true},\n152: \t\t{\"whitespace differs\", \"prose\\n#  Tasks\\n\\nTASK-1  \\nmore prose\", \"# Tasks\\nTASK-1\", true},\n153: \t\t{\"not present\", \"totally different text\", \"# Tasks\\nTASK-1\", false},\n154: \t\t{\"empty file content never matches\", \"anything at all\", \"\", false},\n155: \t}\n156: \tfor _, c := range cases {\n157: \t\tt.Run(c.name, func(t *testing.T) {\n158: \t\t\tif got := isDuplicateOutput(c.text, c.fileContent); got != c.want {\n159: \t\t\t\tt.Errorf(\"isDuplicateOutput(%q, %q) = %v, want %v\", c.text, c.fileContent, got, c.want)\n160: \t\t\t}\n161: \t\t})\n162: \t}\n163: }\n164: \n165: func TestOpenRunLogCreatesSidecarAndAppends(t *testing.T) {\n166: \troot := t.TempDir()\n167: \tconst jobName = \"aaaa01_test-job\"\n168: \n169: \tf, _, err := openRunLog(root, jobName)\n170: \tif err != nil {\n171: \t\tt.Fatalf(\"openRunLog: %v\", err)\n172: \t}\n173: \tif _, err := f.WriteString(\"first run\\n\"); err != nil {\n174: \t\tt.Fatal(err)\n175: \t}\n176: \tf.Close()\n177: \n178: \t// A second open must append, not truncate — a fresh mg-jdi run\n179: \t// continues the same job's transcript.\n180: \tf2, hadContent, err := openRunLog(root, jobName)\n181: \tif err != nil {\n182: \t\tt.Fatalf(\"openRunLog (second): %v\", err)\n183: \t}\n184: \tif !hadContent {\n185: \t\tt.Error(\"second open of a non-empty run.log reported hadContent=false, want true\")\n186: \t}\n187: \tif _, err := f2.WriteString(\"second run\\n\"); err != nil {\n188: \t\tt.Fatal(err)\n189: \t}\n190: \tf2.Close()\n191: \n192: \tdata, err := os.ReadFile(job.JDIRunLogPath(root, jobName))\n193: \tif err != nil {\n194: \t\tt.Fatalf(\"reading run.log: %v\", err)\n195: \t}\n196: \tgot := string(data)\n197: \tif !strings.Contains(got, \"first run\") || !strings.Contains(got, \"second run\") {\n198: \t\tt.Errorf(\"run.log = %q, want both writes present (append, not truncate)\", got)\n199: \t}\n200: }\n201: \n202: func TestOpenRunLogReportsEmptyFreshLog(t *testing.T) {\n203: \troot := t.TempDir()\n204: \tconst jobName = \"aaaa02_test-job\"\n205: \n206: \tf, hadContent, err := openRunLog(root, jobName)\n207: \tif err != nil {\n208: \t\tt.Fatalf(\"openRunLog: %v\", err)\n209: \t}\n210: \tif hadContent {\n211: \t\tt.Error(\"first open of a fresh run.log reported hadContent=true, want false\")\n212: \t}\n213: \tf.Close()\n214: }\n215: \n216: // TestRunLogSeparationAcrossRuns wires openRunLog and sectionWriter together\n217: // exactly as main() does, across two runs of the same job: the first run\n218: // ever written to the log starts it at the top (no leading blank line), and\n219: // the second run's first header picks up the separating blank line.\n220: func TestRunLogSeparationAcrossRuns(t *testing.T) {\n221: \troot := t.TempDir()\n222: \tconst jobName = \"aaaa03_test-job\"\n223: \n224: \trun := func() {\n225: \t\tf, hadContent, err := openRunLog(root, jobName)\n226: \t\tif err != nil {\n227: \t\t\tt.Fatalf(\"openRunLog: %v\", err)\n228: \t\t}\n229: \t\tdefer f.Close()\n230: \t\tw := &sectionWriter{w: f, wroteSection: hadContent}\n231: \t\tlogStarted(w, jobName, \"claude-pro\")\n232: \t\tlogJobFinished(w, orchestrate.StopFinished, \"verdict APPROVED\", true)\n233: \t}\n234: \n235: \trun()\n236: \tdata, err := os.ReadFile(job.JDIRunLogPath(root, jobName))\n237: \tif err != nil {\n238: \t\tt.Fatalf(\"reading run.log: %v\", err)\n239: \t}\n240: \tfirst := string(data)\n241: \tif strings.HasPrefix(first, \"\\n\") {\n242: \t\tt.Errorf(\"first run ever must not open the log with a blank line, got:\\n%q\", first)\n243: \t}\n244: \tif n := sectionHeaderCount(first); n != 2 {\n245: \t\tt.Fatalf(\"first run wrote %d headers, want 2:\\n%q\", n, first)\n246: \t}\n247: \tif n := strings.Count(first, \"\\n\\n\\n===\"); n != 1 {\n248: \t\tt.Errorf(\"first run should have exactly 1 separator (between its two headers), got %d:\\n%q\", n, first)\n249: \t}\n250: \n251: \trun()\n252: \tdata, err = os.ReadFile(job.JDIRunLogPath(root, jobName))\n253: \tif err != nil {\n254: \t\tt.Fatalf(\"reading run.log: %v\", err)\n255: \t}\n256: \tboth := string(data)\n257: \tif n := sectionHeaderCount(both); n != 4 {\n258: \t\tt.Fatalf(\"after two runs got %d headers, want 4:\\n%q\", n, both)\n259: \t}\n260: \tif n := strings.Count(both, \"\\n\\n\\n===\"); n != 3 {\n261: \t\tt.Errorf(\"second run should add 2 separators (1 between its own headers + 1 from the prior run's last header), got %d:\\n%q\", n, both)\n262: \t}\n263: }\n264: \n265: // --- sectionWriter -----------------------------------------------------------\n266: \n267: // TestSectionWriterSeparatesHeadersButNotFirstRunEver covers the two\n268: // sectionWriter behaviors together: within a single writer, the very first\n269: // section header (a fresh log — the first run ever written to it) gets no\n270: // leading blank line, while every subsequent header gets \"\\n\\n\", and\n271: // non-header writes (an agent-text or reason body following its header)\n272: // pass through untouched — sectionWriter never inserts blank lines inside a\n273: // section. The invocation body's two blank lines of separation (brief: jdi\n274: // logs new line) are logInvocation's own writes, asserted below.\n275: func TestSectionWriterSeparatesHeadersButNotFirstRunEver(t *testing.T) {\n276: \tvar buf bytes.Buffer\n277: \tw := &sectionWriter{w: &buf, wroteSection: false}\n278: \n279: \tlogStarted(w, \"aaaa01_test-job\", \"claude-pro\")\n280: \tlogAgentInvoked(w, \"analyst\", 1)\n281: \tlogInvocation(w, \"analyst\", 1, []byte(\"wrote tasks.md\"), \"\", \"\")\n282: \tlogJobFinished(w, orchestrate.StopFinished, \"verdict APPROVED\", true)\n283: \n284: \tgot := buf.String()\n285: \tif strings.HasPrefix(got, \"\\n\") {\n286: \t\tt.Errorf(\"fresh log must start at the top with no leading blank line, got:\\n%q\", got)\n287: \t}\n288: \t// Every header line after the first must be preceded by a blank line —\n289: \t// the separator is \"\\n\\n\" on top of the preceding header's own trailing\n290: \t// newline, so between two headers the text reads \"\\n\\n\\n===\", and that\n291: \t// separator must appear exactly once per header after the first.\n292: \tif n := sectionHeaderCount(got); n != 4 {\n293: \t\tt.Fatalf(\"got %d section headers, want 4:\\n%q\", n, got)\n294: \t}\n295: \tif n := strings.Count(got, \"\\n\\n\\n===\"); n != 3 {\n296: \t\tt.Errorf(\"got %d blank-line separators, want 3 (one before every header but the first):\\n%q\", n, got)\n297: \t}\n298: \t// The invocation body is deliberately separated from its \"finished\"\n299: \t// header by two blank lines (brief: jdi logs new line): the header's own\n300: \t// trailing newline plus the two blank lines reads as\n301: \t// \"finished (attempt 1) ===\\n\\n\\nwrote tasks.md\", so the agent's output\n302: \t// no longer looks glued to the finished statement.\n303: \tif !strings.Contains(got, \"finished (attempt 1) ===\\n\\n\\nwrote tasks.md\") {\n304: \t\tt.Errorf(\"expected two blank lines between the finished header and its body, got:\\n%q\", got)\n305: \t}\n306: \tif strings.Contains(got, \"finished (attempt 1) ===\\n\\n\\n\\nwrote tasks.md\") {\n307: \t\tt.Errorf(\"more than two blank lines between the finished header and its body, got:\\n%q\", got)\n308: \t}\n309: }\n310: \n311: // TestSectionWriterJoinsPriorRunWithBlankLine covers the \"second run\" case:\n312: // a run.log that already has content (wroteSection seeded true) must get the\n313: // separating blank line before its very first header too.\n314: func TestSectionWriterJoinsPriorRunWithBlankLine(t *testing.T) {\n315: \tvar buf bytes.Buffer\n316: \tbuf.WriteString(\"=== 2026-01-01T00:00:00Z mg jdi started: job aaaa01, profile claude-pro ===\\n\")\n317: \tw := &sectionWriter{w: &buf, wroteSection: true}\n318: \n319: \tlogStarted(w, \"aaaa01_test-job\", \"claude-pro\")\n320: \tlogAgentInvoked(w, \"reviewer\", 1)\n321: \n322: \tgot := buf.String()\n323: \tif n := sectionHeaderCount(got); n != 3 {\n324: \t\tt.Fatalf(\"got %d section headers, want 3:\\n%q\", n, got)\n325: \t}\n326: \tif n := strings.Count(got, \"\\n\\n\\n===\"); n != 2 {\n327: \t\tt.Errorf(\"got %d blank-line separators, want 2 (before both of this run's headers — the prior run's own header was the first ever written, so it correctly has none):\\n%q\", n, got)\n328: \t}\n329: }\n330: \n331: // sectionHeaderCount counts the \"=== ... ===\" state-log header lines in s —\n332: // lines that begin (at the very start, or right after a newline) with \"===\".\n333: // Counting occurrences of the \"===\" literal itself would overcount, since\n334: // each header line both opens and closes with it.\n335: func sectionHeaderCount(s string) int {\n336: \tn := 0\n337: \tfor _, line := range strings.Split(s, \"\\n\") {\n338: \t\tif strings.HasPrefix(line, \"===\") {\n339: \t\t\tn++\n340: \t\t}\n341: \t}\n342: \treturn n\n343: }\n344: \n345: // TestSectionWriterPassesThroughNonHeaders ensures a write that does not\n346: // begin with the \"===\" literal — e.g. an invocation's agent text or a stop\n347: // reason — is never prefixed, so blank lines only ever separate sections.\n348: func TestSectionWriterPassesThroughNonHeaders(t *testing.T) {\n349: \tvar buf bytes.Buffer\n350: \tw := &sectionWriter{w: &buf, wroteSection: true}\n351: \n352: \t// A reason line written straight through must not pick up a prefix.\n353: \tif _, err := w.Write([]byte(\"brief.md is not written yet\\n\")); err != nil {\n354: \t\tt.Fatal(err)\n355: \t}\n356: \t// A subsequent real header still gets separated from it.\n357: \tlogImmediateStop(w, \"brief.md is not written yet\")\n358: \n359: \tgot := buf.String()\n360: \tif !strings.HasPrefix(got, \"brief.md is not written yet\\n\") {\n361: \t\tt.Errorf(\"non-header write was not passed through verbatim, got:\\n%q\", got)\n362: \t}\n363: \tif n := strings.Count(got, \"\\n\\n\\n===\"); n != 1 {\n364: \t\tt.Errorf(\"got %d separators, want exactly 1 (only before the header):\\n%q\", n, got)\n365: \t}\n366: }\n367: \n368: // --- ensureSidecarIgnored ----------------------------------------------------\n369: //\n370: // Regression coverage for a bug a real end-to-end mg-jdi run (TASK-14) caught:\n371: // without this, an agent's own `git add -A` (run inside the container against\n372: // the *target project*, not manigot's own checkout) swept the status/run.log\n373: // sidecar straight into a real job-branch commit.\n374: \n375: func gitRunForOutputTest(t *testing.T, dir string, args ...string) {\n376: \tt.Helper()\n377: \tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n378: \tif out, err := cmd.CombinedOutput(); err != nil {\n379: \t\tt.Fatalf(\"git %s in %s: %v\\n%s\", strings.Join(args, \" \"), dir, err, out)\n380: \t}\n381: }\n382: \n383: func initGitRepoForOutputTest(t *testing.T) string {\n384: \tt.Helper()\n385: \tdir := t.TempDir()\n386: \tgitRunForOutputTest(t, dir, \"init\", \"-q\")\n387: \tgitRunForOutputTest(t, dir, \"config\", \"user.email\", \"t@example.com\")\n388: \tgitRunForOutputTest(t, dir, \"config\", \"user.name\", \"Test\")\n389: \tgitRunForOutputTest(t, dir, \"config\", \"commit.gpgsign\", \"false\")\n390: \tif err := os.WriteFile(filepath.Join(dir, \"README\"), []byte(\"init\\n\"), 0o644); err != nil {\n391: \t\tt.Fatal(err)\n392: \t}\n393: \tgitRunForOutputTest(t, dir, \"add\", \"README\")\n394: \tgitRunForOutputTest(t, dir, \"commit\", \"-q\", \"-m\", \"init\")\n395: \treturn dir\n396: }\n397: \n398: func TestEnsureSidecarIgnoredWritesExcludeFile(t *testing.T) {\n399: \troot := initGitRepoForOutputTest(t)\n400: \n401: \tif err := ensureSidecarIgnored(root); err != nil {\n402: \t\tt.Fatalf(\"ensureSidecarIgnored: %v\", err)\n403: \t}\n404: \n405: \tdata, err := os.ReadFile(filepath.Join(root, \".git\", \"info\", \"exclude\"))\n406: \tif err != nil {\n407: \t\tt.Fatalf(\"reading .git/info/exclude: %v\", err)\n408: \t}\n409: \tif !strings.Contains(string(data), \".manigot/jdi-status/\") {\n410: \t\tt.Errorf(\".git/info/exclude = %q, want it to contain .manigot/jdi-status/\", string(data))\n411: \t}\n412: }\n413: \n414: func TestEnsureSidecarIgnoredIsIdempotent(t *testing.T) {\n415: \troot := initGitRepoForOutputTest(t)\n416: \n417: \tif err := ensureSidecarIgnored(root); err != nil {\n418: \t\tt.Fatal(err)\n419: \t}\n420: \tif err := ensureSidecarIgnored(root); err != nil {\n421: \t\tt.Fatal(err)\n422: \t}\n423: \n424: \tdata, err := os.ReadFile(filepath.Join(root, \".git\", \"info\", \"exclude\"))\n425: \tif err != nil {\n426: \t\tt.Fatal(err)\n427: \t}\n428: \tcount := strings.Count(string(data), \".manigot/jdi-status/\")\n429: \tif count != 1 {\n430: \t\tt.Errorf(\"pattern appears %d times after two calls, want exactly 1 (idempotent)\", count)\n431: \t}\n432: }\n433: \n434: func TestEnsureSidecarIgnoredPreservesExistingContent(t *testing.T) {\n435: \troot := initGitRepoForOutputTest(t)\n436: \texcludeDir := filepath.Join(root, \".git\", \"info\")\n437: \tif err := os.MkdirAll(excludeDir, 0o755); err != nil {\n438: \t\tt.Fatal(err)\n439: \t}\n440: \tif err := os.WriteFile(filepath.Join(excludeDir, \"exclude\"), []byte(\"*.local\\n\"), 0o644); err != nil {\n441: \t\tt.Fatal(err)\n442: \t}\n443: \n444: \tif err := ensureSidecarIgnored(root); err != nil {\n445: \t\tt.Fatal(err)\n446: \t}\n447: \n448: \tdata, err := os.ReadFile(filepath.Join(excludeDir, \"exclude\"))\n449: \tif err != nil {\n450: \t\tt.Fatal(err)\n451: \t}\n452: \tgot := string(data)\n453: \tif !strings.Contains(got, \"*.local\") {\n454: \t\tt.Errorf(\".git/info/exclude lost its pre-existing content: %q\", got)\n455: \t}\n456: \tif !strings.Contains(got, \".manigot/jdi-status/\") {\n457: \t\tt.Errorf(\".git/info/exclude missing the sidecar pattern: %q\", got)\n458: \t}\n459: }\n460: \n461: // TestEnsureSidecarIgnoredActuallyWorksWithGit is the real regression test:\n462: // after ensureSidecarIgnored, `git add -A` inside the project must not pick\n463: // up the sidecar directory at all — the exact scenario the TASK-14 manual\n464: // run caught.\n465: func TestEnsureSidecarIgnoredActuallyWorksWithGit(t *testing.T) {\n466: \troot := initGitRepoForOutputTest(t)\n467: \tif err := ensureSidecarIgnored(root); err != nil {\n468: \t\tt.Fatal(err)\n469: \t}\n470: \n471: \tsidecarFile := filepath.Join(root, \".manigot\", \"jdi-status\", \"aaaa01_x\", \"status\")\n472: \tif err := os.MkdirAll(filepath.Dir(sidecarFile), 0o755); err != nil {\n473: \t\tt.Fatal(err)\n474: \t}\n475: \tif err := os.WriteFile(sidecarFile, []byte(\"{}\"), 0o644); err != nil {\n476: \t\tt.Fatal(err)\n477: \t}\n478: \t// A normal job file, tracked as usual, to prove add -A isn't just a\n479: \t// no-op — it should still pick this up.\n480: \tjobFile := filepath.Join(root, \"docs\", \"jobs\", \"aaaa01_x\", \"tasks.md\")\n481: \tif err := os.MkdirAll(filepath.Dir(jobFile), 0o755); err != nil {\n482: \t\tt.Fatal(err)\n483: \t}\n484: \tif err := os.WriteFile(jobFile, []byte(\"# Tasks\\n\"), 0o644); err != nil {\n485: \t\tt.Fatal(err)\n486: \t}\n487: \n488: \tgitRunForOutputTest(t, root, \"add\", \"-A\")\n489: \n490: \tout, err := exec.Command(\"git\", \"-C\", root, \"diff\", \"--cached\", \"--name-only\").Output()\n491: \tif err != nil {\n492: \t\tt.Fatal(err)\n493: \t}\n494: \tstaged := string(out)\n495: \tif strings.Contains(staged, \"jdi-status\") {\n496: \t\tt.Errorf(\"git add -A staged the sidecar despite ensureSidecarIgnored:\\n%s\", staged)\n497: \t}\n498: \tif !strings.Contains(staged, \"docs/jobs/aaaa01_x/tasks.md\") {\n499: \t\tt.Errorf(\"git add -A did not stage the real job file — test itself is broken:\\n%s\", staged)\n500: \t}\n501: }\n502: \n503: // --- session.log append helper (appendSessionLog) ---------------------------\n504: \n505: func TestAppendSessionLogCreatesOnFirstUse(t *testing.T) {\n506: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n507: \tif err := appendSessionLog(path, \"analyst\", 1, []byte(\"Wrote tasks.md.\\n\")); err != nil {\n508: \t\tt.Fatalf(\"appendSessionLog: %v\", err)\n509: \t}\n510: \tdata, err := os.ReadFile(path)\n511: \tif err != nil {\n512: \t\tt.Fatalf(\"reading session.log: %v\", err)\n513: \t}\n514: \tgot := string(data)\n515: \tif !strings.Contains(got, \"analyst (attempt 1)\") {\n516: \t\tt.Errorf(\"session.log = %q, want an analyst (attempt 1) header\", got)\n517: \t}\n518: \tif !strings.Contains(got, \"Wrote tasks.md.\") {\n519: \t\tt.Errorf(\"session.log = %q, want the raw output preserved\", got)\n520: \t}\n521: }\n522: \n523: func TestAppendSessionLogAppendsAcrossSections(t *testing.T) {\n524: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n525: \tif err := appendSessionLog(path, \"analyst\", 1, []byte(\"first output\\n\")); err != nil {\n526: \t\tt.Fatal(err)\n527: \t}\n528: \tif err := appendSessionLog(path, \"developer\", 2, []byte(\"second output\\n\")); err != nil {\n529: \t\tt.Fatal(err)\n530: \t}\n531: \tdata, err := os.ReadFile(path)\n532: \tif err != nil {\n533: \t\tt.Fatal(err)\n534: \t}\n535: \tgot := string(data)\n536: \tif i, j := strings.Index(got, \"analyst (attempt 1)\"), strings.Index(got, \"developer (attempt 2)\"); i == -1 || j == -1 || i > j {\n537: \t\tt.Errorf(\"session.log sections out of order or missing, got:\\n%s\", got)\n538: \t}\n539: \tif i, j := strings.Index(got, \"first output\"), strings.Index(got, \"second output\"); i == -1 || j == -1 || i > j {\n540: \t\tt.Errorf(\"session.log raw outputs out of order or missing, got:\\n%s\", got)\n541: \t}\n542: }\n543: \n544: func TestAppendSessionLogHeaderCarriesAgentAttemptTimestamp(t *testing.T) {\n545: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n546: \tif err := appendSessionLog(path, \"reviewer\", 3, []byte(\"ok\\n\")); err != nil {\n547: \t\tt.Fatal(err)\n548: \t}\n549: \tdata, err := os.ReadFile(path)\n550: \tif err != nil {\n551: \t\tt.Fatal(err)\n552: \t}\n553: \t// The header is the first line: \"=== <RFC3339 timestamp> <agent>\n554: \t// (attempt N) ===\".\n555: \tline, _, _ := strings.Cut(string(data), \"\\n\")\n556: \tif !strings.HasPrefix(line, \"=== \") || !strings.HasSuffix(line, \" reviewer (attempt 3) ===\") {\n557: \t\tt.Fatalf(\"header line = %q, want %q shape\", line, \"=== <timestamp> reviewer (attempt 3) ===\")\n558: \t}\n559: \tts := strings.TrimSuffix(strings.TrimPrefix(line, \"=== \"), \" reviewer (attempt 3) ===\")\n560: \tif _, err := time.Parse(time.RFC3339, ts); err != nil {\n561: \t\tt.Errorf(\"header timestamp %q is not RFC3339: %v\", ts, err)\n562: \t}\n563: }\n564: \n565: func TestAppendSessionLogPreservesRawVerbatim(t *testing.T) {\n566: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n567: \traw := []byte(\"line one\\nline two\\nline three\\n\")\n568: \tif err := appendSessionLog(path, \"analyst\", 1, raw); err != nil {\n569: \t\tt.Fatal(err)\n570: \t}\n571: \tdata, err := os.ReadFile(path)\n572: \tif err != nil {\n573: \t\tt.Fatal(err)\n574: \t}\n575: \tif !strings.Contains(string(data), \"line one\\nline two\\nline three\\n\") {\n576: \t\tt.Errorf(\"session.log = %q, want the raw bytes preserved verbatim\", string(data))\n577: \t}\n578: }\n579: \n580: func TestAppendSessionLogSectionsSeparated(t *testing.T) {\n581: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n582: \t// Two sections where the first's raw output deliberately lacks a\n583: \t// trailing newline: the blank-line separator plus the trailing-newline\n584: \t// guarantee must keep the second section's header from gluing to it.\n585: \tif err := appendSessionLog(path, \"analyst\", 1, []byte(\"no trailing newline\")); err != nil {\n586: \t\tt.Fatal(err)\n587: \t}\n588: \tif err := appendSessionLog(path, \"developer\", 1, []byte(\"second\\n\")); err != nil {\n589: \t\tt.Fatal(err)\n590: \t}\n591: \tdata, err := os.ReadFile(path)\n592: \tif err != nil {\n593: \t\tt.Fatal(err)\n594: \t}\n595: \tgot := string(data)\n596: \tif !strings.Contains(got, \"no trailing newline\\n\\n=== \") {\n597: \t\tt.Errorf(\"sections not separated by a blank line, got:\\n%q\", got)\n598: \t}\n599: }\n600: \n601: func TestAppendSessionLogTrailingNewlineGuarantee(t *testing.T) {\n602: \t// Raw output without a trailing newline gets one appended...\n603: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n604: \tif err := appendSessionLog(path, \"analyst\", 1, []byte(\"no newline\")); err != nil {\n605: \t\tt.Fatal(err)\n606: \t}\n607: \tdata, err := os.ReadFile(path)\n608: \tif err != nil {\n609: \t\tt.Fatal(err)\n610: \t}\n611: \tif !strings.HasSuffix(string(data), \"no newline\\n\") {\n612: \t\tt.Errorf(\"session.log = %q, want the raw output to end with a newline\", string(data))\n613: \t}\n614: \t// ...and output that already ends with one is not double-newlined.\n615: \tpath2 := filepath.Join(t.TempDir(), \"session.log\")\n616: \tif err := appendSessionLog(path2, \"analyst\", 1, []byte(\"has newline\\n\")); err != nil {\n617: \t\tt.Fatal(err)\n618: \t}\n619: \tdata2, err := os.ReadFile(path2)\n620: \tif err != nil {\n621: \t\tt.Fatal(err)\n622: \t}\n623: \tif strings.HasSuffix(string(data2), \"has newline\\n\\n\") {\n624: \t\tt.Errorf(\"session.log = %q, want exactly one trailing newline\", string(data2))\n625: \t}\n626: }\n627: \n628: func TestAppendSessionLogEmptyRawStillWritesHeader(t *testing.T) {\n629: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n630: \tif err := appendSessionLog(path, \"analyst\", 1, nil); err != nil {\n631: \t\tt.Fatal(err)\n632: \t}\n633: \tdata, err := os.ReadFile(path)\n634: \tif err != nil {\n635: \t\tt.Fatal(err)\n636: \t}\n637: \tif got := string(data); !strings.Contains(got, \"analyst (attempt 1)\") {\n638: \t\tt.Errorf(\"session.log = %q, want the header even for empty output\", got)\n639: \t}\n640: }\n\n(End of file - total 640 lines)\n</content>","metadata":{"preview":"package main\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n)\n\nfunc TestLogStarted(t *testing.T) {\n\tvar buf bytes.Buffer\n\tlogStarted(&buf, \"aaaa01_test-job\", \"claude-pro\")\n\tgot := buf.String()\n\tif !strings.Contains(got, \"mg jdi started\") {","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/cmd/mg/jdioutput_test.go","text":"package main\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n)\n\nfunc TestLogStarted(t *testing.T) {\n\tvar buf bytes.Buffer\n\tlogStarted(&buf, \"aaaa01_test-job\", \"claude-pro\")\n\tgot := buf.String()\n\tif !strings.Contains(got, \"mg jdi started\") {\n\t\tt.Errorf(\"logStarted output missing 'mg jdi started', got:\\n%s\", got)\n\t}\n\tif !strings.Contains(got, \"aaaa01_test-job\") {\n\t\tt.Errorf(\"logStarted output missing job name, got:\\n%s\", got)\n\t}\n\tif !strings.Contains(got, \"claude-pro\") {\n\t\tt.Errorf(\"logStarted output missing profile, got:\\n%s\", got)\n\t}\n}\n\nfunc TestLogAgentInvoked(t *testing.T) {\n\tvar buf bytes.Buffer\n\tlogAgentInvoked(&buf, \"developer\", 2)\n\tgot := buf.String()\n\tif !strings.Contains(got, \"developer invoked (attempt 2)\") {\n\t\tt.Errorf(\"logAgentInvoked output missing header, got:\\n%s\", got)\n\t}\n}\n\nfunc TestLogJobFinishedIncludesReasonByDefault(t *testing.T) {\n\tvar buf bytes.Buffer\n\tlogJobFinished(&buf, orchestrate.StopFinished, \"verdict.md's Overall verdict is APPROVED\", true)\n\tgot := buf.String()\n\tif !strings.Contains(got, \"mg jdi finished\") {\n\t\tt.Errorf(\"logJobFinished output missing 'mg jdi finished', got:\\n%s\", got)\n\t}\n\tif !strings.Contains(got, \"stop-finished\") {\n\t\tt.Errorf(\"logJobFinished output missing the outcome kind, got:\\n%s\", got)\n\t}\n\tif !strings.Contains(got, \"verdict.md's Overall verdict is APPROVED\") {\n\t\tt.Errorf(\"logJobFinished output missing reason, got:\\n%s\", got)\n\t}\n}\n\nfunc TestLogJobFinishedOmitsReasonWhenAlreadyLogged(t *testing.T) {\n\tvar buf bytes.Buffer\n\tlogJobFinished(&buf, orchestrate.StopNeedsHuman, \"brief.md is not written yet\", false)\n\tgot := buf.String()\n\tif !strings.Contains(got, \"mg jdi finished\") {\n\t\tt.Errorf(\"logJobFinished output missing 'mg jdi finished', got:\\n%s\", got)\n\t}\n\tif strings.Contains(got, \"brief.md is not written yet\") {\n\t\tt.Errorf(\"logJobFinished output repeats reason despite includeReason=false, got:\\n%s\", got)\n\t}\n}\n\nfunc TestLogInvocationPlainText(t *testing.T) {\n\tvar buf bytes.Buffer\n\tlogInvocation(&buf, \"developer\", 1, []byte(\"did the thing\\n\"), \"\", \"\")\n\tgot := buf.String()\n\tif !strings.Contains(got, \"developer finished (attempt 1)\") {\n\t\tt.Errorf(\"logInvocation output missing header, got:\\n%s\", got)\n\t}\n\tif !strings.Contains(got, \"did the thing\") {\n\t\tt.Errorf(\"logInvocation output missing agent text, got:\\n%s\", got)\n\t}\n}\n\nfunc TestLogInvocationExtractsJSONResult(t *testing.T) {\n\tvar buf bytes.Buffer\n\traw := []byte(`{\"type\":\"result\",\"result\":\"All done, committed TASK-1.\"}`)\n\tlogInvocation(&buf, \"developer\", 2, raw, \"\", \"\")\n\tgot := buf.String()\n\tif !strings.Contains(got, \"All done, committed TASK-1.\") {\n\t\tt.Errorf(\"logInvocation did not extract the JSON result field, got:\\n%s\", got)\n\t}\n\tif strings.Contains(got, `\"type\":\"result\"`) {\n\t\tt.Errorf(\"logInvocation leaked raw JSON into the log, got:\\n%s\", got)\n\t}\n}\n\nfunc TestLogInvocationEmptyOutput(t *testing.T) {\n\tvar buf bytes.Buffer\n\tlogInvocation(&buf, \"analyst\", 1, nil, \"\", \"\")\n\tgot := buf.String()\n\tif !strings.Contains(got, \"(no output)\") {\n\t\tt.Errorf(\"logInvocation on empty output = %q, want it to note there was no output\", got)\n\t}\n}\n\n// --- TASK-5: dedup already-committed file content -----------------------\n\nfunc TestLogInvocationOmitsDuplicateOutput(t *testing.T) {\n\tvar buf bytes.Buffer\n\tfileContent := \"# Tasks\\n\\nTASK-1: do the thing\\n\"\n\traw := []byte(\"Sure, here's what I wrote:\\n\\n\" + fileContent + \"\\nAll done!\")\n\tlogInvocation(&buf, \"analyst\", 1, raw, \"tasks.md\", fileContent)\n\tgot := buf.String()\n\tif !strings.Contains(got, \"(output matches tasks.md, omitted)\") {\n\t\tt.Errorf(\"logInvocation did not dedup matching output, got:\\n%s\", got)\n\t}\n\tif strings.Contains(got, \"TASK-1: do the thing\") {\n\t\tt.Errorf(\"logInvocation printed the full duplicated text instead of omitting it, got:\\n%s\", got)\n\t}\n}\n\nfunc TestLogInvocationKeepsDistinctOutput(t *testing.T) {\n\tvar buf bytes.Buffer\n\tfileContent := \"# Tasks\\n\\nTASK-1: do the thing\\n\"\n\traw := []byte(\"I analyzed the brief and decided on a different approach entirely.\")\n\tlogInvocation(&buf, \"analyst\", 1, raw, \"tasks.md\", fileContent)\n\tgot := buf.String()\n\tif strings.Contains(got, \"omitted\") {\n\t\tt.Errorf(\"logInvocation dedup'd distinct output, got:\\n%s\", got)\n\t}\n\tif !strings.Contains(got, \"I analyzed the brief\") {\n\t\tt.Errorf(\"logInvocation output missing agent text, got:\\n%s\", got)\n\t}\n}\n\nfunc TestLogInvocationSkipsDedupWhenTargetFileEmpty(t *testing.T) {\n\tvar buf bytes.Buffer\n\traw := []byte(\"some response text\")\n\tlogInvocation(&buf, \"analyst\", 1, raw, \"\", \"\")\n\tgot := buf.String()\n\tif strings.Contains(got, \"omitted\") {\n\t\tt.Errorf(\"logInvocation dedup'd with no target file, got:\\n%s\", got)\n\t}\n\tif !strings.Contains(got, \"some response text\") {\n\t\tt.Errorf(\"logInvocation output missing agent text, got:\\n%s\", got)\n\t}\n}\n\nfunc TestIsDuplicateOutput(t *testing.T) {\n\tcases := []struct {\n\t\tname        string\n\t\ttext        string\n\t\tfileContent string\n\t\twant        bool\n\t}{\n\t\t{\"exact substring\", \"prose\\n# Tasks\\nTASK-1\\nmore prose\", \"# Tasks\\nTASK-1\", true},\n\t\t{\"whitespace differs\", \"prose\\n#  Tasks\\n\\nTASK-1  \\nmore prose\", \"# Tasks\\nTASK-1\", true},\n\t\t{\"not present\", \"totally different text\", \"# Tasks\\nTASK-1\", false},\n\t\t{\"empty file content never matches\", \"anything at all\", \"\", false},\n\t}\n\tfor _, c := range cases {\n\t\tt.Run(c.name, func(t *testing.T) {\n\t\t\tif got := isDuplicateOutput(c.text, c.fileContent); got != c.want {\n\t\t\t\tt.Errorf(\"isDuplicateOutput(%q, %q) = %v, want %v\", c.text, c.fileContent, got, c.want)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestOpenRunLogCreatesSidecarAndAppends(t *testing.T) {\n\troot := t.TempDir()\n\tconst jobName = \"aaaa01_test-job\"\n\n\tf, _, err := openRunLog(root, jobName)\n\tif err != nil {\n\t\tt.Fatalf(\"openRunLog: %v\", err)\n\t}\n\tif _, err := f.WriteString(\"first run\\n\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.Close()\n\n\t// A second open must append, not truncate — a fresh mg-jdi run\n\t// continues the same job's transcript.\n\tf2, hadContent, err := openRunLog(root, jobName)\n\tif err != nil {\n\t\tt.Fatalf(\"openRunLog (second): %v\", err)\n\t}\n\tif !hadContent {\n\t\tt.Error(\"second open of a non-empty run.log reported hadContent=false, want true\")\n\t}\n\tif _, err := f2.WriteString(\"second run\\n\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf2.Close()\n\n\tdata, err := os.ReadFile(job.JDIRunLogPath(root, jobName))\n\tif err != nil {\n\t\tt.Fatalf(\"reading run.log: %v\", err)\n\t}\n\tgot := string(data)\n\tif !strings.Contains(got, \"first run\") || !strings.Contains(got, \"second run\") {\n\t\tt.Errorf(\"run.log = %q, want both writes present (append, not truncate)\", got)\n\t}\n}\n\nfunc TestOpenRunLogReportsEmptyFreshLog(t *testing.T) {\n\troot := t.TempDir()\n\tconst jobName = \"aaaa02_test-job\"\n\n\tf, hadContent, err := openRunLog(root, jobName)\n\tif err != nil {\n\t\tt.Fatalf(\"openRunLog: %v\", err)\n\t}\n\tif hadContent {\n\t\tt.Error(\"first open of a fresh run.log reported hadContent=true, want false\")\n\t}\n\tf.Close()\n}\n\n// TestRunLogSeparationAcrossRuns wires openRunLog and sectionWriter together\n// exactly as main() does, across two runs of the same job: the first run\n// ever written to the log starts it at the top (no leading blank line), and\n// the second run's first header picks up the separating blank line.\nfunc TestRunLogSeparationAcrossRuns(t *testing.T) {\n\troot := t.TempDir()\n\tconst jobName = \"aaaa03_test-job\"\n\n\trun := func() {\n\t\tf, hadContent, err := openRunLog(root, jobName)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"openRunLog: %v\", err)\n\t\t}\n\t\tdefer f.Close()\n\t\tw := &sectionWriter{w: f, wroteSection: hadContent}\n\t\tlogStarted(w, jobName, \"claude-pro\")\n\t\tlogJobFinished(w, orchestrate.StopFinished, \"verdict APPROVED\", true)\n\t}\n\n\trun()\n\tdata, err := os.ReadFile(job.JDIRunLogPath(root, jobName))\n\tif err != nil {\n\t\tt.Fatalf(\"reading run.log: %v\", err)\n\t}\n\tfirst := string(data)\n\tif strings.HasPrefix(first, \"\\n\") {\n\t\tt.Errorf(\"first run ever must not open the log with a blank line, got:\\n%q\", first)\n\t}\n\tif n := sectionHeaderCount(first); n != 2 {\n\t\tt.Fatalf(\"first run wrote %d headers, want 2:\\n%q\", n, first)\n\t}\n\tif n := strings.Count(first, \"\\n\\n\\n===\"); n != 1 {\n\t\tt.Errorf(\"first run should have exactly 1 separator (between its two headers), got %d:\\n%q\", n, first)\n\t}\n\n\trun()\n\tdata, err = os.ReadFile(job.JDIRunLogPath(root, jobName))\n\tif err != nil {\n\t\tt.Fatalf(\"reading run.log: %v\", err)\n\t}\n\tboth := string(data)\n\tif n := sectionHeaderCount(both); n != 4 {\n\t\tt.Fatalf(\"after two runs got %d headers, want 4:\\n%q\", n, both)\n\t}\n\tif n := strings.Count(both, \"\\n\\n\\n===\"); n != 3 {\n\t\tt.Errorf(\"second run should add 2 separators (1 between its own headers + 1 from the prior run's last header), got %d:\\n%q\", n, both)\n\t}\n}\n\n// --- sectionWriter -----------------------------------------------------------\n\n// TestSectionWriterSeparatesHeadersButNotFirstRunEver covers the two\n// sectionWriter behaviors together: within a single writer, the very first\n// section header (a fresh log — the first run ever written to it) gets no\n// leading blank line, while every subsequent header gets \"\\n\\n\", and\n// non-header writes (an agent-text or reason body following its header)\n// pass through untouched — sectionWriter never inserts blank lines inside a\n// section. The invocation body's two blank lines of separation (brief: jdi\n// logs new line) are logInvocation's own writes, asserted below.\nfunc TestSectionWriterSeparatesHeadersButNotFirstRunEver(t *testing.T) {\n\tvar buf bytes.Buffer\n\tw := &sectionWriter{w: &buf, wroteSection: false}\n\n\tlogStarted(w, \"aaaa01_test-job\", \"claude-pro\")\n\tlogAgentInvoked(w, \"analyst\", 1)\n\tlogInvocation(w, \"analyst\", 1, []byte(\"wrote tasks.md\"), \"\", \"\")\n\tlogJobFinished(w, orchestrate.StopFinished, \"verdict APPROVED\", true)\n\n\tgot := buf.String()\n\tif strings.HasPrefix(got, \"\\n\") {\n\t\tt.Errorf(\"fresh log must start at the top with no leading blank line, got:\\n%q\", got)\n\t}\n\t// Every header line after the first must be preceded by a blank line —\n\t// the separator is \"\\n\\n\" on top of the preceding header's own trailing\n\t// newline, so between two headers the text reads \"\\n\\n\\n===\", and that\n\t// separator must appear exactly once per header after the first.\n\tif n := sectionHeaderCount(got); n != 4 {\n\t\tt.Fatalf(\"got %d section headers, want 4:\\n%q\", n, got)\n\t}\n\tif n := strings.Count(got, \"\\n\\n\\n===\"); n != 3 {\n\t\tt.Errorf(\"got %d blank-line separators, want 3 (one before every header but the first):\\n%q\", n, got)\n\t}\n\t// The invocation body is deliberately separated from its \"finished\"\n\t// header by two blank lines (brief: jdi logs new line): the header's own\n\t// trailing newline plus the two blank lines reads as\n\t// \"finished (attempt 1) ===\\n\\n\\nwrote tasks.md\", so the agent's output\n\t// no longer looks glued to the finished statement.\n\tif !strings.Contains(got, \"finished (attempt 1) ===\\n\\n\\nwrote tasks.md\") {\n\t\tt.Errorf(\"expected two blank lines between the finished header and its body, got:\\n%q\", got)\n\t}\n\tif strings.Contains(got, \"finished (attempt 1) ===\\n\\n\\n\\nwrote tasks.md\") {\n\t\tt.Errorf(\"more than two blank lines between the finished header and its body, got:\\n%q\", got)\n\t}\n}\n\n// TestSectionWriterJoinsPriorRunWithBlankLine covers the \"second run\" case:\n// a run.log that already has content (wroteSection seeded true) must get the\n// separating blank line before its very first header too.\nfunc TestSectionWriterJoinsPriorRunWithBlankLine(t *testing.T) {\n\tvar buf bytes.Buffer\n\tbuf.WriteString(\"=== 2026-01-01T00:00:00Z mg jdi started: job aaaa01, profile claude-pro ===\\n\")\n\tw := &sectionWriter{w: &buf, wroteSection: true}\n\n\tlogStarted(w, \"aaaa01_test-job\", \"claude-pro\")\n\tlogAgentInvoked(w, \"reviewer\", 1)\n\n\tgot := buf.String()\n\tif n := sectionHeaderCount(got); n != 3 {\n\t\tt.Fatalf(\"got %d section headers, want 3:\\n%q\", n, got)\n\t}\n\tif n := strings.Count(got, \"\\n\\n\\n===\"); n != 2 {\n\t\tt.Errorf(\"got %d blank-line separators, want 2 (before both of this run's headers — the prior run's own header was the first ever written, so it correctly has none):\\n%q\", n, got)\n\t}\n}\n\n// sectionHeaderCount counts the \"=== ... ===\" state-log header lines in s —\n// lines that begin (at the very start, or right after a newline) with \"===\".\n// Counting occurrences of the \"===\" literal itself would overcount, since\n// each header line both opens and closes with it.\nfunc sectionHeaderCount(s string) int {\n\tn := 0\n\tfor _, line := range strings.Split(s, \"\\n\") {\n\t\tif strings.HasPrefix(line, \"===\") {\n\t\t\tn++\n\t\t}\n\t}\n\treturn n\n}\n\n// TestSectionWriterPassesThroughNonHeaders ensures a write that does not\n// begin with the \"===\" literal — e.g. an invocation's agent text or a stop\n// reason — is never prefixed, so blank lines only ever separate sections.\nfunc TestSectionWriterPassesThroughNonHeaders(t *testing.T) {\n\tvar buf bytes.Buffer\n\tw := &sectionWriter{w: &buf, wroteSection: true}\n\n\t// A reason line written straight through must not pick up a prefix.\n\tif _, err := w.Write([]byte(\"brief.md is not written yet\\n\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// A subsequent real header still gets separated from it.\n\tlogImmediateStop(w, \"brief.md is not written yet\")\n\n\tgot := buf.String()\n\tif !strings.HasPrefix(got, \"brief.md is not written yet\\n\") {\n\t\tt.Errorf(\"non-header write was not passed through verbatim, got:\\n%q\", got)\n\t}\n\tif n := strings.Count(got, \"\\n\\n\\n===\"); n != 1 {\n\t\tt.Errorf(\"got %d separators, want exactly 1 (only before the header):\\n%q\", n, got)\n\t}\n}\n\n// --- ensureSidecarIgnored ----------------------------------------------------\n//\n// Regression coverage for a bug a real end-to-end mg-jdi run (TASK-14) caught:\n// without this, an agent's own `git add -A` (run inside the container against\n// the *target project*, not manigot's own checkout) swept the status/run.log\n// sidecar straight into a real job-branch commit.\n\nfunc gitRunForOutputTest(t *testing.T, dir string, args ...string) {\n\tt.Helper()\n\tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"git %s in %s: %v\\n%s\", strings.Join(args, \" \"), dir, err, out)\n\t}\n}\n\nfunc initGitRepoForOutputTest(t *testing.T) string {\n\tt.Helper()\n\tdir := t.TempDir()\n\tgitRunForOutputTest(t, dir, \"init\", \"-q\")\n\tgitRunForOutputTest(t, dir, \"config\", \"user.email\", \"t@example.com\")\n\tgitRunForOutputTest(t, dir, \"config\", \"user.name\", \"Test\")\n\tgitRunForOutputTest(t, dir, \"config\", \"commit.gpgsign\", \"false\")\n\tif err := os.WriteFile(filepath.Join(dir, \"README\"), []byte(\"init\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgitRunForOutputTest(t, dir, \"add\", \"README\")\n\tgitRunForOutputTest(t, dir, \"commit\", \"-q\", \"-m\", \"init\")\n\treturn dir\n}\n\nfunc TestEnsureSidecarIgnoredWritesExcludeFile(t *testing.T) {\n\troot := initGitRepoForOutputTest(t)\n\n\tif err := ensureSidecarIgnored(root); err != nil {\n\t\tt.Fatalf(\"ensureSidecarIgnored: %v\", err)\n\t}\n\n\tdata, err := os.ReadFile(filepath.Join(root, \".git\", \"info\", \"exclude\"))\n\tif err != nil {\n\t\tt.Fatalf(\"reading .git/info/exclude: %v\", err)\n\t}\n\tif !strings.Contains(string(data), \".manigot/jdi-status/\") {\n\t\tt.Errorf(\".git/info/exclude = %q, want it to contain .manigot/jdi-status/\", string(data))\n\t}\n}\n\nfunc TestEnsureSidecarIgnoredIsIdempotent(t *testing.T) {\n\troot := initGitRepoForOutputTest(t)\n\n\tif err := ensureSidecarIgnored(root); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := ensureSidecarIgnored(root); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tdata, err := os.ReadFile(filepath.Join(root, \".git\", \"info\", \"exclude\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcount := strings.Count(string(data), \".manigot/jdi-status/\")\n\tif count != 1 {\n\t\tt.Errorf(\"pattern appears %d times after two calls, want exactly 1 (idempotent)\", count)\n\t}\n}\n\nfunc TestEnsureSidecarIgnoredPreservesExistingContent(t *testing.T) {\n\troot := initGitRepoForOutputTest(t)\n\texcludeDir := filepath.Join(root, \".git\", \"info\")\n\tif err := os.MkdirAll(excludeDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(excludeDir, \"exclude\"), []byte(\"*.local\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tif err := ensureSidecarIgnored(root); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tdata, err := os.ReadFile(filepath.Join(excludeDir, \"exclude\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgot := string(data)\n\tif !strings.Contains(got, \"*.local\") {\n\t\tt.Errorf(\".git/info/exclude lost its pre-existing content: %q\", got)\n\t}\n\tif !strings.Contains(got, \".manigot/jdi-status/\") {\n\t\tt.Errorf(\".git/info/exclude missing the sidecar pattern: %q\", got)\n\t}\n}\n\n// TestEnsureSidecarIgnoredActuallyWorksWithGit is the real regression test:\n// after ensureSidecarIgnored, `git add -A` inside the project must not pick\n// up the sidecar directory at all — the exact scenario the TASK-14 manual\n// run caught.\nfunc TestEnsureSidecarIgnoredActuallyWorksWithGit(t *testing.T) {\n\troot := initGitRepoForOutputTest(t)\n\tif err := ensureSidecarIgnored(root); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tsidecarFile := filepath.Join(root, \".manigot\", \"jdi-status\", \"aaaa01_x\", \"status\")\n\tif err := os.MkdirAll(filepath.Dir(sidecarFile), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(sidecarFile, []byte(\"{}\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// A normal job file, tracked as usual, to prove add -A isn't just a\n\t// no-op — it should still pick this up.\n\tjobFile := filepath.Join(root, \"docs\", \"jobs\", \"aaaa01_x\", \"tasks.md\")\n\tif err := os.MkdirAll(filepath.Dir(jobFile), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(jobFile, []byte(\"# Tasks\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tgitRunForOutputTest(t, root, \"add\", \"-A\")\n\n\tout, err := exec.Command(\"git\", \"-C\", root, \"diff\", \"--cached\", \"--name-only\").Output()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstaged := string(out)\n\tif strings.Contains(staged, \"jdi-status\") {\n\t\tt.Errorf(\"git add -A staged the sidecar despite ensureSidecarIgnored:\\n%s\", staged)\n\t}\n\tif !strings.Contains(staged, \"docs/jobs/aaaa01_x/tasks.md\") {\n\t\tt.Errorf(\"git add -A did not stage the real job file — test itself is broken:\\n%s\", staged)\n\t}\n}\n\n// --- session.log append helper (appendSessionLog) ---------------------------\n\nfunc TestAppendSessionLogCreatesOnFirstUse(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\tif err := appendSessionLog(path, \"analyst\", 1, []byte(\"Wrote tasks.md.\\n\")); err != nil {\n\t\tt.Fatalf(\"appendSessionLog: %v\", err)\n\t}\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatalf(\"reading session.log: %v\", err)\n\t}\n\tgot := string(data)\n\tif !strings.Contains(got, \"analyst (attempt 1)\") {\n\t\tt.Errorf(\"session.log = %q, want an analyst (attempt 1) header\", got)\n\t}\n\tif !strings.Contains(got, \"Wrote tasks.md.\") {\n\t\tt.Errorf(\"session.log = %q, want the raw output preserved\", got)\n\t}\n}\n\nfunc TestAppendSessionLogAppendsAcrossSections(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\tif err := appendSessionLog(path, \"analyst\", 1, []byte(\"first output\\n\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := appendSessionLog(path, \"developer\", 2, []byte(\"second output\\n\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgot := string(data)\n\tif i, j := strings.Index(got, \"analyst (attempt 1)\"), strings.Index(got, \"developer (attempt 2)\"); i == -1 || j == -1 || i > j {\n\t\tt.Errorf(\"session.log sections out of order or missing, got:\\n%s\", got)\n\t}\n\tif i, j := strings.Index(got, \"first output\"), strings.Index(got, \"second output\"); i == -1 || j == -1 || i > j {\n\t\tt.Errorf(\"session.log raw outputs out of order or missing, got:\\n%s\", got)\n\t}\n}\n\nfunc TestAppendSessionLogHeaderCarriesAgentAttemptTimestamp(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\tif err := appendSessionLog(path, \"reviewer\", 3, []byte(\"ok\\n\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// The header is the first line: \"=== <RFC3339 timestamp> <agent>\n\t// (attempt N) ===\".\n\tline, _, _ := strings.Cut(string(data), \"\\n\")\n\tif !strings.HasPrefix(line, \"=== \") || !strings.HasSuffix(line, \" reviewer (attempt 3) ===\") {\n\t\tt.Fatalf(\"header line = %q, want %q shape\", line, \"=== <timestamp> reviewer (attempt 3) ===\")\n\t}\n\tts := strings.TrimSuffix(strings.TrimPrefix(line, \"=== \"), \" reviewer (attempt 3) ===\")\n\tif _, err := time.Parse(time.RFC3339, ts); err != nil {\n\t\tt.Errorf(\"header timestamp %q is not RFC3339: %v\", ts, err)\n\t}\n}\n\nfunc TestAppendSessionLogPreservesRawVerbatim(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\traw := []byte(\"line one\\nline two\\nline three\\n\")\n\tif err := appendSessionLog(path, \"analyst\", 1, raw); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !strings.Contains(string(data), \"line one\\nline two\\nline three\\n\") {\n\t\tt.Errorf(\"session.log = %q, want the raw bytes preserved verbatim\", string(data))\n\t}\n}\n\nfunc TestAppendSessionLogSectionsSeparated(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\t// Two sections where the first's raw output deliberately lacks a\n\t// trailing newline: the blank-line separator plus the trailing-newline\n\t// guarantee must keep the second section's header from gluing to it.\n\tif err := appendSessionLog(path, \"analyst\", 1, []byte(\"no trailing newline\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := appendSessionLog(path, \"developer\", 1, []byte(\"second\\n\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgot := string(data)\n\tif !strings.Contains(got, \"no trailing newline\\n\\n=== \") {\n\t\tt.Errorf(\"sections not separated by a blank line, got:\\n%q\", got)\n\t}\n}\n\nfunc TestAppendSessionLogTrailingNewlineGuarantee(t *testing.T) {\n\t// Raw output without a trailing newline gets one appended...\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\tif err := appendSessionLog(path, \"analyst\", 1, []byte(\"no newline\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !strings.HasSuffix(string(data), \"no newline\\n\") {\n\t\tt.Errorf(\"session.log = %q, want the raw output to end with a newline\", string(data))\n\t}\n\t// ...and output that already ends with one is not double-newlined.\n\tpath2 := filepath.Join(t.TempDir(), \"session.log\")\n\tif err := appendSessionLog(path2, \"analyst\", 1, []byte(\"has newline\\n\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdata2, err := os.ReadFile(path2)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif strings.HasSuffix(string(data2), \"has newline\\n\\n\") {\n\t\tt.Errorf(\"session.log = %q, want exactly one trailing newline\", string(data2))\n\t}\n}\n\nfunc TestAppendSessionLogEmptyRawStillWritesHeader(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\tif err := appendSessionLog(path, \"analyst\", 1, nil); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif got := string(data); !strings.Contains(got, \"analyst (attempt 1)\") {\n\t\tt.Errorf(\"session.log = %q, want the header even for empty output\", got)\n\t}\n}","lineStart":1,"lineEnd":640,"totalLines":640,"truncated":false}},"title":"src/cmd/mg/jdioutput_test.go","time":{"start":1787920070658,"end":1787920070661}},"id":"prt_04857378b001v2ip378kBx9SaI","sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","messageID":"msg_048573021001WktVLmiOV1DwqT"}}
{"type":"step_finish","timestamp":1787920070752,"sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","part":{"id":"prt_04857385b001Fit65d0owTFhyP","reason":"tool-calls","snapshot":"","messageID":"msg_048573021001WktVLmiOV1DwqT","sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","type":"step-finish","tokens":{"total":81288,"input":1104,"output":56,"reasoning":0,"cache":{"write":0,"read":80128}},"cost":0.000840736}}
{"type":"step_start","timestamp":1787920072308,"sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","part":{"id":"prt_048573e73001HjuMDFbbb6kbZW","messageID":"msg_04857385f0010Mn0WuE1Pm7OYY","sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","snapshot":"","type":"step-start"}}
{"type":"tool_use","timestamp":1787920073443,"sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","part":{"type":"tool","tool":"read","callID":"call_00_rY7cj2vQPnNHY8UDMZxc4907","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/ui/app.go"},"output":"<path>/workspace/src/internal/ui/app.go</path>\n<type>file</type>\n<content>\n1: // Package ui holds the Bubble Tea models that make up the manigot TUI.\n2: //\n3: // App is the root model; it owns the discovered job list and routes between the\n4: // list view (list.go), the job detail view (detail.go) and overlays for actions.\n5: package ui\n6: \n7: import (\n8: \t\"context\"\n9: \t\"errors\"\n10: \t\"fmt\"\n11: \t\"io\"\n12: \t\"path/filepath\"\n13: \t\"strings\"\n14: \t\"time\"\n15: \n16: \ttea \"github.com/charmbracelet/bubbletea\"\n17: \t\"github.com/lmuskalla/manigot/internal/agentlist\"\n18: \t\"github.com/lmuskalla/manigot/internal/config\"\n19: \t\"github.com/lmuskalla/manigot/internal/editor\"\n20: \t\"github.com/lmuskalla/manigot/internal/git\"\n21: \t\"github.com/lmuskalla/manigot/internal/job\"\n22: \t\"github.com/lmuskalla/manigot/internal/launch\"\n23: \t\"github.com/lmuskalla/manigot/internal/project\"\n24: )\n25: \n26: // appState selects which view is active. More states (detail, form) are added\n27: // by later tasks.\n28: type appState int\n29: \n30: const (\n31: \tstateList appState = iota\n32: \tstateDetail\n33: \tstateNewJob   // \"n\" from the list — create a job via the in-process job.CreateJob\n34: \tstateSettings // \"s\" from the list — edit the persisted TUI settings\n35: \tstateAgents   // \"a\" from the list — pick and launch any agent as a jobless quick session\n36: \tstateConfirm  // \"D\" / \"delete\" / \"x\" from the detail — confirm a destructive lifecycle action\n37: \tstateGitPanel // \"g\" from the detail — pick a git command (commit all / push / merge default branch)\n38: )\n39: \n40: // App is the root Bubble Tea model.\n41: type App struct {\n42: \troot  string\n43: \tjobs  []job.Job\n44: \tstate appState\n45: \n46: \t// list is the job list view (stateList) — see list.go. It owns the\n47: \t// cursor, the recent-activity strip data, and the list rendering; App\n48: \t// feeds it the job list, settings, and cross-view state on each render.\n49: \tlist *listView\n50: \n51: \t// width / height are the viewport size, used to construct and resize the\n52: \t// overlay views (detail, new-job, settings, agents picker, confirm) and\n53: \t// passed to the list view on each render.\n54: \twidth  int\n55: \theight int\n56: \n57: \t// settings holds the persisted TUI preferences (editor, recent-activity\n58: \t// count, subscription profile). It is loaded once at startup and updated\n59: \t// in place whenever the settings form is submitted.\n60: \tsettings config.Settings\n61: \n62: \t// projectSettings holds the project-scoped conventions (base branch),\n63: \t// read from .manigot/manigot.json in the target project root. Unlike\n64: \t// settings, this file is meant to be committed and shared across a\n65: \t// team — it travels with the project, not the user. Loaded once at\n66: \t// startup and updated in place whenever the settings form is submitted.\n67: \tprojectSettings project.Settings\n68: \n69: \t// detail is non-nil while state == stateDetail.\n70: \tdetail *detailView\n71: \n72: \t// newJob is non-nil while state == stateNewJob.\n73: \tnewJob *newJobView\n74: \n75: \t// settingsView is non-nil while state == stateSettings.\n76: \tsettingsView *settingsView\n77: \n78: \t// agentsPicker is non-nil while state == stateAgents.\n79: \tagentsPicker *agentsPickerView\n80: \n81: \t// confirm is non-nil while state == stateConfirm — the destructive-action\n82: \t// confirmation for \"D\" (mark done) and \"delete\"/\"x\" (delete).\n83: \tconfirm *confirmView\n84: \n85: \t// gitPanel is non-nil while state == stateGitPanel — the \"g\" git-command\n86: \t// picker over the detail view (commit all / push to origin / merge\n87: \t// default branch).\n88: \tgitPanel *gitPanelView\n89: \n90: \t// status is a transient one-line message shown in the footer (e.g. after\n91: \t// running mg-job or an agent).\n92: \tstatus string\n93: \n94: \t// statusUntil is when the current list status blinks then clears — see\n95: \t// statusExpireMsg. statusBlinkOn toggles the list footer's *rendered*\n96: \t// visibility during the blink window immediately before statusUntil; the\n97: \t// underlying status text stays set throughout the blink (statusVisible\n98: \t// decides rendering, so footer layout never jitters mid-blink).\n99: \tstatusUntil   time.Time\n100: \tstatusBlinkOn bool\n101: \n102: \t// statusExpiryTicking guards the status-expiry tick chain: true while a\n103: \t// statusExpireMsg is scheduled or in flight, so no second concurrent\n104: \t// chain can be started (armStatusExpiry is a no-op while it's set).\n105: \t// Cleared by the tick handler itself the moment no status remains on\n106: \t// either surface — the chain self-terminates (one of the two narrow\n107: \t// self-terminating exceptions), leaving the permanent auto-refresh tick\n108: \t// as the app's one always-running timer.\n109: \tstatusExpiryTicking bool\n110: \n111: \t// jdiSeen tracks, per job Name, the last job.JDIState observed for that\n112: \t// job's mg-jdi status sidecar — the TUI's own stop-notification dedup. The very first observation of any given job\n113: \t// (no prior entry) always just seeds this map rather than ringing the\n114: \t// bell, even if that first-seen status is already stopped: a restarted\n115: \t// TUI re-observing an already-stopped job isn't a new event worth\n116: \t// alerting on. Reset (empty) on every TUI restart — in-memory only, no\n117: \t// new event-streaming subsystem or persisted state.\n118: \t//\n119: \t// jdiAlreadyRunning's launch-block guard also falls back to this same\n120: \t// map when no on-disk sidecar exists yet — see jdiSeenAt below for why that fallback has its\n121: \t// own expiry, independent of this dedup's own (unrelated) purpose.\n122: \tjdiSeen map[string]job.JDIState\n123: \n124: \t// jdiSeenAt records when each jdiSeen entry was last written, so\n125: \t// jdiAlreadyRunning's fallback to jdiSeen (used only while no on-disk\n126: \t// sidecar exists) can expire it after jdiSeenFallbackTTL rather than\n127: \t// trusting it forever. Without this, a \"j\" press whose mg-jdi process\n128: \t// then crashed or was killed before ever writing its first status file\n129: \t// left a JDIRunning entry in jdiSeen with nothing to ever clear it —\n130: \t// permanently blocking a re-launch for the rest of the TUI session, with\n131: \t// no visible indicator anywhere (the sidecar-driven badges correctly show\n132: \t// nothing running) explaining why. Keyed the same as jdiSeen.\n133: \tjdiSeenAt map[string]time.Time\n134: \n135: \t// spinnerStep is the current activity-indicator frame index (see\n136: \t// activity.go), advanced once per spinnerTickMsg while any mg-jdi run is\n137: \t// active. Threaded into the running badges (jdiStatusBadge) and into the\n138: \t// open detail view (detailView.spinnerStep) so both the list row and the\n139: \t// action-bar badge animate off the same counter. 0 (the zero value) is\n140: \t// the first frame; nothing special about it.\n141: \tspinnerStep int\n142: \n143: \t// spinnerTicking guards the activity-indicator tick chain: true while a\n144: \t// spinnerTickMsg is scheduled or in flight, so no second concurrent chain\n145: \t// can be started (startSpinnerIfRunning is a no-op while it's set). Cleared\n146: \t// by the tick handler itself the moment no job is running any more — the\n147: \t// chain self-terminates (one of the two narrow self-terminating\n148: \t// exceptions), so a run ending is all it takes to stop the redraws,\n149: \t// leaving the permanent auto-refresh tick as the app's one always-running\n150: \t// timer.\n151: \tspinnerTicking bool\n152: \n153: \t// autoRefreshTicking guards the auto-refresh tick chain: true while an\n154: \t// autoRefreshMsg is scheduled or in flight, so no second concurrent chain\n155: \t// can be started (startAutoRefresh is a no-op while it's set). Unlike the\n156: \t// spinner/status guards this one is never cleared — the chain is\n157: \t// permanent, re-armed by the tick handler itself for the app's whole\n158: \t// lifetime — so once set it stays set.\n159: \tautoRefreshTicking bool\n160: }\n161: \n162: // spinnerTickMsg advances the activity indicator one frame. It is one of the\n163: // app's three timer-driven messages — alongside statusExpireMsg and the\n164: // permanent autoRefreshMsg — and, together with statusExpireMsg, one of the\n165: // two narrow *self-terminating* exceptions to \"no separate timer-driven\n166: // tick\" (see pollJDIBell's doc, and the README's \"mg jdi status & log\"\n167: // section): a ~activityInterval redraw that exists only while an mg-jdi run\n168: // is active, so a watched run visibly indicates it's alive instead of\n169: // sitting as a static badge. Unlike autoRefreshMsg, the chain stops itself\n170: // the moment the run ends.\n171: type spinnerTickMsg struct{}\n172: \n173: // statusExpireMsg drives the blink-then-clear of transient status messages\n174: // (the list footer's status and the detail footer's status). It is one of\n175: // the app's three timer-driven messages — alongside spinnerTickMsg and the\n176: // permanent autoRefreshMsg — and, together with spinnerTickMsg, one of the\n177: // two narrow *self-terminating* exceptions to \"no separate timer-driven\n178: // tick\": a ~statusBlinkInterval redraw that exists only while a status is\n179: // set, so a transient status blinks a few times then disappears instead of\n180: // persisting forever (see armStatusExpiry and its Update handler). Unlike\n181: // autoRefreshMsg, the chain stops itself the moment no status remains.\n182: type statusExpireMsg struct{}\n183: \n184: // autoRefreshMsg drives the app's permanent auto-refresh timer: a\n185: // ~autoRefreshInterval tick that re-reads everything ctrl+r reads (job list,\n186: // project settings, open detail view, git-log strip) so a TUI left sitting\n187: // in a tmux pane catches up on its own — the brief's \"get back to a mg tui\n188: // session and see what's happened\" without a manual refresh. Unlike\n189: // spinnerTickMsg and statusExpireMsg it is not a narrow, self-terminating\n190: // exception: the chain is started once by Init (via startAutoRefresh) and\n191: // re-armed by the tick handler for the app's whole lifetime. See\n192: // autoRefreshMsg's Update handler for the state gating.\n193: type autoRefreshMsg struct{}\n194: \n195: // hostGitTimeout bounds the TUI's background git cmds (push-to-origin, the\n196: // auto-commit after a brief.md edit). These run off the UI goroutine, so an\n197: // unbounded git call — most realistically a stalled network push — would hang\n198: // the app's command channel forever (GIT_TERMINAL_PROMPT=0 covers only the\n199: // credential case). The interactive session and mg done/mg delete keep no\n200: // timeout: the user is waiting on git there. The mg-jdi probes use their own,\n201: // shorter timeout (see cmd/mg/jdi.go).\n202: const hostGitTimeout = 30 * time.Second\n203: \n204: // jdiSeenFallbackTTL bounds how long jdiAlreadyRunning trusts a jdiSeen\n205: // JDIRunning entry that has no corroborating on-disk sidecar file at all.\n206: // It exists to bridge the real race this fallback is for — the gap between\n207: // launch.Jdi's Start() returning and mg-jdi's own first WriteJDIStatus call,\n208: // which happens before mg-jdi invokes its first agent, so\n209: // normally within seconds (a git checkout, not a full agent run) — while\n210: // still being short enough that a launch whose mg-jdi process crashed or was\n211: // killed before ever writing that first status file recovers on its own\n212: // within the same TUI session, rather than requiring a restart. Deliberately\n213: // much shorter than jdiRunningStaleAfter (job.ReadJDIStatus's own 30-minute\n214: // staleness window for a sidecar file that *does* exist): that window has to\n215: // stay generous enough not to mistake one long agent call for a killed\n216: // process, but this one only has to survive process startup, not an entire\n217: // agent invocation.\n218: const jdiSeenFallbackTTL = 2 * time.Minute\n219: \n220: // jdiNow is time.Now, indirected so tests can simulate the passage of time\n221: // for jdiSeenFallbackTTL without an actual sleep.\n222: var jdiNow = time.Now\n223: \n224: // statusNow is time.Now, indirected so tests can simulate the passage of time\n225: // for the status blink/expiry state machine without an actual sleep.\n226: var statusNow = time.Now\n227: \n228: // NewApp builds the root model from a discovered job list. Settings are\n229: // loaded from disk (see config.Load); a load failure (e.g. a corrupt\n230: // tui-settings.json) is non-fatal — the app starts with default settings and\n231: // surfaces the error in the footer instead.\n232: func NewApp(root string, jobs []job.Job) *App {\n233: \ta := &App{root: root, jobs: jobs, state: stateList, list: newListView(root), jdiSeen: map[string]job.JDIState{}, jdiSeenAt: map[string]time.Time{}}\n234: \tsettings, err := config.Load()\n235: \ta.settings = settings\n236: \tif err != nil {\n237: \t\t// A startup config-load error is a transient status like any other:\n238: \t\t// it blinks then clears. The arming cmd is discarded here (NewApp\n239: \t\t// returns no cmd) — Init re-arms via armStatusExpiry.\n240: \t\ta.setStatus(cmdErrorText(err))\n241: \t}\n242: \ta.list.currentBranch, _ = git.CurrentBranch(root) // \"\" on detached HEAD / non-repo\n243: \t// Settings must be loaded before the initial recent-commits fetch so the\n244: \t// strip honors the configured maximum count on the very first render —\n245: \t// not just after the first settings submit.\n246: \ta.refreshRecentCommits()\n247: \t// Project settings (base branch) live in the target project, not the\n248: \t// manigot checkout, so a missing file is the normal pre-first-save state\n249: \t// and project.Load already degrades it to a zero value — only a real I/O\n250: \t// or parse error surfaces here. Append rather than overwrite a config\n251: \t// load error so both can be seen.\n252: \tprojSettings, perr := project.Load(root)\n253: \ta.projectSettings = projSettings\n254: \tif perr != nil {\n255: \t\tif a.status != \"\" {\n256: \t\t\ta.setStatus(a.status + \" · \" + cmdErrorText(perr))\n257: \t\t} else {\n258: \t\t\ta.setStatus(cmdErrorText(perr))\n259: \t\t}\n260: \t}\n261: \treturn a\n262: }\n263: \n264: // Init starts the program. No initial commands are needed — except the\n265: // activity-indicator tick chain when an mg-jdi run is already active at\n266: // startup (startSpinnerIfRunning, so a TUI opened mid-run animates its badge\n267: // without waiting for a keypress or refresh), the status-expiry chain when\n268: // a startup status was set in NewApp (armStatusExpiry, so a config-load error\n269: // surfaced in the footer blinks then clears like any other transient status),\n270: // and the permanent auto-refresh chain (startAutoRefresh, so the TUI re-reads\n271: // state from disk on its own from the very first second instead of only on\n272: // discrete events). The first two are no-ops (nil) when there is nothing to\n273: // animate, and tea.Batch drops those nils; the auto-refresh chain always\n274: // starts and never stops.\n275: func (a *App) Init() tea.Cmd {\n276: \treturn tea.Batch(a.startSpinnerIfRunning(), a.armStatusExpiry(), a.startAutoRefresh())\n277: }\n278: \n279: // editorDoneMsg reports the outcome of the \"e\" edit-shortcut's tea.ExecProcess\n280: // once the suspended editor process returns.\n281: type editorDoneMsg struct {\n282: \tpath string\n283: \terr  error\n284: }\n285: \n286: // doneMsg reports the outcome of the \"D\" mark-done shortcut's background\n287: // job.FinishJob run once it returns.\n288: type doneMsg struct {\n289: \terr error\n290: }\n291: \n292: // deleteMsg reports the outcome of the \"delete\" shortcut's background\n293: // job.DeleteJob run once it returns.\n294: type deleteMsg struct {\n295: \terr error\n296: }\n297: \n298: // commitMsg reports the outcome of the auto-commit that follows a successful\n299: // brief.md edit (see editorDoneMsg and commitBriefCmd).\n300: type commitMsg struct {\n301: \terr error\n302: }\n303: \n304: // pushMsg reports the outcome of the detail view's \"P\" push-to-origin\n305: // action (a `git push -u origin <branch>`, run off the UI thread via\n306: // pushCmd so a slow/blocked network call doesn't block rendering).\n307: type pushMsg struct {\n308: \tbranch string\n309: \terr    error\n310: }\n311: \n312: // commitAllMsg reports the outcome of the detail view's \"c\" commit-all\n313: // action (a `git add -A` + `git commit` in the job's own worktree, run off\n314: // the UI thread via commitAllCmd so a slow git call doesn't block\n315: // rendering). err is git.ErrNothingToCommit when the worktree had no\n316: // changes — a distinct, non-failure outcome the Update handler reports as\n317: // \"nothing to commit\" rather than an error.\n318: type commitAllMsg struct {\n319: \terr error\n320: }\n321: \n322: // mergeMsg reports the outcome of the detail view's \"merge default branch\"\n323: // action (a `git merge --no-edit <base>` run in the job's own worktree, off\n324: // the UI thread via mergeCmd so a slow git call doesn't block rendering).\n325: // base names the resolved base branch the merge ran against, for the success\n326: // status line; err is non-nil on any git failure (a dirty worktree git\n327: // refuses, a conflict leaves the tree in the conflicted state for the user\n328: // to resolve manually — both surface as ordinary status errors).\n329: type mergeMsg struct {\n330: \tbase string\n331: \terr  error\n332: }\n333: \n334: // Update handles window resizing and routes key presses to the active view.\n335: func (a *App) Update(msg tea.Msg) (tea.Model, tea.Cmd) {\n336: \tswitch msg := msg.(type) {\n337: \tcase tea.WindowSizeMsg:\n338: \t\tw, h := msg.Width-2*uiPaddingX, msg.Height-2*uiPaddingY\n339: \t\tif w < 1 {\n340: \t\t\tw = 1\n341: \t\t}\n342: \t\tif h < 1 {\n343: \t\t\th = 1\n344: \t\t}\n345: \t\ta.width, a.height = w, h\n346: \t\tif a.detail != nil {\n347: \t\t\ta.detail.resize(a.width, a.height)\n348: \t\t}\n349: \t\tif a.newJob != nil {\n350: \t\t\ta.newJob.resize(a.width, a.height)\n351: \t\t}\n352: \t\tif a.settingsView != nil {\n353: \t\t\ta.settingsView.resize(a.width, a.height)\n354: \t\t}\n355: \t\tif a.agentsPicker != nil {\n356: \t\t\ta.agentsPicker.resize(a.width, a.height)\n357: \t\t}\n358: \t\tif a.confirm != nil {\n359: \t\t\ta.confirm.resize(a.width, a.height)\n360: \t\t}\n361: \t\tif a.gitPanel != nil {\n362: \t\t\ta.gitPanel.resize(a.width, a.height)\n363: \t\t}\n364: \t\treturn a, nil\n365: \tcase editorDoneMsg:\n366: \t\tif a.detail != nil {\n367: \t\t\tif msg.err != nil {\n368: \t\t\t\ta.detail.setStatus(cmdErrorText(msg.err))\n369: \t\t\t} else {\n370: \t\t\t\ta.detail.reloadCurrent()\n371: \t\t\t\ta.detail.setStatus(\"edited \" + filepath.Base(msg.path))\n372: \t\t\t\t// brief.md is the one editable tab (jobFiles) and the one\n373: \t\t\t\t// file the job workflow expects to always be committed —\n374: \t\t\t\t// auto-commit it so an edit never lingers as an uncommitted\n375: \t\t\t\t// change the way finish-job.sh's clean-tree check would\n376: \t\t\t\t// otherwise reject. Any other future editable tab is left\n377: \t\t\t\t// alone, same as before this behavior existed.\n378: \t\t\t\tif filepath.Base(msg.path) == \"brief.md\" {\n379: \t\t\t\t\treturn a, tea.Batch(a.commitBriefCmd(), a.armStatusExpiry())\n380: \t\t\t\t}\n381: \t\t\t}\n382: \t\t}\n383: \t\treturn a, a.armStatusExpiry()\n384: \tcase commitMsg:\n385: \t\tif a.detail != nil {\n386: \t\t\tif msg.err != nil {\n387: \t\t\t\ta.detail.setStatus(cmdErrorText(msg.err))\n388: \t\t\t} else {\n389: \t\t\t\ta.detail.setStatus(\"edited and committed brief.md\")\n390: \t\t\t}\n391: \t\t}\n392: \t\treturn a, a.armStatusExpiry()\n393: \tcase doneMsg:\n394: \t\t// The lifecycle outcome is not a reliable done signal: a declined\n395: \t\t// confirmation (ErrCancelled) and a real failure both carry an error,\n396: \t\t// while a successful archive carries none — and a declined-but-kept\n397: \t\t// job looks identical to an archived one from the error alone. So\n398: \t\t// regardless of msg.err, always fall back to refreshing the job list\n399: \t\t// from disk and returning to it — a job that got archived is simply\n400: \t\t// gone from the re-read list, one that was declined or failed is\n401: \t\t// still there. An error still surfaces through cmdErrorText first,\n402: \t\t// same as any other host-command failure.\n403: \t\tspinnerCmd := a.refreshJobs()\n404: \t\ta.detail = nil\n405: \t\ta.state = stateList\n406: \t\tif msg.err != nil {\n407: \t\t\t// A merge failure handed to @git-solver is not an error — the\n408: \t\t\t// TUI's pre-approved confirmations always accept the handoff, so\n409: \t\t\t// this is the common conflicted-merge outcome. The git-solver\n410: \t\t\t// session was opened detached (launch.HostAgent); the job stays\n411: \t\t\t// in the list until it finishes the cleanup.\n412: \t\t\tif errors.Is(msg.err, job.ErrGitSolverHandoff) {\n413: \t\t\t\treturn a, tea.Batch(spinnerCmd, a.setStatus(\"handed off to @git-solver — resolving the merge in the opened session\"))\n414: \t\t\t}\n415: \t\t\treturn a, tea.Batch(spinnerCmd, a.setStatus(cmdErrorText(msg.err)))\n416: \t\t}\n417: \t\treturn a, tea.Batch(spinnerCmd, a.setStatus(\"refreshed\"))\n418: \tcase deleteMsg:\n419: \t\t// Same reasoning as doneMsg: a declined delete (ErrCancelled) leaves\n420: \t\t// the job present in the re-read list — refreshJobs and returning to\n421: \t\t// the list handles both outcomes uniformly.\n422: \t\tspinnerCmd := a.refreshJobs()\n423: \t\ta.detail = nil\n424: \t\ta.state = stateList\n425: \t\tif msg.err != nil {\n426: \t\t\treturn a, tea.Batch(spinnerCmd, a.setStatus(cmdErrorText(msg.err)))\n427: \t\t}\n428: \t\treturn a, tea.Batch(spinnerCmd, a.setStatus(\"refreshed\"))\n429: \tcase pushMsg:\n430: \t\t// A push never changes what the working tree or job list looks\n431: \t\t// like — only origin's state — so there is nothing to refresh or\n432: \t\t// rebuild here, just a status line.\n433: \t\tif a.detail != nil {\n434: \t\t\tif msg.err != nil {\n435: \t\t\t\ta.detail.setStatus(cmdErrorText(msg.err))\n436: \t\t\t} else {\n437: \t\t\t\ta.detail.setStatus(\"→ pushed \" + msg.branch + \" to origin\")\n438: \t\t\t}\n439: \t\t}\n440: \t\treturn a, a.armStatusExpiry()\n441: \tcase commitAllMsg:\n442: \t\tif a.detail != nil {\n443: \t\t\tswitch {\n444: \t\t\tcase msg.err == nil:\n445: \t\t\t\ta.detail.setStatus(\"→ committed all changes\")\n446: \t\t\t\t// Unlike a push, a commit does change what the detail view\n447: \t\t\t\t// shows: the bottom git-log strip (refreshCommits) and the\n448: \t\t\t\t// computed diff tab (recomputed by reload via loadTabs).\n449: \t\t\t\t// Refresh both so the new commit appears immediately\n450: \t\t\t\t// instead of on the next refresh (auto or ctrl+r).\n451: \t\t\t\ta.detail.reload()\n452: \t\t\t\ta.detail.refreshCommits(a.settings.RecentActivityCountValue())\n453: \t\t\tcase errors.Is(msg.err, git.ErrNothingToCommit):\n454: \t\t\t\t// Distinct non-failure outcome: the worktree was already\n455: \t\t\t\t// clean, so report that plainly rather than as an error.\n456: \t\t\t\ta.detail.setStatus(\"nothing to commit\")\n457: \t\t\tdefault:\n458: \t\t\t\ta.detail.setStatus(cmdErrorText(msg.err))\n459: \t\t\t}\n460: \t\t}\n461: \t\treturn a, a.armStatusExpiry()\n462: \tcase mergeMsg:\n463: \t\t// A merge changes what the detail view shows exactly like a commit\n464: \t\t// does — the job branch moved, so the bottom git-log strip\n465: \t\t// (refreshCommits) and the computed diff tab (reload via loadTabs)\n466: \t\t// both need rebuilding. A conflict or a dirty-worktree refusal\n467: \t\t// surfaces as a plain status error; the tree is left as git put it\n468: \t\t// for the user to resolve manually.\n469: \t\tif a.detail != nil {\n470: \t\t\tif msg.err != nil {\n471: \t\t\t\ta.detail.setStatus(cmdErrorText(msg.err))\n472: \t\t\t} else {\n473: \t\t\t\ta.detail.setStatus(\"→ merged \" + msg.base + \" into \" + a.detail.job.Branch)\n474: \t\t\t\ta.detail.reload()\n475: \t\t\t\ta.detail.refreshCommits(a.settings.RecentActivityCountValue())\n476: \t\t\t}\n477: \t\t}\n478: \t\treturn a, a.armStatusExpiry()\n479: \tcase spinnerTickMsg:\n480: \t\t// Advance the activity indicator. The step always moves (even on the\n481: \t\t// tick that observes the run has ended — the check below happens\n482: \t\t// after), but the chain only continues while a job is actually\n483: \t\t// running: the moment every sidecar has flipped to a stopped state\n484: \t\t// (or the in-session jdiSeen fallback expired), return nil and clear\n485: \t\t// the guard so no further timer-driven redraws happen. The guard is\n486: \t\t// (re)asserted on the continuing path too, not just by\n487: \t\t// startSpinnerIfRunning, so \"guard set\" stays equivalent to \"chain\n488: \t\t// alive\" no matter how a tick reached the handler.\n489: \t\ta.spinnerStep++\n490: \t\tif a.detail != nil {\n491: \t\t\ta.detail.spinnerStep = a.spinnerStep\n492: \t\t}\n493: \t\tif !a.anyJDIRunning() {\n494: \t\t\ta.spinnerTicking = false\n495: \t\t\treturn a, nil\n496: \t\t}\n497: \t\ta.spinnerTicking = true\n498: \t\treturn a, a.spinnerTickCmd()\n499: \tcase statusExpireMsg:\n500: \t\t// Blink-then-clear state machine for transient statuses. Each tick\n501: \t\t// (statusBlinkInterval) toggles the rendered visibility of any status\n502: \t\t// that has entered its blink window (the statusBlinkWindow right\n503: \t\t// before its deadline), and clears the status text entirely once past\n504: \t\t// the deadline. The underlying text stays set during the blink (only\n505: \t\t// statusBlinkOn toggles), so footer layout — footerLines()/bodyHeight()\n506: \t\t// on the detail surface — never jitters mid-blink; only at final\n507: \t\t// expiry is the text cleared. The chain self-terminates (returns nil\n508: \t\t// and clears the guard) the moment no status remains on either\n509: \t\t// surface — one of the two narrow self-terminating exceptions,\n510: \t\t// leaving the permanent auto-refresh tick as the app's one\n511: \t\t// always-running timer.\n512: \t\tnow := statusNow()\n513: \t\tif a.status != \"\" {\n514: \t\t\tif !now.Before(a.statusUntil) {\n515: \t\t\t\ta.status = \"\"\n516: \t\t\t\ta.statusBlinkOn = false\n517: \t\t\t} else if now.After(a.statusUntil.Add(-statusBlinkWindow)) {\n518: \t\t\t\ta.statusBlinkOn = !a.statusBlinkOn\n519: \t\t\t}\n520: \t\t}\n521: \t\tif a.detail != nil && a.detail.status != \"\" {\n522: \t\t\tif !now.Before(a.detail.statusUntil) {\n523: \t\t\t\ta.detail.status = \"\"\n524: \t\t\t\ta.detail.statusBlinkOn = false\n525: \t\t\t\t// Clearing the text shrinks the footer back to one line, so\n526: \t\t\t\t// resize the body viewers to reclaim the freed rows (the same\n527: \t\t\t\t// thing setStatus(\"\") does on navigation).\n528: \t\t\t\ta.detail.syncViewerSize()\n529: \t\t\t} else if now.After(a.detail.statusUntil.Add(-statusBlinkWindow)) {\n530: \t\t\t\ta.detail.statusBlinkOn = !a.detail.statusBlinkOn\n531: \t\t\t}\n532: \t\t}\n533: \t\tif a.status == \"\" && (a.detail == nil || a.detail.status == \"\") {\n534: \t\t\ta.statusExpiryTicking = false\n535: \t\t\treturn a, nil\n536: \t\t}\n537: \t\treturn a, a.statusExpireCmd()\n538: \tcase autoRefreshMsg:\n539: \t\t// The app's permanent auto-refresh tick: re-read everything ctrl+r\n540: \t\t// reads (job list, project settings, open detail view, git-log strip)\n541: \t\t// so a TUI left sitting in a tmux pane catches up on its own — the\n542: \t\t// brief's \"came back to the TUI and want to see what happened\"\n543: \t\t// outcome, with the jdi stop-bell (pollJDIBell, via refreshJobs)\n544: \t\t// riding along for free. Deliberately silent: no status line, unlike\n545: \t\t// ctrl+r's \"refreshed · N job(s)\" — a footer status every second\n546: \t\t// would blink constantly and drown out real feedback.\n547: \t\t//\n548: \t\t// State gating: refresh() is skipped in the form/overlay states\n549: \t\t// (stateNewJob, stateSettings, stateAgents, stateConfirm,\n550: \t\t// stateGitPanel), where reloading the list or the detail view under\n551: \t\t// an open form/picker/confirmation would be disruptive; the chain\n552: \t\t// itself keeps ticking regardless, so a single chain lives for the\n553: \t\t// app's lifetime. The spinner cmd refresh produced is propagated the\n554: \t\t// way ctrl+r propagates it (a tick is a discovery point for runs\n555: \t\t// started outside this session), and the chain always re-arms.\n556: \t\tswitch a.state {\n557: \t\tcase stateList, stateDetail:\n558: \t\t\tspinnerCmd := a.refresh()\n559: \t\t\treturn a, tea.Batch(spinnerCmd, a.autoRefreshCmd())\n560: \t\tdefault:\n561: \t\t\treturn a, a.autoRefreshCmd()\n562: \t\t}\n563: \tcase tea.KeyMsg:\n564: \t\t// Global keys handled in every state.\n565: \t\tswitch msg.String() {\n566: \t\tcase \"ctrl+c\":\n567: \t\t\treturn a, tea.Quit\n568: \t\t}\n569: \t\tswitch a.state {\n570: \t\tcase stateList:\n571: \t\t\treturn a.updateList(msg)\n572: \t\tcase stateDetail:\n573: \t\t\treturn a.updateDetail(msg)\n574: \t\tcase stateNewJob:\n575: \t\t\treturn a.updateNewJob(msg)\n576: \t\tcase stateSettings:\n577: \t\t\treturn a.updateSettings(msg)\n578: \t\tcase stateAgents:\n579: \t\t\treturn a.updateAgentsPicker(msg)\n580: \t\tcase stateConfirm:\n581: \t\t\treturn a.updateConfirm(msg)\n582: \t\tcase stateGitPanel:\n583: \t\t\treturn a.updateGitPanel(msg)\n584: \t\t}\n585: \t}\n586: \treturn a, nil\n587: }\n588: \n589: // View renders the active view, padded out to the terminal edge — see\n590: // uiPaddingStyle.\n591: func (a *App) View() string {\n592: \tvar content string\n593: \tswitch a.state {\n594: \tcase stateDetail:\n595: \t\tcontent = a.detail.render()\n596: \tcase stateNewJob:\n597: \t\tcontent = a.newJob.render()\n598: \tcase stateSettings:\n599: \t\tcontent = a.settingsView.render()\n600: \tcase stateAgents:\n601: \t\tcontent = a.agentsPicker.render()\n602: \tcase stateConfirm:\n603: \t\tcontent = a.confirm.render()\n604: \tcase stateGitPanel:\n605: \t\tcontent = a.gitPanelOverlay()\n606: \tdefault:\n607: \t\tcontent = a.list.render(a.jobs, a.status, a.statusVisible(), a.settings.RecentActivityCountValue(), a.spinnerStep, a.width, a.height)\n608: \t}\n609: \treturn uiPaddingStyle.Render(content)\n610: }\n611: \n612: // refreshRecentCommits re-reads the recent-activity strip from git, always\n613: // fetching up to the configured maximum (Settings.RecentActivityCountValue).\n614: // How many of those cached commits actually get rendered is decided later, at\n615: // render time, by listView.recentActivityShown — not here. This split matters\n616: // because refreshRecentCommits runs before the first tea.WindowSizeMsg ever\n617: // arrives (see NewApp), when the viewport size is still zero; sizing the\n618: // *fetch* against that would size against a stale terminal height on first\n619: // render. Fetching the configured maximum and deciding the display count at\n620: // render time (once layout is known) avoids that hazard.\n621: //\n622: // Like currentBranch, an error (e.g. a non-repo project) degrades to an empty\n623: // strip rather than surfacing in the status line — this is decorative,\n624: // optional header content, not an action the user asked for.\n625: func (a *App) refreshRecentCommits() {\n626: \tcommits, err := git.RecentCommits(a.root, a.settings.RecentActivityCountValue())\n627: \tif err != nil {\n628: \t\ta.list.recentCommits = nil\n629: \t\treturn\n630: \t}\n631: \ta.list.recentCommits = commits\n632: }\n633: \n634: // clamp bounds n to [lo, hi].\n635: func clamp(n, lo, hi int) int {\n636: \tif n < lo {\n637: \t\treturn lo\n638: \t}\n639: \tif n > hi {\n640: \t\treturn hi\n641: \t}\n642: \treturn n\n643: }\n644: \n645: // refreshJobs re-reads the job list from disk (job.Discover: one os.ReadDir\n646: // plus one small brief.md read per job) and clamps the cursor so a job that\n647: // was archived mid-session doesn't leave it out of range. It does not touch\n648: // an open detail view — see refresh for that, and updateDetail's\n649: // \"esc\"/\"backspace\" case, which uses refreshJobs alone because the detail\n650: // view it would otherwise reload is about to be discarded anyway.\n651: //\n652: // It also returns the activity-indicator tick cmd when a refresh just\n653: // (re)discovered an mg-jdi run while the tick chain wasn't already going\n654: // (startSpinnerIfRunning) — the \"run started somewhere other than this\n655: // session's 'j' key\" path, e.g. ctrl+r picking up a run another TUI or a\n656: // direct mg-jdi launch started. Callers propagate the cmd; the spinnerTicking\n657: // guard makes it a no-op (nil) when the chain is already live.\n658: func (a *App) refreshJobs() tea.Cmd {\n659: \tif jobs, err := job.Discover(a.root); err == nil {\n660: \t\ta.jobs = jobs\n661: \t}\n662: \ta.list.currentBranch, _ = git.CurrentBranch(a.root) // \"\" on detached HEAD / non-repo\n663: \ta.refreshRecentCommits()\n664: \tif a.list.cursor > 0 && a.list.cursor >= len(a.jobs) {\n665: \t\ta.list.cursor = len(a.jobs) - 1\n666: \t}\n667: \tif a.list.cursor < 0 {\n668: \t\ta.list.cursor = 0\n669: \t}\n670: \ta.pollJDIBell()\n671: \treturn a.startSpinnerIfRunning()\n672: }\n673: \n674: // pollJDIBell is the TUI-side half of the stop notification: a TUI-launched\n675: // mg-jdi run has no terminal of its own to\n676: // ring `\\a` into (see cmd/mg/jdi.go's own CLI-path bell), so instead the TUI\n677: // rings it on its own next poll — this function, called from refreshJobs,\n678: // which is every \"poll tick\" this app has (ctrl+r, the permanent\n679: // auto-refresh tick, returning to list, a checkout, etc.) — the first time\n680: // it observes a job's status transition into a stopped:* state it hadn't\n681: // already notified for. The two narrow exceptions to \"refresh-triggered\n682: // polling only\" are the activity indicator's spinnerTickMsg and the\n683: // status-expiry statusExpireMsg: self-terminating timer-driven redraws that\n684: // run only while an mg-jdi run is active / a status is set (see\n685: // spinnerTickMsg's doc), deliberately kept out of the notification path — a\n686: // run stopping is exactly when the spinner timer ends.\n687: //\n688: // Dedup is in-memory (a.jdiSeen) and keyed by job Name: the first\n689: // observation of any given job only seeds the map, never rings, even if\n690: // that first-seen status is already a stopped:* one — a freshly (re)started\n691: // TUI re-observing a job that was already stopped before it started\n692: // watching isn't a new event. A later transition away from stopped back to\n693: // running (a fresh mg-jdi run against the same job) and then stopped again\n694: // rings a second time, since the intervening JDIRunning observation clears\n695: // the \"already notified for this stop\" condition.\n696: func (a *App) pollJDIBell() {\n697: \tfor _, j := range a.jobs {\n698: \t\tst, ok := job.ReadJDIStatus(a.root, j.Name)\n699: \t\tif !ok {\n700: \t\t\tcontinue\n701: \t\t}\n702: \t\tprev, seen := a.jdiSeen[j.Name]\n703: \t\ta.jdiSeen[j.Name] = st.State\n704: \t\ta.jdiSeenAt[j.Name] = jdiNow()\n705: \t\tif !seen {\n706: \t\t\tcontinue\n707: \t\t}\n708: \t\tif isJDIStopped(st.State) && prev != st.State {\n709: \t\t\tringBell()\n710: \t\t}\n711: \t}\n712: }\n713: \n714: // isJDIStopped reports whether s is one of the two terminal mg-jdi states.\n715: func isJDIStopped(s job.JDIState) bool {\n716: \treturn s == job.JDIStoppedFinished || s == job.JDIStoppedNeedsHuman\n717: }\n718: \n719: // jdiAlreadyRunning reports whether j already has an mg-jdi run in progress,\n720: // for the \"j\" key's launch-block guard. The on-disk sidecar (job.ReadJDIStatus) is the source\n721: // of truth once mg-jdi has written it — a JDIStoppedFinished/\n722: // JDIStoppedNeedsHuman status there always wins, even if a.jdiSeen still\n723: // remembers this same session having launched it earlier, so a job is never\n724: // permanently blocked after mg-jdi actually stops.\n725: //\n726: // The gap the sidecar alone can't cover is the brief moment between\n727: // launch.Jdi's Start() returning and mg-jdi's own first WriteJDIStatus call\n728: // (see job/jdistatus.go): nothing has been written yet, so\n729: // job.ReadJDIStatus reports ok=false. Only in that no-sidecar-yet case does\n730: // this fall back to a.jdiSeen, which updateDetail's \"j\" handler itself seeds\n731: // to job.JDIRunning the instant launch.Jdi succeeds — catching a second\n732: // press that lands in that same narrow window. That fallback entry is only\n733: // trusted for jdiSeenFallbackTTL (see its own doc): once it's older than\n734: // that, mg-jdi almost certainly crashed or was killed before ever writing a\n735: // sidecar, and this reports \"not running\" rather than blocking forever.\n736: func (a *App) jdiAlreadyRunning(j job.Job) (job.JDIStatus, bool) {\n737: \tif st, ok := job.ReadJDIStatus(a.root, j.Name); ok {\n738: \t\treturn st, st.State == job.JDIRunning\n739: \t}\n740: \tif a.jdiSeen[j.Name] == job.JDIRunning && jdiNow().Sub(a.jdiSeenAt[j.Name]) <= jdiSeenFallbackTTL {\n741: \t\treturn job.JDIStatus{State: job.JDIRunning}, true\n742: \t}\n743: \treturn job.JDIStatus{}, false\n744: }\n745: \n746: // anyJDIRunning reports whether any job in the current list has an mg-jdi\n747: // run in progress, using the same combined source of truth jdiAlreadyRunning\n748: // uses per job: the on-disk sidecar first (job.ReadJDIStatus — which also\n749: // degrades a stale \"running\" away), falling back to the in-session\n750: // jdiSeen/jdiSeenAt dedup map only while no sidecar exists yet, so a\n751: // just-launched run whose mg-jdi process hasn't written its first status file\n752: // animates immediately (see jdiAlreadyRunning's doc for the fallback's TTL).\n753: // This is the spinner tick chain's liveness check: the chain keeps going\n754: // while it returns true and self-terminates the moment it returns false.\n755: func (a *App) anyJDIRunning() bool {\n756: \tfor _, j := range a.jobs {\n757: \t\tif _, running := a.jdiAlreadyRunning(j); running {\n758: \t\t\treturn true\n759: \t\t}\n760: \t}\n761: \treturn false\n762: }\n763: \n764: // spinnerTickCmd returns the tea.Cmd that delivers the next spinnerTickMsg\n765: // after activityInterval — one frame of the activity indicator.\n766: func (a *App) spinnerTickCmd() tea.Cmd {\n767: \treturn tea.Tick(activityInterval, func(time.Time) tea.Msg {\n768: \t\treturn spinnerTickMsg{}\n769: \t})\n770: }\n771: \n772: // startSpinnerIfRunning starts the activity-indicator tick chain when (a)\n773: // it isn't already going (the spinnerTicking guard — no duplicate concurrent\n774: // chains) and (b) some job is currently running. Returns nil otherwise, so\n775: // callers can `return a, a.startSpinnerIfRunning()` and keep their previous\n776: // nil-cmd behaviour unchanged when there is nothing to animate. The chain is\n777: // stopped by the tick handler itself once anyJDIRunning turns false, so a\n778: // run ending (sidecar flipping to a stopped state) is what ends the timer —\n779: // no separate stop call needed.\n780: func (a *App) startSpinnerIfRunning() tea.Cmd {\n781: \tif a.spinnerTicking || !a.anyJDIRunning() {\n782: \t\treturn nil\n783: \t}\n784: \ta.spinnerTicking = true\n785: \treturn a.spinnerTickCmd()\n786: }\n787: \n788: // statusExpireCmd returns the tea.Cmd that delivers the next statusExpireMsg\n789: // after statusBlinkInterval — one tick of the blink/expiry state machine.\n790: func (a *App) statusExpireCmd() tea.Cmd {\n791: \treturn tea.Tick(statusBlinkInterval, func(time.Time) tea.Msg {\n792: \t\treturn statusExpireMsg{}\n793: \t})\n794: }\n795: \n796: // armStatusExpiry (re)starts the status-expiry tick chain when it isn't\n797: // already going (the statusExpiryTicking guard — no duplicate concurrent\n798: // chains) and there is actually a status to expire on either surface.\n799: // Returns nil when a chain is already active (the deadlines are refreshed by\n800: // the surface setters, so a running chain needs no re-arm) or when there is\n801: // nothing to blink/expire. The chain is stopped by the tick handler itself\n802: // once no status remains. Callers with their own cmd should `tea.Batch` it\n803: // with the result.\n804: func (a *App) armStatusExpiry() tea.Cmd {\n805: \tif a.statusExpiryTicking {\n806: \t\treturn nil\n807: \t}\n808: \tif a.status == \"\" && (a.detail == nil || a.detail.status == \"\") {\n809: \t\treturn nil // nothing to blink/expire\n810: \t}\n811: \ta.statusExpiryTicking = true\n812: \treturn a.statusExpireCmd()\n813: }\n814: \n815: // autoRefreshCmd returns the tea.Cmd that delivers the next autoRefreshMsg\n816: // after autoRefreshInterval — one tick of the app's permanent auto-refresh\n817: // timer. The tick handler always re-arms with this (never self-terminating),\n818: // so the chain runs for the app's whole lifetime once started.\n819: func (a *App) autoRefreshCmd() tea.Cmd {\n820: \treturn tea.Tick(autoRefreshInterval, func(time.Time) tea.Msg {\n821: \t\treturn autoRefreshMsg{}\n822: \t})\n823: }\n824: \n825: // startAutoRefresh starts the auto-refresh tick chain when it isn't already\n826: // going (the autoRefreshTicking guard — no duplicate concurrent chains).\n827: // Returns nil when a chain is already active. Unlike startSpinnerIfRunning /\n828: // armStatusExpiry there is no \"nothing to do\" condition: the chain is\n829: // permanent, started once by Init and re-armed by the tick handler itself,\n830: // so no separate stop call exists either.\n831: func (a *App) startAutoRefresh() tea.Cmd {\n832: \tif a.autoRefreshTicking {\n833: \t\treturn nil\n834: \t}\n835: \ta.autoRefreshTicking = true\n836: \treturn a.autoRefreshCmd()\n837: }\n838: \n839: // setStatus sets the list footer status and, when non-empty, arms the\n840: // status-expiry chain so it blinks then clears. The status text itself is set\n841: // directly (callers and existing tests rely on the literal value, e.g.\n842: // `== \"refreshed\"`); arming is a no-op (nil cmd) when the chain is already\n843: // going. An empty s is a plain clear — no arming.\n844: func (a *App) setStatus(s string) tea.Cmd {\n845: \ta.status = s\n846: \tif s == \"\" {\n847: \t\ta.statusBlinkOn = false\n848: \t\ta.statusUntil = time.Time{}\n849: \t\treturn nil\n850: \t}\n851: \ta.statusBlinkOn = false\n852: \ta.statusUntil = statusNow().Add(statusLifetime)\n853: \treturn a.armStatusExpiry()\n854: }\n855: \n856: // detailStatus sets the open detail view's footer status and arms the\n857: // status-expiry chain so it blinks then clears. Returns the arming cmd (nil\n858: // when the chain is already going or there is no detail view) for the caller\n859: // to `tea.Batch` with any cmd it was already returning.\n860: func (a *App) detailStatus(s string) tea.Cmd {\n861: \tif a.detail == nil {\n862: \t\treturn nil\n863: \t}\n864: \ta.detail.setStatus(s)\n865: \treturn a.armStatusExpiry()\n866: }\n867: \n868: // statusVisible reports whether a transient status should currently be\n869: // rendered, given its deadline and blink phase: solid until the blink window\n870: // (statusBlinkWindow before until), then alternating visible/hidden as\n871: // blinkOn toggles during the window, and hidden once past until (the tick\n872: // handler clears the text around then). The text stays set in the caller's\n873: // field regardless; this only decides rendered visibility, so layout\n874: // (footerLines, bodyHeight) keys off the set text, not this toggle.\n875: func statusVisible(status string, until time.Time, blinkOn bool, now time.Time) bool {\n876: \tif status == \"\" {\n877: \t\treturn false\n878: \t}\n879: \tif !now.Before(until) {\n880: \t\treturn false // past the deadline — hidden (the handler clears the text)\n881: \t}\n882: \tif !now.After(until.Add(-statusBlinkWindow)) {\n883: \t\treturn true // still in the solid hold period\n884: \t}\n885: \treturn blinkOn // blink window: visible only during on toggles\n886: }\n887: \n888: // statusVisible reports the list footer status's current rendered visibility.\n889: func (a *App) statusVisible() bool {\n890: \treturn statusVisible(a.status, a.statusUntil, a.statusBlinkOn, statusNow())\n891: }\n892: \n893: // ringBell writes a bare terminal bell character. A BEL byte reaches the\n894: // terminal (and triggers whatever bell/notification behavior it's\n895: // configured for) regardless of Bubble Tea's alt-screen rendering state, so\n896: // this is safe to call as a direct side effect from within Update rather\n897: // than needing its own tea.Cmd. A package-level var (not a plain func) so\n898: // tests can swap it out instead of actually beeping the test runner.\n899: var ringBell = func() {\n900: \tfmt.Print(\"\\a\")\n901: }\n902: \n903: // refresh does refreshJobs, plus reloads the open detail view's files (if\n904: // any) so changes an agent made outside the TUI show up — used by \"ctrl+r\"\n905: // and by the permanent auto-refresh tick (autoRefreshMsg), which is the\n906: // whole point of the brief's \"get back to a mg tui session and see what's\n907: // happened\": the TUI re-reads on its own instead of waiting for a keypress.\n908: // It also re-reads the project settings, so a .manigot/manigot.json edited\n909: // outside the TUI (e.g. base branch changed by hand or pulled from origin)\n910: // is picked up without an app restart. The settings form's own submit path\n911: // is the only writer to a.projectSettings and it never runs concurrently\n912: // with refresh() — the auto-refresh tick skips the form states, and ctrl+r\n913: // isn't routed here while the form is open.\n914: //\n915: // Returns the activity-indicator tick cmd refreshJobs produced (a ctrl+r or\n916: // an auto-refresh tick is a discovery point for runs started outside this\n917: // session's \"j\" key), so the callers can propagate it.\n918: func (a *App) refresh() tea.Cmd {\n919: \tspinnerCmd := a.refreshJobs()\n920: \tif ps, err := project.Load(a.root); err == nil {\n921: \t\ta.projectSettings = ps\n922: \t}\n923: \tif a.detail != nil {\n924: \t\ta.detail.reload()\n925: \t\ta.detail.refreshCommits(a.settings.RecentActivityCountValue())\n926: \t}\n927: \treturn spinnerCmd\n928: }\n929: \n930: // updateList handles keys while the job list is showing. The cursor-movement\n931: // keys delegate to the list view (a.list.update); everything else is App\n932: // routing — view switches, refresh, launches.\n933: func (a *App) updateList(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n934: \ta.status = \"\" // status is transient — cleared on every key unless a case sets it\n935: \tswitch msg.String() {\n936: \tcase \"q\", \"esc\":\n937: \t\treturn a, tea.Quit\n938: \tcase \"ctrl+r\":\n939: \t\t// Refresh first, then report the *post*-refresh job count — the\n940: \t\t// original ordering (see main), preserved across the\n941: \t\t// refresh-return-value refactor. The refresh is the discovery point\n942: \t\t// for runs started\n943: \t\t// outside this session (its returned tick cmd is propagated below),\n944: \t\t// and len(a.jobs) must reflect the re-read list, not the stale one.\n945: \t\tspinnerCmd := a.refresh()\n946: \t\treturn a, tea.Batch(spinnerCmd, a.setStatus(fmt.Sprintf(\"refreshed · %d job(s)\", len(a.jobs))))\n947: \tcase \"enter\", \"l\", \"right\":\n948: \t\tif j, ok := a.list.selectedJob(a.jobs); ok {\n949: \t\t\ta.detail = newDetailView(j, a.width, a.height)\n950: \t\t\ta.detail.refreshCommits(a.settings.RecentActivityCountValue())\n951: \t\t\ta.state = stateDetail\n952: \t\t}\n953: \tcase \"j\":\n954: \t\t// Run mg-jdi against the job under the cursor — the list-view\n955: \t\t// counterpart of updateDetail's \"j\" case, sharing its already-running\n956: \t\t// guard (on-disk sidecar + in-session jdiSeen fallback) and its\n957: \t\t// detached-background launch (launch.Jdi opens no terminal at all).\n958: \t\t// Status lands in the list footer, and the wording points at the list\n959: \t\t// badge — the list has no log tab open to point at. No-op when the\n960: \t\t// list is empty (nothing under the cursor).\n961: \t\tj, ok := a.list.selectedJob(a.jobs)\n962: \t\tif !ok {\n963: \t\t\treturn a, nil\n964: \t\t}\n965: \t\tif st, running := a.jdiAlreadyRunning(j); running {\n966: \t\t\tlabel := \"mg jdi is already running for this job\"\n967: \t\t\tif st.Agent != \"\" {\n968: \t\t\t\tlabel += \" @\" + st.Agent\n969: \t\t\t}\n970: \t\t\treturn a, a.setStatus(label)\n971: \t\t}\n972: \t\tif err := launch.Jdi(j.ID, a.root, a.settings.ProfileValue()); err != nil {\n973: \t\t\treturn a, a.setStatus(cmdErrorText(err))\n974: \t\t}\n975: \t\t// Seed the stop-notification dedup as \"running\" right away (see\n976: \t\t// updateDetail's \"j\" case for why), then start the activity-indicator\n977: \t\t// tick chain if it isn't already going.\n978: \t\ta.jdiSeen[j.Name] = job.JDIRunning\n979: \t\ta.jdiSeenAt[j.Name] = jdiNow()\n980: \t\treturn a, tea.Batch(a.startSpinnerIfRunning(), a.setStatus(\"→ mg jdi started in the background — see the list badge\"))\n981: \tcase \"n\":\n982: \t\t// Create a new job via the host mg-job command.\n983: \t\ta.newJob = newNewJobView(a.width, a.height)\n984: \t\ta.state = stateNewJob\n985: \tcase \"s\":\n986: \t\t// Edit the persisted TUI settings: the global personal prefs\n987: \t\t// (editor, recent activity count, subscription profile) and the\n988: \t\t// project base branch. Both are seeded from their on-disk files\n989: \t\t// (see NewApp).\n990: \t\ta.settingsView = newSettingsView(a.settings, a.projectSettings, a.width, a.height)\n991: \t\ta.state = stateSettings\n992: \tcase \"o\":\n993: \t\t// Launch a bare manigot session (no agent, no job) in a detached\n994: \t\t// new terminal — a quick ad-hoc change that doesn't belong to any\n995: \t\t// specific job's workflow. Mirrors updateDetail's agent-launch\n996: \t\t// reporting so the two launch paths feel consistent in the footer.\n997: \t\tdesc, err := launch.Quick(a.root, a.settings.ProfileValue(), a.settings.Terminal)\n998: \t\tif err != nil {\n999: \t\t\ta.status = cmdErrorText(err)\n1000: \t\t} else {\n1001: \t\t\ta.status = \"→ quick session in \" + desc\n1002: \t\t}\n1003: \tcase \"a\":\n1004: \t\t// Pick any agent and launch it as a jobless quick session — the\n1005: \t\t// native-TUI counterpart to `mg agents` (scripts/agents.sh),\n1006: \t\t// mirroring \"o\" (bare quick session) but for a specific agent.\n1007: \t\t// A discovery failure (e.g. no resolvable manigot checkout) or an\n1008: \t\t// empty agent list degrades to a status line\n1009: \t\t// instead of opening the picker, the same \"never crash on a\n1010: \t\t// host-command error\" convention every other action in this file\n1011: \t\t// follows (cmdErrorText).\n1012: \t\tagents, err := agentlist.Discover(a.root)\n1013: \t\tif err != nil {\n1014: \t\t\ta.status = cmdErrorText(err)\n1015: \t\t} else if len(agents) == 0 {\n1016: \t\t\ta.status = \"no agents found\"\n1017: \t\t} else {\n1018: \t\t\ta.agentsPicker = newAgentsPickerView(agents, a.width, a.height)\n1019: \t\t\ta.state = stateAgents\n1020: \t\t}\n1021: \tdefault:\n1022: \t\t// Cursor movement — the list view's own key handling. \"g\"/\"G\" land\n1023: \t\t// here too, below the routing keys (none of which collide).\n1024: \t\ta.list.update(msg, len(a.jobs))\n1025: \t}\n1026: \treturn a, nil\n1027: }\n1028: \n1029: // updateSettings handles keys in the settings form.\n1030: func (a *App) updateSettings(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n1031: \tswitch a.settingsView.update(msg) {\n1032: \tcase stCancel:\n1033: \t\ta.settingsView = nil\n1034: \t\ta.state = stateList\n1035: \tcase stSubmit:\n1036: \t\t// Validate the recent-activity count field first (blank = default;\n1037: \t\t// anything unparseable or outside 1–100 keeps the form open with a\n1038: \t\t// status message and persists nothing). Persist both files — the\n1039: \t\t// global personal prefs (config.Save) and the project base branch\n1040: \t\t// (project.Save). Surface whichever fails first in the form's status,\n1041: \t\t// leaving the form open so the user can retry without retyping; only\n1042: \t\t// update the in-memory copies and return to the list once both\n1043: \t\t// succeed.\n1044: \t\tif _, err := a.settingsView.recentActivityCount(); err != nil {\n1045: \t\t\ta.settingsView.status = cmdErrorText(err)\n1046: \t\t\treturn a, nil\n1047: \t\t}\n1048: \t\ts := a.settingsView.settingsValue()\n1049: \t\tps := a.settingsView.projectValue()\n1050: \t\tif err := config.Save(s); err != nil {\n1051: \t\t\ta.settingsView.status = cmdErrorText(err)\n1052: \t\t\treturn a, nil\n1053: \t\t}\n1054: \t\tif err := project.Save(a.root, ps); err != nil {\n1055: \t\t\ta.settingsView.status = cmdErrorText(err)\n1056: \t\t\treturn a, nil\n1057: \t\t}\n1058: \t\ta.settings = s\n1059: \t\ta.projectSettings = ps\n1060: \t\t// The recent-activity strip's maximum may have just changed — refetch\n1061: \t\t// so the list reflects the new count immediately on return.\n1062: \t\ta.refreshRecentCommits()\n1063: \t\ta.settingsView = nil\n1064: \t\ta.status = \"settings saved\"\n1065: \t\ta.state = stateList\n1066: \t}\n1067: \treturn a, nil\n1068: }\n1069: \n1070: // updateNewJob handles keys in the new-job form.\n1071: func (a *App) updateNewJob(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n1072: \tswitch a.newJob.update(msg) {\n1073: \tcase njCancel:\n1074: \t\ta.newJob = nil\n1075: \t\ta.state = stateList\n1076: \tcase njSubmit:\n1077: \t\ttitle := strings.TrimSpace(a.newJob.title.Value())\n1078: \t\tif title == \"\" {\n1079: \t\t\ta.newJob.status = \"title is required\"\n1080: \t\t\treturn a, nil\n1081: \t\t}\n1082: \t\ttyp := a.newJob.typeValue()\n1083: \t\t// In-process job creation (the port of hostcmd.NewJob): the script's\n1084: \t\t// full stdout summary is discarded — the TUI shows its own status\n1085: \t\t// line, matching how the old call ignored the captured output.\n1086: \t\tif _, err := job.CreateJob(a.root, title, job.CreateOptions{Type: typ}, io.Discard); err != nil {\n1087: \t\t\ta.newJob.status = cmdErrorText(err)\n1088: \t\t\treturn a, nil\n1089: \t\t}\n1090: \t\t// Refresh the list so the new job appears, then return to it.\n1091: \t\tif jobs, derr := job.Discover(a.root); derr == nil {\n1092: \t\t\ta.jobs = jobs\n1093: \t\t}\n1094: \t\ta.list.currentBranch, _ = git.CurrentBranch(a.root) // \"\" on detached HEAD / non-repo\n1095: \t\ta.refreshRecentCommits()\n1096: \t\ta.list.cursor = 0 // newest first after Discover's date-desc sort\n1097: \t\ta.status = \"created \\\"\" + title + \"\\\" (\" + typ + \")\"\n1098: \t\ta.newJob = nil\n1099: \t\ta.state = stateList\n1100: \t}\n1101: \treturn a, nil\n1102: }\n1103: \n1104: // updateAgentsPicker handles keys in the \"Launch an agent\" picker opened by\n1105: // \"a\" from the list view.\n1106: func (a *App) updateAgentsPicker(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n1107: \tswitch a.agentsPicker.update(msg) {\n1108: \tcase apCancel:\n1109: \t\ta.agentsPicker = nil\n1110: \t\ta.state = stateList\n1111: \tcase apSubmit:\n1112: \t\tagent, ok := a.agentsPicker.selected()\n1113: \t\ta.agentsPicker = nil\n1114: \t\ta.state = stateList\n1115: \t\tif !ok {\n1116: \t\t\treturn a, nil\n1117: \t\t}\n1118: \t\t// Mirrors updateDetail's agent-launch status reporting (\"→ <agent>\n1119: \t\t// in <desc>\") so both launch paths feel consistent in the footer.\n1120: \t\tdesc, err := launch.AgentQuick(agent.Name, a.root, a.settings.ProfileValue(), a.settings.Terminal)\n1121: \t\tif err != nil {\n1122: \t\t\ta.status = cmdErrorText(err)\n1123: \t\t} else {\n1124: \t\t\ta.status = \"→ \" + agent.Name + \" in \" + desc\n1125: \t\t}\n1126: \t}\n1127: \treturn a, nil\n1128: }\n1129: \n1130: // updateGitPanel handles keys in the \"git\" panel opened by \"g\" from the\n1131: // detail view: esc/q cancels back to the detail view; enter dispatches the\n1132: // highlighted action — the same cmds the \"c\" commit-all and \"P\" push-to-origin\n1133: // accelerators run, plus TASK-2's mergeCmd — and then returns to the detail\n1134: // view, where the resulting *Msg's Update case (commitAllMsg / pushMsg /\n1135: // mergeMsg) surfaces the outcome in the status line. The \"g\" key itself is\n1136: // gated on the job having a branch (see updateDetail), so no branch guard is\n1137: // needed here — every action in the panel targets the job's worktree branch.\n1138: func (a *App) updateGitPanel(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n1139: \tswitch a.gitPanel.update(msg) {\n1140: \tcase gpCancel:\n1141: \t\ta.gitPanel = nil\n1142: \t\ta.state = stateDetail\n1143: \tcase gpSubmit:\n1144: \t\taction, ok := a.gitPanel.selected()\n1145: \t\ta.gitPanel = nil\n1146: \t\ta.state = stateDetail\n1147: \t\tif !ok || a.detail == nil {\n1148: \t\t\treturn a, nil\n1149: \t\t}\n1150: \t\tswitch action {\n1151: \t\tcase gitActionCommitAll:\n1152: \t\t\treturn a, a.commitAllCmd()\n1153: \t\tcase gitActionPush:\n1154: \t\t\treturn a, a.pushCmd(a.detail.job.Branch)\n1155: \t\tcase gitActionMerge:\n1156: \t\t\treturn a, a.mergeCmd()\n1157: \t\t}\n1158: \t}\n1159: \treturn a, nil\n1160: }\n1161: \n1162: // updateDetail handles keys while a job's files are showing.\n1163: func (a *App) updateDetail(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n1164: \tswitch msg.String() {\n1165: \tcase \"esc\", \"backspace\":\n1166: \t\t// Return to the list. Only the job list itself needs refreshing\n1167: \t\t// (a job may have been archived, or its status/title changed) —\n1168: \t\t// reloading the detail view we're about to throw away would be pure\n1169: \t\t// waste, and used to be a real source of lag (see refreshJobs' doc).\n1170: \t\tspinnerCmd := a.refreshJobs()\n1171: \t\ta.detail = nil\n1172: \t\ta.state = stateList\n1173: \t\ta.status = \"refreshed\"\n1174: \t\treturn a, spinnerCmd\n1175: \tcase \"q\":\n1176: \t\treturn a, tea.Quit\n1177: \tcase \"ctrl+r\":\n1178: \t\tspinnerCmd := a.refresh()\n1179: \t\ta.detail.setStatus(\"refreshed\")\n1180: \t\treturn a, tea.Batch(spinnerCmd, a.armStatusExpiry())\n1181: \tcase \"e\":\n1182: \t\t// Only the tabs marked editable in jobFiles (currently brief.md\n1183: \t\t// only) respond — for any other tab this falls through to the\n1184: \t\t// default key handling below, same as any other unbound key.\n1185: \t\tif a.detail.current().editable {\n1186: \t\t\tcmd, err := a.editCmd()\n1187: \t\t\tif err != nil {\n1188: \t\t\t\ta.detail.setStatus(cmdErrorText(err))\n1189: \t\t\t\treturn a, a.armStatusExpiry()\n1190: \t\t\t}\n1191: \t\t\treturn a, cmd\n1192: \t\t}\n1193: \tcase \"D\":\n1194: \t\t// Mark done: not an agent action, so it is handled here rather than\n1195: \t\t// falling into the agentForKey dispatch below. Shows the TUI-side\n1196: \t\t// confirmation (replacing finish-job.sh's subprocess prompts); on\n1197: \t\t// confirmation the lifecycle runs in-process.\n1198: \t\ta.openConfirm(confirmDone)\n1199: \t\treturn a, nil\n1200: \tcase \"j\":\n1201: \t\t// Run mg-jdi: a bigger, composite action like \"D\", not a\n1202: \t\t// single-agent launch, so it's handled here rather than through\n1203: \t\t// agentForKey. Unlike launch.Agent, this starts detached in the\n1204: \t\t// background with no spawned terminal window at all — see launch.Jdi's\n1205: \t\t// own doc for why. Every job now has its own worktree, so there is\n1206: \t\t// no \"wrong branch checked out\" state to guard against\n1207: \t\t// here: mg-jdi resolves its own correct worktree per invocation.\n1208: \t\t// Block a second concurrent launch against the same job — the brief\n1209: \t\t// this job exists for (\"press j ... multiple times\" spawns several\n1210: \t\t// processes with no indication). jdiAlreadyRunning combines the\n1211: \t\t// on-disk sidecar with the in-session dedup map so a press landing\n1212: \t\t// before mg-jdi has written its very first status file is caught\n1213: \t\t// too.\n\n(Output capped at 50 KB. Showing lines 1-1213. Use offset=1214 to continue.)\n</content>","metadata":{"preview":"// Package ui holds the Bubble Tea models that make up the manigot TUI.\n//\n// App is the root model; it owns the discovered job list and routes between the\n// list view (list.go), the job detail view (detail.go) and overlays for actions.\npackage ui\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\ttea \"github.com/charmbracelet/bubbletea\"\n\t\"github.com/lmuskalla/manigot/internal/agentlist\"\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/editor\"\n\t\"github.com/lmuskalla/manigot/internal/git\"","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/ui/app.go","text":"// Package ui holds the Bubble Tea models that make up the manigot TUI.\n//\n// App is the root model; it owns the discovered job list and routes between the\n// list view (list.go), the job detail view (detail.go) and overlays for actions.\npackage ui\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\ttea \"github.com/charmbracelet/bubbletea\"\n\t\"github.com/lmuskalla/manigot/internal/agentlist\"\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/editor\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/launch\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// appState selects which view is active. More states (detail, form) are added\n// by later tasks.\ntype appState int\n\nconst (\n\tstateList appState = iota\n\tstateDetail\n\tstateNewJob   // \"n\" from the list — create a job via the in-process job.CreateJob\n\tstateSettings // \"s\" from the list — edit the persisted TUI settings\n\tstateAgents   // \"a\" from the list — pick and launch any agent as a jobless quick session\n\tstateConfirm  // \"D\" / \"delete\" / \"x\" from the detail — confirm a destructive lifecycle action\n\tstateGitPanel // \"g\" from the detail — pick a git command (commit all / push / merge default branch)\n)\n\n// App is the root Bubble Tea model.\ntype App struct {\n\troot  string\n\tjobs  []job.Job\n\tstate appState\n\n\t// list is the job list view (stateList) — see list.go. It owns the\n\t// cursor, the recent-activity strip data, and the list rendering; App\n\t// feeds it the job list, settings, and cross-view state on each render.\n\tlist *listView\n\n\t// width / height are the viewport size, used to construct and resize the\n\t// overlay views (detail, new-job, settings, agents picker, confirm) and\n\t// passed to the list view on each render.\n\twidth  int\n\theight int\n\n\t// settings holds the persisted TUI preferences (editor, recent-activity\n\t// count, subscription profile). It is loaded once at startup and updated\n\t// in place whenever the settings form is submitted.\n\tsettings config.Settings\n\n\t// projectSettings holds the project-scoped conventions (base branch),\n\t// read from .manigot/manigot.json in the target project root. Unlike\n\t// settings, this file is meant to be committed and shared across a\n\t// team — it travels with the project, not the user. Loaded once at\n\t// startup and updated in place whenever the settings form is submitted.\n\tprojectSettings project.Settings\n\n\t// detail is non-nil while state == stateDetail.\n\tdetail *detailView\n\n\t// newJob is non-nil while state == stateNewJob.\n\tnewJob *newJobView\n\n\t// settingsView is non-nil while state == stateSettings.\n\tsettingsView *settingsView\n\n\t// agentsPicker is non-nil while state == stateAgents.\n\tagentsPicker *agentsPickerView\n\n\t// confirm is non-nil while state == stateConfirm — the destructive-action\n\t// confirmation for \"D\" (mark done) and \"delete\"/\"x\" (delete).\n\tconfirm *confirmView\n\n\t// gitPanel is non-nil while state == stateGitPanel — the \"g\" git-command\n\t// picker over the detail view (commit all / push to origin / merge\n\t// default branch).\n\tgitPanel *gitPanelView\n\n\t// status is a transient one-line message shown in the footer (e.g. after\n\t// running mg-job or an agent).\n\tstatus string\n\n\t// statusUntil is when the current list status blinks then clears — see\n\t// statusExpireMsg. statusBlinkOn toggles the list footer's *rendered*\n\t// visibility during the blink window immediately before statusUntil; the\n\t// underlying status text stays set throughout the blink (statusVisible\n\t// decides rendering, so footer layout never jitters mid-blink).\n\tstatusUntil   time.Time\n\tstatusBlinkOn bool\n\n\t// statusExpiryTicking guards the status-expiry tick chain: true while a\n\t// statusExpireMsg is scheduled or in flight, so no second concurrent\n\t// chain can be started (armStatusExpiry is a no-op while it's set).\n\t// Cleared by the tick handler itself the moment no status remains on\n\t// either surface — the chain self-terminates (one of the two narrow\n\t// self-terminating exceptions), leaving the permanent auto-refresh tick\n\t// as the app's one always-running timer.\n\tstatusExpiryTicking bool\n\n\t// jdiSeen tracks, per job Name, the last job.JDIState observed for that\n\t// job's mg-jdi status sidecar — the TUI's own stop-notification dedup. The very first observation of any given job\n\t// (no prior entry) always just seeds this map rather than ringing the\n\t// bell, even if that first-seen status is already stopped: a restarted\n\t// TUI re-observing an already-stopped job isn't a new event worth\n\t// alerting on. Reset (empty) on every TUI restart — in-memory only, no\n\t// new event-streaming subsystem or persisted state.\n\t//\n\t// jdiAlreadyRunning's launch-block guard also falls back to this same\n\t// map when no on-disk sidecar exists yet — see jdiSeenAt below for why that fallback has its\n\t// own expiry, independent of this dedup's own (unrelated) purpose.\n\tjdiSeen map[string]job.JDIState\n\n\t// jdiSeenAt records when each jdiSeen entry was last written, so\n\t// jdiAlreadyRunning's fallback to jdiSeen (used only while no on-disk\n\t// sidecar exists) can expire it after jdiSeenFallbackTTL rather than\n\t// trusting it forever. Without this, a \"j\" press whose mg-jdi process\n\t// then crashed or was killed before ever writing its first status file\n\t// left a JDIRunning entry in jdiSeen with nothing to ever clear it —\n\t// permanently blocking a re-launch for the rest of the TUI session, with\n\t// no visible indicator anywhere (the sidecar-driven badges correctly show\n\t// nothing running) explaining why. Keyed the same as jdiSeen.\n\tjdiSeenAt map[string]time.Time\n\n\t// spinnerStep is the current activity-indicator frame index (see\n\t// activity.go), advanced once per spinnerTickMsg while any mg-jdi run is\n\t// active. Threaded into the running badges (jdiStatusBadge) and into the\n\t// open detail view (detailView.spinnerStep) so both the list row and the\n\t// action-bar badge animate off the same counter. 0 (the zero value) is\n\t// the first frame; nothing special about it.\n\tspinnerStep int\n\n\t// spinnerTicking guards the activity-indicator tick chain: true while a\n\t// spinnerTickMsg is scheduled or in flight, so no second concurrent chain\n\t// can be started (startSpinnerIfRunning is a no-op while it's set). Cleared\n\t// by the tick handler itself the moment no job is running any more — the\n\t// chain self-terminates (one of the two narrow self-terminating\n\t// exceptions), so a run ending is all it takes to stop the redraws,\n\t// leaving the permanent auto-refresh tick as the app's one always-running\n\t// timer.\n\tspinnerTicking bool\n\n\t// autoRefreshTicking guards the auto-refresh tick chain: true while an\n\t// autoRefreshMsg is scheduled or in flight, so no second concurrent chain\n\t// can be started (startAutoRefresh is a no-op while it's set). Unlike the\n\t// spinner/status guards this one is never cleared — the chain is\n\t// permanent, re-armed by the tick handler itself for the app's whole\n\t// lifetime — so once set it stays set.\n\tautoRefreshTicking bool\n}\n\n// spinnerTickMsg advances the activity indicator one frame. It is one of the\n// app's three timer-driven messages — alongside statusExpireMsg and the\n// permanent autoRefreshMsg — and, together with statusExpireMsg, one of the\n// two narrow *self-terminating* exceptions to \"no separate timer-driven\n// tick\" (see pollJDIBell's doc, and the README's \"mg jdi status & log\"\n// section): a ~activityInterval redraw that exists only while an mg-jdi run\n// is active, so a watched run visibly indicates it's alive instead of\n// sitting as a static badge. Unlike autoRefreshMsg, the chain stops itself\n// the moment the run ends.\ntype spinnerTickMsg struct{}\n\n// statusExpireMsg drives the blink-then-clear of transient status messages\n// (the list footer's status and the detail footer's status). It is one of\n// the app's three timer-driven messages — alongside spinnerTickMsg and the\n// permanent autoRefreshMsg — and, together with spinnerTickMsg, one of the\n// two narrow *self-terminating* exceptions to \"no separate timer-driven\n// tick\": a ~statusBlinkInterval redraw that exists only while a status is\n// set, so a transient status blinks a few times then disappears instead of\n// persisting forever (see armStatusExpiry and its Update handler). Unlike\n// autoRefreshMsg, the chain stops itself the moment no status remains.\ntype statusExpireMsg struct{}\n\n// autoRefreshMsg drives the app's permanent auto-refresh timer: a\n// ~autoRefreshInterval tick that re-reads everything ctrl+r reads (job list,\n// project settings, open detail view, git-log strip) so a TUI left sitting\n// in a tmux pane catches up on its own — the brief's \"get back to a mg tui\n// session and see what's happened\" without a manual refresh. Unlike\n// spinnerTickMsg and statusExpireMsg it is not a narrow, self-terminating\n// exception: the chain is started once by Init (via startAutoRefresh) and\n// re-armed by the tick handler for the app's whole lifetime. See\n// autoRefreshMsg's Update handler for the state gating.\ntype autoRefreshMsg struct{}\n\n// hostGitTimeout bounds the TUI's background git cmds (push-to-origin, the\n// auto-commit after a brief.md edit). These run off the UI goroutine, so an\n// unbounded git call — most realistically a stalled network push — would hang\n// the app's command channel forever (GIT_TERMINAL_PROMPT=0 covers only the\n// credential case). The interactive session and mg done/mg delete keep no\n// timeout: the user is waiting on git there. The mg-jdi probes use their own,\n// shorter timeout (see cmd/mg/jdi.go).\nconst hostGitTimeout = 30 * time.Second\n\n// jdiSeenFallbackTTL bounds how long jdiAlreadyRunning trusts a jdiSeen\n// JDIRunning entry that has no corroborating on-disk sidecar file at all.\n// It exists to bridge the real race this fallback is for — the gap between\n// launch.Jdi's Start() returning and mg-jdi's own first WriteJDIStatus call,\n// which happens before mg-jdi invokes its first agent, so\n// normally within seconds (a git checkout, not a full agent run) — while\n// still being short enough that a launch whose mg-jdi process crashed or was\n// killed before ever writing that first status file recovers on its own\n// within the same TUI session, rather than requiring a restart. Deliberately\n// much shorter than jdiRunningStaleAfter (job.ReadJDIStatus's own 30-minute\n// staleness window for a sidecar file that *does* exist): that window has to\n// stay generous enough not to mistake one long agent call for a killed\n// process, but this one only has to survive process startup, not an entire\n// agent invocation.\nconst jdiSeenFallbackTTL = 2 * time.Minute\n\n// jdiNow is time.Now, indirected so tests can simulate the passage of time\n// for jdiSeenFallbackTTL without an actual sleep.\nvar jdiNow = time.Now\n\n// statusNow is time.Now, indirected so tests can simulate the passage of time\n// for the status blink/expiry state machine without an actual sleep.\nvar statusNow = time.Now\n\n// NewApp builds the root model from a discovered job list. Settings are\n// loaded from disk (see config.Load); a load failure (e.g. a corrupt\n// tui-settings.json) is non-fatal — the app starts with default settings and\n// surfaces the error in the footer instead.\nfunc NewApp(root string, jobs []job.Job) *App {\n\ta := &App{root: root, jobs: jobs, state: stateList, list: newListView(root), jdiSeen: map[string]job.JDIState{}, jdiSeenAt: map[string]time.Time{}}\n\tsettings, err := config.Load()\n\ta.settings = settings\n\tif err != nil {\n\t\t// A startup config-load error is a transient status like any other:\n\t\t// it blinks then clears. The arming cmd is discarded here (NewApp\n\t\t// returns no cmd) — Init re-arms via armStatusExpiry.\n\t\ta.setStatus(cmdErrorText(err))\n\t}\n\ta.list.currentBranch, _ = git.CurrentBranch(root) // \"\" on detached HEAD / non-repo\n\t// Settings must be loaded before the initial recent-commits fetch so the\n\t// strip honors the configured maximum count on the very first render —\n\t// not just after the first settings submit.\n\ta.refreshRecentCommits()\n\t// Project settings (base branch) live in the target project, not the\n\t// manigot checkout, so a missing file is the normal pre-first-save state\n\t// and project.Load already degrades it to a zero value — only a real I/O\n\t// or parse error surfaces here. Append rather than overwrite a config\n\t// load error so both can be seen.\n\tprojSettings, perr := project.Load(root)\n\ta.projectSettings = projSettings\n\tif perr != nil {\n\t\tif a.status != \"\" {\n\t\t\ta.setStatus(a.status + \" · \" + cmdErrorText(perr))\n\t\t} else {\n\t\t\ta.setStatus(cmdErrorText(perr))\n\t\t}\n\t}\n\treturn a\n}\n\n// Init starts the program. No initial commands are needed — except the\n// activity-indicator tick chain when an mg-jdi run is already active at\n// startup (startSpinnerIfRunning, so a TUI opened mid-run animates its badge\n// without waiting for a keypress or refresh), the status-expiry chain when\n// a startup status was set in NewApp (armStatusExpiry, so a config-load error\n// surfaced in the footer blinks then clears like any other transient status),\n// and the permanent auto-refresh chain (startAutoRefresh, so the TUI re-reads\n// state from disk on its own from the very first second instead of only on\n// discrete events). The first two are no-ops (nil) when there is nothing to\n// animate, and tea.Batch drops those nils; the auto-refresh chain always\n// starts and never stops.\nfunc (a *App) Init() tea.Cmd {\n\treturn tea.Batch(a.startSpinnerIfRunning(), a.armStatusExpiry(), a.startAutoRefresh())\n}\n\n// editorDoneMsg reports the outcome of the \"e\" edit-shortcut's tea.ExecProcess\n// once the suspended editor process returns.\ntype editorDoneMsg struct {\n\tpath string\n\terr  error\n}\n\n// doneMsg reports the outcome of the \"D\" mark-done shortcut's background\n// job.FinishJob run once it returns.\ntype doneMsg struct {\n\terr error\n}\n\n// deleteMsg reports the outcome of the \"delete\" shortcut's background\n// job.DeleteJob run once it returns.\ntype deleteMsg struct {\n\terr error\n}\n\n// commitMsg reports the outcome of the auto-commit that follows a successful\n// brief.md edit (see editorDoneMsg and commitBriefCmd).\ntype commitMsg struct {\n\terr error\n}\n\n// pushMsg reports the outcome of the detail view's \"P\" push-to-origin\n// action (a `git push -u origin <branch>`, run off the UI thread via\n// pushCmd so a slow/blocked network call doesn't block rendering).\ntype pushMsg struct {\n\tbranch string\n\terr    error\n}\n\n// commitAllMsg reports the outcome of the detail view's \"c\" commit-all\n// action (a `git add -A` + `git commit` in the job's own worktree, run off\n// the UI thread via commitAllCmd so a slow git call doesn't block\n// rendering). err is git.ErrNothingToCommit when the worktree had no\n// changes — a distinct, non-failure outcome the Update handler reports as\n// \"nothing to commit\" rather than an error.\ntype commitAllMsg struct {\n\terr error\n}\n\n// mergeMsg reports the outcome of the detail view's \"merge default branch\"\n// action (a `git merge --no-edit <base>` run in the job's own worktree, off\n// the UI thread via mergeCmd so a slow git call doesn't block rendering).\n// base names the resolved base branch the merge ran against, for the success\n// status line; err is non-nil on any git failure (a dirty worktree git\n// refuses, a conflict leaves the tree in the conflicted state for the user\n// to resolve manually — both surface as ordinary status errors).\ntype mergeMsg struct {\n\tbase string\n\terr  error\n}\n\n// Update handles window resizing and routes key presses to the active view.\nfunc (a *App) Update(msg tea.Msg) (tea.Model, tea.Cmd) {\n\tswitch msg := msg.(type) {\n\tcase tea.WindowSizeMsg:\n\t\tw, h := msg.Width-2*uiPaddingX, msg.Height-2*uiPaddingY\n\t\tif w < 1 {\n\t\t\tw = 1\n\t\t}\n\t\tif h < 1 {\n\t\t\th = 1\n\t\t}\n\t\ta.width, a.height = w, h\n\t\tif a.detail != nil {\n\t\t\ta.detail.resize(a.width, a.height)\n\t\t}\n\t\tif a.newJob != nil {\n\t\t\ta.newJob.resize(a.width, a.height)\n\t\t}\n\t\tif a.settingsView != nil {\n\t\t\ta.settingsView.resize(a.width, a.height)\n\t\t}\n\t\tif a.agentsPicker != nil {\n\t\t\ta.agentsPicker.resize(a.width, a.height)\n\t\t}\n\t\tif a.confirm != nil {\n\t\t\ta.confirm.resize(a.width, a.height)\n\t\t}\n\t\tif a.gitPanel != nil {\n\t\t\ta.gitPanel.resize(a.width, a.height)\n\t\t}\n\t\treturn a, nil\n\tcase editorDoneMsg:\n\t\tif a.detail != nil {\n\t\t\tif msg.err != nil {\n\t\t\t\ta.detail.setStatus(cmdErrorText(msg.err))\n\t\t\t} else {\n\t\t\t\ta.detail.reloadCurrent()\n\t\t\t\ta.detail.setStatus(\"edited \" + filepath.Base(msg.path))\n\t\t\t\t// brief.md is the one editable tab (jobFiles) and the one\n\t\t\t\t// file the job workflow expects to always be committed —\n\t\t\t\t// auto-commit it so an edit never lingers as an uncommitted\n\t\t\t\t// change the way finish-job.sh's clean-tree check would\n\t\t\t\t// otherwise reject. Any other future editable tab is left\n\t\t\t\t// alone, same as before this behavior existed.\n\t\t\t\tif filepath.Base(msg.path) == \"brief.md\" {\n\t\t\t\t\treturn a, tea.Batch(a.commitBriefCmd(), a.armStatusExpiry())\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treturn a, a.armStatusExpiry()\n\tcase commitMsg:\n\t\tif a.detail != nil {\n\t\t\tif msg.err != nil {\n\t\t\t\ta.detail.setStatus(cmdErrorText(msg.err))\n\t\t\t} else {\n\t\t\t\ta.detail.setStatus(\"edited and committed brief.md\")\n\t\t\t}\n\t\t}\n\t\treturn a, a.armStatusExpiry()\n\tcase doneMsg:\n\t\t// The lifecycle outcome is not a reliable done signal: a declined\n\t\t// confirmation (ErrCancelled) and a real failure both carry an error,\n\t\t// while a successful archive carries none — and a declined-but-kept\n\t\t// job looks identical to an archived one from the error alone. So\n\t\t// regardless of msg.err, always fall back to refreshing the job list\n\t\t// from disk and returning to it — a job that got archived is simply\n\t\t// gone from the re-read list, one that was declined or failed is\n\t\t// still there. An error still surfaces through cmdErrorText first,\n\t\t// same as any other host-command failure.\n\t\tspinnerCmd := a.refreshJobs()\n\t\ta.detail = nil\n\t\ta.state = stateList\n\t\tif msg.err != nil {\n\t\t\t// A merge failure handed to @git-solver is not an error — the\n\t\t\t// TUI's pre-approved confirmations always accept the handoff, so\n\t\t\t// this is the common conflicted-merge outcome. The git-solver\n\t\t\t// session was opened detached (launch.HostAgent); the job stays\n\t\t\t// in the list until it finishes the cleanup.\n\t\t\tif errors.Is(msg.err, job.ErrGitSolverHandoff) {\n\t\t\t\treturn a, tea.Batch(spinnerCmd, a.setStatus(\"handed off to @git-solver — resolving the merge in the opened session\"))\n\t\t\t}\n\t\t\treturn a, tea.Batch(spinnerCmd, a.setStatus(cmdErrorText(msg.err)))\n\t\t}\n\t\treturn a, tea.Batch(spinnerCmd, a.setStatus(\"refreshed\"))\n\tcase deleteMsg:\n\t\t// Same reasoning as doneMsg: a declined delete (ErrCancelled) leaves\n\t\t// the job present in the re-read list — refreshJobs and returning to\n\t\t// the list handles both outcomes uniformly.\n\t\tspinnerCmd := a.refreshJobs()\n\t\ta.detail = nil\n\t\ta.state = stateList\n\t\tif msg.err != nil {\n\t\t\treturn a, tea.Batch(spinnerCmd, a.setStatus(cmdErrorText(msg.err)))\n\t\t}\n\t\treturn a, tea.Batch(spinnerCmd, a.setStatus(\"refreshed\"))\n\tcase pushMsg:\n\t\t// A push never changes what the working tree or job list looks\n\t\t// like — only origin's state — so there is nothing to refresh or\n\t\t// rebuild here, just a status line.\n\t\tif a.detail != nil {\n\t\t\tif msg.err != nil {\n\t\t\t\ta.detail.setStatus(cmdErrorText(msg.err))\n\t\t\t} else {\n\t\t\t\ta.detail.setStatus(\"→ pushed \" + msg.branch + \" to origin\")\n\t\t\t}\n\t\t}\n\t\treturn a, a.armStatusExpiry()\n\tcase commitAllMsg:\n\t\tif a.detail != nil {\n\t\t\tswitch {\n\t\t\tcase msg.err == nil:\n\t\t\t\ta.detail.setStatus(\"→ committed all changes\")\n\t\t\t\t// Unlike a push, a commit does change what the detail view\n\t\t\t\t// shows: the bottom git-log strip (refreshCommits) and the\n\t\t\t\t// computed diff tab (recomputed by reload via loadTabs).\n\t\t\t\t// Refresh both so the new commit appears immediately\n\t\t\t\t// instead of on the next refresh (auto or ctrl+r).\n\t\t\t\ta.detail.reload()\n\t\t\t\ta.detail.refreshCommits(a.settings.RecentActivityCountValue())\n\t\t\tcase errors.Is(msg.err, git.ErrNothingToCommit):\n\t\t\t\t// Distinct non-failure outcome: the worktree was already\n\t\t\t\t// clean, so report that plainly rather than as an error.\n\t\t\t\ta.detail.setStatus(\"nothing to commit\")\n\t\t\tdefault:\n\t\t\t\ta.detail.setStatus(cmdErrorText(msg.err))\n\t\t\t}\n\t\t}\n\t\treturn a, a.armStatusExpiry()\n\tcase mergeMsg:\n\t\t// A merge changes what the detail view shows exactly like a commit\n\t\t// does — the job branch moved, so the bottom git-log strip\n\t\t// (refreshCommits) and the computed diff tab (reload via loadTabs)\n\t\t// both need rebuilding. A conflict or a dirty-worktree refusal\n\t\t// surfaces as a plain status error; the tree is left as git put it\n\t\t// for the user to resolve manually.\n\t\tif a.detail != nil {\n\t\t\tif msg.err != nil {\n\t\t\t\ta.detail.setStatus(cmdErrorText(msg.err))\n\t\t\t} else {\n\t\t\t\ta.detail.setStatus(\"→ merged \" + msg.base + \" into \" + a.detail.job.Branch)\n\t\t\t\ta.detail.reload()\n\t\t\t\ta.detail.refreshCommits(a.settings.RecentActivityCountValue())\n\t\t\t}\n\t\t}\n\t\treturn a, a.armStatusExpiry()\n\tcase spinnerTickMsg:\n\t\t// Advance the activity indicator. The step always moves (even on the\n\t\t// tick that observes the run has ended — the check below happens\n\t\t// after), but the chain only continues while a job is actually\n\t\t// running: the moment every sidecar has flipped to a stopped state\n\t\t// (or the in-session jdiSeen fallback expired), return nil and clear\n\t\t// the guard so no further timer-driven redraws happen. The guard is\n\t\t// (re)asserted on the continuing path too, not just by\n\t\t// startSpinnerIfRunning, so \"guard set\" stays equivalent to \"chain\n\t\t// alive\" no matter how a tick reached the handler.\n\t\ta.spinnerStep++\n\t\tif a.detail != nil {\n\t\t\ta.detail.spinnerStep = a.spinnerStep\n\t\t}\n\t\tif !a.anyJDIRunning() {\n\t\t\ta.spinnerTicking = false\n\t\t\treturn a, nil\n\t\t}\n\t\ta.spinnerTicking = true\n\t\treturn a, a.spinnerTickCmd()\n\tcase statusExpireMsg:\n\t\t// Blink-then-clear state machine for transient statuses. Each tick\n\t\t// (statusBlinkInterval) toggles the rendered visibility of any status\n\t\t// that has entered its blink window (the statusBlinkWindow right\n\t\t// before its deadline), and clears the status text entirely once past\n\t\t// the deadline. The underlying text stays set during the blink (only\n\t\t// statusBlinkOn toggles), so footer layout — footerLines()/bodyHeight()\n\t\t// on the detail surface — never jitters mid-blink; only at final\n\t\t// expiry is the text cleared. The chain self-terminates (returns nil\n\t\t// and clears the guard) the moment no status remains on either\n\t\t// surface — one of the two narrow self-terminating exceptions,\n\t\t// leaving the permanent auto-refresh tick as the app's one\n\t\t// always-running timer.\n\t\tnow := statusNow()\n\t\tif a.status != \"\" {\n\t\t\tif !now.Before(a.statusUntil) {\n\t\t\t\ta.status = \"\"\n\t\t\t\ta.statusBlinkOn = false\n\t\t\t} else if now.After(a.statusUntil.Add(-statusBlinkWindow)) {\n\t\t\t\ta.statusBlinkOn = !a.statusBlinkOn\n\t\t\t}\n\t\t}\n\t\tif a.detail != nil && a.detail.status != \"\" {\n\t\t\tif !now.Before(a.detail.statusUntil) {\n\t\t\t\ta.detail.status = \"\"\n\t\t\t\ta.detail.statusBlinkOn = false\n\t\t\t\t// Clearing the text shrinks the footer back to one line, so\n\t\t\t\t// resize the body viewers to reclaim the freed rows (the same\n\t\t\t\t// thing setStatus(\"\") does on navigation).\n\t\t\t\ta.detail.syncViewerSize()\n\t\t\t} else if now.After(a.detail.statusUntil.Add(-statusBlinkWindow)) {\n\t\t\t\ta.detail.statusBlinkOn = !a.detail.statusBlinkOn\n\t\t\t}\n\t\t}\n\t\tif a.status == \"\" && (a.detail == nil || a.detail.status == \"\") {\n\t\t\ta.statusExpiryTicking = false\n\t\t\treturn a, nil\n\t\t}\n\t\treturn a, a.statusExpireCmd()\n\tcase autoRefreshMsg:\n\t\t// The app's permanent auto-refresh tick: re-read everything ctrl+r\n\t\t// reads (job list, project settings, open detail view, git-log strip)\n\t\t// so a TUI left sitting in a tmux pane catches up on its own — the\n\t\t// brief's \"came back to the TUI and want to see what happened\"\n\t\t// outcome, with the jdi stop-bell (pollJDIBell, via refreshJobs)\n\t\t// riding along for free. Deliberately silent: no status line, unlike\n\t\t// ctrl+r's \"refreshed · N job(s)\" — a footer status every second\n\t\t// would blink constantly and drown out real feedback.\n\t\t//\n\t\t// State gating: refresh() is skipped in the form/overlay states\n\t\t// (stateNewJob, stateSettings, stateAgents, stateConfirm,\n\t\t// stateGitPanel), where reloading the list or the detail view under\n\t\t// an open form/picker/confirmation would be disruptive; the chain\n\t\t// itself keeps ticking regardless, so a single chain lives for the\n\t\t// app's lifetime. The spinner cmd refresh produced is propagated the\n\t\t// way ctrl+r propagates it (a tick is a discovery point for runs\n\t\t// started outside this session), and the chain always re-arms.\n\t\tswitch a.state {\n\t\tcase stateList, stateDetail:\n\t\t\tspinnerCmd := a.refresh()\n\t\t\treturn a, tea.Batch(spinnerCmd, a.autoRefreshCmd())\n\t\tdefault:\n\t\t\treturn a, a.autoRefreshCmd()\n\t\t}\n\tcase tea.KeyMsg:\n\t\t// Global keys handled in every state.\n\t\tswitch msg.String() {\n\t\tcase \"ctrl+c\":\n\t\t\treturn a, tea.Quit\n\t\t}\n\t\tswitch a.state {\n\t\tcase stateList:\n\t\t\treturn a.updateList(msg)\n\t\tcase stateDetail:\n\t\t\treturn a.updateDetail(msg)\n\t\tcase stateNewJob:\n\t\t\treturn a.updateNewJob(msg)\n\t\tcase stateSettings:\n\t\t\treturn a.updateSettings(msg)\n\t\tcase stateAgents:\n\t\t\treturn a.updateAgentsPicker(msg)\n\t\tcase stateConfirm:\n\t\t\treturn a.updateConfirm(msg)\n\t\tcase stateGitPanel:\n\t\t\treturn a.updateGitPanel(msg)\n\t\t}\n\t}\n\treturn a, nil\n}\n\n// View renders the active view, padded out to the terminal edge — see\n// uiPaddingStyle.\nfunc (a *App) View() string {\n\tvar content string\n\tswitch a.state {\n\tcase stateDetail:\n\t\tcontent = a.detail.render()\n\tcase stateNewJob:\n\t\tcontent = a.newJob.render()\n\tcase stateSettings:\n\t\tcontent = a.settingsView.render()\n\tcase stateAgents:\n\t\tcontent = a.agentsPicker.render()\n\tcase stateConfirm:\n\t\tcontent = a.confirm.render()\n\tcase stateGitPanel:\n\t\tcontent = a.gitPanelOverlay()\n\tdefault:\n\t\tcontent = a.list.render(a.jobs, a.status, a.statusVisible(), a.settings.RecentActivityCountValue(), a.spinnerStep, a.width, a.height)\n\t}\n\treturn uiPaddingStyle.Render(content)\n}\n\n// refreshRecentCommits re-reads the recent-activity strip from git, always\n// fetching up to the configured maximum (Settings.RecentActivityCountValue).\n// How many of those cached commits actually get rendered is decided later, at\n// render time, by listView.recentActivityShown — not here. This split matters\n// because refreshRecentCommits runs before the first tea.WindowSizeMsg ever\n// arrives (see NewApp), when the viewport size is still zero; sizing the\n// *fetch* against that would size against a stale terminal height on first\n// render. Fetching the configured maximum and deciding the display count at\n// render time (once layout is known) avoids that hazard.\n//\n// Like currentBranch, an error (e.g. a non-repo project) degrades to an empty\n// strip rather than surfacing in the status line — this is decorative,\n// optional header content, not an action the user asked for.\nfunc (a *App) refreshRecentCommits() {\n\tcommits, err := git.RecentCommits(a.root, a.settings.RecentActivityCountValue())\n\tif err != nil {\n\t\ta.list.recentCommits = nil\n\t\treturn\n\t}\n\ta.list.recentCommits = commits\n}\n\n// clamp bounds n to [lo, hi].\nfunc clamp(n, lo, hi int) int {\n\tif n < lo {\n\t\treturn lo\n\t}\n\tif n > hi {\n\t\treturn hi\n\t}\n\treturn n\n}\n\n// refreshJobs re-reads the job list from disk (job.Discover: one os.ReadDir\n// plus one small brief.md read per job) and clamps the cursor so a job that\n// was archived mid-session doesn't leave it out of range. It does not touch\n// an open detail view — see refresh for that, and updateDetail's\n// \"esc\"/\"backspace\" case, which uses refreshJobs alone because the detail\n// view it would otherwise reload is about to be discarded anyway.\n//\n// It also returns the activity-indicator tick cmd when a refresh just\n// (re)discovered an mg-jdi run while the tick chain wasn't already going\n// (startSpinnerIfRunning) — the \"run started somewhere other than this\n// session's 'j' key\" path, e.g. ctrl+r picking up a run another TUI or a\n// direct mg-jdi launch started. Callers propagate the cmd; the spinnerTicking\n// guard makes it a no-op (nil) when the chain is already live.\nfunc (a *App) refreshJobs() tea.Cmd {\n\tif jobs, err := job.Discover(a.root); err == nil {\n\t\ta.jobs = jobs\n\t}\n\ta.list.currentBranch, _ = git.CurrentBranch(a.root) // \"\" on detached HEAD / non-repo\n\ta.refreshRecentCommits()\n\tif a.list.cursor > 0 && a.list.cursor >= len(a.jobs) {\n\t\ta.list.cursor = len(a.jobs) - 1\n\t}\n\tif a.list.cursor < 0 {\n\t\ta.list.cursor = 0\n\t}\n\ta.pollJDIBell()\n\treturn a.startSpinnerIfRunning()\n}\n\n// pollJDIBell is the TUI-side half of the stop notification: a TUI-launched\n// mg-jdi run has no terminal of its own to\n// ring `\\a` into (see cmd/mg/jdi.go's own CLI-path bell), so instead the TUI\n// rings it on its own next poll — this function, called from refreshJobs,\n// which is every \"poll tick\" this app has (ctrl+r, the permanent\n// auto-refresh tick, returning to list, a checkout, etc.) — the first time\n// it observes a job's status transition into a stopped:* state it hadn't\n// already notified for. The two narrow exceptions to \"refresh-triggered\n// polling only\" are the activity indicator's spinnerTickMsg and the\n// status-expiry statusExpireMsg: self-terminating timer-driven redraws that\n// run only while an mg-jdi run is active / a status is set (see\n// spinnerTickMsg's doc), deliberately kept out of the notification path — a\n// run stopping is exactly when the spinner timer ends.\n//\n// Dedup is in-memory (a.jdiSeen) and keyed by job Name: the first\n// observation of any given job only seeds the map, never rings, even if\n// that first-seen status is already a stopped:* one — a freshly (re)started\n// TUI re-observing a job that was already stopped before it started\n// watching isn't a new event. A later transition away from stopped back to\n// running (a fresh mg-jdi run against the same job) and then stopped again\n// rings a second time, since the intervening JDIRunning observation clears\n// the \"already notified for this stop\" condition.\nfunc (a *App) pollJDIBell() {\n\tfor _, j := range a.jobs {\n\t\tst, ok := job.ReadJDIStatus(a.root, j.Name)\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tprev, seen := a.jdiSeen[j.Name]\n\t\ta.jdiSeen[j.Name] = st.State\n\t\ta.jdiSeenAt[j.Name] = jdiNow()\n\t\tif !seen {\n\t\t\tcontinue\n\t\t}\n\t\tif isJDIStopped(st.State) && prev != st.State {\n\t\t\tringBell()\n\t\t}\n\t}\n}\n\n// isJDIStopped reports whether s is one of the two terminal mg-jdi states.\nfunc isJDIStopped(s job.JDIState) bool {\n\treturn s == job.JDIStoppedFinished || s == job.JDIStoppedNeedsHuman\n}\n\n// jdiAlreadyRunning reports whether j already has an mg-jdi run in progress,\n// for the \"j\" key's launch-block guard. The on-disk sidecar (job.ReadJDIStatus) is the source\n// of truth once mg-jdi has written it — a JDIStoppedFinished/\n// JDIStoppedNeedsHuman status there always wins, even if a.jdiSeen still\n// remembers this same session having launched it earlier, so a job is never\n// permanently blocked after mg-jdi actually stops.\n//\n// The gap the sidecar alone can't cover is the brief moment between\n// launch.Jdi's Start() returning and mg-jdi's own first WriteJDIStatus call\n// (see job/jdistatus.go): nothing has been written yet, so\n// job.ReadJDIStatus reports ok=false. Only in that no-sidecar-yet case does\n// this fall back to a.jdiSeen, which updateDetail's \"j\" handler itself seeds\n// to job.JDIRunning the instant launch.Jdi succeeds — catching a second\n// press that lands in that same narrow window. That fallback entry is only\n// trusted for jdiSeenFallbackTTL (see its own doc): once it's older than\n// that, mg-jdi almost certainly crashed or was killed before ever writing a\n// sidecar, and this reports \"not running\" rather than blocking forever.\nfunc (a *App) jdiAlreadyRunning(j job.Job) (job.JDIStatus, bool) {\n\tif st, ok := job.ReadJDIStatus(a.root, j.Name); ok {\n\t\treturn st, st.State == job.JDIRunning\n\t}\n\tif a.jdiSeen[j.Name] == job.JDIRunning && jdiNow().Sub(a.jdiSeenAt[j.Name]) <= jdiSeenFallbackTTL {\n\t\treturn job.JDIStatus{State: job.JDIRunning}, true\n\t}\n\treturn job.JDIStatus{}, false\n}\n\n// anyJDIRunning reports whether any job in the current list has an mg-jdi\n// run in progress, using the same combined source of truth jdiAlreadyRunning\n// uses per job: the on-disk sidecar first (job.ReadJDIStatus — which also\n// degrades a stale \"running\" away), falling back to the in-session\n// jdiSeen/jdiSeenAt dedup map only while no sidecar exists yet, so a\n// just-launched run whose mg-jdi process hasn't written its first status file\n// animates immediately (see jdiAlreadyRunning's doc for the fallback's TTL).\n// This is the spinner tick chain's liveness check: the chain keeps going\n// while it returns true and self-terminates the moment it returns false.\nfunc (a *App) anyJDIRunning() bool {\n\tfor _, j := range a.jobs {\n\t\tif _, running := a.jdiAlreadyRunning(j); running {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// spinnerTickCmd returns the tea.Cmd that delivers the next spinnerTickMsg\n// after activityInterval — one frame of the activity indicator.\nfunc (a *App) spinnerTickCmd() tea.Cmd {\n\treturn tea.Tick(activityInterval, func(time.Time) tea.Msg {\n\t\treturn spinnerTickMsg{}\n\t})\n}\n\n// startSpinnerIfRunning starts the activity-indicator tick chain when (a)\n// it isn't already going (the spinnerTicking guard — no duplicate concurrent\n// chains) and (b) some job is currently running. Returns nil otherwise, so\n// callers can `return a, a.startSpinnerIfRunning()` and keep their previous\n// nil-cmd behaviour unchanged when there is nothing to animate. The chain is\n// stopped by the tick handler itself once anyJDIRunning turns false, so a\n// run ending (sidecar flipping to a stopped state) is what ends the timer —\n// no separate stop call needed.\nfunc (a *App) startSpinnerIfRunning() tea.Cmd {\n\tif a.spinnerTicking || !a.anyJDIRunning() {\n\t\treturn nil\n\t}\n\ta.spinnerTicking = true\n\treturn a.spinnerTickCmd()\n}\n\n// statusExpireCmd returns the tea.Cmd that delivers the next statusExpireMsg\n// after statusBlinkInterval — one tick of the blink/expiry state machine.\nfunc (a *App) statusExpireCmd() tea.Cmd {\n\treturn tea.Tick(statusBlinkInterval, func(time.Time) tea.Msg {\n\t\treturn statusExpireMsg{}\n\t})\n}\n\n// armStatusExpiry (re)starts the status-expiry tick chain when it isn't\n// already going (the statusExpiryTicking guard — no duplicate concurrent\n// chains) and there is actually a status to expire on either surface.\n// Returns nil when a chain is already active (the deadlines are refreshed by\n// the surface setters, so a running chain needs no re-arm) or when there is\n// nothing to blink/expire. The chain is stopped by the tick handler itself\n// once no status remains. Callers with their own cmd should `tea.Batch` it\n// with the result.\nfunc (a *App) armStatusExpiry() tea.Cmd {\n\tif a.statusExpiryTicking {\n\t\treturn nil\n\t}\n\tif a.status == \"\" && (a.detail == nil || a.detail.status == \"\") {\n\t\treturn nil // nothing to blink/expire\n\t}\n\ta.statusExpiryTicking = true\n\treturn a.statusExpireCmd()\n}\n\n// autoRefreshCmd returns the tea.Cmd that delivers the next autoRefreshMsg\n// after autoRefreshInterval — one tick of the app's permanent auto-refresh\n// timer. The tick handler always re-arms with this (never self-terminating),\n// so the chain runs for the app's whole lifetime once started.\nfunc (a *App) autoRefreshCmd() tea.Cmd {\n\treturn tea.Tick(autoRefreshInterval, func(time.Time) tea.Msg {\n\t\treturn autoRefreshMsg{}\n\t})\n}\n\n// startAutoRefresh starts the auto-refresh tick chain when it isn't already\n// going (the autoRefreshTicking guard — no duplicate concurrent chains).\n// Returns nil when a chain is already active. Unlike startSpinnerIfRunning /\n// armStatusExpiry there is no \"nothing to do\" condition: the chain is\n// permanent, started once by Init and re-armed by the tick handler itself,\n// so no separate stop call exists either.\nfunc (a *App) startAutoRefresh() tea.Cmd {\n\tif a.autoRefreshTicking {\n\t\treturn nil\n\t}\n\ta.autoRefreshTicking = true\n\treturn a.autoRefreshCmd()\n}\n\n// setStatus sets the list footer status and, when non-empty, arms the\n// status-expiry chain so it blinks then clears. The status text itself is set\n// directly (callers and existing tests rely on the literal value, e.g.\n// `== \"refreshed\"`); arming is a no-op (nil cmd) when the chain is already\n// going. An empty s is a plain clear — no arming.\nfunc (a *App) setStatus(s string) tea.Cmd {\n\ta.status = s\n\tif s == \"\" {\n\t\ta.statusBlinkOn = false\n\t\ta.statusUntil = time.Time{}\n\t\treturn nil\n\t}\n\ta.statusBlinkOn = false\n\ta.statusUntil = statusNow().Add(statusLifetime)\n\treturn a.armStatusExpiry()\n}\n\n// detailStatus sets the open detail view's footer status and arms the\n// status-expiry chain so it blinks then clears. Returns the arming cmd (nil\n// when the chain is already going or there is no detail view) for the caller\n// to `tea.Batch` with any cmd it was already returning.\nfunc (a *App) detailStatus(s string) tea.Cmd {\n\tif a.detail == nil {\n\t\treturn nil\n\t}\n\ta.detail.setStatus(s)\n\treturn a.armStatusExpiry()\n}\n\n// statusVisible reports whether a transient status should currently be\n// rendered, given its deadline and blink phase: solid until the blink window\n// (statusBlinkWindow before until), then alternating visible/hidden as\n// blinkOn toggles during the window, and hidden once past until (the tick\n// handler clears the text around then). The text stays set in the caller's\n// field regardless; this only decides rendered visibility, so layout\n// (footerLines, bodyHeight) keys off the set text, not this toggle.\nfunc statusVisible(status string, until time.Time, blinkOn bool, now time.Time) bool {\n\tif status == \"\" {\n\t\treturn false\n\t}\n\tif !now.Before(until) {\n\t\treturn false // past the deadline — hidden (the handler clears the text)\n\t}\n\tif !now.After(until.Add(-statusBlinkWindow)) {\n\t\treturn true // still in the solid hold period\n\t}\n\treturn blinkOn // blink window: visible only during on toggles\n}\n\n// statusVisible reports the list footer status's current rendered visibility.\nfunc (a *App) statusVisible() bool {\n\treturn statusVisible(a.status, a.statusUntil, a.statusBlinkOn, statusNow())\n}\n\n// ringBell writes a bare terminal bell character. A BEL byte reaches the\n// terminal (and triggers whatever bell/notification behavior it's\n// configured for) regardless of Bubble Tea's alt-screen rendering state, so\n// this is safe to call as a direct side effect from within Update rather\n// than needing its own tea.Cmd. A package-level var (not a plain func) so\n// tests can swap it out instead of actually beeping the test runner.\nvar ringBell = func() {\n\tfmt.Print(\"\\a\")\n}\n\n// refresh does refreshJobs, plus reloads the open detail view's files (if\n// any) so changes an agent made outside the TUI show up — used by \"ctrl+r\"\n// and by the permanent auto-refresh tick (autoRefreshMsg), which is the\n// whole point of the brief's \"get back to a mg tui session and see what's\n// happened\": the TUI re-reads on its own instead of waiting for a keypress.\n// It also re-reads the project settings, so a .manigot/manigot.json edited\n// outside the TUI (e.g. base branch changed by hand or pulled from origin)\n// is picked up without an app restart. The settings form's own submit path\n// is the only writer to a.projectSettings and it never runs concurrently\n// with refresh() — the auto-refresh tick skips the form states, and ctrl+r\n// isn't routed here while the form is open.\n//\n// Returns the activity-indicator tick cmd refreshJobs produced (a ctrl+r or\n// an auto-refresh tick is a discovery point for runs started outside this\n// session's \"j\" key), so the callers can propagate it.\nfunc (a *App) refresh() tea.Cmd {\n\tspinnerCmd := a.refreshJobs()\n\tif ps, err := project.Load(a.root); err == nil {\n\t\ta.projectSettings = ps\n\t}\n\tif a.detail != nil {\n\t\ta.detail.reload()\n\t\ta.detail.refreshCommits(a.settings.RecentActivityCountValue())\n\t}\n\treturn spinnerCmd\n}\n\n// updateList handles keys while the job list is showing. The cursor-movement\n// keys delegate to the list view (a.list.update); everything else is App\n// routing — view switches, refresh, launches.\nfunc (a *App) updateList(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n\ta.status = \"\" // status is transient — cleared on every key unless a case sets it\n\tswitch msg.String() {\n\tcase \"q\", \"esc\":\n\t\treturn a, tea.Quit\n\tcase \"ctrl+r\":\n\t\t// Refresh first, then report the *post*-refresh job count — the\n\t\t// original ordering (see main), preserved across the\n\t\t// refresh-return-value refactor. The refresh is the discovery point\n\t\t// for runs started\n\t\t// outside this session (its returned tick cmd is propagated below),\n\t\t// and len(a.jobs) must reflect the re-read list, not the stale one.\n\t\tspinnerCmd := a.refresh()\n\t\treturn a, tea.Batch(spinnerCmd, a.setStatus(fmt.Sprintf(\"refreshed · %d job(s)\", len(a.jobs))))\n\tcase \"enter\", \"l\", \"right\":\n\t\tif j, ok := a.list.selectedJob(a.jobs); ok {\n\t\t\ta.detail = newDetailView(j, a.width, a.height)\n\t\t\ta.detail.refreshCommits(a.settings.RecentActivityCountValue())\n\t\t\ta.state = stateDetail\n\t\t}\n\tcase \"j\":\n\t\t// Run mg-jdi against the job under the cursor — the list-view\n\t\t// counterpart of updateDetail's \"j\" case, sharing its already-running\n\t\t// guard (on-disk sidecar + in-session jdiSeen fallback) and its\n\t\t// detached-background launch (launch.Jdi opens no terminal at all).\n\t\t// Status lands in the list footer, and the wording points at the list\n\t\t// badge — the list has no log tab open to point at. No-op when the\n\t\t// list is empty (nothing under the cursor).\n\t\tj, ok := a.list.selectedJob(a.jobs)\n\t\tif !ok {\n\t\t\treturn a, nil\n\t\t}\n\t\tif st, running := a.jdiAlreadyRunning(j); running {\n\t\t\tlabel := \"mg jdi is already running for this job\"\n\t\t\tif st.Agent != \"\" {\n\t\t\t\tlabel += \" @\" + st.Agent\n\t\t\t}\n\t\t\treturn a, a.setStatus(label)\n\t\t}\n\t\tif err := launch.Jdi(j.ID, a.root, a.settings.ProfileValue()); err != nil {\n\t\t\treturn a, a.setStatus(cmdErrorText(err))\n\t\t}\n\t\t// Seed the stop-notification dedup as \"running\" right away (see\n\t\t// updateDetail's \"j\" case for why), then start the activity-indicator\n\t\t// tick chain if it isn't already going.\n\t\ta.jdiSeen[j.Name] = job.JDIRunning\n\t\ta.jdiSeenAt[j.Name] = jdiNow()\n\t\treturn a, tea.Batch(a.startSpinnerIfRunning(), a.setStatus(\"→ mg jdi started in the background — see the list badge\"))\n\tcase \"n\":\n\t\t// Create a new job via the host mg-job command.\n\t\ta.newJob = newNewJobView(a.width, a.height)\n\t\ta.state = stateNewJob\n\tcase \"s\":\n\t\t// Edit the persisted TUI settings: the global personal prefs\n\t\t// (editor, recent activity count, subscription profile) and the\n\t\t// project base branch. Both are seeded from their on-disk files\n\t\t// (see NewApp).\n\t\ta.settingsView = newSettingsView(a.settings, a.projectSettings, a.width, a.height)\n\t\ta.state = stateSettings\n\tcase \"o\":\n\t\t// Launch a bare manigot session (no agent, no job) in a detached\n\t\t// new terminal — a quick ad-hoc change that doesn't belong to any\n\t\t// specific job's workflow. Mirrors updateDetail's agent-launch\n\t\t// reporting so the two launch paths feel consistent in the footer.\n\t\tdesc, err := launch.Quick(a.root, a.settings.ProfileValue(), a.settings.Terminal)\n\t\tif err != nil {\n\t\t\ta.status = cmdErrorText(err)\n\t\t} else {\n\t\t\ta.status = \"→ quick session in \" + desc\n\t\t}\n\tcase \"a\":\n\t\t// Pick any agent and launch it as a jobless quick session — the\n\t\t// native-TUI counterpart to `mg agents` (scripts/agents.sh),\n\t\t// mirroring \"o\" (bare quick session) but for a specific agent.\n\t\t// A discovery failure (e.g. no resolvable manigot checkout) or an\n\t\t// empty agent list degrades to a status line\n\t\t// instead of opening the picker, the same \"never crash on a\n\t\t// host-command error\" convention every other action in this file\n\t\t// follows (cmdErrorText).\n\t\tagents, err := agentlist.Discover(a.root)\n\t\tif err != nil {\n\t\t\ta.status = cmdErrorText(err)\n\t\t} else if len(agents) == 0 {\n\t\t\ta.status = \"no agents found\"\n\t\t} else {\n\t\t\ta.agentsPicker = newAgentsPickerView(agents, a.width, a.height)\n\t\t\ta.state = stateAgents\n\t\t}\n\tdefault:\n\t\t// Cursor movement — the list view's own key handling. \"g\"/\"G\" land\n\t\t// here too, below the routing keys (none of which collide).\n\t\ta.list.update(msg, len(a.jobs))\n\t}\n\treturn a, nil\n}\n\n// updateSettings handles keys in the settings form.\nfunc (a *App) updateSettings(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n\tswitch a.settingsView.update(msg) {\n\tcase stCancel:\n\t\ta.settingsView = nil\n\t\ta.state = stateList\n\tcase stSubmit:\n\t\t// Validate the recent-activity count field first (blank = default;\n\t\t// anything unparseable or outside 1–100 keeps the form open with a\n\t\t// status message and persists nothing). Persist both files — the\n\t\t// global personal prefs (config.Save) and the project base branch\n\t\t// (project.Save). Surface whichever fails first in the form's status,\n\t\t// leaving the form open so the user can retry without retyping; only\n\t\t// update the in-memory copies and return to the list once both\n\t\t// succeed.\n\t\tif _, err := a.settingsView.recentActivityCount(); err != nil {\n\t\t\ta.settingsView.status = cmdErrorText(err)\n\t\t\treturn a, nil\n\t\t}\n\t\ts := a.settingsView.settingsValue()\n\t\tps := a.settingsView.projectValue()\n\t\tif err := config.Save(s); err != nil {\n\t\t\ta.settingsView.status = cmdErrorText(err)\n\t\t\treturn a, nil\n\t\t}\n\t\tif err := project.Save(a.root, ps); err != nil {\n\t\t\ta.settingsView.status = cmdErrorText(err)\n\t\t\treturn a, nil\n\t\t}\n\t\ta.settings = s\n\t\ta.projectSettings = ps\n\t\t// The recent-activity strip's maximum may have just changed — refetch\n\t\t// so the list reflects the new count immediately on return.\n\t\ta.refreshRecentCommits()\n\t\ta.settingsView = nil\n\t\ta.status = \"settings saved\"\n\t\ta.state = stateList\n\t}\n\treturn a, nil\n}\n\n// updateNewJob handles keys in the new-job form.\nfunc (a *App) updateNewJob(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n\tswitch a.newJob.update(msg) {\n\tcase njCancel:\n\t\ta.newJob = nil\n\t\ta.state = stateList\n\tcase njSubmit:\n\t\ttitle := strings.TrimSpace(a.newJob.title.Value())\n\t\tif title == \"\" {\n\t\t\ta.newJob.status = \"title is required\"\n\t\t\treturn a, nil\n\t\t}\n\t\ttyp := a.newJob.typeValue()\n\t\t// In-process job creation (the port of hostcmd.NewJob): the script's\n\t\t// full stdout summary is discarded — the TUI shows its own status\n\t\t// line, matching how the old call ignored the captured output.\n\t\tif _, err := job.CreateJob(a.root, title, job.CreateOptions{Type: typ}, io.Discard); err != nil {\n\t\t\ta.newJob.status = cmdErrorText(err)\n\t\t\treturn a, nil\n\t\t}\n\t\t// Refresh the list so the new job appears, then return to it.\n\t\tif jobs, derr := job.Discover(a.root); derr == nil {\n\t\t\ta.jobs = jobs\n\t\t}\n\t\ta.list.currentBranch, _ = git.CurrentBranch(a.root) // \"\" on detached HEAD / non-repo\n\t\ta.refreshRecentCommits()\n\t\ta.list.cursor = 0 // newest first after Discover's date-desc sort\n\t\ta.status = \"created \\\"\" + title + \"\\\" (\" + typ + \")\"\n\t\ta.newJob = nil\n\t\ta.state = stateList\n\t}\n\treturn a, nil\n}\n\n// updateAgentsPicker handles keys in the \"Launch an agent\" picker opened by\n// \"a\" from the list view.\nfunc (a *App) updateAgentsPicker(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n\tswitch a.agentsPicker.update(msg) {\n\tcase apCancel:\n\t\ta.agentsPicker = nil\n\t\ta.state = stateList\n\tcase apSubmit:\n\t\tagent, ok := a.agentsPicker.selected()\n\t\ta.agentsPicker = nil\n\t\ta.state = stateList\n\t\tif !ok {\n\t\t\treturn a, nil\n\t\t}\n\t\t// Mirrors updateDetail's agent-launch status reporting (\"→ <agent>\n\t\t// in <desc>\") so both launch paths feel consistent in the footer.\n\t\tdesc, err := launch.AgentQuick(agent.Name, a.root, a.settings.ProfileValue(), a.settings.Terminal)\n\t\tif err != nil {\n\t\t\ta.status = cmdErrorText(err)\n\t\t} else {\n\t\t\ta.status = \"→ \" + agent.Name + \" in \" + desc\n\t\t}\n\t}\n\treturn a, nil\n}\n\n// updateGitPanel handles keys in the \"git\" panel opened by \"g\" from the\n// detail view: esc/q cancels back to the detail view; enter dispatches the\n// highlighted action — the same cmds the \"c\" commit-all and \"P\" push-to-origin\n// accelerators run, plus TASK-2's mergeCmd — and then returns to the detail\n// view, where the resulting *Msg's Update case (commitAllMsg / pushMsg /\n// mergeMsg) surfaces the outcome in the status line. The \"g\" key itself is\n// gated on the job having a branch (see updateDetail), so no branch guard is\n// needed here — every action in the panel targets the job's worktree branch.\nfunc (a *App) updateGitPanel(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n\tswitch a.gitPanel.update(msg) {\n\tcase gpCancel:\n\t\ta.gitPanel = nil\n\t\ta.state = stateDetail\n\tcase gpSubmit:\n\t\taction, ok := a.gitPanel.selected()\n\t\ta.gitPanel = nil\n\t\ta.state = stateDetail\n\t\tif !ok || a.detail == nil {\n\t\t\treturn a, nil\n\t\t}\n\t\tswitch action {\n\t\tcase gitActionCommitAll:\n\t\t\treturn a, a.commitAllCmd()\n\t\tcase gitActionPush:\n\t\t\treturn a, a.pushCmd(a.detail.job.Branch)\n\t\tcase gitActionMerge:\n\t\t\treturn a, a.mergeCmd()\n\t\t}\n\t}\n\treturn a, nil\n}\n\n// updateDetail handles keys while a job's files are showing.\nfunc (a *App) updateDetail(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n\tswitch msg.String() {\n\tcase \"esc\", \"backspace\":\n\t\t// Return to the list. Only the job list itself needs refreshing\n\t\t// (a job may have been archived, or its status/title changed) —\n\t\t// reloading the detail view we're about to throw away would be pure\n\t\t// waste, and used to be a real source of lag (see refreshJobs' doc).\n\t\tspinnerCmd := a.refreshJobs()\n\t\ta.detail = nil\n\t\ta.state = stateList\n\t\ta.status = \"refreshed\"\n\t\treturn a, spinnerCmd\n\tcase \"q\":\n\t\treturn a, tea.Quit\n\tcase \"ctrl+r\":\n\t\tspinnerCmd := a.refresh()\n\t\ta.detail.setStatus(\"refreshed\")\n\t\treturn a, tea.Batch(spinnerCmd, a.armStatusExpiry())\n\tcase \"e\":\n\t\t// Only the tabs marked editable in jobFiles (currently brief.md\n\t\t// only) respond — for any other tab this falls through to the\n\t\t// default key handling below, same as any other unbound key.\n\t\tif a.detail.current().editable {\n\t\t\tcmd, err := a.editCmd()\n\t\t\tif err != nil {\n\t\t\t\ta.detail.setStatus(cmdErrorText(err))\n\t\t\t\treturn a, a.armStatusExpiry()\n\t\t\t}\n\t\t\treturn a, cmd\n\t\t}\n\tcase \"D\":\n\t\t// Mark done: not an agent action, so it is handled here rather than\n\t\t// falling into the agentForKey dispatch below. Shows the TUI-side\n\t\t// confirmation (replacing finish-job.sh's subprocess prompts); on\n\t\t// confirmation the lifecycle runs in-process.\n\t\ta.openConfirm(confirmDone)\n\t\treturn a, nil\n\tcase \"j\":\n\t\t// Run mg-jdi: a bigger, composite action like \"D\", not a\n\t\t// single-agent launch, so it's handled here rather than through\n\t\t// agentForKey. Unlike launch.Agent, this starts detached in the\n\t\t// background with no spawned terminal window at all — see launch.Jdi's\n\t\t// own doc for why. Every job now has its own worktree, so there is\n\t\t// no \"wrong branch checked out\" state to guard against\n\t\t// here: mg-jdi resolves its own correct worktree per invocation.\n\t\t// Block a second concurrent launch against the same job — the brief\n\t\t// this job exists for (\"press j ... multiple times\" spawns several\n\t\t// processes with no indication). jdiAlreadyRunning combines the\n\t\t// on-disk sidecar with the in-session dedup map so a press landing\n\t\t// before mg-jdi has written its very first status file is caught\n\t\t// too.","lineStart":1,"lineEnd":1213,"totalLines":1214,"truncated":true}},"title":"src/internal/ui/app.go","time":{"start":1787920073433,"end":1787920073441}},"id":"prt_048574279001rCCzr5y5A0cTrl","sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","messageID":"msg_04857385f0010Mn0WuE1Pm7OYY"}}
