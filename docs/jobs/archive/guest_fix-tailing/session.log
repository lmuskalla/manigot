{"type":"tool_use","timestamp":1787921086026,"sessionID":"ses_fb7999c4fffe1anLtOEgzjXUGJ","part":{"type":"tool","tool":"read","callID":"call_00_HGSqd9TbJ23guvSpSfOR8284","state":{"status":"completed","input":{"filePath":"/workspace/src/cmd/mg/jdioutput.go"},"output":"<path>/workspace/src/cmd/mg/jdioutput.go</path>\n<type>file</type>\n<content>\n1: package main\n2: \n3: import (\n4: \t\"bytes\"\n5: \t\"fmt\"\n6: \t\"io\"\n7: \t\"os\"\n8: \t\"path/filepath\"\n9: \t\"strings\"\n10: \t\"time\"\n11: \n12: \t\"github.com/lmuskalla/manigot/internal/job\"\n13: \t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n14: )\n15: \n16: // sidecarExcludePattern is the .gitignore-syntax line ensureSidecarIgnored\n17: // adds to a project's .git/info/exclude — every job's status sidecar, not\n18: // just one, since the pattern is directory-shaped\n19: // (\".manigot/jdi-status/\"). Rebuilt from the same constants\n20: // (job.ManigotRelDir + job.JDISidecarDirName) the Go path construction\n21: // uses, so the exclude pattern can never drift from where the sidecar is\n22: // actually written.\n23: var sidecarExcludePattern = filepath.ToSlash(filepath.Join(job.ManigotRelDir, job.JDISidecarDirName)) + \"/\"\n24: \n25: // ensureSidecarIgnored appends sidecarExcludePattern to root's\n26: // .git/info/exclude if not already present.\n27: //\n28: // This matters because the status/run.log sidecar lives inside\n29: // the *target project's* .manigot/ — not manigot's own checkout — and the\n30: // whole point of keeping it outside every job's own directory is so it can\n31: // never be swept into an agent's own `git add -A`. That only actually holds\n32: // if *this project's* git configuration excludes it: manigot's own\n33: // .gitignore has no bearing on a project mg-jdi is driving. Rather than\n34: // assume (or silently mutate) the project's own tracked .gitignore,\n35: // .git/info/exclude is the right mechanism — local-only, per-checkout, never\n36: // itself committed — so mg-jdi can guarantee this without touching anything\n37: // the project's own history would ever see. Idempotent: safe to call on\n38: // every mg-jdi run.\n39: //\n40: // Best-effort: a failure here (root isn't a git repo, .git/info isn't\n41: // writable, etc.) is surfaced to the caller to log, but must not abort the\n42: // run — worst case the sidecar risks being swept into a commit, exactly the\n43: // pre-existing behavior before this safeguard existed.\n44: func ensureSidecarIgnored(root string) error {\n45: \texcludePath := filepath.Join(root, \".git\", \"info\", \"exclude\")\n46: \n47: \texisting, err := os.ReadFile(excludePath)\n48: \tswitch {\n49: \tcase err == nil:\n50: \t\tif containsLine(string(existing), sidecarExcludePattern) {\n51: \t\t\treturn nil\n52: \t\t}\n53: \tcase os.IsNotExist(err):\n54: \t\texisting = nil\n55: \tdefault:\n56: \t\treturn err\n57: \t}\n58: \n59: \tif err := os.MkdirAll(filepath.Dir(excludePath), 0o755); err != nil {\n60: \t\treturn err\n61: \t}\n62: \tf, err := os.OpenFile(excludePath, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n63: \tif err != nil {\n64: \t\treturn err\n65: \t}\n66: \tdefer f.Close()\n67: \n68: \tprefix := \"\"\n69: \tif len(existing) > 0 && existing[len(existing)-1] != '\\n' {\n70: \t\tprefix = \"\\n\"\n71: \t}\n72: \t_, err = f.WriteString(prefix + sidecarExcludePattern + \"\\n\")\n73: \treturn err\n74: }\n75: \n76: // containsLine reports whether body has pattern as one of its lines\n77: // (trimmed), so an existing exclude file with the pattern already present —\n78: // however it got there — isn't duplicated on a second mg-jdi run.\n79: func containsLine(body, pattern string) bool {\n80: \tfor _, line := range strings.Split(body, \"\\n\") {\n81: \t\tif strings.TrimSpace(line) == pattern {\n82: \t\t\treturn true\n83: \t\t}\n84: \t}\n85: \treturn false\n86: }\n87: \n88: // openRunLog ensures the sidecar directory (job.JDIStatusDir — shared with\n89: // the status file WriteJDIStatus writes) exists and opens\n90: // (creating if necessary) run.log for appending — a fresh mg-jdi run\n91: // continues the same job's transcript rather than truncating it, so a human\n92: // can see the full history of every run against this job, not just the most\n93: // recent one. It also reports whether the log already had content when it\n94: // was opened (hadContent), which main() feeds to sectionWriter so the very\n95: // first run ever written to a log starts it cleanly without a leading blank\n96: // line (see sectionWriter's own doc).\n97: func openRunLog(root, jobName string) (*os.File, bool, error) {\n98: \tdir := job.JDIStatusDir(root, jobName)\n99: \tif err := os.MkdirAll(dir, 0o755); err != nil {\n100: \t\treturn nil, false, fmt.Errorf(\"create sidecar dir %s: %w\", dir, err)\n101: \t}\n102: \tf, err := os.OpenFile(job.JDIRunLogPath(root, jobName), os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n103: \tif err != nil {\n104: \t\treturn nil, false, fmt.Errorf(\"open run log: %w\", err)\n105: \t}\n106: \tst, err := f.Stat()\n107: \tif err != nil {\n108: \t\tf.Close()\n109: \t\treturn nil, false, fmt.Errorf(\"stat run log: %w\", err)\n110: \t}\n111: \treturn f, st.Size() > 0, nil\n112: }\n113: \n114: // sectionPrefix is the literal every \"=== ... ===\" state-log header in this\n115: // file starts with — the five log* functions (logStarted, logAgentInvoked,\n116: // logInvocation, logJobFinished, logImmediateStop) all emit their event\n117: // headers as a line beginning with it. sectionWriter keys off it so it only\n118: // inserts blank lines between actual sections, never inside one (the agent\n119: // text and stop-reason bodies that follow their headers are separate writes\n120: // that don't match).\n121: var sectionPrefix = []byte(\"===\")\n122: \n123: // sectionWriter is the writer mg-jdi's log destinations (stdout and the\n124: // sidecar run.log) are wrapped in before anything is logged: it inserts a\n125: // blank line before every \"=== ... ===\" section header written through it,\n126: // so the log's events don't get crumbled together — either between the\n127: // state events of a single run, or between consecutive mg-jdi runs of the\n128: // same job appending to the same run.log.\n129: //\n130: // wroteSection seeds the writer with the pre-existing state of the\n131: // underlying destination — whether run.log already had content when it was\n132: // opened (see openRunLog). true means the first header written through this\n133: // writer still needs its separating blank line (it's joining prior runs'\n134: // output); false means this is the very first run ever written to the log,\n135: // and the first header starts it at the top of the file with no leading\n136: // blank line. Either way, every subsequent header gets the blank line.\n137: //\n138: // A non-header write (a header's following reason line, or an invocation's\n139: // agent text, each of which arrives as its own write that does not start\n140: // with sectionPrefix) passes through untouched — it belongs to the section\n141: // that just began. sectionWriter itself never inserts blank lines inside a\n142: // section; any body/header separation beyond the header's own trailing\n143: // newline is the caller's own writes (logInvocation, for one, emits two\n144: // blank lines of its own between the \"finished\" header and the agent text —\n145: // see its doc).\n146: type sectionWriter struct {\n147: \tw            io.Writer\n148: \twroteSection bool\n149: }\n150: \n151: func (s *sectionWriter) Write(p []byte) (int, error) {\n152: \tif bytes.HasPrefix(p, sectionPrefix) {\n153: \t\tif s.wroteSection {\n154: \t\t\tif _, err := io.WriteString(s.w, \"\\n\\n\"); err != nil {\n155: \t\t\t\treturn 0, err\n156: \t\t\t}\n157: \t\t}\n158: \t\ts.wroteSection = true\n159: \t}\n160: \treturn s.w.Write(p)\n161: }\n162: \n163: // logStarted writes a \"mg jdi started\" event to w, once, at the very top of\n164: // a run — main()'s first write to logDest, before Run is even\n165: // invoked, so a human watching run.log sees confirmation the run began\n166: // immediately, rather than the log staying empty until the first agent\n167: // invocation finishes. Mirrors\n168: // logImmediateStop's \"=== ... ===\" header shape so every event in the log\n169: // looks consistent.\n170: func logStarted(w io.Writer, jobName, profile string) {\n171: \tfmt.Fprintf(w, \"=== %s mg jdi started: job %s, profile %s ===\\n\", time.Now().Format(time.RFC3339), jobName, profile)\n172: }\n173: \n174: // logAgentInvoked writes an \"agent invoked\" event to w immediately before\n175: // Run launches an agent — distinct from logInvocation's own\n176: // post-run header below, so a human watching run.log sees an invoked\n177: // header right away rather than waiting for the (possibly long-running)\n178: // invocation to finish before anything at all appears for it. attempt is\n179: // that agent's invocation count within the run — per agent, not per run —\n180: // so the first call of every agent is attempt 1, and a bounced-back\n181: // agent's second call is attempt 2.\n182: func logAgentInvoked(w io.Writer, agent string, attempt int) {\n183: \tfmt.Fprintf(w, \"=== %s %s invoked (attempt %d) ===\\n\", time.Now().Format(time.RFC3339), agent, attempt)\n184: }\n185: \n186: // logJobFinished writes a \"job finished\" event to w at Run's loop exit\n187: // — both terminal outcomes, StopFinished and StopNeedsHuman.\n188: //\n189: // includeReason is false only for the stop-before-any-agent-ran case: that\n190: // path has already printed reason via logImmediateStop immediately above,\n191: // so repeating it here would print the exact same line twice in a row.\n192: // Every other call site has never logged reason before this point, so it's\n193: // included.\n194: func logJobFinished(w io.Writer, kind orchestrate.Kind, reason string, includeReason bool) {\n195: \tfmt.Fprintf(w, \"=== %s mg jdi finished: %s ===\\n\", time.Now().Format(time.RFC3339), kind)\n196: \tif includeReason && reason != \"\" {\n197: \t\tfmt.Fprintln(w, reason)\n198: \t}\n199: }\n200: \n201: // isDuplicateOutput reports whether fileContent — the just-run agent's\n202: // target file, read fresh after this invocation — appears, once both sides\n203: // are trimmed and internal whitespace is collapsed, as a substring of text —\n204: // the agent's own response (the \"already the same ... skip it\" rule).\n205: // Substring rather than exact equality, since a real\n206: // response typically echoes the file's content plus its own surrounding\n207: // commentary (a leading summary, a trailing \"done!\", etc.).\n208: //\n209: // An empty fileContent (the target file doesn't exist yet, or is itself\n210: // empty) never counts as a duplicate — trivially \"contained\" in anything,\n211: // but not a meaningful match.\n212: func isDuplicateOutput(text, fileContent string) bool {\n213: \tnormFile := normalizeWhitespace(fileContent)\n214: \tif normFile == \"\" {\n215: \t\treturn false\n216: \t}\n217: \treturn strings.Contains(normalizeWhitespace(text), normFile)\n218: }\n219: \n220: // normalizeWhitespace collapses s to single-space-separated fields, so\n221: // isDuplicateOutput's comparison isn't tripped up by incidental reformatting\n222: // (extra blank lines, trailing spaces, etc.) between what's on disk and what\n223: // an agent echoed back.\n224: func normalizeWhitespace(s string) string {\n225: \treturn strings.Join(strings.Fields(s), \" \")\n226: }\n227: \n228: // logInvocation writes one agent invocation's captured output to w — Run's\n229: // fan-out target, which main() builds as an io.MultiWriter of\n230: // mg-jdi's own stdout and the sidecar's run.log, so both destinations get\n231: // the exact same section: a \"=== <timestamp> <agent> finished (attempt N)\n232: // ===\" header — paired with logAgentInvoked's own header just before this\n233: // invocation started so a reader sees an invoked/finished\n234: // pair per agent call rather than one ambiguous header. N is that agent's\n235: // invocation count within the run — per agent, not per run — so the first\n236: // call of every agent is attempt 1, and a bounced-back agent's second call\n237: // is attempt 2. Then the agent's extracted final-response text\n238: // (orchestrate.ResultText) — not the raw --output-format stream-json blob,\n239: // so a human reading either destination sees prose, not JSON.\n240: //\n241: // Two blank lines separate the \"finished\" header from the agent's output\n242: // (brief: jdi logs new line): without them the output reads as glued to the\n243: // finished statement — on a wrapped terminal, and in the TUI's log tab,\n244: // which renders run.log's raw content — as if it began on the same line.\n245: // The blank lines are written unconditionally, before whichever body variant\n246: // follows (real text, \"(no output)\", or the dedup \"(output matches ...,\n247: // omitted)\" note below), so the separation is the same in every case.\n248: //\n249: // Honesty note (carried into scripts/entrypoint.sh's own comment): this is\n250: // exactly the agent's *final response text* per invocation — the prose\n251: // ResultText extracts from whatever --print shape produced it — not a\n252: // blow-by-blow of every tool call/file edit. The blow-by-blow itself is not\n253: // lost anymore: the raw captured output (the full step-level event stream\n254: // since --output-format stream-json) is streamed verbatim into the job's\n255: // session.log live during the invocation (see openSessionLog and Run) —\n256: // run.log is the summary, session.log is the truth.\n257: //\n258: // targetFile/targetContent are the just-run agent's expected job\n259: // file and its content read fresh after the invocation (see\n260: // orchestrate.AgentTargetFile) — the caller's responsibility, since it\n261: // already has j.Dir\n262: // on hand. When the response text turns out to be a duplicate of that file\n263: // (isDuplicateOutput), the body is replaced with a short note instead of the\n264: // full (possibly large) text — the header is unaffected, so a reader still\n265: // sees an invoked/finished pair either way. targetFile == \"\" (e.g. an\n266: // unrecognized agent, or the file couldn't be read) simply skips the check.\n267: func logInvocation(w io.Writer, agent string, attempt int, raw []byte, targetFile, targetContent string) {\n268: \t// \"\\n\\n\\n\" = the header's own trailing newline plus two blank lines, so\n269: \t// the agent's output starts two lines below the \"finished\" statement\n270: \t// (brief: jdi logs new line).\n271: \tfmt.Fprintf(w, \"=== %s %s finished (attempt %d) ===\\n\\n\\n\", time.Now().Format(time.RFC3339), agent, attempt)\n272: \ttext := orchestrate.ResultText(raw)\n273: \tswitch {\n274: \tcase text == \"\":\n275: \t\ttext = \"(no output)\"\n276: \tcase targetFile != \"\" && isDuplicateOutput(text, targetContent):\n277: \t\ttext = fmt.Sprintf(\"(output matches %s, omitted)\", targetFile)\n278: \t}\n279: \tif text[len(text)-1] != '\\n' {\n280: \t\ttext += \"\\n\"\n281: \t}\n282: \tfmt.Fprint(w, text)\n283: }\n284: \n285: // openSessionLog opens the job's session.log for live appending and writes\n286: // the section header for the invocation about to start — a blank-line\n287: // separator (skipped for the very first section ever written to a fresh\n288: // file) plus the \"=== <RFC3339 timestamp> <agent> (attempt N) ===\" header,\n289: // the same sectioned shape appendSessionLog used to write post-hoc. The\n290: // returned *sessionLog is the writer the invocation's raw bytes are tee'd\n291: // into as they arrive (see commandAgentRunner.Run's io.MultiWriter), so the\n292: // verbose log grows live during the run instead of only after it finishes —\n293: // the whole point of the tailing fix. Callers Close it after the invocation\n294: // so the trailing-newline guarantee holds.\n295: func openSessionLog(path, agent string, attempt int) (*sessionLog, error) {\n296: \tf, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n297: \tif err != nil {\n298: \t\treturn nil, err\n299: \t}\n300: \n301: \t// Blank-line separator between sections — the very first section ever\n302: \t// written to a fresh file starts at the top instead.\n303: \tif st, err := f.Stat(); err != nil {\n304: \t\tf.Close()\n305: \t\treturn nil, err\n306: \t} else if st.Size() > 0 {\n307: \t\tif _, err := io.WriteString(f, \"\\n\"); err != nil {\n308: \t\t\tf.Close()\n309: \t\t\treturn nil, err\n310: \t\t}\n311: \t}\n312: \n313: \tif _, err := fmt.Fprintf(f, \"=== %s %s (attempt %d) ===\\n\", time.Now().Format(time.RFC3339), agent, attempt); err != nil {\n314: \t\tf.Close()\n315: \t\treturn nil, err\n316: \t}\n317: \treturn &sessionLog{f: f}, nil\n318: }\n319: \n320: // sessionLog is the live, per-invocation writer behind the job's session.log\n321: // (docs/jobs/<id>_<slug>/session.log): it owns the open file handle and\n322: // tracks the last byte written through it, so Close can guarantee the\n323: // section ends with a newline — the same trailing-newline guarantee\n324: // appendSessionLog used to make post-hoc, without needing to read the file\n325: // back. The file is opened in append mode, so concurrent appends (a second\n326: // mg-jdi run against the same job, or the next invocation's own section)\n327: // can never overwrite this section.\n328: type sessionLog struct {\n329: \tf        *os.File\n330: \tlastByte byte // last byte written through this writer; 0 when nothing was written\n331: }\n332: \n333: // Write appends p to the underlying file and records the last byte, so Close\n334: // knows whether a trailing newline is still needed.\n335: func (s *sessionLog) Write(p []byte) (int, error) {\n336: \tif len(p) > 0 {\n337: \t\ts.lastByte = p[len(p)-1]\n338: \t}\n339: \treturn s.f.Write(p)\n340: }\n341: \n342: // Close finishes the section and closes the file: a trailing newline is\n343: // written when the last write didn't already end with one, so the next\n344: // section's header never glues to this section's raw output. Nothing written\n345: // at all (an invocation that produced no output) leaves the header's own\n346: // trailing newline as the section end.\n347: func (s *sessionLog) Close() error {\n348: \tif s.lastByte != 0 && s.lastByte != '\\n' {\n349: \t\tif _, err := s.f.Write([]byte(\"\\n\")); err != nil {\n350: \t\t\ts.f.Close()\n351: \t\t\treturn err\n352: \t\t}\n353: \t}\n354: \treturn s.f.Close()\n355: }\n356: \n357: // ensureSessionLogFile creates the job's session.log if it doesn't exist yet\n358: // (an empty file is fine — the per-invocation openSessionLog appends the\n359: // first section header on demand), so the TUI's \"l\" tail gate — the file's\n360: // existence — is stable from the moment an mg-jdi run begins, mirroring\n361: // run.log's own up-front creation in openRunLog. Best-effort: a failure only\n362: // warns; the loop still creates the file per invocation.\n363: func ensureSessionLogFile(path string) error {\n364: \tf, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n365: \tif err != nil {\n366: \t\treturn err\n367: \t}\n368: \treturn f.Close()\n369: }\n370: \n371: // logImmediateStop writes an \"immediate stop\" note to w — orchestrate.Next\n372: // returning a Stop* decision before any agent has ever been invoked (e.g.\n373: // job.StageDefine with an unwritten brief.md), the one case logInvocation\n374: // never runs for. Without this, run.log would be left at 0 bytes for that\n375: // stop, itself confusing\n376: // independent of whether the stop was the correct call. Mirrors\n377: // logInvocation's \"=== ... ===\" header shape so both look consistent in the\n378: // same log, but names the stop instead of an agent/attempt.\n379: func logImmediateStop(w io.Writer, reason string) {\n380: \tfmt.Fprintf(w, \"=== %s mg jdi stopped before running any agent ===\\n\", time.Now().Format(time.RFC3339))\n381: \tfmt.Fprintln(w, reason)\n382: }\n\n(End of file - total 382 lines)\n</content>","metadata":{"preview":"package main\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n)\n\n// sidecarExcludePattern is the .gitignore-syntax line ensureSidecarIgnored\n// adds to a project's .git/info/exclude — every job's status sidecar, not\n// just one, since the pattern is directory-shaped\n// (\".manigot/jdi-status/\"). Rebuilt from the same constants\n// (job.ManigotRelDir + job.JDISidecarDirName) the Go path construction","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/cmd/mg/jdioutput.go","text":"package main\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n)\n\n// sidecarExcludePattern is the .gitignore-syntax line ensureSidecarIgnored\n// adds to a project's .git/info/exclude — every job's status sidecar, not\n// just one, since the pattern is directory-shaped\n// (\".manigot/jdi-status/\"). Rebuilt from the same constants\n// (job.ManigotRelDir + job.JDISidecarDirName) the Go path construction\n// uses, so the exclude pattern can never drift from where the sidecar is\n// actually written.\nvar sidecarExcludePattern = filepath.ToSlash(filepath.Join(job.ManigotRelDir, job.JDISidecarDirName)) + \"/\"\n\n// ensureSidecarIgnored appends sidecarExcludePattern to root's\n// .git/info/exclude if not already present.\n//\n// This matters because the status/run.log sidecar lives inside\n// the *target project's* .manigot/ — not manigot's own checkout — and the\n// whole point of keeping it outside every job's own directory is so it can\n// never be swept into an agent's own `git add -A`. That only actually holds\n// if *this project's* git configuration excludes it: manigot's own\n// .gitignore has no bearing on a project mg-jdi is driving. Rather than\n// assume (or silently mutate) the project's own tracked .gitignore,\n// .git/info/exclude is the right mechanism — local-only, per-checkout, never\n// itself committed — so mg-jdi can guarantee this without touching anything\n// the project's own history would ever see. Idempotent: safe to call on\n// every mg-jdi run.\n//\n// Best-effort: a failure here (root isn't a git repo, .git/info isn't\n// writable, etc.) is surfaced to the caller to log, but must not abort the\n// run — worst case the sidecar risks being swept into a commit, exactly the\n// pre-existing behavior before this safeguard existed.\nfunc ensureSidecarIgnored(root string) error {\n\texcludePath := filepath.Join(root, \".git\", \"info\", \"exclude\")\n\n\texisting, err := os.ReadFile(excludePath)\n\tswitch {\n\tcase err == nil:\n\t\tif containsLine(string(existing), sidecarExcludePattern) {\n\t\t\treturn nil\n\t\t}\n\tcase os.IsNotExist(err):\n\t\texisting = nil\n\tdefault:\n\t\treturn err\n\t}\n\n\tif err := os.MkdirAll(filepath.Dir(excludePath), 0o755); err != nil {\n\t\treturn err\n\t}\n\tf, err := os.OpenFile(excludePath, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer f.Close()\n\n\tprefix := \"\"\n\tif len(existing) > 0 && existing[len(existing)-1] != '\\n' {\n\t\tprefix = \"\\n\"\n\t}\n\t_, err = f.WriteString(prefix + sidecarExcludePattern + \"\\n\")\n\treturn err\n}\n\n// containsLine reports whether body has pattern as one of its lines\n// (trimmed), so an existing exclude file with the pattern already present —\n// however it got there — isn't duplicated on a second mg-jdi run.\nfunc containsLine(body, pattern string) bool {\n\tfor _, line := range strings.Split(body, \"\\n\") {\n\t\tif strings.TrimSpace(line) == pattern {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// openRunLog ensures the sidecar directory (job.JDIStatusDir — shared with\n// the status file WriteJDIStatus writes) exists and opens\n// (creating if necessary) run.log for appending — a fresh mg-jdi run\n// continues the same job's transcript rather than truncating it, so a human\n// can see the full history of every run against this job, not just the most\n// recent one. It also reports whether the log already had content when it\n// was opened (hadContent), which main() feeds to sectionWriter so the very\n// first run ever written to a log starts it cleanly without a leading blank\n// line (see sectionWriter's own doc).\nfunc openRunLog(root, jobName string) (*os.File, bool, error) {\n\tdir := job.JDIStatusDir(root, jobName)\n\tif err := os.MkdirAll(dir, 0o755); err != nil {\n\t\treturn nil, false, fmt.Errorf(\"create sidecar dir %s: %w\", dir, err)\n\t}\n\tf, err := os.OpenFile(job.JDIRunLogPath(root, jobName), os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n\tif err != nil {\n\t\treturn nil, false, fmt.Errorf(\"open run log: %w\", err)\n\t}\n\tst, err := f.Stat()\n\tif err != nil {\n\t\tf.Close()\n\t\treturn nil, false, fmt.Errorf(\"stat run log: %w\", err)\n\t}\n\treturn f, st.Size() > 0, nil\n}\n\n// sectionPrefix is the literal every \"=== ... ===\" state-log header in this\n// file starts with — the five log* functions (logStarted, logAgentInvoked,\n// logInvocation, logJobFinished, logImmediateStop) all emit their event\n// headers as a line beginning with it. sectionWriter keys off it so it only\n// inserts blank lines between actual sections, never inside one (the agent\n// text and stop-reason bodies that follow their headers are separate writes\n// that don't match).\nvar sectionPrefix = []byte(\"===\")\n\n// sectionWriter is the writer mg-jdi's log destinations (stdout and the\n// sidecar run.log) are wrapped in before anything is logged: it inserts a\n// blank line before every \"=== ... ===\" section header written through it,\n// so the log's events don't get crumbled together — either between the\n// state events of a single run, or between consecutive mg-jdi runs of the\n// same job appending to the same run.log.\n//\n// wroteSection seeds the writer with the pre-existing state of the\n// underlying destination — whether run.log already had content when it was\n// opened (see openRunLog). true means the first header written through this\n// writer still needs its separating blank line (it's joining prior runs'\n// output); false means this is the very first run ever written to the log,\n// and the first header starts it at the top of the file with no leading\n// blank line. Either way, every subsequent header gets the blank line.\n//\n// A non-header write (a header's following reason line, or an invocation's\n// agent text, each of which arrives as its own write that does not start\n// with sectionPrefix) passes through untouched — it belongs to the section\n// that just began. sectionWriter itself never inserts blank lines inside a\n// section; any body/header separation beyond the header's own trailing\n// newline is the caller's own writes (logInvocation, for one, emits two\n// blank lines of its own between the \"finished\" header and the agent text —\n// see its doc).\ntype sectionWriter struct {\n\tw            io.Writer\n\twroteSection bool\n}\n\nfunc (s *sectionWriter) Write(p []byte) (int, error) {\n\tif bytes.HasPrefix(p, sectionPrefix) {\n\t\tif s.wroteSection {\n\t\t\tif _, err := io.WriteString(s.w, \"\\n\\n\"); err != nil {\n\t\t\t\treturn 0, err\n\t\t\t}\n\t\t}\n\t\ts.wroteSection = true\n\t}\n\treturn s.w.Write(p)\n}\n\n// logStarted writes a \"mg jdi started\" event to w, once, at the very top of\n// a run — main()'s first write to logDest, before Run is even\n// invoked, so a human watching run.log sees confirmation the run began\n// immediately, rather than the log staying empty until the first agent\n// invocation finishes. Mirrors\n// logImmediateStop's \"=== ... ===\" header shape so every event in the log\n// looks consistent.\nfunc logStarted(w io.Writer, jobName, profile string) {\n\tfmt.Fprintf(w, \"=== %s mg jdi started: job %s, profile %s ===\\n\", time.Now().Format(time.RFC3339), jobName, profile)\n}\n\n// logAgentInvoked writes an \"agent invoked\" event to w immediately before\n// Run launches an agent — distinct from logInvocation's own\n// post-run header below, so a human watching run.log sees an invoked\n// header right away rather than waiting for the (possibly long-running)\n// invocation to finish before anything at all appears for it. attempt is\n// that agent's invocation count within the run — per agent, not per run —\n// so the first call of every agent is attempt 1, and a bounced-back\n// agent's second call is attempt 2.\nfunc logAgentInvoked(w io.Writer, agent string, attempt int) {\n\tfmt.Fprintf(w, \"=== %s %s invoked (attempt %d) ===\\n\", time.Now().Format(time.RFC3339), agent, attempt)\n}\n\n// logJobFinished writes a \"job finished\" event to w at Run's loop exit\n// — both terminal outcomes, StopFinished and StopNeedsHuman.\n//\n// includeReason is false only for the stop-before-any-agent-ran case: that\n// path has already printed reason via logImmediateStop immediately above,\n// so repeating it here would print the exact same line twice in a row.\n// Every other call site has never logged reason before this point, so it's\n// included.\nfunc logJobFinished(w io.Writer, kind orchestrate.Kind, reason string, includeReason bool) {\n\tfmt.Fprintf(w, \"=== %s mg jdi finished: %s ===\\n\", time.Now().Format(time.RFC3339), kind)\n\tif includeReason && reason != \"\" {\n\t\tfmt.Fprintln(w, reason)\n\t}\n}\n\n// isDuplicateOutput reports whether fileContent — the just-run agent's\n// target file, read fresh after this invocation — appears, once both sides\n// are trimmed and internal whitespace is collapsed, as a substring of text —\n// the agent's own response (the \"already the same ... skip it\" rule).\n// Substring rather than exact equality, since a real\n// response typically echoes the file's content plus its own surrounding\n// commentary (a leading summary, a trailing \"done!\", etc.).\n//\n// An empty fileContent (the target file doesn't exist yet, or is itself\n// empty) never counts as a duplicate — trivially \"contained\" in anything,\n// but not a meaningful match.\nfunc isDuplicateOutput(text, fileContent string) bool {\n\tnormFile := normalizeWhitespace(fileContent)\n\tif normFile == \"\" {\n\t\treturn false\n\t}\n\treturn strings.Contains(normalizeWhitespace(text), normFile)\n}\n\n// normalizeWhitespace collapses s to single-space-separated fields, so\n// isDuplicateOutput's comparison isn't tripped up by incidental reformatting\n// (extra blank lines, trailing spaces, etc.) between what's on disk and what\n// an agent echoed back.\nfunc normalizeWhitespace(s string) string {\n\treturn strings.Join(strings.Fields(s), \" \")\n}\n\n// logInvocation writes one agent invocation's captured output to w — Run's\n// fan-out target, which main() builds as an io.MultiWriter of\n// mg-jdi's own stdout and the sidecar's run.log, so both destinations get\n// the exact same section: a \"=== <timestamp> <agent> finished (attempt N)\n// ===\" header — paired with logAgentInvoked's own header just before this\n// invocation started so a reader sees an invoked/finished\n// pair per agent call rather than one ambiguous header. N is that agent's\n// invocation count within the run — per agent, not per run — so the first\n// call of every agent is attempt 1, and a bounced-back agent's second call\n// is attempt 2. Then the agent's extracted final-response text\n// (orchestrate.ResultText) — not the raw --output-format stream-json blob,\n// so a human reading either destination sees prose, not JSON.\n//\n// Two blank lines separate the \"finished\" header from the agent's output\n// (brief: jdi logs new line): without them the output reads as glued to the\n// finished statement — on a wrapped terminal, and in the TUI's log tab,\n// which renders run.log's raw content — as if it began on the same line.\n// The blank lines are written unconditionally, before whichever body variant\n// follows (real text, \"(no output)\", or the dedup \"(output matches ...,\n// omitted)\" note below), so the separation is the same in every case.\n//\n// Honesty note (carried into scripts/entrypoint.sh's own comment): this is\n// exactly the agent's *final response text* per invocation — the prose\n// ResultText extracts from whatever --print shape produced it — not a\n// blow-by-blow of every tool call/file edit. The blow-by-blow itself is not\n// lost anymore: the raw captured output (the full step-level event stream\n// since --output-format stream-json) is streamed verbatim into the job's\n// session.log live during the invocation (see openSessionLog and Run) —\n// run.log is the summary, session.log is the truth.\n//\n// targetFile/targetContent are the just-run agent's expected job\n// file and its content read fresh after the invocation (see\n// orchestrate.AgentTargetFile) — the caller's responsibility, since it\n// already has j.Dir\n// on hand. When the response text turns out to be a duplicate of that file\n// (isDuplicateOutput), the body is replaced with a short note instead of the\n// full (possibly large) text — the header is unaffected, so a reader still\n// sees an invoked/finished pair either way. targetFile == \"\" (e.g. an\n// unrecognized agent, or the file couldn't be read) simply skips the check.\nfunc logInvocation(w io.Writer, agent string, attempt int, raw []byte, targetFile, targetContent string) {\n\t// \"\\n\\n\\n\" = the header's own trailing newline plus two blank lines, so\n\t// the agent's output starts two lines below the \"finished\" statement\n\t// (brief: jdi logs new line).\n\tfmt.Fprintf(w, \"=== %s %s finished (attempt %d) ===\\n\\n\\n\", time.Now().Format(time.RFC3339), agent, attempt)\n\ttext := orchestrate.ResultText(raw)\n\tswitch {\n\tcase text == \"\":\n\t\ttext = \"(no output)\"\n\tcase targetFile != \"\" && isDuplicateOutput(text, targetContent):\n\t\ttext = fmt.Sprintf(\"(output matches %s, omitted)\", targetFile)\n\t}\n\tif text[len(text)-1] != '\\n' {\n\t\ttext += \"\\n\"\n\t}\n\tfmt.Fprint(w, text)\n}\n\n// openSessionLog opens the job's session.log for live appending and writes\n// the section header for the invocation about to start — a blank-line\n// separator (skipped for the very first section ever written to a fresh\n// file) plus the \"=== <RFC3339 timestamp> <agent> (attempt N) ===\" header,\n// the same sectioned shape appendSessionLog used to write post-hoc. The\n// returned *sessionLog is the writer the invocation's raw bytes are tee'd\n// into as they arrive (see commandAgentRunner.Run's io.MultiWriter), so the\n// verbose log grows live during the run instead of only after it finishes —\n// the whole point of the tailing fix. Callers Close it after the invocation\n// so the trailing-newline guarantee holds.\nfunc openSessionLog(path, agent string, attempt int) (*sessionLog, error) {\n\tf, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\t// Blank-line separator between sections — the very first section ever\n\t// written to a fresh file starts at the top instead.\n\tif st, err := f.Stat(); err != nil {\n\t\tf.Close()\n\t\treturn nil, err\n\t} else if st.Size() > 0 {\n\t\tif _, err := io.WriteString(f, \"\\n\"); err != nil {\n\t\t\tf.Close()\n\t\t\treturn nil, err\n\t\t}\n\t}\n\n\tif _, err := fmt.Fprintf(f, \"=== %s %s (attempt %d) ===\\n\", time.Now().Format(time.RFC3339), agent, attempt); err != nil {\n\t\tf.Close()\n\t\treturn nil, err\n\t}\n\treturn &sessionLog{f: f}, nil\n}\n\n// sessionLog is the live, per-invocation writer behind the job's session.log\n// (docs/jobs/<id>_<slug>/session.log): it owns the open file handle and\n// tracks the last byte written through it, so Close can guarantee the\n// section ends with a newline — the same trailing-newline guarantee\n// appendSessionLog used to make post-hoc, without needing to read the file\n// back. The file is opened in append mode, so concurrent appends (a second\n// mg-jdi run against the same job, or the next invocation's own section)\n// can never overwrite this section.\ntype sessionLog struct {\n\tf        *os.File\n\tlastByte byte // last byte written through this writer; 0 when nothing was written\n}\n\n// Write appends p to the underlying file and records the last byte, so Close\n// knows whether a trailing newline is still needed.\nfunc (s *sessionLog) Write(p []byte) (int, error) {\n\tif len(p) > 0 {\n\t\ts.lastByte = p[len(p)-1]\n\t}\n\treturn s.f.Write(p)\n}\n\n// Close finishes the section and closes the file: a trailing newline is\n// written when the last write didn't already end with one, so the next\n// section's header never glues to this section's raw output. Nothing written\n// at all (an invocation that produced no output) leaves the header's own\n// trailing newline as the section end.\nfunc (s *sessionLog) Close() error {\n\tif s.lastByte != 0 && s.lastByte != '\\n' {\n\t\tif _, err := s.f.Write([]byte(\"\\n\")); err != nil {\n\t\t\ts.f.Close()\n\t\t\treturn err\n\t\t}\n\t}\n\treturn s.f.Close()\n}\n\n// ensureSessionLogFile creates the job's session.log if it doesn't exist yet\n// (an empty file is fine — the per-invocation openSessionLog appends the\n// first section header on demand), so the TUI's \"l\" tail gate — the file's\n// existence — is stable from the moment an mg-jdi run begins, mirroring\n// run.log's own up-front creation in openRunLog. Best-effort: a failure only\n// warns; the loop still creates the file per invocation.\nfunc ensureSessionLogFile(path string) error {\n\tf, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn f.Close()\n}\n\n// logImmediateStop writes an \"immediate stop\" note to w — orchestrate.Next\n// returning a Stop* decision before any agent has ever been invoked (e.g.\n// job.StageDefine with an unwritten brief.md), the one case logInvocation\n// never runs for. Without this, run.log would be left at 0 bytes for that\n// stop, itself confusing\n// independent of whether the stop was the correct call. Mirrors\n// logInvocation's \"=== ... ===\" header shape so both look consistent in the\n// same log, but names the stop instead of an agent/attempt.\nfunc logImmediateStop(w io.Writer, reason string) {\n\tfmt.Fprintf(w, \"=== %s mg jdi stopped before running any agent ===\\n\", time.Now().Format(time.RFC3339))\n\tfmt.Fprintln(w, reason)\n}","lineStart":1,"lineEnd":382,"totalLines":382,"truncated":false}},"title":"src/cmd/mg/jdioutput.go","time":{"start":1787921086021,"end":1787921086024}},"id":"prt_04866b5cf0016QbBETx5N7NpP5","sessionID":"ses_fb7999c4fffe1anLtOEgzjXUGJ","messageID":"msg_04866ae500019QS2BRl6P2ABMZ"}}
