{"type":"tool_use","timestamp":1787919601473,"sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","part":{"type":"tool","tool":"read","callID":"call_00_kVNzKaiREzcCDFcA7nu80791","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/orchestrate/orchestrate.go"},"output":"<path>/workspace/src/internal/orchestrate/orchestrate.go</path>\n<type>file</type>\n<content>\n1: // Package orchestrate decides which agent mg-jdi should run next for a job,\n2: // or whether it should stop — the agent-sequence orchestration logic.\n3: //\n4: // Next is a pure function of state already visible on disk/in git: a job's\n5: // job.Stage(), how many verdict commits exist on its branch\n6: // (git.CountVerdictCommits), and whether the branch tip is itself one of\n7: // those verdict commits (git.LatestCommitIsVerdict). No new state file is\n8: // needed, and mg-jdi never has to trust in-memory state across loop\n9: // iterations — every decision re-derives cleanly from what's already\n10: // committed, so re-running mg-jdi against the same job after it was killed\n11: // mid-loop is always safe.\n12: package orchestrate\n13: \n14: import (\n15: \t\"github.com/lmuskalla/manigot/internal/agents\"\n16: \t\"github.com/lmuskalla/manigot/internal/job\"\n17: )\n18: \n19: // Kind is what mg-jdi should do next.\n20: type Kind int\n21: \n22: const (\n23: \t// RunAgent means launch the agent named in Decision.Agent next.\n24: \tRunAgent Kind = iota\n25: \t// StopFinished means the job's verdict is APPROVED — mg-jdi's work is\n26: \t// done (it does not auto-merge; see the brief's completion criteria).\n27: \tStopFinished\n28: \t// StopNeedsHuman means mg-jdi cannot safely continue unattended and\n29: \t// must hand control back to a human.\n30: \tStopNeedsHuman\n31: )\n32: \n33: func (k Kind) String() string {\n34: \tswitch k {\n35: \tcase RunAgent:\n36: \t\treturn \"run-agent\"\n37: \tcase StopFinished:\n38: \t\treturn \"stop-finished\"\n39: \tcase StopNeedsHuman:\n40: \t\treturn \"stop-needs-human\"\n41: \tdefault:\n42: \t\treturn \"unknown\"\n43: \t}\n44: }\n45: \n46: // Decision is Next's result.\n47: type Decision struct {\n48: \t// Kind is what to do.\n49: \tKind Kind\n50: \t// Agent is set only when Kind == RunAgent: \"analyst\", \"developer\", or\n51: \t// \"reviewer\" — see Sequence.\n52: \tAgent string\n53: \t// Reason is a short, human-readable explanation, always set — surfaced\n54: \t// in mg-jdi's own log/status output.\n55: \tReason string\n56: }\n57: \n58: // Sequence is the fixed, uniform mg-jdi agent order: the same for every job.Type — feature, fix, and chore all drive\n59: // through analyst → developer → reviewer. Not branched on Job.Type anywhere\n60: // in this package. Keyed off the agents package constants so a rename breaks\n61: // the build.\n62: var Sequence = []string{agents.Analyst, agents.Developer, agents.Reviewer}\n63: \n64: // AgentTargetFile maps each driven agent (Sequence) to the job file it's\n65: // expected to have written by the time its invocation returns — mg-jdi's\n66: // output-dedup check reads this file fresh off disk (via j.Dir) to compare\n67: // against the agent's own response text. Kept next to Sequence so the two\n68: // can't drift.\n69: var AgentTargetFile = map[string]string{\n70: \tagents.Analyst:   \"tasks.md\",\n71: \tagents.Developer: \"implementation.md\",\n72: \tagents.Reviewer:  \"verdict.md\",\n73: }\n74: \n75: // Next decides what mg-jdi should do next for a job.\n76: //\n77: // verdictRounds is git.CountVerdictCommits(root, branch, jobID) — how many\n78: // \"[ID] verdict: …\" commits exist on the job's branch. latestCommitIsVerdict\n79: // is git.LatestCommitIsVerdict(root, branch, jobID) — whether the branch tip\n80: // is itself one of those commits, which is what lets StageImplement's two\n81: // very different situations be told apart: a rejection @developer hasn't\n82: // responded to yet (tip is the verdict commit) versus one it already has\n83: // (something newer sits on top of it).\n84: func Next(stage job.Stage, verdictRounds int, latestCommitIsVerdict bool) Decision {\n85: \tswitch stage {\n86: \tcase job.StageDefine:\n87: \t\t// brief.md itself isn't written — writing it is not any of the three\n88: \t\t// driven agents' job (a human fills in brief.md; @analyst starts\n89: \t\t// from it, per agents/analyst.md).\n90: \t\treturn Decision{Kind: StopNeedsHuman, Reason: \"brief.md is not written yet\"}\n91: \n92: \tcase job.StagePlan:\n93: \t\treturn Decision{Kind: RunAgent, Agent: agents.Analyst, Reason: \"brief.md written, tasks.md not written yet\"}\n94: \n95: \tcase job.StageReview:\n96: \t\treturn Decision{Kind: RunAgent, Agent: agents.Reviewer, Reason: \"implementation.md written, verdict.md not written yet\"}\n97: \n98: \tcase job.StageFinished:\n99: \t\treturn Decision{Kind: StopFinished, Reason: \"verdict.md's Overall verdict is APPROVED\"}\n100: \n101: \tcase job.StageImplement:\n102: \t\tswitch {\n103: \t\tcase verdictRounds == 0:\n104: \t\t\t// Either the very first pass (tasks.md written, implementation.md\n105: \t\t\t// not yet), or a job that started implementation but hasn't been\n106: \t\t\t// reviewed at all yet — either way, it's @developer's turn.\n107: \t\t\treturn Decision{Kind: RunAgent, Agent: agents.Developer, Reason: \"tasks.md written, no verdict yet\"}\n108: \t\tcase verdictRounds >= 2:\n109: \t\t\t// Two rejections already happened (a third could only exist if\n110: \t\t\t// job.Stage() were still StageImplement after a second rejection,\n111: \t\t\t// which is exactly this case) — the one-bounce retry budget is\n112: \t\t\t// exhausted regardless of what's on the tip. The Reason leads\n113: \t\t\t// with \"needs human: review cycle\" so this deliberate\n114: \t\t\t// developer/reviewer back-and-forth stop reads distinctly from a\n115: \t\t\t// crash.\n116: \t\t\treturn Decision{Kind: StopNeedsHuman, Reason: \"needs human: review cycle — retry budget exhausted: 2 verdict commits already, still not approved\"}\n117: \t\tcase latestCommitIsVerdict:\n118: \t\t\t// Exactly 1 verdict commit, and it's still the tip: @reviewer\n119: \t\t\t// rejected once and @developer hasn't responded yet. This is the\n120: \t\t\t// one allowed bounce.\n121: \t\t\treturn Decision{Kind: RunAgent, Agent: agents.Developer, Reason: \"reviewer rejected once, bouncing back to developer (1 of 1 allowed retries)\"}\n122: \t\tdefault:\n123: \t\t\t// Exactly 1 verdict commit, but something newer sits on top of\n124: \t\t\t// it: @developer already committed a fix since that verdict —\n125: \t\t\t// time to re-review, not another developer bounce.\n126: \t\t\treturn Decision{Kind: RunAgent, Agent: agents.Reviewer, Reason: \"developer has committed since the last verdict, re-review\"}\n127: \t\t}\n128: \n129: \tdefault:\n130: \t\treturn Decision{Kind: StopNeedsHuman, Reason: \"unknown stage: \" + string(stage)}\n131: \t}\n132: }\n\n(End of file - total 132 lines)\n</content>","metadata":{"preview":"// Package orchestrate decides which agent mg-jdi should run next for a job,\n// or whether it should stop — the agent-sequence orchestration logic.\n//\n// Next is a pure function of state already visible on disk/in git: a job's\n// job.Stage(), how many verdict commits exist on its branch\n// (git.CountVerdictCommits), and whether the branch tip is itself one of\n// those verdict commits (git.LatestCommitIsVerdict). No new state file is\n// needed, and mg-jdi never has to trust in-memory state across loop\n// iterations — every decision re-derives cleanly from what's already\n// committed, so re-running mg-jdi against the same job after it was killed\n// mid-loop is always safe.\npackage orchestrate\n\nimport (\n\t\"github.com/lmuskalla/manigot/internal/agents\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// Kind is what mg-jdi should do next.\ntype Kind int","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/orchestrate/orchestrate.go","text":"// Package orchestrate decides which agent mg-jdi should run next for a job,\n// or whether it should stop — the agent-sequence orchestration logic.\n//\n// Next is a pure function of state already visible on disk/in git: a job's\n// job.Stage(), how many verdict commits exist on its branch\n// (git.CountVerdictCommits), and whether the branch tip is itself one of\n// those verdict commits (git.LatestCommitIsVerdict). No new state file is\n// needed, and mg-jdi never has to trust in-memory state across loop\n// iterations — every decision re-derives cleanly from what's already\n// committed, so re-running mg-jdi against the same job after it was killed\n// mid-loop is always safe.\npackage orchestrate\n\nimport (\n\t\"github.com/lmuskalla/manigot/internal/agents\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// Kind is what mg-jdi should do next.\ntype Kind int\n\nconst (\n\t// RunAgent means launch the agent named in Decision.Agent next.\n\tRunAgent Kind = iota\n\t// StopFinished means the job's verdict is APPROVED — mg-jdi's work is\n\t// done (it does not auto-merge; see the brief's completion criteria).\n\tStopFinished\n\t// StopNeedsHuman means mg-jdi cannot safely continue unattended and\n\t// must hand control back to a human.\n\tStopNeedsHuman\n)\n\nfunc (k Kind) String() string {\n\tswitch k {\n\tcase RunAgent:\n\t\treturn \"run-agent\"\n\tcase StopFinished:\n\t\treturn \"stop-finished\"\n\tcase StopNeedsHuman:\n\t\treturn \"stop-needs-human\"\n\tdefault:\n\t\treturn \"unknown\"\n\t}\n}\n\n// Decision is Next's result.\ntype Decision struct {\n\t// Kind is what to do.\n\tKind Kind\n\t// Agent is set only when Kind == RunAgent: \"analyst\", \"developer\", or\n\t// \"reviewer\" — see Sequence.\n\tAgent string\n\t// Reason is a short, human-readable explanation, always set — surfaced\n\t// in mg-jdi's own log/status output.\n\tReason string\n}\n\n// Sequence is the fixed, uniform mg-jdi agent order: the same for every job.Type — feature, fix, and chore all drive\n// through analyst → developer → reviewer. Not branched on Job.Type anywhere\n// in this package. Keyed off the agents package constants so a rename breaks\n// the build.\nvar Sequence = []string{agents.Analyst, agents.Developer, agents.Reviewer}\n\n// AgentTargetFile maps each driven agent (Sequence) to the job file it's\n// expected to have written by the time its invocation returns — mg-jdi's\n// output-dedup check reads this file fresh off disk (via j.Dir) to compare\n// against the agent's own response text. Kept next to Sequence so the two\n// can't drift.\nvar AgentTargetFile = map[string]string{\n\tagents.Analyst:   \"tasks.md\",\n\tagents.Developer: \"implementation.md\",\n\tagents.Reviewer:  \"verdict.md\",\n}\n\n// Next decides what mg-jdi should do next for a job.\n//\n// verdictRounds is git.CountVerdictCommits(root, branch, jobID) — how many\n// \"[ID] verdict: …\" commits exist on the job's branch. latestCommitIsVerdict\n// is git.LatestCommitIsVerdict(root, branch, jobID) — whether the branch tip\n// is itself one of those commits, which is what lets StageImplement's two\n// very different situations be told apart: a rejection @developer hasn't\n// responded to yet (tip is the verdict commit) versus one it already has\n// (something newer sits on top of it).\nfunc Next(stage job.Stage, verdictRounds int, latestCommitIsVerdict bool) Decision {\n\tswitch stage {\n\tcase job.StageDefine:\n\t\t// brief.md itself isn't written — writing it is not any of the three\n\t\t// driven agents' job (a human fills in brief.md; @analyst starts\n\t\t// from it, per agents/analyst.md).\n\t\treturn Decision{Kind: StopNeedsHuman, Reason: \"brief.md is not written yet\"}\n\n\tcase job.StagePlan:\n\t\treturn Decision{Kind: RunAgent, Agent: agents.Analyst, Reason: \"brief.md written, tasks.md not written yet\"}\n\n\tcase job.StageReview:\n\t\treturn Decision{Kind: RunAgent, Agent: agents.Reviewer, Reason: \"implementation.md written, verdict.md not written yet\"}\n\n\tcase job.StageFinished:\n\t\treturn Decision{Kind: StopFinished, Reason: \"verdict.md's Overall verdict is APPROVED\"}\n\n\tcase job.StageImplement:\n\t\tswitch {\n\t\tcase verdictRounds == 0:\n\t\t\t// Either the very first pass (tasks.md written, implementation.md\n\t\t\t// not yet), or a job that started implementation but hasn't been\n\t\t\t// reviewed at all yet — either way, it's @developer's turn.\n\t\t\treturn Decision{Kind: RunAgent, Agent: agents.Developer, Reason: \"tasks.md written, no verdict yet\"}\n\t\tcase verdictRounds >= 2:\n\t\t\t// Two rejections already happened (a third could only exist if\n\t\t\t// job.Stage() were still StageImplement after a second rejection,\n\t\t\t// which is exactly this case) — the one-bounce retry budget is\n\t\t\t// exhausted regardless of what's on the tip. The Reason leads\n\t\t\t// with \"needs human: review cycle\" so this deliberate\n\t\t\t// developer/reviewer back-and-forth stop reads distinctly from a\n\t\t\t// crash.\n\t\t\treturn Decision{Kind: StopNeedsHuman, Reason: \"needs human: review cycle — retry budget exhausted: 2 verdict commits already, still not approved\"}\n\t\tcase latestCommitIsVerdict:\n\t\t\t// Exactly 1 verdict commit, and it's still the tip: @reviewer\n\t\t\t// rejected once and @developer hasn't responded yet. This is the\n\t\t\t// one allowed bounce.\n\t\t\treturn Decision{Kind: RunAgent, Agent: agents.Developer, Reason: \"reviewer rejected once, bouncing back to developer (1 of 1 allowed retries)\"}\n\t\tdefault:\n\t\t\t// Exactly 1 verdict commit, but something newer sits on top of\n\t\t\t// it: @developer already committed a fix since that verdict —\n\t\t\t// time to re-review, not another developer bounce.\n\t\t\treturn Decision{Kind: RunAgent, Agent: agents.Reviewer, Reason: \"developer has committed since the last verdict, re-review\"}\n\t\t}\n\n\tdefault:\n\t\treturn Decision{Kind: StopNeedsHuman, Reason: \"unknown stage: \" + string(stage)}\n\t}\n}","lineStart":1,"lineEnd":132,"totalLines":132,"truncated":false}},"title":"src/internal/orchestrate/orchestrate.go","time":{"start":1787919601463,"end":1787919601471}},"id":"prt_048500e57001o3l73HKbAgWaUw","sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","messageID":"msg_04850038c001E9SN53c7iLxDmj"}}
{"type":"tool_use","timestamp":1787919601522,"sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","part":{"type":"tool","tool":"glob","callID":"call_01_Km6BpNRQnq9om8kj17uh2320","state":{"status":"completed","input":{"pattern":"src/cmd/mg/*.go"},"output":"/workspace/src/cmd/mg/tui.go\n/workspace/src/cmd/mg/theme_test.go\n/workspace/src/cmd/mg/theme.go\n/workspace/src/cmd/mg/setup_test.go\n/workspace/src/cmd/mg/setup.go\n/workspace/src/cmd/mg/session_test.go\n/workspace/src/cmd/mg/session.go\n/workspace/src/cmd/mg/serve_test.go\n/workspace/src/cmd/mg/serve.go\n/workspace/src/cmd/mg/prune_test.go\n/workspace/src/cmd/mg/prune.go\n/workspace/src/cmd/mg/profiles_test.go\n/workspace/src/cmd/mg/profiles.go\n/workspace/src/cmd/mg/picker.go\n/workspace/src/cmd/mg/main.go\n/workspace/src/cmd/mg/lifecycle_test.go\n/workspace/src/cmd/mg/jobs_test.go\n/workspace/src/cmd/mg/jobs.go\n/workspace/src/cmd/mg/job.go\n/workspace/src/cmd/mg/jdioutput_test.go\n/workspace/src/cmd/mg/jdioutput.go\n/workspace/src/cmd/mg/jdi_test.go\n/workspace/src/cmd/mg/jdi.go\n/workspace/src/cmd/mg/init_test.go\n/workspace/src/cmd/mg/init.go\n/workspace/src/cmd/mg/host_test.go\n/workspace/src/cmd/mg/host.go\n/workspace/src/cmd/mg/flags.go\n/workspace/src/cmd/mg/errors.go\n/workspace/src/cmd/mg/done.go\n/workspace/src/cmd/mg/diff_test.go\n/workspace/src/cmd/mg/diff.go\n/workspace/src/cmd/mg/delete.go\n/workspace/src/cmd/mg/agents_test.go\n/workspace/src/cmd/mg/agents.go","metadata":{"count":35,"truncated":false},"title":"","time":{"start":1787919601502,"end":1787919601519}},"id":"prt_048500f39001A24CpusIeuqX0N","sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","messageID":"msg_04850038c001E9SN53c7iLxDmj"}}
