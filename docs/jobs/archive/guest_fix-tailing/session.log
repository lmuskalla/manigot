{"type":"tool_use","timestamp":1787919605836,"sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","part":{"type":"tool","tool":"read","callID":"call_bd923104f5244d10b7efc838","state":{"status":"completed","input":{"filePath":"/workspace/src/cmd/mg/jdi.go"},"output":"<path>/workspace/src/cmd/mg/jdi.go</path>\n<type>file</type>\n<content>\n1: // mg jdi (\"just do it\") drives a job's fixed agent sequence —\n2: // @analyst → @developer → @reviewer — end to end without a human manually\n3: // triggering each stage. It is the fold of the former cmd/jdi main into\n4: // the single mg binary (runJDI).\n5: //\n6: // It resolves the job by ID or directory name, then repeatedly asks\n7: // internal/orchestrate what to do next given the job's current\n8: // job.Stage() and git-derived retry-round state, invokes that agent\n9: // non-interactively (internal/session's --print path, see scripts/entrypoint.sh),\n10: // and loops — until the job's verdict is APPROVED or it needs a human (the\n11: // retry budget is exhausted, an agent asked a question via the\n12: // NEEDS-HUMAN-INPUT marker, or the same agent made no progress twice in a\n13: // row).\n14: //\n15: // It does not auto-merge the finished branch.\n16: //\n17: // Run from anywhere inside a project that has a docs/ directory:\n18: //\n19: //\tmg jdi --job/-j <id-or-name>\n20: package main\n21: \n22: import (\n23: \t\"bytes\"\n24: \t\"context\"\n25: \t\"errors\"\n26: \t\"flag\"\n27: \t\"fmt\"\n28: \t\"io\"\n29: \t\"os\"\n30: \t\"path/filepath\"\n31: \t\"strings\"\n32: \t\"time\"\n33: \n34: \t\"github.com/lmuskalla/manigot/internal/config\"\n35: \t\"github.com/lmuskalla/manigot/internal/git\"\n36: \t\"github.com/lmuskalla/manigot/internal/job\"\n37: \t\"github.com/lmuskalla/manigot/internal/notify\"\n38: \t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n39: \t\"github.com/lmuskalla/manigot/internal/session\"\n40: )\n41: \n42: // jdiVersion is the mg-jdi version. Overridden at build time with:\n43: //\n44: //\tgo build -ldflags \"-X main.jdiVersion=1.2.3\"\n45: var jdiVersion = \"0.1.0-dev\"\n46: \n47: // runJDI implements `mg jdi` (thematic alias `mg made-man`) — the fold of the\n48: // former cmd/jdi main into the single mg binary. It parses the flags, drives\n49: // the job's @analyst → @developer → @reviewer sequence end to end, and returns\n50: // the process exit code: 2 for flag/argument errors, 1 when the run stops\n51: // needing human input, 0 otherwise.\n52: func runJDI(args []string, stdout, stderr io.Writer) int {\n53: \tfs := flag.NewFlagSet(\"mg jdi\", flag.ContinueOnError)\n54: \tfs.SetOutput(stderr)\n55: \tvar jobArg string\n56: \tfs.StringVar(&jobArg, \"job\", \"\", \"job ID or directory name to drive (required)\")\n57: \tfs.StringVar(&jobArg, \"j\", \"\", \"short form of --job\")\n58: \tprofileArg := fs.String(\"profile\", \"\", \"subscription profile to run agents under: claude-pro, zai, opencode-go, opencode-zen, or opencode-zen-free (default claude-pro)\")\n59: \tfs.Usage = func() {\n60: \t\tfmt.Fprintf(stderr, \"mg jdi %s\\n\\n\", jdiVersion)\n61: \t\tfmt.Fprintf(stderr, \"Drives a job's @analyst -> @developer -> @reviewer sequence end to end.\\n\\n\")\n62: \t\tfmt.Fprintf(stderr, \"Usage:\\n\")\n63: \t\tfmt.Fprintf(stderr, \"  mg jdi --job/-j <id-or-name> [--profile <profile>]\\n\\n\")\n64: \t\tfmt.Fprintf(stderr, \"Run from anywhere inside a project that has a docs/ directory.\\n\\n\")\n65: \t\tfmt.Fprintf(stderr, \"Flags:\\n\")\n66: \t\tfs.PrintDefaults()\n67: \t}\n68: \tif err := fs.Parse(args); err != nil {\n69: \t\treturn 2 // the flag package already printed the error + usage\n70: \t}\n71: \n72: \tif strings.TrimSpace(jobArg) == \"\" {\n73: \t\tfmt.Fprintln(stderr, \"mg jdi: --job is required\")\n74: \t\tfs.Usage()\n75: \t\treturn 2\n76: \t}\n77: \n78: \t// Default to claude-pro when unset, so existing callers/behavior are\n79: \t// unchanged; validated against config.Profiles() otherwise.\n80: \tprofile := strings.TrimSpace(*profileArg)\n81: \tif profile == \"\" {\n82: \t\tprofile = config.ProfileClaudePro\n83: \t}\n84: \tif _, ok := config.ProfileByID(profile); !ok {\n85: \t\tfmt.Fprintf(stderr, \"mg jdi: --profile must be one of: claude-pro, zai, opencode-go, opencode-zen, opencode-zen-free (got %q)\\n\", profile)\n86: \t\treturn 2\n87: \t}\n88: \n89: \troot, err := job.FindProjectRoot()\n90: \tif err != nil {\n91: \t\tfmt.Fprintf(stderr, \"mg jdi: cannot read working directory: %v\\n\", err)\n92: \t\treturn 1\n93: \t}\n94: \tif root == \"\" {\n95: \t\tfmt.Fprintln(stderr, \"mg jdi: could not find a docs/ directory in this or any parent directory\")\n96: \t\treturn 1\n97: \t}\n98: \n99: \tj, err := resolveJob(root, jobArg)\n100: \tif err != nil {\n101: \t\tfmt.Fprintf(stderr, \"mg jdi: %v\\n\", err)\n102: \t\treturn 1\n103: \t}\n104: \n105: \t// Crash notification (opt-in — see internal/notify): the previous run for\n106: \t// this job may have been killed without ever reporting a stop; detect it\n107: \t// here at the next run's start and push an attention notification. A\n108: \t// process that was SIGKILLed/OOM-killed cannot notify from inside itself,\n109: \t// so this stale-sidecar check on next start is the self-contained\n110: \t// approximation — an external watchdog is out of scope. Best-effort and\n111: \t// only when NTFY_TOPIC is set (unconfigured behavior unchanged).\n112: \tnotifyCrashedRun(stderr, root, j)\n113: \n114: \t// Best-effort: see ensureSidecarIgnored's own doc for why a failure here\n115: \t// does not abort the run.\n116: \tif err := ensureSidecarIgnored(root); err != nil {\n117: \t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not exclude the status sidecar from git: %v\\n\", err)\n118: \t}\n119: \n120: \trunner, err := newCommandAgentRunner(root, profile)\n121: \tif err != nil {\n122: \t\tfmt.Fprintf(stderr, \"mg jdi: %v\\n\", err)\n123: \t\treturn 1\n124: \t}\n125: \n126: \t// Fan-out: every invocation's formatted output\n127: \t// (see jdioutput.go's logInvocation) goes to both mg-jdi's own stdout —\n128: \t// which has an audience only for a direct CLI run; a TUI-launched run is\n129: \t// detached with no terminal attached to this leg at all — and the\n130: \t// sidecar's run.log, which the TUI log tab reads and is therefore the\n131: \t// only visibility path for a TUI-launched run. Writing to both\n132: \t// unconditionally is simplest and harmless: stdout always exists as a\n133: \t// file descriptor whether or not anything is reading it.\n134: \tlogDest := io.Writer(stdout)\n135: \twroteSection := false\n136: \tif logFile, hadContent, ferr := openRunLog(root, j.Name); ferr != nil {\n137: \t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not open run log, continuing with stdout only: %v\\n\", ferr)\n138: \t} else {\n139: \t\tdefer logFile.Close()\n140: \t\tlogDest = io.MultiWriter(stdout, logFile)\n141: \t\twroteSection = hadContent\n142: \t}\n143: \t// Wrap the destination in a sectionWriter (see jdioutput.go) so every\n144: \t// \"=== ... ===\" state-log header is preceded by a blank line instead of\n145: \t// the events getting crumbled together — the very first run ever written\n146: \t// to a fresh log excepted, which is what wroteSection captures.\n147: \tlogDest = &sectionWriter{w: logDest, wroteSection: wroteSection}\n148: \n149: \t// Status sidecar: best-effort — a write failure\n150: \t// (e.g. a read-only filesystem) must not abort the loop itself, only\n151: \t// mean the TUI's list-row badge and stop-notification dedup won't see it.\n152: \t// mg-jdi's own stdout/run.log remain authoritative for a human watching\n153: \t// directly either way.\n154: \tstatusFn := func(state job.JDIState, agent string) {\n155: \t\tif err := job.WriteJDIStatus(root, j.Name, state, agent); err != nil {\n156: \t\t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not write status sidecar: %v\\n\", err)\n157: \t\t}\n158: \t}\n159: \n160: \tlogStarted(logDest, j.Name, profile)\n161: \tresult := Run(root, j, runner, logDest, statusFn)\n162: \tfmt.Fprintf(stdout, \"\\nmg jdi: %s — %s\\n\", result.Kind, result.Reason)\n163: \n164: \t// Stop notification, CLI path: ring the terminal bell\n165: \t// at both loop-exit points (finished, needs human) — this process is\n166: \t// attached to the human's own terminal for a direct `mg jdi` run, which\n167: \t// is the only case this leg has an audience for. A TUI-launched run has\n168: \t// no terminal to ring into at all; the TUI rings on its own next poll\n169: \t// tick instead (see pollJDIBell in internal/ui/app.go), once it observes\n170: \t// this job's status sidecar (just written above) transition into a\n171: \t// stopped state.\n172: \tfmt.Fprint(stdout, \"\\a\")\n173: \n174: \t// Stop notification, ntfy path (opt-in — see internal/notify): both the\n175: \t// CLI path and a TUI-launched run go through this same runJDI stop path,\n176: \t// so notifying here covers both. Best-effort like the sidecar/run-log\n177: \t// warnings above — a send failure warns on stderr and never aborts the\n178: \t// exit path.\n179: \tnotifyStop(stderr, j.Name, result)\n180: \n181: \tif result.Kind == orchestrate.StopNeedsHuman {\n182: \t\treturn 1\n183: \t}\n184: \treturn 0\n185: }\n186: \n187: // notifyStop sends the opt-in ntfy stop notification for a finished mg-jdi\n188: // run: a default-priority success message (tag white_check_mark) when the\n189: // run finished (result.Kind == StopFinished), and a high-priority attention\n190: // message (tag warning, priority 4) when it stopped needing a human. Both\n191: // messages carry the job name and the stop reason. It is a strict no-op when\n192: // NTFY_TOPIC is unset (nothing is sent, no error), and a send failure only\n193: // warns on stderr — never aborting the caller.\n194: func notifyStop(stderr io.Writer, jobName string, result LoopResult) {\n195: \tc := notify.FromConfig()\n196: \tif !c.Enabled() {\n197: \t\treturn\n198: \t}\n199: \n200: \tmsg := notify.Message{Message: result.Reason}\n201: \tswitch result.Kind {\n202: \tcase orchestrate.StopFinished:\n203: \t\tmsg.Title = \"mg jdi: \" + jobName + \" finished\"\n204: \t\tmsg.Tags = []string{\"white_check_mark\"}\n205: \tdefault: // orchestrate.StopNeedsHuman\n206: \t\tmsg.Title = \"mg jdi: \" + jobName + \" needs attention\"\n207: \t\tmsg.Tags = []string{\"warning\"}\n208: \t\tmsg.Priority = 4\n209: \t}\n210: \tif err := c.Publish(msg); err != nil {\n211: \t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not send ntfy notification: %v\\n\", err)\n212: \t}\n213: }\n214: \n215: // notifyCrashedRun checks, at a new `mg jdi` run's start, whether the\n216: // previous run for job j died without ever reporting a stop — a JDIRunning\n217: // status in the sidecar stale past job's jdiRunningStaleAfter (see\n218: // job.StaleRunningJDI) — and pushes a high-priority attention notification\n219: // (tag warning, priority 4) about it. Once the crash has been notified, the\n220: // stale sidecar is overwritten with JDIStoppedNeedsHuman so a later start\n221: // does not re-notify about the same already-known crash; a failed send does\n222: // not mark it, so the notification is retried on the next start instead.\n223: //\n224: // It is a strict no-op when ntfy is unconfigured (no NTFY_TOPIC): nothing is\n225: // read-modify-written, keeping unconfigured behavior byte-for-byte identical\n226: // (the TUI still degrades the stale sidecar away on its own). Failures warn\n227: // on stderr and never abort the run.\n228: func notifyCrashedRun(stderr io.Writer, root string, j job.Job) {\n229: \tc := notify.FromConfig()\n230: \tif !c.Enabled() {\n231: \t\treturn\n232: \t}\n233: \n234: \tst, crashed := job.StaleRunningJDI(root, j.Name)\n235: \tif !crashed {\n236: \t\treturn\n237: \t}\n238: \n239: \tmsg := notify.Message{\n240: \t\tTitle:    \"mg jdi: \" + j.Name + \" crashed\",\n241: \t\tMessage:  fmt.Sprintf(\"The previous mg jdi run appears to have crashed or been killed (status stale since %s).\", st.Updated.Format(time.RFC3339)),\n242: \t\tTags:     []string{\"warning\"},\n243: \t\tPriority: 4,\n244: \t}\n245: \tif st.Agent != \"\" {\n246: \t\tmsg.Message += fmt.Sprintf(\" Last agent: %s.\", st.Agent)\n247: \t}\n248: \tif err := c.Publish(msg); err != nil {\n249: \t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not send ntfy notification: %v\\n\", err)\n250: \t\treturn\n251: \t}\n252: \n253: \t// Mark the crash as known so the next start doesn't re-notify about it.\n254: \tif err := job.WriteJDIStatus(root, j.Name, job.JDIStoppedNeedsHuman, st.Agent); err != nil {\n255: \t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not mark the crashed run as known: %v\\n\", err)\n256: \t}\n257: }\n258: \n259: // resolveJob finds the job named or ID-prefixed by arg among every job\n260: // job.Discover can see (cross-branch — see internal/job), mirroring the\n261: // session launcher's own --job resolution: an exact job-directory-name match\n262: // first, then an exact ID match, then a directory-name prefix match.\n263: func resolveJob(root, arg string) (job.Job, error) {\n264: \tjobs, err := job.Discover(root)\n265: \tif err != nil {\n266: \t\treturn job.Job{}, fmt.Errorf(\"could not list jobs: %w\", err)\n267: \t}\n268: \n269: \t// A job's Name is its id_slug — the same concept as a branch tail — so\n270: \t// the exact-name and name-prefix matching below reuses the branch-matching\n271: \t// primitives in internal/git rather than re-implementing them.\n272: \tbyName := make(map[string]job.Job, len(jobs))\n273: \tnames := make([]string, len(jobs))\n274: \tfor i, j := range jobs {\n275: \t\tbyName[j.Name] = j\n276: \t\tnames[i] = j.Name\n277: \t}\n278: \n279: \tif name := git.ExactBranchMatch(names, arg); name != \"\" {\n280: \t\treturn byName[name], nil\n281: \t}\n282: \tfor _, j := range jobs {\n283: \t\tif j.ID == arg {\n284: \t\t\treturn j, nil\n285: \t\t}\n286: \t}\n287: \n288: \tswitch matches := git.PrefixBranchMatches(names, arg); len(matches) {\n289: \tcase 0:\n290: \t\treturn job.Job{}, fmt.Errorf(\"job %q not found under docs/jobs/\", arg)\n291: \tcase 1:\n292: \t\treturn byName[matches[0]], nil\n293: \tdefault:\n294: \t\treturn job.Job{}, fmt.Errorf(\"job %q is ambiguous — matches %d jobs\", arg, len(matches))\n295: \t}\n296: }\n297: \n298: // AgentRunner runs one non-interactive agent invocation for job j and\n299: // returns its captured output (the session launcher's --print path — a\n300: // `claude --print --verbose --output-format stream-json` event stream, an\n301: // `opencode run --format json` event stream, or plain text; see\n302: // internal/orchestrate.DetectSignal, which handles all three). Run's loop\n303: // persists the raw bytes to the job's session.log (appendSessionLog) and\n304: // extracts the response prose for run.log via orchestrate.ResultText.\n305: //\n306: // Implemented by commandAgentRunner for real invocations; the tests use a\n307: // fake instead of spawning real containers.\n308: type AgentRunner interface {\n309: \tRun(agent string, j job.Job) ([]byte, error)\n310: }\n311: \n312: // commandAgentRunner is the real AgentRunner: it calls the session package's\n313: // --print path in-process (the replacement for exec'ing the resolved run.sh),\n314: // capturing the agent's stdout and routing diagnostics to a buffer that only\n315: // surfaces on error — the same visibility the exec'd run.sh's fd-3\n316: // diagnostics had.\n317: type commandAgentRunner struct {\n318: \tprojectRoot string\n319: \tprofile     string\n320: }\n321: \n322: // newCommandAgentRunner builds the in-process runner. projectRoot is where\n323: // --job resolution starts from (run.sh used $PWD, which the old runner set to\n324: // the project root); profile is passed through unchanged to every Run\n325: // invocation — see its own doc.\n326: func newCommandAgentRunner(projectRoot, profile string) (*commandAgentRunner, error) {\n327: \treturn &commandAgentRunner{projectRoot: projectRoot, profile: profile}, nil\n328: }\n329: \n330: // agentInvocation builds the session options for one agent run — the --print\n331: // invocation with the runner's pinned profile, the agent, and the exact job\n332: // directory name.\n333: func (r *commandAgentRunner) agentInvocation(agent string, j job.Job) session.Options {\n334: \treturn session.Options{Print: true, Profile: r.profile, Agent: agent, Job: j.Name}\n335: }\n336: \n337: // Run invokes the session launcher's --print path synchronously and returns\n338: // its stdout. The --print path keeps stdout clean of its own diagnostics\n339: // (they go to the diag writer), so stdout here is exactly the agent's own\n340: // response. j.Name (the exact job directory name) is passed rather than j.ID\n341: // to remove any ambiguity in the --job resolution.\n342: //\n343: // r.profile is passed explicitly rather than left to the launcher's own\n344: // default (main's --profile flag, validated and defaulted to\n345: // config.ProfileClaudePro there) so a run keeps using the profile it was\n346: // started with even when the user later changes their default profile via\n347: // `mg profiles` mid-run.\n348: func (r *commandAgentRunner) Run(agent string, j job.Job) ([]byte, error) {\n349: \topts := r.agentInvocation(agent, j)\n350: \tinfo, err := session.ResolveProfile(opts)\n351: \tif err != nil {\n352: \t\treturn nil, err\n353: \t}\n354: \troot, err := session.ResolveRootFrom(opts, r.projectRoot)\n355: \tif err != nil {\n356: \t\treturn nil, err\n357: \t}\n358: \tif err := info.CheckAuth(); err != nil {\n359: \t\treturn nil, err\n360: \t}\n361: \n362: \tvar diag bytes.Buffer\n363: \tinv, err := session.BuildDockerInvocation(opts, info, root, false, &diag)\n364: \tif err != nil {\n365: \t\treturn nil, err\n366: \t}\n367: \n368: \t// Prune orphaned manigot containers before the run — the same fail-soft\n369: \t// self-healing cleanup as the interactive session path. Warnings go into\n370: \t// the diag buffer, which only surfaces on error; a prune failure never\n371: \t// aborts the invocation.\n372: \tif _, err := pruneOrphans(&diag); err != nil {\n373: \t\tfmt.Fprintf(&diag, \"mg: warning: could not prune orphaned containers: %v\\n\", err)\n374: \t}\n375: \n376: \tvar stdout bytes.Buffer\n377: \tcode, ran := inv.Run(os.Stdin, &stdout, &diag)\n378: \t// The same host-side sweep as the interactive session path: every mg-jdi\n379: \t// --print invocation ends with leftover changes committed, including the\n380: \t// analyst's tasks.md (the analyst is read-only and cannot commit it\n381: \t// itself). The sweep runs before the loop's post-run stall probe reads\n382: \t// HEAD, so the sweep commit correctly counts as agent progress. Sweep only\n383: \t// when the container actually ran — an agent that never started must not\n384: \t// trigger a commit.\n385: \tif ran {\n386: \t\tsession.SweepJobWorktree(root, &diag)\n387: \t}\n388: \tif code != 0 {\n389: \t\treturn stdout.Bytes(), fmt.Errorf(\"mg --print --agent %s --job %s: exit code %d: %s\", agent, j.Name, code, strings.TrimSpace(diag.String()))\n390: \t}\n391: \treturn stdout.Bytes(), nil\n392: }\n393: \n394: // LoopResult is Run's outcome: always one of orchestrate.StopFinished or\n395: // orchestrate.StopNeedsHuman — Run never returns while orchestrate.Next\n396: // keeps saying RunAgent.\n397: type LoopResult struct {\n398: \tKind   orchestrate.Kind\n399: \tReason string\n400: }\n401: \n402: // maxIterations is a hard safety cap on loop iterations, independent of\n403: // orchestrate.Next's own one-bounce retry budget — a defensive backstop\n404: // against an unforeseen bug in the state machine looping forever rather than\n405: // trusting Next's own termination alone.\n406: const maxIterations = 20\n407: \n408: // jdiProbeTimeout bounds each loop iteration's git probes (HeadCommit,\n409: // CountVerdictCommits, LatestCommitIsVerdict): local, fast reads, so 10s is\n410: // generous — the point is that a hung git stalls one probe rather than the\n411: // whole run. The probe errors are already read with `_` (the loop tolerates a\n412: // failed probe as \"no information\"), so a timeout degrades exactly like any\n413: // other probe failure and surfaces in the stop reason only if it's the last\n414: // thing that happened before a stop.\n415: //\n416: // A var rather than a const so tests can lower it: the stall-backstop test\n417: // needs a runner whose Run call outlives the probe timeout, which would be\n418: // a 10s test at the production value.\n419: var jdiProbeTimeout = 10 * time.Second\n420: \n421: // StatusFunc is called by Run at each state transition: once\n422: // before invoking an agent (job.JDIRunning, that agent's name) and once\n423: // more at loop exit (the terminal state, and the last agent that ran, or \"\"\n424: // if none ever did — e.g. a job stuck at StageDefine). May be nil, in which\n425: // case Run simply doesn't report status — used by tests that don't care\n426: // about the sidecar file.\n427: type StatusFunc func(state job.JDIState, agent string)\n428: \n429: // jdiTerminalState maps a LoopResult's orchestrate.Kind (always\n430: // StopFinished or StopNeedsHuman by the time Run returns) to the\n431: // corresponding job.JDIState reported to StatusFunc.\n432: func jdiTerminalState(k orchestrate.Kind) job.JDIState {\n433: \tif k == orchestrate.StopFinished {\n434: \t\treturn job.JDIStoppedFinished\n435: \t}\n436: \treturn job.JDIStoppedNeedsHuman\n437: }\n438: \n439: // Run drives job j through the agent sequence via runner, writing each\n440: // invocation's formatted output to log (see jdioutput.go's logInvocation) and\n441: // reporting state transitions to status (may be nil), until\n442: // orchestrate.Next reports StopFinished or StopNeedsHuman.\n443: //\n444: // The attempt number in each invocation's log header (logAgentInvoked /\n445: // logInvocation) counts that agent's own invocations within this run — per\n446: // agent, not a run-wide counter — so a bounce back to the developer logs\n447: // that developer's second call as attempt 2, not attempt 4. The counter is\n448: // seeded at 0 before the loop and reset at the start of every run, matching\n449: // the loop index's old behavior.\n450: //\n451: // Each iteration re-derives its decision from job.Stage() and git — the\n452: // job.Job struct's identity fields (Dir/Root/Branch/ID/Name) never change\n453: // across iterations, but Stage() and the git.CountVerdictCommits/\n454: // LatestCommitIsVerdict reads underneath it are re-evaluated fresh every\n455: // time, since they read from disk/git rather than a cached snapshot — so\n456: // Run never needs to re-fetch or mutate j itself mid-loop.\n457: func Run(root string, j job.Job, runner AgentRunner, log io.Writer, status StatusFunc) LoopResult {\n458: \tvar lastAgent string\n459: \tvar lastNoChange bool\n460: \tvar agentEverRan bool\n461: \n462: \treport := func(state job.JDIState, agent string) {\n463: \t\tif status != nil {\n464: \t\t\tstatus(state, agent)\n465: \t\t}\n466: \t}\n467: \t// finish reports the terminal status, logs the \"job finished\" event,\n468: \t// and builds the LoopResult every exit point returns.\n469: \t// includeReason is normally true; it's false only for the\n470: \t// stop-before-any-agent-ran case below, whose reason was already printed\n471: \t// by logImmediateStop a line above — see logJobFinished's own doc.\n472: \t//\n473: \t// Loop-exit sweep first: the per-invocation sweep\n474: \t// (session.SweepJobWorktree inside commandAgentRunner.Run) runs BEFORE\n475: \t// the loop's session.log append, so the final section would otherwise\n476: \t// stay an uncommitted tracked modification — session.log is untracked\n477: \t// when iteration 1 appends it, iteration 2's sweep `git add -A` commits\n478: \t// it (now TRACKED), every later append is a tracked modification, and\n479: \t// git.WorkingTreeDirty DOES report tracked modifications, so mg done's\n480: \t// clean-tree check (finish.go) would refuse to finish the job. Commit\n481: \t// everything left — the final session.log section above all — with the\n482: \t// sweep's own message. Linked worktrees only: for a pre-worktree job\n483: \t// (branch checked out in the MAIN worktree itself — an explicitly\n484: \t// supported, Discover-visible state) the resolved worktree IS j.Root,\n485: \t// where the user's own uncommitted work lives — sweeping there would\n486: \t// commit it, an unexcluded .env included, onto the job branch, the\n487: \t// exact hazard session.SweepJobWorktree's ProjectRoot == InvocationRoot\n488: \t// gate exists for — so the sweep is skipped when WorktreeForBranch\n489: \t// resolves to the main worktree. The stop-before-any-agent path has\n490: \t// nothing to commit and ErrNothingToCommit is swallowed.\n491: \tfinish := func(kind orchestrate.Kind, reason string, includeReason bool) LoopResult {\n492: \t\tif wt, ok, err := git.WorktreeForBranch(j.Root, j.Branch); err != nil {\n493: \t\t\tfmt.Fprintf(log, \"mg jdi: warning: could not resolve worktree for the final session-log sweep: %v\\n\", err)\n494: \t\t} else if ok && filepath.Clean(wt) != filepath.Clean(j.Root) {\n495: \t\t\tif err := git.CommitAll(wt, fmt.Sprintf(\"[%s] chore: commit all\", j.ID)); err != nil && !errors.Is(err, git.ErrNothingToCommit) && !errors.Is(err, git.ErrNotARepo) {\n496: \t\t\t\tfmt.Fprintf(log, \"mg jdi: warning: could not commit the session log: %v\\n\", err)\n497: \t\t\t}\n498: \t\t}\n499: \t\treport(jdiTerminalState(kind), lastAgent)\n500: \t\tlogJobFinished(log, kind, reason, includeReason)\n501: \t\treturn LoopResult{Kind: kind, Reason: reason}\n502: \t}\n503: \n504: \t// attempts counts each agent's invocations within this run, keyed by\n505: \t// agent name — per agent, not run-wide — and feeds the \"attempt N\" in\n506: \t// both logAgentInvoked's and logInvocation's headers below. Seeded at 0\n507: \t// before the loop, so the first call of every agent is attempt 1.\n508: \tattempts := make(map[string]int)\n509: \n510: \tfor i := 0; i < maxIterations; i++ {\n511: \t\t// One bounded context for this iteration's pre-agent git probes\n512: \t\t// (see jdiProbeTimeout): a hung git must stall one probe, not the\n513: \t\t// whole run. Each context is cancelled at its point of use — never\n514: \t\t// deferred, which would accumulate up to maxIterations timers until\n515: \t\t// Run returns. The post-agent stall probe gets its own fresh context\n516: \t\t// below: runner.Run is a minutes-long docker/LLM invocation, so a\n517: \t\t// context created here would be long expired by the time that probe\n518: \t\t// runs and would read \"\" for HEAD, silently defeating the stall\n519: \t\t// backstop.\n520: \t\tprobeCtx, cancelProbes := context.WithTimeout(context.Background(), jdiProbeTimeout)\n521: \n522: \t\tstageBefore := j.Stage()\n523: \t\trounds, _ := git.CountVerdictCommitsWithContext(probeCtx, root, j.Branch, j.ID)\n524: \t\ttipIsVerdict, _ := git.LatestCommitIsVerdictWithContext(probeCtx, root, j.Branch, j.ID)\n525: \t\tdecision := orchestrate.Next(stageBefore, rounds, tipIsVerdict)\n526: \n527: \t\tif decision.Kind != orchestrate.RunAgent {\n528: \t\t\tcancelProbes()\n529: \t\t\tincludeReason := true\n530: \t\t\tif !agentEverRan {\n531: \t\t\t\t// No agent has run yet this whole loop (typically the very\n532: \t\t\t\t// first iteration, e.g. an unwritten brief.md) — logInvocation\n533: \t\t\t\t// never gets a chance to run for this stop, which otherwise\n534: \t\t\t\t// leaves run.log at 0 bytes for a case that has just as much\n535: \t\t\t\t// reason to explain itself there as any agent invocation does.\n536: \t\t\t\tlogImmediateStop(log, decision.Reason)\n537: \t\t\t\tincludeReason = false\n538: \t\t\t}\n539: \t\t\treturn finish(decision.Kind, decision.Reason, includeReason)\n540: \t\t}\n541: \n542: \t\treport(job.JDIRunning, decision.Agent)\n543: \t\tattempts[decision.Agent]++\n544: \t\tlogAgentInvoked(log, decision.Agent, attempts[decision.Agent])\n545: \t\theadBefore, _ := git.HeadCommitWithContext(probeCtx, root, j.Branch)\n546: \t\tcancelProbes() // pre-agent probes done; the agent invocation below can take minutes\n547: \n548: \t\tout, runErr := runner.Run(decision.Agent, j)\n549: \t\tagentEverRan = true\n550: \n551: \t\t// Read the just-run agent's expected target file fresh off\n552: \t\t// disk, so logInvocation can skip re-printing output that's already\n553: \t\t// the same as what got written to the job's own markdown file. Safe\n554: \t\t// to read directly from j.Dir — see orchestrate.AgentTargetFile's own\n555: \t\t// doc. A missing/unreadable file (targetContent left \"\") just means\n556: \t\t// logInvocation's dedup check never matches, which is the same as\n557: \t\t// not having this feature at all for that call.\n558: \t\tvar targetContent string\n559: \t\ttargetFile := orchestrate.AgentTargetFile[decision.Agent]\n560: \t\tif targetFile != \"\" {\n561: \t\t\tif data, rerr := os.ReadFile(filepath.Join(j.Dir, targetFile)); rerr == nil {\n562: \t\t\t\ttargetContent = string(data)\n563: \t\t\t}\n564: \t\t}\n565: \n566: \t\t// Fan-out: log gets the same formatted section\n567: \t\t// regardless of whether it's os.Stdout, the sidecar run.log, or (in\n568: \t\t// tests) an in-memory buffer — see main()'s io.MultiWriter and\n569: \t\t// jdioutput.go's logInvocation. DetectSignal below scans the raw bytes\n570: \t\t// directly (it does its own JSON extraction), independent of what\n571: \t\t// logInvocation writes for a human to read.\n572: \t\tlogInvocation(log, decision.Agent, attempts[decision.Agent], out, targetFile, targetContent)\n573: \n574: \t\t// Session log: persist this invocation's raw captured output — the\n575: \t\t// whole step-level event stream, not just the final answer — to the\n576: \t\t// job's own session.log (docs/jobs/<id>_<slug>/session.log), for\n577: \t\t// every invocation including failed ones, so what an agent did\n578: \t\t// during an unattended run survives. Best-effort: a failure only\n579: \t\t// warns through the log writer (Run has no stderr) and never aborts\n580: \t\t// the loop. The section stays uncommitted until the finish closure's\n581: \t\t// loop-exit sweep below — the per-invocation sweep inside\n582: \t\t// commandAgentRunner.Run already ran before this append.\n583: \t\tif err := appendSessionLog(filepath.Join(j.Dir, \"session.log\"), decision.Agent, attempts[decision.Agent], out); err != nil {\n584: \t\t\tfmt.Fprintf(log, \"mg jdi: warning: could not append to session log: %v\\n\", err)\n585: \t\t}\n586: \n587: \t\tif sig, ok := orchestrate.DetectSignal(out); ok {\n588: \t\t\tlastAgent = decision.Agent\n589: \t\t\treturn finish(orchestrate.StopNeedsHuman, fmt.Sprintf(\"%s asked for human input: %s\", decision.Agent, sig.Reason), true)\n590: \t\t}\n591: \t\tif runErr != nil {\n592: \t\t\tlastAgent = decision.Agent\n593: \t\t\treturn finish(orchestrate.StopNeedsHuman, fmt.Sprintf(\"%s invocation failed: %v\", decision.Agent, runErr), true)\n594: \t\t}\n595: \n596: \t\t// Stall backstop: the same agent invoked twice in a\n597: \t\t// row, each time persisting nothing at all (neither Stage() nor the\n598: \t\t// branch HEAD moved across that invocation), stops on the second\n599: \t\t// such occurrence — a single no-op invocation is tolerated (it may\n600: \t\t// be transient), but two in a row for the same agent means it's\n601: \t\t// genuinely stuck, regardless of whether the NEEDS-HUMAN-INPUT\n602: \t\t// marker was present.\n603: \t\tstageAfter := j.Stage()\n604: \t\t// Fresh context for the post-agent probe: the pre-agent probeCtx\n605: \t\t// above was cancelled before runner.Run and would in any case be\n606: \t\t// long expired after a minutes-long invocation — reusing it would\n607: \t\t// make this probe fail instantly and read \"\", which noChange would\n608: \t\t// take as a HEAD change and the stall backstop would never fire.\n609: \t\tprobeAfterCtx, cancelProbeAfter := context.WithTimeout(context.Background(), jdiProbeTimeout)\n610: \t\theadAfter, _ := git.HeadCommitWithContext(probeAfterCtx, root, j.Branch)\n611: \t\tcancelProbeAfter()\n612: \t\tnoChange := stageAfter == stageBefore && headAfter == headBefore\n613: \n614: \t\tif noChange && lastNoChange && decision.Agent == lastAgent {\n615: \t\t\treturn finish(orchestrate.StopNeedsHuman, fmt.Sprintf(\"%s made no progress on two consecutive runs (Stage and branch HEAD unchanged both times) — stopping rather than looping indefinitely\", decision.Agent), true)\n616: \t\t}\n617: \t\tlastAgent, lastNoChange = decision.Agent, noChange\n618: \t}\n619: \n620: \treturn finish(orchestrate.StopNeedsHuman, fmt.Sprintf(\"exceeded %d iterations without finishing\", maxIterations), true)\n621: }\n\n(End of file - total 621 lines)\n</content>","metadata":{"preview":"// mg jdi (\"just do it\") drives a job's fixed agent sequence —\n// @analyst → @developer → @reviewer — end to end without a human manually\n// triggering each stage. It is the fold of the former cmd/jdi main into\n// the single mg binary (runJDI).\n//\n// It resolves the job by ID or directory name, then repeatedly asks\n// internal/orchestrate what to do next given the job's current\n// job.Stage() and git-derived retry-round state, invokes that agent\n// non-interactively (internal/session's --print path, see scripts/entrypoint.sh),\n// and loops — until the job's verdict is APPROVED or it needs a human (the\n// retry budget is exhausted, an agent asked a question via the\n// NEEDS-HUMAN-INPUT marker, or the same agent made no progress twice in a\n// row).\n//\n// It does not auto-merge the finished branch.\n//\n// Run from anywhere inside a project that has a docs/ directory:\n//\n//\tmg jdi --job/-j <id-or-name>\npackage main","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/cmd/mg/jdi.go","text":"// mg jdi (\"just do it\") drives a job's fixed agent sequence —\n// @analyst → @developer → @reviewer — end to end without a human manually\n// triggering each stage. It is the fold of the former cmd/jdi main into\n// the single mg binary (runJDI).\n//\n// It resolves the job by ID or directory name, then repeatedly asks\n// internal/orchestrate what to do next given the job's current\n// job.Stage() and git-derived retry-round state, invokes that agent\n// non-interactively (internal/session's --print path, see scripts/entrypoint.sh),\n// and loops — until the job's verdict is APPROVED or it needs a human (the\n// retry budget is exhausted, an agent asked a question via the\n// NEEDS-HUMAN-INPUT marker, or the same agent made no progress twice in a\n// row).\n//\n// It does not auto-merge the finished branch.\n//\n// Run from anywhere inside a project that has a docs/ directory:\n//\n//\tmg jdi --job/-j <id-or-name>\npackage main\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/notify\"\n\t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n\t\"github.com/lmuskalla/manigot/internal/session\"\n)\n\n// jdiVersion is the mg-jdi version. Overridden at build time with:\n//\n//\tgo build -ldflags \"-X main.jdiVersion=1.2.3\"\nvar jdiVersion = \"0.1.0-dev\"\n\n// runJDI implements `mg jdi` (thematic alias `mg made-man`) — the fold of the\n// former cmd/jdi main into the single mg binary. It parses the flags, drives\n// the job's @analyst → @developer → @reviewer sequence end to end, and returns\n// the process exit code: 2 for flag/argument errors, 1 when the run stops\n// needing human input, 0 otherwise.\nfunc runJDI(args []string, stdout, stderr io.Writer) int {\n\tfs := flag.NewFlagSet(\"mg jdi\", flag.ContinueOnError)\n\tfs.SetOutput(stderr)\n\tvar jobArg string\n\tfs.StringVar(&jobArg, \"job\", \"\", \"job ID or directory name to drive (required)\")\n\tfs.StringVar(&jobArg, \"j\", \"\", \"short form of --job\")\n\tprofileArg := fs.String(\"profile\", \"\", \"subscription profile to run agents under: claude-pro, zai, opencode-go, opencode-zen, or opencode-zen-free (default claude-pro)\")\n\tfs.Usage = func() {\n\t\tfmt.Fprintf(stderr, \"mg jdi %s\\n\\n\", jdiVersion)\n\t\tfmt.Fprintf(stderr, \"Drives a job's @analyst -> @developer -> @reviewer sequence end to end.\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"Usage:\\n\")\n\t\tfmt.Fprintf(stderr, \"  mg jdi --job/-j <id-or-name> [--profile <profile>]\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"Run from anywhere inside a project that has a docs/ directory.\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"Flags:\\n\")\n\t\tfs.PrintDefaults()\n\t}\n\tif err := fs.Parse(args); err != nil {\n\t\treturn 2 // the flag package already printed the error + usage\n\t}\n\n\tif strings.TrimSpace(jobArg) == \"\" {\n\t\tfmt.Fprintln(stderr, \"mg jdi: --job is required\")\n\t\tfs.Usage()\n\t\treturn 2\n\t}\n\n\t// Default to claude-pro when unset, so existing callers/behavior are\n\t// unchanged; validated against config.Profiles() otherwise.\n\tprofile := strings.TrimSpace(*profileArg)\n\tif profile == \"\" {\n\t\tprofile = config.ProfileClaudePro\n\t}\n\tif _, ok := config.ProfileByID(profile); !ok {\n\t\tfmt.Fprintf(stderr, \"mg jdi: --profile must be one of: claude-pro, zai, opencode-go, opencode-zen, opencode-zen-free (got %q)\\n\", profile)\n\t\treturn 2\n\t}\n\n\troot, err := job.FindProjectRoot()\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"mg jdi: cannot read working directory: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif root == \"\" {\n\t\tfmt.Fprintln(stderr, \"mg jdi: could not find a docs/ directory in this or any parent directory\")\n\t\treturn 1\n\t}\n\n\tj, err := resolveJob(root, jobArg)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"mg jdi: %v\\n\", err)\n\t\treturn 1\n\t}\n\n\t// Crash notification (opt-in — see internal/notify): the previous run for\n\t// this job may have been killed without ever reporting a stop; detect it\n\t// here at the next run's start and push an attention notification. A\n\t// process that was SIGKILLed/OOM-killed cannot notify from inside itself,\n\t// so this stale-sidecar check on next start is the self-contained\n\t// approximation — an external watchdog is out of scope. Best-effort and\n\t// only when NTFY_TOPIC is set (unconfigured behavior unchanged).\n\tnotifyCrashedRun(stderr, root, j)\n\n\t// Best-effort: see ensureSidecarIgnored's own doc for why a failure here\n\t// does not abort the run.\n\tif err := ensureSidecarIgnored(root); err != nil {\n\t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not exclude the status sidecar from git: %v\\n\", err)\n\t}\n\n\trunner, err := newCommandAgentRunner(root, profile)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"mg jdi: %v\\n\", err)\n\t\treturn 1\n\t}\n\n\t// Fan-out: every invocation's formatted output\n\t// (see jdioutput.go's logInvocation) goes to both mg-jdi's own stdout —\n\t// which has an audience only for a direct CLI run; a TUI-launched run is\n\t// detached with no terminal attached to this leg at all — and the\n\t// sidecar's run.log, which the TUI log tab reads and is therefore the\n\t// only visibility path for a TUI-launched run. Writing to both\n\t// unconditionally is simplest and harmless: stdout always exists as a\n\t// file descriptor whether or not anything is reading it.\n\tlogDest := io.Writer(stdout)\n\twroteSection := false\n\tif logFile, hadContent, ferr := openRunLog(root, j.Name); ferr != nil {\n\t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not open run log, continuing with stdout only: %v\\n\", ferr)\n\t} else {\n\t\tdefer logFile.Close()\n\t\tlogDest = io.MultiWriter(stdout, logFile)\n\t\twroteSection = hadContent\n\t}\n\t// Wrap the destination in a sectionWriter (see jdioutput.go) so every\n\t// \"=== ... ===\" state-log header is preceded by a blank line instead of\n\t// the events getting crumbled together — the very first run ever written\n\t// to a fresh log excepted, which is what wroteSection captures.\n\tlogDest = &sectionWriter{w: logDest, wroteSection: wroteSection}\n\n\t// Status sidecar: best-effort — a write failure\n\t// (e.g. a read-only filesystem) must not abort the loop itself, only\n\t// mean the TUI's list-row badge and stop-notification dedup won't see it.\n\t// mg-jdi's own stdout/run.log remain authoritative for a human watching\n\t// directly either way.\n\tstatusFn := func(state job.JDIState, agent string) {\n\t\tif err := job.WriteJDIStatus(root, j.Name, state, agent); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not write status sidecar: %v\\n\", err)\n\t\t}\n\t}\n\n\tlogStarted(logDest, j.Name, profile)\n\tresult := Run(root, j, runner, logDest, statusFn)\n\tfmt.Fprintf(stdout, \"\\nmg jdi: %s — %s\\n\", result.Kind, result.Reason)\n\n\t// Stop notification, CLI path: ring the terminal bell\n\t// at both loop-exit points (finished, needs human) — this process is\n\t// attached to the human's own terminal for a direct `mg jdi` run, which\n\t// is the only case this leg has an audience for. A TUI-launched run has\n\t// no terminal to ring into at all; the TUI rings on its own next poll\n\t// tick instead (see pollJDIBell in internal/ui/app.go), once it observes\n\t// this job's status sidecar (just written above) transition into a\n\t// stopped state.\n\tfmt.Fprint(stdout, \"\\a\")\n\n\t// Stop notification, ntfy path (opt-in — see internal/notify): both the\n\t// CLI path and a TUI-launched run go through this same runJDI stop path,\n\t// so notifying here covers both. Best-effort like the sidecar/run-log\n\t// warnings above — a send failure warns on stderr and never aborts the\n\t// exit path.\n\tnotifyStop(stderr, j.Name, result)\n\n\tif result.Kind == orchestrate.StopNeedsHuman {\n\t\treturn 1\n\t}\n\treturn 0\n}\n\n// notifyStop sends the opt-in ntfy stop notification for a finished mg-jdi\n// run: a default-priority success message (tag white_check_mark) when the\n// run finished (result.Kind == StopFinished), and a high-priority attention\n// message (tag warning, priority 4) when it stopped needing a human. Both\n// messages carry the job name and the stop reason. It is a strict no-op when\n// NTFY_TOPIC is unset (nothing is sent, no error), and a send failure only\n// warns on stderr — never aborting the caller.\nfunc notifyStop(stderr io.Writer, jobName string, result LoopResult) {\n\tc := notify.FromConfig()\n\tif !c.Enabled() {\n\t\treturn\n\t}\n\n\tmsg := notify.Message{Message: result.Reason}\n\tswitch result.Kind {\n\tcase orchestrate.StopFinished:\n\t\tmsg.Title = \"mg jdi: \" + jobName + \" finished\"\n\t\tmsg.Tags = []string{\"white_check_mark\"}\n\tdefault: // orchestrate.StopNeedsHuman\n\t\tmsg.Title = \"mg jdi: \" + jobName + \" needs attention\"\n\t\tmsg.Tags = []string{\"warning\"}\n\t\tmsg.Priority = 4\n\t}\n\tif err := c.Publish(msg); err != nil {\n\t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not send ntfy notification: %v\\n\", err)\n\t}\n}\n\n// notifyCrashedRun checks, at a new `mg jdi` run's start, whether the\n// previous run for job j died without ever reporting a stop — a JDIRunning\n// status in the sidecar stale past job's jdiRunningStaleAfter (see\n// job.StaleRunningJDI) — and pushes a high-priority attention notification\n// (tag warning, priority 4) about it. Once the crash has been notified, the\n// stale sidecar is overwritten with JDIStoppedNeedsHuman so a later start\n// does not re-notify about the same already-known crash; a failed send does\n// not mark it, so the notification is retried on the next start instead.\n//\n// It is a strict no-op when ntfy is unconfigured (no NTFY_TOPIC): nothing is\n// read-modify-written, keeping unconfigured behavior byte-for-byte identical\n// (the TUI still degrades the stale sidecar away on its own). Failures warn\n// on stderr and never abort the run.\nfunc notifyCrashedRun(stderr io.Writer, root string, j job.Job) {\n\tc := notify.FromConfig()\n\tif !c.Enabled() {\n\t\treturn\n\t}\n\n\tst, crashed := job.StaleRunningJDI(root, j.Name)\n\tif !crashed {\n\t\treturn\n\t}\n\n\tmsg := notify.Message{\n\t\tTitle:    \"mg jdi: \" + j.Name + \" crashed\",\n\t\tMessage:  fmt.Sprintf(\"The previous mg jdi run appears to have crashed or been killed (status stale since %s).\", st.Updated.Format(time.RFC3339)),\n\t\tTags:     []string{\"warning\"},\n\t\tPriority: 4,\n\t}\n\tif st.Agent != \"\" {\n\t\tmsg.Message += fmt.Sprintf(\" Last agent: %s.\", st.Agent)\n\t}\n\tif err := c.Publish(msg); err != nil {\n\t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not send ntfy notification: %v\\n\", err)\n\t\treturn\n\t}\n\n\t// Mark the crash as known so the next start doesn't re-notify about it.\n\tif err := job.WriteJDIStatus(root, j.Name, job.JDIStoppedNeedsHuman, st.Agent); err != nil {\n\t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not mark the crashed run as known: %v\\n\", err)\n\t}\n}\n\n// resolveJob finds the job named or ID-prefixed by arg among every job\n// job.Discover can see (cross-branch — see internal/job), mirroring the\n// session launcher's own --job resolution: an exact job-directory-name match\n// first, then an exact ID match, then a directory-name prefix match.\nfunc resolveJob(root, arg string) (job.Job, error) {\n\tjobs, err := job.Discover(root)\n\tif err != nil {\n\t\treturn job.Job{}, fmt.Errorf(\"could not list jobs: %w\", err)\n\t}\n\n\t// A job's Name is its id_slug — the same concept as a branch tail — so\n\t// the exact-name and name-prefix matching below reuses the branch-matching\n\t// primitives in internal/git rather than re-implementing them.\n\tbyName := make(map[string]job.Job, len(jobs))\n\tnames := make([]string, len(jobs))\n\tfor i, j := range jobs {\n\t\tbyName[j.Name] = j\n\t\tnames[i] = j.Name\n\t}\n\n\tif name := git.ExactBranchMatch(names, arg); name != \"\" {\n\t\treturn byName[name], nil\n\t}\n\tfor _, j := range jobs {\n\t\tif j.ID == arg {\n\t\t\treturn j, nil\n\t\t}\n\t}\n\n\tswitch matches := git.PrefixBranchMatches(names, arg); len(matches) {\n\tcase 0:\n\t\treturn job.Job{}, fmt.Errorf(\"job %q not found under docs/jobs/\", arg)\n\tcase 1:\n\t\treturn byName[matches[0]], nil\n\tdefault:\n\t\treturn job.Job{}, fmt.Errorf(\"job %q is ambiguous — matches %d jobs\", arg, len(matches))\n\t}\n}\n\n// AgentRunner runs one non-interactive agent invocation for job j and\n// returns its captured output (the session launcher's --print path — a\n// `claude --print --verbose --output-format stream-json` event stream, an\n// `opencode run --format json` event stream, or plain text; see\n// internal/orchestrate.DetectSignal, which handles all three). Run's loop\n// persists the raw bytes to the job's session.log (appendSessionLog) and\n// extracts the response prose for run.log via orchestrate.ResultText.\n//\n// Implemented by commandAgentRunner for real invocations; the tests use a\n// fake instead of spawning real containers.\ntype AgentRunner interface {\n\tRun(agent string, j job.Job) ([]byte, error)\n}\n\n// commandAgentRunner is the real AgentRunner: it calls the session package's\n// --print path in-process (the replacement for exec'ing the resolved run.sh),\n// capturing the agent's stdout and routing diagnostics to a buffer that only\n// surfaces on error — the same visibility the exec'd run.sh's fd-3\n// diagnostics had.\ntype commandAgentRunner struct {\n\tprojectRoot string\n\tprofile     string\n}\n\n// newCommandAgentRunner builds the in-process runner. projectRoot is where\n// --job resolution starts from (run.sh used $PWD, which the old runner set to\n// the project root); profile is passed through unchanged to every Run\n// invocation — see its own doc.\nfunc newCommandAgentRunner(projectRoot, profile string) (*commandAgentRunner, error) {\n\treturn &commandAgentRunner{projectRoot: projectRoot, profile: profile}, nil\n}\n\n// agentInvocation builds the session options for one agent run — the --print\n// invocation with the runner's pinned profile, the agent, and the exact job\n// directory name.\nfunc (r *commandAgentRunner) agentInvocation(agent string, j job.Job) session.Options {\n\treturn session.Options{Print: true, Profile: r.profile, Agent: agent, Job: j.Name}\n}\n\n// Run invokes the session launcher's --print path synchronously and returns\n// its stdout. The --print path keeps stdout clean of its own diagnostics\n// (they go to the diag writer), so stdout here is exactly the agent's own\n// response. j.Name (the exact job directory name) is passed rather than j.ID\n// to remove any ambiguity in the --job resolution.\n//\n// r.profile is passed explicitly rather than left to the launcher's own\n// default (main's --profile flag, validated and defaulted to\n// config.ProfileClaudePro there) so a run keeps using the profile it was\n// started with even when the user later changes their default profile via\n// `mg profiles` mid-run.\nfunc (r *commandAgentRunner) Run(agent string, j job.Job) ([]byte, error) {\n\topts := r.agentInvocation(agent, j)\n\tinfo, err := session.ResolveProfile(opts)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\troot, err := session.ResolveRootFrom(opts, r.projectRoot)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif err := info.CheckAuth(); err != nil {\n\t\treturn nil, err\n\t}\n\n\tvar diag bytes.Buffer\n\tinv, err := session.BuildDockerInvocation(opts, info, root, false, &diag)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\t// Prune orphaned manigot containers before the run — the same fail-soft\n\t// self-healing cleanup as the interactive session path. Warnings go into\n\t// the diag buffer, which only surfaces on error; a prune failure never\n\t// aborts the invocation.\n\tif _, err := pruneOrphans(&diag); err != nil {\n\t\tfmt.Fprintf(&diag, \"mg: warning: could not prune orphaned containers: %v\\n\", err)\n\t}\n\n\tvar stdout bytes.Buffer\n\tcode, ran := inv.Run(os.Stdin, &stdout, &diag)\n\t// The same host-side sweep as the interactive session path: every mg-jdi\n\t// --print invocation ends with leftover changes committed, including the\n\t// analyst's tasks.md (the analyst is read-only and cannot commit it\n\t// itself). The sweep runs before the loop's post-run stall probe reads\n\t// HEAD, so the sweep commit correctly counts as agent progress. Sweep only\n\t// when the container actually ran — an agent that never started must not\n\t// trigger a commit.\n\tif ran {\n\t\tsession.SweepJobWorktree(root, &diag)\n\t}\n\tif code != 0 {\n\t\treturn stdout.Bytes(), fmt.Errorf(\"mg --print --agent %s --job %s: exit code %d: %s\", agent, j.Name, code, strings.TrimSpace(diag.String()))\n\t}\n\treturn stdout.Bytes(), nil\n}\n\n// LoopResult is Run's outcome: always one of orchestrate.StopFinished or\n// orchestrate.StopNeedsHuman — Run never returns while orchestrate.Next\n// keeps saying RunAgent.\ntype LoopResult struct {\n\tKind   orchestrate.Kind\n\tReason string\n}\n\n// maxIterations is a hard safety cap on loop iterations, independent of\n// orchestrate.Next's own one-bounce retry budget — a defensive backstop\n// against an unforeseen bug in the state machine looping forever rather than\n// trusting Next's own termination alone.\nconst maxIterations = 20\n\n// jdiProbeTimeout bounds each loop iteration's git probes (HeadCommit,\n// CountVerdictCommits, LatestCommitIsVerdict): local, fast reads, so 10s is\n// generous — the point is that a hung git stalls one probe rather than the\n// whole run. The probe errors are already read with `_` (the loop tolerates a\n// failed probe as \"no information\"), so a timeout degrades exactly like any\n// other probe failure and surfaces in the stop reason only if it's the last\n// thing that happened before a stop.\n//\n// A var rather than a const so tests can lower it: the stall-backstop test\n// needs a runner whose Run call outlives the probe timeout, which would be\n// a 10s test at the production value.\nvar jdiProbeTimeout = 10 * time.Second\n\n// StatusFunc is called by Run at each state transition: once\n// before invoking an agent (job.JDIRunning, that agent's name) and once\n// more at loop exit (the terminal state, and the last agent that ran, or \"\"\n// if none ever did — e.g. a job stuck at StageDefine). May be nil, in which\n// case Run simply doesn't report status — used by tests that don't care\n// about the sidecar file.\ntype StatusFunc func(state job.JDIState, agent string)\n\n// jdiTerminalState maps a LoopResult's orchestrate.Kind (always\n// StopFinished or StopNeedsHuman by the time Run returns) to the\n// corresponding job.JDIState reported to StatusFunc.\nfunc jdiTerminalState(k orchestrate.Kind) job.JDIState {\n\tif k == orchestrate.StopFinished {\n\t\treturn job.JDIStoppedFinished\n\t}\n\treturn job.JDIStoppedNeedsHuman\n}\n\n// Run drives job j through the agent sequence via runner, writing each\n// invocation's formatted output to log (see jdioutput.go's logInvocation) and\n// reporting state transitions to status (may be nil), until\n// orchestrate.Next reports StopFinished or StopNeedsHuman.\n//\n// The attempt number in each invocation's log header (logAgentInvoked /\n// logInvocation) counts that agent's own invocations within this run — per\n// agent, not a run-wide counter — so a bounce back to the developer logs\n// that developer's second call as attempt 2, not attempt 4. The counter is\n// seeded at 0 before the loop and reset at the start of every run, matching\n// the loop index's old behavior.\n//\n// Each iteration re-derives its decision from job.Stage() and git — the\n// job.Job struct's identity fields (Dir/Root/Branch/ID/Name) never change\n// across iterations, but Stage() and the git.CountVerdictCommits/\n// LatestCommitIsVerdict reads underneath it are re-evaluated fresh every\n// time, since they read from disk/git rather than a cached snapshot — so\n// Run never needs to re-fetch or mutate j itself mid-loop.\nfunc Run(root string, j job.Job, runner AgentRunner, log io.Writer, status StatusFunc) LoopResult {\n\tvar lastAgent string\n\tvar lastNoChange bool\n\tvar agentEverRan bool\n\n\treport := func(state job.JDIState, agent string) {\n\t\tif status != nil {\n\t\t\tstatus(state, agent)\n\t\t}\n\t}\n\t// finish reports the terminal status, logs the \"job finished\" event,\n\t// and builds the LoopResult every exit point returns.\n\t// includeReason is normally true; it's false only for the\n\t// stop-before-any-agent-ran case below, whose reason was already printed\n\t// by logImmediateStop a line above — see logJobFinished's own doc.\n\t//\n\t// Loop-exit sweep first: the per-invocation sweep\n\t// (session.SweepJobWorktree inside commandAgentRunner.Run) runs BEFORE\n\t// the loop's session.log append, so the final section would otherwise\n\t// stay an uncommitted tracked modification — session.log is untracked\n\t// when iteration 1 appends it, iteration 2's sweep `git add -A` commits\n\t// it (now TRACKED), every later append is a tracked modification, and\n\t// git.WorkingTreeDirty DOES report tracked modifications, so mg done's\n\t// clean-tree check (finish.go) would refuse to finish the job. Commit\n\t// everything left — the final session.log section above all — with the\n\t// sweep's own message. Linked worktrees only: for a pre-worktree job\n\t// (branch checked out in the MAIN worktree itself — an explicitly\n\t// supported, Discover-visible state) the resolved worktree IS j.Root,\n\t// where the user's own uncommitted work lives — sweeping there would\n\t// commit it, an unexcluded .env included, onto the job branch, the\n\t// exact hazard session.SweepJobWorktree's ProjectRoot == InvocationRoot\n\t// gate exists for — so the sweep is skipped when WorktreeForBranch\n\t// resolves to the main worktree. The stop-before-any-agent path has\n\t// nothing to commit and ErrNothingToCommit is swallowed.\n\tfinish := func(kind orchestrate.Kind, reason string, includeReason bool) LoopResult {\n\t\tif wt, ok, err := git.WorktreeForBranch(j.Root, j.Branch); err != nil {\n\t\t\tfmt.Fprintf(log, \"mg jdi: warning: could not resolve worktree for the final session-log sweep: %v\\n\", err)\n\t\t} else if ok && filepath.Clean(wt) != filepath.Clean(j.Root) {\n\t\t\tif err := git.CommitAll(wt, fmt.Sprintf(\"[%s] chore: commit all\", j.ID)); err != nil && !errors.Is(err, git.ErrNothingToCommit) && !errors.Is(err, git.ErrNotARepo) {\n\t\t\t\tfmt.Fprintf(log, \"mg jdi: warning: could not commit the session log: %v\\n\", err)\n\t\t\t}\n\t\t}\n\t\treport(jdiTerminalState(kind), lastAgent)\n\t\tlogJobFinished(log, kind, reason, includeReason)\n\t\treturn LoopResult{Kind: kind, Reason: reason}\n\t}\n\n\t// attempts counts each agent's invocations within this run, keyed by\n\t// agent name — per agent, not run-wide — and feeds the \"attempt N\" in\n\t// both logAgentInvoked's and logInvocation's headers below. Seeded at 0\n\t// before the loop, so the first call of every agent is attempt 1.\n\tattempts := make(map[string]int)\n\n\tfor i := 0; i < maxIterations; i++ {\n\t\t// One bounded context for this iteration's pre-agent git probes\n\t\t// (see jdiProbeTimeout): a hung git must stall one probe, not the\n\t\t// whole run. Each context is cancelled at its point of use — never\n\t\t// deferred, which would accumulate up to maxIterations timers until\n\t\t// Run returns. The post-agent stall probe gets its own fresh context\n\t\t// below: runner.Run is a minutes-long docker/LLM invocation, so a\n\t\t// context created here would be long expired by the time that probe\n\t\t// runs and would read \"\" for HEAD, silently defeating the stall\n\t\t// backstop.\n\t\tprobeCtx, cancelProbes := context.WithTimeout(context.Background(), jdiProbeTimeout)\n\n\t\tstageBefore := j.Stage()\n\t\trounds, _ := git.CountVerdictCommitsWithContext(probeCtx, root, j.Branch, j.ID)\n\t\ttipIsVerdict, _ := git.LatestCommitIsVerdictWithContext(probeCtx, root, j.Branch, j.ID)\n\t\tdecision := orchestrate.Next(stageBefore, rounds, tipIsVerdict)\n\n\t\tif decision.Kind != orchestrate.RunAgent {\n\t\t\tcancelProbes()\n\t\t\tincludeReason := true\n\t\t\tif !agentEverRan {\n\t\t\t\t// No agent has run yet this whole loop (typically the very\n\t\t\t\t// first iteration, e.g. an unwritten brief.md) — logInvocation\n\t\t\t\t// never gets a chance to run for this stop, which otherwise\n\t\t\t\t// leaves run.log at 0 bytes for a case that has just as much\n\t\t\t\t// reason to explain itself there as any agent invocation does.\n\t\t\t\tlogImmediateStop(log, decision.Reason)\n\t\t\t\tincludeReason = false\n\t\t\t}\n\t\t\treturn finish(decision.Kind, decision.Reason, includeReason)\n\t\t}\n\n\t\treport(job.JDIRunning, decision.Agent)\n\t\tattempts[decision.Agent]++\n\t\tlogAgentInvoked(log, decision.Agent, attempts[decision.Agent])\n\t\theadBefore, _ := git.HeadCommitWithContext(probeCtx, root, j.Branch)\n\t\tcancelProbes() // pre-agent probes done; the agent invocation below can take minutes\n\n\t\tout, runErr := runner.Run(decision.Agent, j)\n\t\tagentEverRan = true\n\n\t\t// Read the just-run agent's expected target file fresh off\n\t\t// disk, so logInvocation can skip re-printing output that's already\n\t\t// the same as what got written to the job's own markdown file. Safe\n\t\t// to read directly from j.Dir — see orchestrate.AgentTargetFile's own\n\t\t// doc. A missing/unreadable file (targetContent left \"\") just means\n\t\t// logInvocation's dedup check never matches, which is the same as\n\t\t// not having this feature at all for that call.\n\t\tvar targetContent string\n\t\ttargetFile := orchestrate.AgentTargetFile[decision.Agent]\n\t\tif targetFile != \"\" {\n\t\t\tif data, rerr := os.ReadFile(filepath.Join(j.Dir, targetFile)); rerr == nil {\n\t\t\t\ttargetContent = string(data)\n\t\t\t}\n\t\t}\n\n\t\t// Fan-out: log gets the same formatted section\n\t\t// regardless of whether it's os.Stdout, the sidecar run.log, or (in\n\t\t// tests) an in-memory buffer — see main()'s io.MultiWriter and\n\t\t// jdioutput.go's logInvocation. DetectSignal below scans the raw bytes\n\t\t// directly (it does its own JSON extraction), independent of what\n\t\t// logInvocation writes for a human to read.\n\t\tlogInvocation(log, decision.Agent, attempts[decision.Agent], out, targetFile, targetContent)\n\n\t\t// Session log: persist this invocation's raw captured output — the\n\t\t// whole step-level event stream, not just the final answer — to the\n\t\t// job's own session.log (docs/jobs/<id>_<slug>/session.log), for\n\t\t// every invocation including failed ones, so what an agent did\n\t\t// during an unattended run survives. Best-effort: a failure only\n\t\t// warns through the log writer (Run has no stderr) and never aborts\n\t\t// the loop. The section stays uncommitted until the finish closure's\n\t\t// loop-exit sweep below — the per-invocation sweep inside\n\t\t// commandAgentRunner.Run already ran before this append.\n\t\tif err := appendSessionLog(filepath.Join(j.Dir, \"session.log\"), decision.Agent, attempts[decision.Agent], out); err != nil {\n\t\t\tfmt.Fprintf(log, \"mg jdi: warning: could not append to session log: %v\\n\", err)\n\t\t}\n\n\t\tif sig, ok := orchestrate.DetectSignal(out); ok {\n\t\t\tlastAgent = decision.Agent\n\t\t\treturn finish(orchestrate.StopNeedsHuman, fmt.Sprintf(\"%s asked for human input: %s\", decision.Agent, sig.Reason), true)\n\t\t}\n\t\tif runErr != nil {\n\t\t\tlastAgent = decision.Agent\n\t\t\treturn finish(orchestrate.StopNeedsHuman, fmt.Sprintf(\"%s invocation failed: %v\", decision.Agent, runErr), true)\n\t\t}\n\n\t\t// Stall backstop: the same agent invoked twice in a\n\t\t// row, each time persisting nothing at all (neither Stage() nor the\n\t\t// branch HEAD moved across that invocation), stops on the second\n\t\t// such occurrence — a single no-op invocation is tolerated (it may\n\t\t// be transient), but two in a row for the same agent means it's\n\t\t// genuinely stuck, regardless of whether the NEEDS-HUMAN-INPUT\n\t\t// marker was present.\n\t\tstageAfter := j.Stage()\n\t\t// Fresh context for the post-agent probe: the pre-agent probeCtx\n\t\t// above was cancelled before runner.Run and would in any case be\n\t\t// long expired after a minutes-long invocation — reusing it would\n\t\t// make this probe fail instantly and read \"\", which noChange would\n\t\t// take as a HEAD change and the stall backstop would never fire.\n\t\tprobeAfterCtx, cancelProbeAfter := context.WithTimeout(context.Background(), jdiProbeTimeout)\n\t\theadAfter, _ := git.HeadCommitWithContext(probeAfterCtx, root, j.Branch)\n\t\tcancelProbeAfter()\n\t\tnoChange := stageAfter == stageBefore && headAfter == headBefore\n\n\t\tif noChange && lastNoChange && decision.Agent == lastAgent {\n\t\t\treturn finish(orchestrate.StopNeedsHuman, fmt.Sprintf(\"%s made no progress on two consecutive runs (Stage and branch HEAD unchanged both times) — stopping rather than looping indefinitely\", decision.Agent), true)\n\t\t}\n\t\tlastAgent, lastNoChange = decision.Agent, noChange\n\t}\n\n\treturn finish(orchestrate.StopNeedsHuman, fmt.Sprintf(\"exceeded %d iterations without finishing\", maxIterations), true)\n}","lineStart":1,"lineEnd":621,"totalLines":621,"truncated":false}},"title":"src/cmd/mg/jdi.go","time":{"start":1787919605830,"end":1787919605834}},"id":"prt_048501f31001gYPUJMpjp0Znul","sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","messageID":"msg_048501056001pkYCD3Qd3H0sPL"}}
{"type":"step_finish","timestamp":1787919605869,"sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","part":{"id":"prt_048502067001buES7qzrBy0S6s","reason":"tool-calls","snapshot":"","messageID":"msg_048501056001pkYCD3Qd3H0sPL","sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","type":"step-finish","tokens":{"total":66429,"input":66374,"output":55,"reasoning":0,"cache":{"write":0,"read":0}},"cost":0.01463858}}
{"type":"step_start","timestamp":1787919607105,"sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","part":{"id":"prt_04850253f001UYkE4r2zyro1EB","messageID":"msg_04850206c001TA8151iLkxcLkN","sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","snapshot":"","type":"step-start"}}
{"type":"tool_use","timestamp":1787919607479,"sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","part":{"type":"tool","tool":"read","callID":"call_e2af8e4835054ce7bb9c1342","state":{"status":"completed","input":{"filePath":"/workspace/src/cmd/mg/jdioutput.go"},"output":"<path>/workspace/src/cmd/mg/jdioutput.go</path>\n<type>file</type>\n<content>\n1: package main\n2: \n3: import (\n4: \t\"bytes\"\n5: \t\"fmt\"\n6: \t\"io\"\n7: \t\"os\"\n8: \t\"path/filepath\"\n9: \t\"strings\"\n10: \t\"time\"\n11: \n12: \t\"github.com/lmuskalla/manigot/internal/job\"\n13: \t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n14: )\n15: \n16: // sidecarExcludePattern is the .gitignore-syntax line ensureSidecarIgnored\n17: // adds to a project's .git/info/exclude — every job's status sidecar, not\n18: // just one, since the pattern is directory-shaped\n19: // (\".manigot/jdi-status/\"). Rebuilt from the same constants\n20: // (job.ManigotRelDir + job.JDISidecarDirName) the Go path construction\n21: // uses, so the exclude pattern can never drift from where the sidecar is\n22: // actually written.\n23: var sidecarExcludePattern = filepath.ToSlash(filepath.Join(job.ManigotRelDir, job.JDISidecarDirName)) + \"/\"\n24: \n25: // ensureSidecarIgnored appends sidecarExcludePattern to root's\n26: // .git/info/exclude if not already present.\n27: //\n28: // This matters because the status/run.log sidecar lives inside\n29: // the *target project's* .manigot/ — not manigot's own checkout — and the\n30: // whole point of keeping it outside every job's own directory is so it can\n31: // never be swept into an agent's own `git add -A`. That only actually holds\n32: // if *this project's* git configuration excludes it: manigot's own\n33: // .gitignore has no bearing on a project mg-jdi is driving. Rather than\n34: // assume (or silently mutate) the project's own tracked .gitignore,\n35: // .git/info/exclude is the right mechanism — local-only, per-checkout, never\n36: // itself committed — so mg-jdi can guarantee this without touching anything\n37: // the project's own history would ever see. Idempotent: safe to call on\n38: // every mg-jdi run.\n39: //\n40: // Best-effort: a failure here (root isn't a git repo, .git/info isn't\n41: // writable, etc.) is surfaced to the caller to log, but must not abort the\n42: // run — worst case the sidecar risks being swept into a commit, exactly the\n43: // pre-existing behavior before this safeguard existed.\n44: func ensureSidecarIgnored(root string) error {\n45: \texcludePath := filepath.Join(root, \".git\", \"info\", \"exclude\")\n46: \n47: \texisting, err := os.ReadFile(excludePath)\n48: \tswitch {\n49: \tcase err == nil:\n50: \t\tif containsLine(string(existing), sidecarExcludePattern) {\n51: \t\t\treturn nil\n52: \t\t}\n53: \tcase os.IsNotExist(err):\n54: \t\texisting = nil\n55: \tdefault:\n56: \t\treturn err\n57: \t}\n58: \n59: \tif err := os.MkdirAll(filepath.Dir(excludePath), 0o755); err != nil {\n60: \t\treturn err\n61: \t}\n62: \tf, err := os.OpenFile(excludePath, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n63: \tif err != nil {\n64: \t\treturn err\n65: \t}\n66: \tdefer f.Close()\n67: \n68: \tprefix := \"\"\n69: \tif len(existing) > 0 && existing[len(existing)-1] != '\\n' {\n70: \t\tprefix = \"\\n\"\n71: \t}\n72: \t_, err = f.WriteString(prefix + sidecarExcludePattern + \"\\n\")\n73: \treturn err\n74: }\n75: \n76: // containsLine reports whether body has pattern as one of its lines\n77: // (trimmed), so an existing exclude file with the pattern already present —\n78: // however it got there — isn't duplicated on a second mg-jdi run.\n79: func containsLine(body, pattern string) bool {\n80: \tfor _, line := range strings.Split(body, \"\\n\") {\n81: \t\tif strings.TrimSpace(line) == pattern {\n82: \t\t\treturn true\n83: \t\t}\n84: \t}\n85: \treturn false\n86: }\n87: \n88: // openRunLog ensures the sidecar directory (job.JDIStatusDir — shared with\n89: // the status file WriteJDIStatus writes) exists and opens\n90: // (creating if necessary) run.log for appending — a fresh mg-jdi run\n91: // continues the same job's transcript rather than truncating it, so a human\n92: // can see the full history of every run against this job, not just the most\n93: // recent one. It also reports whether the log already had content when it\n94: // was opened (hadContent), which main() feeds to sectionWriter so the very\n95: // first run ever written to a log starts it cleanly without a leading blank\n96: // line (see sectionWriter's own doc).\n97: func openRunLog(root, jobName string) (*os.File, bool, error) {\n98: \tdir := job.JDIStatusDir(root, jobName)\n99: \tif err := os.MkdirAll(dir, 0o755); err != nil {\n100: \t\treturn nil, false, fmt.Errorf(\"create sidecar dir %s: %w\", dir, err)\n101: \t}\n102: \tf, err := os.OpenFile(job.JDIRunLogPath(root, jobName), os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n103: \tif err != nil {\n104: \t\treturn nil, false, fmt.Errorf(\"open run log: %w\", err)\n105: \t}\n106: \tst, err := f.Stat()\n107: \tif err != nil {\n108: \t\tf.Close()\n109: \t\treturn nil, false, fmt.Errorf(\"stat run log: %w\", err)\n110: \t}\n111: \treturn f, st.Size() > 0, nil\n112: }\n113: \n114: // sectionPrefix is the literal every \"=== ... ===\" state-log header in this\n115: // file starts with — the five log* functions (logStarted, logAgentInvoked,\n116: // logInvocation, logJobFinished, logImmediateStop) all emit their event\n117: // headers as a line beginning with it. sectionWriter keys off it so it only\n118: // inserts blank lines between actual sections, never inside one (the agent\n119: // text and stop-reason bodies that follow their headers are separate writes\n120: // that don't match).\n121: var sectionPrefix = []byte(\"===\")\n122: \n123: // sectionWriter is the writer mg-jdi's log destinations (stdout and the\n124: // sidecar run.log) are wrapped in before anything is logged: it inserts a\n125: // blank line before every \"=== ... ===\" section header written through it,\n126: // so the log's events don't get crumbled together — either between the\n127: // state events of a single run, or between consecutive mg-jdi runs of the\n128: // same job appending to the same run.log.\n129: //\n130: // wroteSection seeds the writer with the pre-existing state of the\n131: // underlying destination — whether run.log already had content when it was\n132: // opened (see openRunLog). true means the first header written through this\n133: // writer still needs its separating blank line (it's joining prior runs'\n134: // output); false means this is the very first run ever written to the log,\n135: // and the first header starts it at the top of the file with no leading\n136: // blank line. Either way, every subsequent header gets the blank line.\n137: //\n138: // A non-header write (a header's following reason line, or an invocation's\n139: // agent text, each of which arrives as its own write that does not start\n140: // with sectionPrefix) passes through untouched — it belongs to the section\n141: // that just began. sectionWriter itself never inserts blank lines inside a\n142: // section; any body/header separation beyond the header's own trailing\n143: // newline is the caller's own writes (logInvocation, for one, emits two\n144: // blank lines of its own between the \"finished\" header and the agent text —\n145: // see its doc).\n146: type sectionWriter struct {\n147: \tw            io.Writer\n148: \twroteSection bool\n149: }\n150: \n151: func (s *sectionWriter) Write(p []byte) (int, error) {\n152: \tif bytes.HasPrefix(p, sectionPrefix) {\n153: \t\tif s.wroteSection {\n154: \t\t\tif _, err := io.WriteString(s.w, \"\\n\\n\"); err != nil {\n155: \t\t\t\treturn 0, err\n156: \t\t\t}\n157: \t\t}\n158: \t\ts.wroteSection = true\n159: \t}\n160: \treturn s.w.Write(p)\n161: }\n162: \n163: // logStarted writes a \"mg jdi started\" event to w, once, at the very top of\n164: // a run — main()'s first write to logDest, before Run is even\n165: // invoked, so a human watching run.log sees confirmation the run began\n166: // immediately, rather than the log staying empty until the first agent\n167: // invocation finishes. Mirrors\n168: // logImmediateStop's \"=== ... ===\" header shape so every event in the log\n169: // looks consistent.\n170: func logStarted(w io.Writer, jobName, profile string) {\n171: \tfmt.Fprintf(w, \"=== %s mg jdi started: job %s, profile %s ===\\n\", time.Now().Format(time.RFC3339), jobName, profile)\n172: }\n173: \n174: // logAgentInvoked writes an \"agent invoked\" event to w immediately before\n175: // Run launches an agent — distinct from logInvocation's own\n176: // post-run header below, so a human watching run.log sees an invoked\n177: // header right away rather than waiting for the (possibly long-running)\n178: // invocation to finish before anything at all appears for it. attempt is\n179: // that agent's invocation count within the run — per agent, not per run —\n180: // so the first call of every agent is attempt 1, and a bounced-back\n181: // agent's second call is attempt 2.\n182: func logAgentInvoked(w io.Writer, agent string, attempt int) {\n183: \tfmt.Fprintf(w, \"=== %s %s invoked (attempt %d) ===\\n\", time.Now().Format(time.RFC3339), agent, attempt)\n184: }\n185: \n186: // logJobFinished writes a \"job finished\" event to w at Run's loop exit\n187: // — both terminal outcomes, StopFinished and StopNeedsHuman.\n188: //\n189: // includeReason is false only for the stop-before-any-agent-ran case: that\n190: // path has already printed reason via logImmediateStop immediately above,\n191: // so repeating it here would print the exact same line twice in a row.\n192: // Every other call site has never logged reason before this point, so it's\n193: // included.\n194: func logJobFinished(w io.Writer, kind orchestrate.Kind, reason string, includeReason bool) {\n195: \tfmt.Fprintf(w, \"=== %s mg jdi finished: %s ===\\n\", time.Now().Format(time.RFC3339), kind)\n196: \tif includeReason && reason != \"\" {\n197: \t\tfmt.Fprintln(w, reason)\n198: \t}\n199: }\n200: \n201: // isDuplicateOutput reports whether fileContent — the just-run agent's\n202: // target file, read fresh after this invocation — appears, once both sides\n203: // are trimmed and internal whitespace is collapsed, as a substring of text —\n204: // the agent's own response (the \"already the same ... skip it\" rule).\n205: // Substring rather than exact equality, since a real\n206: // response typically echoes the file's content plus its own surrounding\n207: // commentary (a leading summary, a trailing \"done!\", etc.).\n208: //\n209: // An empty fileContent (the target file doesn't exist yet, or is itself\n210: // empty) never counts as a duplicate — trivially \"contained\" in anything,\n211: // but not a meaningful match.\n212: func isDuplicateOutput(text, fileContent string) bool {\n213: \tnormFile := normalizeWhitespace(fileContent)\n214: \tif normFile == \"\" {\n215: \t\treturn false\n216: \t}\n217: \treturn strings.Contains(normalizeWhitespace(text), normFile)\n218: }\n219: \n220: // normalizeWhitespace collapses s to single-space-separated fields, so\n221: // isDuplicateOutput's comparison isn't tripped up by incidental reformatting\n222: // (extra blank lines, trailing spaces, etc.) between what's on disk and what\n223: // an agent echoed back.\n224: func normalizeWhitespace(s string) string {\n225: \treturn strings.Join(strings.Fields(s), \" \")\n226: }\n227: \n228: // logInvocation writes one agent invocation's captured output to w — Run's\n229: // fan-out target, which main() builds as an io.MultiWriter of\n230: // mg-jdi's own stdout and the sidecar's run.log, so both destinations get\n231: // the exact same section: a \"=== <timestamp> <agent> finished (attempt N)\n232: // ===\" header — paired with logAgentInvoked's own header just before this\n233: // invocation started so a reader sees an invoked/finished\n234: // pair per agent call rather than one ambiguous header. N is that agent's\n235: // invocation count within the run — per agent, not per run — so the first\n236: // call of every agent is attempt 1, and a bounced-back agent's second call\n237: // is attempt 2. Then the agent's extracted final-response text\n238: // (orchestrate.ResultText) — not the raw --output-format stream-json blob,\n239: // so a human reading either destination sees prose, not JSON.\n240: //\n241: // Two blank lines separate the \"finished\" header from the agent's output\n242: // (brief: jdi logs new line): without them the output reads as glued to the\n243: // finished statement — on a wrapped terminal, and in the TUI's log tab,\n244: // which renders run.log's raw content — as if it began on the same line.\n245: // The blank lines are written unconditionally, before whichever body variant\n246: // follows (real text, \"(no output)\", or the dedup \"(output matches ...,\n247: // omitted)\" note below), so the separation is the same in every case.\n248: //\n249: // Honesty note (carried into scripts/entrypoint.sh's own comment): this is\n250: // exactly the agent's *final response text* per invocation — the prose\n251: // ResultText extracts from whatever --print shape produced it — not a\n252: // blow-by-blow of every tool call/file edit. The blow-by-blow itself is not\n253: // lost anymore: the raw captured output (the full step-level event stream\n254: // since --output-format stream-json) is persisted verbatim to the job's\n255: // session.log by appendSessionLog — run.log is the summary, session.log is\n256: // the truth.\n257: //\n258: // targetFile/targetContent are the just-run agent's expected job\n259: // file and its content read fresh after the invocation (see\n260: // orchestrate.AgentTargetFile) — the caller's responsibility, since it\n261: // already has j.Dir\n262: // on hand. When the response text turns out to be a duplicate of that file\n263: // (isDuplicateOutput), the body is replaced with a short note instead of the\n264: // full (possibly large) text — the header is unaffected, so a reader still\n265: // sees an invoked/finished pair either way. targetFile == \"\" (e.g. an\n266: // unrecognized agent, or the file couldn't be read) simply skips the check.\n267: func logInvocation(w io.Writer, agent string, attempt int, raw []byte, targetFile, targetContent string) {\n268: \t// \"\\n\\n\\n\" = the header's own trailing newline plus two blank lines, so\n269: \t// the agent's output starts two lines below the \"finished\" statement\n270: \t// (brief: jdi logs new line).\n271: \tfmt.Fprintf(w, \"=== %s %s finished (attempt %d) ===\\n\\n\\n\", time.Now().Format(time.RFC3339), agent, attempt)\n272: \ttext := orchestrate.ResultText(raw)\n273: \tswitch {\n274: \tcase text == \"\":\n275: \t\ttext = \"(no output)\"\n276: \tcase targetFile != \"\" && isDuplicateOutput(text, targetContent):\n277: \t\ttext = fmt.Sprintf(\"(output matches %s, omitted)\", targetFile)\n278: \t}\n279: \tif text[len(text)-1] != '\\n' {\n280: \t\ttext += \"\\n\"\n281: \t}\n282: \tfmt.Fprint(w, text)\n283: }\n284: \n285: // appendSessionLog persists one agent invocation's raw captured output to the\n286: // job's own session.log (docs/jobs/<id>_<slug>/session.log — the caller\n287: // passes the full path, which it derives from j.Dir) — the persistent\n288: // blow-by-blow of every non-interactive invocation in an mg-jdi run,\n289: // complementing run.log's per-invocation summary. It is called from Run's\n290: // loop for EVERY invocation, failed ones included, right after logInvocation.\n291: //\n292: // Each call opens the file per-section (O_CREATE|O_APPEND|O_WRONLY — a fresh\n293: // mg-jdi run continues the same job's session rather than truncating it) and\n294: // writes a \"=== <timestamp> <agent> (attempt N) ===\" header — the same\n295: // sectioned shape run.log uses — followed by the invocation's raw bytes\n296: // verbatim. A blank line separates each section from the previous one (never\n297: // a leading blank on a fresh file), and a trailing newline is guaranteed so\n298: // the next section's header never glues to raw output.\n299: func appendSessionLog(path, agent string, attempt int, raw []byte) error {\n300: \tf, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n301: \tif err != nil {\n302: \t\treturn err\n303: \t}\n304: \tdefer f.Close()\n305: \n306: \t// Blank-line separator between sections — the very first section ever\n307: \t// written to a fresh file starts at the top instead.\n308: \tif st, err := f.Stat(); err != nil {\n309: \t\treturn err\n310: \t} else if st.Size() > 0 {\n311: \t\tif _, err := io.WriteString(f, \"\\n\"); err != nil {\n312: \t\t\treturn err\n313: \t\t}\n314: \t}\n315: \n316: \tif _, err := fmt.Fprintf(f, \"=== %s %s (attempt %d) ===\\n\", time.Now().Format(time.RFC3339), agent, attempt); err != nil {\n317: \t\treturn err\n318: \t}\n319: \n320: \t// Trailing-newline guarantee; the raw bytes are otherwise untouched.\n321: \tif len(raw) > 0 && raw[len(raw)-1] != '\\n' {\n322: \t\traw = append(raw, '\\n')\n323: \t}\n324: \t_, err = f.Write(raw)\n325: \treturn err\n326: }\n327: \n328: // logImmediateStop writes an \"immediate stop\" note to w — orchestrate.Next\n329: // returning a Stop* decision before any agent has ever been invoked (e.g.\n330: // job.StageDefine with an unwritten brief.md), the one case logInvocation\n331: // never runs for. Without this, run.log would be left at 0 bytes for that\n332: // stop, itself confusing\n333: // independent of whether the stop was the correct call. Mirrors\n334: // logInvocation's \"=== ... ===\" header shape so both look consistent in the\n335: // same log, but names the stop instead of an agent/attempt.\n336: func logImmediateStop(w io.Writer, reason string) {\n337: \tfmt.Fprintf(w, \"=== %s mg jdi stopped before running any agent ===\\n\", time.Now().Format(time.RFC3339))\n338: \tfmt.Fprintln(w, reason)\n339: }\n\n(End of file - total 339 lines)\n</content>","metadata":{"preview":"package main\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n)\n\n// sidecarExcludePattern is the .gitignore-syntax line ensureSidecarIgnored\n// adds to a project's .git/info/exclude — every job's status sidecar, not\n// just one, since the pattern is directory-shaped\n// (\".manigot/jdi-status/\"). Rebuilt from the same constants\n// (job.ManigotRelDir + job.JDISidecarDirName) the Go path construction","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/cmd/mg/jdioutput.go","text":"package main\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n)\n\n// sidecarExcludePattern is the .gitignore-syntax line ensureSidecarIgnored\n// adds to a project's .git/info/exclude — every job's status sidecar, not\n// just one, since the pattern is directory-shaped\n// (\".manigot/jdi-status/\"). Rebuilt from the same constants\n// (job.ManigotRelDir + job.JDISidecarDirName) the Go path construction\n// uses, so the exclude pattern can never drift from where the sidecar is\n// actually written.\nvar sidecarExcludePattern = filepath.ToSlash(filepath.Join(job.ManigotRelDir, job.JDISidecarDirName)) + \"/\"\n\n// ensureSidecarIgnored appends sidecarExcludePattern to root's\n// .git/info/exclude if not already present.\n//\n// This matters because the status/run.log sidecar lives inside\n// the *target project's* .manigot/ — not manigot's own checkout — and the\n// whole point of keeping it outside every job's own directory is so it can\n// never be swept into an agent's own `git add -A`. That only actually holds\n// if *this project's* git configuration excludes it: manigot's own\n// .gitignore has no bearing on a project mg-jdi is driving. Rather than\n// assume (or silently mutate) the project's own tracked .gitignore,\n// .git/info/exclude is the right mechanism — local-only, per-checkout, never\n// itself committed — so mg-jdi can guarantee this without touching anything\n// the project's own history would ever see. Idempotent: safe to call on\n// every mg-jdi run.\n//\n// Best-effort: a failure here (root isn't a git repo, .git/info isn't\n// writable, etc.) is surfaced to the caller to log, but must not abort the\n// run — worst case the sidecar risks being swept into a commit, exactly the\n// pre-existing behavior before this safeguard existed.\nfunc ensureSidecarIgnored(root string) error {\n\texcludePath := filepath.Join(root, \".git\", \"info\", \"exclude\")\n\n\texisting, err := os.ReadFile(excludePath)\n\tswitch {\n\tcase err == nil:\n\t\tif containsLine(string(existing), sidecarExcludePattern) {\n\t\t\treturn nil\n\t\t}\n\tcase os.IsNotExist(err):\n\t\texisting = nil\n\tdefault:\n\t\treturn err\n\t}\n\n\tif err := os.MkdirAll(filepath.Dir(excludePath), 0o755); err != nil {\n\t\treturn err\n\t}\n\tf, err := os.OpenFile(excludePath, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer f.Close()\n\n\tprefix := \"\"\n\tif len(existing) > 0 && existing[len(existing)-1] != '\\n' {\n\t\tprefix = \"\\n\"\n\t}\n\t_, err = f.WriteString(prefix + sidecarExcludePattern + \"\\n\")\n\treturn err\n}\n\n// containsLine reports whether body has pattern as one of its lines\n// (trimmed), so an existing exclude file with the pattern already present —\n// however it got there — isn't duplicated on a second mg-jdi run.\nfunc containsLine(body, pattern string) bool {\n\tfor _, line := range strings.Split(body, \"\\n\") {\n\t\tif strings.TrimSpace(line) == pattern {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// openRunLog ensures the sidecar directory (job.JDIStatusDir — shared with\n// the status file WriteJDIStatus writes) exists and opens\n// (creating if necessary) run.log for appending — a fresh mg-jdi run\n// continues the same job's transcript rather than truncating it, so a human\n// can see the full history of every run against this job, not just the most\n// recent one. It also reports whether the log already had content when it\n// was opened (hadContent), which main() feeds to sectionWriter so the very\n// first run ever written to a log starts it cleanly without a leading blank\n// line (see sectionWriter's own doc).\nfunc openRunLog(root, jobName string) (*os.File, bool, error) {\n\tdir := job.JDIStatusDir(root, jobName)\n\tif err := os.MkdirAll(dir, 0o755); err != nil {\n\t\treturn nil, false, fmt.Errorf(\"create sidecar dir %s: %w\", dir, err)\n\t}\n\tf, err := os.OpenFile(job.JDIRunLogPath(root, jobName), os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n\tif err != nil {\n\t\treturn nil, false, fmt.Errorf(\"open run log: %w\", err)\n\t}\n\tst, err := f.Stat()\n\tif err != nil {\n\t\tf.Close()\n\t\treturn nil, false, fmt.Errorf(\"stat run log: %w\", err)\n\t}\n\treturn f, st.Size() > 0, nil\n}\n\n// sectionPrefix is the literal every \"=== ... ===\" state-log header in this\n// file starts with — the five log* functions (logStarted, logAgentInvoked,\n// logInvocation, logJobFinished, logImmediateStop) all emit their event\n// headers as a line beginning with it. sectionWriter keys off it so it only\n// inserts blank lines between actual sections, never inside one (the agent\n// text and stop-reason bodies that follow their headers are separate writes\n// that don't match).\nvar sectionPrefix = []byte(\"===\")\n\n// sectionWriter is the writer mg-jdi's log destinations (stdout and the\n// sidecar run.log) are wrapped in before anything is logged: it inserts a\n// blank line before every \"=== ... ===\" section header written through it,\n// so the log's events don't get crumbled together — either between the\n// state events of a single run, or between consecutive mg-jdi runs of the\n// same job appending to the same run.log.\n//\n// wroteSection seeds the writer with the pre-existing state of the\n// underlying destination — whether run.log already had content when it was\n// opened (see openRunLog). true means the first header written through this\n// writer still needs its separating blank line (it's joining prior runs'\n// output); false means this is the very first run ever written to the log,\n// and the first header starts it at the top of the file with no leading\n// blank line. Either way, every subsequent header gets the blank line.\n//\n// A non-header write (a header's following reason line, or an invocation's\n// agent text, each of which arrives as its own write that does not start\n// with sectionPrefix) passes through untouched — it belongs to the section\n// that just began. sectionWriter itself never inserts blank lines inside a\n// section; any body/header separation beyond the header's own trailing\n// newline is the caller's own writes (logInvocation, for one, emits two\n// blank lines of its own between the \"finished\" header and the agent text —\n// see its doc).\ntype sectionWriter struct {\n\tw            io.Writer\n\twroteSection bool\n}\n\nfunc (s *sectionWriter) Write(p []byte) (int, error) {\n\tif bytes.HasPrefix(p, sectionPrefix) {\n\t\tif s.wroteSection {\n\t\t\tif _, err := io.WriteString(s.w, \"\\n\\n\"); err != nil {\n\t\t\t\treturn 0, err\n\t\t\t}\n\t\t}\n\t\ts.wroteSection = true\n\t}\n\treturn s.w.Write(p)\n}\n\n// logStarted writes a \"mg jdi started\" event to w, once, at the very top of\n// a run — main()'s first write to logDest, before Run is even\n// invoked, so a human watching run.log sees confirmation the run began\n// immediately, rather than the log staying empty until the first agent\n// invocation finishes. Mirrors\n// logImmediateStop's \"=== ... ===\" header shape so every event in the log\n// looks consistent.\nfunc logStarted(w io.Writer, jobName, profile string) {\n\tfmt.Fprintf(w, \"=== %s mg jdi started: job %s, profile %s ===\\n\", time.Now().Format(time.RFC3339), jobName, profile)\n}\n\n// logAgentInvoked writes an \"agent invoked\" event to w immediately before\n// Run launches an agent — distinct from logInvocation's own\n// post-run header below, so a human watching run.log sees an invoked\n// header right away rather than waiting for the (possibly long-running)\n// invocation to finish before anything at all appears for it. attempt is\n// that agent's invocation count within the run — per agent, not per run —\n// so the first call of every agent is attempt 1, and a bounced-back\n// agent's second call is attempt 2.\nfunc logAgentInvoked(w io.Writer, agent string, attempt int) {\n\tfmt.Fprintf(w, \"=== %s %s invoked (attempt %d) ===\\n\", time.Now().Format(time.RFC3339), agent, attempt)\n}\n\n// logJobFinished writes a \"job finished\" event to w at Run's loop exit\n// — both terminal outcomes, StopFinished and StopNeedsHuman.\n//\n// includeReason is false only for the stop-before-any-agent-ran case: that\n// path has already printed reason via logImmediateStop immediately above,\n// so repeating it here would print the exact same line twice in a row.\n// Every other call site has never logged reason before this point, so it's\n// included.\nfunc logJobFinished(w io.Writer, kind orchestrate.Kind, reason string, includeReason bool) {\n\tfmt.Fprintf(w, \"=== %s mg jdi finished: %s ===\\n\", time.Now().Format(time.RFC3339), kind)\n\tif includeReason && reason != \"\" {\n\t\tfmt.Fprintln(w, reason)\n\t}\n}\n\n// isDuplicateOutput reports whether fileContent — the just-run agent's\n// target file, read fresh after this invocation — appears, once both sides\n// are trimmed and internal whitespace is collapsed, as a substring of text —\n// the agent's own response (the \"already the same ... skip it\" rule).\n// Substring rather than exact equality, since a real\n// response typically echoes the file's content plus its own surrounding\n// commentary (a leading summary, a trailing \"done!\", etc.).\n//\n// An empty fileContent (the target file doesn't exist yet, or is itself\n// empty) never counts as a duplicate — trivially \"contained\" in anything,\n// but not a meaningful match.\nfunc isDuplicateOutput(text, fileContent string) bool {\n\tnormFile := normalizeWhitespace(fileContent)\n\tif normFile == \"\" {\n\t\treturn false\n\t}\n\treturn strings.Contains(normalizeWhitespace(text), normFile)\n}\n\n// normalizeWhitespace collapses s to single-space-separated fields, so\n// isDuplicateOutput's comparison isn't tripped up by incidental reformatting\n// (extra blank lines, trailing spaces, etc.) between what's on disk and what\n// an agent echoed back.\nfunc normalizeWhitespace(s string) string {\n\treturn strings.Join(strings.Fields(s), \" \")\n}\n\n// logInvocation writes one agent invocation's captured output to w — Run's\n// fan-out target, which main() builds as an io.MultiWriter of\n// mg-jdi's own stdout and the sidecar's run.log, so both destinations get\n// the exact same section: a \"=== <timestamp> <agent> finished (attempt N)\n// ===\" header — paired with logAgentInvoked's own header just before this\n// invocation started so a reader sees an invoked/finished\n// pair per agent call rather than one ambiguous header. N is that agent's\n// invocation count within the run — per agent, not per run — so the first\n// call of every agent is attempt 1, and a bounced-back agent's second call\n// is attempt 2. Then the agent's extracted final-response text\n// (orchestrate.ResultText) — not the raw --output-format stream-json blob,\n// so a human reading either destination sees prose, not JSON.\n//\n// Two blank lines separate the \"finished\" header from the agent's output\n// (brief: jdi logs new line): without them the output reads as glued to the\n// finished statement — on a wrapped terminal, and in the TUI's log tab,\n// which renders run.log's raw content — as if it began on the same line.\n// The blank lines are written unconditionally, before whichever body variant\n// follows (real text, \"(no output)\", or the dedup \"(output matches ...,\n// omitted)\" note below), so the separation is the same in every case.\n//\n// Honesty note (carried into scripts/entrypoint.sh's own comment): this is\n// exactly the agent's *final response text* per invocation — the prose\n// ResultText extracts from whatever --print shape produced it — not a\n// blow-by-blow of every tool call/file edit. The blow-by-blow itself is not\n// lost anymore: the raw captured output (the full step-level event stream\n// since --output-format stream-json) is persisted verbatim to the job's\n// session.log by appendSessionLog — run.log is the summary, session.log is\n// the truth.\n//\n// targetFile/targetContent are the just-run agent's expected job\n// file and its content read fresh after the invocation (see\n// orchestrate.AgentTargetFile) — the caller's responsibility, since it\n// already has j.Dir\n// on hand. When the response text turns out to be a duplicate of that file\n// (isDuplicateOutput), the body is replaced with a short note instead of the\n// full (possibly large) text — the header is unaffected, so a reader still\n// sees an invoked/finished pair either way. targetFile == \"\" (e.g. an\n// unrecognized agent, or the file couldn't be read) simply skips the check.\nfunc logInvocation(w io.Writer, agent string, attempt int, raw []byte, targetFile, targetContent string) {\n\t// \"\\n\\n\\n\" = the header's own trailing newline plus two blank lines, so\n\t// the agent's output starts two lines below the \"finished\" statement\n\t// (brief: jdi logs new line).\n\tfmt.Fprintf(w, \"=== %s %s finished (attempt %d) ===\\n\\n\\n\", time.Now().Format(time.RFC3339), agent, attempt)\n\ttext := orchestrate.ResultText(raw)\n\tswitch {\n\tcase text == \"\":\n\t\ttext = \"(no output)\"\n\tcase targetFile != \"\" && isDuplicateOutput(text, targetContent):\n\t\ttext = fmt.Sprintf(\"(output matches %s, omitted)\", targetFile)\n\t}\n\tif text[len(text)-1] != '\\n' {\n\t\ttext += \"\\n\"\n\t}\n\tfmt.Fprint(w, text)\n}\n\n// appendSessionLog persists one agent invocation's raw captured output to the\n// job's own session.log (docs/jobs/<id>_<slug>/session.log — the caller\n// passes the full path, which it derives from j.Dir) — the persistent\n// blow-by-blow of every non-interactive invocation in an mg-jdi run,\n// complementing run.log's per-invocation summary. It is called from Run's\n// loop for EVERY invocation, failed ones included, right after logInvocation.\n//\n// Each call opens the file per-section (O_CREATE|O_APPEND|O_WRONLY — a fresh\n// mg-jdi run continues the same job's session rather than truncating it) and\n// writes a \"=== <timestamp> <agent> (attempt N) ===\" header — the same\n// sectioned shape run.log uses — followed by the invocation's raw bytes\n// verbatim. A blank line separates each section from the previous one (never\n// a leading blank on a fresh file), and a trailing newline is guaranteed so\n// the next section's header never glues to raw output.\nfunc appendSessionLog(path, agent string, attempt int, raw []byte) error {\n\tf, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer f.Close()\n\n\t// Blank-line separator between sections — the very first section ever\n\t// written to a fresh file starts at the top instead.\n\tif st, err := f.Stat(); err != nil {\n\t\treturn err\n\t} else if st.Size() > 0 {\n\t\tif _, err := io.WriteString(f, \"\\n\"); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\n\tif _, err := fmt.Fprintf(f, \"=== %s %s (attempt %d) ===\\n\", time.Now().Format(time.RFC3339), agent, attempt); err != nil {\n\t\treturn err\n\t}\n\n\t// Trailing-newline guarantee; the raw bytes are otherwise untouched.\n\tif len(raw) > 0 && raw[len(raw)-1] != '\\n' {\n\t\traw = append(raw, '\\n')\n\t}\n\t_, err = f.Write(raw)\n\treturn err\n}\n\n// logImmediateStop writes an \"immediate stop\" note to w — orchestrate.Next\n// returning a Stop* decision before any agent has ever been invoked (e.g.\n// job.StageDefine with an unwritten brief.md), the one case logInvocation\n// never runs for. Without this, run.log would be left at 0 bytes for that\n// stop, itself confusing\n// independent of whether the stop was the correct call. Mirrors\n// logInvocation's \"=== ... ===\" header shape so both look consistent in the\n// same log, but names the stop instead of an agent/attempt.\nfunc logImmediateStop(w io.Writer, reason string) {\n\tfmt.Fprintf(w, \"=== %s mg jdi stopped before running any agent ===\\n\", time.Now().Format(time.RFC3339))\n\tfmt.Fprintln(w, reason)\n}","lineStart":1,"lineEnd":339,"totalLines":339,"truncated":false}},"title":"src/cmd/mg/jdioutput.go","time":{"start":1787919607473,"end":1787919607477}},"id":"prt_0485026360015MSF291Y4coHfy","sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","messageID":"msg_04850206c001TA8151iLkxcLkN"}}
