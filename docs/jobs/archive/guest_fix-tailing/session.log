{"type":"tool_use","timestamp":1787920097074,"sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","part":{"type":"tool","tool":"read","callID":"call_41e12d18a3024956be196f6e","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/ui/tail_test.go"},"output":"<path>/workspace/src/internal/ui/tail_test.go</path>\n<type>file</type>\n<content>\n1: package ui\n2: \n3: import (\n4: \t\"os\"\n5: \t\"strings\"\n6: \t\"testing\"\n7: \n8: \t\"github.com/lmuskalla/manigot/internal/job\"\n9: )\n10: \n11: // --- footer hint (TASK-4) ----------------------------------------------------\n12: \n13: // TestDetailFooterTailHintShownWhenRunLogExists: the \"· l tail\" hint renders\n14: // only when a run.log exists for this job — the file-exists gate from the\n15: // analysis, mirroring the conditional \"e edit\" and \"t tig\" hints.\n16: func TestDetailFooterTailHintShownWhenRunLogExists(t *testing.T) {\n17: \troot := t.TempDir()\n18: \tj := discoverOneJob(t, root, \"aaaa08_t\")\n19: \n20: \t// No run.log yet: no hint.\n21: \td := newDetailView(j, 80, 24)\n22: \tif strings.Contains(d.renderFooter(), \"l tail\") {\n23: \t\tt.Errorf(\"footer shows the tail hint with no run.log:\\n%s\", d.renderFooter())\n24: \t}\n25: \n26: \t// A run.log appears (mg jdi drove the job): the hint shows.\n27: \tif err := os.MkdirAll(job.JDIStatusDir(root, j.Name), 0o755); err != nil {\n28: \t\tt.Fatal(err)\n29: \t}\n30: \tif err := os.WriteFile(job.JDIRunLogPath(root, j.Name), []byte(\"=== mg jdi started ===\\n\"), 0o644); err != nil {\n31: \t\tt.Fatal(err)\n32: \t}\n33: \td2 := newDetailView(j, 80, 24)\n34: \tif !strings.Contains(d2.renderFooter(), \"l tail\") {\n35: \t\tt.Errorf(\"footer missing the tail hint when a run.log exists:\\n%s\", d2.renderFooter())\n36: \t}\n37: }\n38: \n39: // --- \"l\" key gate ------------------------------------------------------------\n40: \n41: // TestTailKeyReportsNoRunLogAndLaunchesNothing: with no run.log, \"l\" must\n42: // report the gate and never reach the launch path at all — the tmux stub call\n43: // log stays completely empty (not even list-panes, which the launch path's\n44: // replace policy runs first), mirroring TestTigKeyReportsNotInstalledAndLaunchesNothing's\n45: // assertion that a gated-off launch never spawns anything.\n46: func TestTailKeyReportsNoRunLogAndLaunchesNothing(t *testing.T) {\n47: \troot := t.TempDir()\n48: \tj := discoverOneJob(t, root, \"aaaa09_g\")\n49: \n50: \tlogPath := writeTmuxStub(t)\n51: \n52: \ta := NewApp(root, []job.Job{j})\n53: \ta.width, a.height = 80, 24\n54: \ta.detail = newDetailView(j, 80, 24)\n55: \ta.state = stateDetail\n56: \n57: \ta.updateDetail(keyMsg(\"l\"))\n58: \tif !strings.Contains(a.detail.status, \"no mg jdi run has happened for this job yet\") {\n59: \t\tt.Errorf(\"status = %q, want it to explain no run.log exists yet\", a.detail.status)\n60: \t}\n61: \t// The stub's call log only exists once the stub has been invoked at all —\n62: \t// a never-reached launch path leaves no file behind, which is exactly the\n63: \t// empty log this assertion means.\n64: \tcalls, err := os.ReadFile(logPath)\n65: \tif err != nil && !os.IsNotExist(err) {\n66: \t\tt.Fatalf(\"tmux stub call log not readable: %v\", err)\n67: \t}\n68: \tif len(calls) != 0 {\n69: \t\tt.Errorf(\"launch path reached despite the gate — tmux stub was invoked:\\n%s\", calls)\n70: \t}\n71: }\n72: \n73: // --- \"l\" success path (tails run.log in a tmux pane) -------------------------\n74: \n75: // TestTailKeyLaunchesTailInTmuxPane exercises the full \"l\" flow with a real\n76: // run.log sidecar and a stubbed tmux on PATH + $TMUX: the split-window\n77: // invocation must carry the `tail -f '<path>'` inner command (routed through\n78: // launch.Tail → launchDetached's tmux path, exactly like tig/agent launches),\n79: // the pane must be tagged, and the status reports where it opened.\n80: func TestTailKeyLaunchesTailInTmuxPane(t *testing.T) {\n81: \troot := t.TempDir()\n82: \tj := discoverOneJob(t, root, \"aaaa10_t\")\n83: \n84: \tif err := os.MkdirAll(job.JDIStatusDir(root, j.Name), 0o755); err != nil {\n85: \t\tt.Fatal(err)\n86: \t}\n87: \trunLog := job.JDIRunLogPath(root, j.Name)\n88: \tif err := os.WriteFile(runLog, []byte(\"=== mg jdi started ===\\n\"), 0o644); err != nil {\n89: \t\tt.Fatal(err)\n90: \t}\n91: \n92: \tlogPath := writeTmuxStub(t)\n93: \n94: \ta := NewApp(root, []job.Job{j})\n95: \ta.width, a.height = 80, 24\n96: \ta.detail = newDetailView(j, 80, 24)\n97: \ta.state = stateDetail\n98: \n99: \ta.updateDetail(keyMsg(\"l\"))\n100: \tif !strings.Contains(a.detail.status, \"→ tailing run.log in tmux pane\") {\n101: \t\tt.Errorf(\"status = %q, want it to report the tail launch in a tmux pane\", a.detail.status)\n102: \t}\n103: \tcalls, err := os.ReadFile(logPath)\n104: \tif err != nil {\n105: \t\tt.Fatalf(\"tmux stub call log not written: %v\", err)\n106: \t}\n107: \tif !strings.Contains(string(calls), \"tail -f '\"+runLog+\"'\") {\n108: \t\tt.Errorf(\"tmux split-window not invoked with the tail inner command:\\n%s\", calls)\n109: \t}\n110: \tif !strings.Contains(string(calls), \"select-pane -t %100 -T manigot\") {\n111: \t\tt.Errorf(\"select-pane tagging of the new pane missing:\\n%s\", calls)\n112: \t}\n113: }\n\n(End of file - total 113 lines)\n</content>","metadata":{"preview":"package ui\n\nimport (\n\t\"os\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// --- footer hint (TASK-4) ----------------------------------------------------\n\n// TestDetailFooterTailHintShownWhenRunLogExists: the \"· l tail\" hint renders\n// only when a run.log exists for this job — the file-exists gate from the\n// analysis, mirroring the conditional \"e edit\" and \"t tig\" hints.\nfunc TestDetailFooterTailHintShownWhenRunLogExists(t *testing.T) {\n\troot := t.TempDir()\n\tj := discoverOneJob(t, root, \"aaaa08_t\")\n\n\t// No run.log yet: no hint.","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/ui/tail_test.go","text":"package ui\n\nimport (\n\t\"os\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// --- footer hint (TASK-4) ----------------------------------------------------\n\n// TestDetailFooterTailHintShownWhenRunLogExists: the \"· l tail\" hint renders\n// only when a run.log exists for this job — the file-exists gate from the\n// analysis, mirroring the conditional \"e edit\" and \"t tig\" hints.\nfunc TestDetailFooterTailHintShownWhenRunLogExists(t *testing.T) {\n\troot := t.TempDir()\n\tj := discoverOneJob(t, root, \"aaaa08_t\")\n\n\t// No run.log yet: no hint.\n\td := newDetailView(j, 80, 24)\n\tif strings.Contains(d.renderFooter(), \"l tail\") {\n\t\tt.Errorf(\"footer shows the tail hint with no run.log:\\n%s\", d.renderFooter())\n\t}\n\n\t// A run.log appears (mg jdi drove the job): the hint shows.\n\tif err := os.MkdirAll(job.JDIStatusDir(root, j.Name), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(job.JDIRunLogPath(root, j.Name), []byte(\"=== mg jdi started ===\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\td2 := newDetailView(j, 80, 24)\n\tif !strings.Contains(d2.renderFooter(), \"l tail\") {\n\t\tt.Errorf(\"footer missing the tail hint when a run.log exists:\\n%s\", d2.renderFooter())\n\t}\n}\n\n// --- \"l\" key gate ------------------------------------------------------------\n\n// TestTailKeyReportsNoRunLogAndLaunchesNothing: with no run.log, \"l\" must\n// report the gate and never reach the launch path at all — the tmux stub call\n// log stays completely empty (not even list-panes, which the launch path's\n// replace policy runs first), mirroring TestTigKeyReportsNotInstalledAndLaunchesNothing's\n// assertion that a gated-off launch never spawns anything.\nfunc TestTailKeyReportsNoRunLogAndLaunchesNothing(t *testing.T) {\n\troot := t.TempDir()\n\tj := discoverOneJob(t, root, \"aaaa09_g\")\n\n\tlogPath := writeTmuxStub(t)\n\n\ta := NewApp(root, []job.Job{j})\n\ta.width, a.height = 80, 24\n\ta.detail = newDetailView(j, 80, 24)\n\ta.state = stateDetail\n\n\ta.updateDetail(keyMsg(\"l\"))\n\tif !strings.Contains(a.detail.status, \"no mg jdi run has happened for this job yet\") {\n\t\tt.Errorf(\"status = %q, want it to explain no run.log exists yet\", a.detail.status)\n\t}\n\t// The stub's call log only exists once the stub has been invoked at all —\n\t// a never-reached launch path leaves no file behind, which is exactly the\n\t// empty log this assertion means.\n\tcalls, err := os.ReadFile(logPath)\n\tif err != nil && !os.IsNotExist(err) {\n\t\tt.Fatalf(\"tmux stub call log not readable: %v\", err)\n\t}\n\tif len(calls) != 0 {\n\t\tt.Errorf(\"launch path reached despite the gate — tmux stub was invoked:\\n%s\", calls)\n\t}\n}\n\n// --- \"l\" success path (tails run.log in a tmux pane) -------------------------\n\n// TestTailKeyLaunchesTailInTmuxPane exercises the full \"l\" flow with a real\n// run.log sidecar and a stubbed tmux on PATH + $TMUX: the split-window\n// invocation must carry the `tail -f '<path>'` inner command (routed through\n// launch.Tail → launchDetached's tmux path, exactly like tig/agent launches),\n// the pane must be tagged, and the status reports where it opened.\nfunc TestTailKeyLaunchesTailInTmuxPane(t *testing.T) {\n\troot := t.TempDir()\n\tj := discoverOneJob(t, root, \"aaaa10_t\")\n\n\tif err := os.MkdirAll(job.JDIStatusDir(root, j.Name), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunLog := job.JDIRunLogPath(root, j.Name)\n\tif err := os.WriteFile(runLog, []byte(\"=== mg jdi started ===\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tlogPath := writeTmuxStub(t)\n\n\ta := NewApp(root, []job.Job{j})\n\ta.width, a.height = 80, 24\n\ta.detail = newDetailView(j, 80, 24)\n\ta.state = stateDetail\n\n\ta.updateDetail(keyMsg(\"l\"))\n\tif !strings.Contains(a.detail.status, \"→ tailing run.log in tmux pane\") {\n\t\tt.Errorf(\"status = %q, want it to report the tail launch in a tmux pane\", a.detail.status)\n\t}\n\tcalls, err := os.ReadFile(logPath)\n\tif err != nil {\n\t\tt.Fatalf(\"tmux stub call log not written: %v\", err)\n\t}\n\tif !strings.Contains(string(calls), \"tail -f '\"+runLog+\"'\") {\n\t\tt.Errorf(\"tmux split-window not invoked with the tail inner command:\\n%s\", calls)\n\t}\n\tif !strings.Contains(string(calls), \"select-pane -t %100 -T manigot\") {\n\t\tt.Errorf(\"select-pane tagging of the new pane missing:\\n%s\", calls)\n\t}\n}","lineStart":1,"lineEnd":113,"totalLines":113,"truncated":false}},"title":"src/internal/ui/tail_test.go","time":{"start":1787920097068,"end":1787920097073}},"id":"prt_048579e6d001Y3HTicvuSRr7hM","sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","messageID":"msg_0485768c1001aaK0D3uh3JszpI"}}
{"type":"tool_use","timestamp":1787920097403,"sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","part":{"type":"tool","tool":"read","callID":"call_90e159e2e7b54c36b071c82a","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/launch/launch.go","offset":190,"limit":100},"output":"<path>/workspace/src/internal/launch/launch.go</path>\n<type>file</type>\n<content>\n190: // The job is passed by its Name (id_slug), not its ID: `mg diff` resolves the\n191: // job's branch via an exact match on the branch's id_slug tail segment first,\n192: // then a unique prefix (cmd/mg/diff.go resolveJobBranch) — and job.Name\n193: // equals that tail segment exactly, so resolution is unambiguous.\n194: //\n195: // Tig re-checks availability itself (TigAvailable) before spawning: the\n196: // TUI's cached availability gate (detailView.tigAvailable) is only as fresh\n197: // as the last job open, so a stale cached \"available\" must surface a\n198: // synchronous error here rather than opening a doomed pane that dies on the\n199: // CLI's own tig-missing check.\n200: func Tig(jobID, projectRoot, terminal string) (string, error) {\n201: \tif !TigAvailable() {\n202: \t\treturn \"\", errors.New(\"tig is not installed on the host — install it, or use the diff tab\")\n203: \t}\n204: \texe, err := ExeOverride()\n205: \tif err != nil {\n206: \t\treturn \"\", fmt.Errorf(\"locate mg binary: %w\", err)\n207: \t}\n208: \tinner := tigShellCommand(exe, jobID, projectRoot)\n209: \treturn launchDetached(inner, terminal)\n210: }\n211: \n212: // Tail opens a new terminal — inside tmux, a split pane in the TUI's current\n213: // window, exactly like Agent/Quick/Tig, including the replace policy — that\n214: // runs `tail -f '<logPath>'`: a live tail of the given absolute log file (the\n215: // mg-jdi run.log sidecar, job.JDIRunLogPath) so a user can watch the currently\n216: // running agent's output grow from inside the TUI. terminal is\n217: // config.Settings.Terminal, threaded through to launchDetached exactly like\n218: // the other launch paths' own terminal parameter — see Agent's doc for the\n219: // override semantics. It returns the same short human description of where it\n220: // opened so the caller can surface it in a status line.\n221: //\n222: // Unlike Agent/Quick/Tig there is no mg-binary hop at all: `tail -f` is a\n223: // plain host command, so there is no ExeOverride resolution and no profile\n224: // flag. The inner command is deliberately NOT wrapped in holdOnFailure (the\n225: // one launch path that deviates): a user ends a tail pane with Ctrl+C (exit\n226: // 130, non-zero), so holding on a non-zero exit would leave a \"press enter to\n227: // close\" prompt every single time — the pane should just close when the user\n228: // is done watching.\n229: //\n230: // tail -f idles harmlessly once the underlying run ends (the file simply\n231: // stops growing), so there is no liveness check here; the caller decides when\n232: // the key and footer hint are reachable (e.g. gated on the log file existing).\n233: func Tail(logPath, terminal string) (string, error) {\n234: \tinner := tailShellCommand(logPath)\n235: \treturn launchDetached(inner, terminal)\n236: }\n237: \n238: // ExeOverride returns the path of the binary implementing the mg session\n239: // subcommand — the running binary itself. An exported package-level variable\n240: // so tests (in this package and internal/ui) can point Agent/Quick/AgentQuick\n241: // at a stub or a resolution failure instead of the real os.Executable().\n242: var ExeOverride = func() (string, error) { return os.Executable() }\n243: \n244: // TerminalSetting returns the user's configured terminal override — the\n245: // `terminal` field of config/tui-settings.json — or \"\" when unset or\n246: // unreadable. It is the default every terminal-launch path falls back to when\n247: // the caller passes an empty terminal (see launchDetached), so the setting is\n248: // honored from the TUI — which passes it explicitly — and from CLI paths like\n249: // `mg done`'s git-solver handoff alike, instead of silently degrading to\n250: // auto-detect. An exported package-level variable, mirroring ExeOverride, so\n251: // tests can stub it.\n252: var TerminalSetting = func() string {\n253: \ts, err := config.Load()\n254: \tif err != nil {\n255: \t\treturn \"\"\n256: \t}\n257: \treturn s.Terminal\n258: }\n259: \n260: // JdiExe returns the path of the binary implementing the `mg jdi` subcommand —\n261: // the running binary itself. An exported package-level variable, mirroring\n262: // ExeOverride, so tests (in this package and internal/ui) can point it at a\n263: // stub or a resolution failure.\n264: var JdiExe = func() (string, error) { return os.Executable() }\n265: \n266: // TigLookPath resolves the tig binary on the host, mirroring `mg diff --tig`'s\n267: // own check (cmd/mg/diff.go's tigLookPath). An exported package-level\n268: // variable, mirroring ExeOverride/JdiExe, so tests (in this package and\n269: // internal/ui) can point it at a stub or a tig-less PATH instead of requiring\n270: // tig on the test machine.\n271: var TigLookPath = exec.LookPath\n272: \n273: // TigAvailable reports whether tig resolves on the host — the \"if available\"\n274: // gate the TUI's `t` key and footer hint key off (see Tig's own doc for why\n275: // the launch path re-checks this itself). It is deliberately a lightweight\n276: // LookPath probe with no version check or config scan: `mg diff --tig` is the\n277: // authoritative backstop and errors clearly on its own when tig is missing.\n278: func TigAvailable() bool {\n279: \t_, err := TigLookPath(\"tig\")\n280: \treturn err == nil\n281: }\n282: \n283: // Jdi starts `mg jdi --job <jobID> --profile <profile>` detached in the\n284: // background — no spawned terminal window at all, unlike Agent/Quick.\n285: // mg-jdi drives a fixed,\n286: // non-interactive agent sequence with no TTY at any point in its own\n287: // container invocations (the session launcher's --print flag) and needs no\n288: // terminal for a human or a subprocess to attach to — spawning one anyway\n289: // would be pure overhead and would reintroduce exactly the per-agent-window\n\n(Showing lines 190-289 of 820. Use offset=290 to continue.)\n</content>","metadata":{"preview":"// The job is passed by its Name (id_slug), not its ID: `mg diff` resolves the\n// job's branch via an exact match on the branch's id_slug tail segment first,\n// then a unique prefix (cmd/mg/diff.go resolveJobBranch) — and job.Name\n// equals that tail segment exactly, so resolution is unambiguous.\n//\n// Tig re-checks availability itself (TigAvailable) before spawning: the\n// TUI's cached availability gate (detailView.tigAvailable) is only as fresh\n// as the last job open, so a stale cached \"available\" must surface a\n// synchronous error here rather than opening a doomed pane that dies on the\n// CLI's own tig-missing check.\nfunc Tig(jobID, projectRoot, terminal string) (string, error) {\n\tif !TigAvailable() {\n\t\treturn \"\", errors.New(\"tig is not installed on the host — install it, or use the diff tab\")\n\t}\n\texe, err := ExeOverride()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"locate mg binary: %w\", err)\n\t}\n\tinner := tigShellCommand(exe, jobID, projectRoot)\n\treturn launchDetached(inner, terminal)","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/launch/launch.go","text":"// The job is passed by its Name (id_slug), not its ID: `mg diff` resolves the\n// job's branch via an exact match on the branch's id_slug tail segment first,\n// then a unique prefix (cmd/mg/diff.go resolveJobBranch) — and job.Name\n// equals that tail segment exactly, so resolution is unambiguous.\n//\n// Tig re-checks availability itself (TigAvailable) before spawning: the\n// TUI's cached availability gate (detailView.tigAvailable) is only as fresh\n// as the last job open, so a stale cached \"available\" must surface a\n// synchronous error here rather than opening a doomed pane that dies on the\n// CLI's own tig-missing check.\nfunc Tig(jobID, projectRoot, terminal string) (string, error) {\n\tif !TigAvailable() {\n\t\treturn \"\", errors.New(\"tig is not installed on the host — install it, or use the diff tab\")\n\t}\n\texe, err := ExeOverride()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"locate mg binary: %w\", err)\n\t}\n\tinner := tigShellCommand(exe, jobID, projectRoot)\n\treturn launchDetached(inner, terminal)\n}\n\n// Tail opens a new terminal — inside tmux, a split pane in the TUI's current\n// window, exactly like Agent/Quick/Tig, including the replace policy — that\n// runs `tail -f '<logPath>'`: a live tail of the given absolute log file (the\n// mg-jdi run.log sidecar, job.JDIRunLogPath) so a user can watch the currently\n// running agent's output grow from inside the TUI. terminal is\n// config.Settings.Terminal, threaded through to launchDetached exactly like\n// the other launch paths' own terminal parameter — see Agent's doc for the\n// override semantics. It returns the same short human description of where it\n// opened so the caller can surface it in a status line.\n//\n// Unlike Agent/Quick/Tig there is no mg-binary hop at all: `tail -f` is a\n// plain host command, so there is no ExeOverride resolution and no profile\n// flag. The inner command is deliberately NOT wrapped in holdOnFailure (the\n// one launch path that deviates): a user ends a tail pane with Ctrl+C (exit\n// 130, non-zero), so holding on a non-zero exit would leave a \"press enter to\n// close\" prompt every single time — the pane should just close when the user\n// is done watching.\n//\n// tail -f idles harmlessly once the underlying run ends (the file simply\n// stops growing), so there is no liveness check here; the caller decides when\n// the key and footer hint are reachable (e.g. gated on the log file existing).\nfunc Tail(logPath, terminal string) (string, error) {\n\tinner := tailShellCommand(logPath)\n\treturn launchDetached(inner, terminal)\n}\n\n// ExeOverride returns the path of the binary implementing the mg session\n// subcommand — the running binary itself. An exported package-level variable\n// so tests (in this package and internal/ui) can point Agent/Quick/AgentQuick\n// at a stub or a resolution failure instead of the real os.Executable().\nvar ExeOverride = func() (string, error) { return os.Executable() }\n\n// TerminalSetting returns the user's configured terminal override — the\n// `terminal` field of config/tui-settings.json — or \"\" when unset or\n// unreadable. It is the default every terminal-launch path falls back to when\n// the caller passes an empty terminal (see launchDetached), so the setting is\n// honored from the TUI — which passes it explicitly — and from CLI paths like\n// `mg done`'s git-solver handoff alike, instead of silently degrading to\n// auto-detect. An exported package-level variable, mirroring ExeOverride, so\n// tests can stub it.\nvar TerminalSetting = func() string {\n\ts, err := config.Load()\n\tif err != nil {\n\t\treturn \"\"\n\t}\n\treturn s.Terminal\n}\n\n// JdiExe returns the path of the binary implementing the `mg jdi` subcommand —\n// the running binary itself. An exported package-level variable, mirroring\n// ExeOverride, so tests (in this package and internal/ui) can point it at a\n// stub or a resolution failure.\nvar JdiExe = func() (string, error) { return os.Executable() }\n\n// TigLookPath resolves the tig binary on the host, mirroring `mg diff --tig`'s\n// own check (cmd/mg/diff.go's tigLookPath). An exported package-level\n// variable, mirroring ExeOverride/JdiExe, so tests (in this package and\n// internal/ui) can point it at a stub or a tig-less PATH instead of requiring\n// tig on the test machine.\nvar TigLookPath = exec.LookPath\n\n// TigAvailable reports whether tig resolves on the host — the \"if available\"\n// gate the TUI's `t` key and footer hint key off (see Tig's own doc for why\n// the launch path re-checks this itself). It is deliberately a lightweight\n// LookPath probe with no version check or config scan: `mg diff --tig` is the\n// authoritative backstop and errors clearly on its own when tig is missing.\nfunc TigAvailable() bool {\n\t_, err := TigLookPath(\"tig\")\n\treturn err == nil\n}\n\n// Jdi starts `mg jdi --job <jobID> --profile <profile>` detached in the\n// background — no spawned terminal window at all, unlike Agent/Quick.\n// mg-jdi drives a fixed,\n// non-interactive agent sequence with no TTY at any point in its own\n// container invocations (the session launcher's --print flag) and needs no\n// terminal for a human or a subprocess to attach to — spawning one anyway\n// would be pure overhead and would reintroduce exactly the per-agent-window","lineStart":190,"lineEnd":289,"totalLines":820,"truncated":true}},"title":"src/internal/launch/launch.go","time":{"start":1787920097398,"end":1787920097402}},"id":"prt_048579f2e001e1rPOtQaFFwmeI","sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","messageID":"msg_0485768c1001aaK0D3uh3JszpI"}}
