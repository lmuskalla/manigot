{"type":"tool_use","timestamp":1787920128419,"sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","part":{"type":"tool","tool":"read","callID":"call_f9ced84f824b4e9dbf62d676","state":{"status":"completed","input":{"filePath":"/workspace/src/cmd/mg/session_test.go"},"output":"<path>/workspace/src/cmd/mg/session_test.go</path>\n<type>file</type>\n<content>\n1: package main\n2: \n3: import (\n4: \t\"errors\"\n5: \t\"io\"\n6: \t\"os\"\n7: \t\"os/exec\"\n8: \t\"path/filepath\"\n9: \t\"strings\"\n10: \t\"testing\"\n11: \n12: \t\"github.com/lmuskalla/manigot/internal/session\"\n13: )\n14: \n15: // pathWithRealGitOnly returns a PATH value containing git but nothing else,\n16: // so the docker launch inside the session flow fails deterministically —\n17: // never starting a real container on a machine that has docker, and failing\n18: // with the same clear error on one that doesn't. The real git (not the\n19: // manigot git shim, which may sit on PATH and refuses some session-flow git\n20: // calls) is resolved explicitly.\n21: func pathWithRealGitOnly(t *testing.T) string {\n22: \tt.Helper()\n23: \tbinDir := t.TempDir()\n24: \trealGit := \"/usr/bin/git\"\n25: \tif _, err := os.Stat(realGit); err != nil {\n26: \t\tvar lerr error\n27: \t\trealGit, lerr = exec.LookPath(\"git\")\n28: \t\tif lerr != nil {\n29: \t\t\tt.Fatalf(\"could not locate a real git: %v\", lerr)\n30: \t\t}\n31: \t}\n32: \tif err := os.Symlink(realGit, filepath.Join(binDir, \"git\")); err != nil {\n33: \t\tt.Fatal(err)\n34: \t}\n35: \treturn binDir\n36: }\n37: \n38: // fakeDockerOnPath returns a PATH value with real git plus a fake `docker`\n39: // executable that runs body (default \"exit 0\") — so the session flow's\n40: // docker invocation \"runs\" without a real container, letting the post-run\n41: // sweep logic be exercised end to end (the launch-path prune also shells out\n42: // to docker; an exit-0 docker with no output makes it a quiet success).\n43: func fakeDockerOnPath(t *testing.T, body string) string {\n44: \tt.Helper()\n45: \tbinDir := pathWithRealGitOnly(t)\n46: \tif body == \"\" {\n47: \t\tbody = \"exit 0\"\n48: \t}\n49: \tscript := \"#!/bin/sh\\n\" + body + \"\\n\"\n50: \tif err := os.WriteFile(filepath.Join(binDir, \"docker\"), []byte(script), 0o755); err != nil {\n51: \t\tt.Fatal(err)\n52: \t}\n53: \treturn binDir\n54: }\n55: \n56: // sweepTestJob builds a real worktree job (the mg job flow) and returns the\n57: // project root, the job name, and the job worktree path — the scaffolding the\n58: // sweep-wiring tests share. Callers set PATH first (fakeDockerOnPath or\n59: // pathWithRealGitOnly) and chdir into the returned root.\n60: func sweepTestJob(t *testing.T) (dir, jobName, wt string) {\n61: \tt.Helper()\n62: \tdir = mgCheckout(t)\n63: \tt.Chdir(dir)\n64: \tvar out strings.Builder\n65: \tif code := runJob([]string{\"Sweep Job\"}, &out, &strings.Builder{}); code != 0 {\n66: \t\tt.Fatalf(\"runJob: %d %s\", code, out.String())\n67: \t}\n68: \tbranch := mgJobBranch(t, dir)\n69: \tjobName = strings.TrimPrefix(branch, \"feature/\")\n70: \twt = mgWorktreePath(t, dir, branch)\n71: \treturn dir, jobName, wt\n72: }\n73: \n74: // TestRunSessionPruneCalledBeforeRun pins the launch-path wiring: runSession\n75: // calls pruneOrphans (stubbed — docker is not on the test PATH) before the\n76: // docker run, and a successful prune is quiet. The run then proceeds to the\n77: // docker launch, which fails on the git-only PATH — proving the prune\n78: // happened before the run and did not replace it.\n79: func TestRunSessionPruneCalledBeforeRun(t *testing.T) {\n80: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n81: \tdir := mgCheckout(t)\n82: \tt.Chdir(dir)\n83: \tprofileCheckout(t, \"CLAUDE_CODE_OAUTH_TOKEN=t\\nCLAUDE_ACCOUNT_UUID=u\\nCLAUDE_EMAIL=e\\nCLAUDE_ORG_UUID=o\\n\")\n84: \n85: \tvar pruneCalls int\n86: \told := pruneOrphans\n87: \tpruneOrphans = func(diag io.Writer) (session.PruneResult, error) {\n88: \t\tpruneCalls++\n89: \t\treturn session.PruneResult{Removed: 1, Running: 0}, nil\n90: \t}\n91: \tt.Cleanup(func() { pruneOrphans = old })\n92: \n93: \tvar out, errOut strings.Builder\n94: \tif code := runSession(nil, os.Stdin, &out, &errOut); code != 1 {\n95: \t\tt.Errorf(\"exit code = %d, want 1 (the docker launch fails on the git-only PATH)\", code)\n96: \t}\n97: \tif pruneCalls != 1 {\n98: \t\tt.Errorf(\"pruneOrphans called %d times, want 1\", pruneCalls)\n99: \t}\n100: \tif !strings.Contains(errOut.String(), \"executable file not found\") {\n101: \t\tt.Errorf(\"the docker launch must have been attempted after the prune:\\n%s\", errOut.String())\n102: \t}\n103: \tif strings.Contains(errOut.String(), \"could not prune\") {\n104: \t\tt.Errorf(\"a successful prune must not warn:\\n%s\", errOut.String())\n105: \t}\n106: }\n107: \n108: // TestRunSessionPruneFailureIsFailSoft pins the fail-soft contract: a prune\n109: // failure only warns on stderr and never aborts the launch — the run proceeds\n110: // to the docker launch (which fails on the git-only PATH) despite the prune\n111: // error.\n112: func TestRunSessionPruneFailureIsFailSoft(t *testing.T) {\n113: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n114: \tdir := mgCheckout(t)\n115: \tt.Chdir(dir)\n116: \tprofileCheckout(t, \"CLAUDE_CODE_OAUTH_TOKEN=t\\nCLAUDE_ACCOUNT_UUID=u\\nCLAUDE_EMAIL=e\\nCLAUDE_ORG_UUID=o\\n\")\n117: \n118: \tvar pruneCalls int\n119: \told := pruneOrphans\n120: \tpruneOrphans = func(diag io.Writer) (session.PruneResult, error) {\n121: \t\tpruneCalls++\n122: \t\treturn session.PruneResult{}, errors.New(\"Cannot connect to the Docker daemon\")\n123: \t}\n124: \tt.Cleanup(func() { pruneOrphans = old })\n125: \n126: \tvar out, errOut strings.Builder\n127: \tif code := runSession(nil, os.Stdin, &out, &errOut); code != 1 {\n128: \t\tt.Errorf(\"exit code = %d, want 1 (the docker launch fails on the git-only PATH)\", code)\n129: \t}\n130: \tif pruneCalls != 1 {\n131: \t\tt.Errorf(\"pruneOrphans called %d times, want 1\", pruneCalls)\n132: \t}\n133: \tif !strings.Contains(errOut.String(), \"mg: warning: could not prune orphaned containers\") {\n134: \t\tt.Errorf(\"missing the prune warning:\\n%s\", errOut.String())\n135: \t}\n136: \tif !strings.Contains(errOut.String(), \"executable file not found\") {\n137: \t\tt.Errorf(\"the launch must proceed past a prune failure (docker attempted):\\n%s\", errOut.String())\n138: \t}\n139: }\n140: \n141: // TestRunSessionSweepsJobWorktree pins the job-worktree sweep wiring at the\n142: // session level: after a job-worktree session whose container \"ran\" (a fake\n143: // docker that exits 0), whatever the agent left uncommitted in the job\n144: // worktree is swept into a single [<id>] chore: commit all commit and the\n145: // worktree is left clean.\n146: func TestRunSessionSweepsJobWorktree(t *testing.T) {\n147: \tt.Setenv(\"PATH\", fakeDockerOnPath(t, \"\"))\n148: \tdir, jobName, wt := sweepTestJob(t)\n149: \tprofileCheckout(t, \"CLAUDE_CODE_OAUTH_TOKEN=t\\nCLAUDE_ACCOUNT_UUID=u\\nCLAUDE_EMAIL=e\\nCLAUDE_ORG_UUID=o\\n\")\n150: \n151: \t// The \"agent\" leaves a leftover in the job worktree (the analyst's\n152: \t// tasks.md shape — written, never committed).\n153: \tif err := os.WriteFile(filepath.Join(wt, \"docs\", \"jobs\", jobName, \"tasks.md\"), []byte(\"# Tasks\\n\\nTASK-1: do the thing\\n\"), 0o644); err != nil {\n154: \t\tt.Fatal(err)\n155: \t}\n156: \n157: \tvar out, errOut strings.Builder\n158: \tif code := runSession([]string{\"--job\", jobName}, os.Stdin, &out, &errOut); code != 0 {\n159: \t\tt.Fatalf(\"runSession exit code = %d, stderr:\\n%s\", code, errOut.String())\n160: \t}\n161: \tif want := \"[\" + strings.Split(jobName, \"_\")[0] + \"] chore: commit all\"; mgGit(t, wt, \"log\", \"-1\", \"--format=%s\") != want {\n162: \t\tt.Errorf(\"sweep commit subject = %q, want %q\", mgGit(t, wt, \"log\", \"-1\", \"--format=%s\"), want)\n163: \t}\n164: \tif status := mgGit(t, wt, \"status\", \"--porcelain\"); status != \"\" {\n165: \t\tt.Errorf(\"job worktree not clean after sweep:\\n%s\", status)\n166: \t}\n167: \t// The plain session at the project root must not be swept (no --job).\n168: \tif status := mgGit(t, dir, \"status\", \"--porcelain\"); status != \"\" {\n169: \t\tt.Errorf(\"project root must be untouched by a job-worktree sweep:\\n%s\", status)\n170: \t}\n171: }\n172: \n173: // TestRunSessionDoesNotSweepWhenDockerFailed pins the \"no sweep when no agent\n174: // ran\" contract at the session level: when the docker launch itself fails\n175: // (docker missing on the git-only PATH), the leftover in the job worktree is\n176: // left exactly as it was — an agent that never started must not trigger a\n177: // commit.\n178: func TestRunSessionDoesNotSweepWhenDockerFailed(t *testing.T) {\n179: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n180: \t_, jobName, wt := sweepTestJob(t)\n181: \tprofileCheckout(t, \"CLAUDE_CODE_OAUTH_TOKEN=t\\nCLAUDE_ACCOUNT_UUID=u\\nCLAUDE_EMAIL=e\\nCLAUDE_ORG_UUID=o\\n\")\n182: \n183: \tleftover := filepath.Join(wt, \"docs\", \"jobs\", jobName, \"tasks.md\")\n184: \tif err := os.WriteFile(leftover, []byte(\"# Tasks\\n\\nTASK-1: do the thing\\n\"), 0o644); err != nil {\n185: \t\tt.Fatal(err)\n186: \t}\n187: \n188: \tvar out, errOut strings.Builder\n189: \tif code := runSession([]string{\"--job\", jobName}, os.Stdin, &out, &errOut); code != 1 {\n190: \t\tt.Errorf(\"exit code = %d, want 1 (the docker launch fails on the git-only PATH)\", code)\n191: \t}\n192: \tif got := mgGit(t, wt, \"log\", \"-1\", \"--format=%s\"); strings.HasPrefix(got, \"[\") {\n193: \t\tt.Errorf(\"a sweep commit was made despite docker never running (head = %q)\", got)\n194: \t}\n195: \tif status := mgGit(t, wt, \"status\", \"--porcelain\"); !strings.Contains(status, \"tasks.md\") {\n196: \t\tt.Errorf(\"leftover must remain uncommitted after a failed launch, status:\\n%s\", status)\n197: \t}\n198: }\n199: \n200: // TestRunSessionDoesNotSweepFlatScanFallback pins the TASK-3 blocker fix at\n201: // the session level: the --job flat-scan fallback — a git repo with no local\n202: // branches (here: a fresh git init before its first commit), where the job's\n203: // files live directly in the main project root — must never be swept, even\n204: // when the container \"ran\" (a fake docker that exits 0). Sweeping there would\n205: // run git add -A over the user's own uncommitted work — .env included — and\n206: // create the repo's first commit. The repo keeps its unborn HEAD and the\n207: // leftovers stay untracked.\n208: func TestRunSessionDoesNotSweepFlatScanFallback(t *testing.T) {\n209: \tt.Setenv(\"PATH\", fakeDockerOnPath(t, \"\"))\n210: \tdir := t.TempDir()\n211: \tmgGit(t, dir, \"init\", \"-q\")\n212: \tmgGit(t, dir, \"config\", \"user.name\", \"Test\")\n213: \tmgGit(t, dir, \"config\", \"user.email\", \"test@x.io\")\n214: \tif err := os.MkdirAll(filepath.Join(dir, \"docs\", \"jobs\", \"ab12cd_flat-scan\"), 0o755); err != nil {\n215: \t\tt.Fatal(err)\n216: \t}\n217: \tprofileCheckout(t, \"CLAUDE_CODE_OAUTH_TOKEN=t\\nCLAUDE_ACCOUNT_UUID=u\\nCLAUDE_EMAIL=e\\nCLAUDE_ORG_UUID=o\\n\")\n218: \n219: \t// The user's own uncommitted work, .env included — the exact contents the\n220: \t// flat-scan fallback must never sweep into the repo's first commit.\n221: \tif err := os.WriteFile(filepath.Join(dir, \"work.txt\"), []byte(\"mine\\n\"), 0o644); err != nil {\n222: \t\tt.Fatal(err)\n223: \t}\n224: \tif err := os.WriteFile(filepath.Join(dir, \".env\"), []byte(\"SECRET=token\\n\"), 0o644); err != nil {\n225: \t\tt.Fatal(err)\n226: \t}\n227: \tt.Chdir(dir)\n228: \n229: \tvar out, errOut strings.Builder\n230: \tif code := runSession([]string{\"--job\", \"ab12cd_flat-scan\"}, os.Stdin, &out, &errOut); code != 0 {\n231: \t\tt.Fatalf(\"runSession exit code = %d, stderr:\\n%s\", code, errOut.String())\n232: \t}\n233: \tif err := exec.Command(\"git\", \"-C\", dir, \"rev-parse\", \"--verify\", \"HEAD\").Run(); err == nil {\n234: \t\tt.Error(\"flat-scan fallback must not create the repo's first commit\")\n235: \t}\n236: \tstatus := mgGit(t, dir, \"status\", \"--porcelain\")\n237: \tif !strings.Contains(status, \"work.txt\") || !strings.Contains(status, \".env\") {\n238: \t\tt.Errorf(\"leftovers must remain untracked after a flat-scan no-op, status:\\n%s\", status)\n239: \t}\n240: \tif strings.Contains(errOut.String(), \"chore: commit all\") {\n241: \t\tt.Errorf(\"no sweep note may appear for a flat-scan fallback:\\n%s\", errOut.String())\n242: \t}\n243: }\n244: \n245: // TestRunSessionDoesNotSweepPreWorktreeJob pins the second TASK-3 blocker\n246: // shape at the session level: a pre-worktree job — its branch checked out in\n247: // the main worktree itself, an explicitly supported transitional state (see\n248: // internal/job/discover.go:76-82) — resolves --job to the main project root\n249: // (git.WorktreeForBranch matches the main worktree's own porcelain entry), so\n250: // it must never be swept either, even though GitCommonDir resolves non-empty\n251: // there (the repo's own .git — unlike the flat-scan fallback, where\n252: // GitCommonDir stays \"\"). Sweeping would commit the user's own uncommitted\n253: // work — .env included — onto the job branch.\n254: func TestRunSessionDoesNotSweepPreWorktreeJob(t *testing.T) {\n255: \tt.Setenv(\"PATH\", fakeDockerOnPath(t, \"\"))\n256: \tdir := mgCheckout(t)\n257: \tt.Chdir(dir)\n258: \tmgGit(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/ab12cd_main-wt\")\n259: \tjobDir := filepath.Join(dir, \"docs\", \"jobs\", \"ab12cd_main-wt\")\n260: \tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n261: \t\tt.Fatal(err)\n262: \t}\n263: \tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(\"# Brief\\n\\nstatus: open\\nid: ab12cd\\n\"), 0o644); err != nil {\n264: \t\tt.Fatal(err)\n265: \t}\n266: \tmgGit(t, dir, \"add\", \"-A\")\n267: \tmgGit(t, dir, \"commit\", \"-q\", \"-m\", \"[ab12cd] scaffold\")\n268: \tprofileCheckout(t, \"CLAUDE_CODE_OAUTH_TOKEN=t\\nCLAUDE_ACCOUNT_UUID=u\\nCLAUDE_EMAIL=e\\nCLAUDE_ORG_UUID=o\\n\")\n269: \n270: \t// The user's own uncommitted work, .env included — must never be swept\n271: \t// onto the job branch.\n272: \tif err := os.WriteFile(filepath.Join(dir, \"work.txt\"), []byte(\"mine\\n\"), 0o644); err != nil {\n273: \t\tt.Fatal(err)\n274: \t}\n275: \tif err := os.WriteFile(filepath.Join(dir, \".env\"), []byte(\"SECRET=token\\n\"), 0o644); err != nil {\n276: \t\tt.Fatal(err)\n277: \t}\n278: \n279: \tvar out, errOut strings.Builder\n280: \tif code := runSession([]string{\"--job\", \"ab12cd_main-wt\"}, os.Stdin, &out, &errOut); code != 0 {\n281: \t\tt.Fatalf(\"runSession exit code = %d, stderr:\\n%s\", code, errOut.String())\n282: \t}\n283: \tif got := mgGit(t, dir, \"log\", \"-1\", \"--format=%s\"); got != \"[ab12cd] scaffold\" {\n284: \t\tt.Errorf(\"a sweep commit was made over the pre-worktree job's main worktree (head = %q)\", got)\n285: \t}\n286: \tstatus := mgGit(t, dir, \"status\", \"--porcelain\")\n287: \tif !strings.Contains(status, \"work.txt\") || !strings.Contains(status, \".env\") {\n288: \t\tt.Errorf(\"leftovers must remain untracked after a pre-worktree-job no-op, status:\\n%s\", status)\n289: \t}\n290: \tif strings.Contains(errOut.String(), \"chore: commit all\") {\n291: \t\tt.Errorf(\"no sweep note may appear for a pre-worktree job:\\n%s\", errOut.String())\n292: \t}\n293: }\n\n(End of file - total 293 lines)\n</content>","metadata":{"preview":"package main\n\nimport (\n\t\"errors\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/session\"\n)\n\n// pathWithRealGitOnly returns a PATH value containing git but nothing else,\n// so the docker launch inside the session flow fails deterministically —\n// never starting a real container on a machine that has docker, and failing\n// with the same clear error on one that doesn't. The real git (not the\n// manigot git shim, which may sit on PATH and refuses some session-flow git\n// calls) is resolved explicitly.","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/cmd/mg/session_test.go","text":"package main\n\nimport (\n\t\"errors\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/session\"\n)\n\n// pathWithRealGitOnly returns a PATH value containing git but nothing else,\n// so the docker launch inside the session flow fails deterministically —\n// never starting a real container on a machine that has docker, and failing\n// with the same clear error on one that doesn't. The real git (not the\n// manigot git shim, which may sit on PATH and refuses some session-flow git\n// calls) is resolved explicitly.\nfunc pathWithRealGitOnly(t *testing.T) string {\n\tt.Helper()\n\tbinDir := t.TempDir()\n\trealGit := \"/usr/bin/git\"\n\tif _, err := os.Stat(realGit); err != nil {\n\t\tvar lerr error\n\t\trealGit, lerr = exec.LookPath(\"git\")\n\t\tif lerr != nil {\n\t\t\tt.Fatalf(\"could not locate a real git: %v\", lerr)\n\t\t}\n\t}\n\tif err := os.Symlink(realGit, filepath.Join(binDir, \"git\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn binDir\n}\n\n// fakeDockerOnPath returns a PATH value with real git plus a fake `docker`\n// executable that runs body (default \"exit 0\") — so the session flow's\n// docker invocation \"runs\" without a real container, letting the post-run\n// sweep logic be exercised end to end (the launch-path prune also shells out\n// to docker; an exit-0 docker with no output makes it a quiet success).\nfunc fakeDockerOnPath(t *testing.T, body string) string {\n\tt.Helper()\n\tbinDir := pathWithRealGitOnly(t)\n\tif body == \"\" {\n\t\tbody = \"exit 0\"\n\t}\n\tscript := \"#!/bin/sh\\n\" + body + \"\\n\"\n\tif err := os.WriteFile(filepath.Join(binDir, \"docker\"), []byte(script), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn binDir\n}\n\n// sweepTestJob builds a real worktree job (the mg job flow) and returns the\n// project root, the job name, and the job worktree path — the scaffolding the\n// sweep-wiring tests share. Callers set PATH first (fakeDockerOnPath or\n// pathWithRealGitOnly) and chdir into the returned root.\nfunc sweepTestJob(t *testing.T) (dir, jobName, wt string) {\n\tt.Helper()\n\tdir = mgCheckout(t)\n\tt.Chdir(dir)\n\tvar out strings.Builder\n\tif code := runJob([]string{\"Sweep Job\"}, &out, &strings.Builder{}); code != 0 {\n\t\tt.Fatalf(\"runJob: %d %s\", code, out.String())\n\t}\n\tbranch := mgJobBranch(t, dir)\n\tjobName = strings.TrimPrefix(branch, \"feature/\")\n\twt = mgWorktreePath(t, dir, branch)\n\treturn dir, jobName, wt\n}\n\n// TestRunSessionPruneCalledBeforeRun pins the launch-path wiring: runSession\n// calls pruneOrphans (stubbed — docker is not on the test PATH) before the\n// docker run, and a successful prune is quiet. The run then proceeds to the\n// docker launch, which fails on the git-only PATH — proving the prune\n// happened before the run and did not replace it.\nfunc TestRunSessionPruneCalledBeforeRun(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\tdir := mgCheckout(t)\n\tt.Chdir(dir)\n\tprofileCheckout(t, \"CLAUDE_CODE_OAUTH_TOKEN=t\\nCLAUDE_ACCOUNT_UUID=u\\nCLAUDE_EMAIL=e\\nCLAUDE_ORG_UUID=o\\n\")\n\n\tvar pruneCalls int\n\told := pruneOrphans\n\tpruneOrphans = func(diag io.Writer) (session.PruneResult, error) {\n\t\tpruneCalls++\n\t\treturn session.PruneResult{Removed: 1, Running: 0}, nil\n\t}\n\tt.Cleanup(func() { pruneOrphans = old })\n\n\tvar out, errOut strings.Builder\n\tif code := runSession(nil, os.Stdin, &out, &errOut); code != 1 {\n\t\tt.Errorf(\"exit code = %d, want 1 (the docker launch fails on the git-only PATH)\", code)\n\t}\n\tif pruneCalls != 1 {\n\t\tt.Errorf(\"pruneOrphans called %d times, want 1\", pruneCalls)\n\t}\n\tif !strings.Contains(errOut.String(), \"executable file not found\") {\n\t\tt.Errorf(\"the docker launch must have been attempted after the prune:\\n%s\", errOut.String())\n\t}\n\tif strings.Contains(errOut.String(), \"could not prune\") {\n\t\tt.Errorf(\"a successful prune must not warn:\\n%s\", errOut.String())\n\t}\n}\n\n// TestRunSessionPruneFailureIsFailSoft pins the fail-soft contract: a prune\n// failure only warns on stderr and never aborts the launch — the run proceeds\n// to the docker launch (which fails on the git-only PATH) despite the prune\n// error.\nfunc TestRunSessionPruneFailureIsFailSoft(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\tdir := mgCheckout(t)\n\tt.Chdir(dir)\n\tprofileCheckout(t, \"CLAUDE_CODE_OAUTH_TOKEN=t\\nCLAUDE_ACCOUNT_UUID=u\\nCLAUDE_EMAIL=e\\nCLAUDE_ORG_UUID=o\\n\")\n\n\tvar pruneCalls int\n\told := pruneOrphans\n\tpruneOrphans = func(diag io.Writer) (session.PruneResult, error) {\n\t\tpruneCalls++\n\t\treturn session.PruneResult{}, errors.New(\"Cannot connect to the Docker daemon\")\n\t}\n\tt.Cleanup(func() { pruneOrphans = old })\n\n\tvar out, errOut strings.Builder\n\tif code := runSession(nil, os.Stdin, &out, &errOut); code != 1 {\n\t\tt.Errorf(\"exit code = %d, want 1 (the docker launch fails on the git-only PATH)\", code)\n\t}\n\tif pruneCalls != 1 {\n\t\tt.Errorf(\"pruneOrphans called %d times, want 1\", pruneCalls)\n\t}\n\tif !strings.Contains(errOut.String(), \"mg: warning: could not prune orphaned containers\") {\n\t\tt.Errorf(\"missing the prune warning:\\n%s\", errOut.String())\n\t}\n\tif !strings.Contains(errOut.String(), \"executable file not found\") {\n\t\tt.Errorf(\"the launch must proceed past a prune failure (docker attempted):\\n%s\", errOut.String())\n\t}\n}\n\n// TestRunSessionSweepsJobWorktree pins the job-worktree sweep wiring at the\n// session level: after a job-worktree session whose container \"ran\" (a fake\n// docker that exits 0), whatever the agent left uncommitted in the job\n// worktree is swept into a single [<id>] chore: commit all commit and the\n// worktree is left clean.\nfunc TestRunSessionSweepsJobWorktree(t *testing.T) {\n\tt.Setenv(\"PATH\", fakeDockerOnPath(t, \"\"))\n\tdir, jobName, wt := sweepTestJob(t)\n\tprofileCheckout(t, \"CLAUDE_CODE_OAUTH_TOKEN=t\\nCLAUDE_ACCOUNT_UUID=u\\nCLAUDE_EMAIL=e\\nCLAUDE_ORG_UUID=o\\n\")\n\n\t// The \"agent\" leaves a leftover in the job worktree (the analyst's\n\t// tasks.md shape — written, never committed).\n\tif err := os.WriteFile(filepath.Join(wt, \"docs\", \"jobs\", jobName, \"tasks.md\"), []byte(\"# Tasks\\n\\nTASK-1: do the thing\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tvar out, errOut strings.Builder\n\tif code := runSession([]string{\"--job\", jobName}, os.Stdin, &out, &errOut); code != 0 {\n\t\tt.Fatalf(\"runSession exit code = %d, stderr:\\n%s\", code, errOut.String())\n\t}\n\tif want := \"[\" + strings.Split(jobName, \"_\")[0] + \"] chore: commit all\"; mgGit(t, wt, \"log\", \"-1\", \"--format=%s\") != want {\n\t\tt.Errorf(\"sweep commit subject = %q, want %q\", mgGit(t, wt, \"log\", \"-1\", \"--format=%s\"), want)\n\t}\n\tif status := mgGit(t, wt, \"status\", \"--porcelain\"); status != \"\" {\n\t\tt.Errorf(\"job worktree not clean after sweep:\\n%s\", status)\n\t}\n\t// The plain session at the project root must not be swept (no --job).\n\tif status := mgGit(t, dir, \"status\", \"--porcelain\"); status != \"\" {\n\t\tt.Errorf(\"project root must be untouched by a job-worktree sweep:\\n%s\", status)\n\t}\n}\n\n// TestRunSessionDoesNotSweepWhenDockerFailed pins the \"no sweep when no agent\n// ran\" contract at the session level: when the docker launch itself fails\n// (docker missing on the git-only PATH), the leftover in the job worktree is\n// left exactly as it was — an agent that never started must not trigger a\n// commit.\nfunc TestRunSessionDoesNotSweepWhenDockerFailed(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\t_, jobName, wt := sweepTestJob(t)\n\tprofileCheckout(t, \"CLAUDE_CODE_OAUTH_TOKEN=t\\nCLAUDE_ACCOUNT_UUID=u\\nCLAUDE_EMAIL=e\\nCLAUDE_ORG_UUID=o\\n\")\n\n\tleftover := filepath.Join(wt, \"docs\", \"jobs\", jobName, \"tasks.md\")\n\tif err := os.WriteFile(leftover, []byte(\"# Tasks\\n\\nTASK-1: do the thing\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tvar out, errOut strings.Builder\n\tif code := runSession([]string{\"--job\", jobName}, os.Stdin, &out, &errOut); code != 1 {\n\t\tt.Errorf(\"exit code = %d, want 1 (the docker launch fails on the git-only PATH)\", code)\n\t}\n\tif got := mgGit(t, wt, \"log\", \"-1\", \"--format=%s\"); strings.HasPrefix(got, \"[\") {\n\t\tt.Errorf(\"a sweep commit was made despite docker never running (head = %q)\", got)\n\t}\n\tif status := mgGit(t, wt, \"status\", \"--porcelain\"); !strings.Contains(status, \"tasks.md\") {\n\t\tt.Errorf(\"leftover must remain uncommitted after a failed launch, status:\\n%s\", status)\n\t}\n}\n\n// TestRunSessionDoesNotSweepFlatScanFallback pins the TASK-3 blocker fix at\n// the session level: the --job flat-scan fallback — a git repo with no local\n// branches (here: a fresh git init before its first commit), where the job's\n// files live directly in the main project root — must never be swept, even\n// when the container \"ran\" (a fake docker that exits 0). Sweeping there would\n// run git add -A over the user's own uncommitted work — .env included — and\n// create the repo's first commit. The repo keeps its unborn HEAD and the\n// leftovers stay untracked.\nfunc TestRunSessionDoesNotSweepFlatScanFallback(t *testing.T) {\n\tt.Setenv(\"PATH\", fakeDockerOnPath(t, \"\"))\n\tdir := t.TempDir()\n\tmgGit(t, dir, \"init\", \"-q\")\n\tmgGit(t, dir, \"config\", \"user.name\", \"Test\")\n\tmgGit(t, dir, \"config\", \"user.email\", \"test@x.io\")\n\tif err := os.MkdirAll(filepath.Join(dir, \"docs\", \"jobs\", \"ab12cd_flat-scan\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tprofileCheckout(t, \"CLAUDE_CODE_OAUTH_TOKEN=t\\nCLAUDE_ACCOUNT_UUID=u\\nCLAUDE_EMAIL=e\\nCLAUDE_ORG_UUID=o\\n\")\n\n\t// The user's own uncommitted work, .env included — the exact contents the\n\t// flat-scan fallback must never sweep into the repo's first commit.\n\tif err := os.WriteFile(filepath.Join(dir, \"work.txt\"), []byte(\"mine\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(dir, \".env\"), []byte(\"SECRET=token\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Chdir(dir)\n\n\tvar out, errOut strings.Builder\n\tif code := runSession([]string{\"--job\", \"ab12cd_flat-scan\"}, os.Stdin, &out, &errOut); code != 0 {\n\t\tt.Fatalf(\"runSession exit code = %d, stderr:\\n%s\", code, errOut.String())\n\t}\n\tif err := exec.Command(\"git\", \"-C\", dir, \"rev-parse\", \"--verify\", \"HEAD\").Run(); err == nil {\n\t\tt.Error(\"flat-scan fallback must not create the repo's first commit\")\n\t}\n\tstatus := mgGit(t, dir, \"status\", \"--porcelain\")\n\tif !strings.Contains(status, \"work.txt\") || !strings.Contains(status, \".env\") {\n\t\tt.Errorf(\"leftovers must remain untracked after a flat-scan no-op, status:\\n%s\", status)\n\t}\n\tif strings.Contains(errOut.String(), \"chore: commit all\") {\n\t\tt.Errorf(\"no sweep note may appear for a flat-scan fallback:\\n%s\", errOut.String())\n\t}\n}\n\n// TestRunSessionDoesNotSweepPreWorktreeJob pins the second TASK-3 blocker\n// shape at the session level: a pre-worktree job — its branch checked out in\n// the main worktree itself, an explicitly supported transitional state (see\n// internal/job/discover.go:76-82) — resolves --job to the main project root\n// (git.WorktreeForBranch matches the main worktree's own porcelain entry), so\n// it must never be swept either, even though GitCommonDir resolves non-empty\n// there (the repo's own .git — unlike the flat-scan fallback, where\n// GitCommonDir stays \"\"). Sweeping would commit the user's own uncommitted\n// work — .env included — onto the job branch.\nfunc TestRunSessionDoesNotSweepPreWorktreeJob(t *testing.T) {\n\tt.Setenv(\"PATH\", fakeDockerOnPath(t, \"\"))\n\tdir := mgCheckout(t)\n\tt.Chdir(dir)\n\tmgGit(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/ab12cd_main-wt\")\n\tjobDir := filepath.Join(dir, \"docs\", \"jobs\", \"ab12cd_main-wt\")\n\tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(\"# Brief\\n\\nstatus: open\\nid: ab12cd\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tmgGit(t, dir, \"add\", \"-A\")\n\tmgGit(t, dir, \"commit\", \"-q\", \"-m\", \"[ab12cd] scaffold\")\n\tprofileCheckout(t, \"CLAUDE_CODE_OAUTH_TOKEN=t\\nCLAUDE_ACCOUNT_UUID=u\\nCLAUDE_EMAIL=e\\nCLAUDE_ORG_UUID=o\\n\")\n\n\t// The user's own uncommitted work, .env included — must never be swept\n\t// onto the job branch.\n\tif err := os.WriteFile(filepath.Join(dir, \"work.txt\"), []byte(\"mine\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(dir, \".env\"), []byte(\"SECRET=token\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tvar out, errOut strings.Builder\n\tif code := runSession([]string{\"--job\", \"ab12cd_main-wt\"}, os.Stdin, &out, &errOut); code != 0 {\n\t\tt.Fatalf(\"runSession exit code = %d, stderr:\\n%s\", code, errOut.String())\n\t}\n\tif got := mgGit(t, dir, \"log\", \"-1\", \"--format=%s\"); got != \"[ab12cd] scaffold\" {\n\t\tt.Errorf(\"a sweep commit was made over the pre-worktree job's main worktree (head = %q)\", got)\n\t}\n\tstatus := mgGit(t, dir, \"status\", \"--porcelain\")\n\tif !strings.Contains(status, \"work.txt\") || !strings.Contains(status, \".env\") {\n\t\tt.Errorf(\"leftovers must remain untracked after a pre-worktree-job no-op, status:\\n%s\", status)\n\t}\n\tif strings.Contains(errOut.String(), \"chore: commit all\") {\n\t\tt.Errorf(\"no sweep note may appear for a pre-worktree job:\\n%s\", errOut.String())\n\t}\n}","lineStart":1,"lineEnd":293,"totalLines":293,"truncated":false}},"title":"src/cmd/mg/session_test.go","time":{"start":1787920128414,"end":1787920128417}},"id":"prt_048581920001WXwI2ssCdzv2iN","sessionID":"ses_fb7a913aeffe0rISXrjcCChio6","messageID":"msg_