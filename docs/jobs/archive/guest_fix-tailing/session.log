{"type":"tool_use","timestamp":1787919590637,"sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","part":{"type":"tool","tool":"read","callID":"call_00_zwpQuJhsDTJdZUJ542KV5915","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/ui/detail.go"},"output":"<path>/workspace/src/internal/ui/detail.go</path>\n<type>file</type>\n<content>\n1: package ui\n2: \n3: import (\n4: \t\"fmt\"\n5: \t\"os\"\n6: \t\"path/filepath\"\n7: \t\"strings\"\n8: \t\"time\"\n9: \n10: \ttea \"github.com/charmbracelet/bubbletea\"\n11: \t\"github.com/charmbracelet/lipgloss\"\n12: \t\"github.com/lmuskalla/manigot/internal/git\"\n13: \t\"github.com/lmuskalla/manigot/internal/job\"\n14: \t\"github.com/lmuskalla/manigot/internal/launch\"\n15: \t\"github.com/lmuskalla/manigot/internal/markdown\"\n16: \t\"github.com/lmuskalla/manigot/internal/project\"\n17: )\n18: \n19: // The four markdown files every job directory holds, in the order the detail\n20: // view presents them. Matches new-job.sh and the README's job-workflow section.\n21: //\n22: // editable gates the in-TUI edit shortcut (see app.go's \"e\" handling). Only\n23: // brief.md is user-authored — the other three are meant to be written by\n24: // agents, so the shortcut is a no-op there. This is a per-tab flag rather\n25: // than a hardcoded brief.md check so a future job could open editing on more\n26: // tabs by flipping this table alone.\n27: var jobFiles = []struct {\n28: \tlabel    string // tab label\n29: \tfilename string // file within the job dir\n30: \teditable bool   // whether the \"e\" shortcut may open this tab in $EDITOR\n31: }{\n32: \t{\"brief\", \"brief.md\", true},\n33: \t{\"tasks\", \"tasks.md\", false},\n34: \t{\"implementation\", \"implementation.md\", false},\n35: \t{\"verdict\", \"verdict.md\", false},\n36: }\n37: \n38: // fileTab is one rendered file in the detail view.\n39: type fileTab struct {\n40: \tlabel    string\n41: \tpath     string\n42: \texists   bool\n43: \teditable bool\n44: \tcontent  string // raw markdown (or the placeholder) as last read from disk\n45: \tviewer   *markdown.Viewer\n46: \n47: \t// isLog marks the fifth \"log\" tab: unlike the four job files,\n48: \t// its content comes from mg-jdi's sidecar run.log\n49: \t// (job.ReadJDIRunLogTail(d.job.Root, d.job.Name)) rather than d.path —\n50: \t// the sidecar lives outside any job's worktree (tied only to the job\n51: \t// name, not a branch), and it is never editable.\n52: \tisLog bool\n53: \n54: \t// isDiff marks the sixth \"diff\" tab: its content is computed, not read —\n55: \t// the quick-eyeball of what the job's branch changed relative to the\n56: \t// project's base branch (git.LogOneline + git.DiffStat over\n57: \t// <base>...<branch>, the same output `mg diff`'s default prints, see\n58: \t// loadDiff), built fresh on every load so ctrl+r picks up new commits.\n59: \t// Like the log tab it is never editable; a job with no branch (the\n60: \t// working-tree fallback) or a git error gets a plain-text placeholder.\n61: \tisDiff bool\n62: \n63: \t// stale marks a viewer that is out of date with content and/or the\n64: \t// current body size, because the tab wasn't active when that changed —\n65: \t// either a resize (syncViewerSize) or a (re)load (loadTab, see\n66: \t// the \"selecting/leaving a job is laggy\" fix below). It is cleared the\n67: \t// next time the tab becomes active and is caught up in render() via\n68: \t// ensureCurrentSized.\n69: \tstale bool\n70: }\n71: \n72: // detailView shows the four job files as scrollable markdown with a tab bar.\n73: type detailView struct {\n74: \tjob    job.Job\n75: \ttabs   []fileTab\n76: \tcur    int\n77: \twidth  int\n78: \theight int\n79: \n80: \t// status, when non-empty, replaces the footer's key hint — used to confirm\n81: \t// an agent launch or report a launch error.\n82: \tstatus string\n83: \n84: \t// statusUntil is when the current footer status blinks then clears (see\n85: \t// the App's statusExpireMsg handler). statusBlinkOn toggles the footer's\n86: \t// *rendered* visibility during the blink window immediately before\n87: \t// statusUntil; the underlying status text stays set throughout the blink\n88: \t// (statusVisible decides rendering) so footerLines()/bodyHeight()/\n89: \t// syncViewerSize() layout budgets stay stable.\n90: \tstatusUntil   time.Time\n91: \tstatusBlinkOn bool\n92: \n93: \t// spinnerStep is the current activity-indicator frame index (see\n94: \t// activity.go), threaded in from the App by the spinnerTickMsg handler so\n95: \t// the action-bar's running badge animates in sync with the list row.\n96: \t// Defaults to 0 for a freshly built view; the next tick re-syncs it even\n97: \t// if the App was already mid-animation when the view opened.\n98: \tspinnerStep int\n99: \n100: \t// recentCommits backs the bottom-of-view git-log strip: the last few\n101: \t// commits on this job's own branch (git.BranchCommits, fetched via\n102: \t// refreshCommits), the detail view's counterpart of\n103: \t// listView.recentCommits. nil when the job has no branch, the repo has no\n104: \t// commits yet, or BranchCommits errors (e.g. a non-repo project) —\n105: \t// renderCommitStrip degrades to rendering nothing in that case. Populated\n106: \t// by the App on open and on refresh; a detail view constructed directly\n107: \t// (as the tests do) simply has no strip.\n108: \trecentCommits []git.Commit\n109: \n110: \t// recentMax is the maximum number of strip entries (the settings'\n111: \t// RecentActivityCountValue, stored by refreshCommits) that\n112: \t// commitStripShown clamps to, mirroring listView.recentActivityShown's\n113: \t// use of its maxRecent parameter.\n114: \trecentMax int\n115: \n116: \t// tigAvailable caches whether tig resolves on the host (launch.\n117: \t// TigAvailable), queried when the view is constructed and cached for the\n118: \t// view's lifetime — a new job open re-checks it. It gates both the \"t\"\n119: \t// key and the footer hint (see renderFooter), the \"if available\" reading\n120: \t// of the brief; the launch path re-checks availability itself as an\n121: \t// authoritative backstop. The zero value (unavailable) keeps every\n122: \t// existing footer test green without stubbing.\n123: \ttigAvailable bool\n124: }\n125: \n126: // newDetailView loads all four job files, plus the fifth \"log\" tab and the\n127: // sixth computed \"diff\" tab, for job j at the given viewport size.\n128: func newDetailView(j job.Job, width, height int) *detailView {\n129: \td := &detailView{job: j, width: width, height: height, tigAvailable: launch.TigAvailable()}\n130: \tfor _, f := range jobFiles {\n131: \t\td.tabs = append(d.tabs, fileTab{\n132: \t\t\tlabel:    f.label,\n133: \t\t\tpath:     filepath.Join(j.Dir, f.filename),\n134: \t\t\teditable: f.editable,\n135: \t\t\tviewer:   markdown.NewViewer(d.bodyWidth(), d.bodyHeight()),\n136: \t\t})\n137: \t}\n138: \td.tabs = append(d.tabs, fileTab{\n139: \t\tlabel:  \"log\",\n140: \t\tisLog:  true,\n141: \t\tviewer: markdown.NewViewer(d.bodyWidth(), d.bodyHeight()),\n142: \t})\n143: \t// The diff tab's content is git plain text (log/stat output), not\n144: \t// markdown: render it verbatim so glamour's paragraph reflow can't merge\n145: \t// several commits or stat entries onto one rendered line. Strictly\n146: \t// per-tab — the four job-file tabs and the log tab keep the markdown\n147: \t// path (the log tab's latent reflow is a known follow-up, out of scope).\n148: \tdiffTab := fileTab{\n149: \t\tlabel:  \"diff\",\n150: \t\tisDiff: true,\n151: \t\tviewer: markdown.NewViewer(d.bodyWidth(), d.bodyHeight()),\n152: \t}\n153: \tdiffTab.viewer.SetRaw(true)\n154: \td.tabs = append(d.tabs, diffTab)\n155: \td.loadTabs()\n156: \treturn d\n157: }\n158: \n159: // jobFileNotWritten is the placeholder markdown shown for a file new-job.sh has\n160: // not created or an agent has not filled in yet.\n161: //\n162: // No \"# <label>\" heading of its own: the detail view's own title+meta chrome\n163: // line already shows the job title regardless of which tab is showing, so a\n164: // second heading here would just be the same duplication\n165: // stripLeadingFrontmatter removes from real file content below.\n166: func filePlaceholder(filename string) string {\n167: \treturn \"_\" + filename + \" has not been written yet._\"\n168: }\n169: \n170: // loadTabs (re)reads every tab's file from disk. Called on construction and\n171: // on refresh: agents edit files outside the TUI, so the detail view\n172: // must re-read to pick up their changes.\n173: //\n174: // Only the active tab's viewer is actually re-rendered here; the other three\n175: // are cheap disk reads whose markdown render is deferred until they become\n176: // active (see loadTab, ensureCurrentSized). Previously this eagerly rendered\n177: // all four tabs' markdown — non-trivial cost (glamour.Render is not free) —\n178: // on every job open and every return to the list, which is what made\n179: // selecting a job and pressing esc/backspace to leave one feel laggy even\n180: // after the same problem was fixed for resize-triggered re-renders.\n181: func (d *detailView) loadTabs() {\n182: \tfor i := range d.tabs {\n183: \t\td.loadTab(i)\n184: \t}\n185: }\n186: \n187: // loadTab re-reads one tab's file into t.content. If the tab is\n188: // currently active, its viewer is rebuilt immediately; otherwise the viewer\n189: // is left alone and the tab is marked stale so ensureCurrentSized catches it\n190: // up lazily once it actually becomes active.\n191: //\n192: // Every job file is read straight off disk via d.readFile (a job's own\n193: // worktree — or, for an archived job, the main worktree's archive/ — is\n194: // unconditionally the live, correct place to read it from, see the job\n195: // package doc). A missing file falls back to the placeholder.\n196: //\n197: // Real content goes through stripLeadingFrontmatter first: every job file's\n198: // new-job.sh scaffold repeats the title (as its own \"# <Label>: <title>\" H1)\n199: // and metadata (as a \"key: value\" block) that the detail view's chrome\n200: // title+meta line already shows — see loadTab's caller-facing doc and the\n201: // helper's own comment for why only the leading block is ever touched.\n202: func (d *detailView) loadTab(i int) {\n203: \tt := &d.tabs[i]\n204: \tif t.isLog {\n205: \t\tif text, ok := job.ReadJDIRunLogTail(d.job.Root, d.job.Name); ok {\n206: \t\t\tt.exists = true\n207: \t\t\tt.content = text\n208: \t\t\tif t.content == \"\" {\n209: \t\t\t\tt.content = \"_run.log is empty — mg jdi may still be starting its first invocation._\"\n210: \t\t\t}\n211: \t\t} else {\n212: \t\t\tt.exists = false\n213: \t\t\tt.content = \"_no mg jdi run has happened for this job yet._\"\n214: \t\t}\n215: \t\tif i == d.cur {\n216: \t\t\tt.viewer.SetContent(t.content)\n217: \t\t\tt.stale = false\n218: \t\t} else {\n219: \t\t\tt.stale = true\n220: \t\t}\n221: \t\treturn\n222: \t}\n223: \tif t.isDiff {\n224: \t\td.loadDiff(t)\n225: \t\tif i == d.cur {\n226: \t\t\tt.viewer.SetContent(t.content)\n227: \t\t\tt.stale = false\n228: \t\t} else {\n229: \t\t\tt.stale = true\n230: \t\t}\n231: \t\treturn\n232: \t}\n233: \tdata, ok := d.readFile(t)\n234: \tif ok {\n235: \t\tt.exists = true\n236: \t\tt.content = stripLeadingFrontmatter(string(data))\n237: \t} else {\n238: \t\tt.exists = false\n239: \t\tt.content = filePlaceholder(filepath.Base(t.path))\n240: \t}\n241: \tif i == d.cur {\n242: \t\tt.viewer.SetContent(t.content)\n243: \t\tt.stale = false\n244: \t} else {\n245: \t\tt.stale = true\n246: \t}\n247: }\n248: \n249: // loadDiff fills the computed \"diff\" tab's content: the quick-eyeball of\n250: // what the job's branch changed relative to the project's base branch —\n251: // `git log --oneline <base>...<branch>` followed by\n252: // `git diff --stat <base>...<branch>` — mirroring `mg diff`'s default output\n253: // (cmd/mg/diff.go) and its base-branch resolution chain (see\n254: // diffBaseBranch), so the TUI's diff tab and the CLI's `mg diff` always\n255: // agree on the range shown.\n256: //\n257: // Degrades, never crashes: a job with no branch (the working-tree fallback /\n258: // non-repo project) and a git error (e.g. the branch deleted out from under\n259: // the TUI) each set exists=false and a plain-text placeholder; an undiverged\n260: // branch gets the same \"No changes on <branch> relative to <base>.\" line\n261: // `mg diff` prints, with exists=true — it is a real, informative result.\n262: func (d *detailView) loadDiff(t *fileTab) {\n263: \tt.exists = false\n264: \tif d.job.Branch == \"\" {\n265: \t\tt.content = \"_this job has no branch to diff (not a git worktree job)._\"\n266: \t\treturn\n267: \t}\n268: \tbase := d.diffBaseBranch()\n269: \tlogs, err := git.LogOneline(d.job.Root, base, d.job.Branch)\n270: \tif err != nil {\n271: \t\tt.content = diffErrorPlaceholder(err)\n272: \t\treturn\n273: \t}\n274: \tfiles, err := git.DiffStat(d.job.Root, base, d.job.Branch)\n275: \tif err != nil {\n276: \t\tt.content = diffErrorPlaceholder(err)\n277: \t\treturn\n278: \t}\n279: \tif logs == \"\" && files == \"\" {\n280: \t\tt.content = fmt.Sprintf(\"No changes on %s relative to %s.\", d.job.Branch, base)\n281: \t\tt.exists = true\n282: \t\treturn\n283: \t}\n284: \tt.exists = true\n285: \tt.content = logs + \"\\n\\n\" + files\n286: }\n287: \n288: // diffBaseBranch resolves the base branch the diff tab diffs against,\n289: // mirroring cmd/mg/diff.go's chain: the project's configured baseBranch\n290: // (.manigot/manigot.json), falling back to git.SymbolicRefHead\n291: // (origin/HEAD → \"main\") when unset — deliberately NOT\n292: // Settings.BaseBranchValue(), which would default to \"main\" and skip the\n293: // origin/HEAD fallback. The same chain doneConfirmLines uses for its\n294: // \"Branch : <job> → <base>\" line, so the diff tab and the done confirmation\n295: // never disagree about what the job will be merged into.\n296: func (d *detailView) diffBaseBranch() string {\n297: \tsettings, _ := project.Load(d.job.Root)\n298: \tbase := settings.BaseBranch\n299: \tif base == \"\" {\n300: \t\tbase = git.SymbolicRefHead(d.job.Root)\n301: \t}\n302: \treturn base\n303: }\n304: \n305: // diffErrorPlaceholder is the plain-text content for the diff tab when git\n306: // fails to produce the range (e.g. a branch deleted out from under the TUI):\n307: // the error's message, dimmed so it reads as a degrade, not a crash.\n308: func diffErrorPlaceholder(err error) string {\n309: \treturn \"_could not compute the diff: \" + err.Error() + \"_\"\n310: }\n311: \n312: // stripLeadingFrontmatter removes the leading H1 + \"key: value\" frontmatter\n313: // block every job file's new-job.sh scaffold begins with, so glamour doesn't\n314: // render a second title/metadata block duplicating what the detail view's\n315: // own chrome (title+meta line) already shows — app chrome owns identity.\n316: //\n317: // Only the leading, contiguous run bounded by the first blank line is ever\n318: // touched: the first line if it's an H1 (\"# \"), an optional single blank\n319: // line right after it, then a run of \"key: value\" lines, stopping at the\n320: // first blank line found in that run. Real body content past that point is\n321: // never scanned — a line like \"TASK-1: description\" inside \"## Task\n322: // breakdown\" is well past the block's terminating blank line by the time any\n323: // real content is reached, so stripping never reaches it even though it is\n324: // syntactically colon-shaped too.\n325: //\n326: // A file that doesn't start with an H1, or whose line right after the H1\n327: // (and optional blank) isn't itself a \"key: value\" line, doesn't match the\n328: // scaffold shape at all and is returned unchanged rather than guessed at.\n329: func stripLeadingFrontmatter(content string) string {\n330: \tlines := strings.Split(content, \"\\n\")\n331: \tif len(lines) == 0 || !strings.HasPrefix(lines[0], \"# \") {\n332: \t\treturn content\n333: \t}\n334: \ti := 1\n335: \tif i < len(lines) && strings.TrimSpace(lines[i]) == \"\" {\n336: \t\ti++\n337: \t}\n338: \tstart := i\n339: \tfor i < len(lines) && strings.TrimSpace(lines[i]) != \"\" {\n340: \t\tif !isFrontmatterLine(lines[i]) {\n341: \t\t\t// Not the scaffold shape (e.g. the H1 is directly followed by\n342: \t\t\t// prose, no frontmatter at all) — leave the whole file alone.\n343: \t\t\treturn content\n344: \t\t}\n345: \t\ti++\n346: \t}\n347: \tif i == start {\n348: \t\t// H1 with nothing (not even a blank line) after it.\n349: \t\treturn content\n350: \t}\n351: \t// Skip the blank line terminating the frontmatter block, if present.\n352: \tif i < len(lines) && strings.TrimSpace(lines[i]) == \"\" {\n353: \t\ti++\n354: \t}\n355: \treturn strings.Join(lines[i:], \"\\n\")\n356: }\n357: \n358: // isFrontmatterLine reports whether a line matches the \"key: value\" shape\n359: // new-job.sh's scaffold frontmatter uses: a bare key with no leading\n360: // whitespace and no spaces before its colon (e.g. \"status: open\",\n361: // \"developer:\"). Deliberately narrow so it only ever matches inside the\n362: // leading contiguous block stripLeadingFrontmatter bounds by the first blank\n363: // line — real prose elsewhere in the document is never passed to this.\n364: func isFrontmatterLine(line string) bool {\n365: \tif line == \"\" || line[0] == ' ' || line[0] == '\\t' {\n366: \t\treturn false\n367: \t}\n368: \tidx := strings.Index(line, \":\")\n369: \tif idx <= 0 {\n370: \t\treturn false\n371: \t}\n372: \treturn !strings.ContainsAny(line[:idx], \" \\t\")\n373: }\n374: \n375: // readFile reads one tab's file bytes straight off disk from t.path — a\n376: // job's own worktree (or the main worktree's archive/) is unconditionally\n377: // the live, correct place to read its four files from (see the job package\n378: // doc), so there is no branch check and no git-show fallback. ok is false\n379: // when the file isn't available at that path (missing).\n380: func (d *detailView) readFile(t *fileTab) (data []byte, ok bool) {\n381: \tb, err := os.ReadFile(t.path)\n382: \tif err != nil {\n383: \t\treturn nil, false\n384: \t}\n385: \treturn b, true\n386: }\n387: \n388: // reload re-reads all four files (used by App.refresh).\n389: func (d *detailView) reload() { d.loadTabs() }\n390: \n391: // runLogExists reports whether a run.log sidecar exists for this job — the\n392: // gate for both the \"l\" tail key (app.go's updateDetail) and its footer hint\n393: // (renderFooter), the same condition under which the log tab shows real\n394: // content (job.ReadJDIRunLogTail). A simple existence check, not a liveness\n395: // check: `tail -f` idles harmlessly once a run ends, so the pane is\n396: // reachable for any job mg-jdi has ever driven.\n397: func (d *detailView) runLogExists() bool {\n398: \t_, err := os.Stat(job.JDIRunLogPath(d.job.Root, d.job.Name))\n399: \treturn err == nil\n400: }\n401: \n402: // reloadCurrent re-reads just the active tab's file — used after the \"e\"\n403: // edit shortcut returns, so a file that didn't exist before (and was shown\n404: // as a placeholder) flips over to its real content once the editor creates\n405: // it on save.\n406: func (d *detailView) reloadCurrent() { d.loadTab(d.cur) }\n407: \n408: // refreshCommits re-reads the job-branch git-log strip from git (git.\n409: // BranchCommits against d.job.Root, d.job.Branch — the branch ref is shared\n410: // across the whole repo, so the main worktree's root resolves it fine),\n411: // always fetching up to maxRecent (Settings.RecentActivityCountValue). How\n412: // many of those cached commits actually get rendered is decided later, at\n413: // render time, by commitStripShown — the same split the list view uses\n414: // between refreshRecentCommits and recentActivityShown, so a view that never\n415: // received a WindowSizeMsg isn't sized against a stale terminal height.\n416: //\n417: // Like the list view's strip fetch, an error (e.g. a non-repo project) or an\n418: // empty job branch degrades to an empty strip rather than surfacing in the\n419: // status line — this is decorative, optional content, not an action the user\n420: // asked for.\n421: func (d *detailView) refreshCommits(maxRecent int) {\n422: \td.recentMax = maxRecent\n423: \tif d.job.Branch == \"\" {\n424: \t\td.recentCommits = nil\n425: \t\td.syncViewerSize()\n426: \t\treturn\n427: \t}\n428: \tcommits, err := git.BranchCommits(d.job.Root, d.job.Branch, maxRecent)\n429: \tif err != nil {\n430: \t\td.recentCommits = nil\n431: \t\td.syncViewerSize()\n432: \t\treturn\n433: \t}\n434: \td.recentCommits = commits\n435: \t// The strip's footprint may have changed (appeared, disappeared, or\n436: \t// grown), which changes how many chrome rows the total render needs —\n437: \t// resize the active viewer and mark the others stale so the body shrinks\n438: \t// and the total still fits the viewport, mirroring setStatus's own\n439: \t// budget handling. refreshCommits runs right after newDetailView (whose\n440: \t// viewers were sized with no strip yet), so without this the strip would\n441: \t// overflow the alt-screen on open.\n442: \td.syncViewerSize()\n443: }\n444: \n445: // resize propagates a window-size change to every viewer (a width change means\n446: // the markdown must be re-wrapped).\n447: func (d *detailView) resize(width, height int) {\n448: \tif width == d.width && height == d.height {\n449: \t\treturn\n450: \t}\n451: \td.width, d.height = width, height\n452: \td.syncViewerSize()\n453: }\n454: \n455: // setStatus sets the footer status line, arms its blink-then-expire deadline\n456: // (mirroring App.setStatus for the list footer — see statusExpireMsg), and,\n457: // since a multi-line status (e.g. cmdErrorText's resolution diagnosis)\n458: // changes how many chrome rows the footer needs, resizes the viewers so the\n459: // total rendered height still fits the terminal — otherwise the alt-screen\n460: // viewport clips the bottom of the status instead of shrinking the body.\n461: func (d *detailView) setStatus(s string) {\n462: \td.status = s\n463: \tif s == \"\" {\n464: \t\td.statusBlinkOn = false\n465: \t\td.statusUntil = time.Time{}\n466: \t} else {\n467: \t\td.statusBlinkOn = false\n468: \t\td.statusUntil = statusNow().Add(statusLifetime)\n469: \t}\n470: \td.syncViewerSize()\n471: }\n472: \n473: // syncViewerSize resizes the active tab's viewer to the current body\n474: // dimensions immediately, and marks the other three as stale instead of\n475: // eagerly re-rendering them too.\n476: //\n477: // Re-rendering all four tabs' markdown here was a major source of the\n478: // reported input lag: this is called from setStatus, which itself fires on\n479: // nearly every keypress in the detail view (including every agent launch\n480: // attempt), so every keypress was paying for three re-renders that weren't\n481: // even visible. Deferred tabs catch up lazily in render() the next time\n482: // they actually become the active one.\n483: func (d *detailView) syncViewerSize() {\n484: \tw, h := d.bodyWidth(), d.bodyHeight()\n485: \tfor i := range d.tabs {\n486: \t\tif i == d.cur {\n487: \t\t\td.tabs[i].viewer.Resize(w, h)\n488: \t\t\td.tabs[i].stale = false\n489: \t\t} else {\n490: \t\t\td.tabs[i].stale = true\n491: \t\t}\n492: \t}\n493: }\n494: \n495: // ensureCurrentSized brings the active tab's viewer up to date if it was left\n496: // stale — by a resize that happened while a different tab was showing (see\n497: // syncViewerSize), or by a (re)load that only updated t.content because the\n498: // tab wasn't active at the time (see loadTab). Called from render() so a tab\n499: // is always correctly rendered by the time it is actually drawn.\n500: //\n501: // This always goes through SetSize+SetContent rather than the guarded\n502: // Resize: Resize is a no-op when the width/height haven't changed, which is\n503: // exactly the common case here (content changed, size didn't) — using it\n504: // would leave a content-stale tab showing its old rendered text.\n505: func (d *detailView) ensureCurrentSized() {\n506: \tt := &d.tabs[d.cur]\n507: \tif !t.stale {\n508: \t\treturn\n509: \t}\n510: \tt.viewer.SetSize(d.bodyWidth(), d.bodyHeight())\n511: \tt.viewer.SetContent(t.content)\n512: \tt.stale = false\n513: }\n514: \n515: // update handles detail-view keys: file switching and scrolling.\n516: func (d *detailView) update(msg tea.KeyMsg) {\n517: \tswitch msg.String() {\n518: \tcase \"tab\", \"right\":\n519: \t\tif d.cur < len(d.tabs)-1 {\n520: \t\t\td.cur++\n521: \t\t}\n522: \tcase \"shift+tab\", \"left\":\n523: \t\tif d.cur > 0 {\n524: \t\t\td.cur--\n525: \t\t}\n526: \tcase \"1\":\n527: \t\td.cur = 0\n528: \tcase \"2\":\n529: \t\td.cur = 1\n530: \tcase \"3\":\n531: \t\td.cur = 2\n532: \tcase \"4\":\n533: \t\td.cur = 3\n534: \tcase \"5\":\n535: \t\td.cur = 4\n536: \tcase \"6\":\n537: \t\td.cur = 5\n538: \tdefault:\n539: \t\td.active().scroll(msg)\n540: \t}\n541: }\n542: \n543: // current returns the active tab.\n544: func (d *detailView) current() *fileTab { return &d.tabs[d.cur] }\n545: \n546: // active is an alias for current used by update; kept for readability at the\n547: // call site where we mean \"the tab the scroll key applies to\".\n548: func (d *detailView) active() *fileTab { return d.current() }\n549: \n550: // scroll routes scroll keys to the active viewer.\n551: func (t *fileTab) scroll(msg tea.KeyMsg) {\n552: \tswitch msg.String() {\n553: \tcase \"down\":\n554: \t\tt.viewer.ScrollDown(1)\n555: \tcase \"up\":\n556: \t\tt.viewer.ScrollUp(1)\n557: \tcase \"pgdown\", \" \":\n558: \t\tt.viewer.PageDown()\n559: \tcase \"pgup\":\n560: \t\tt.viewer.PageUp()\n561: \t// \"g\" is deliberately not bound here anymore: the detail view's App-level\n562: \t// \"g\" key opens the git panel (see app.go's updateDetail), so the viewer\n563: \t// scroll-to-top stays reachable via \"home\" only.\n564: \tcase \"home\":\n565: \t\tt.viewer.Top()\n566: \tcase \"G\", \"end\":\n567: \t\tt.viewer.Bottom()\n568: \t}\n569: }\n570: \n571: // bodyGutter is the width of the vertical rule + gap rendered to the left of\n572: // the doc body (see renderBody) — reserved out of bodyWidth so the\n573: // rule-prefixed lines still fit within d.width.\n574: const bodyGutter = 2\n575: \n576: // bodyWidth / bodyHeight compute the markdown viewport given the chrome the\n577: // detail view draws around it (title, tab bar, footer, and the left-hand\n578: // vertical rule).\n579: func (d *detailView) bodyWidth() int {\n580: \tw := d.width - 2 - bodyGutter // small right margin + left rule/gap\n581: \tif w < 1 {\n582: \t\tw = 1\n583: \t}\n584: \treturn w\n585: }\n586: \n587: func (d *detailView) bodyHeight() int {\n588: \t// title(1) + blank(1) + tab bar(1) + agents line(1) + stage/done line(1) + blank(1) + body + blank(1) + footer(footerLines)\n589: \t// = (7 + footerLines) chrome rows around the body, plus the bottom\n590: \t// git-log strip's own footprint (1 spacer + its commit rows, see\n591: \t// commitStripRows) — the body shrinks so the total render still fits the\n592: \t// alt-screen viewport, the same budget discipline\n593: \t// TestDetailBodyHeightShrinksForMultiLineStatus guards for the footer.\n594: \th := d.height - 7 - d.footerLines() - d.commitStripRows()\n595: \tif h < 1 {\n596: \t\th = 1\n597: \t}\n598: \treturn h\n599: }\n600: \n601: // renderBody prefixes the active viewer's rendered lines with a dim vertical\n602: // rule, so the doc content — already indented by glamour's own document\n603: // margin — reads as a distinct panel rather than chrome-level text.\n604: func (d *detailView) renderBody() string {\n605: \tbody := d.current().viewer.View()\n606: \tif body == \"\" {\n607: \t\treturn body\n608: \t}\n609: \trule := dimStyle.Render(\"│\") + \" \"\n610: \tlines := strings.Split(body, \"\\n\")\n611: \tfor i, l := range lines {\n612: \t\tlines[i] = rule + l\n613: \t}\n614: \treturn strings.Join(lines, \"\\n\")\n615: }\n616: \n617: // footerLines returns how many rows renderFooter will occupy. Normally the\n618: // footer is a single line (the scroll position / key hint, or a short status\n619: // message), but cmdErrorText (app.go) can return a multi-line resolution\n620: // diagnosis for a failed agent launch — bodyHeight must account for that so\n621: // the total rendered height still fits the fixed alt-screen viewport, instead\n622: // of pushing the last line(s) of the footer (the \"fix:\" hint) off screen.\n623: func (d *detailView) footerLines() int {\n624: \tif d.status == \"\" {\n625: \t\treturn 1\n626: \t}\n627: \treturn strings.Count(d.status, \"\\n\") + 1\n628: }\n629: \n630: // commitStripShown returns how many of d.recentCommits the bottom git-log\n631: // strip should actually render, mirroring listView.recentActivityShown's\n632: // adaptive sizing: between recentActivityFloor and the configured maximum\n633: // (d.recentMax, stored by refreshCommits), clamped to the spare vertical room\n634: // and the available commits. 0 when the cache is empty — no strip at all.\n635: //\n636: // The spare-room formula is the detail view's analogue of the list's\n637: // `height - dashboardFixedChrome - jobCount`: the fixed chrome (7 rows +\n638: // footerLines) is what the list's dashboardFixedChrome is; the body's own\n639: // 1-row floor stands in for the job rows (the body is scrollable but must\n640: // never be squeezed out entirely); and the strip's own 1-row spacer is\n641: // accounted for so the body budget and the rendered output agree.\n642: //\n643: // height == 0 (a view that has never received a tea.WindowSizeMsg, e.g.\n644: // some existing tests) falls back to the floor, the same kind of guard the\n645: // list view applies.\n646: func (d *detailView) commitStripShown() int {\n647: \tif len(d.recentCommits) == 0 {\n648: \t\treturn 0\n649: \t}\n650: \tvar n int\n651: \tif d.height == 0 {\n652: \t\tn = recentActivityFloor\n653: \t} else {\n654: \t\tspare := d.height - 7 - d.footerLines() - 1 - 1 // body floor + strip spacer\n655: \t\tn = clamp(spare, recentActivityFloor, d.recentMax)\n656: \t}\n657: \tif n > len(d.recentCommits) {\n658: \t\t// Fewer real commits than the computed count — render whatever's\n659: \t\t// available, same graceful-degrade rule the list view applies.\n660: \t\tn = len(d.recentCommits)\n661: \t}\n662: \treturn n\n663: }\n664: \n665: // commitStripRows is the strip's total vertical footprint below the footer:\n666: // its 1-row blank spacer plus one row per commit line it renders (0 when\n667: // nothing renders). bodyHeight subtracts this from the viewport so the body\n668: // shrinks and the total render still fits — the detail view's analogue of\n669: // the list's dashboardFixedChrome strip-spacer row.\n670: func (d *detailView) commitStripRows() int {\n671: \tif n := d.commitStripShown(); n > 0 {\n672: \t\treturn 1 + n\n673: \t}\n674: \treturn 0\n675: }\n676: \n677: // render draws the detail view.\n678: func (d *detailView) render() string {\n679: \tw := d.width\n680: \tif w == 0 {\n681: \t\tw = 72\n682: \t}\n683: \n684: \td.ensureCurrentSized()\n685: \n686: \tvar b strings.Builder\n687: \n688: \t// Title + meta line.\n689: \tb.WriteString(titleStyle.Render(d.job.Title))\n690: \tmeta := fmt.Sprintf(\"  #%s · %s · %s · %s\", d.job.ID, d.job.Status, d.job.Type, d.job.Date)\n691: \tb.WriteString(dimStyle.Render(meta))\n692: \t// Branch: show which branch the job's own worktree is checked out to.\n693: \t// Purely informational — every job has its own worktree, so there is no\n694: \t// \"wrong branch checked out\" state to warn about anymore.\n695: \tif d.job.Branch != \"\" {\n696: \t\tb.WriteString(dimStyle.Render(\" · branch: \" + d.job.Branch))\n697: \t}\n698: \tb.WriteString(\"\\n\\n\")\n699: \n700: \t// Tab bar (\"docs:\" line).\n701: \tb.WriteString(d.renderTabs(w))\n702: \tb.WriteString(\"\\n\")\n703: \n704: \t// Agent action bar: an \"agents:\" line, then the stage timeline plus the\n705: \t// Done button on its own line beneath.\n706: \tb.WriteString(d.renderActionBar())\n707: \tb.WriteString(\"\\n\\n\")\n708: \n709: \t// Body: the active viewer, set off from the chrome by a left rule.\n710: \tb.WriteString(d.renderBody())\n711: \tb.WriteString(\"\\n\\n\")\n712: \n713: \t// Footer: scroll position + keys.\n714: \tb.WriteString(d.renderFooter())\n715: \n716: \t// Job-branch git-log strip: below the footer, mirroring the list view's\n717: \t// recent-activity strip position — read-only supplementary info, kept out\n718: \t// of the way of the job files and the chrome (see renderCommitStrip).\n719: \tb.WriteString(d.renderCommitStrip(w))\n720: \n721: \treturn b.String()\n722: }\n723: \n724: // actionButton is one entry in the agents line: an agent-launch button,\n725: // rendered \"[key] Label\" — see renderActionBar's doc comment.\n726: type actionButton struct {\n727: \tkey, label string\n728: }\n729: \n730: // renderActionBar draws the two-line action bar: an \"agents:\" line listing\n731: // the five agents in agentOrder (always shown regardless of the job's\n732: // stage — app.go's agentForKey is not stage-gated either), each in a\n733: // consistent \"[key] Label\" format; then, on its own line beneath, a \"stage:\"\n734: // label (mirroring \"docs:\" and \"agents:\") followed by the stage timeline\n735: // (see renderStageTimeline) alongside the \"[D] Done\" mark-done button and\n736: // \"[j] mg-jdi\" — a bigger, composite action like Done, not a\n737: // single-agent launch, hence its own key rather than living in agentOrder.\n738: //\n739: // The stage timeline stays purely informational: an at-a-glance sense of\n740: // where the job's files say it is in the ideal workflow, and how far it has\n741: // come. It no longer restricts which buttons appear (launching any agent is\n742: // not gated by stage). Done keeps its own colour (statusDoneStyle, the same\n743: // green used for \"done\" status elsewhere) to flag that it's categorically\n744: // different from the five launch actions — it archives the job via mg-done\n745: // rather than starting a session.\n746: //\n747: // Narrow-width handling: this is designed against an 80-column baseline, and\n748: // there isn't room there for five full \"[key] Label\" agent buttons —\n749: // \"Developer\" alone is 9 characters. Once the full-label agents line\n750: // would overflow d.width, every button's *label* — never its key, which must\n751: // always stay reachable/visible — is truncated to share whatever room\n752: // remains, using the same \"…\" convention truncate() (app.go) already applies\n753: // to job titles. Wrapping to a further line was the brief's other offered\n754: // option; truncation was chosen instead because it would add a row the fixed\n755: // chrome-row budget in bodyHeight doesn't account for (it assumes a\n756: // two-line action bar) — the same kind of alt-screen-clipping risk\n757: // TestDetailBodyHeightShrinksForMultiLineStatus guards against for the\n758: // footer, without that guard existing here.\n759: func (d *detailView) renderActionBar() string {\n760: \tbuttons := make([]actionButton, 0, len(agentOrder))\n761: \tfor _, a := range agentOrder {\n762: \t\tm, ok := agentMeta[a]\n763: \t\tif !ok {\n764: \t\t\t// Unknown agent name — render it literally without a bound key.\n765: \t\t\tbuttons = append(buttons, actionButton{key: \"?\", label: a})\n766: \t\t\tcontinue\n767: \t\t}\n768: \t\tbuttons = append(buttons, actionButton{key: m.key, label: m.display})\n769: \t}\n770: \n771: \tw := d.width\n772: \tif w == 0 {\n773: \t\tw = 72\n774: \t}\n775: \tconst sep = \"  \"\n776: \tconst agentsLabel = \"agents:\"\n777: \n778: \t// Fixed cost: the \"agents:\" label, every button's \"[key] \" prefix, and\n779: \t// the separators between all elements — everything but the label text,\n780: \t// which is the only part allowed to shrink.\n781: \tfixed := len(agentsLabel)\n782: \tfor _, btn := range buttons {\n783: \t\tfixed += len(sep) + len(\"[\"+btn.key+\"] \")\n784: \t}\n785: \tlabelBudget := w - fixed\n786: \tperLabel := 0\n787: \tif len(buttons) > 0 {\n788: \t\tperLabel = labelBudget / len(buttons)\n789: \t}\n790: \n791: \tvar agentsLine strings.Builder\n792: \tagentsLine.WriteString(dimStyle.Render(agentsLabel))\n793: \tfor _, btn := range buttons {\n794: \t\tlabel := btn.label\n795: \t\tif perLabel < len(label) {\n796: \t\t\tlabel = truncateToWidth(label, perLabel)\n797: \t\t}\n798: \t\tagentsLine.WriteString(sep)\n799: \t\tagentsLine.WriteString(accentStyle.Render(\"[\" + btn.key + \"]\"))\n800: \t\tif label != \"\" {\n801: \t\t\tagentsLine.WriteString(\" \")\n802: \t\t\tagentsLine.WriteString(label)\n803: \t\t}\n804: \t}\n805: \n806: \tvar stageLine strings.Builder\n807: \tstageLine.WriteString(dimStyle.Render(\"stage:\"))\n808: \tstageLine.WriteString(sep)\n809: \tstageLine.WriteString(renderStageTimeline(d.job.Stage()))\n810: \tstageLine.WriteString(sep)\n811: \tstageLine.WriteString(statusDoneStyle.Render(\"[D]\"))\n812: \tstageLine.WriteString(\" \")\n813: \tstageLine.WriteString(statusDoneStyle.Render(\"Done\"))\n814: \tstageLine.WriteString(sep)\n815: \tstageLine.WriteString(accentStyle.Render(\"[j]\"))\n816: \tstageLine.WriteString(\" \")\n817: \tstageLine.WriteString(accentStyle.Render(\"just do it\"))\n818: \t// A live running/stopped indicator right next to the button that starts\n819: \t// it: reuses the same job.ReadJDIStatus-backed jdiStatusBadge formatting\n820: \t// the job-list row already renders, so a user sitting in the detail view\n821: \t// — exactly where \"j\" is pressed, and where the already-running block\n822: \t// message appears — can see at a glance whether mg-jdi is still going,\n823: \t// not only from the list. The\n824: \t// running variant's animated frame comes from d.spinnerStep, threaded in\n825: \t// by the App's spinnerTickMsg handler, so it animates in sync with the\n826: \t// list row while a run is active. Like the list badge, the underlying\n827: \t// status has no polling timer of its own: it reads the sidecar fresh on\n828: \t// every render() call, so it updates whenever Bubble Tea next re-renders\n829: \t// (the spinner tick, or any keypress).\n830: \tif badge := jdiStatusBadge(d.job.Root, d.job, d.spinnerStep); badge != \"\" {\n831: \t\tstageLine.WriteString(sep)\n832: \t\tstageLine.WriteString(badge)\n833: \t}\n834: \n835: \treturn agentsLine.String() + \"\\n\" + stageLine.String()\n836: }\n837: \n838: // renderStageTimeline renders every job.Stages entry as a compact horizontal\n839: // timeline: a checked, done-coloured marker for every stage behind the\n840: // current one, a highlighted marker for the current stage, and a dim, hollow\n841: // marker for stages still ahead. Replaces the old bare \"stage: <name>\" label\n842: // with an at-a-glance sense of how far along the job actually is — including\n843: // a verdict that bounced the job back to implement showing review/finished\n844: // as still ahead, not behind, since job.Stage() already encodes that.\n845: func renderStageTimeline(current job.Stage) string {\n846: \tidx := -1\n847: \tfor i, s := range job.Stages {\n848: \t\tif s == current {\n849: \t\t\tidx = i\n850: \t\t\tbreak\n851: \t\t}\n852: \t}\n853: \tparts := make([]string, len(job.Stages))\n854: \tfor i, s := range job.Stages {\n855: \t\tlabel := string(s)\n856: \t\tswitch {\n857: \t\tcase idx >= 0 && i < idx:\n858: \t\t\tparts[i] = statusDoneStyle.Render(\"✓ \" + label)\n859: \t\tcase i == idx:\n860: \t\t\tparts[i] = accentStyle.Render(\"● \" + label)\n861: \t\tdefault:\n862: \t\t\tparts[i] = dimStyle.Render(\"○ \" + label)\n863: \t\t}\n864: \t}\n865: \treturn strings.Join(parts, dimStyle.Render(\" → \"))\n866: }\n867: \n868: // truncateToWidth is truncate() (app.go) with a floor of 0 instead of\n869: // truncate's own \"n <= 0 leaves s unchanged\" behaviour: the action bar's\n870: // narrow-width handling can legitimately compute a zero or negative label\n871: // budget (six buttons is a lot to fit at 80 columns), in which case the\n872: // label should disappear entirely — leaving only the reachable \"[key]\" — not\n873: // render at full length as truncate(s, 0) would.\n874: func truncateToWidth(s string, n int) string {\n875: \tif n <= 0 {\n876: \t\treturn \"\"\n877: \t}\n878: \treturn truncate(s, n)\n879: }\n880: \n881: // renderTabs draws \"docs: [brief] tasks implementation verdict\" with the\n882: // active tab highlighted and not-yet-written files dimmed.\n883: func (d *detailView) renderTabs(width int) string {\n884: \tparts := make([]string, len(d.tabs))\n885: \tfor i, t := range d.tabs {\n886: \t\tlabel := t.label\n887: \t\tif !t.exists {\n888: \t\t\tlabel = \"(\" + t.label + \")\"\n889: \t\t}\n890: \t\tif i == d.cur {\n891: \t\t\tparts[i] = lipgloss.NewStyle().Bold(true).\n892: \t\t\t\tBackground(accent).Foreground(lipgloss.Color(\"#ffffff\")).\n893: \t\t\t\tRender(\" \" + label + \" \")\n894: \t\t} else if !t.exists {\n895: \t\t\tparts[i] = dimStyle.Render(label)\n896: \t\t} else {\n897: \t\t\tparts[i] = label\n898: \t\t}\n899: \t}\n900: \tbar := strings.Join(parts, \"  \")\n901: \treturn dimStyle.Render(\"docs:\") + \"  \" + bar\n902: }\n903: \n904: // renderFooter draws the scroll position, key hint, and (when set and\n905: // currently visible — see statusVisible/the blink window this footer shares\n906: // with the list footer) the status message — a status must coexist with the\n907: // hint, not replace it, so a user who just pressed \"ctrl+r\" or launched an\n908: // agent still knows what keys exist.\n909: //\n910: // The one exception is a multi-line status (cmdErrorText's resolution\n911: // diagnosis for a failed host-command lookup — see footerLines): that's a\n912: // distinct, already-tested diagnostic case, not the \"lost the legend\" problem\n913: // this coexistence handles, and appending the (fairly long) hint to it risks\n914: // overflowing narrow terminals on top of an already multi-line block. It\n915: // keeps replacing the hint entirely, same as before.\n916: //\n917: // During a blink-off toggle the status text itself stays set (so\n918: // footerLines()/bodyHeight() layout never jitters — see setStatus) but is\n919: // rendered as blank space of the same line count instead, exactly mirroring\n920: // how listFooter hides (not shrinks) a blinked-off list status.\n921: func (d *detailView) renderFooter() string {\n922: \tpos := d.current().viewer.Position()\n923: \thint := \"tab/1-6 files\"\n924: \tif d.current().editable {\n925: \t\t// \"e\" only does anything on editable tabs (brief.md today), so the\n926: \t\t// hint is scoped to when it would actually work.\n927: \t\thint += \" · e edit\"\n928: \t}\n929: \tif d.tigAvailable && d.job.Branch != \"\" {\n930: \t\t// \"t\" opens tig on the job's branch diff — only reachable when tig\n931: \t\t// is installed on the host AND the job has a branch to browse (the\n932: \t\t// same availability gate the key itself checks, see app.go).\n933: \t\thint += \" · t tig\"\n934: \t}\n935: \tif d.runLogExists() {\n936: \t\t// \"l\" tails the job's mg-jdi run.log in a spawned pane — reachable\n937: \t\t// whenever a run.log exists for this job (the same gate the key\n938: \t\t// itself checks, see app.go), regardless of branch or tig.\n939: \t\thint += \" · l tail\"\n940: \t}\n941: \thint += \" · g git · x/del remove job · ctrl+r refresh · esc back · q quit\"\n942: \n943: \tif d.status != \"\" {\n944: \t\tvisible := statusVisible(d.status, d.statusUntil, d.statusBlinkOn, statusNow())\n945: \t\tif strings.Contains(d.status, \"\\n\") {\n946: \t\t\tif !visible {\n947: \t\t\t\treturn strings.Repeat(\"\\n\", strings.Count(d.status, \"\\n\"))\n948: \t\t\t}\n949: \t\t\treturn statusStyle.Render(d.status)\n950: \t\t}\n951: \t\tif !visible {\n952: \t\t\treturn dimStyle.Render(fmt.Sprintf(\"%s   %s\", pos, hint))\n953: \t\t}\n954: \t\treturn dimStyle.Render(fmt.Sprintf(\"%s   %s\", pos, hint)) + \"  \" + statusStyle.Render(d.status)\n955: \t}\n956: \treturn dimStyle.Render(fmt.Sprintf(\"%s   %s\", pos, hint))\n957: }\n958: \n959: // renderCommitStrip renders the job-branch git-log strip below the footer —\n960: // the detail view's counterpart of the list view's recent-activity strip,\n961: // scoped to just this job's own branch (d.recentCommits, fed by\n962: // refreshCommits). It reuses the same renderActivityLines formatter, so the\n963: // visuals are byte-for-byte identical to the list's (the branch column\n964: // included — \"same visuals\" per the brief, even though it is redundant when\n965: // every line belongs to one branch). The blank spacer line before the first\n966: // commit line is part of the strip's footprint, which bodyHeight's\n967: // commitStripRows already budgets for.\n968: //\n969: // Renders nothing — not even the spacer — when the cache is empty (a\n970: // non-repo project, a job with no branch, or a job branch with no commits\n971: // yet): the strip is optional supplementary content, same as the list view's.\n972: func (d *detailView) renderCommitStrip(w int) string {\n973: \tn := d.commitStripShown()\n974: \tif n == 0 {\n975: \t\treturn \"\"\n976: \t}\n977: \treturn \"\\n\\n\" + renderActivityLines(d.recentCommits[:n], w)\n978: }\n\n(End of file - total 978 lines)\n</content>","metadata":{"preview":"package ui\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\ttea \"github.com/charmbracelet/bubbletea\"\n\t\"github.com/charmbracelet/lipgloss\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/launch\"\n\t\"github.com/lmuskalla/manigot/internal/markdown\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// The four markdown files every job directory holds, in the order the detail\n// view presents them. Matches new-job.sh and the README's job-workflow section.","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/ui/detail.go","text":"package ui\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\ttea \"github.com/charmbracelet/bubbletea\"\n\t\"github.com/charmbracelet/lipgloss\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/launch\"\n\t\"github.com/lmuskalla/manigot/internal/markdown\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// The four markdown files every job directory holds, in the order the detail\n// view presents them. Matches new-job.sh and the README's job-workflow section.\n//\n// editable gates the in-TUI edit shortcut (see app.go's \"e\" handling). Only\n// brief.md is user-authored — the other three are meant to be written by\n// agents, so the shortcut is a no-op there. This is a per-tab flag rather\n// than a hardcoded brief.md check so a future job could open editing on more\n// tabs by flipping this table alone.\nvar jobFiles = []struct {\n\tlabel    string // tab label\n\tfilename string // file within the job dir\n\teditable bool   // whether the \"e\" shortcut may open this tab in $EDITOR\n}{\n\t{\"brief\", \"brief.md\", true},\n\t{\"tasks\", \"tasks.md\", false},\n\t{\"implementation\", \"implementation.md\", false},\n\t{\"verdict\", \"verdict.md\", false},\n}\n\n// fileTab is one rendered file in the detail view.\ntype fileTab struct {\n\tlabel    string\n\tpath     string\n\texists   bool\n\teditable bool\n\tcontent  string // raw markdown (or the placeholder) as last read from disk\n\tviewer   *markdown.Viewer\n\n\t// isLog marks the fifth \"log\" tab: unlike the four job files,\n\t// its content comes from mg-jdi's sidecar run.log\n\t// (job.ReadJDIRunLogTail(d.job.Root, d.job.Name)) rather than d.path —\n\t// the sidecar lives outside any job's worktree (tied only to the job\n\t// name, not a branch), and it is never editable.\n\tisLog bool\n\n\t// isDiff marks the sixth \"diff\" tab: its content is computed, not read —\n\t// the quick-eyeball of what the job's branch changed relative to the\n\t// project's base branch (git.LogOneline + git.DiffStat over\n\t// <base>...<branch>, the same output `mg diff`'s default prints, see\n\t// loadDiff), built fresh on every load so ctrl+r picks up new commits.\n\t// Like the log tab it is never editable; a job with no branch (the\n\t// working-tree fallback) or a git error gets a plain-text placeholder.\n\tisDiff bool\n\n\t// stale marks a viewer that is out of date with content and/or the\n\t// current body size, because the tab wasn't active when that changed —\n\t// either a resize (syncViewerSize) or a (re)load (loadTab, see\n\t// the \"selecting/leaving a job is laggy\" fix below). It is cleared the\n\t// next time the tab becomes active and is caught up in render() via\n\t// ensureCurrentSized.\n\tstale bool\n}\n\n// detailView shows the four job files as scrollable markdown with a tab bar.\ntype detailView struct {\n\tjob    job.Job\n\ttabs   []fileTab\n\tcur    int\n\twidth  int\n\theight int\n\n\t// status, when non-empty, replaces the footer's key hint — used to confirm\n\t// an agent launch or report a launch error.\n\tstatus string\n\n\t// statusUntil is when the current footer status blinks then clears (see\n\t// the App's statusExpireMsg handler). statusBlinkOn toggles the footer's\n\t// *rendered* visibility during the blink window immediately before\n\t// statusUntil; the underlying status text stays set throughout the blink\n\t// (statusVisible decides rendering) so footerLines()/bodyHeight()/\n\t// syncViewerSize() layout budgets stay stable.\n\tstatusUntil   time.Time\n\tstatusBlinkOn bool\n\n\t// spinnerStep is the current activity-indicator frame index (see\n\t// activity.go), threaded in from the App by the spinnerTickMsg handler so\n\t// the action-bar's running badge animates in sync with the list row.\n\t// Defaults to 0 for a freshly built view; the next tick re-syncs it even\n\t// if the App was already mid-animation when the view opened.\n\tspinnerStep int\n\n\t// recentCommits backs the bottom-of-view git-log strip: the last few\n\t// commits on this job's own branch (git.BranchCommits, fetched via\n\t// refreshCommits), the detail view's counterpart of\n\t// listView.recentCommits. nil when the job has no branch, the repo has no\n\t// commits yet, or BranchCommits errors (e.g. a non-repo project) —\n\t// renderCommitStrip degrades to rendering nothing in that case. Populated\n\t// by the App on open and on refresh; a detail view constructed directly\n\t// (as the tests do) simply has no strip.\n\trecentCommits []git.Commit\n\n\t// recentMax is the maximum number of strip entries (the settings'\n\t// RecentActivityCountValue, stored by refreshCommits) that\n\t// commitStripShown clamps to, mirroring listView.recentActivityShown's\n\t// use of its maxRecent parameter.\n\trecentMax int\n\n\t// tigAvailable caches whether tig resolves on the host (launch.\n\t// TigAvailable), queried when the view is constructed and cached for the\n\t// view's lifetime — a new job open re-checks it. It gates both the \"t\"\n\t// key and the footer hint (see renderFooter), the \"if available\" reading\n\t// of the brief; the launch path re-checks availability itself as an\n\t// authoritative backstop. The zero value (unavailable) keeps every\n\t// existing footer test green without stubbing.\n\ttigAvailable bool\n}\n\n// newDetailView loads all four job files, plus the fifth \"log\" tab and the\n// sixth computed \"diff\" tab, for job j at the given viewport size.\nfunc newDetailView(j job.Job, width, height int) *detailView {\n\td := &detailView{job: j, width: width, height: height, tigAvailable: launch.TigAvailable()}\n\tfor _, f := range jobFiles {\n\t\td.tabs = append(d.tabs, fileTab{\n\t\t\tlabel:    f.label,\n\t\t\tpath:     filepath.Join(j.Dir, f.filename),\n\t\t\teditable: f.editable,\n\t\t\tviewer:   markdown.NewViewer(d.bodyWidth(), d.bodyHeight()),\n\t\t})\n\t}\n\td.tabs = append(d.tabs, fileTab{\n\t\tlabel:  \"log\",\n\t\tisLog:  true,\n\t\tviewer: markdown.NewViewer(d.bodyWidth(), d.bodyHeight()),\n\t})\n\t// The diff tab's content is git plain text (log/stat output), not\n\t// markdown: render it verbatim so glamour's paragraph reflow can't merge\n\t// several commits or stat entries onto one rendered line. Strictly\n\t// per-tab — the four job-file tabs and the log tab keep the markdown\n\t// path (the log tab's latent reflow is a known follow-up, out of scope).\n\tdiffTab := fileTab{\n\t\tlabel:  \"diff\",\n\t\tisDiff: true,\n\t\tviewer: markdown.NewViewer(d.bodyWidth(), d.bodyHeight()),\n\t}\n\tdiffTab.viewer.SetRaw(true)\n\td.tabs = append(d.tabs, diffTab)\n\td.loadTabs()\n\treturn d\n}\n\n// jobFileNotWritten is the placeholder markdown shown for a file new-job.sh has\n// not created or an agent has not filled in yet.\n//\n// No \"# <label>\" heading of its own: the detail view's own title+meta chrome\n// line already shows the job title regardless of which tab is showing, so a\n// second heading here would just be the same duplication\n// stripLeadingFrontmatter removes from real file content below.\nfunc filePlaceholder(filename string) string {\n\treturn \"_\" + filename + \" has not been written yet._\"\n}\n\n// loadTabs (re)reads every tab's file from disk. Called on construction and\n// on refresh: agents edit files outside the TUI, so the detail view\n// must re-read to pick up their changes.\n//\n// Only the active tab's viewer is actually re-rendered here; the other three\n// are cheap disk reads whose markdown render is deferred until they become\n// active (see loadTab, ensureCurrentSized). Previously this eagerly rendered\n// all four tabs' markdown — non-trivial cost (glamour.Render is not free) —\n// on every job open and every return to the list, which is what made\n// selecting a job and pressing esc/backspace to leave one feel laggy even\n// after the same problem was fixed for resize-triggered re-renders.\nfunc (d *detailView) loadTabs() {\n\tfor i := range d.tabs {\n\t\td.loadTab(i)\n\t}\n}\n\n// loadTab re-reads one tab's file into t.content. If the tab is\n// currently active, its viewer is rebuilt immediately; otherwise the viewer\n// is left alone and the tab is marked stale so ensureCurrentSized catches it\n// up lazily once it actually becomes active.\n//\n// Every job file is read straight off disk via d.readFile (a job's own\n// worktree — or, for an archived job, the main worktree's archive/ — is\n// unconditionally the live, correct place to read it from, see the job\n// package doc). A missing file falls back to the placeholder.\n//\n// Real content goes through stripLeadingFrontmatter first: every job file's\n// new-job.sh scaffold repeats the title (as its own \"# <Label>: <title>\" H1)\n// and metadata (as a \"key: value\" block) that the detail view's chrome\n// title+meta line already shows — see loadTab's caller-facing doc and the\n// helper's own comment for why only the leading block is ever touched.\nfunc (d *detailView) loadTab(i int) {\n\tt := &d.tabs[i]\n\tif t.isLog {\n\t\tif text, ok := job.ReadJDIRunLogTail(d.job.Root, d.job.Name); ok {\n\t\t\tt.exists = true\n\t\t\tt.content = text\n\t\t\tif t.content == \"\" {\n\t\t\t\tt.content = \"_run.log is empty — mg jdi may still be starting its first invocation._\"\n\t\t\t}\n\t\t} else {\n\t\t\tt.exists = false\n\t\t\tt.content = \"_no mg jdi run has happened for this job yet._\"\n\t\t}\n\t\tif i == d.cur {\n\t\t\tt.viewer.SetContent(t.content)\n\t\t\tt.stale = false\n\t\t} else {\n\t\t\tt.stale = true\n\t\t}\n\t\treturn\n\t}\n\tif t.isDiff {\n\t\td.loadDiff(t)\n\t\tif i == d.cur {\n\t\t\tt.viewer.SetContent(t.content)\n\t\t\tt.stale = false\n\t\t} else {\n\t\t\tt.stale = true\n\t\t}\n\t\treturn\n\t}\n\tdata, ok := d.readFile(t)\n\tif ok {\n\t\tt.exists = true\n\t\tt.content = stripLeadingFrontmatter(string(data))\n\t} else {\n\t\tt.exists = false\n\t\tt.content = filePlaceholder(filepath.Base(t.path))\n\t}\n\tif i == d.cur {\n\t\tt.viewer.SetContent(t.content)\n\t\tt.stale = false\n\t} else {\n\t\tt.stale = true\n\t}\n}\n\n// loadDiff fills the computed \"diff\" tab's content: the quick-eyeball of\n// what the job's branch changed relative to the project's base branch —\n// `git log --oneline <base>...<branch>` followed by\n// `git diff --stat <base>...<branch>` — mirroring `mg diff`'s default output\n// (cmd/mg/diff.go) and its base-branch resolution chain (see\n// diffBaseBranch), so the TUI's diff tab and the CLI's `mg diff` always\n// agree on the range shown.\n//\n// Degrades, never crashes: a job with no branch (the working-tree fallback /\n// non-repo project) and a git error (e.g. the branch deleted out from under\n// the TUI) each set exists=false and a plain-text placeholder; an undiverged\n// branch gets the same \"No changes on <branch> relative to <base>.\" line\n// `mg diff` prints, with exists=true — it is a real, informative result.\nfunc (d *detailView) loadDiff(t *fileTab) {\n\tt.exists = false\n\tif d.job.Branch == \"\" {\n\t\tt.content = \"_this job has no branch to diff (not a git worktree job)._\"\n\t\treturn\n\t}\n\tbase := d.diffBaseBranch()\n\tlogs, err := git.LogOneline(d.job.Root, base, d.job.Branch)\n\tif err != nil {\n\t\tt.content = diffErrorPlaceholder(err)\n\t\treturn\n\t}\n\tfiles, err := git.DiffStat(d.job.Root, base, d.job.Branch)\n\tif err != nil {\n\t\tt.content = diffErrorPlaceholder(err)\n\t\treturn\n\t}\n\tif logs == \"\" && files == \"\" {\n\t\tt.content = fmt.Sprintf(\"No changes on %s relative to %s.\", d.job.Branch, base)\n\t\tt.exists = true\n\t\treturn\n\t}\n\tt.exists = true\n\tt.content = logs + \"\\n\\n\" + files\n}\n\n// diffBaseBranch resolves the base branch the diff tab diffs against,\n// mirroring cmd/mg/diff.go's chain: the project's configured baseBranch\n// (.manigot/manigot.json), falling back to git.SymbolicRefHead\n// (origin/HEAD → \"main\") when unset — deliberately NOT\n// Settings.BaseBranchValue(), which would default to \"main\" and skip the\n// origin/HEAD fallback. The same chain doneConfirmLines uses for its\n// \"Branch : <job> → <base>\" line, so the diff tab and the done confirmation\n// never disagree about what the job will be merged into.\nfunc (d *detailView) diffBaseBranch() string {\n\tsettings, _ := project.Load(d.job.Root)\n\tbase := settings.BaseBranch\n\tif base == \"\" {\n\t\tbase = git.SymbolicRefHead(d.job.Root)\n\t}\n\treturn base\n}\n\n// diffErrorPlaceholder is the plain-text content for the diff tab when git\n// fails to produce the range (e.g. a branch deleted out from under the TUI):\n// the error's message, dimmed so it reads as a degrade, not a crash.\nfunc diffErrorPlaceholder(err error) string {\n\treturn \"_could not compute the diff: \" + err.Error() + \"_\"\n}\n\n// stripLeadingFrontmatter removes the leading H1 + \"key: value\" frontmatter\n// block every job file's new-job.sh scaffold begins with, so glamour doesn't\n// render a second title/metadata block duplicating what the detail view's\n// own chrome (title+meta line) already shows — app chrome owns identity.\n//\n// Only the leading, contiguous run bounded by the first blank line is ever\n// touched: the first line if it's an H1 (\"# \"), an optional single blank\n// line right after it, then a run of \"key: value\" lines, stopping at the\n// first blank line found in that run. Real body content past that point is\n// never scanned — a line like \"TASK-1: description\" inside \"## Task\n// breakdown\" is well past the block's terminating blank line by the time any\n// real content is reached, so stripping never reaches it even though it is\n// syntactically colon-shaped too.\n//\n// A file that doesn't start with an H1, or whose line right after the H1\n// (and optional blank) isn't itself a \"key: value\" line, doesn't match the\n// scaffold shape at all and is returned unchanged rather than guessed at.\nfunc stripLeadingFrontmatter(content string) string {\n\tlines := strings.Split(content, \"\\n\")\n\tif len(lines) == 0 || !strings.HasPrefix(lines[0], \"# \") {\n\t\treturn content\n\t}\n\ti := 1\n\tif i < len(lines) && strings.TrimSpace(lines[i]) == \"\" {\n\t\ti++\n\t}\n\tstart := i\n\tfor i < len(lines) && strings.TrimSpace(lines[i]) != \"\" {\n\t\tif !isFrontmatterLine(lines[i]) {\n\t\t\t// Not the scaffold shape (e.g. the H1 is directly followed by\n\t\t\t// prose, no frontmatter at all) — leave the whole file alone.\n\t\t\treturn content\n\t\t}\n\t\ti++\n\t}\n\tif i == start {\n\t\t// H1 with nothing (not even a blank line) after it.\n\t\treturn content\n\t}\n\t// Skip the blank line terminating the frontmatter block, if present.\n\tif i < len(lines) && strings.TrimSpace(lines[i]) == \"\" {\n\t\ti++\n\t}\n\treturn strings.Join(lines[i:], \"\\n\")\n}\n\n// isFrontmatterLine reports whether a line matches the \"key: value\" shape\n// new-job.sh's scaffold frontmatter uses: a bare key with no leading\n// whitespace and no spaces before its colon (e.g. \"status: open\",\n// \"developer:\"). Deliberately narrow so it only ever matches inside the\n// leading contiguous block stripLeadingFrontmatter bounds by the first blank\n// line — real prose elsewhere in the document is never passed to this.\nfunc isFrontmatterLine(line string) bool {\n\tif line == \"\" || line[0] == ' ' || line[0] == '\\t' {\n\t\treturn false\n\t}\n\tidx := strings.Index(line, \":\")\n\tif idx <= 0 {\n\t\treturn false\n\t}\n\treturn !strings.ContainsAny(line[:idx], \" \\t\")\n}\n\n// readFile reads one tab's file bytes straight off disk from t.path — a\n// job's own worktree (or the main worktree's archive/) is unconditionally\n// the live, correct place to read its four files from (see the job package\n// doc), so there is no branch check and no git-show fallback. ok is false\n// when the file isn't available at that path (missing).\nfunc (d *detailView) readFile(t *fileTab) (data []byte, ok bool) {\n\tb, err := os.ReadFile(t.path)\n\tif err != nil {\n\t\treturn nil, false\n\t}\n\treturn b, true\n}\n\n// reload re-reads all four files (used by App.refresh).\nfunc (d *detailView) reload() { d.loadTabs() }\n\n// runLogExists reports whether a run.log sidecar exists for this job — the\n// gate for both the \"l\" tail key (app.go's updateDetail) and its footer hint\n// (renderFooter), the same condition under which the log tab shows real\n// content (job.ReadJDIRunLogTail). A simple existence check, not a liveness\n// check: `tail -f` idles harmlessly once a run ends, so the pane is\n// reachable for any job mg-jdi has ever driven.\nfunc (d *detailView) runLogExists() bool {\n\t_, err := os.Stat(job.JDIRunLogPath(d.job.Root, d.job.Name))\n\treturn err == nil\n}\n\n// reloadCurrent re-reads just the active tab's file — used after the \"e\"\n// edit shortcut returns, so a file that didn't exist before (and was shown\n// as a placeholder) flips over to its real content once the editor creates\n// it on save.\nfunc (d *detailView) reloadCurrent() { d.loadTab(d.cur) }\n\n// refreshCommits re-reads the job-branch git-log strip from git (git.\n// BranchCommits against d.job.Root, d.job.Branch — the branch ref is shared\n// across the whole repo, so the main worktree's root resolves it fine),\n// always fetching up to maxRecent (Settings.RecentActivityCountValue). How\n// many of those cached commits actually get rendered is decided later, at\n// render time, by commitStripShown — the same split the list view uses\n// between refreshRecentCommits and recentActivityShown, so a view that never\n// received a WindowSizeMsg isn't sized against a stale terminal height.\n//\n// Like the list view's strip fetch, an error (e.g. a non-repo project) or an\n// empty job branch degrades to an empty strip rather than surfacing in the\n// status line — this is decorative, optional content, not an action the user\n// asked for.\nfunc (d *detailView) refreshCommits(maxRecent int) {\n\td.recentMax = maxRecent\n\tif d.job.Branch == \"\" {\n\t\td.recentCommits = nil\n\t\td.syncViewerSize()\n\t\treturn\n\t}\n\tcommits, err := git.BranchCommits(d.job.Root, d.job.Branch, maxRecent)\n\tif err != nil {\n\t\td.recentCommits = nil\n\t\td.syncViewerSize()\n\t\treturn\n\t}\n\td.recentCommits = commits\n\t// The strip's footprint may have changed (appeared, disappeared, or\n\t// grown), which changes how many chrome rows the total render needs —\n\t// resize the active viewer and mark the others stale so the body shrinks\n\t// and the total still fits the viewport, mirroring setStatus's own\n\t// budget handling. refreshCommits runs right after newDetailView (whose\n\t// viewers were sized with no strip yet), so without this the strip would\n\t// overflow the alt-screen on open.\n\td.syncViewerSize()\n}\n\n// resize propagates a window-size change to every viewer (a width change means\n// the markdown must be re-wrapped).\nfunc (d *detailView) resize(width, height int) {\n\tif width == d.width && height == d.height {\n\t\treturn\n\t}\n\td.width, d.height = width, height\n\td.syncViewerSize()\n}\n\n// setStatus sets the footer status line, arms its blink-then-expire deadline\n// (mirroring App.setStatus for the list footer — see statusExpireMsg), and,\n// since a multi-line status (e.g. cmdErrorText's resolution diagnosis)\n// changes how many chrome rows the footer needs, resizes the viewers so the\n// total rendered height still fits the terminal — otherwise the alt-screen\n// viewport clips the bottom of the status instead of shrinking the body.\nfunc (d *detailView) setStatus(s string) {\n\td.status = s\n\tif s == \"\" {\n\t\td.statusBlinkOn = false\n\t\td.statusUntil = time.Time{}\n\t} else {\n\t\td.statusBlinkOn = false\n\t\td.statusUntil = statusNow().Add(statusLifetime)\n\t}\n\td.syncViewerSize()\n}\n\n// syncViewerSize resizes the active tab's viewer to the current body\n// dimensions immediately, and marks the other three as stale instead of\n// eagerly re-rendering them too.\n//\n// Re-rendering all four tabs' markdown here was a major source of the\n// reported input lag: this is called from setStatus, which itself fires on\n// nearly every keypress in the detail view (including every agent launch\n// attempt), so every keypress was paying for three re-renders that weren't\n// even visible. Deferred tabs catch up lazily in render() the next time\n// they actually become the active one.\nfunc (d *detailView) syncViewerSize() {\n\tw, h := d.bodyWidth(), d.bodyHeight()\n\tfor i := range d.tabs {\n\t\tif i == d.cur {\n\t\t\td.tabs[i].viewer.Resize(w, h)\n\t\t\td.tabs[i].stale = false\n\t\t} else {\n\t\t\td.tabs[i].stale = true\n\t\t}\n\t}\n}\n\n// ensureCurrentSized brings the active tab's viewer up to date if it was left\n// stale — by a resize that happened while a different tab was showing (see\n// syncViewerSize), or by a (re)load that only updated t.content because the\n// tab wasn't active at the time (see loadTab). Called from render() so a tab\n// is always correctly rendered by the time it is actually drawn.\n//\n// This always goes through SetSize+SetContent rather than the guarded\n// Resize: Resize is a no-op when the width/height haven't changed, which is\n// exactly the common case here (content changed, size didn't) — using it\n// would leave a content-stale tab showing its old rendered text.\nfunc (d *detailView) ensureCurrentSized() {\n\tt := &d.tabs[d.cur]\n\tif !t.stale {\n\t\treturn\n\t}\n\tt.viewer.SetSize(d.bodyWidth(), d.bodyHeight())\n\tt.viewer.SetContent(t.content)\n\tt.stale = false\n}\n\n// update handles detail-view keys: file switching and scrolling.\nfunc (d *detailView) update(msg tea.KeyMsg) {\n\tswitch msg.String() {\n\tcase \"tab\", \"right\":\n\t\tif d.cur < len(d.tabs)-1 {\n\t\t\td.cur++\n\t\t}\n\tcase \"shift+tab\", \"left\":\n\t\tif d.cur > 0 {\n\t\t\td.cur--\n\t\t}\n\tcase \"1\":\n\t\td.cur = 0\n\tcase \"2\":\n\t\td.cur = 1\n\tcase \"3\":\n\t\td.cur = 2\n\tcase \"4\":\n\t\td.cur = 3\n\tcase \"5\":\n\t\td.cur = 4\n\tcase \"6\":\n\t\td.cur = 5\n\tdefault:\n\t\td.active().scroll(msg)\n\t}\n}\n\n// current returns the active tab.\nfunc (d *detailView) current() *fileTab { return &d.tabs[d.cur] }\n\n// active is an alias for current used by update; kept for readability at the\n// call site where we mean \"the tab the scroll key applies to\".\nfunc (d *detailView) active() *fileTab { return d.current() }\n\n// scroll routes scroll keys to the active viewer.\nfunc (t *fileTab) scroll(msg tea.KeyMsg) {\n\tswitch msg.String() {\n\tcase \"down\":\n\t\tt.viewer.ScrollDown(1)\n\tcase \"up\":\n\t\tt.viewer.ScrollUp(1)\n\tcase \"pgdown\", \" \":\n\t\tt.viewer.PageDown()\n\tcase \"pgup\":\n\t\tt.viewer.PageUp()\n\t// \"g\" is deliberately not bound here anymore: the detail view's App-level\n\t// \"g\" key opens the git panel (see app.go's updateDetail), so the viewer\n\t// scroll-to-top stays reachable via \"home\" only.\n\tcase \"home\":\n\t\tt.viewer.Top()\n\tcase \"G\", \"end\":\n\t\tt.viewer.Bottom()\n\t}\n}\n\n// bodyGutter is the width of the vertical rule + gap rendered to the left of\n// the doc body (see renderBody) — reserved out of bodyWidth so the\n// rule-prefixed lines still fit within d.width.\nconst bodyGutter = 2\n\n// bodyWidth / bodyHeight compute the markdown viewport given the chrome the\n// detail view draws around it (title, tab bar, footer, and the left-hand\n// vertical rule).\nfunc (d *detailView) bodyWidth() int {\n\tw := d.width - 2 - bodyGutter // small right margin + left rule/gap\n\tif w < 1 {\n\t\tw = 1\n\t}\n\treturn w\n}\n\nfunc (d *detailView) bodyHeight() int {\n\t// title(1) + blank(1) + tab bar(1) + agents line(1) + stage/done line(1) + blank(1) + body + blank(1) + footer(footerLines)\n\t// = (7 + footerLines) chrome rows around the body, plus the bottom\n\t// git-log strip's own footprint (1 spacer + its commit rows, see\n\t// commitStripRows) — the body shrinks so the total render still fits the\n\t// alt-screen viewport, the same budget discipline\n\t// TestDetailBodyHeightShrinksForMultiLineStatus guards for the footer.\n\th := d.height - 7 - d.footerLines() - d.commitStripRows()\n\tif h < 1 {\n\t\th = 1\n\t}\n\treturn h\n}\n\n// renderBody prefixes the active viewer's rendered lines with a dim vertical\n// rule, so the doc content — already indented by glamour's own document\n// margin — reads as a distinct panel rather than chrome-level text.\nfunc (d *detailView) renderBody() string {\n\tbody := d.current().viewer.View()\n\tif body == \"\" {\n\t\treturn body\n\t}\n\trule := dimStyle.Render(\"│\") + \" \"\n\tlines := strings.Split(body, \"\\n\")\n\tfor i, l := range lines {\n\t\tlines[i] = rule + l\n\t}\n\treturn strings.Join(lines, \"\\n\")\n}\n\n// footerLines returns how many rows renderFooter will occupy. Normally the\n// footer is a single line (the scroll position / key hint, or a short status\n// message), but cmdErrorText (app.go) can return a multi-line resolution\n// diagnosis for a failed agent launch — bodyHeight must account for that so\n// the total rendered height still fits the fixed alt-screen viewport, instead\n// of pushing the last line(s) of the footer (the \"fix:\" hint) off screen.\nfunc (d *detailView) footerLines() int {\n\tif d.status == \"\" {\n\t\treturn 1\n\t}\n\treturn strings.Count(d.status, \"\\n\") + 1\n}\n\n// commitStripShown returns how many of d.recentCommits the bottom git-log\n// strip should actually render, mirroring listView.recentActivityShown's\n// adaptive sizing: between recentActivityFloor and the configured maximum\n// (d.recentMax, stored by refreshCommits), clamped to the spare vertical room\n// and the available commits. 0 when the cache is empty — no strip at all.\n//\n// The spare-room formula is the detail view's analogue of the list's\n// `height - dashboardFixedChrome - jobCount`: the fixed chrome (7 rows +\n// footerLines) is what the list's dashboardFixedChrome is; the body's own\n// 1-row floor stands in for the job rows (the body is scrollable but must\n// never be squeezed out entirely); and the strip's own 1-row spacer is\n// accounted for so the body budget and the rendered output agree.\n//\n// height == 0 (a view that has never received a tea.WindowSizeMsg, e.g.\n// some existing tests) falls back to the floor, the same kind of guard the\n// list view applies.\nfunc (d *detailView) commitStripShown() int {\n\tif len(d.recentCommits) == 0 {\n\t\treturn 0\n\t}\n\tvar n int\n\tif d.height == 0 {\n\t\tn = recentActivityFloor\n\t} else {\n\t\tspare := d.height - 7 - d.footerLines() - 1 - 1 // body floor + strip spacer\n\t\tn = clamp(spare, recentActivityFloor, d.recentMax)\n\t}\n\tif n > len(d.recentCommits) {\n\t\t// Fewer real commits than the computed count — render whatever's\n\t\t// available, same graceful-degrade rule the list view applies.\n\t\tn = len(d.recentCommits)\n\t}\n\treturn n\n}\n\n// commitStripRows is the strip's total vertical footprint below the footer:\n// its 1-row blank spacer plus one row per commit line it renders (0 when\n// nothing renders). bodyHeight subtracts this from the viewport so the body\n// shrinks and the total render still fits — the detail view's analogue of\n// the list's dashboardFixedChrome strip-spacer row.\nfunc (d *detailView) commitStripRows() int {\n\tif n := d.commitStripShown(); n > 0 {\n\t\treturn 1 + n\n\t}\n\treturn 0\n}\n\n// render draws the detail view.\nfunc (d *detailView) render() string {\n\tw := d.width\n\tif w == 0 {\n\t\tw = 72\n\t}\n\n\td.ensureCurrentSized()\n\n\tvar b strings.Builder\n\n\t// Title + meta line.\n\tb.WriteString(titleStyle.Render(d.job.Title))\n\tmeta := fmt.Sprintf(\"  #%s · %s · %s · %s\", d.job.ID, d.job.Status, d.job.Type, d.job.Date)\n\tb.WriteString(dimStyle.Render(meta))\n\t// Branch: show which branch the job's own worktree is checked out to.\n\t// Purely informational — every job has its own worktree, so there is no\n\t// \"wrong branch checked out\" state to warn about anymore.\n\tif d.job.Branch != \"\" {\n\t\tb.WriteString(dimStyle.Render(\" · branch: \" + d.job.Branch))\n\t}\n\tb.WriteString(\"\\n\\n\")\n\n\t// Tab bar (\"docs:\" line).\n\tb.WriteString(d.renderTabs(w))\n\tb.WriteString(\"\\n\")\n\n\t// Agent action bar: an \"agents:\" line, then the stage timeline plus the\n\t// Done button on its own line beneath.\n\tb.WriteString(d.renderActionBar())\n\tb.WriteString(\"\\n\\n\")\n\n\t// Body: the active viewer, set off from the chrome by a left rule.\n\tb.WriteString(d.renderBody())\n\tb.WriteString(\"\\n\\n\")\n\n\t// Footer: scroll position + keys.\n\tb.WriteString(d.renderFooter())\n\n\t// Job-branch git-log strip: below the footer, mirroring the list view's\n\t// recent-activity strip position — read-only supplementary info, kept out\n\t// of the way of the job files and the chrome (see renderCommitStrip).\n\tb.WriteString(d.renderCommitStrip(w))\n\n\treturn b.String()\n}\n\n// actionButton is one entry in the agents line: an agent-launch button,\n// rendered \"[key] Label\" — see renderActionBar's doc comment.\ntype actionButton struct {\n\tkey, label string\n}\n\n// renderActionBar draws the two-line action bar: an \"agents:\" line listing\n// the five agents in agentOrder (always shown regardless of the job's\n// stage — app.go's agentForKey is not stage-gated either), each in a\n// consistent \"[key] Label\" format; then, on its own line beneath, a \"stage:\"\n// label (mirroring \"docs:\" and \"agents:\") followed by the stage timeline\n// (see renderStageTimeline) alongside the \"[D] Done\" mark-done button and\n// \"[j] mg-jdi\" — a bigger, composite action like Done, not a\n// single-agent launch, hence its own key rather than living in agentOrder.\n//\n// The stage timeline stays purely informational: an at-a-glance sense of\n// where the job's files say it is in the ideal workflow, and how far it has\n// come. It no longer restricts which buttons appear (launching any agent is\n// not gated by stage). Done keeps its own colour (statusDoneStyle, the same\n// green used for \"done\" status elsewhere) to flag that it's categorically\n// different from the five launch actions — it archives the job via mg-done\n// rather than starting a session.\n//\n// Narrow-width handling: this is designed against an 80-column baseline, and\n// there isn't room there for five full \"[key] Label\" agent buttons —\n// \"Developer\" alone is 9 characters. Once the full-label agents line\n// would overflow d.width, every button's *label* — never its key, which must\n// always stay reachable/visible — is truncated to share whatever room\n// remains, using the same \"…\" convention truncate() (app.go) already applies\n// to job titles. Wrapping to a further line was the brief's other offered\n// option; truncation was chosen instead because it would add a row the fixed\n// chrome-row budget in bodyHeight doesn't account for (it assumes a\n// two-line action bar) — the same kind of alt-screen-clipping risk\n// TestDetailBodyHeightShrinksForMultiLineStatus guards against for the\n// footer, without that guard existing here.\nfunc (d *detailView) renderActionBar() string {\n\tbuttons := make([]actionButton, 0, len(agentOrder))\n\tfor _, a := range agentOrder {\n\t\tm, ok := agentMeta[a]\n\t\tif !ok {\n\t\t\t// Unknown agent name — render it literally without a bound key.\n\t\t\tbuttons = append(buttons, actionButton{key: \"?\", label: a})\n\t\t\tcontinue\n\t\t}\n\t\tbuttons = append(buttons, actionButton{key: m.key, label: m.display})\n\t}\n\n\tw := d.width\n\tif w == 0 {\n\t\tw = 72\n\t}\n\tconst sep = \"  \"\n\tconst agentsLabel = \"agents:\"\n\n\t// Fixed cost: the \"agents:\" label, every button's \"[key] \" prefix, and\n\t// the separators between all elements — everything but the label text,\n\t// which is the only part allowed to shrink.\n\tfixed := len(agentsLabel)\n\tfor _, btn := range buttons {\n\t\tfixed += len(sep) + len(\"[\"+btn.key+\"] \")\n\t}\n\tlabelBudget := w - fixed\n\tperLabel := 0\n\tif len(buttons) > 0 {\n\t\tperLabel = labelBudget / len(buttons)\n\t}\n\n\tvar agentsLine strings.Builder\n\tagentsLine.WriteString(dimStyle.Render(agentsLabel))\n\tfor _, btn := range buttons {\n\t\tlabel := btn.label\n\t\tif perLabel < len(label) {\n\t\t\tlabel = truncateToWidth(label, perLabel)\n\t\t}\n\t\tagentsLine.WriteString(sep)\n\t\tagentsLine.WriteString(accentStyle.Render(\"[\" + btn.key + \"]\"))\n\t\tif label != \"\" {\n\t\t\tagentsLine.WriteString(\" \")\n\t\t\tagentsLine.WriteString(label)\n\t\t}\n\t}\n\n\tvar stageLine strings.Builder\n\tstageLine.WriteString(dimStyle.Render(\"stage:\"))\n\tstageLine.WriteString(sep)\n\tstageLine.WriteString(renderStageTimeline(d.job.Stage()))\n\tstageLine.WriteString(sep)\n\tstageLine.WriteString(statusDoneStyle.Render(\"[D]\"))\n\tstageLine.WriteString(\" \")\n\tstageLine.WriteString(statusDoneStyle.Render(\"Done\"))\n\tstageLine.WriteString(sep)\n\tstageLine.WriteString(accentStyle.Render(\"[j]\"))\n\tstageLine.WriteString(\" \")\n\tstageLine.WriteString(accentStyle.Render(\"just do it\"))\n\t// A live running/stopped indicator right next to the button that starts\n\t// it: reuses the same job.ReadJDIStatus-backed jdiStatusBadge formatting\n\t// the job-list row already renders, so a user sitting in the detail view\n\t// — exactly where \"j\" is pressed, and where the already-running block\n\t// message appears — can see at a glance whether mg-jdi is still going,\n\t// not only from the list. The\n\t// running variant's animated frame comes from d.spinnerStep, threaded in\n\t// by the App's spinnerTickMsg handler, so it animates in sync with the\n\t// list row while a run is active. Like the list badge, the underlying\n\t// status has no polling timer of its own: it reads the sidecar fresh on\n\t// every render() call, so it updates whenever Bubble Tea next re-renders\n\t// (the spinner tick, or any keypress).\n\tif badge := jdiStatusBadge(d.job.Root, d.job, d.spinnerStep); badge != \"\" {\n\t\tstageLine.WriteString(sep)\n\t\tstageLine.WriteString(badge)\n\t}\n\n\treturn agentsLine.String() + \"\\n\" + stageLine.String()\n}\n\n// renderStageTimeline renders every job.Stages entry as a compact horizontal\n// timeline: a checked, done-coloured marker for every stage behind the\n// current one, a highlighted marker for the current stage, and a dim, hollow\n// marker for stages still ahead. Replaces the old bare \"stage: <name>\" label\n// with an at-a-glance sense of how far along the job actually is — including\n// a verdict that bounced the job back to implement showing review/finished\n// as still ahead, not behind, since job.Stage() already encodes that.\nfunc renderStageTimeline(current job.Stage) string {\n\tidx := -1\n\tfor i, s := range job.Stages {\n\t\tif s == current {\n\t\t\tidx = i\n\t\t\tbreak\n\t\t}\n\t}\n\tparts := make([]string, len(job.Stages))\n\tfor i, s := range job.Stages {\n\t\tlabel := string(s)\n\t\tswitch {\n\t\tcase idx >= 0 && i < idx:\n\t\t\tparts[i] = statusDoneStyle.Render(\"✓ \" + label)\n\t\tcase i == idx:\n\t\t\tparts[i] = accentStyle.Render(\"● \" + label)\n\t\tdefault:\n\t\t\tparts[i] = dimStyle.Render(\"○ \" + label)\n\t\t}\n\t}\n\treturn strings.Join(parts, dimStyle.Render(\" → \"))\n}\n\n// truncateToWidth is truncate() (app.go) with a floor of 0 instead of\n// truncate's own \"n <= 0 leaves s unchanged\" behaviour: the action bar's\n// narrow-width handling can legitimately compute a zero or negative label\n// budget (six buttons is a lot to fit at 80 columns), in which case the\n// label should disappear entirely — leaving only the reachable \"[key]\" — not\n// render at full length as truncate(s, 0) would.\nfunc truncateToWidth(s string, n int) string {\n\tif n <= 0 {\n\t\treturn \"\"\n\t}\n\treturn truncate(s, n)\n}\n\n// renderTabs draws \"docs: [brief] tasks implementation verdict\" with the\n// active tab highlighted and not-yet-written files dimmed.\nfunc (d *detailView) renderTabs(width int) string {\n\tparts := make([]string, len(d.tabs))\n\tfor i, t := range d.tabs {\n\t\tlabel := t.label\n\t\tif !t.exists {\n\t\t\tlabel = \"(\" + t.label + \")\"\n\t\t}\n\t\tif i == d.cur {\n\t\t\tparts[i] = lipgloss.NewStyle().Bold(true).\n\t\t\t\tBackground(accent).Foreground(lipgloss.Color(\"#ffffff\")).\n\t\t\t\tRender(\" \" + label + \" \")\n\t\t} else if !t.exists {\n\t\t\tparts[i] = dimStyle.Render(label)\n\t\t} else {\n\t\t\tparts[i] = label\n\t\t}\n\t}\n\tbar := strings.Join(parts, \"  \")\n\treturn dimStyle.Render(\"docs:\") + \"  \" + bar\n}\n\n// renderFooter draws the scroll position, key hint, and (when set and\n// currently visible — see statusVisible/the blink window this footer shares\n// with the list footer) the status message — a status must coexist with the\n// hint, not replace it, so a user who just pressed \"ctrl+r\" or launched an\n// agent still knows what keys exist.\n//\n// The one exception is a multi-line status (cmdErrorText's resolution\n// diagnosis for a failed host-command lookup — see footerLines): that's a\n// distinct, already-tested diagnostic case, not the \"lost the legend\" problem\n// this coexistence handles, and appending the (fairly long) hint to it risks\n// overflowing narrow terminals on top of an already multi-line block. It\n// keeps replacing the hint entirely, same as before.\n//\n// During a blink-off toggle the status text itself stays set (so\n// footerLines()/bodyHeight() layout never jitters — see setStatus) but is\n// rendered as blank space of the same line count instead, exactly mirroring\n// how listFooter hides (not shrinks) a blinked-off list status.\nfunc (d *detailView) renderFooter() string {\n\tpos := d.current().viewer.Position()\n\thint := \"tab/1-6 files\"\n\tif d.current().editable {\n\t\t// \"e\" only does anything on editable tabs (brief.md today), so the\n\t\t// hint is scoped to when it would actually work.\n\t\thint += \" · e edit\"\n\t}\n\tif d.tigAvailable && d.job.Branch != \"\" {\n\t\t// \"t\" opens tig on the job's branch diff — only reachable when tig\n\t\t// is installed on the host AND the job has a branch to browse (the\n\t\t// same availability gate the key itself checks, see app.go).\n\t\thint += \" · t tig\"\n\t}\n\tif d.runLogExists() {\n\t\t// \"l\" tails the job's mg-jdi run.log in a spawned pane — reachable\n\t\t// whenever a run.log exists for this job (the same gate the key\n\t\t// itself checks, see app.go), regardless of branch or tig.\n\t\thint += \" · l tail\"\n\t}\n\thint += \" · g git · x/del remove job · ctrl+r refresh · esc back · q quit\"\n\n\tif d.status != \"\" {\n\t\tvisible := statusVisible(d.status, d.statusUntil, d.statusBlinkOn, statusNow())\n\t\tif strings.Contains(d.status, \"\\n\") {\n\t\t\tif !visible {\n\t\t\t\treturn strings.Repeat(\"\\n\", strings.Count(d.status, \"\\n\"))\n\t\t\t}\n\t\t\treturn statusStyle.Render(d.status)\n\t\t}\n\t\tif !visible {\n\t\t\treturn dimStyle.Render(fmt.Sprintf(\"%s   %s\", pos, hint))\n\t\t}\n\t\treturn dimStyle.Render(fmt.Sprintf(\"%s   %s\", pos, hint)) + \"  \" + statusStyle.Render(d.status)\n\t}\n\treturn dimStyle.Render(fmt.Sprintf(\"%s   %s\", pos, hint))\n}\n\n// renderCommitStrip renders the job-branch git-log strip below the footer —\n// the detail view's counterpart of the list view's recent-activity strip,\n// scoped to just this job's own branch (d.recentCommits, fed by\n// refreshCommits). It reuses the same renderActivityLines formatter, so the\n// visuals are byte-for-byte identical to the list's (the branch column\n// included — \"same visuals\" per the brief, even though it is redundant when\n// every line belongs to one branch). The blank spacer line before the first\n// commit line is part of the strip's footprint, which bodyHeight's\n// commitStripRows already budgets for.\n//\n// Renders nothing — not even the spacer — when the cache is empty (a\n// non-repo project, a job with no branch, or a job branch with no commits\n// yet): the strip is optional supplementary content, same as the list view's.\nfunc (d *detailView) renderCommitStrip(w int) string {\n\tn := d.commitStripShown()\n\tif n == 0 {\n\t\treturn \"\"\n\t}\n\treturn \"\\n\\n\" + renderActivityLines(d.recentCommits[:n], w)\n}","lineStart":1,"lineEnd":978,"totalLines":978,"truncated":false}},"title":"src/internal/ui/detail.go","time":{"start":1787919590624,"end":1787919590634}},"id":"prt_0484fe467001a0f2cnWQun4xbT","sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","messageID":"msg_0484fd40a0016UBwjYzsjWFJBe"}}
{"type":"tool_use","timestamp":1787919590828,"sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","part":{"type":"tool","tool":"read","callID":"call_01_nir6PHI7DTlt6FhpJPlV7697","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/ui/tail_test.go"},"output":"<path>/workspace/src/internal/ui/tail_test.go</path>\n<type>file</type>\n<content>\n1: package ui\n2: \n3: import (\n4: \t\"os\"\n5: \t\"strings\"\n6: \t\"testing\"\n7: \n8: \t\"github.com/lmuskalla/manigot/internal/job\"\n9: )\n10: \n11: // --- footer hint (TASK-4) ----------------------------------------------------\n12: \n13: // TestDetailFooterTailHintShownWhenRunLogExists: the \"· l tail\" hint renders\n14: // only when a run.log exists for this job — the file-exists gate from the\n15: // analysis, mirroring the conditional \"e edit\" and \"t tig\" hints.\n16: func TestDetailFooterTailHintShownWhenRunLogExists(t *testing.T) {\n17: \troot := t.TempDir()\n18: \tj := discoverOneJob(t, root, \"aaaa08_t\")\n19: \n20: \t// No run.log yet: no hint.\n21: \td := newDetailView(j, 80, 24)\n22: \tif strings.Contains(d.renderFooter(), \"l tail\") {\n23: \t\tt.Errorf(\"footer shows the tail hint with no run.log:\\n%s\", d.renderFooter())\n24: \t}\n25: \n26: \t// A run.log appears (mg jdi drove the job): the hint shows.\n27: \tif err := os.MkdirAll(job.JDIStatusDir(root, j.Name), 0o755); err != nil {\n28: \t\tt.Fatal(err)\n29: \t}\n30: \tif err := os.WriteFile(job.JDIRunLogPath(root, j.Name), []byte(\"=== mg jdi started ===\\n\"), 0o644); err != nil {\n31: \t\tt.Fatal(err)\n32: \t}\n33: \td2 := newDetailView(j, 80, 24)\n34: \tif !strings.Contains(d2.renderFooter(), \"l tail\") {\n35: \t\tt.Errorf(\"footer missing the tail hint when a run.log exists:\\n%s\", d2.renderFooter())\n36: \t}\n37: }\n38: \n39: // --- \"l\" key gate ------------------------------------------------------------\n40: \n41: // TestTailKeyReportsNoRunLogAndLaunchesNothing: with no run.log, \"l\" must\n42: // report the gate and never reach the launch path at all — the tmux stub call\n43: // log stays completely empty (not even list-panes, which the launch path's\n44: // replace policy runs first), mirroring TestTigKeyReportsNotInstalledAndLaunchesNothing's\n45: // assertion that a gated-off launch never spawns anything.\n46: func TestTailKeyReportsNoRunLogAndLaunchesNothing(t *testing.T) {\n47: \troot := t.TempDir()\n48: \tj := discoverOneJob(t, root, \"aaaa09_g\")\n49: \n50: \tlogPath := writeTmuxStub(t)\n51: \n52: \ta := NewApp(root, []job.Job{j})\n53: \ta.width, a.height = 80, 24\n54: \ta.detail = newDetailView(j, 80, 24)\n55: \ta.state = stateDetail\n56: \n57: \ta.updateDetail(keyMsg(\"l\"))\n58: \tif !strings.Contains(a.detail.status, \"no mg jdi run has happened for this job yet\") {\n59: \t\tt.Errorf(\"status = %q, want it to explain no run.log exists yet\", a.detail.status)\n60: \t}\n61: \t// The stub's call log only exists once the stub has been invoked at all —\n62: \t// a never-reached launch path leaves no file behind, which is exactly the\n63: \t// empty log this assertion means.\n64: \tcalls, err := os.ReadFile(logPath)\n65: \tif err != nil && !os.IsNotExist(err) {\n66: \t\tt.Fatalf(\"tmux stub call log not readable: %v\", err)\n67: \t}\n68: \tif len(calls) != 0 {\n69: \t\tt.Errorf(\"launch path reached despite the gate — tmux stub was invoked:\\n%s\", calls)\n70: \t}\n71: }\n72: \n73: // --- \"l\" success path (tails run.log in a tmux pane) -------------------------\n74: \n75: // TestTailKeyLaunchesTailInTmuxPane exercises the full \"l\" flow with a real\n76: // run.log sidecar and a stubbed tmux on PATH + $TMUX: the split-window\n77: // invocation must carry the `tail -f '<path>'` inner command (routed through\n78: // launch.Tail → launchDetached's tmux path, exactly like tig/agent launches),\n79: // the pane must be tagged, and the status reports where it opened.\n80: func TestTailKeyLaunchesTailInTmuxPane(t *testing.T) {\n81: \troot := t.TempDir()\n82: \tj := discoverOneJob(t, root, \"aaaa10_t\")\n83: \n84: \tif err := os.MkdirAll(job.JDIStatusDir(root, j.Name), 0o755); err != nil {\n85: \t\tt.Fatal(err)\n86: \t}\n87: \trunLog := job.JDIRunLogPath(root, j.Name)\n88: \tif err := os.WriteFile(runLog, []byte(\"=== mg jdi started ===\\n\"), 0o644); err != nil {\n89: \t\tt.Fatal(err)\n90: \t}\n91: \n92: \tlogPath := writeTmuxStub(t)\n93: \n94: \ta := NewApp(root, []job.Job{j})\n95: \ta.width, a.height = 80, 24\n96: \ta.detail = newDetailView(j, 80, 24)\n97: \ta.state = stateDetail\n98: \n99: \ta.updateDetail(keyMsg(\"l\"))\n100: \tif !strings.Contains(a.detail.status, \"→ tailing run.log in tmux pane\") {\n101: \t\tt.Errorf(\"status = %q, want it to report the tail launch in a tmux pane\", a.detail.status)\n102: \t}\n103: \tcalls, err := os.ReadFile(logPath)\n104: \tif err != nil {\n105: \t\tt.Fatalf(\"tmux stub call log not written: %v\", err)\n106: \t}\n107: \tif !strings.Contains(string(calls), \"tail -f '\"+runLog+\"'\") {\n108: \t\tt.Errorf(\"tmux split-window not invoked with the tail inner command:\\n%s\", calls)\n109: \t}\n110: \tif !strings.Contains(string(calls), \"select-pane -t %100 -T manigot\") {\n111: \t\tt.Errorf(\"select-pane tagging of the new pane missing:\\n%s\", calls)\n112: \t}\n113: }\n\n(End of file - total 113 lines)\n</content>","metadata":{"preview":"package ui\n\nimport (\n\t\"os\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// --- footer hint (TASK-4) ----------------------------------------------------\n\n// TestDetailFooterTailHintShownWhenRunLogExists: the \"· l tail\" hint renders\n// only when a run.log exists for this job — the file-exists gate from the\n// analysis, mirroring the conditional \"e edit\" and \"t tig\" hints.\nfunc TestDetailFooterTailHintShownWhenRunLogExists(t *testing.T) {\n\troot := t.TempDir()\n\tj := discoverOneJob(t, root, \"aaaa08_t\")\n\n\t// No run.log yet: no hint.","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/ui/tail_test.go","text":"package ui\n\nimport (\n\t\"os\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// --- footer hint (TASK-4) ----------------------------------------------------\n\n// TestDetailFooterTailHintShownWhenRunLogExists: the \"· l tail\" hint renders\n// only when a run.log exists for this job — the file-exists gate from the\n// analysis, mirroring the conditional \"e edit\" and \"t tig\" hints.\nfunc TestDetailFooterTailHintShownWhenRunLogExists(t *testing.T) {\n\troot := t.TempDir()\n\tj := discoverOneJob(t, root, \"aaaa08_t\")\n\n\t// No run.log yet: no hint.\n\td := newDetailView(j, 80, 24)\n\tif strings.Contains(d.renderFooter(), \"l tail\") {\n\t\tt.Errorf(\"footer shows the tail hint with no run.log:\\n%s\", d.renderFooter())\n\t}\n\n\t// A run.log appears (mg jdi drove the job): the hint shows.\n\tif err := os.MkdirAll(job.JDIStatusDir(root, j.Name), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(job.JDIRunLogPath(root, j.Name), []byte(\"=== mg jdi started ===\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\td2 := newDetailView(j, 80, 24)\n\tif !strings.Contains(d2.renderFooter(), \"l tail\") {\n\t\tt.Errorf(\"footer missing the tail hint when a run.log exists:\\n%s\", d2.renderFooter())\n\t}\n}\n\n// --- \"l\" key gate ------------------------------------------------------------\n\n// TestTailKeyReportsNoRunLogAndLaunchesNothing: with no run.log, \"l\" must\n// report the gate and never reach the launch path at all — the tmux stub call\n// log stays completely empty (not even list-panes, which the launch path's\n// replace policy runs first), mirroring TestTigKeyReportsNotInstalledAndLaunchesNothing's\n// assertion that a gated-off launch never spawns anything.\nfunc TestTailKeyReportsNoRunLogAndLaunchesNothing(t *testing.T) {\n\troot := t.TempDir()\n\tj := discoverOneJob(t, root, \"aaaa09_g\")\n\n\tlogPath := writeTmuxStub(t)\n\n\ta := NewApp(root, []job.Job{j})\n\ta.width, a.height = 80, 24\n\ta.detail = newDetailView(j, 80, 24)\n\ta.state = stateDetail\n\n\ta.updateDetail(keyMsg(\"l\"))\n\tif !strings.Contains(a.detail.status, \"no mg jdi run has happened for this job yet\") {\n\t\tt.Errorf(\"status = %q, want it to explain no run.log exists yet\", a.detail.status)\n\t}\n\t// The stub's call log only exists once the stub has been invoked at all —\n\t// a never-reached launch path leaves no file behind, which is exactly the\n\t// empty log this assertion means.\n\tcalls, err := os.ReadFile(logPath)\n\tif err != nil && !os.IsNotExist(err) {\n\t\tt.Fatalf(\"tmux stub call log not readable: %v\", err)\n\t}\n\tif len(calls) != 0 {\n\t\tt.Errorf(\"launch path reached despite the gate — tmux stub was invoked:\\n%s\", calls)\n\t}\n}\n\n// --- \"l\" success path (tails run.log in a tmux pane) -------------------------\n\n// TestTailKeyLaunchesTailInTmuxPane exercises the full \"l\" flow with a real\n// run.log sidecar and a stubbed tmux on PATH + $TMUX: the split-window\n// invocation must carry the `tail -f '<path>'` inner command (routed through\n// launch.Tail → launchDetached's tmux path, exactly like tig/agent launches),\n// the pane must be tagged, and the status reports where it opened.\nfunc TestTailKeyLaunchesTailInTmuxPane(t *testing.T) {\n\troot := t.TempDir()\n\tj := discoverOneJob(t, root, \"aaaa10_t\")\n\n\tif err := os.MkdirAll(job.JDIStatusDir(root, j.Name), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunLog := job.JDIRunLogPath(root, j.Name)\n\tif err := os.WriteFile(runLog, []byte(\"=== mg jdi started ===\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tlogPath := writeTmuxStub(t)\n\n\ta := NewApp(root, []job.Job{j})\n\ta.width, a.height = 80, 24\n\ta.detail = newDetailView(j, 80, 24)\n\ta.state = stateDetail\n\n\ta.updateDetail(keyMsg(\"l\"))\n\tif !strings.Contains(a.detail.status, \"→ tailing run.log in tmux pane\") {\n\t\tt.Errorf(\"status = %q, want it to report the tail launch in a tmux pane\", a.detail.status)\n\t}\n\tcalls, err := os.ReadFile(logPath)\n\tif err != nil {\n\t\tt.Fatalf(\"tmux stub call log not written: %v\", err)\n\t}\n\tif !strings.Contains(string(calls), \"tail -f '\"+runLog+\"'\") {\n\t\tt.Errorf(\"tmux split-window not invoked with the tail inner command:\\n%s\", calls)\n\t}\n\tif !strings.Contains(string(calls), \"select-pane -t %100 -T manigot\") {\n\t\tt.Errorf(\"select-pane tagging of the new pane missing:\\n%s\", calls)\n\t}\n}","lineStart":1,"lineEnd":113,"totalLines":113,"truncated":false}},"title":"src/internal/ui/tail_test.go","time":{"start":1787919590823,"end":1787919590826}},"id":"prt_0484fe51e001224AofPkrjDHMk","sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","messageID":"msg_0484fd40a0016UBwjYzsjWFJBe"}}
