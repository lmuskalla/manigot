{"type":"tool_use","timestamp":1787919663855,"sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","part":{"type":"tool","tool":"grep","callID":"call_f29af2b8e13d4d8e9e2155cf","state":{"status":"completed","input":{"path":"/workspace/src/internal/session","pattern":"func .*Run|Stdout|stdout|--format json|stream"},"output":"Found 12 matches\n/workspace/src/internal/session/host_test.go:\n  Line 448: func TestHostInvocationRun(t *testing.T) {\n\n\n/workspace/src/internal/session/session.go:\n  Line 9: // the agent's stdout clean in --print mode; Go separates stdout/stderr\n\n\n/workspace/src/internal/session/host.go:\n  Line 511: // Run executes the assembled CLI invocation, wiring stdin/stdout/stderr\n\n  Line 514: func (h HostInvocation) Run(stdin *os.File, stdout, stderr io.Writer) int {\n\n  Line 519: \tcmd.Stdout = stdout\n\n\n/workspace/src/internal/session/docker.go:\n  Line 106: // session start and warns on diag (stderr — the diagnostics stream): when the\n\n  Line 140: // existed only to keep --print stdout clean; Go separates the streams\n\n  Line 524: // Run executes the assembled docker invocation, wiring stdin/stdout/stderr\n\n  Line 534: func (d DockerInvocation) Run(stdin *os.File, stdout, stderr io.Writer) (int, bool) {\n\n  Line 540: \tcmd.Stdout = stdout\n\n\n/workspace/src/internal/session/docker_test.go:\n  Line 80: \t// Banner diagnostics went to the diag writer, not stdout.\n\n  Line 1415: // swallowed — the diagnostics stream, so it can never corrupt --print stdout.\n","metadata":{"matches":12,"truncated":false},"title":"func .*Run|Stdout|stdout|--format json|stream","time":{"start":1787919663840,"end":1787919663853}},"id":"prt_048510298001vGh2an6B7SWmJw","sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","messageID":"msg_04850b5d6001zCeC8kNYoOI2B9"}}
{"type":"tool_use","timestamp":1787919663884,"sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","part":{"type":"tool","tool":"read","callID":"call_25249449d6b14134918175c8","state":{"status":"completed","input":{"filePath":"/workspace/scripts/entrypoint.sh"},"output":"<path>/workspace/scripts/entrypoint.sh</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env bash\n2: set -euo pipefail\n3: \n4: # Which agent CLI to start — set by run.sh from the resolved session profile\n5: # (MANIGOT_TOOL: claude-code or opencode).\n6: TOOL=\"${MANIGOT_TOOL:-claude-code}\"\n7: \n8: if [[ \"$TOOL\" == \"claude-code\" ]]; then\n9:     # Write ~/.claude.json to bypass the onboarding wizard.\n10:     # Without this, Claude Code opens a browser OAuth flow on every container start.\n11:     # Values come from environment variables set by run.sh from your .env file.\n12:     CLAUDE_JSON=\"$HOME/.claude.json\"\n13: \n14:     if [[ ! -f \"$CLAUDE_JSON\" ]]; then\n15:         if [[ -z \"${CLAUDE_ACCOUNT_UUID:-}\" ]] || [[ -z \"${CLAUDE_EMAIL:-}\" ]] || [[ -z \"${CLAUDE_ORG_UUID:-}\" ]]; then\n16:             echo \"Error: CLAUDE_ACCOUNT_UUID, CLAUDE_EMAIL, and CLAUDE_ORG_UUID must be set.\"\n17:             echo \"Extract them from your host with:\"\n18:             echo \"  cat ~/.claude.json | python3 -c \\\"import json,sys; d=json.load(sys.stdin); print(json.dumps(d.get('oauthAccount'), indent=2))\\\"\"\n19:             echo \"Then add them to your manigot/.env file.\"\n20:             exit 1\n21:         fi\n22: \n23:         # Get Claude Code version for lastOnboardingVersion\n24:         CLAUDE_VERSION=$(claude --version 2>/dev/null | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' | head -1 || echo \"2.1.0\")\n25: \n26:         # `projects[\"/workspace\"].hasTrustDialogAccepted` pre-accepts the\n27:         # folder-trust dialog for the container's fixed WORKDIR, so the \"do you\n28:         # trust the files in this folder?\" prompt never appears on first start.\n29:         # `bypassPermissionsModeAccepted` pre-accepts the one-time bypass\n30:         # disclaimer so `--dangerously-skip-permissions` (passed to the exec\n31:         # below) actually takes effect in interactive sessions — without it\n32:         # Claude Code downgrades bypass mode to default with \"bypass requires\n33:         # accepting the disclaimer interactively first\".\n34:         cat > \"$CLAUDE_JSON\" <<EOF\n35: {\n36:   \"hasCompletedOnboarding\": true,\n37:   \"lastOnboardingVersion\": \"$CLAUDE_VERSION\",\n38:   \"bypassPermissionsModeAccepted\": true,\n39:   \"oauthAccount\": {\n40:     \"accountUuid\": \"$CLAUDE_ACCOUNT_UUID\",\n41:     \"emailAddress\": \"$CLAUDE_EMAIL\",\n42:     \"organizationUuid\": \"$CLAUDE_ORG_UUID\"\n43:   },\n44:   \"projects\": {\n45:     \"/workspace\": {\n46:       \"hasTrustDialogAccepted\": true\n47:     }\n48:   }\n49: }\n50: EOF\n51:     fi\n52: else\n53:     # OpenCode has no onboarding wizard to bypass — it reads provider keys from\n54:     # the environment on startup. Just make sure at least one of them is here,\n55:     # otherwise it would start with no usable provider.\n56:     OPENCODE_KEY_VARS=(\n57:         ANTHROPIC_API_KEY\n58:         OPENAI_API_KEY\n59:         OPENROUTER_API_KEY\n60:         GOOGLE_GENERATIVE_AI_API_KEY\n61:         GROQ_API_KEY\n62:         XAI_API_KEY\n63:         DEEPSEEK_API_KEY\n64:         OPENCODE_API_KEY\n65:         ZHIPU_API_KEY\n66:     )\n67: \n68:     HAVE_KEY=0\n69:     for var in \"${OPENCODE_KEY_VARS[@]}\"; do\n70:         [[ -n \"${!var:-}\" ]] && HAVE_KEY=1\n71:     done\n72: \n73:     if [[ \"$HAVE_KEY\" -eq 0 ]]; then\n74:         echo \"Error: no provider API key found for OpenCode.\"\n75:         echo \"Set at least one of these in your manigot/.env file:\"\n76:         printf '  %s\\n' \"${OPENCODE_KEY_VARS[@]}\"\n77:         exit 1\n78:     fi\n79: \n80:     # OpenCode doesn't read OPENCODE_MODEL directly — the model must come from a\n81:     # config file. run.sh forwards OPENCODE_MODEL; emit a minimal global config\n82:     # using {env:...} substitution so it actually takes effect. Without this\n83:     # OpenCode boots with its built-in default model (often the wrong provider).\n84:     OPENCODE_CFG=\"$HOME/.config/opencode/opencode.json\"\n85:     if [[ -n \"${OPENCODE_MODEL:-}\" && ! -f \"$OPENCODE_CFG\" ]]; then\n86:         mkdir -p \"$(dirname \"$OPENCODE_CFG\")\"\n87:         cat > \"$OPENCODE_CFG\" <<'EOF'\n88: {\n89:   \"$schema\": \"https://opencode.ai/config.json\",\n90:   \"model\": \"{env:OPENCODE_MODEL}\"\n91: }\n92: EOF\n93:     fi\n94: \n95:     # The theme setting is TUI-specific and lives in its own tui.json, not\n96:     # opencode.json — confirmed against https://opencode.ai/docs/config/,\n97:     # which documents opencode.json's top-level \"theme\" key as legacy\n98:     # (\"Legacy theme, keybinds, and tui keys in opencode.json are deprecated\n99:     # and automatically migrated when possible\") and directs current users to\n100:     # tui.json instead (https://opencode.ai/docs/themes/'s own example uses\n101:     # tui.json). run.sh forwards OPENCODE_THEME when the user has set the\n102:     # global theme (mg theme); emit a minimal tui.json using the same\n103:     # {env:...} substitution the model config above relies on. Without this\n104:     # OpenCode boots with its built-in default theme, ignoring the user's\n105:     # choice.\n106:     OPENCODE_TUI_CFG=\"$HOME/.config/opencode/tui.json\"\n107:     if [[ -n \"${OPENCODE_THEME:-}\" && ! -f \"$OPENCODE_TUI_CFG\" ]]; then\n108:         mkdir -p \"$(dirname \"$OPENCODE_TUI_CFG\")\"\n109:         cat > \"$OPENCODE_TUI_CFG\" <<'EOF'\n110: {\n111:   \"$schema\": \"https://opencode.ai/tui.json\",\n112:   \"theme\": \"{env:OPENCODE_THEME}\"\n113: }\n114: EOF\n115:     fi\n116: fi\n117: \n118: # ── Git config ──────────────────────────────────────────────────────────────────\n119: # GIT_AUTHOR_NAME/EMAIL env vars override gitconfig when set — even when empty.\n120: # Unset them first so gitconfig always wins, then configure gitconfig from\n121: # whatever values we have available.\n122: unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL\n123: \n124: GIT_NAME=\"${GIT_AUTHOR_NAME_CFG:-manigot}\"\n125: GIT_EMAIL=\"${GIT_AUTHOR_EMAIL_CFG:-manigot@localhost}\"\n126: \n127: git config --global user.name  \"$GIT_NAME\"\n128: git config --global user.email \"$GIT_EMAIL\"\n129: \n130: git config --global --add safe.directory /workspace\n131: \n132: # ── Git shim ──────────────────────────────────────────────────────────────────\n133: # Agents may read git history and make commits, nothing more. A PATH-first git\n134: # shim allowlists the read + commit subcommands and refuses everything else\n135: # (worktree management, branch -d/-D, reset, clean, gc, prune, reflog, push,\n136: # fetch, pull, checkout, switch, restore, stash, remote, tag writes,\n137: # update-ref, merge, rebase, ...) with a clear message. It is a soft layer — a\n138: # determined agent can exec the real git at its absolute path or write the\n139: # mounted gitdir directly; the hard filesystem boundary for non-committing\n140: # agents is the read-only git-common-dir mount the session launcher sets up.\n141: # Installed after the git config --global calls above, so the shim never sees\n142: # (and never blocks) the entrypoint's own configuration writes.\n143: MANIGOT_BIN=\"$HOME/.manigot/bin\"\n144: mkdir -p \"$MANIGOT_BIN\"\n145: REAL_GIT=\"$(command -v git)\"\n146: \n147: cat > \"$MANIGOT_BIN/git\" <<'SHIM'\n148: #!/usr/bin/env bash\n149: set -euo pipefail\n150: \n151: # manigot git shim — agents may read git history and make commits, nothing\n152: # more. See docs/AGENTS.md (\"Session git shim\").\n153: REAL_GIT=\"@REAL_GIT@\"\n154: \n155: # Subcommands allowed: the read surface (history, index, refs, objects) plus\n156: # add/commit. Everything else is refused below. The destructive forms of the\n157: # allowed commands (branch -d/-D/-m/-M/-c/-C, config writes, symbolic-ref\n158: # writes) are refused per-command.\n159: ALLOWED=\" add commit diff log show status rev-parse rev-list merge-base branch config grep ls-files ls-tree cat-file for-each-ref show-ref describe blame shortlog whatchanged name-rev check-ignore check-attr check-mailmap count-objects diff-index diff-tree diff-files symbolic-ref \"\n160: \n161: deny() {\n162:     echo \"manigot: git '$1' is not allowed in agent sessions.\" >&2\n163:     echo \"manigot: agents may only read git history and make commits (git add, git commit, git log, git diff, git show, git status, ...).\" >&2\n164:     exit 1\n165: }\n166: \n167: # Locate the subcommand, skipping leading git global options and their values\n168: # (git -C <dir>, git -c key=value, --git-dir, --work-tree, ...). Everything\n169: # after the subcommand is collected in rest for the per-command checks below.\n170: subcmd=\"\"\n171: rest=()\n172: skip_next=0\n173: for arg in \"$@\"; do\n174:     if [[ -n \"$subcmd\" ]]; then\n175:         rest+=(\"$arg\")\n176:         continue\n177:     fi\n178:     if [[ \"$skip_next\" -eq 1 ]]; then\n179:         skip_next=0\n180:         continue\n181:     fi\n182:     case \"$arg\" in\n183:         -C|-c|--git-dir|--work-tree|--namespace|--config-env)\n184:             skip_next=1\n185:             ;;\n186:         --git-dir=*|--work-tree=*|--namespace=*|--config-env=*|-c?*)\n187:             ;;\n188:         -*)\n189:             ;;\n190:         *)\n191:             subcmd=\"$arg\"\n192:             ;;\n193:     esac\n194: done\n195: \n196: if [[ -z \"$subcmd\" ]] || [[ \"$ALLOWED\" != *\" $subcmd \"* ]]; then\n197:     deny \"${subcmd:-<no subcommand>}\"\n198: fi\n199: \n200: case \"$subcmd\" in\n201:     add)\n202:         # The container docs mounts collide with the repo paths .opencode/\n203:         # (OpenCode) and .claude/ (Claude Code): inside the container those\n204:         # are bind mounts of docs/, so an agent staging files through them\n205:         # would commit a stale duplicate of docs/ under the colliding path.\n206:         # info/exclude already makes git ignore both paths (host-side, via\n207:         # git.ExcludeMountTargets at job creation and session launch) — this\n208:         # is the belt-and-braces second layer for a worktree the exclusion\n209:         # hasn't reached yet. Covers leading ./ variants and -f forces.\n210:         for a in \"${rest[@]}\"; do\n211:             case \"$a\" in\n212:                 .opencode*|./.opencode*|.claude*|./.claude*)\n213:                     deny \"add $a\"\n214:                     ;;\n215:             esac\n216:         done\n217:         ;;\n218:     branch)\n219:         for a in \"${rest[@]}\"; do\n220:             case \"$a\" in\n221:                 -d*|-D*|-m*|-M*|-c*|-C*|-f*|--delete*|--move*|--copy*|--track*|--no-track*|--set-upstream*|--unset-upstream*|--edit-description*)\n222:                     deny \"branch $a\"\n223:                     ;;\n224:             esac\n225:         done\n226:         ;;\n227:     config)\n228:         positional=0\n229:         write=0\n230:         for a in \"${rest[@]}\"; do\n231:             case \"$a\" in\n232:                 --add|--unset|--unset-all|--rename-section|--remove-section|--edit|--replace-all)\n233:                     write=1\n234:                     ;;\n235:                 -*)\n236:                     ;;\n237:                 *)\n238:                     positional=$((positional + 1))\n239:                     ;;\n240:             esac\n241:         done\n242:         if [[ \"$write\" -eq 1 || \"$positional\" -ge 2 ]]; then\n243:             deny \"config write\"\n244:         fi\n245:         ;;\n246:     symbolic-ref)\n247:         positional=0\n248:         for a in \"${rest[@]}\"; do\n249:             case \"$a\" in\n250:                 -*) ;;\n251:                 *) positional=$((positional + 1)) ;;\n252:             esac\n253:         done\n254:         if [[ \"$positional\" -ge 2 ]]; then\n255:             deny \"symbolic-ref write\"\n256:         fi\n257:         ;;\n258: esac\n259: \n260: exec \"$REAL_GIT\" \"$@\"\n261: SHIM\n262: \n263: sed -i \"s|@REAL_GIT@|$REAL_GIT|g\" \"$MANIGOT_BIN/git\"\n264: chmod +x \"$MANIGOT_BIN/git\"\n265: export PATH=\"$MANIGOT_BIN:$PATH\"\n266: \n267: # --print mode expects a clean stdout stream (see run.sh and the\n268: # --output-format stream-json branch below) — this quote is purely cosmetic, so\n269: # it's skipped there rather than risking a caller mis-parsing it as part\n270: # of the agent's own output. Printed in italics (raw ANSI, not tput/ncurses\n271: # — not guaranteed present in this slim image) with a trailing blank line.\n272: if [[ \"${MANIGOT_PRINT:-false}\" != \"true\" && -n \"${MANIGOT_QUOTE:-}\" ]]; then\n273:     printf '\\033[3m\"%s\"\\033[0m\\n\\n' \"$MANIGOT_QUOTE\"\n274: fi\n275: \n276: if [[ \"$TOOL\" == \"opencode\" ]]; then\n277:     if [[ \"${MANIGOT_PRINT:-false}\" == \"true\" ]]; then\n278:         # Non-interactive, one-shot mode (run.sh's --print flag, e.g. for\n279:         # mg-jdi) — mirrors the claude-code branch below. OpenCode's\n280:         # interactive `opencode [project]` command (the \"$@\" passthrough\n281:         # used otherwise) takes --agent/--prompt as flags, but has no\n282:         # non-interactive equivalent of its own; the headless mode is a\n283:         # separate subcommand, `opencode run [message..]`, which takes the\n284:         # prompt as a positional argument instead and supports its own\n285:         # --agent flag (confirmed via `opencode run --help` against the\n286:         # opencode-ai version installed from the Dockerfile's unpinned `npm\n287:         # install -g opencode-ai`). Translate the incoming --agent/--prompt\n288:         # pair into that shape rather than passing \"$@\" through unchanged.\n289:         # --format json makes it emit one JSON object per line (JSONL: a\n290:         # stream of step_start/tool_use/text/step_finish events, each\n291:         # reporting the assistant's response in a \"text\"-typed event's\n292:         # part.text) instead of interactive TUI output — parsed by\n293:         # tui/internal/orchestrate.ResultText/DetectSignal the same way\n294:         # Claude's --output-format stream-json \"result\" event is.\n295:         OC_AGENT=\"\"\n296:         OC_PROMPT=\"\"\n297:         OC_REST=()\n298:         while [[ $# -gt 0 ]]; do\n299:             case \"$1\" in\n300:                 --agent)  OC_AGENT=\"$2\";  shift 2 ;;\n301:                 --prompt) OC_PROMPT=\"$2\"; shift 2 ;;\n302:                 *)        OC_REST+=(\"$1\"); shift ;;\n303:             esac\n304:         done\n305: \n306:         OC_ARGS=(run)\n307:         [[ -n \"$OC_PROMPT\" ]] && OC_ARGS+=(\"$OC_PROMPT\")\n308:         [[ -n \"$OC_AGENT\" ]] && OC_ARGS+=(--agent \"$OC_AGENT\")\n309:         # --auto makes the headless run explicitly auto-approved: the archived\n310:         # foycfl job verified `opencode run` auto-executes bash/write tool\n311:         # calls even without it, but the flag makes the intent explicit and\n312:         # guards other tools (webfetch, task, lsp, mcp) against an unanswered\n313:         # \"ask\" prompt stalling an unattended non-TTY run — the headless\n314:         # counterpart of the interactive --auto above and of Claude's\n315:         # --dangerously-skip-permissions on its own --print branch.\n316:         OC_ARGS+=(--auto --format json)\n317:         exec opencode \"${OC_ARGS[@]}\" \"${OC_REST[@]+\"${OC_REST[@]}\"}\"\n318:     fi\n319:     # --auto starts every OpenCode session in full auto mode (no per-tool\n320:     # confirmation, e.g. \"can I run this python script?\"). Safe in this context\n321:     # because manigot launches an isolated, ephemeral container specifically for\n322:     # this purpose; the brief explicitly wants OpenCode to start in auto mode,\n323:     # mirroring the claude-code branch's --dangerously-skip-permissions below.\n324:     # Placed before \"$@\" so it composes with the passthrough (--agent <name>,\n325:     # --prompt <text> and/or the positional job prompt).\n326:     exec opencode --auto \"$@\"\n327: else\n328:     # --dangerously-skip-permissions starts every Claude Code session in full\n329:     # auto mode (no per-tool-call confirmation). Safe in this context because\n330:     # manigot launches an isolated, ephemeral container specifically for this\n331:     # purpose; the brief explicitly wants Claude Code to start in auto mode.\n332:     # Placed before \"$@\" so it composes with the passthrough (--agent <name>\n333:     # and/or the positional job prompt).\n334:     if [[ \"${MANIGOT_PRINT:-false}\" == \"true\" ]]; then\n335:         # Non-interactive, one-shot mode (run.sh's --print flag, e.g. for\n336:         # mg-jdi): no attached terminal, so the caller gets the agent's\n337:         # output back on stdout instead. --verbose --output-format\n338:         # stream-json emits a step-level JSONL event stream — system /\n339:         # assistant / user / result events, one object per line — whose\n340:         # final \"result\" event's \"result\" field carries the final response\n341:         # text. That is strictly more than the old single-result json form:\n342:         # the full stream is what mg-jdi persists to the job's session.log\n343:         # (see jdioutput.go's appendSessionLog), not just the final answer.\n344:         # --verbose is required: claude rejects stream-json under --print\n345:         # without it (\"--output-format=stream-json requires --verbose\"),\n346:         # verified against the installed version (2.1.247). Stream-json has\n347:         # been more version-volatile than the stable single-result shape, so\n348:         # internal/orchestrate keeps the plain result parse as a defensive\n349:         # fallback (see signal.go). Parsing the stream — instead of scanning\n350:         # raw combined stdout — also keeps the marker text (see\n351:         # docs/AGENTS.md) from false-positiving when it appears incidentally\n352:         # inside a tool call's own output (e.g. a grep result).\n353:         exec claude --dangerously-skip-permissions --print --verbose --output-format stream-json \"$@\"\n354:     fi\n355:     exec claude --dangerously-skip-permissions \"$@\"\n356: fi\n\n(End of file - total 356 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env bash\nset -euo pipefail\n\n# Which agent CLI to start — set by run.sh from the resolved session profile\n# (MANIGOT_TOOL: claude-code or opencode).\nTOOL=\"${MANIGOT_TOOL:-claude-code}\"\n\nif [[ \"$TOOL\" == \"claude-code\" ]]; then\n    # Write ~/.claude.json to bypass the onboarding wizard.\n    # Without this, Claude Code opens a browser OAuth flow on every container start.\n    # Values come from environment variables set by run.sh from your .env file.\n    CLAUDE_JSON=\"$HOME/.claude.json\"\n\n    if [[ ! -f \"$CLAUDE_JSON\" ]]; then\n        if [[ -z \"${CLAUDE_ACCOUNT_UUID:-}\" ]] || [[ -z \"${CLAUDE_EMAIL:-}\" ]] || [[ -z \"${CLAUDE_ORG_UUID:-}\" ]]; then\n            echo \"Error: CLAUDE_ACCOUNT_UUID, CLAUDE_EMAIL, and CLAUDE_ORG_UUID must be set.\"\n            echo \"Extract them from your host with:\"\n            echo \"  cat ~/.claude.json | python3 -c \\\"import json,sys; d=json.load(sys.stdin); print(json.dumps(d.get('oauthAccount'), indent=2))\\\"\"\n            echo \"Then add them to your manigot/.env file.\"\n            exit 1","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/scripts/entrypoint.sh","text":"#!/usr/bin/env bash\nset -euo pipefail\n\n# Which agent CLI to start — set by run.sh from the resolved session profile\n# (MANIGOT_TOOL: claude-code or opencode).\nTOOL=\"${MANIGOT_TOOL:-claude-code}\"\n\nif [[ \"$TOOL\" == \"claude-code\" ]]; then\n    # Write ~/.claude.json to bypass the onboarding wizard.\n    # Without this, Claude Code opens a browser OAuth flow on every container start.\n    # Values come from environment variables set by run.sh from your .env file.\n    CLAUDE_JSON=\"$HOME/.claude.json\"\n\n    if [[ ! -f \"$CLAUDE_JSON\" ]]; then\n        if [[ -z \"${CLAUDE_ACCOUNT_UUID:-}\" ]] || [[ -z \"${CLAUDE_EMAIL:-}\" ]] || [[ -z \"${CLAUDE_ORG_UUID:-}\" ]]; then\n            echo \"Error: CLAUDE_ACCOUNT_UUID, CLAUDE_EMAIL, and CLAUDE_ORG_UUID must be set.\"\n            echo \"Extract them from your host with:\"\n            echo \"  cat ~/.claude.json | python3 -c \\\"import json,sys; d=json.load(sys.stdin); print(json.dumps(d.get('oauthAccount'), indent=2))\\\"\"\n            echo \"Then add them to your manigot/.env file.\"\n            exit 1\n        fi\n\n        # Get Claude Code version for lastOnboardingVersion\n        CLAUDE_VERSION=$(claude --version 2>/dev/null | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' | head -1 || echo \"2.1.0\")\n\n        # `projects[\"/workspace\"].hasTrustDialogAccepted` pre-accepts the\n        # folder-trust dialog for the container's fixed WORKDIR, so the \"do you\n        # trust the files in this folder?\" prompt never appears on first start.\n        # `bypassPermissionsModeAccepted` pre-accepts the one-time bypass\n        # disclaimer so `--dangerously-skip-permissions` (passed to the exec\n        # below) actually takes effect in interactive sessions — without it\n        # Claude Code downgrades bypass mode to default with \"bypass requires\n        # accepting the disclaimer interactively first\".\n        cat > \"$CLAUDE_JSON\" <<EOF\n{\n  \"hasCompletedOnboarding\": true,\n  \"lastOnboardingVersion\": \"$CLAUDE_VERSION\",\n  \"bypassPermissionsModeAccepted\": true,\n  \"oauthAccount\": {\n    \"accountUuid\": \"$CLAUDE_ACCOUNT_UUID\",\n    \"emailAddress\": \"$CLAUDE_EMAIL\",\n    \"organizationUuid\": \"$CLAUDE_ORG_UUID\"\n  },\n  \"projects\": {\n    \"/workspace\": {\n      \"hasTrustDialogAccepted\": true\n    }\n  }\n}\nEOF\n    fi\nelse\n    # OpenCode has no onboarding wizard to bypass — it reads provider keys from\n    # the environment on startup. Just make sure at least one of them is here,\n    # otherwise it would start with no usable provider.\n    OPENCODE_KEY_VARS=(\n        ANTHROPIC_API_KEY\n        OPENAI_API_KEY\n        OPENROUTER_API_KEY\n        GOOGLE_GENERATIVE_AI_API_KEY\n        GROQ_API_KEY\n        XAI_API_KEY\n        DEEPSEEK_API_KEY\n        OPENCODE_API_KEY\n        ZHIPU_API_KEY\n    )\n\n    HAVE_KEY=0\n    for var in \"${OPENCODE_KEY_VARS[@]}\"; do\n        [[ -n \"${!var:-}\" ]] && HAVE_KEY=1\n    done\n\n    if [[ \"$HAVE_KEY\" -eq 0 ]]; then\n        echo \"Error: no provider API key found for OpenCode.\"\n        echo \"Set at least one of these in your manigot/.env file:\"\n        printf '  %s\\n' \"${OPENCODE_KEY_VARS[@]}\"\n        exit 1\n    fi\n\n    # OpenCode doesn't read OPENCODE_MODEL directly — the model must come from a\n    # config file. run.sh forwards OPENCODE_MODEL; emit a minimal global config\n    # using {env:...} substitution so it actually takes effect. Without this\n    # OpenCode boots with its built-in default model (often the wrong provider).\n    OPENCODE_CFG=\"$HOME/.config/opencode/opencode.json\"\n    if [[ -n \"${OPENCODE_MODEL:-}\" && ! -f \"$OPENCODE_CFG\" ]]; then\n        mkdir -p \"$(dirname \"$OPENCODE_CFG\")\"\n        cat > \"$OPENCODE_CFG\" <<'EOF'\n{\n  \"$schema\": \"https://opencode.ai/config.json\",\n  \"model\": \"{env:OPENCODE_MODEL}\"\n}\nEOF\n    fi\n\n    # The theme setting is TUI-specific and lives in its own tui.json, not\n    # opencode.json — confirmed against https://opencode.ai/docs/config/,\n    # which documents opencode.json's top-level \"theme\" key as legacy\n    # (\"Legacy theme, keybinds, and tui keys in opencode.json are deprecated\n    # and automatically migrated when possible\") and directs current users to\n    # tui.json instead (https://opencode.ai/docs/themes/'s own example uses\n    # tui.json). run.sh forwards OPENCODE_THEME when the user has set the\n    # global theme (mg theme); emit a minimal tui.json using the same\n    # {env:...} substitution the model config above relies on. Without this\n    # OpenCode boots with its built-in default theme, ignoring the user's\n    # choice.\n    OPENCODE_TUI_CFG=\"$HOME/.config/opencode/tui.json\"\n    if [[ -n \"${OPENCODE_THEME:-}\" && ! -f \"$OPENCODE_TUI_CFG\" ]]; then\n        mkdir -p \"$(dirname \"$OPENCODE_TUI_CFG\")\"\n        cat > \"$OPENCODE_TUI_CFG\" <<'EOF'\n{\n  \"$schema\": \"https://opencode.ai/tui.json\",\n  \"theme\": \"{env:OPENCODE_THEME}\"\n}\nEOF\n    fi\nfi\n\n# ── Git config ──────────────────────────────────────────────────────────────────\n# GIT_AUTHOR_NAME/EMAIL env vars override gitconfig when set — even when empty.\n# Unset them first so gitconfig always wins, then configure gitconfig from\n# whatever values we have available.\nunset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL\n\nGIT_NAME=\"${GIT_AUTHOR_NAME_CFG:-manigot}\"\nGIT_EMAIL=\"${GIT_AUTHOR_EMAIL_CFG:-manigot@localhost}\"\n\ngit config --global user.name  \"$GIT_NAME\"\ngit config --global user.email \"$GIT_EMAIL\"\n\ngit config --global --add safe.directory /workspace\n\n# ── Git shim ──────────────────────────────────────────────────────────────────\n# Agents may read git history and make commits, nothing more. A PATH-first git\n# shim allowlists the read + commit subcommands and refuses everything else\n# (worktree management, branch -d/-D, reset, clean, gc, prune, reflog, push,\n# fetch, pull, checkout, switch, restore, stash, remote, tag writes,\n# update-ref, merge, rebase, ...) with a clear message. It is a soft layer — a\n# determined agent can exec the real git at its absolute path or write the\n# mounted gitdir directly; the hard filesystem boundary for non-committing\n# agents is the read-only git-common-dir mount the session launcher sets up.\n# Installed after the git config --global calls above, so the shim never sees\n# (and never blocks) the entrypoint's own configuration writes.\nMANIGOT_BIN=\"$HOME/.manigot/bin\"\nmkdir -p \"$MANIGOT_BIN\"\nREAL_GIT=\"$(command -v git)\"\n\ncat > \"$MANIGOT_BIN/git\" <<'SHIM'\n#!/usr/bin/env bash\nset -euo pipefail\n\n# manigot git shim — agents may read git history and make commits, nothing\n# more. See docs/AGENTS.md (\"Session git shim\").\nREAL_GIT=\"@REAL_GIT@\"\n\n# Subcommands allowed: the read surface (history, index, refs, objects) plus\n# add/commit. Everything else is refused below. The destructive forms of the\n# allowed commands (branch -d/-D/-m/-M/-c/-C, config writes, symbolic-ref\n# writes) are refused per-command.\nALLOWED=\" add commit diff log show status rev-parse rev-list merge-base branch config grep ls-files ls-tree cat-file for-each-ref show-ref describe blame shortlog whatchanged name-rev check-ignore check-attr check-mailmap count-objects diff-index diff-tree diff-files symbolic-ref \"\n\ndeny() {\n    echo \"manigot: git '$1' is not allowed in agent sessions.\" >&2\n    echo \"manigot: agents may only read git history and make commits (git add, git commit, git log, git diff, git show, git status, ...).\" >&2\n    exit 1\n}\n\n# Locate the subcommand, skipping leading git global options and their values\n# (git -C <dir>, git -c key=value, --git-dir, --work-tree, ...). Everything\n# after the subcommand is collected in rest for the per-command checks below.\nsubcmd=\"\"\nrest=()\nskip_next=0\nfor arg in \"$@\"; do\n    if [[ -n \"$subcmd\" ]]; then\n        rest+=(\"$arg\")\n        continue\n    fi\n    if [[ \"$skip_next\" -eq 1 ]]; then\n        skip_next=0\n        continue\n    fi\n    case \"$arg\" in\n        -C|-c|--git-dir|--work-tree|--namespace|--config-env)\n            skip_next=1\n            ;;\n        --git-dir=*|--work-tree=*|--namespace=*|--config-env=*|-c?*)\n            ;;\n        -*)\n            ;;\n        *)\n            subcmd=\"$arg\"\n            ;;\n    esac\ndone\n\nif [[ -z \"$subcmd\" ]] || [[ \"$ALLOWED\" != *\" $subcmd \"* ]]; then\n    deny \"${subcmd:-<no subcommand>}\"\nfi\n\ncase \"$subcmd\" in\n    add)\n        # The container docs mounts collide with the repo paths .opencode/\n        # (OpenCode) and .claude/ (Claude Code): inside the container those\n        # are bind mounts of docs/, so an agent staging files through them\n        # would commit a stale duplicate of docs/ under the colliding path.\n        # info/exclude already makes git ignore both paths (host-side, via\n        # git.ExcludeMountTargets at job creation and session launch) — this\n        # is the belt-and-braces second layer for a worktree the exclusion\n        # hasn't reached yet. Covers leading ./ variants and -f forces.\n        for a in \"${rest[@]}\"; do\n            case \"$a\" in\n                .opencode*|./.opencode*|.claude*|./.claude*)\n                    deny \"add $a\"\n                    ;;\n            esac\n        done\n        ;;\n    branch)\n        for a in \"${rest[@]}\"; do\n            case \"$a\" in\n                -d*|-D*|-m*|-M*|-c*|-C*|-f*|--delete*|--move*|--copy*|--track*|--no-track*|--set-upstream*|--unset-upstream*|--edit-description*)\n                    deny \"branch $a\"\n                    ;;\n            esac\n        done\n        ;;\n    config)\n        positional=0\n        write=0\n        for a in \"${rest[@]}\"; do\n            case \"$a\" in\n                --add|--unset|--unset-all|--rename-section|--remove-section|--edit|--replace-all)\n                    write=1\n                    ;;\n                -*)\n                    ;;\n                *)\n                    positional=$((positional + 1))\n                    ;;\n            esac\n        done\n        if [[ \"$write\" -eq 1 || \"$positional\" -ge 2 ]]; then\n            deny \"config write\"\n        fi\n        ;;\n    symbolic-ref)\n        positional=0\n        for a in \"${rest[@]}\"; do\n            case \"$a\" in\n                -*) ;;\n                *) positional=$((positional + 1)) ;;\n            esac\n        done\n        if [[ \"$positional\" -ge 2 ]]; then\n            deny \"symbolic-ref write\"\n        fi\n        ;;\nesac\n\nexec \"$REAL_GIT\" \"$@\"\nSHIM\n\nsed -i \"s|@REAL_GIT@|$REAL_GIT|g\" \"$MANIGOT_BIN/git\"\nchmod +x \"$MANIGOT_BIN/git\"\nexport PATH=\"$MANIGOT_BIN:$PATH\"\n\n# --print mode expects a clean stdout stream (see run.sh and the\n# --output-format stream-json branch below) — this quote is purely cosmetic, so\n# it's skipped there rather than risking a caller mis-parsing it as part\n# of the agent's own output. Printed in italics (raw ANSI, not tput/ncurses\n# — not guaranteed present in this slim image) with a trailing blank line.\nif [[ \"${MANIGOT_PRINT:-false}\" != \"true\" && -n \"${MANIGOT_QUOTE:-}\" ]]; then\n    printf '\\033[3m\"%s\"\\033[0m\\n\\n' \"$MANIGOT_QUOTE\"\nfi\n\nif [[ \"$TOOL\" == \"opencode\" ]]; then\n    if [[ \"${MANIGOT_PRINT:-false}\" == \"true\" ]]; then\n        # Non-interactive, one-shot mode (run.sh's --print flag, e.g. for\n        # mg-jdi) — mirrors the claude-code branch below. OpenCode's\n        # interactive `opencode [project]` command (the \"$@\" passthrough\n        # used otherwise) takes --agent/--prompt as flags, but has no\n        # non-interactive equivalent of its own; the headless mode is a\n        # separate subcommand, `opencode run [message..]`, which takes the\n        # prompt as a positional argument instead and supports its own\n        # --agent flag (confirmed via `opencode run --help` against the\n        # opencode-ai version installed from the Dockerfile's unpinned `npm\n        # install -g opencode-ai`). Translate the incoming --agent/--prompt\n        # pair into that shape rather than passing \"$@\" through unchanged.\n        # --format json makes it emit one JSON object per line (JSONL: a\n        # stream of step_start/tool_use/text/step_finish events, each\n        # reporting the assistant's response in a \"text\"-typed event's\n        # part.text) instead of interactive TUI output — parsed by\n        # tui/internal/orchestrate.ResultText/DetectSignal the same way\n        # Claude's --output-format stream-json \"result\" event is.\n        OC_AGENT=\"\"\n        OC_PROMPT=\"\"\n        OC_REST=()\n        while [[ $# -gt 0 ]]; do\n            case \"$1\" in\n                --agent)  OC_AGENT=\"$2\";  shift 2 ;;\n                --prompt) OC_PROMPT=\"$2\"; shift 2 ;;\n                *)        OC_REST+=(\"$1\"); shift ;;\n            esac\n        done\n\n        OC_ARGS=(run)\n        [[ -n \"$OC_PROMPT\" ]] && OC_ARGS+=(\"$OC_PROMPT\")\n        [[ -n \"$OC_AGENT\" ]] && OC_ARGS+=(--agent \"$OC_AGENT\")\n        # --auto makes the headless run explicitly auto-approved: the archived\n        # foycfl job verified `opencode run` auto-executes bash/write tool\n        # calls even without it, but the flag makes the intent explicit and\n        # guards other tools (webfetch, task, lsp, mcp) against an unanswered\n        # \"ask\" prompt stalling an unattended non-TTY run — the headless\n        # counterpart of the interactive --auto above and of Claude's\n        # --dangerously-skip-permissions on its own --print branch.\n        OC_ARGS+=(--auto --format json)\n        exec opencode \"${OC_ARGS[@]}\" \"${OC_REST[@]+\"${OC_REST[@]}\"}\"\n    fi\n    # --auto starts every OpenCode session in full auto mode (no per-tool\n    # confirmation, e.g. \"can I run this python script?\"). Safe in this context\n    # because manigot launches an isolated, ephemeral container specifically for\n    # this purpose; the brief explicitly wants OpenCode to start in auto mode,\n    # mirroring the claude-code branch's --dangerously-skip-permissions below.\n    # Placed before \"$@\" so it composes with the passthrough (--agent <name>,\n    # --prompt <text> and/or the positional job prompt).\n    exec opencode --auto \"$@\"\nelse\n    # --dangerously-skip-permissions starts every Claude Code session in full\n    # auto mode (no per-tool-call confirmation). Safe in this context because\n    # manigot launches an isolated, ephemeral container specifically for this\n    # purpose; the brief explicitly wants Claude Code to start in auto mode.\n    # Placed before \"$@\" so it composes with the passthrough (--agent <name>\n    # and/or the positional job prompt).\n    if [[ \"${MANIGOT_PRINT:-false}\" == \"true\" ]]; then\n        # Non-interactive, one-shot mode (run.sh's --print flag, e.g. for\n        # mg-jdi): no attached terminal, so the caller gets the agent's\n        # output back on stdout instead. --verbose --output-format\n        # stream-json emits a step-level JSONL event stream — system /\n        # assistant / user / result events, one object per line — whose\n        # final \"result\" event's \"result\" field carries the final response\n        # text. That is strictly more than the old single-result json form:\n        # the full stream is what mg-jdi persists to the job's session.log\n        # (see jdioutput.go's appendSessionLog), not just the final answer.\n        # --verbose is required: claude rejects stream-json under --print\n        # without it (\"--output-format=stream-json requires --verbose\"),\n        # verified against the installed version (2.1.247). Stream-json has\n        # been more version-volatile than the stable single-result shape, so\n        # internal/orchestrate keeps the plain result parse as a defensive\n        # fallback (see signal.go). Parsing the stream — instead of scanning\n        # raw combined stdout — also keeps the marker text (see\n        # docs/AGENTS.md) from false-positiving when it appears incidentally\n        # inside a tool call's own output (e.g. a grep result).\n        exec claude --dangerously-skip-permissions --print --verbose --output-format stream-json \"$@\"\n    fi\n    exec claude --dangerously-skip-permissions \"$@\"\nfi","lineStart":1,"lineEnd":356,"totalLines":356,"truncated":false}},"title":"scripts/entrypoint.sh","time":{"start":1787919663872,"end":1787919663882}},"id":"prt_0485102e2001K1MBPgEtz8OeR6","sessionID":"ses_fb7b04d47ffelTPa5RFrjm6f8o","messageID":"msg_04850b5d6001zCeC8kNYoOI2B9"}}
