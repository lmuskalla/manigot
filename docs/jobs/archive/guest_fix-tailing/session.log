{"type":"tool_use","timestamp":1787921096287,"sessionID":"ses_fb7999c4fffe1anLtOEgzjXUGJ","part":{"type":"tool","tool":"read","callID":"call_00_v2TbykQcPeX8TIsflpzz7689","state":{"status":"completed","input":{"filePath":"/workspace/src/cmd/mg/jdi_test.go"},"output":"<path>/workspace/src/cmd/mg/jdi_test.go</path>\n<type>file</type>\n<content>\n1: package main\n2: \n3: import (\n4: \t\"bytes\"\n5: \t\"errors\"\n6: \t\"fmt\"\n7: \t\"io\"\n8: \t\"net/http\"\n9: \t\"net/http/httptest\"\n10: \t\"os\"\n11: \t\"os/exec\"\n12: \t\"path/filepath\"\n13: \t\"strings\"\n14: \t\"testing\"\n15: \t\"time\"\n16: \n17: \t\"github.com/lmuskalla/manigot/internal/git\"\n18: \t\"github.com/lmuskalla/manigot/internal/job\"\n19: \t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n20: \t\"github.com/lmuskalla/manigot/internal/session\"\n21: )\n22: \n23: // runGit runs git -C dir args, failing the test on any error — mirrors\n24: // tui/internal/git's own test helper, duplicated here since it is\n25: // unexported in that package.\n26: func runGit(t *testing.T, dir string, args ...string) {\n27: \tt.Helper()\n28: \tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n29: \tif out, err := cmd.CombinedOutput(); err != nil {\n30: \t\tt.Fatalf(\"git %s in %s: %v\\n%s\", strings.Join(args, \" \"), dir, err, out)\n31: \t}\n32: }\n33: \n34: // initTestRepo creates a fresh git repo at a temp dir with a job scaffold\n35: // (brief.md only — tasks/implementation/verdict are written by the fake\n36: // runner as the loop progresses) on its own job branch, and returns the\n37: // job.Job ready to hand to Run.\n38: func initTestRepo(t *testing.T) (root string, j job.Job) {\n39: \tt.Helper()\n40: \troot = t.TempDir()\n41: \trunGit(t, root, \"init\", \"-q\")\n42: \trunGit(t, root, \"config\", \"user.email\", \"t@example.com\")\n43: \trunGit(t, root, \"config\", \"user.name\", \"Test\")\n44: \trunGit(t, root, \"config\", \"commit.gpgsign\", \"false\")\n45: \n46: \tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n47: \t\tt.Fatal(err)\n48: \t}\n49: \tif err := os.WriteFile(filepath.Join(root, \"README\"), []byte(\"init\\n\"), 0o644); err != nil {\n50: \t\tt.Fatal(err)\n51: \t}\n52: \trunGit(t, root, \"add\", \"README\")\n53: \trunGit(t, root, \"commit\", \"-q\", \"-m\", \"init\")\n54: \n55: \tconst jobName = \"aaaa01_test-job\"\n56: \tconst branch = \"feature/aaaa01_test-job\"\n57: \tjobDir := filepath.Join(root, \"docs\", \"jobs\", jobName)\n58: \tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n59: \t\tt.Fatal(err)\n60: \t}\n61: \tbrief := \"# Brief: test job\\n\\nstatus: open\\ntype: feature\\nid: aaaa01\\nbranch: \" + branch + \"\\n\\n\" +\n62: \t\t\"## What\\n\\nsomething substantial enough to count as written\\nand a second line so isWritten's rule is satisfied\\n\"\n63: \tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n64: \t\tt.Fatal(err)\n65: \t}\n66: \trunGit(t, root, \"checkout\", \"-q\", \"-b\", branch)\n67: \trunGit(t, root, \"add\", \"-A\")\n68: \trunGit(t, root, \"commit\", \"-q\", \"-m\", \"[aaaa01] scaffold job\")\n69: \n70: \tj = job.Job{\n71: \t\tName:   jobName,\n72: \t\tDir:    jobDir,\n73: \t\tRoot:   root,\n74: \t\tID:     \"aaaa01\",\n75: \t\tBranch: branch,\n76: \t}\n77: \treturn root, j\n78: }\n79: \n80: // initLinkedWorktreeRepo creates a fresh git repo whose job branch is checked\n81: // out in a REAL linked worktree — the production shape `mg job` produces —\n82: // unlike initTestRepo's pre-worktree shape (branch checked out in the main\n83: // worktree itself). Run-level session.log tests use this shape so the\n84: // loop-exit sweep's CommitAll runs against the job's own worktree and the\n85: // REQUIRED clean-tree assertion actually exercises it (in the pre-worktree\n86: // shape the sweep is gated off by design — see TestRunDoesNotSweepMainWorktree).\n87: //\n88: // Returns the main project root (matching job.Discover's semantics: a Job's\n89: // Root is always the main root, never its own worktree), the job's linked\n90: // worktree path, and the job.Job.\n91: func initLinkedWorktreeRepo(t *testing.T) (root, wt string, j job.Job) {\n92: \tt.Helper()\n93: \troot = t.TempDir()\n94: \trunGit(t, root, \"init\", \"-q\", \"-b\", \"main\")\n95: \trunGit(t, root, \"config\", \"user.email\", \"t@example.com\")\n96: \trunGit(t, root, \"config\", \"user.name\", \"Test\")\n97: \trunGit(t, root, \"config\", \"commit.gpgsign\", \"false\")\n98: \n99: \tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n100: \t\tt.Fatal(err)\n101: \t}\n102: \tif err := os.WriteFile(filepath.Join(root, \"README\"), []byte(\"init\\n\"), 0o644); err != nil {\n103: \t\tt.Fatal(err)\n104: \t}\n105: \trunGit(t, root, \"add\", \"README\")\n106: \trunGit(t, root, \"commit\", \"-q\", \"-m\", \"init\")\n107: \n108: \tconst jobName = \"aaaa01_test-job\"\n109: \tconst branch = \"feature/aaaa01_test-job\"\n110: \tjobDir := filepath.Join(root, \"docs\", \"jobs\", jobName)\n111: \tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n112: \t\tt.Fatal(err)\n113: \t}\n114: \tbrief := \"# Brief: test job\\n\\nstatus: open\\ntype: feature\\nid: aaaa01\\nbranch: \" + branch + \"\\n\\n\" +\n115: \t\t\"## What\\n\\nsomething substantial enough to count as written\\nand a second line so isWritten's rule is satisfied\\n\"\n116: \tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n117: \t\tt.Fatal(err)\n118: \t}\n119: \trunGit(t, root, \"checkout\", \"-q\", \"-b\", branch)\n120: \trunGit(t, root, \"add\", \"-A\")\n121: \trunGit(t, root, \"commit\", \"-q\", \"-m\", \"[aaaa01] scaffold job\")\n122: \n123: \t// Back to main, then add the job's own linked worktree — the shape mg\n124: \t// job creates for a normal (post-worktree) job.\n125: \trunGit(t, root, \"checkout\", \"-q\", \"main\")\n126: \twt = filepath.Join(root, \".manigot-worktrees\", jobName)\n127: \trunGit(t, root, \"worktree\", \"add\", \"-q\", wt, branch)\n128: \n129: \tj = job.Job{\n130: \t\tName:   jobName,\n131: \t\tDir:    filepath.Join(wt, \"docs\", \"jobs\", jobName),\n132: \t\tRoot:   root, // the main project root — job.Discover's semantics\n133: \t\tID:     \"aaaa01\",\n134: \t\tBranch: branch,\n135: \t}\n136: \treturn root, wt, j\n137: }\n138: \n139: // writeJobFile writes content to one of the job's four files.\n140: func writeJobFile(t *testing.T, j job.Job, filename, content string) {\n141: \tt.Helper()\n142: \tif err := os.WriteFile(filepath.Join(j.Dir, filename), []byte(content), 0o644); err != nil {\n143: \t\tt.Fatal(err)\n144: \t}\n145: }\n146: \n147: func commit(t *testing.T, root, msg string) {\n148: \tt.Helper()\n149: \trunGit(t, root, \"add\", \"-A\")\n150: \trunGit(t, root, \"commit\", \"-q\", \"-m\", msg)\n151: }\n152: \n153: // fakeRunner implements AgentRunner by calling fn, which simulates an agent\n154: // invocation's effect on disk/git — the same effect a real one would have\n155: // via its own file writes and commits — and returns canned output. It also\n156: // tees the canned output into the live writer (the session.log section the\n157: // loop opened), mirroring the real runner's io.MultiWriter, so the\n158: // loop-level session.log tests exercise the full stream path.\n159: type fakeRunner struct {\n160: \troot  string\n161: \tcalls []string\n162: \tfn    func(t *testing.T, root string, j job.Job, agent string, call int) []byte\n163: \tt     *testing.T\n164: }\n165: \n166: func (f *fakeRunner) Run(agent string, j job.Job, live io.Writer) ([]byte, error) {\n167: \tf.calls = append(f.calls, agent)\n168: \tout := f.fn(f.t, f.root, j, agent, len(f.calls))\n169: \tif len(out) > 0 && live != nil {\n170: \t\tlive.Write(out)\n171: \t}\n172: \treturn out, nil\n173: }\n174: \n175: // TestRunJDIJobShortFlagAccepted pins that `-j` is a recognized alias of\n176: // `--job` in runJDI's own flag set: with no docs/ directory anywhere above\n177: // the working dir, the run must get past flag parsing (an unknown flag would\n178: // exit 2) and fail cleanly at project resolution instead.\n179: func TestRunJDIJobShortFlagAccepted(t *testing.T) {\n180: \tt.Chdir(t.TempDir())\n181: \tvar out, errOut strings.Builder\n182: \tif code := runJDI([]string{\"-j\", \"somejob\"}, &out, &errOut); code != 1 {\n183: \t\tt.Errorf(\"-j exit code = %d, want 1 (no docs/ dir); stderr:\\n%s\", code, errOut.String())\n184: \t}\n185: \tif !strings.Contains(errOut.String(), \"could not find a docs/ directory\") {\n186: \t\tt.Errorf(\"expected the no-docs error, got:\\n%s\", errOut.String())\n187: \t}\n188: }\n189: \n190: func TestRunJDIUnknownFlagRejected(t *testing.T) {\n191: \tvar out, errOut strings.Builder\n192: \tif code := runJDI([]string{\"-x\", \"somejob\"}, &out, &errOut); code != 2 {\n193: \t\tt.Errorf(\"unknown flag exit code = %d, want 2\", code)\n194: \t}\n195: }\n196: \n197: func TestRunHappyPath(t *testing.T) {\n198: \troot, j := initTestRepo(t)\n199: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n200: \t\tswitch agent {\n201: \t\tcase \"analyst\":\n202: \t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n203: \t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n204: \t\tcase \"developer\":\n205: \t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n206: \t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n207: \t\tcase \"reviewer\":\n208: \t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n209: \t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n210: \t\t}\n211: \t\treturn []byte(\"ok\")\n212: \t}}\n213: \n214: \tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n215: \tif got.Kind != orchestrate.StopFinished {\n216: \t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n217: \t}\n218: \twantCalls := []string{\"analyst\", \"developer\", \"reviewer\"}\n219: \tif strings.Join(r.calls, \",\") != strings.Join(wantCalls, \",\") {\n220: \t\tt.Errorf(\"calls = %v, want %v\", r.calls, wantCalls)\n221: \t}\n222: }\n223: \n224: // TestRunLogsAgentInvoked confirms Run writes an \"invoked\" event to the log\n225: // immediately before each agent invocation (TASK-2), reusing the same\n226: // attempt number logInvocation's own post-run header uses. The attempt is\n227: // per agent: every agent's first call is attempt 1, so the happy path reads\n228: // analyst 1 -> developer 1 -> reviewer 1, not a run-wide 1/2/3.\n229: func TestRunLogsAgentInvoked(t *testing.T) {\n230: \troot, j := initTestRepo(t)\n231: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n232: \t\tswitch agent {\n233: \t\tcase \"analyst\":\n234: \t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n235: \t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n236: \t\tcase \"developer\":\n237: \t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n238: \t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n239: \t\tcase \"reviewer\":\n240: \t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n241: \t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n242: \t\t}\n243: \t\treturn []byte(\"ok\")\n244: \t}}\n245: \n246: \tvar log bytes.Buffer\n247: \tgot := Run(root, j, r, &log, nil)\n248: \tif got.Kind != orchestrate.StopFinished {\n249: \t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n250: \t}\n251: \tout := log.String()\n252: \tfor _, want := range []string{\n253: \t\t\"analyst invoked (attempt 1)\",\n254: \t\t\"developer invoked (attempt 1)\",\n255: \t\t\"reviewer invoked (attempt 1)\",\n256: \t} {\n257: \t\tif !strings.Contains(out, want) {\n258: \t\t\tt.Errorf(\"log missing %q, got:\\n%s\", want, out)\n259: \t\t}\n260: \t}\n261: }\n262: \n263: // TestRunReportsStatus exercises Run's StatusFunc callback (TASK-8): a\n264: // job.JDIRunning report before each invocation naming that invocation's\n265: // agent, and a final job.JDIStoppedFinished report naming the last agent\n266: // that ran.\n267: func TestRunReportsStatus(t *testing.T) {\n268: \troot, j := initTestRepo(t)\n269: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n270: \t\tswitch agent {\n271: \t\tcase \"analyst\":\n272: \t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n273: \t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n274: \t\tcase \"developer\":\n275: \t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n276: \t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n277: \t\tcase \"reviewer\":\n278: \t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n279: \t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n280: \t\t}\n281: \t\treturn []byte(\"ok\")\n282: \t}}\n283: \n284: \ttype report struct {\n285: \t\tstate job.JDIState\n286: \t\tagent string\n287: \t}\n288: \tvar reports []report\n289: \tstatus := func(state job.JDIState, agent string) {\n290: \t\treports = append(reports, report{state, agent})\n291: \t}\n292: \n293: \tgot := Run(root, j, r, &bytes.Buffer{}, status)\n294: \tif got.Kind != orchestrate.StopFinished {\n295: \t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n296: \t}\n297: \n298: \twant := []report{\n299: \t\t{job.JDIRunning, \"analyst\"},\n300: \t\t{job.JDIRunning, \"developer\"},\n301: \t\t{job.JDIRunning, \"reviewer\"},\n302: \t\t{job.JDIStoppedFinished, \"reviewer\"},\n303: \t}\n304: \tif len(reports) != len(want) {\n305: \t\tt.Fatalf(\"reports = %+v, want %+v\", reports, want)\n306: \t}\n307: \tfor i, w := range want {\n308: \t\tif reports[i] != w {\n309: \t\t\tt.Errorf(\"reports[%d] = %+v, want %+v\", i, reports[i], w)\n310: \t\t}\n311: \t}\n312: }\n313: \n314: // TestRunOneBounceThenApproved covers the bounce path: a rejected review\n315: // sends control back to the developer once, and a second approved review\n316: // ends the run. The log headers assert the per-agent attempt semantics that\n317: // motivated the brief — the developer's second call is that developer's\n318: // attempt 2, NOT attempt 4 as a run-wide counter would produce, and the\n319: // reviewer's first call is attempt 1 — with each invocation's invoked and\n320: // finished headers sharing the same number.\n321: func TestRunOneBounceThenApproved(t *testing.T) {\n322: \troot, j := initTestRepo(t)\n323: \twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n324: \tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n325: \n326: \treviewCalls := 0\n327: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n328: \t\tswitch agent {\n329: \t\tcase \"developer\":\n330: \t\t\twriteJobFile(t, j, \"implementation.md\", fmt.Sprintf(\"# Implementation\\n\\nTASK-1: attempt %d\\n\", call))\n331: \t\t\tcommit(t, root, fmt.Sprintf(\"[aaaa01] TASK-1: attempt %d\", call))\n332: \t\tcase \"reviewer\":\n333: \t\t\treviewCalls++\n334: \t\t\tif reviewCalls == 1 {\n335: \t\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: FAIL\\n\\n## Overall\\n\\nNEEDS WORK\\n\")\n336: \t\t\t\tcommit(t, root, \"[aaaa01] verdict: needs work\")\n337: \t\t\t} else {\n338: \t\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n339: \t\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n340: \t\t\t}\n341: \t\t}\n342: \t\treturn []byte(\"ok\")\n343: \t}}\n344: \n345: \tvar log bytes.Buffer\n346: \tgot := Run(root, j, r, &log, nil)\n347: \tif got.Kind != orchestrate.StopFinished {\n348: \t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n349: \t}\n350: \twantCalls := []string{\"developer\", \"reviewer\", \"developer\", \"reviewer\"}\n351: \tif strings.Join(r.calls, \",\") != strings.Join(wantCalls, \",\") {\n352: \t\tt.Errorf(\"calls = %v, want %v\", r.calls, wantCalls)\n353: \t}\n354: \n355: \t// Per-agent attempts on the bounce path: each agent's first call is\n356: \t// attempt 1 and the bounced-back developer's second call is attempt 2 —\n357: \t// not attempt 4 as the old run-wide i+1 counter produced. The invoked and\n358: \t// finished headers of one invocation share the same number.\n359: \tassertLogOrder(t, log.String(), []string{\n360: \t\t\"developer invoked (attempt 1)\",\n361: \t\t\"developer finished (attempt 1)\",\n362: \t\t\"reviewer invoked (attempt 1)\",\n363: \t\t\"reviewer finished (attempt 1)\",\n364: \t\t\"developer invoked (attempt 2)\",\n365: \t\t\"developer finished (attempt 2)\",\n366: \t\t\"reviewer invoked (attempt 2)\",\n367: \t\t\"reviewer finished (attempt 2)\",\n368: \t})\n369: }\n370: \n371: func TestRunStopsAfterOneBounceExhausted(t *testing.T) {\n372: \troot, j := initTestRepo(t)\n373: \twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n374: \tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n375: \n376: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n377: \t\tswitch agent {\n378: \t\tcase \"developer\":\n379: \t\t\twriteJobFile(t, j, \"implementation.md\", fmt.Sprintf(\"# Implementation\\n\\nTASK-1: attempt %d\\n\", call))\n380: \t\t\tcommit(t, root, fmt.Sprintf(\"[aaaa01] TASK-1: attempt %d\", call))\n381: \t\tcase \"reviewer\":\n382: \t\t\twriteJobFile(t, j, \"verdict.md\", fmt.Sprintf(\"# Verdict\\n\\nTASK-1: FAIL (attempt %d)\\n\\n## Overall\\n\\nREJECTED\\n\", call))\n383: \t\t\tcommit(t, root, fmt.Sprintf(\"[aaaa01] verdict: rejected (attempt %d)\", call))\n384: \t\t}\n385: \t\treturn []byte(\"ok\")\n386: \t}}\n387: \n388: \tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n389: \tif got.Kind != orchestrate.StopNeedsHuman {\n390: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman (reason: %s)\", got.Kind, got.Reason)\n391: \t}\n392: \tif !strings.Contains(got.Reason, \"review cycle\") {\n393: \t\tt.Errorf(\"Reason = %q, want it to contain \\\"review cycle\\\"\", got.Reason)\n394: \t}\n395: \t// developer, reviewer (round 1, rejected), developer (the one allowed\n396: \t// bounce), reviewer (round 2, rejected again) — then stop, no third\n397: \t// developer bounce.\n398: \twantCalls := []string{\"developer\", \"reviewer\", \"developer\", \"reviewer\"}\n399: \tif strings.Join(r.calls, \",\") != strings.Join(wantCalls, \",\") {\n400: \t\tt.Errorf(\"calls = %v, want %v\", r.calls, wantCalls)\n401: \t}\n402: \tcount, err := git.CountVerdictCommits(root, j.Branch, j.ID)\n403: \tif err != nil {\n404: \t\tt.Fatal(err)\n405: \t}\n406: \tif count != 2 {\n407: \t\tt.Errorf(\"verdict commit count = %d, want 2\", count)\n408: \t}\n409: }\n410: \n411: func TestRunStopsOnNeedsHumanMarker(t *testing.T) {\n412: \troot, j := initTestRepo(t)\n413: \n414: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n415: \t\treturn []byte(\"I looked at the brief.\\nNEEDS-HUMAN-INPUT: which auth provider should this use?\\n\")\n416: \t}}\n417: \n418: \tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n419: \tif got.Kind != orchestrate.StopNeedsHuman {\n420: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n421: \t}\n422: \tif !strings.Contains(got.Reason, \"which auth provider should this use?\") {\n423: \t\tt.Errorf(\"Reason = %q, want it to contain the marker's reason text\", got.Reason)\n424: \t}\n425: \tif len(r.calls) != 1 {\n426: \t\tt.Errorf(\"calls = %v, want exactly one invocation (stopped immediately)\", r.calls)\n427: \t}\n428: }\n429: \n430: // TestRunStopsOnNeedsHumanMarkerInOpenCodeJSONL proves the marker detection\n431: // holds at the loop level against the real `opencode run --format json`\n432: // JSONL shape — a stream of typed events whose response prose lives in a\n433: // \"text\"-event's part.text (see orchestrate.realOpenCodeJSONL) — not just\n434: // against the plain-text / Claude-JSON shapes the other marker tests use.\n435: // It also pins the run.log contract for an opencode-driven run: the log must\n436: // show the extracted prose (ResultText), never the raw JSONL blob — while the\n437: // job's session.log holds the raw stream verbatim (the \"are we actually\n438: // grabbing the output\" answer for opencode).\n439: func TestRunStopsOnNeedsHumanMarkerInOpenCodeJSONL(t *testing.T) {\n440: \troot, j := initTestRepo(t)\n441: \n442: \t// A minimal but real `opencode run --format json` output (the 3-line\n443: \t// step_start/text/step_finish shape captured live in the 63quv2\n444: \t// verification), with the marker inside the text event's part.text.\n445: \tconst realShape = `{\"type\":\"step_start\",\"part\":{\"type\":\"step-start\"}}\n446: {\"type\":\"text\",\"part\":{\"type\":\"text\",\"text\":\"Looked at tasks.md.\\nNEEDS-HUMAN-INPUT: which auth provider should this use?\"}}\n447: {\"type\":\"step_finish\",\"part\":{\"type\":\"step-finish\",\"reason\":\"stop\"}}\n448: `\n449: \n450: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n451: \t\treturn []byte(realShape)\n452: \t}}\n453: \n454: \tvar log bytes.Buffer\n455: \tgot := Run(root, j, r, &log, nil)\n456: \tif got.Kind != orchestrate.StopNeedsHuman {\n457: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n458: \t}\n459: \tif !strings.Contains(got.Reason, \"which auth provider should this use?\") {\n460: \t\tt.Errorf(\"Reason = %q, want it to contain the marker's reason text\", got.Reason)\n461: \t}\n462: \tif len(r.calls) != 1 {\n463: \t\tt.Errorf(\"calls = %v, want exactly one invocation (stopped immediately)\", r.calls)\n464: \t}\n465: \tout := log.String()\n466: \tif strings.Contains(out, `\"type\":\"step_start\"`) || strings.Contains(out, `{\"type\":\"text\"`) {\n467: \t\tt.Errorf(\"run.log contains raw JSONL, want the extracted prose (ResultText):\\n%s\", out)\n468: \t}\n469: \tif !strings.Contains(out, \"which auth provider should this use?\") {\n470: \t\tt.Errorf(\"run.log missing the marker reason prose, got:\\n%s\", out)\n471: \t}\n472: \t// The raw stream (the truth) also lands in the job's session.log: the\n473: \t// capture path persists the full JSONL verbatim — every event line of the\n474: \t// opencode-shaped stream, run.log's extracted-prose summary\n475: \t// notwithstanding.\n476: \tsess, err := os.ReadFile(filepath.Join(j.Dir, \"session.log\"))\n477: \tif err != nil {\n478: \t\tt.Fatalf(\"reading session.log: %v\", err)\n479: \t}\n480: \tfor _, line := range strings.Split(strings.TrimSpace(realShape), \"\\n\") {\n481: \t\tif !strings.Contains(string(sess), line) {\n482: \t\t\tt.Errorf(\"session.log missing raw JSONL line %q, got:\\n%s\", line, sess)\n483: \t\t}\n484: \t}\n485: }\n486: \n487: func TestRunStopsOnStall(t *testing.T) {\n488: \troot, j := initTestRepo(t)\n489: \n490: \t// analyst \"runs\" but writes/commits nothing at all — Stage() and HEAD\n491: \t// stay unchanged, so the second consecutive analyst invocation must\n492: \t// trip the stall backstop rather than loop forever.\n493: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n494: \t\treturn []byte(\"thinking out loud, not sure what to do\")\n495: \t}}\n496: \n497: \tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n498: \tif got.Kind != orchestrate.StopNeedsHuman {\n499: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n500: \t}\n501: \tif !strings.Contains(got.Reason, \"no progress\") {\n502: \t\tt.Errorf(\"Reason = %q, want it to mention no progress\", got.Reason)\n503: \t}\n504: \tif len(r.calls) != 2 {\n505: \t\tt.Errorf(\"calls = %v, want exactly two invocations (stall detected on the second)\", r.calls)\n506: \t}\n507: }\n508: \n509: // TestRunStallProbeUsesFreshContext pins the stall backstop against a\n510: // regression where the post-agent HEAD probe reused the pre-agent probe\n511: // context: an agent invocation (runner.Run) takes minutes in production, so\n512: // by the time the probe ran the 10s context was long expired and the probe\n513: // returned \"\" — headAfter never equaled headBefore, noChange was always\n514: // false, and a genuinely stuck agent ran to maxIterations instead of\n515: // stopping after two no-op invocations. The test simulates that by lowering\n516: // jdiProbeTimeout and making the fake runner's Run outlive it (but write\n517: // nothing), then asserting the backstop still fires: it can only if the\n518: // post-agent probe used a fresh context.\n519: func TestRunStallProbeUsesFreshContext(t *testing.T) {\n520: \troot, j := initTestRepo(t)\n521: \n522: \torig := jdiProbeTimeout\n523: \tjdiProbeTimeout = 200 * time.Millisecond\n524: \tt.Cleanup(func() { jdiProbeTimeout = orig })\n525: \n526: \t// The fake agent \"runs\" longer than the probe timeout and writes\n527: \t// nothing at all — exactly the production shape of a stuck agent. 600ms\n528: \t// comfortably outlives the 200ms probe timeout, and 200ms leaves the\n529: \t// pre-agent probes (three fast, real git execs sharing the loop-top\n530: \t// context) plenty of room to complete within it even on a loaded CI\n531: \t// machine.\n532: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n533: \t\ttime.Sleep(600 * time.Millisecond)\n534: \t\treturn []byte(\"thinking out loud, not sure what to do\")\n535: \t}}\n536: \n537: \tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n538: \tif got.Kind != orchestrate.StopNeedsHuman {\n539: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n540: \t}\n541: \tif !strings.Contains(got.Reason, \"no progress\") {\n542: \t\tt.Errorf(\"Reason = %q, want it to mention no progress\", got.Reason)\n543: \t}\n544: \tif len(r.calls) != 2 {\n545: \t\tt.Errorf(\"calls = %v, want exactly two invocations (stall detected on the second, not looped to maxIterations)\", r.calls)\n546: \t}\n547: }\n548: \n549: func TestRunStopsOnRunnerError(t *testing.T) {\n550: \troot, j := initTestRepo(t)\n551: \twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n552: \tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n553: \n554: \tr := &errRunner{}\n555: \tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n556: \tif got.Kind != orchestrate.StopNeedsHuman {\n557: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n558: \t}\n559: \tif !strings.Contains(got.Reason, \"boom\") {\n560: \t\tt.Errorf(\"Reason = %q, want it to mention the runner error\", got.Reason)\n561: \t}\n562: }\n563: \n564: // TestRunLogsImmediateStopReason confirms an immediate stop — Next()\n565: // returning a Stop* decision before any agent has ever run, e.g. a\n566: // genuinely-unwritten brief.md — writes its Reason to the log, not just to\n567: // mg jdi's own return value. Before this fix, this case left the log at 0\n568: // bytes, which read as \"mg jdi didn't do anything at all\" rather than \"mg\n569: // jdi correctly stopped immediately, here's why\".\n570: func TestRunLogsImmediateStopReason(t *testing.T) {\n571: \troot, j := initTestRepo(t)\n572: \t// Overwrite brief.md with the genuinely-unwritten scaffold shape (no\n573: \t// substantive content at all) so Stage() reports StageDefine and Next\n574: \t// stops before ever invoking an agent.\n575: \twriteJobFile(t, j, \"brief.md\", \"# Brief: test job\\n\\nstatus: open\\ntype: feature\\nid: aaaa01\\n\\n\"+\n576: \t\t\"## What\\n\\n<!-- placeholder -->\\n\")\n577: \tcommit(t, root, \"[aaaa01] brief: reset to scaffold\")\n578: \n579: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n580: \t\tt.Fatal(\"no agent should have been invoked for an immediate stop\")\n581: \t\treturn nil\n582: \t}}\n583: \n584: \tvar log bytes.Buffer\n585: \tgot := Run(root, j, r, &log, nil)\n586: \tif got.Kind != orchestrate.StopNeedsHuman {\n587: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman (reason: %s)\", got.Kind, got.Reason)\n588: \t}\n589: \tif len(r.calls) != 0 {\n590: \t\tt.Fatalf(\"calls = %v, want no invocations (immediate stop)\", r.calls)\n591: \t}\n592: \tif log.Len() == 0 {\n593: \t\tt.Fatal(\"run.log is empty, want it to contain the immediate-stop reason\")\n594: \t}\n595: \tif !strings.Contains(log.String(), got.Reason) {\n596: \t\tt.Errorf(\"log = %q, want it to contain the stop reason %q\", log.String(), got.Reason)\n597: \t}\n598: }\n599: \n600: // TestRunLogsJobFinishedOnNormalStop confirms Run writes a \"job finished\"\n601: // event to the log at loop exit (TASK-4) once an agent has actually run —\n602: // distinct from the immediate-stop case covered by\n603: // TestRunLogsImmediateStopReason below, which must not repeat the same\n604: // reason text twice in a row.\n605: func TestRunLogsJobFinishedOnNormalStop(t *testing.T) {\n606: \troot, j := initTestRepo(t)\n607: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n608: \t\tswitch agent {\n609: \t\tcase \"analyst\":\n610: \t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n611: \t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n612: \t\tcase \"developer\":\n613: \t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n614: \t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n615: \t\tcase \"reviewer\":\n616: \t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n617: \t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n618: \t\t}\n619: \t\treturn []byte(\"ok\")\n620: \t}}\n621: \n622: \tvar log bytes.Buffer\n623: \tgot := Run(root, j, r, &log, nil)\n624: \tif got.Kind != orchestrate.StopFinished {\n625: \t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n626: \t}\n627: \tout := log.String()\n628: \tif !strings.Contains(out, \"mg jdi finished: stop-finished\") {\n629: \t\tt.Errorf(\"log missing job-finished event, got:\\n%s\", out)\n630: \t}\n631: \tif !strings.Contains(out, got.Reason) {\n632: \t\tt.Errorf(\"log missing the finish reason %q, got:\\n%s\", got.Reason, out)\n633: \t}\n634: }\n635: \n636: // TestRunImmediateStopDoesNotDuplicateReason extends\n637: // TestRunLogsImmediateStopReason: TASK-4's \"job finished\" event must still\n638: // fire for the stop-before-any-agent-ran case, but must not print the same\n639: // reason text logImmediateStop already printed a second time.\n640: func TestRunImmediateStopDoesNotDuplicateReason(t *testing.T) {\n641: \troot, j := initTestRepo(t)\n642: \twriteJobFile(t, j, \"brief.md\", \"# Brief: test job\\n\\nstatus: open\\ntype: feature\\nid: aaaa01\\n\\n\"+\n643: \t\t\"## What\\n\\n<!-- placeholder -->\\n\")\n644: \tcommit(t, root, \"[aaaa01] brief: reset to scaffold\")\n645: \n646: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n647: \t\tt.Fatal(\"no agent should have been invoked for an immediate stop\")\n648: \t\treturn nil\n649: \t}}\n650: \n651: \tvar log bytes.Buffer\n652: \tgot := Run(root, j, r, &log, nil)\n653: \tif got.Kind != orchestrate.StopNeedsHuman {\n654: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman (reason: %s)\", got.Kind, got.Reason)\n655: \t}\n656: \tout := log.String()\n657: \tif !strings.Contains(out, \"mg jdi finished: stop-needs-human\") {\n658: \t\tt.Errorf(\"log missing job-finished event, got:\\n%s\", out)\n659: \t}\n660: \tif strings.Count(out, got.Reason) != 1 {\n661: \t\tt.Errorf(\"reason %q appears %d times in log, want exactly 1 (not duplicated between logImmediateStop and logJobFinished):\\n%s\", got.Reason, strings.Count(out, got.Reason), out)\n662: \t}\n663: }\n664: \n665: // assertLogOrder fails the test unless every substring in wantInOrder\n666: // appears in out, each strictly after the previous one — i.e. out reads as\n667: // wantInOrder describes, start to finish.\n668: func assertLogOrder(t *testing.T, out string, wantInOrder []string) {\n669: \tt.Helper()\n670: \tpos := 0\n671: \tfor _, want := range wantInOrder {\n672: \t\tidx := strings.Index(out[pos:], want)\n673: \t\tif idx == -1 {\n674: \t\t\tt.Fatalf(\"log missing %q after position %d, want it in order %v; full log:\\n%s\", want, pos, wantInOrder, out)\n675: \t\t}\n676: \t\tpos += idx + len(want)\n677: \t}\n678: }\n679: \n680: // TestRunFullLogSequenceHappyPath is TASK-6's end-to-end coverage: a full\n681: // mg-jdi run (mimicking main()'s own logStarted call ahead of Run) produces\n682: // the complete started -> invoked -> finished -> ... -> job finished\n683: // sequence the brief asked for, not just each event in isolation.\n684: func TestRunFullLogSequenceHappyPath(t *testing.T) {\n685: \troot, j := initTestRepo(t)\n686: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n687: \t\tswitch agent {\n688: \t\tcase \"analyst\":\n689: \t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n690: \t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n691: \t\t\treturn []byte(\"Wrote tasks.md with one task.\")\n692: \t\tcase \"developer\":\n693: \t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n694: \t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n695: \t\t\treturn []byte(\"Implemented TASK-1, all tests pass.\")\n696: \t\tcase \"reviewer\":\n697: \t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n698: \t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n699: \t\t\treturn []byte(\"Reviewed and approved.\")\n700: \t\t}\n701: \t\treturn nil\n702: \t}}\n703: \n704: \tvar log bytes.Buffer\n705: \tlogStarted(&log, j.Name, \"claude-pro\")\n706: \tgot := Run(root, j, r, &log, nil)\n707: \tif got.Kind != orchestrate.StopFinished {\n708: \t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n709: \t}\n710: \n711: \tassertLogOrder(t, log.String(), []string{\n712: \t\t\"mg jdi started\",\n713: \t\t\"analyst invoked (attempt 1)\",\n714: \t\t\"analyst finished (attempt 1)\",\n715: \t\t\"Wrote tasks.md with one task.\",\n716: \t\t\"developer invoked (attempt 1)\",\n717: \t\t\"developer finished (attempt 1)\",\n718: \t\t\"Implemented TASK-1, all tests pass.\",\n719: \t\t\"reviewer invoked (attempt 1)\",\n720: \t\t\"reviewer finished (attempt 1)\",\n721: \t\t\"Reviewed and approved.\",\n722: \t\t\"mg jdi finished: stop-finished\",\n723: \t})\n724: }\n725: \n726: // TestRunFullLogSequenceDedupsMatchingOutput is TASK-6's dedup-case\n727: // end-to-end coverage: when an agent's response text is just an echo of the\n728: // file it wrote (TASK-5), the full sequence still reads started -> invoked\n729: // -> finished -> ... -> job finished, but the finished body is the short\n730: // omission note instead of the file's full content repeated in the log.\n731: func TestRunFullLogSequenceDedupsMatchingOutput(t *testing.T) {\n732: \troot, j := initTestRepo(t)\n733: \tconst tasksContent = \"# Tasks\\n\\nTASK-1: do the thing\\n\"\n734: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n735: \t\tswitch agent {\n736: \t\tcase \"analyst\":\n737: \t\t\twriteJobFile(t, j, \"tasks.md\", tasksContent)\n738: \t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n739: \t\t\treturn []byte(tasksContent)\n740: \t\tcase \"developer\":\n741: \t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n742: \t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n743: \t\t\treturn []byte(\"done\")\n744: \t\tcase \"reviewer\":\n745: \t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n746: \t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n747: \t\t\treturn []byte(\"done\")\n748: \t\t}\n749: \t\treturn nil\n750: \t}}\n751: \n752: \tvar log bytes.Buffer\n753: \tlogStarted(&log, j.Name, \"claude-pro\")\n754: \tgot := Run(root, j, r, &log, nil)\n755: \tif got.Kind != orchestrate.StopFinished {\n756: \t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n757: \t}\n758: \n759: \tout := log.String()\n760: \tassertLogOrder(t, out, []string{\n761: \t\t\"mg jdi started\",\n762: \t\t\"analyst invoked (attempt 1)\",\n763: \t\t\"analyst finished (attempt 1)\",\n764: \t\t\"(output matches tasks.md, omitted)\",\n765: \t\t\"developer invoked (attempt 1)\",\n766: \t\t\"developer finished (attempt 1)\",\n767: \t\t\"reviewer invoked (attempt 1)\",\n768: \t\t\"reviewer finished (attempt 1)\",\n769: \t\t\"mg jdi finished: stop-finished\",\n770: \t})\n771: \tif strings.Contains(out, \"TASK-1: do the thing\") {\n772: \t\tt.Errorf(\"log = %q, want tasks.md's content not repeated verbatim (should be omitted)\", out)\n773: \t}\n774: }\n775: \n776: type errRunner struct{}\n777: \n778: func (errRunner) Run(agent string, j job.Job, live io.Writer) ([]byte, error) {\n779: \treturn nil, errors.New(\"boom\")\n780: }\n781: \n782: // TestCommandAgentRunnerUsesGivenProfile confirms commandAgentRunner builds\n783: // its --print session invocation with the profile it was constructed with\n784: // (TASK-5), rather than the old hardcoded config.ProfileClaudePro pin —\n785: // exercised for a non-default profile so a stale pin would be caught. Since\n786: // the runner now calls the session package in-process (no run.sh exec), the\n787: // pinned profile is asserted on the constructed options, and a full Run\n788: // against the test repo must reach the docker launch (which fails with a\n789: // docker-not-found error here) rather than a profile/auth/resolution error.\n790: func TestCommandAgentRunnerUsesGivenProfile(t *testing.T) {\n791: \troot, j := initTestRepo(t)\n792: \n793: \tr := &commandAgentRunner{projectRoot: root, profile: \"zai\"}\n794: \topts := r.agentInvocation(\"developer\", j)\n795: \tif opts.Profile != \"zai\" {\n796: \t\tt.Errorf(\"invocation profile = %q, want zai\", opts.Profile)\n797: \t}\n798: \tif opts.Agent != \"developer\" || opts.Job != j.Name || !opts.Print {\n799: \t\tt.Errorf(\"invocation = %+v\", opts)\n800: \t}\n801: }\n802: \n803: // notifyRequest is one HTTP request the fake ntfy server captured.\n804: type notifyRequest struct {\n805: \tmethod  string\n806: \tpath    string\n807: \tbody    string\n808: \theaders http.Header\n809: }\n810: \n811: // newNotifyCapture starts an httptest server recording every request it\n812: // receives (method, path, headers, body) and replying with status, so tests\n813: // can assert on exactly what notifyStop/notifyCrashedRun sent.\n814: func newNotifyCapture(t *testing.T, status int) (*httptest.Server, *[]notifyRequest) {\n815: \tt.Helper()\n816: \tvar got []notifyRequest\n817: \tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n818: \t\tbody, _ := io.ReadAll(r.Body)\n819: \t\tgot = append(got, notifyRequest{method: r.Method, path: r.URL.Path, body: string(body), headers: r.Header.Clone()})\n820: \t\tw.WriteHeader(status)\n821: \t}))\n822: \tt.Cleanup(srv.Close)\n823: \treturn srv, &got\n824: }\n825: \n826: // configureNtfy points the ntfy config (internal/notify's FromConfig, which\n827: // reads config.EnvValue) at the test server by setting the process env the\n828: // .env-less fake checkout falls back to.\n829: func configureNtfy(t *testing.T, srvURL, topic, token string) {\n830: \tt.Helper()\n831: \tt.Setenv(\"NTFY_URL\", srvURL)\n832: \tt.Setenv(\"NTFY_TOPIC\", topic)\n833: \tt.Setenv(\"NTFY_TOKEN\", token)\n834: }\n835: \n836: func TestNotifyStopFinished(t *testing.T) {\n837: \tprofileCheckout(t, \"\")\n838: \tsrv, got := newNotifyCapture(t, http.StatusOK)\n839: \tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n840: \n841: \tvar stderr bytes.Buffer\n842: \tnotifyStop(&stderr, \"aaaa01_test-job\", LoopResult{Kind: orchestrate.StopFinished, Reason: \"verdict.md's Overall verdict is APPROVED\"})\n843: \n844: \tif len(*got) != 1 {\n845: \t\tt.Fatalf(\"received %d requests, want 1\", len(*got))\n846: \t}\n847: \treq := (*got)[0]\n848: \tif req.headers.Get(\"Tags\") != \"white_check_mark\" {\n849: \t\tt.Errorf(\"Tags header = %q, want white_check_mark\", req.headers.Get(\"Tags\"))\n850: \t}\n851: \tif req.headers.Get(\"Priority\") != \"\" {\n852: \t\tt.Errorf(\"Priority header = %q, want unset (default priority) for a success\", req.headers.Get(\"Priority\"))\n853: \t}\n854: \tif !strings.Contains(req.headers.Get(\"Title\"), \"aaaa01_test-job\") {\n855: \t\tt.Errorf(\"Title header = %q, want it to contain the job name\", req.headers.Get(\"Title\"))\n856: \t}\n857: \tif !strings.Contains(req.body, \"APPROVED\") {\n858: \t\tt.Errorf(\"body = %q, want it to contain the stop reason\", req.body)\n859: \t}\n860: \tif stderr.Len() != 0 {\n861: \t\tt.Errorf(\"stderr = %q, want empty\", stderr.String())\n862: \t}\n863: }\n864: \n865: func TestNotifyStopNeedsHuman(t *testing.T) {\n866: \tprofileCheckout(t, \"\")\n867: \tsrv, got := newNotifyCapture(t, http.StatusOK)\n868: \tconfigureNtfy(t, srv.URL, \"my-topic\", \"tok\")\n869: \n870: \tvar stderr bytes.Buffer\n871: \tnotifyStop(&stderr, \"aaaa01_test-job\", LoopResult{Kind: orchestrate.StopNeedsHuman, Reason: \"analyst made no progress on two consecutive runs\"})\n872: \n873: \tif len(*got) != 1 {\n874: \t\tt.Fatalf(\"received %d requests, want 1\", len(*got))\n875: \t}\n876: \treq := (*got)[0]\n877: \tif req.headers.Get(\"Tags\") != \"warning\" {\n878: \t\tt.Errorf(\"Tags header = %q, want warning\", req.headers.Get(\"Tags\"))\n879: \t}\n880: \tif req.headers.Get(\"Priority\") != \"4\" {\n881: \t\tt.Errorf(\"Priority header = %q, want 4 (high priority) for needs-human\", req.headers.Get(\"Priority\"))\n882: \t}\n883: \tif req.headers.Get(\"Authorization\") != \"Bearer tok\" {\n884: \t\tt.Errorf(\"Authorization header = %q, want %q\", req.headers.Get(\"Authorization\"), \"Bearer tok\")\n885: \t}\n886: \tif !strings.Contains(req.headers.Get(\"Title\"), \"needs attention\") {\n887: \t\tt.Errorf(\"Title header = %q, want it to say needs attention\", req.headers.Get(\"Title\"))\n888: \t}\n889: \tif !strings.Contains(req.body, \"no progress\") {\n890: \t\tt.Errorf(\"body = %q, want it to contain the stop reason\", req.body)\n891: \t}\n892: }\n893: \n894: func TestNotifyStopUnconfiguredSendsNothing(t *testing.T) {\n895: \tprofileCheckout(t, \"\")\n896: \tsrv, got := newNotifyCapture(t, http.StatusOK)\n897: \tconfigureNtfy(t, srv.URL, \"\", \"\") // no NTFY_TOPIC → feature off\n898: \n899: \tvar stderr bytes.Buffer\n900: \tnotifyStop(&stderr, \"aaaa01_test-job\", LoopResult{Kind: orchestrate.StopNeedsHuman, Reason: \"stalled\"})\n901: \n902: \tif len(*got) != 0 {\n903: \t\tt.Errorf(\"received %d requests, want 0 (unconfigured must be a strict no-op)\", len(*got))\n904: \t}\n905: \tif stderr.Len() != 0 {\n906: \t\tt.Errorf(\"stderr = %q, want empty\", stderr.String())\n907: \t}\n908: }\n909: \n910: func TestNotifyStopSendFailureWarnsButDoesNotAbort(t *testing.T) {\n911: \tprofileCheckout(t, \"\")\n912: \tsrv, _ := newNotifyCapture(t, http.StatusInternalServerError)\n913: \tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n914: \n915: \tvar stderr bytes.Buffer\n916: \tnotifyStop(&stderr, \"aaaa01_test-job\", LoopResult{Kind: orchestrate.StopFinished, Reason: \"done\"})\n917: \n918: \tout := stderr.String()\n919: \tif !strings.Contains(out, \"mg jdi: warning: could not send ntfy notification\") {\n920: \t\tt.Errorf(\"stderr = %q, want a 'could not send ntfy notification' warning\", out)\n921: \t}\n922: }\n923: \n924: // writeStaleRunningSidecar plants an old JDIRunning sidecar — the on-disk\n925: // signature of an mg-jdi run that was killed without ever reporting a stop\n926: // (job.jdiRunningStaleAfter is 30 minutes, so 2 hours is safely stale).\n927: func writeStaleRunningSidecar(t *testing.T, root, jobName string) {\n928: \tt.Helper()\n929: \tif err := os.MkdirAll(job.JDIStatusDir(root, jobName), 0o755); err != nil {\n930: \t\tt.Fatal(err)\n931: \t}\n932: \tstale := time.Now().Add(-2 * time.Hour).UTC().Format(time.RFC3339)\n933: \tbody := `{\"state\":\"running\",\"agent\":\"developer\",\"updated\":\"` + stale + `\"}`\n934: \tif err := os.WriteFile(job.JDIStatusPath(root, jobName), []byte(body), 0o644); err != nil {\n935: \t\tt.Fatal(err)\n936: \t}\n937: }\n938: \n939: func TestNotifyCrashedRunNotifiesAndDedups(t *testing.T) {\n940: \tprofileCheckout(t, \"\")\n941: \tsrv, got := newNotifyCapture(t, http.StatusOK)\n942: \tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n943: \troot := t.TempDir()\n944: \tconst jobName = \"aaaa01_test-job\"\n945: \twriteStaleRunningSidecar(t, root, jobName)\n946: \tj := job.Job{Name: jobName, Root: root}\n947: \n948: \tvar stderr bytes.Buffer\n949: \tnotifyCrashedRun(&stderr, root, j)\n950: \n951: \tif len(*got) != 1 {\n952: \t\tt.Fatalf(\"received %d requests, want 1 (the crash notification)\", len(*got))\n953: \t}\n954: \treq := (*got)[0]\n955: \tif req.headers.Get(\"Tags\") != \"warning\" {\n956: \t\tt.Errorf(\"Tags header = %q, want warning\", req.headers.Get(\"Tags\"))\n957: \t}\n958: \tif req.headers.Get(\"Priority\") != \"4\" {\n959: \t\tt.Errorf(\"Priority header = %q, want 4 (high priority) for a crash\", req.headers.Get(\"Priority\"))\n960: \t}\n961: \tif !strings.Contains(req.headers.Get(\"Title\"), jobName) {\n962: \t\tt.Errorf(\"Title header = %q, want it to contain the job name\", req.headers.Get(\"Title\"))\n963: \t}\n964: \tif !strings.Contains(req.body, \"crashed or been killed\") {\n965: \t\tt.Errorf(\"body = %q, want it to describe the crash\", req.body)\n966: \t}\n967: \tif !strings.Contains(req.body, \"Last agent: developer\") {\n968: \t\tt.Errorf(\"body = %q, want it to name the last agent\", req.body)\n969: \t}\n970: \tif stderr.Len() != 0 {\n971: \t\tt.Errorf(\"stderr = %q, want empty\", stderr.String())\n972: \t}\n973: \n974: \t// The stale sidecar is overwritten with a stopped state, so a second\n975: \t// start must not re-notify about the same already-known crash.\n976: \tnotifyCrashedRun(&stderr, root, j)\n977: \tif len(*got) != 1 {\n978: \t\tt.Errorf(\"received %d requests after dedup, want still 1\", len(*got))\n979: \t}\n980: \tif st, ok := job.ReadJDIStatus(root, jobName); !ok || st.State != job.JDIStoppedNeedsHuman {\n981: \t\tt.Errorf(\"sidecar after dedup = %+v (ok=%v), want stopped:needs-human\", st, ok)\n982: \t}\n983: }\n984: \n985: func TestNotifyCrashedRunFreshRunningDoesNotNotify(t *testing.T) {\n986: \tprofileCheckout(t, \"\")\n987: \tsrv, got := newNotifyCapture(t, http.StatusOK)\n988: \tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n989: \troot := t.TempDir()\n990: \tconst jobName = \"aaaa01_test-job\"\n991: \t// A fresh running status means a live mg-jdi run — must not be reported\n992: \t// as a crash.\n993: \tif err := job.WriteJDIStatus(root, jobName, job.JDIRunning, \"analyst\"); err != nil {\n994: \t\tt.Fatal(err)\n995: \t}\n996: \n997: \tvar stderr bytes.Buffer\n998: \tnotifyCrashedRun(&stderr, root, job.Job{Name: jobName, Root: root})\n999: \n1000: \tif len(*got) != 0 {\n1001: \t\tt.Errorf(\"received %d requests, want 0 (a live run is not a crash)\", len(*got))\n1002: \t}\n1003: \tif stderr.Len() != 0 {\n1004: \t\tt.Errorf(\"stderr = %q, want empty\", stderr.String())\n1005: \t}\n1006: }\n1007: \n1008: func TestNotifyCrashedRunStoppedStatusDoesNotNotify(t *testing.T) {\n1009: \tprofileCheckout(t, \"\")\n1010: \tsrv, got := newNotifyCapture(t, http.StatusOK)\n1011: \tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n1012: \troot := t.TempDir()\n1013: \tconst jobName = \"aaaa01_test-job\"\n1014: \tif err := job.WriteJDIStatus(root, jobName, job.JDIStoppedFinished, \"reviewer\"); err != nil {\n1015: \t\tt.Fatal(err)\n1016: \t}\n1017: \n1018: \tvar stderr bytes.Buffer\n1019: \tnotifyCrashedRun(&stderr, root, job.Job{Name: jobName, Root: root})\n1020: \n1021: \tif len(*got) != 0 {\n1022: \t\tt.Errorf(\"received %d requests, want 0 (a stopped run is not a crash)\", len(*got))\n1023: \t}\n1024: }\n1025: \n1026: func TestNotifyCrashedRunUnconfiguredLeavesSidecarUntouched(t *testing.T) {\n1027: \tprofileCheckout(t, \"\")\n1028: \tsrv, got := newNotifyCapture(t, http.StatusOK)\n1029: \tconfigureNtfy(t, srv.URL, \"\", \"\") // no NTFY_TOPIC → feature off\n1030: \troot := t.TempDir()\n1031: \tconst jobName = \"aaaa01_test-job\"\n1032: \twriteStaleRunningSidecar(t, root, jobName)\n1033: \n1034: \tvar stderr bytes.Buffer\n1035: \tnotifyCrashedRun(&stderr, root, job.Job{Name: jobName, Root: root})\n1036: \n1037: \tif len(*got) != 0 {\n1038: \t\tt.Errorf(\"received %d requests, want 0 (unconfigured must be a strict no-op)\", len(*got))\n1039: \t}\n1040: \t// Unconfigured behavior must be byte-for-byte identical: the stale sidecar\n1041: \t// is left exactly as it was (ReadJDIStatus still degrades it away).\n1042: \tif _, ok := job.StaleRunningJDI(root, jobName); !ok {\n1043: \t\tt.Error(\"sidecar was modified despite ntfy being unconfigured — unconfigured behavior must be unchanged\")\n1044: \t}\n1045: }\n1046: \n1047: // pruneTestJob builds a real worktree job (the mg job flow) for the\n1048: // commandAgentRunner prune-wiring tests — initTestRepo's job branch has no\n1049: // registered worktree, but commandAgentRunner.Run resolves its --job through\n1050: // the worktree path (ResolveRootFrom → WorktreeForBranch), so a real\n1051: // worktree job is required.\n1052: func pruneTestJob(t *testing.T) (dir string, j job.Job) {\n1053: \tt.Helper()\n1054: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n1055: \tdir = mgCheckout(t)\n1056: \tt.Chdir(dir)\n1057: \tprofileCheckout(t, \"MANIGOT_PROFILE=zai\\nZHIPU_API_KEY=k\\n\")\n1058: \n1059: \tvar out, errOut strings.Builder\n1060: \tif code := runJob([]string{\"Prune Job\"}, &out, &errOut); code != 0 {\n1061: \t\tt.Fatalf(\"runJob: %d %s\", code, errOut.String())\n1062: \t}\n1063: \tbranch := mgJobBranch(t, dir)\n1064: \tjobName := strings.TrimPrefix(branch, \"feature/\")\n1065: \twt := mgWorktreePath(t, dir, branch)\n1066: \tj = job.Job{\n1067: \t\tName:   jobName,\n1068: \t\tDir:    filepath.Join(wt, \"docs\", \"jobs\", jobName),\n1069: \t\tRoot:   wt,\n1070: \t\tID:     strings.Split(jobName, \"_\")[0],\n1071: \t\tBranch: branch,\n1072: \t}\n1073: \treturn dir, j\n1074: }\n1075: \n1076: // TestCommandAgentRunnerPrunesBeforeRun pins the mg-jdi launch-path wiring:\n1077: // commandAgentRunner.Run calls pruneOrphans (stubbed — docker is not on the\n1078: // test PATH) before its docker invocation, which then fails on the git-only\n1079: // PATH — proving the prune ran and did not replace the launch.\n1080: func TestCommandAgentRunnerPrunesBeforeRun(t *testing.T) {\n1081: \tdir, j := pruneTestJob(t)\n1082: \n1083: \tvar pruneCalls int\n1084: \told := pruneOrphans\n1085: \tpruneOrphans = func(diag io.Writer) (session.PruneResult, error) {\n1086: \t\tpruneCalls++\n1087: \t\treturn session.PruneResult{Removed: 2, Running: 0}, nil\n1088: \t}\n1089: \tt.Cleanup(func() { pruneOrphans = old })\n1090: \n1091: \tr := &commandAgentRunner{projectRoot: dir, profile: \"zai\"}\n1092: \t_, err := r.Run(\"analyst\", j, io.Discard)\n1093: \tif err == nil {\n1094: \t\tt.Fatal(\"Run = nil error, want the docker-launch failure (docker is not on the test PATH)\")\n1095: \t}\n1096: \tif pruneCalls != 1 {\n1097: \t\tt.Errorf(\"pruneOrphans called %d times, want 1\", pruneCalls)\n1098: \t}\n1099: \tif !strings.Contains(err.Error(), \"executable file not found\") {\n1100: \t\tt.Errorf(\"the invocation must have proceeded to the docker launch:\\n%v\", err)\n1101: \t}\n1102: }\n1103: \n1104: // TestCommandAgentRunnerPruneFailureDoesNotAbort: a prune failure only warns\n1105: // (into the diag buffer, which surfaces in the invocation error) and never\n1106: // aborts the invocation — the docker launch is still attempted.\n1107: func TestCommandAgentRunnerPruneFailureDoesNotAbort(t *testing.T) {\n1108: \tdir, j := pruneTestJob(t)\n1109: \n1110: \told := pruneOrphans\n1111: \tpruneOrphans = func(diag io.Writer) (session.PruneResult, error) {\n1112: \t\treturn session.PruneResult{}, errors.New(\"Cannot connect to the Docker daemon\")\n1113: \t}\n1114: \tt.Cleanup(func() { pruneOrphans = old })\n1115: \n1116: \tr := &commandAgentRunner{projectRoot: dir, profile: \"zai\"}\n1117: \t_, err := r.Run(\"analyst\", j, io.Discard)\n1118: \tif err == nil {\n1119: \t\tt.Fatal(\"Run = nil error, want the docker-launch failure (docker is not on the test PATH)\")\n1120: \t}\n1121: \tif !strings.Contains(err.Error(), \"could not prune orphaned containers\") {\n1122: \t\tt.Errorf(\"missing the prune warning in the invocation error:\\n%v\", err)\n1123: \t}\n1124: \tif !strings.Contains(err.Error(), \"executable file not found\") {\n1125: \t\tt.Errorf(\"the invocation must proceed past a prune failure (docker attempted):\\n%v\", err)\n1126: \t}\n1127: }\n1128: \n1129: // TestRunWritesSessionLogPerInvocation pins the live session.log streaming\n1130: // at the loop level: Run opens one section per invocation — header (agent +\n1131: // attempt + timestamp) written before the invocation, raw captured output\n1132: // tee'd in during it — to docs/jobs/<id>_<slug>/session.log, for every\n1133: // invocation in order. REQUIRED\n1134: // (TASK-5): the git-level assertion that the worktree is clean after Run —\n1135: // the final section must have been committed by the loop-exit sweep, or mg\n1136: // done's clean-tree check would refuse a just-finished run. The job runs in\n1137: // a REAL linked worktree (initLinkedWorktreeRepo), the production shape, so\n1138: // the sweep actually commits the final section into the job's own worktree\n1139: // and the clean-tree assertion exercises it meaningfully. (The fake runner\n1140: // itself sweeps nothing — only the loop-exit sweep can have committed the\n1141: // section here, mirroring the container-never-started degrade of the real\n1142: // runner.)\n1143: func TestRunWritesSessionLogPerInvocation(t *testing.T) {\n1144: \troot, wt, j := initLinkedWorktreeRepo(t)\n1145: \tr := &fakeRunner{t: t, root: wt, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n1146: \t\tswitch agent {\n1147: \t\tcase \"analyst\":\n1148: \t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n1149: \t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n1150: \t\tcase \"developer\":\n1151: \t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n1152: \t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n1153: \t\tcase \"reviewer\":\n1154: \t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n1155: \t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n1156: \t\t}\n1157: \t\treturn []byte(\"raw \" + agent + \" output\\n\")\n1158: \t}}\n1159: \n1160: \tvar log bytes.Buffer\n1161: \tgot := Run(root, j, r, &log, nil)\n1162: \tif got.Kind != orchestrate.StopFinished {\n1163: \t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n1164: \t}\n1165: \n1166: \tdata, err := os.ReadFile(filepath.Join(j.Dir, \"session.log\"))\n1167: \tif err != nil {\n1168: \t\tt.Fatalf(\"reading session.log: %v\", err)\n1169: \t}\n1170: \tout := string(data)\n1171: \t// Exactly one section per invocation, headers and raw content in order.\n1172: \tassertLogOrder(t, out, []string{\n1173: \t\t\"analyst (attempt 1)\",\n1174: \t\t\"raw analyst output\",\n1175: \t\t\"developer (attempt 1)\",\n1176: \t\t\"raw developer output\",\n1177: \t\t\"reviewer (attempt 1)\",\n1178: \t\t\"raw reviewer output\",\n1179: \t})\n1180: \tif n := sectionHeaderCount(out); n != 3 {\n1181: \t\tt.Errorf(\"session.log has %d section headers, want 3 (one per invocation)\", n)\n1182: \t}\n1183: \n1184: \t// REQUIRED: the loop-exit sweep must have committed the final session.log\n1185: \t// section in the job's linked worktree, so `git status --porcelain` is\n1186: \t// empty there — mg done's clean-tree check (git.WorkingTreeDirty) can\n1187: \t// never refuse a just-finished run.\n1188: \tif status := mgGit(t, wt, \"status\", \"--porcelain\"); status != \"\" {\n1189: \t\tt.Errorf(\"job worktree not clean after Run (final session.log section must be committed by the loop-exit sweep):\\n%s\", status)\n1190: \t}\n1191: }\n1192: \n1193: // TestRunWritesSessionLogHeaderBeforeInvocation pins the live-streaming\n1194: // contract's first half: the section header (agent, attempt, timestamp) is\n1195: // written to the job's session.log BEFORE the invocation starts — the fake\n1196: // runner's fn checks, at call time, that its own header is already in the\n1197: // file. (The second half — the raw bytes arriving during the run — is the\n1198: // tee the fake runner performs in Run, whose end state\n1199: // TestRunWritesSessionLogPerInvocation asserts.)\n1200: func TestRunWritesSessionLogHeaderBeforeInvocation(t *testing.T) {\n1201: \troot, j := initTestRepo(t)\n1202: \t// fn's call parameter is the run-wide invocation count; the session.log\n1203: \t// header uses the per-agent attempt (the same number logAgentInvoked's\n1204: \t// \"invoked (attempt N)\" header carries), so count per agent here.\n1205: \tattempts := map[string]int{}\n1206: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n1207: \t\tattempts[agent]++\n1208: \t\tdata, err := os.ReadFile(filepath.Join(j.Dir, \"session.log\"))\n1209: \t\tif err != nil {\n1210: \t\t\tt.Fatalf(\"reading session.log at invocation time: %v\", err)\n1211: \t\t}\n1212: \t\tif !strings.Contains(string(data), fmt.Sprintf(\"%s (attempt %d)\", agent, attempts[agent])) {\n1213: \t\t\tt.Errorf(\"session.log at invocation time missing the %s (attempt %d) header — the header must be written before the invocation starts:\\n%s\", agent, attempts[agent], data)\n1214: \t\t}\n1215: \t\tswitch agent {\n1216: \t\tcase \"analyst\":\n1217: \t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n1218: \t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n1219: \t\tcase \"developer\":\n1220: \t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n1221: \t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n1222: \t\tcase \"reviewer\":\n1223: \t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n1224: \t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n1225: \t\t}\n1226: \t\treturn []byte(\"ok\")\n1227: \t}}\n1228: \n1229: \tvar log bytes.Buffer\n1230: \tgot := Run(root, j, r, &log, nil)\n1231: \tif got.Kind != orchestrate.StopFinished {\n1232: \t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n1233: \t}\n1234: }\n1235: \n1236: // TestRunDoesNotSweepMainWorktree pins the loop-exit sweep's main-worktree\n1237: // gate: for a pre-worktree job (the job branch checked out in the MAIN\n1238: // worktree itself — initTestRepo's shape, an explicitly supported state) the\n1239: // sweep must be skipped entirely. Without the gate, git.CommitAll on the\n1240: // main worktree would stage and commit the user's own uncommitted work — an\n1241: // unexcluded .env included — as [<id>] chore: commit all on the job branch:\n1242: // precisely the hazard session.SweepJobWorktree's\n1243: // ProjectRoot == InvocationRoot gate exists for. The test plants an\n1244: // untracked .env in the main worktree and runs a marker-stop loop (a single\n1245: // invocation whose output the fake runner never commits, so the ONLY thing\n1246: // that could commit the .env is the loop-exit sweep), then asserts the .env\n1247: // is still untracked with its content untouched and that no sweep commit\n1248: // landed on the branch. (The final session.log section staying uncommitted\n1249: // here is the accepted trade-off — the host never sweeps the main worktree,\n1250: // by design.)\n1251: func TestRunDoesNotSweepMainWorktree(t *testing.T) {\n1252: \troot, j := initTestRepo(t)\n1253: \n1254: \t// The user's own uncommitted work in the main worktree — the exact file\n1255: \t// the gate exists to keep off the job branch.\n1256: \tconst envContent = \"CLAUDE_CODE_OAUTH_TOKEN=secret-token\\n\"\n1257: \tif err := os.WriteFile(filepath.Join(root, \".env\"), []byte(envContent), 0o644); err != nil {\n1258: \t\tt.Fatal(err)\n1259: \t}\n1260: \n1261: \tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n1262: \t\treturn []byte(\"NEEDS-HUMAN-INPUT: which auth provider should this use?\\n\")\n1263: \t}}\n1264: \n1265: \tvar log bytes.Buffer\n1266: \tgot := Run(root, j, r, &log, nil)\n1267: \tif got.Kind != orchestrate.StopNeedsHuman {\n1268: \t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman (reason: %s)\", got.Kind, got.Reason)\n1269: \t}\n1270: \tif len(r.calls) != 1 {\n1271: \t\tt.Fatalf(\"calls = %v, want exactly one invocation (marker stop)\", r.calls)\n1272: \t}\n1273: \n1274: \t// The .env must still be untracked — the fake runner never runs\n1275: \t// `git add -A`, so the only thing that could have committed it is the\n1276: \t// loop-exit sweep, and the gate must have skipped it.\n1277: \tstatus := mgGit(t, root, \"status\", \"--porcelain\")\n1278: \tif !strings.Contains(status, \"?? .env\") {\n\n(Output capped at 50 KB. Showing lines 1-1278. Use offset=1279 to continue.)\n</content>","metadata":{"preview":"package main\n\nimport (\n\t\"bytes\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n\t\"github.com/lmuskalla/manigot/internal/session\"","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/src/cmd/mg/jdi_test.go","text":"package main\n\nimport (\n\t\"bytes\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n\t\"github.com/lmuskalla/manigot/internal/session\"\n)\n\n// runGit runs git -C dir args, failing the test on any error — mirrors\n// tui/internal/git's own test helper, duplicated here since it is\n// unexported in that package.\nfunc runGit(t *testing.T, dir string, args ...string) {\n\tt.Helper()\n\tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"git %s in %s: %v\\n%s\", strings.Join(args, \" \"), dir, err, out)\n\t}\n}\n\n// initTestRepo creates a fresh git repo at a temp dir with a job scaffold\n// (brief.md only — tasks/implementation/verdict are written by the fake\n// runner as the loop progresses) on its own job branch, and returns the\n// job.Job ready to hand to Run.\nfunc initTestRepo(t *testing.T) (root string, j job.Job) {\n\tt.Helper()\n\troot = t.TempDir()\n\trunGit(t, root, \"init\", \"-q\")\n\trunGit(t, root, \"config\", \"user.email\", \"t@example.com\")\n\trunGit(t, root, \"config\", \"user.name\", \"Test\")\n\trunGit(t, root, \"config\", \"commit.gpgsign\", \"false\")\n\n\tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(root, \"README\"), []byte(\"init\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGit(t, root, \"add\", \"README\")\n\trunGit(t, root, \"commit\", \"-q\", \"-m\", \"init\")\n\n\tconst jobName = \"aaaa01_test-job\"\n\tconst branch = \"feature/aaaa01_test-job\"\n\tjobDir := filepath.Join(root, \"docs\", \"jobs\", jobName)\n\tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tbrief := \"# Brief: test job\\n\\nstatus: open\\ntype: feature\\nid: aaaa01\\nbranch: \" + branch + \"\\n\\n\" +\n\t\t\"## What\\n\\nsomething substantial enough to count as written\\nand a second line so isWritten's rule is satisfied\\n\"\n\tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGit(t, root, \"checkout\", \"-q\", \"-b\", branch)\n\trunGit(t, root, \"add\", \"-A\")\n\trunGit(t, root, \"commit\", \"-q\", \"-m\", \"[aaaa01] scaffold job\")\n\n\tj = job.Job{\n\t\tName:   jobName,\n\t\tDir:    jobDir,\n\t\tRoot:   root,\n\t\tID:     \"aaaa01\",\n\t\tBranch: branch,\n\t}\n\treturn root, j\n}\n\n// initLinkedWorktreeRepo creates a fresh git repo whose job branch is checked\n// out in a REAL linked worktree — the production shape `mg job` produces —\n// unlike initTestRepo's pre-worktree shape (branch checked out in the main\n// worktree itself). Run-level session.log tests use this shape so the\n// loop-exit sweep's CommitAll runs against the job's own worktree and the\n// REQUIRED clean-tree assertion actually exercises it (in the pre-worktree\n// shape the sweep is gated off by design — see TestRunDoesNotSweepMainWorktree).\n//\n// Returns the main project root (matching job.Discover's semantics: a Job's\n// Root is always the main root, never its own worktree), the job's linked\n// worktree path, and the job.Job.\nfunc initLinkedWorktreeRepo(t *testing.T) (root, wt string, j job.Job) {\n\tt.Helper()\n\troot = t.TempDir()\n\trunGit(t, root, \"init\", \"-q\", \"-b\", \"main\")\n\trunGit(t, root, \"config\", \"user.email\", \"t@example.com\")\n\trunGit(t, root, \"config\", \"user.name\", \"Test\")\n\trunGit(t, root, \"config\", \"commit.gpgsign\", \"false\")\n\n\tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(root, \"README\"), []byte(\"init\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGit(t, root, \"add\", \"README\")\n\trunGit(t, root, \"commit\", \"-q\", \"-m\", \"init\")\n\n\tconst jobName = \"aaaa01_test-job\"\n\tconst branch = \"feature/aaaa01_test-job\"\n\tjobDir := filepath.Join(root, \"docs\", \"jobs\", jobName)\n\tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tbrief := \"# Brief: test job\\n\\nstatus: open\\ntype: feature\\nid: aaaa01\\nbranch: \" + branch + \"\\n\\n\" +\n\t\t\"## What\\n\\nsomething substantial enough to count as written\\nand a second line so isWritten's rule is satisfied\\n\"\n\tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGit(t, root, \"checkout\", \"-q\", \"-b\", branch)\n\trunGit(t, root, \"add\", \"-A\")\n\trunGit(t, root, \"commit\", \"-q\", \"-m\", \"[aaaa01] scaffold job\")\n\n\t// Back to main, then add the job's own linked worktree — the shape mg\n\t// job creates for a normal (post-worktree) job.\n\trunGit(t, root, \"checkout\", \"-q\", \"main\")\n\twt = filepath.Join(root, \".manigot-worktrees\", jobName)\n\trunGit(t, root, \"worktree\", \"add\", \"-q\", wt, branch)\n\n\tj = job.Job{\n\t\tName:   jobName,\n\t\tDir:    filepath.Join(wt, \"docs\", \"jobs\", jobName),\n\t\tRoot:   root, // the main project root — job.Discover's semantics\n\t\tID:     \"aaaa01\",\n\t\tBranch: branch,\n\t}\n\treturn root, wt, j\n}\n\n// writeJobFile writes content to one of the job's four files.\nfunc writeJobFile(t *testing.T, j job.Job, filename, content string) {\n\tt.Helper()\n\tif err := os.WriteFile(filepath.Join(j.Dir, filename), []byte(content), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\nfunc commit(t *testing.T, root, msg string) {\n\tt.Helper()\n\trunGit(t, root, \"add\", \"-A\")\n\trunGit(t, root, \"commit\", \"-q\", \"-m\", msg)\n}\n\n// fakeRunner implements AgentRunner by calling fn, which simulates an agent\n// invocation's effect on disk/git — the same effect a real one would have\n// via its own file writes and commits — and returns canned output. It also\n// tees the canned output into the live writer (the session.log section the\n// loop opened), mirroring the real runner's io.MultiWriter, so the\n// loop-level session.log tests exercise the full stream path.\ntype fakeRunner struct {\n\troot  string\n\tcalls []string\n\tfn    func(t *testing.T, root string, j job.Job, agent string, call int) []byte\n\tt     *testing.T\n}\n\nfunc (f *fakeRunner) Run(agent string, j job.Job, live io.Writer) ([]byte, error) {\n\tf.calls = append(f.calls, agent)\n\tout := f.fn(f.t, f.root, j, agent, len(f.calls))\n\tif len(out) > 0 && live != nil {\n\t\tlive.Write(out)\n\t}\n\treturn out, nil\n}\n\n// TestRunJDIJobShortFlagAccepted pins that `-j` is a recognized alias of\n// `--job` in runJDI's own flag set: with no docs/ directory anywhere above\n// the working dir, the run must get past flag parsing (an unknown flag would\n// exit 2) and fail cleanly at project resolution instead.\nfunc TestRunJDIJobShortFlagAccepted(t *testing.T) {\n\tt.Chdir(t.TempDir())\n\tvar out, errOut strings.Builder\n\tif code := runJDI([]string{\"-j\", \"somejob\"}, &out, &errOut); code != 1 {\n\t\tt.Errorf(\"-j exit code = %d, want 1 (no docs/ dir); stderr:\\n%s\", code, errOut.String())\n\t}\n\tif !strings.Contains(errOut.String(), \"could not find a docs/ directory\") {\n\t\tt.Errorf(\"expected the no-docs error, got:\\n%s\", errOut.String())\n\t}\n}\n\nfunc TestRunJDIUnknownFlagRejected(t *testing.T) {\n\tvar out, errOut strings.Builder\n\tif code := runJDI([]string{\"-x\", \"somejob\"}, &out, &errOut); code != 2 {\n\t\tt.Errorf(\"unknown flag exit code = %d, want 2\", code)\n\t}\n}\n\nfunc TestRunHappyPath(t *testing.T) {\n\troot, j := initTestRepo(t)\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"analyst\":\n\t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n\t\tcase \"reviewer\":\n\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n\t\t}\n\t\treturn []byte(\"ok\")\n\t}}\n\n\tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n\tif got.Kind != orchestrate.StopFinished {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n\t}\n\twantCalls := []string{\"analyst\", \"developer\", \"reviewer\"}\n\tif strings.Join(r.calls, \",\") != strings.Join(wantCalls, \",\") {\n\t\tt.Errorf(\"calls = %v, want %v\", r.calls, wantCalls)\n\t}\n}\n\n// TestRunLogsAgentInvoked confirms Run writes an \"invoked\" event to the log\n// immediately before each agent invocation (TASK-2), reusing the same\n// attempt number logInvocation's own post-run header uses. The attempt is\n// per agent: every agent's first call is attempt 1, so the happy path reads\n// analyst 1 -> developer 1 -> reviewer 1, not a run-wide 1/2/3.\nfunc TestRunLogsAgentInvoked(t *testing.T) {\n\troot, j := initTestRepo(t)\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"analyst\":\n\t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n\t\tcase \"reviewer\":\n\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n\t\t}\n\t\treturn []byte(\"ok\")\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopFinished {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n\t}\n\tout := log.String()\n\tfor _, want := range []string{\n\t\t\"analyst invoked (attempt 1)\",\n\t\t\"developer invoked (attempt 1)\",\n\t\t\"reviewer invoked (attempt 1)\",\n\t} {\n\t\tif !strings.Contains(out, want) {\n\t\t\tt.Errorf(\"log missing %q, got:\\n%s\", want, out)\n\t\t}\n\t}\n}\n\n// TestRunReportsStatus exercises Run's StatusFunc callback (TASK-8): a\n// job.JDIRunning report before each invocation naming that invocation's\n// agent, and a final job.JDIStoppedFinished report naming the last agent\n// that ran.\nfunc TestRunReportsStatus(t *testing.T) {\n\troot, j := initTestRepo(t)\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"analyst\":\n\t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n\t\tcase \"reviewer\":\n\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n\t\t}\n\t\treturn []byte(\"ok\")\n\t}}\n\n\ttype report struct {\n\t\tstate job.JDIState\n\t\tagent string\n\t}\n\tvar reports []report\n\tstatus := func(state job.JDIState, agent string) {\n\t\treports = append(reports, report{state, agent})\n\t}\n\n\tgot := Run(root, j, r, &bytes.Buffer{}, status)\n\tif got.Kind != orchestrate.StopFinished {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n\t}\n\n\twant := []report{\n\t\t{job.JDIRunning, \"analyst\"},\n\t\t{job.JDIRunning, \"developer\"},\n\t\t{job.JDIRunning, \"reviewer\"},\n\t\t{job.JDIStoppedFinished, \"reviewer\"},\n\t}\n\tif len(reports) != len(want) {\n\t\tt.Fatalf(\"reports = %+v, want %+v\", reports, want)\n\t}\n\tfor i, w := range want {\n\t\tif reports[i] != w {\n\t\t\tt.Errorf(\"reports[%d] = %+v, want %+v\", i, reports[i], w)\n\t\t}\n\t}\n}\n\n// TestRunOneBounceThenApproved covers the bounce path: a rejected review\n// sends control back to the developer once, and a second approved review\n// ends the run. The log headers assert the per-agent attempt semantics that\n// motivated the brief — the developer's second call is that developer's\n// attempt 2, NOT attempt 4 as a run-wide counter would produce, and the\n// reviewer's first call is attempt 1 — with each invocation's invoked and\n// finished headers sharing the same number.\nfunc TestRunOneBounceThenApproved(t *testing.T) {\n\troot, j := initTestRepo(t)\n\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\n\treviewCalls := 0\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", fmt.Sprintf(\"# Implementation\\n\\nTASK-1: attempt %d\\n\", call))\n\t\t\tcommit(t, root, fmt.Sprintf(\"[aaaa01] TASK-1: attempt %d\", call))\n\t\tcase \"reviewer\":\n\t\t\treviewCalls++\n\t\t\tif reviewCalls == 1 {\n\t\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: FAIL\\n\\n## Overall\\n\\nNEEDS WORK\\n\")\n\t\t\t\tcommit(t, root, \"[aaaa01] verdict: needs work\")\n\t\t\t} else {\n\t\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\t\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n\t\t\t}\n\t\t}\n\t\treturn []byte(\"ok\")\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopFinished {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n\t}\n\twantCalls := []string{\"developer\", \"reviewer\", \"developer\", \"reviewer\"}\n\tif strings.Join(r.calls, \",\") != strings.Join(wantCalls, \",\") {\n\t\tt.Errorf(\"calls = %v, want %v\", r.calls, wantCalls)\n\t}\n\n\t// Per-agent attempts on the bounce path: each agent's first call is\n\t// attempt 1 and the bounced-back developer's second call is attempt 2 —\n\t// not attempt 4 as the old run-wide i+1 counter produced. The invoked and\n\t// finished headers of one invocation share the same number.\n\tassertLogOrder(t, log.String(), []string{\n\t\t\"developer invoked (attempt 1)\",\n\t\t\"developer finished (attempt 1)\",\n\t\t\"reviewer invoked (attempt 1)\",\n\t\t\"reviewer finished (attempt 1)\",\n\t\t\"developer invoked (attempt 2)\",\n\t\t\"developer finished (attempt 2)\",\n\t\t\"reviewer invoked (attempt 2)\",\n\t\t\"reviewer finished (attempt 2)\",\n\t})\n}\n\nfunc TestRunStopsAfterOneBounceExhausted(t *testing.T) {\n\troot, j := initTestRepo(t)\n\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", fmt.Sprintf(\"# Implementation\\n\\nTASK-1: attempt %d\\n\", call))\n\t\t\tcommit(t, root, fmt.Sprintf(\"[aaaa01] TASK-1: attempt %d\", call))\n\t\tcase \"reviewer\":\n\t\t\twriteJobFile(t, j, \"verdict.md\", fmt.Sprintf(\"# Verdict\\n\\nTASK-1: FAIL (attempt %d)\\n\\n## Overall\\n\\nREJECTED\\n\", call))\n\t\t\tcommit(t, root, fmt.Sprintf(\"[aaaa01] verdict: rejected (attempt %d)\", call))\n\t\t}\n\t\treturn []byte(\"ok\")\n\t}}\n\n\tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman (reason: %s)\", got.Kind, got.Reason)\n\t}\n\tif !strings.Contains(got.Reason, \"review cycle\") {\n\t\tt.Errorf(\"Reason = %q, want it to contain \\\"review cycle\\\"\", got.Reason)\n\t}\n\t// developer, reviewer (round 1, rejected), developer (the one allowed\n\t// bounce), reviewer (round 2, rejected again) — then stop, no third\n\t// developer bounce.\n\twantCalls := []string{\"developer\", \"reviewer\", \"developer\", \"reviewer\"}\n\tif strings.Join(r.calls, \",\") != strings.Join(wantCalls, \",\") {\n\t\tt.Errorf(\"calls = %v, want %v\", r.calls, wantCalls)\n\t}\n\tcount, err := git.CountVerdictCommits(root, j.Branch, j.ID)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif count != 2 {\n\t\tt.Errorf(\"verdict commit count = %d, want 2\", count)\n\t}\n}\n\nfunc TestRunStopsOnNeedsHumanMarker(t *testing.T) {\n\troot, j := initTestRepo(t)\n\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\treturn []byte(\"I looked at the brief.\\nNEEDS-HUMAN-INPUT: which auth provider should this use?\\n\")\n\t}}\n\n\tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n\t}\n\tif !strings.Contains(got.Reason, \"which auth provider should this use?\") {\n\t\tt.Errorf(\"Reason = %q, want it to contain the marker's reason text\", got.Reason)\n\t}\n\tif len(r.calls) != 1 {\n\t\tt.Errorf(\"calls = %v, want exactly one invocation (stopped immediately)\", r.calls)\n\t}\n}\n\n// TestRunStopsOnNeedsHumanMarkerInOpenCodeJSONL proves the marker detection\n// holds at the loop level against the real `opencode run --format json`\n// JSONL shape — a stream of typed events whose response prose lives in a\n// \"text\"-event's part.text (see orchestrate.realOpenCodeJSONL) — not just\n// against the plain-text / Claude-JSON shapes the other marker tests use.\n// It also pins the run.log contract for an opencode-driven run: the log must\n// show the extracted prose (ResultText), never the raw JSONL blob — while the\n// job's session.log holds the raw stream verbatim (the \"are we actually\n// grabbing the output\" answer for opencode).\nfunc TestRunStopsOnNeedsHumanMarkerInOpenCodeJSONL(t *testing.T) {\n\troot, j := initTestRepo(t)\n\n\t// A minimal but real `opencode run --format json` output (the 3-line\n\t// step_start/text/step_finish shape captured live in the 63quv2\n\t// verification), with the marker inside the text event's part.text.\n\tconst realShape = `{\"type\":\"step_start\",\"part\":{\"type\":\"step-start\"}}\n{\"type\":\"text\",\"part\":{\"type\":\"text\",\"text\":\"Looked at tasks.md.\\nNEEDS-HUMAN-INPUT: which auth provider should this use?\"}}\n{\"type\":\"step_finish\",\"part\":{\"type\":\"step-finish\",\"reason\":\"stop\"}}\n`\n\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\treturn []byte(realShape)\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n\t}\n\tif !strings.Contains(got.Reason, \"which auth provider should this use?\") {\n\t\tt.Errorf(\"Reason = %q, want it to contain the marker's reason text\", got.Reason)\n\t}\n\tif len(r.calls) != 1 {\n\t\tt.Errorf(\"calls = %v, want exactly one invocation (stopped immediately)\", r.calls)\n\t}\n\tout := log.String()\n\tif strings.Contains(out, `\"type\":\"step_start\"`) || strings.Contains(out, `{\"type\":\"text\"`) {\n\t\tt.Errorf(\"run.log contains raw JSONL, want the extracted prose (ResultText):\\n%s\", out)\n\t}\n\tif !strings.Contains(out, \"which auth provider should this use?\") {\n\t\tt.Errorf(\"run.log missing the marker reason prose, got:\\n%s\", out)\n\t}\n\t// The raw stream (the truth) also lands in the job's session.log: the\n\t// capture path persists the full JSONL verbatim — every event line of the\n\t// opencode-shaped stream, run.log's extracted-prose summary\n\t// notwithstanding.\n\tsess, err := os.ReadFile(filepath.Join(j.Dir, \"session.log\"))\n\tif err != nil {\n\t\tt.Fatalf(\"reading session.log: %v\", err)\n\t}\n\tfor _, line := range strings.Split(strings.TrimSpace(realShape), \"\\n\") {\n\t\tif !strings.Contains(string(sess), line) {\n\t\t\tt.Errorf(\"session.log missing raw JSONL line %q, got:\\n%s\", line, sess)\n\t\t}\n\t}\n}\n\nfunc TestRunStopsOnStall(t *testing.T) {\n\troot, j := initTestRepo(t)\n\n\t// analyst \"runs\" but writes/commits nothing at all — Stage() and HEAD\n\t// stay unchanged, so the second consecutive analyst invocation must\n\t// trip the stall backstop rather than loop forever.\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\treturn []byte(\"thinking out loud, not sure what to do\")\n\t}}\n\n\tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n\t}\n\tif !strings.Contains(got.Reason, \"no progress\") {\n\t\tt.Errorf(\"Reason = %q, want it to mention no progress\", got.Reason)\n\t}\n\tif len(r.calls) != 2 {\n\t\tt.Errorf(\"calls = %v, want exactly two invocations (stall detected on the second)\", r.calls)\n\t}\n}\n\n// TestRunStallProbeUsesFreshContext pins the stall backstop against a\n// regression where the post-agent HEAD probe reused the pre-agent probe\n// context: an agent invocation (runner.Run) takes minutes in production, so\n// by the time the probe ran the 10s context was long expired and the probe\n// returned \"\" — headAfter never equaled headBefore, noChange was always\n// false, and a genuinely stuck agent ran to maxIterations instead of\n// stopping after two no-op invocations. The test simulates that by lowering\n// jdiProbeTimeout and making the fake runner's Run outlive it (but write\n// nothing), then asserting the backstop still fires: it can only if the\n// post-agent probe used a fresh context.\nfunc TestRunStallProbeUsesFreshContext(t *testing.T) {\n\troot, j := initTestRepo(t)\n\n\torig := jdiProbeTimeout\n\tjdiProbeTimeout = 200 * time.Millisecond\n\tt.Cleanup(func() { jdiProbeTimeout = orig })\n\n\t// The fake agent \"runs\" longer than the probe timeout and writes\n\t// nothing at all — exactly the production shape of a stuck agent. 600ms\n\t// comfortably outlives the 200ms probe timeout, and 200ms leaves the\n\t// pre-agent probes (three fast, real git execs sharing the loop-top\n\t// context) plenty of room to complete within it even on a loaded CI\n\t// machine.\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\ttime.Sleep(600 * time.Millisecond)\n\t\treturn []byte(\"thinking out loud, not sure what to do\")\n\t}}\n\n\tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n\t}\n\tif !strings.Contains(got.Reason, \"no progress\") {\n\t\tt.Errorf(\"Reason = %q, want it to mention no progress\", got.Reason)\n\t}\n\tif len(r.calls) != 2 {\n\t\tt.Errorf(\"calls = %v, want exactly two invocations (stall detected on the second, not looped to maxIterations)\", r.calls)\n\t}\n}\n\nfunc TestRunStopsOnRunnerError(t *testing.T) {\n\troot, j := initTestRepo(t)\n\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\n\tr := &errRunner{}\n\tgot := Run(root, j, r, &bytes.Buffer{}, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman\", got.Kind)\n\t}\n\tif !strings.Contains(got.Reason, \"boom\") {\n\t\tt.Errorf(\"Reason = %q, want it to mention the runner error\", got.Reason)\n\t}\n}\n\n// TestRunLogsImmediateStopReason confirms an immediate stop — Next()\n// returning a Stop* decision before any agent has ever run, e.g. a\n// genuinely-unwritten brief.md — writes its Reason to the log, not just to\n// mg jdi's own return value. Before this fix, this case left the log at 0\n// bytes, which read as \"mg jdi didn't do anything at all\" rather than \"mg\n// jdi correctly stopped immediately, here's why\".\nfunc TestRunLogsImmediateStopReason(t *testing.T) {\n\troot, j := initTestRepo(t)\n\t// Overwrite brief.md with the genuinely-unwritten scaffold shape (no\n\t// substantive content at all) so Stage() reports StageDefine and Next\n\t// stops before ever invoking an agent.\n\twriteJobFile(t, j, \"brief.md\", \"# Brief: test job\\n\\nstatus: open\\ntype: feature\\nid: aaaa01\\n\\n\"+\n\t\t\"## What\\n\\n<!-- placeholder -->\\n\")\n\tcommit(t, root, \"[aaaa01] brief: reset to scaffold\")\n\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tt.Fatal(\"no agent should have been invoked for an immediate stop\")\n\t\treturn nil\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman (reason: %s)\", got.Kind, got.Reason)\n\t}\n\tif len(r.calls) != 0 {\n\t\tt.Fatalf(\"calls = %v, want no invocations (immediate stop)\", r.calls)\n\t}\n\tif log.Len() == 0 {\n\t\tt.Fatal(\"run.log is empty, want it to contain the immediate-stop reason\")\n\t}\n\tif !strings.Contains(log.String(), got.Reason) {\n\t\tt.Errorf(\"log = %q, want it to contain the stop reason %q\", log.String(), got.Reason)\n\t}\n}\n\n// TestRunLogsJobFinishedOnNormalStop confirms Run writes a \"job finished\"\n// event to the log at loop exit (TASK-4) once an agent has actually run —\n// distinct from the immediate-stop case covered by\n// TestRunLogsImmediateStopReason below, which must not repeat the same\n// reason text twice in a row.\nfunc TestRunLogsJobFinishedOnNormalStop(t *testing.T) {\n\troot, j := initTestRepo(t)\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"analyst\":\n\t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n\t\tcase \"reviewer\":\n\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n\t\t}\n\t\treturn []byte(\"ok\")\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopFinished {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n\t}\n\tout := log.String()\n\tif !strings.Contains(out, \"mg jdi finished: stop-finished\") {\n\t\tt.Errorf(\"log missing job-finished event, got:\\n%s\", out)\n\t}\n\tif !strings.Contains(out, got.Reason) {\n\t\tt.Errorf(\"log missing the finish reason %q, got:\\n%s\", got.Reason, out)\n\t}\n}\n\n// TestRunImmediateStopDoesNotDuplicateReason extends\n// TestRunLogsImmediateStopReason: TASK-4's \"job finished\" event must still\n// fire for the stop-before-any-agent-ran case, but must not print the same\n// reason text logImmediateStop already printed a second time.\nfunc TestRunImmediateStopDoesNotDuplicateReason(t *testing.T) {\n\troot, j := initTestRepo(t)\n\twriteJobFile(t, j, \"brief.md\", \"# Brief: test job\\n\\nstatus: open\\ntype: feature\\nid: aaaa01\\n\\n\"+\n\t\t\"## What\\n\\n<!-- placeholder -->\\n\")\n\tcommit(t, root, \"[aaaa01] brief: reset to scaffold\")\n\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tt.Fatal(\"no agent should have been invoked for an immediate stop\")\n\t\treturn nil\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman (reason: %s)\", got.Kind, got.Reason)\n\t}\n\tout := log.String()\n\tif !strings.Contains(out, \"mg jdi finished: stop-needs-human\") {\n\t\tt.Errorf(\"log missing job-finished event, got:\\n%s\", out)\n\t}\n\tif strings.Count(out, got.Reason) != 1 {\n\t\tt.Errorf(\"reason %q appears %d times in log, want exactly 1 (not duplicated between logImmediateStop and logJobFinished):\\n%s\", got.Reason, strings.Count(out, got.Reason), out)\n\t}\n}\n\n// assertLogOrder fails the test unless every substring in wantInOrder\n// appears in out, each strictly after the previous one — i.e. out reads as\n// wantInOrder describes, start to finish.\nfunc assertLogOrder(t *testing.T, out string, wantInOrder []string) {\n\tt.Helper()\n\tpos := 0\n\tfor _, want := range wantInOrder {\n\t\tidx := strings.Index(out[pos:], want)\n\t\tif idx == -1 {\n\t\t\tt.Fatalf(\"log missing %q after position %d, want it in order %v; full log:\\n%s\", want, pos, wantInOrder, out)\n\t\t}\n\t\tpos += idx + len(want)\n\t}\n}\n\n// TestRunFullLogSequenceHappyPath is TASK-6's end-to-end coverage: a full\n// mg-jdi run (mimicking main()'s own logStarted call ahead of Run) produces\n// the complete started -> invoked -> finished -> ... -> job finished\n// sequence the brief asked for, not just each event in isolation.\nfunc TestRunFullLogSequenceHappyPath(t *testing.T) {\n\troot, j := initTestRepo(t)\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"analyst\":\n\t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\t\t\treturn []byte(\"Wrote tasks.md with one task.\")\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n\t\t\treturn []byte(\"Implemented TASK-1, all tests pass.\")\n\t\tcase \"reviewer\":\n\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n\t\t\treturn []byte(\"Reviewed and approved.\")\n\t\t}\n\t\treturn nil\n\t}}\n\n\tvar log bytes.Buffer\n\tlogStarted(&log, j.Name, \"claude-pro\")\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopFinished {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n\t}\n\n\tassertLogOrder(t, log.String(), []string{\n\t\t\"mg jdi started\",\n\t\t\"analyst invoked (attempt 1)\",\n\t\t\"analyst finished (attempt 1)\",\n\t\t\"Wrote tasks.md with one task.\",\n\t\t\"developer invoked (attempt 1)\",\n\t\t\"developer finished (attempt 1)\",\n\t\t\"Implemented TASK-1, all tests pass.\",\n\t\t\"reviewer invoked (attempt 1)\",\n\t\t\"reviewer finished (attempt 1)\",\n\t\t\"Reviewed and approved.\",\n\t\t\"mg jdi finished: stop-finished\",\n\t})\n}\n\n// TestRunFullLogSequenceDedupsMatchingOutput is TASK-6's dedup-case\n// end-to-end coverage: when an agent's response text is just an echo of the\n// file it wrote (TASK-5), the full sequence still reads started -> invoked\n// -> finished -> ... -> job finished, but the finished body is the short\n// omission note instead of the file's full content repeated in the log.\nfunc TestRunFullLogSequenceDedupsMatchingOutput(t *testing.T) {\n\troot, j := initTestRepo(t)\n\tconst tasksContent = \"# Tasks\\n\\nTASK-1: do the thing\\n\"\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"analyst\":\n\t\t\twriteJobFile(t, j, \"tasks.md\", tasksContent)\n\t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\t\t\treturn []byte(tasksContent)\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n\t\t\treturn []byte(\"done\")\n\t\tcase \"reviewer\":\n\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n\t\t\treturn []byte(\"done\")\n\t\t}\n\t\treturn nil\n\t}}\n\n\tvar log bytes.Buffer\n\tlogStarted(&log, j.Name, \"claude-pro\")\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopFinished {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n\t}\n\n\tout := log.String()\n\tassertLogOrder(t, out, []string{\n\t\t\"mg jdi started\",\n\t\t\"analyst invoked (attempt 1)\",\n\t\t\"analyst finished (attempt 1)\",\n\t\t\"(output matches tasks.md, omitted)\",\n\t\t\"developer invoked (attempt 1)\",\n\t\t\"developer finished (attempt 1)\",\n\t\t\"reviewer invoked (attempt 1)\",\n\t\t\"reviewer finished (attempt 1)\",\n\t\t\"mg jdi finished: stop-finished\",\n\t})\n\tif strings.Contains(out, \"TASK-1: do the thing\") {\n\t\tt.Errorf(\"log = %q, want tasks.md's content not repeated verbatim (should be omitted)\", out)\n\t}\n}\n\ntype errRunner struct{}\n\nfunc (errRunner) Run(agent string, j job.Job, live io.Writer) ([]byte, error) {\n\treturn nil, errors.New(\"boom\")\n}\n\n// TestCommandAgentRunnerUsesGivenProfile confirms commandAgentRunner builds\n// its --print session invocation with the profile it was constructed with\n// (TASK-5), rather than the old hardcoded config.ProfileClaudePro pin —\n// exercised for a non-default profile so a stale pin would be caught. Since\n// the runner now calls the session package in-process (no run.sh exec), the\n// pinned profile is asserted on the constructed options, and a full Run\n// against the test repo must reach the docker launch (which fails with a\n// docker-not-found error here) rather than a profile/auth/resolution error.\nfunc TestCommandAgentRunnerUsesGivenProfile(t *testing.T) {\n\troot, j := initTestRepo(t)\n\n\tr := &commandAgentRunner{projectRoot: root, profile: \"zai\"}\n\topts := r.agentInvocation(\"developer\", j)\n\tif opts.Profile != \"zai\" {\n\t\tt.Errorf(\"invocation profile = %q, want zai\", opts.Profile)\n\t}\n\tif opts.Agent != \"developer\" || opts.Job != j.Name || !opts.Print {\n\t\tt.Errorf(\"invocation = %+v\", opts)\n\t}\n}\n\n// notifyRequest is one HTTP request the fake ntfy server captured.\ntype notifyRequest struct {\n\tmethod  string\n\tpath    string\n\tbody    string\n\theaders http.Header\n}\n\n// newNotifyCapture starts an httptest server recording every request it\n// receives (method, path, headers, body) and replying with status, so tests\n// can assert on exactly what notifyStop/notifyCrashedRun sent.\nfunc newNotifyCapture(t *testing.T, status int) (*httptest.Server, *[]notifyRequest) {\n\tt.Helper()\n\tvar got []notifyRequest\n\tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\tbody, _ := io.ReadAll(r.Body)\n\t\tgot = append(got, notifyRequest{method: r.Method, path: r.URL.Path, body: string(body), headers: r.Header.Clone()})\n\t\tw.WriteHeader(status)\n\t}))\n\tt.Cleanup(srv.Close)\n\treturn srv, &got\n}\n\n// configureNtfy points the ntfy config (internal/notify's FromConfig, which\n// reads config.EnvValue) at the test server by setting the process env the\n// .env-less fake checkout falls back to.\nfunc configureNtfy(t *testing.T, srvURL, topic, token string) {\n\tt.Helper()\n\tt.Setenv(\"NTFY_URL\", srvURL)\n\tt.Setenv(\"NTFY_TOPIC\", topic)\n\tt.Setenv(\"NTFY_TOKEN\", token)\n}\n\nfunc TestNotifyStopFinished(t *testing.T) {\n\tprofileCheckout(t, \"\")\n\tsrv, got := newNotifyCapture(t, http.StatusOK)\n\tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n\n\tvar stderr bytes.Buffer\n\tnotifyStop(&stderr, \"aaaa01_test-job\", LoopResult{Kind: orchestrate.StopFinished, Reason: \"verdict.md's Overall verdict is APPROVED\"})\n\n\tif len(*got) != 1 {\n\t\tt.Fatalf(\"received %d requests, want 1\", len(*got))\n\t}\n\treq := (*got)[0]\n\tif req.headers.Get(\"Tags\") != \"white_check_mark\" {\n\t\tt.Errorf(\"Tags header = %q, want white_check_mark\", req.headers.Get(\"Tags\"))\n\t}\n\tif req.headers.Get(\"Priority\") != \"\" {\n\t\tt.Errorf(\"Priority header = %q, want unset (default priority) for a success\", req.headers.Get(\"Priority\"))\n\t}\n\tif !strings.Contains(req.headers.Get(\"Title\"), \"aaaa01_test-job\") {\n\t\tt.Errorf(\"Title header = %q, want it to contain the job name\", req.headers.Get(\"Title\"))\n\t}\n\tif !strings.Contains(req.body, \"APPROVED\") {\n\t\tt.Errorf(\"body = %q, want it to contain the stop reason\", req.body)\n\t}\n\tif stderr.Len() != 0 {\n\t\tt.Errorf(\"stderr = %q, want empty\", stderr.String())\n\t}\n}\n\nfunc TestNotifyStopNeedsHuman(t *testing.T) {\n\tprofileCheckout(t, \"\")\n\tsrv, got := newNotifyCapture(t, http.StatusOK)\n\tconfigureNtfy(t, srv.URL, \"my-topic\", \"tok\")\n\n\tvar stderr bytes.Buffer\n\tnotifyStop(&stderr, \"aaaa01_test-job\", LoopResult{Kind: orchestrate.StopNeedsHuman, Reason: \"analyst made no progress on two consecutive runs\"})\n\n\tif len(*got) != 1 {\n\t\tt.Fatalf(\"received %d requests, want 1\", len(*got))\n\t}\n\treq := (*got)[0]\n\tif req.headers.Get(\"Tags\") != \"warning\" {\n\t\tt.Errorf(\"Tags header = %q, want warning\", req.headers.Get(\"Tags\"))\n\t}\n\tif req.headers.Get(\"Priority\") != \"4\" {\n\t\tt.Errorf(\"Priority header = %q, want 4 (high priority) for needs-human\", req.headers.Get(\"Priority\"))\n\t}\n\tif req.headers.Get(\"Authorization\") != \"Bearer tok\" {\n\t\tt.Errorf(\"Authorization header = %q, want %q\", req.headers.Get(\"Authorization\"), \"Bearer tok\")\n\t}\n\tif !strings.Contains(req.headers.Get(\"Title\"), \"needs attention\") {\n\t\tt.Errorf(\"Title header = %q, want it to say needs attention\", req.headers.Get(\"Title\"))\n\t}\n\tif !strings.Contains(req.body, \"no progress\") {\n\t\tt.Errorf(\"body = %q, want it to contain the stop reason\", req.body)\n\t}\n}\n\nfunc TestNotifyStopUnconfiguredSendsNothing(t *testing.T) {\n\tprofileCheckout(t, \"\")\n\tsrv, got := newNotifyCapture(t, http.StatusOK)\n\tconfigureNtfy(t, srv.URL, \"\", \"\") // no NTFY_TOPIC → feature off\n\n\tvar stderr bytes.Buffer\n\tnotifyStop(&stderr, \"aaaa01_test-job\", LoopResult{Kind: orchestrate.StopNeedsHuman, Reason: \"stalled\"})\n\n\tif len(*got) != 0 {\n\t\tt.Errorf(\"received %d requests, want 0 (unconfigured must be a strict no-op)\", len(*got))\n\t}\n\tif stderr.Len() != 0 {\n\t\tt.Errorf(\"stderr = %q, want empty\", stderr.String())\n\t}\n}\n\nfunc TestNotifyStopSendFailureWarnsButDoesNotAbort(t *testing.T) {\n\tprofileCheckout(t, \"\")\n\tsrv, _ := newNotifyCapture(t, http.StatusInternalServerError)\n\tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n\n\tvar stderr bytes.Buffer\n\tnotifyStop(&stderr, \"aaaa01_test-job\", LoopResult{Kind: orchestrate.StopFinished, Reason: \"done\"})\n\n\tout := stderr.String()\n\tif !strings.Contains(out, \"mg jdi: warning: could not send ntfy notification\") {\n\t\tt.Errorf(\"stderr = %q, want a 'could not send ntfy notification' warning\", out)\n\t}\n}\n\n// writeStaleRunningSidecar plants an old JDIRunning sidecar — the on-disk\n// signature of an mg-jdi run that was killed without ever reporting a stop\n// (job.jdiRunningStaleAfter is 30 minutes, so 2 hours is safely stale).\nfunc writeStaleRunningSidecar(t *testing.T, root, jobName string) {\n\tt.Helper()\n\tif err := os.MkdirAll(job.JDIStatusDir(root, jobName), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstale := time.Now().Add(-2 * time.Hour).UTC().Format(time.RFC3339)\n\tbody := `{\"state\":\"running\",\"agent\":\"developer\",\"updated\":\"` + stale + `\"}`\n\tif err := os.WriteFile(job.JDIStatusPath(root, jobName), []byte(body), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\nfunc TestNotifyCrashedRunNotifiesAndDedups(t *testing.T) {\n\tprofileCheckout(t, \"\")\n\tsrv, got := newNotifyCapture(t, http.StatusOK)\n\tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n\troot := t.TempDir()\n\tconst jobName = \"aaaa01_test-job\"\n\twriteStaleRunningSidecar(t, root, jobName)\n\tj := job.Job{Name: jobName, Root: root}\n\n\tvar stderr bytes.Buffer\n\tnotifyCrashedRun(&stderr, root, j)\n\n\tif len(*got) != 1 {\n\t\tt.Fatalf(\"received %d requests, want 1 (the crash notification)\", len(*got))\n\t}\n\treq := (*got)[0]\n\tif req.headers.Get(\"Tags\") != \"warning\" {\n\t\tt.Errorf(\"Tags header = %q, want warning\", req.headers.Get(\"Tags\"))\n\t}\n\tif req.headers.Get(\"Priority\") != \"4\" {\n\t\tt.Errorf(\"Priority header = %q, want 4 (high priority) for a crash\", req.headers.Get(\"Priority\"))\n\t}\n\tif !strings.Contains(req.headers.Get(\"Title\"), jobName) {\n\t\tt.Errorf(\"Title header = %q, want it to contain the job name\", req.headers.Get(\"Title\"))\n\t}\n\tif !strings.Contains(req.body, \"crashed or been killed\") {\n\t\tt.Errorf(\"body = %q, want it to describe the crash\", req.body)\n\t}\n\tif !strings.Contains(req.body, \"Last agent: developer\") {\n\t\tt.Errorf(\"body = %q, want it to name the last agent\", req.body)\n\t}\n\tif stderr.Len() != 0 {\n\t\tt.Errorf(\"stderr = %q, want empty\", stderr.String())\n\t}\n\n\t// The stale sidecar is overwritten with a stopped state, so a second\n\t// start must not re-notify about the same already-known crash.\n\tnotifyCrashedRun(&stderr, root, j)\n\tif len(*got) != 1 {\n\t\tt.Errorf(\"received %d requests after dedup, want still 1\", len(*got))\n\t}\n\tif st, ok := job.ReadJDIStatus(root, jobName); !ok || st.State != job.JDIStoppedNeedsHuman {\n\t\tt.Errorf(\"sidecar after dedup = %+v (ok=%v), want stopped:needs-human\", st, ok)\n\t}\n}\n\nfunc TestNotifyCrashedRunFreshRunningDoesNotNotify(t *testing.T) {\n\tprofileCheckout(t, \"\")\n\tsrv, got := newNotifyCapture(t, http.StatusOK)\n\tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n\troot := t.TempDir()\n\tconst jobName = \"aaaa01_test-job\"\n\t// A fresh running status means a live mg-jdi run — must not be reported\n\t// as a crash.\n\tif err := job.WriteJDIStatus(root, jobName, job.JDIRunning, \"analyst\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tvar stderr bytes.Buffer\n\tnotifyCrashedRun(&stderr, root, job.Job{Name: jobName, Root: root})\n\n\tif len(*got) != 0 {\n\t\tt.Errorf(\"received %d requests, want 0 (a live run is not a crash)\", len(*got))\n\t}\n\tif stderr.Len() != 0 {\n\t\tt.Errorf(\"stderr = %q, want empty\", stderr.String())\n\t}\n}\n\nfunc TestNotifyCrashedRunStoppedStatusDoesNotNotify(t *testing.T) {\n\tprofileCheckout(t, \"\")\n\tsrv, got := newNotifyCapture(t, http.StatusOK)\n\tconfigureNtfy(t, srv.URL, \"my-topic\", \"\")\n\troot := t.TempDir()\n\tconst jobName = \"aaaa01_test-job\"\n\tif err := job.WriteJDIStatus(root, jobName, job.JDIStoppedFinished, \"reviewer\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tvar stderr bytes.Buffer\n\tnotifyCrashedRun(&stderr, root, job.Job{Name: jobName, Root: root})\n\n\tif len(*got) != 0 {\n\t\tt.Errorf(\"received %d requests, want 0 (a stopped run is not a crash)\", len(*got))\n\t}\n}\n\nfunc TestNotifyCrashedRunUnconfiguredLeavesSidecarUntouched(t *testing.T) {\n\tprofileCheckout(t, \"\")\n\tsrv, got := newNotifyCapture(t, http.StatusOK)\n\tconfigureNtfy(t, srv.URL, \"\", \"\") // no NTFY_TOPIC → feature off\n\troot := t.TempDir()\n\tconst jobName = \"aaaa01_test-job\"\n\twriteStaleRunningSidecar(t, root, jobName)\n\n\tvar stderr bytes.Buffer\n\tnotifyCrashedRun(&stderr, root, job.Job{Name: jobName, Root: root})\n\n\tif len(*got) != 0 {\n\t\tt.Errorf(\"received %d requests, want 0 (unconfigured must be a strict no-op)\", len(*got))\n\t}\n\t// Unconfigured behavior must be byte-for-byte identical: the stale sidecar\n\t// is left exactly as it was (ReadJDIStatus still degrades it away).\n\tif _, ok := job.StaleRunningJDI(root, jobName); !ok {\n\t\tt.Error(\"sidecar was modified despite ntfy being unconfigured — unconfigured behavior must be unchanged\")\n\t}\n}\n\n// pruneTestJob builds a real worktree job (the mg job flow) for the\n// commandAgentRunner prune-wiring tests — initTestRepo's job branch has no\n// registered worktree, but commandAgentRunner.Run resolves its --job through\n// the worktree path (ResolveRootFrom → WorktreeForBranch), so a real\n// worktree job is required.\nfunc pruneTestJob(t *testing.T) (dir string, j job.Job) {\n\tt.Helper()\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\tdir = mgCheckout(t)\n\tt.Chdir(dir)\n\tprofileCheckout(t, \"MANIGOT_PROFILE=zai\\nZHIPU_API_KEY=k\\n\")\n\n\tvar out, errOut strings.Builder\n\tif code := runJob([]string{\"Prune Job\"}, &out, &errOut); code != 0 {\n\t\tt.Fatalf(\"runJob: %d %s\", code, errOut.String())\n\t}\n\tbranch := mgJobBranch(t, dir)\n\tjobName := strings.TrimPrefix(branch, \"feature/\")\n\twt := mgWorktreePath(t, dir, branch)\n\tj = job.Job{\n\t\tName:   jobName,\n\t\tDir:    filepath.Join(wt, \"docs\", \"jobs\", jobName),\n\t\tRoot:   wt,\n\t\tID:     strings.Split(jobName, \"_\")[0],\n\t\tBranch: branch,\n\t}\n\treturn dir, j\n}\n\n// TestCommandAgentRunnerPrunesBeforeRun pins the mg-jdi launch-path wiring:\n// commandAgentRunner.Run calls pruneOrphans (stubbed — docker is not on the\n// test PATH) before its docker invocation, which then fails on the git-only\n// PATH — proving the prune ran and did not replace the launch.\nfunc TestCommandAgentRunnerPrunesBeforeRun(t *testing.T) {\n\tdir, j := pruneTestJob(t)\n\n\tvar pruneCalls int\n\told := pruneOrphans\n\tpruneOrphans = func(diag io.Writer) (session.PruneResult, error) {\n\t\tpruneCalls++\n\t\treturn session.PruneResult{Removed: 2, Running: 0}, nil\n\t}\n\tt.Cleanup(func() { pruneOrphans = old })\n\n\tr := &commandAgentRunner{projectRoot: dir, profile: \"zai\"}\n\t_, err := r.Run(\"analyst\", j, io.Discard)\n\tif err == nil {\n\t\tt.Fatal(\"Run = nil error, want the docker-launch failure (docker is not on the test PATH)\")\n\t}\n\tif pruneCalls != 1 {\n\t\tt.Errorf(\"pruneOrphans called %d times, want 1\", pruneCalls)\n\t}\n\tif !strings.Contains(err.Error(), \"executable file not found\") {\n\t\tt.Errorf(\"the invocation must have proceeded to the docker launch:\\n%v\", err)\n\t}\n}\n\n// TestCommandAgentRunnerPruneFailureDoesNotAbort: a prune failure only warns\n// (into the diag buffer, which surfaces in the invocation error) and never\n// aborts the invocation — the docker launch is still attempted.\nfunc TestCommandAgentRunnerPruneFailureDoesNotAbort(t *testing.T) {\n\tdir, j := pruneTestJob(t)\n\n\told := pruneOrphans\n\tpruneOrphans = func(diag io.Writer) (session.PruneResult, error) {\n\t\treturn session.PruneResult{}, errors.New(\"Cannot connect to the Docker daemon\")\n\t}\n\tt.Cleanup(func() { pruneOrphans = old })\n\n\tr := &commandAgentRunner{projectRoot: dir, profile: \"zai\"}\n\t_, err := r.Run(\"analyst\", j, io.Discard)\n\tif err == nil {\n\t\tt.Fatal(\"Run = nil error, want the docker-launch failure (docker is not on the test PATH)\")\n\t}\n\tif !strings.Contains(err.Error(), \"could not prune orphaned containers\") {\n\t\tt.Errorf(\"missing the prune warning in the invocation error:\\n%v\", err)\n\t}\n\tif !strings.Contains(err.Error(), \"executable file not found\") {\n\t\tt.Errorf(\"the invocation must proceed past a prune failure (docker attempted):\\n%v\", err)\n\t}\n}\n\n// TestRunWritesSessionLogPerInvocation pins the live session.log streaming\n// at the loop level: Run opens one section per invocation — header (agent +\n// attempt + timestamp) written before the invocation, raw captured output\n// tee'd in during it — to docs/jobs/<id>_<slug>/session.log, for every\n// invocation in order. REQUIRED\n// (TASK-5): the git-level assertion that the worktree is clean after Run —\n// the final section must have been committed by the loop-exit sweep, or mg\n// done's clean-tree check would refuse a just-finished run. The job runs in\n// a REAL linked worktree (initLinkedWorktreeRepo), the production shape, so\n// the sweep actually commits the final section into the job's own worktree\n// and the clean-tree assertion exercises it meaningfully. (The fake runner\n// itself sweeps nothing — only the loop-exit sweep can have committed the\n// section here, mirroring the container-never-started degrade of the real\n// runner.)\nfunc TestRunWritesSessionLogPerInvocation(t *testing.T) {\n\troot, wt, j := initLinkedWorktreeRepo(t)\n\tr := &fakeRunner{t: t, root: wt, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tswitch agent {\n\t\tcase \"analyst\":\n\t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n\t\tcase \"reviewer\":\n\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n\t\t}\n\t\treturn []byte(\"raw \" + agent + \" output\\n\")\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopFinished {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n\t}\n\n\tdata, err := os.ReadFile(filepath.Join(j.Dir, \"session.log\"))\n\tif err != nil {\n\t\tt.Fatalf(\"reading session.log: %v\", err)\n\t}\n\tout := string(data)\n\t// Exactly one section per invocation, headers and raw content in order.\n\tassertLogOrder(t, out, []string{\n\t\t\"analyst (attempt 1)\",\n\t\t\"raw analyst output\",\n\t\t\"developer (attempt 1)\",\n\t\t\"raw developer output\",\n\t\t\"reviewer (attempt 1)\",\n\t\t\"raw reviewer output\",\n\t})\n\tif n := sectionHeaderCount(out); n != 3 {\n\t\tt.Errorf(\"session.log has %d section headers, want 3 (one per invocation)\", n)\n\t}\n\n\t// REQUIRED: the loop-exit sweep must have committed the final session.log\n\t// section in the job's linked worktree, so `git status --porcelain` is\n\t// empty there — mg done's clean-tree check (git.WorkingTreeDirty) can\n\t// never refuse a just-finished run.\n\tif status := mgGit(t, wt, \"status\", \"--porcelain\"); status != \"\" {\n\t\tt.Errorf(\"job worktree not clean after Run (final session.log section must be committed by the loop-exit sweep):\\n%s\", status)\n\t}\n}\n\n// TestRunWritesSessionLogHeaderBeforeInvocation pins the live-streaming\n// contract's first half: the section header (agent, attempt, timestamp) is\n// written to the job's session.log BEFORE the invocation starts — the fake\n// runner's fn checks, at call time, that its own header is already in the\n// file. (The second half — the raw bytes arriving during the run — is the\n// tee the fake runner performs in Run, whose end state\n// TestRunWritesSessionLogPerInvocation asserts.)\nfunc TestRunWritesSessionLogHeaderBeforeInvocation(t *testing.T) {\n\troot, j := initTestRepo(t)\n\t// fn's call parameter is the run-wide invocation count; the session.log\n\t// header uses the per-agent attempt (the same number logAgentInvoked's\n\t// \"invoked (attempt N)\" header carries), so count per agent here.\n\tattempts := map[string]int{}\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\tattempts[agent]++\n\t\tdata, err := os.ReadFile(filepath.Join(j.Dir, \"session.log\"))\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"reading session.log at invocation time: %v\", err)\n\t\t}\n\t\tif !strings.Contains(string(data), fmt.Sprintf(\"%s (attempt %d)\", agent, attempts[agent])) {\n\t\t\tt.Errorf(\"session.log at invocation time missing the %s (attempt %d) header — the header must be written before the invocation starts:\\n%s\", agent, attempts[agent], data)\n\t\t}\n\t\tswitch agent {\n\t\tcase \"analyst\":\n\t\t\twriteJobFile(t, j, \"tasks.md\", \"# Tasks\\n\\nTASK-1: do the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] tasks: add breakdown\")\n\t\tcase \"developer\":\n\t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n\t\tcase \"reviewer\":\n\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n\t\t}\n\t\treturn []byte(\"ok\")\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopFinished {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n\t}\n}\n\n// TestRunDoesNotSweepMainWorktree pins the loop-exit sweep's main-worktree\n// gate: for a pre-worktree job (the job branch checked out in the MAIN\n// worktree itself — initTestRepo's shape, an explicitly supported state) the\n// sweep must be skipped entirely. Without the gate, git.CommitAll on the\n// main worktree would stage and commit the user's own uncommitted work — an\n// unexcluded .env included — as [<id>] chore: commit all on the job branch:\n// precisely the hazard session.SweepJobWorktree's\n// ProjectRoot == InvocationRoot gate exists for. The test plants an\n// untracked .env in the main worktree and runs a marker-stop loop (a single\n// invocation whose output the fake runner never commits, so the ONLY thing\n// that could commit the .env is the loop-exit sweep), then asserts the .env\n// is still untracked with its content untouched and that no sweep commit\n// landed on the branch. (The final session.log section staying uncommitted\n// here is the accepted trade-off — the host never sweeps the main worktree,\n// by design.)\nfunc TestRunDoesNotSweepMainWorktree(t *testing.T) {\n\troot, j := initTestRepo(t)\n\n\t// The user's own uncommitted work in the main worktree — the exact file\n\t// the gate exists to keep off the job branch.\n\tconst envContent = \"CLAUDE_CODE_OAUTH_TOKEN=secret-token\\n\"\n\tif err := os.WriteFile(filepath.Join(root, \".env\"), []byte(envContent), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tr := &fakeRunner{t: t, root: root, fn: func(t *testing.T, root string, j job.Job, agent string, call int) []byte {\n\t\treturn []byte(\"NEEDS-HUMAN-INPUT: which auth provider should this use?\\n\")\n\t}}\n\n\tvar log bytes.Buffer\n\tgot := Run(root, j, r, &log, nil)\n\tif got.Kind != orchestrate.StopNeedsHuman {\n\t\tt.Fatalf(\"Run.Kind = %v, want StopNeedsHuman (reason: %s)\", got.Kind, got.Reason)\n\t}\n\tif len(r.calls) != 1 {\n\t\tt.Fatalf(\"calls = %v, want exactly one invocation (marker stop)\", r.calls)\n\t}\n\n\t// The .env must still be untracked — the fake runner never runs\n\t// `git add -A`, so the only thing that could have committed it is the\n\t// loop-exit sweep, and the gate must have skipped it.\n\tstatus := mgGit(t, root, \"status\", \"--porcelain\")\n\tif !strings.Contains(status, \"?? .env\") {","lineStart":1,"lineEnd":1278,"totalLines":1279,"truncated":true}},"title":"src/cmd/mg/jdi_test.go","time":{"start":1787921096276,"end":1787921096284}},"id":"prt_04866ddd5001h3NZvplp94l1xw","sessionID":"ses_fb7999c4fffe1anLtOEgzjXUGJ","messageID":"msg_04866c0d3001I9HcHXB7pFZZbC"}}
