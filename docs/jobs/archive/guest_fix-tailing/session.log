{"type":"tool_use","timestamp":1787921088641,"sessionID":"ses_fb7999c4fffe1anLtOEgzjXUGJ","part":{"type":"tool","tool":"read","callID":"call_00_1wlS7QBu7kInnV4M1nRA4525","state":{"status":"completed","input":{"filePath":"/workspace/src/cmd/mg/jdi.go"},"output":"<path>/workspace/src/cmd/mg/jdi.go</path>\n<type>file</type>\n<content>\n1: // mg jdi (\"just do it\") drives a job's fixed agent sequence —\n2: // @analyst → @developer → @reviewer — end to end without a human manually\n3: // triggering each stage. It is the fold of the former cmd/jdi main into\n4: // the single mg binary (runJDI).\n5: //\n6: // It resolves the job by ID or directory name, then repeatedly asks\n7: // internal/orchestrate what to do next given the job's current\n8: // job.Stage() and git-derived retry-round state, invokes that agent\n9: // non-interactively (internal/session's --print path, see scripts/entrypoint.sh),\n10: // and loops — until the job's verdict is APPROVED or it needs a human (the\n11: // retry budget is exhausted, an agent asked a question via the\n12: // NEEDS-HUMAN-INPUT marker, or the same agent made no progress twice in a\n13: // row).\n14: //\n15: // It does not auto-merge the finished branch.\n16: //\n17: // Run from anywhere inside a project that has a docs/ directory:\n18: //\n19: //\tmg jdi --job/-j <id-or-name>\n20: package main\n21: \n22: import (\n23: \t\"bytes\"\n24: \t\"context\"\n25: \t\"errors\"\n26: \t\"flag\"\n27: \t\"fmt\"\n28: \t\"io\"\n29: \t\"os\"\n30: \t\"path/filepath\"\n31: \t\"strings\"\n32: \t\"time\"\n33: \n34: \t\"github.com/lmuskalla/manigot/internal/config\"\n35: \t\"github.com/lmuskalla/manigot/internal/git\"\n36: \t\"github.com/lmuskalla/manigot/internal/job\"\n37: \t\"github.com/lmuskalla/manigot/internal/notify\"\n38: \t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n39: \t\"github.com/lmuskalla/manigot/internal/session\"\n40: )\n41: \n42: // jdiVersion is the mg-jdi version. Overridden at build time with:\n43: //\n44: //\tgo build -ldflags \"-X main.jdiVersion=1.2.3\"\n45: var jdiVersion = \"0.1.0-dev\"\n46: \n47: // runJDI implements `mg jdi` (thematic alias `mg made-man`) — the fold of the\n48: // former cmd/jdi main into the single mg binary. It parses the flags, drives\n49: // the job's @analyst → @developer → @reviewer sequence end to end, and returns\n50: // the process exit code: 2 for flag/argument errors, 1 when the run stops\n51: // needing human input, 0 otherwise.\n52: func runJDI(args []string, stdout, stderr io.Writer) int {\n53: \tfs := flag.NewFlagSet(\"mg jdi\", flag.ContinueOnError)\n54: \tfs.SetOutput(stderr)\n55: \tvar jobArg string\n56: \tfs.StringVar(&jobArg, \"job\", \"\", \"job ID or directory name to drive (required)\")\n57: \tfs.StringVar(&jobArg, \"j\", \"\", \"short form of --job\")\n58: \tprofileArg := fs.String(\"profile\", \"\", \"subscription profile to run agents under: claude-pro, zai, opencode-go, opencode-zen, or opencode-zen-free (default claude-pro)\")\n59: \tfs.Usage = func() {\n60: \t\tfmt.Fprintf(stderr, \"mg jdi %s\\n\\n\", jdiVersion)\n61: \t\tfmt.Fprintf(stderr, \"Drives a job's @analyst -> @developer -> @reviewer sequence end to end.\\n\\n\")\n62: \t\tfmt.Fprintf(stderr, \"Usage:\\n\")\n63: \t\tfmt.Fprintf(stderr, \"  mg jdi --job/-j <id-or-name> [--profile <profile>]\\n\\n\")\n64: \t\tfmt.Fprintf(stderr, \"Run from anywhere inside a project that has a docs/ directory.\\n\\n\")\n65: \t\tfmt.Fprintf(stderr, \"Flags:\\n\")\n66: \t\tfs.PrintDefaults()\n67: \t}\n68: \tif err := fs.Parse(args); err != nil {\n69: \t\treturn 2 // the flag package already printed the error + usage\n70: \t}\n71: \n72: \tif strings.TrimSpace(jobArg) == \"\" {\n73: \t\tfmt.Fprintln(stderr, \"mg jdi: --job is required\")\n74: \t\tfs.Usage()\n75: \t\treturn 2\n76: \t}\n77: \n78: \t// Default to claude-pro when unset, so existing callers/behavior are\n79: \t// unchanged; validated against config.Profiles() otherwise.\n80: \tprofile := strings.TrimSpace(*profileArg)\n81: \tif profile == \"\" {\n82: \t\tprofile = config.ProfileClaudePro\n83: \t}\n84: \tif _, ok := config.ProfileByID(profile); !ok {\n85: \t\tfmt.Fprintf(stderr, \"mg jdi: --profile must be one of: claude-pro, zai, opencode-go, opencode-zen, opencode-zen-free (got %q)\\n\", profile)\n86: \t\treturn 2\n87: \t}\n88: \n89: \troot, err := job.FindProjectRoot()\n90: \tif err != nil {\n91: \t\tfmt.Fprintf(stderr, \"mg jdi: cannot read working directory: %v\\n\", err)\n92: \t\treturn 1\n93: \t}\n94: \tif root == \"\" {\n95: \t\tfmt.Fprintln(stderr, \"mg jdi: could not find a docs/ directory in this or any parent directory\")\n96: \t\treturn 1\n97: \t}\n98: \n99: \tj, err := resolveJob(root, jobArg)\n100: \tif err != nil {\n101: \t\tfmt.Fprintf(stderr, \"mg jdi: %v\\n\", err)\n102: \t\treturn 1\n103: \t}\n104: \n105: \t// Crash notification (opt-in — see internal/notify): the previous run for\n106: \t// this job may have been killed without ever reporting a stop; detect it\n107: \t// here at the next run's start and push an attention notification. A\n108: \t// process that was SIGKILLed/OOM-killed cannot notify from inside itself,\n109: \t// so this stale-sidecar check on next start is the self-contained\n110: \t// approximation — an external watchdog is out of scope. Best-effort and\n111: \t// only when NTFY_TOPIC is set (unconfigured behavior unchanged).\n112: \tnotifyCrashedRun(stderr, root, j)\n113: \n114: \t// Best-effort: see ensureSidecarIgnored's own doc for why a failure here\n115: \t// does not abort the run.\n116: \tif err := ensureSidecarIgnored(root); err != nil {\n117: \t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not exclude the status sidecar from git: %v\\n\", err)\n118: \t}\n119: \n120: \trunner, err := newCommandAgentRunner(root, profile)\n121: \tif err != nil {\n122: \t\tfmt.Fprintf(stderr, \"mg jdi: %v\\n\", err)\n123: \t\treturn 1\n124: \t}\n125: \n126: \t// Fan-out: every invocation's formatted output\n127: \t// (see jdioutput.go's logInvocation) goes to both mg-jdi's own stdout —\n128: \t// which has an audience only for a direct CLI run; a TUI-launched run is\n129: \t// detached with no terminal attached to this leg at all — and the\n130: \t// sidecar's run.log, which the TUI log tab reads and is therefore the\n131: \t// only visibility path for a TUI-launched run. Writing to both\n132: \t// unconditionally is simplest and harmless: stdout always exists as a\n133: \t// file descriptor whether or not anything is reading it.\n134: \tlogDest := io.Writer(stdout)\n135: \twroteSection := false\n136: \tif logFile, hadContent, ferr := openRunLog(root, j.Name); ferr != nil {\n137: \t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not open run log, continuing with stdout only: %v\\n\", ferr)\n138: \t} else {\n139: \t\tdefer logFile.Close()\n140: \t\tlogDest = io.MultiWriter(stdout, logFile)\n141: \t\twroteSection = hadContent\n142: \t}\n143: \t// Wrap the destination in a sectionWriter (see jdioutput.go) so every\n144: \t// \"=== ... ===\" state-log header is preceded by a blank line instead of\n145: \t// the events getting crumbled together — the very first run ever written\n146: \t// to a fresh log excepted, which is what wroteSection captures.\n147: \tlogDest = &sectionWriter{w: logDest, wroteSection: wroteSection}\n148: \n149: \t// Ensure the job's session.log exists before the loop so the TUI's \"l\"\n150: \t// tail gate — the file's existence, see internal/ui's sessionLogExists —\n151: \t// is stable from the moment a run begins, mirroring run.log's own\n152: \t// up-front creation above. Best-effort: a failure only warns; the loop\n153: \t// still creates the file per invocation (see openSessionLog).\n154: \tif err := ensureSessionLogFile(filepath.Join(j.Dir, \"session.log\")); err != nil {\n155: \t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not create session log: %v\\n\", err)\n156: \t}\n157: \n158: \t// Status sidecar: best-effort — a write failure\n159: \t// (e.g. a read-only filesystem) must not abort the loop itself, only\n160: \t// mean the TUI's list-row badge and stop-notification dedup won't see it.\n161: \t// mg-jdi's own stdout/run.log remain authoritative for a human watching\n162: \t// directly either way.\n163: \tstatusFn := func(state job.JDIState, agent string) {\n164: \t\tif err := job.WriteJDIStatus(root, j.Name, state, agent); err != nil {\n165: \t\t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not write status sidecar: %v\\n\", err)\n166: \t\t}\n167: \t}\n168: \n169: \tlogStarted(logDest, j.Name, profile)\n170: \tresult := Run(root, j, runner, logDest, statusFn)\n171: \tfmt.Fprintf(stdout, \"\\nmg jdi: %s — %s\\n\", result.Kind, result.Reason)\n172: \n173: \t// Stop notification, CLI path: ring the terminal bell\n174: \t// at both loop-exit points (finished, needs human) — this process is\n175: \t// attached to the human's own terminal for a direct `mg jdi` run, which\n176: \t// is the only case this leg has an audience for. A TUI-launched run has\n177: \t// no terminal to ring into at all; the TUI rings on its own next poll\n178: \t// tick instead (see pollJDIBell in internal/ui/app.go), once it observes\n179: \t// this job's status sidecar (just written above) transition into a\n180: \t// stopped state.\n181: \tfmt.Fprint(stdout, \"\\a\")\n182: \n183: \t// Stop notification, ntfy path (opt-in — see internal/notify): both the\n184: \t// CLI path and a TUI-launched run go through this same runJDI stop path,\n185: \t// so notifying here covers both. Best-effort like the sidecar/run-log\n186: \t// warnings above — a send failure warns on stderr and never aborts the\n187: \t// exit path.\n188: \tnotifyStop(stderr, j.Name, result)\n189: \n190: \tif result.Kind == orchestrate.StopNeedsHuman {\n191: \t\treturn 1\n192: \t}\n193: \treturn 0\n194: }\n195: \n196: // notifyStop sends the opt-in ntfy stop notification for a finished mg-jdi\n197: // run: a default-priority success message (tag white_check_mark) when the\n198: // run finished (result.Kind == StopFinished), and a high-priority attention\n199: // message (tag warning, priority 4) when it stopped needing a human. Both\n200: // messages carry the job name and the stop reason. It is a strict no-op when\n201: // NTFY_TOPIC is unset (nothing is sent, no error), and a send failure only\n202: // warns on stderr — never aborting the caller.\n203: func notifyStop(stderr io.Writer, jobName string, result LoopResult) {\n204: \tc := notify.FromConfig()\n205: \tif !c.Enabled() {\n206: \t\treturn\n207: \t}\n208: \n209: \tmsg := notify.Message{Message: result.Reason}\n210: \tswitch result.Kind {\n211: \tcase orchestrate.StopFinished:\n212: \t\tmsg.Title = \"mg jdi: \" + jobName + \" finished\"\n213: \t\tmsg.Tags = []string{\"white_check_mark\"}\n214: \tdefault: // orchestrate.StopNeedsHuman\n215: \t\tmsg.Title = \"mg jdi: \" + jobName + \" needs attention\"\n216: \t\tmsg.Tags = []string{\"warning\"}\n217: \t\tmsg.Priority = 4\n218: \t}\n219: \tif err := c.Publish(msg); err != nil {\n220: \t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not send ntfy notification: %v\\n\", err)\n221: \t}\n222: }\n223: \n224: // notifyCrashedRun checks, at a new `mg jdi` run's start, whether the\n225: // previous run for job j died without ever reporting a stop — a JDIRunning\n226: // status in the sidecar stale past job's jdiRunningStaleAfter (see\n227: // job.StaleRunningJDI) — and pushes a high-priority attention notification\n228: // (tag warning, priority 4) about it. Once the crash has been notified, the\n229: // stale sidecar is overwritten with JDIStoppedNeedsHuman so a later start\n230: // does not re-notify about the same already-known crash; a failed send does\n231: // not mark it, so the notification is retried on the next start instead.\n232: //\n233: // It is a strict no-op when ntfy is unconfigured (no NTFY_TOPIC): nothing is\n234: // read-modify-written, keeping unconfigured behavior byte-for-byte identical\n235: // (the TUI still degrades the stale sidecar away on its own). Failures warn\n236: // on stderr and never abort the run.\n237: func notifyCrashedRun(stderr io.Writer, root string, j job.Job) {\n238: \tc := notify.FromConfig()\n239: \tif !c.Enabled() {\n240: \t\treturn\n241: \t}\n242: \n243: \tst, crashed := job.StaleRunningJDI(root, j.Name)\n244: \tif !crashed {\n245: \t\treturn\n246: \t}\n247: \n248: \tmsg := notify.Message{\n249: \t\tTitle:    \"mg jdi: \" + j.Name + \" crashed\",\n250: \t\tMessage:  fmt.Sprintf(\"The previous mg jdi run appears to have crashed or been killed (status stale since %s).\", st.Updated.Format(time.RFC3339)),\n251: \t\tTags:     []string{\"warning\"},\n252: \t\tPriority: 4,\n253: \t}\n254: \tif st.Agent != \"\" {\n255: \t\tmsg.Message += fmt.Sprintf(\" Last agent: %s.\", st.Agent)\n256: \t}\n257: \tif err := c.Publish(msg); err != nil {\n258: \t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not send ntfy notification: %v\\n\", err)\n259: \t\treturn\n260: \t}\n261: \n262: \t// Mark the crash as known so the next start doesn't re-notify about it.\n263: \tif err := job.WriteJDIStatus(root, j.Name, job.JDIStoppedNeedsHuman, st.Agent); err != nil {\n264: \t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not mark the crashed run as known: %v\\n\", err)\n265: \t}\n266: }\n267: \n268: // resolveJob finds the job named or ID-prefixed by arg among every job\n269: // job.Discover can see (cross-branch — see internal/job), mirroring the\n270: // session launcher's own --job resolution: an exact job-directory-name match\n271: // first, then an exact ID match, then a directory-name prefix match.\n272: func resolveJob(root, arg string) (job.Job, error) {\n273: \tjobs, err := job.Discover(root)\n274: \tif err != nil {\n275: \t\treturn job.Job{}, fmt.Errorf(\"could not list jobs: %w\", err)\n276: \t}\n277: \n278: \t// A job's Name is its id_slug — the same concept as a branch tail — so\n279: \t// the exact-name and name-prefix matching below reuses the branch-matching\n280: \t// primitives in internal/git rather than re-implementing them.\n281: \tbyName := make(map[string]job.Job, len(jobs))\n282: \tnames := make([]string, len(jobs))\n283: \tfor i, j := range jobs {\n284: \t\tbyName[j.Name] = j\n285: \t\tnames[i] = j.Name\n286: \t}\n287: \n288: \tif name := git.ExactBranchMatch(names, arg); name != \"\" {\n289: \t\treturn byName[name], nil\n290: \t}\n291: \tfor _, j := range jobs {\n292: \t\tif j.ID == arg {\n293: \t\t\treturn j, nil\n294: \t\t}\n295: \t}\n296: \n297: \tswitch matches := git.PrefixBranchMatches(names, arg); len(matches) {\n298: \tcase 0:\n299: \t\treturn job.Job{}, fmt.Errorf(\"job %q not found under docs/jobs/\", arg)\n300: \tcase 1:\n301: \t\treturn byName[matches[0]], nil\n302: \tdefault:\n303: \t\treturn job.Job{}, fmt.Errorf(\"job %q is ambiguous — matches %d jobs\", arg, len(matches))\n304: \t}\n305: }\n306: \n307: // AgentRunner runs one non-interactive agent invocation for job j and\n308: // returns its captured output (the session launcher's --print path — a\n309: // `claude --print --verbose --output-format stream-json` event stream, an\n310: // `opencode run --format json` event stream, or plain text; see\n311: // internal/orchestrate.DetectSignal, which handles all three). live is the\n312: // writer the invocation's raw output is streamed into as it arrives — Run's\n313: // loop passes the job's open session.log section (see openSessionLog), so\n314: // the verbose log grows live during the invocation instead of only after it\n315: // finishes; implementations must tee every captured byte into it (the real\n316: // runner does via io.MultiWriter — see commandAgentRunner.Run). Run's loop\n317: // persists the returned bytes to run.log's per-invocation summary\n318: // (logInvocation) and extracts the response prose via\n319: // orchestrate.ResultText.\n320: //\n321: // Implemented by commandAgentRunner for real invocations; the tests use a\n322: // fake instead of spawning real containers.\n323: type AgentRunner interface {\n324: \tRun(agent string, j job.Job, live io.Writer) ([]byte, error)\n325: }\n326: \n327: // commandAgentRunner is the real AgentRunner: it calls the session package's\n328: // --print path in-process (the replacement for exec'ing the resolved run.sh),\n329: // capturing the agent's stdout and routing diagnostics to a buffer that only\n330: // surfaces on error — the same visibility the exec'd run.sh's fd-3\n331: // diagnostics had.\n332: type commandAgentRunner struct {\n333: \tprojectRoot string\n334: \tprofile     string\n335: }\n336: \n337: // newCommandAgentRunner builds the in-process runner. projectRoot is where\n338: // --job resolution starts from (run.sh used $PWD, which the old runner set to\n339: // the project root); profile is passed through unchanged to every Run\n340: // invocation — see its own doc.\n341: func newCommandAgentRunner(projectRoot, profile string) (*commandAgentRunner, error) {\n342: \treturn &commandAgentRunner{projectRoot: projectRoot, profile: profile}, nil\n343: }\n344: \n345: // agentInvocation builds the session options for one agent run — the --print\n346: // invocation with the runner's pinned profile, the agent, and the exact job\n347: // directory name.\n348: func (r *commandAgentRunner) agentInvocation(agent string, j job.Job) session.Options {\n349: \treturn session.Options{Print: true, Profile: r.profile, Agent: agent, Job: j.Name}\n350: }\n351: \n352: // Run invokes the session launcher's --print path synchronously and returns\n353: // its stdout. The --print path keeps stdout clean of its own diagnostics\n354: // (they go to the diag writer), so stdout here is exactly the agent's own\n355: // response. live receives the exact same bytes as they arrive — the io.\n356: // MultiWriter tee that makes the job's session.log grow live during the\n357: // invocation (the loop passes the open sessionLog section; see Run). j.Name\n358: // (the exact job directory name) is passed rather than j.ID to remove any\n359: // ambiguity in the --job resolution.\n360: //\n361: // r.profile is passed explicitly rather than left to the launcher's own\n362: // default (main's --profile flag, validated and defaulted to\n363: // config.ProfileClaudePro there) so a run keeps using the profile it was\n364: // started with even when the user later changes their default profile via\n365: // `mg profiles` mid-run.\n366: func (r *commandAgentRunner) Run(agent string, j job.Job, live io.Writer) ([]byte, error) {\n367: \topts := r.agentInvocation(agent, j)\n368: \tinfo, err := session.ResolveProfile(opts)\n369: \tif err != nil {\n370: \t\treturn nil, err\n371: \t}\n372: \troot, err := session.ResolveRootFrom(opts, r.projectRoot)\n373: \tif err != nil {\n374: \t\treturn nil, err\n375: \t}\n376: \tif err := info.CheckAuth(); err != nil {\n377: \t\treturn nil, err\n378: \t}\n379: \n380: \tvar diag bytes.Buffer\n381: \tinv, err := session.BuildDockerInvocation(opts, info, root, false, &diag)\n382: \tif err != nil {\n383: \t\treturn nil, err\n384: \t}\n385: \n386: \t// Prune orphaned manigot containers before the run — the same fail-soft\n387: \t// self-healing cleanup as the interactive session path. Warnings go into\n388: \t// the diag buffer, which only surfaces on error; a prune failure never\n389: \t// aborts the invocation.\n390: \tif _, err := pruneOrphans(&diag); err != nil {\n391: \t\tfmt.Fprintf(&diag, \"mg: warning: could not prune orphaned containers: %v\\n\", err)\n392: \t}\n393: \n394: \t// Tee the container's stdout into both the capture buffer (returned to\n395: \t// the loop for DetectSignal/ResultText) and the live session.log writer,\n396: \t// so the verbose log grows as the bytes arrive rather than post-hoc.\n397: \tvar stdout bytes.Buffer\n398: \tcode, ran := inv.Run(os.Stdin, io.MultiWriter(&stdout, live), &diag)\n399: \t// The same host-side sweep as the interactive session path: every mg-jdi\n400: \t// --print invocation ends with leftover changes committed, including the\n401: \t// analyst's tasks.md (the analyst is read-only and cannot commit it\n402: \t// itself) and this invocation's just-streamed session.log section (the\n403: \t// header was written before the run and the raw bytes during it, so the\n404: \t// section is complete by the time this sweep runs). The sweep runs before\n405: \t// the loop's post-run stall probe reads HEAD, so the sweep commit\n406: \t// correctly counts as agent progress. Sweep only when the container\n407: \t// actually ran — an agent that never started must not trigger a commit.\n408: \tif ran {\n409: \t\tsession.SweepJobWorktree(root, &diag)\n410: \t}\n411: \tif code != 0 {\n412: \t\treturn stdout.Bytes(), fmt.Errorf(\"mg --print --agent %s --job %s: exit code %d: %s\", agent, j.Name, code, strings.TrimSpace(diag.String()))\n413: \t}\n414: \treturn stdout.Bytes(), nil\n415: }\n416: \n417: // LoopResult is Run's outcome: always one of orchestrate.StopFinished or\n418: // orchestrate.StopNeedsHuman — Run never returns while orchestrate.Next\n419: // keeps saying RunAgent.\n420: type LoopResult struct {\n421: \tKind   orchestrate.Kind\n422: \tReason string\n423: }\n424: \n425: // maxIterations is a hard safety cap on loop iterations, independent of\n426: // orchestrate.Next's own one-bounce retry budget — a defensive backstop\n427: // against an unforeseen bug in the state machine looping forever rather than\n428: // trusting Next's own termination alone.\n429: const maxIterations = 20\n430: \n431: // jdiProbeTimeout bounds each loop iteration's git probes (HeadCommit,\n432: // CountVerdictCommits, LatestCommitIsVerdict): local, fast reads, so 10s is\n433: // generous — the point is that a hung git stalls one probe rather than the\n434: // whole run. The probe errors are already read with `_` (the loop tolerates a\n435: // failed probe as \"no information\"), so a timeout degrades exactly like any\n436: // other probe failure and surfaces in the stop reason only if it's the last\n437: // thing that happened before a stop.\n438: //\n439: // A var rather than a const so tests can lower it: the stall-backstop test\n440: // needs a runner whose Run call outlives the probe timeout, which would be\n441: // a 10s test at the production value.\n442: var jdiProbeTimeout = 10 * time.Second\n443: \n444: // StatusFunc is called by Run at each state transition: once\n445: // before invoking an agent (job.JDIRunning, that agent's name) and once\n446: // more at loop exit (the terminal state, and the last agent that ran, or \"\"\n447: // if none ever did — e.g. a job stuck at StageDefine). May be nil, in which\n448: // case Run simply doesn't report status — used by tests that don't care\n449: // about the sidecar file.\n450: type StatusFunc func(state job.JDIState, agent string)\n451: \n452: // jdiTerminalState maps a LoopResult's orchestrate.Kind (always\n453: // StopFinished or StopNeedsHuman by the time Run returns) to the\n454: // corresponding job.JDIState reported to StatusFunc.\n455: func jdiTerminalState(k orchestrate.Kind) job.JDIState {\n456: \tif k == orchestrate.StopFinished {\n457: \t\treturn job.JDIStoppedFinished\n458: \t}\n459: \treturn job.JDIStoppedNeedsHuman\n460: }\n461: \n462: // Run drives job j through the agent sequence via runner, writing each\n463: // invocation's formatted output to log (see jdioutput.go's logInvocation) and\n464: // reporting state transitions to status (may be nil), until\n465: // orchestrate.Next reports StopFinished or StopNeedsHuman.\n466: //\n467: // The attempt number in each invocation's log header (logAgentInvoked /\n468: // logInvocation) counts that agent's own invocations within this run — per\n469: // agent, not a run-wide counter — so a bounce back to the developer logs\n470: // that developer's second call as attempt 2, not attempt 4. The counter is\n471: // seeded at 0 before the loop and reset at the start of every run, matching\n472: // the loop index's old behavior.\n473: //\n474: // Each iteration re-derives its decision from job.Stage() and git — the\n475: // job.Job struct's identity fields (Dir/Root/Branch/ID/Name) never change\n476: // across iterations, but Stage() and the git.CountVerdictCommits/\n477: // LatestCommitIsVerdict reads underneath it are re-evaluated fresh every\n478: // time, since they read from disk/git rather than a cached snapshot — so\n479: // Run never needs to re-fetch or mutate j itself mid-loop.\n480: func Run(root string, j job.Job, runner AgentRunner, log io.Writer, status StatusFunc) LoopResult {\n481: \tvar lastAgent string\n482: \tvar lastNoChange bool\n483: \tvar agentEverRan bool\n484: \n485: \treport := func(state job.JDIState, agent string) {\n486: \t\tif status != nil {\n487: \t\t\tstatus(state, agent)\n488: \t\t}\n489: \t}\n490: \t// finish reports the terminal status, logs the \"job finished\" event,\n491: \t// and builds the LoopResult every exit point returns.\n492: \t// includeReason is normally true; it's false only for the\n493: \t// stop-before-any-agent-ran case below, whose reason was already printed\n494: \t// by logImmediateStop a line above — see logJobFinished's own doc.\n495: \t//\n496: \t// Loop-exit sweep first: the per-invocation sweep\n497: \t// (session.SweepJobWorktree inside commandAgentRunner.Run) now runs AFTER\n498: \t// each invocation's live session.log writes — the section header is\n499: \t// written before the invocation and the raw bytes are tee'd into the\n500: \t// file during it, so by the time the sweep runs the section is complete,\n501: \t// and the sweep's `git add -A` commits it (untracked on iteration 1,\n502: \t// a tracked modification thereafter) exactly as it commits the agent's\n503: \t// own files. What the per-invocation sweep can't cover is a run whose\n504: \t// container never started (ran=false — the sweep is skipped, but the\n505: \t// header may already be in the file) or a test fake runner that sweeps\n506: \t// nothing at all; without this loop-exit sweep the final section would\n507: \t// then stay an uncommitted tracked modification — git.WorkingTreeDirty\n508: \t// DOES report tracked modifications, so mg done's clean-tree check\n509: \t// (finish.go) would refuse to finish the job. Commit everything left —\n510: \t// the final session.log section above all — with the sweep's own\n511: \t// message. Linked worktrees only: for a pre-worktree job\n512: \t// (branch checked out in the MAIN worktree itself — an explicitly\n513: \t// supported, Discover-visible state) the resolved worktree IS j.Root,\n514: \t// where the user's own uncommitted work lives — sweeping there would\n515: \t// commit it, an unexcluded .env included, onto the job branch, the\n516: \t// exact hazard session.SweepJobWorktree's ProjectRoot == InvocationRoot\n517: \t// gate exists for — so the sweep is skipped when WorktreeForBranch\n518: \t// resolves to the main worktree. The stop-before-any-agent path has\n519: \t// nothing to commit and ErrNothingToCommit is swallowed.\n520: \tfinish := func(kind orchestrate.Kind, reason string, includeReason bool) LoopResult {\n521: \t\tif wt, ok, err := git.WorktreeForBranch(j.Root, j.Branch); err != nil {\n522: \t\t\tfmt.Fprintf(log, \"mg jdi: warning: could not resolve worktree for the final session-log sweep: %v\\n\", err)\n523: \t\t} else if ok && filepath.Clean(wt) != filepath.Clean(j.Root) {\n524: \t\t\tif err := git.CommitAll(wt, fmt.Sprintf(\"[%s] chore: commit all\", j.ID)); err != nil && !errors.Is(err, git.ErrNothingToCommit) && !errors.Is(err, git.ErrNotARepo) {\n525: \t\t\t\tfmt.Fprintf(log, \"mg jdi: warning: could not commit the session log: %v\\n\", err)\n526: \t\t\t}\n527: \t\t}\n528: \t\treport(jdiTerminalState(kind), lastAgent)\n529: \t\tlogJobFinished(log, kind, reason, includeReason)\n530: \t\treturn LoopResult{Kind: kind, Reason: reason}\n531: \t}\n532: \n533: \t// attempts counts each agent's invocations within this run, keyed by\n534: \t// agent name — per agent, not run-wide — and feeds the \"attempt N\" in\n535: \t// both logAgentInvoked's and logInvocation's headers below. Seeded at 0\n536: \t// before the loop, so the first call of every agent is attempt 1.\n537: \tattempts := make(map[string]int)\n538: \n539: \tfor i := 0; i < maxIterations; i++ {\n540: \t\t// One bounded context for this iteration's pre-agent git probes\n541: \t\t// (see jdiProbeTimeout): a hung git must stall one probe, not the\n542: \t\t// whole run. Each context is cancelled at its point of use — never\n543: \t\t// deferred, which would accumulate up to maxIterations timers until\n544: \t\t// Run returns. The post-agent stall probe gets its own fresh context\n545: \t\t// below: runner.Run is a minutes-long docker/LLM invocation, so a\n546: \t\t// context created here would be long expired by the time that probe\n547: \t\t// runs and would read \"\" for HEAD, silently defeating the stall\n548: \t\t// backstop.\n549: \t\tprobeCtx, cancelProbes := context.WithTimeout(context.Background(), jdiProbeTimeout)\n550: \n551: \t\tstageBefore := j.Stage()\n552: \t\trounds, _ := git.CountVerdictCommitsWithContext(probeCtx, root, j.Branch, j.ID)\n553: \t\ttipIsVerdict, _ := git.LatestCommitIsVerdictWithContext(probeCtx, root, j.Branch, j.ID)\n554: \t\tdecision := orchestrate.Next(stageBefore, rounds, tipIsVerdict)\n555: \n556: \t\tif decision.Kind != orchestrate.RunAgent {\n557: \t\t\tcancelProbes()\n558: \t\t\tincludeReason := true\n559: \t\t\tif !agentEverRan {\n560: \t\t\t\t// No agent has run yet this whole loop (typically the very\n561: \t\t\t\t// first iteration, e.g. an unwritten brief.md) — logInvocation\n562: \t\t\t\t// never gets a chance to run for this stop, which otherwise\n563: \t\t\t\t// leaves run.log at 0 bytes for a case that has just as much\n564: \t\t\t\t// reason to explain itself there as any agent invocation does.\n565: \t\t\t\tlogImmediateStop(log, decision.Reason)\n566: \t\t\t\tincludeReason = false\n567: \t\t\t}\n568: \t\t\treturn finish(decision.Kind, decision.Reason, includeReason)\n569: \t\t}\n570: \n571: \t\treport(job.JDIRunning, decision.Agent)\n572: \t\tattempts[decision.Agent]++\n573: \t\tlogAgentInvoked(log, decision.Agent, attempts[decision.Agent])\n574: \t\theadBefore, _ := git.HeadCommitWithContext(probeCtx, root, j.Branch)\n575: \t\tcancelProbes() // pre-agent probes done; the agent invocation below can take minutes\n576: \n577: \t\t// Session log: open the job's session.log and write the section\n578: \t\t// header (agent, attempt, timestamp) BEFORE the invocation, then\n579: \t\t// stream the invocation's raw bytes into it live as they arrive —\n580: \t\t// the runner tees through the live writer (see commandAgentRunner.\n581: \t\t// Run's io.MultiWriter), so a `tail -f` on the file sees the\n582: \t\t// blow-by-blow grow during the run instead of only after it\n583: \t\t// finishes. This replaces the old post-hoc appendSessionLog call.\n584: \t\t// The section is written for EVERY invocation, failed ones included,\n585: \t\t// so what an agent did during an unattended run survives. Best-effort:\n586: \t\t// an open failure only warns through the log writer (Run has no\n587: \t\t// stderr) and never aborts the loop — the invocation still runs and\n588: \t\t// its output still lands in run.log's summary; only this invocation's\n589: \t\t// verbose persistence is lost, and the next invocation retries the\n590: \t\t// open on its own.\n591: \t\tsess, sessErr := openSessionLog(filepath.Join(j.Dir, \"session.log\"), decision.Agent, attempts[decision.Agent])\n592: \t\tif sessErr != nil {\n593: \t\t\tfmt.Fprintf(log, \"mg jdi: warning: could not open session log: %v\\n\", sessErr)\n594: \t\t}\n595: \t\tlive := io.Writer(io.Discard)\n596: \t\tif sess != nil {\n597: \t\t\tlive = sess\n598: \t\t}\n599: \t\tout, runErr := runner.Run(decision.Agent, j, live)\n600: \t\tagentEverRan = true\n601: \t\tif sess != nil {\n602: \t\t\tif cerr := sess.Close(); cerr != nil {\n603: \t\t\t\tfmt.Fprintf(log, \"mg jdi: warning: could not finalize session log: %v\\n\", cerr)\n604: \t\t\t}\n605: \t\t}\n606: \n607: \t\t// Read the just-run agent's expected target file fresh off\n608: \t\t// disk, so logInvocation can skip re-printing output that's already\n609: \t\t// the same as what got written to the job's own markdown file. Safe\n610: \t\t// to read directly from j.Dir — see orchestrate.AgentTargetFile's own\n611: \t\t// doc. A missing/unreadable file (targetContent left \"\") just means\n612: \t\t// logInvocation's dedup check never matches, which is the same as\n613: \t\t// not having this feature at all for that call.\n614: \t\tvar targetContent string\n615: \t\ttargetFile := orchestrate.AgentTargetFile[decision.Agent]\n616: \t\tif targetFile != \"\" {\n617: \t\t\tif data, rerr := os.ReadFile(filepath.Join(j.Dir, targetFile)); rerr == nil {\n618: \t\t\t\ttargetContent = string(data)\n619: \t\t\t}\n620: \t\t}\n621: \n622: \t\t// Fan-out: log gets the same formatted section\n623: \t\t// regardless of whether it's os.Stdout, the sidecar run.log, or (in\n624: \t\t// tests) an in-memory buffer — see main()'s io.MultiWriter and\n625: \t\t// jdioutput.go's logInvocation. DetectSignal below scans the raw bytes\n626: \t\t// directly (it does its own JSON extraction), independent of what\n627: \t\t// logInvocation writes for a human to read.\n628: \t\tlogInvocation(log, decision.Agent, attempts[decision.Agent], out, targetFile, targetContent)\n629: \n630: \t\tif sig, ok := orchestrate.DetectSignal(out); ok {\n631: \t\t\tlastAgent = decision.Agent\n632: \t\t\treturn finish(orchestrate.StopNeedsHuman, fmt.Sprintf(\"%s asked for human input: %s\", decision.Agent, sig.Reason), true)\n633: \t\t}\n634: \t\tif runErr != nil {\n635: \t\t\tlastAgent = decision.Agent\n636: \t\t\treturn finish(orchestrate.StopNeedsHuman, fmt.Sprintf(\"%s invocation failed: %v\", decision.Agent, runErr), true)\n637: \t\t}\n638: \n639: \t\t// Stall backstop: the same agent invoked twice in a\n640: \t\t// row, each time persisting nothing at all (neither Stage() nor the\n641: \t\t// branch HEAD moved across that invocation), stops on the second\n642: \t\t// such occurrence — a single no-op invocation is tolerated (it may\n643: \t\t// be transient), but two in a row for the same agent means it's\n644: \t\t// genuinely stuck, regardless of whether the NEEDS-HUMAN-INPUT\n645: \t\t// marker was present.\n646: \t\tstageAfter := j.Stage()\n647: \t\t// Fresh context for the post-agent probe: the pre-agent probeCtx\n648: \t\t// above was cancelled before runner.Run and would in any case be\n649: \t\t// long expired after a minutes-long invocation — reusing it would\n650: \t\t// make this probe fail instantly and read \"\", which noChange would\n651: \t\t// take as a HEAD change and the stall backstop would never fire.\n652: \t\tprobeAfterCtx, cancelProbeAfter := context.WithTimeout(context.Background(), jdiProbeTimeout)\n653: \t\theadAfter, _ := git.HeadCommitWithContext(probeAfterCtx, root, j.Branch)\n654: \t\tcancelProbeAfter()\n655: \t\tnoChange := stageAfter == stageBefore && headAfter == headBefore\n656: \n657: \t\tif noChange && lastNoChange && decision.Agent == lastAgent {\n658: \t\t\treturn finish(orchestrate.StopNeedsHuman, fmt.Sprintf(\"%s made no progress on two consecutive runs (Stage and branch HEAD unchanged both times) — stopping rather than looping indefinitely\", decision.Agent), true)\n659: \t\t}\n660: \t\tlastAgent, lastNoChange = decision.Agent, noChange\n661: \t}\n662: \n663: \treturn finish(orchestrate.StopNeedsHuman, fmt.Sprintf(\"exceeded %d iterations without finishing\", maxIterations), true)\n664: }\n\n(End of file - total 664 lines)\n</content>","metadata":{"preview":"// mg jdi (\"just do it\") drives a job's fixed agent sequence —\n// @analyst → @developer → @reviewer — end to end without a human manually\n// triggering each stage. It is the fold of the former cmd/jdi main into\n// the single mg binary (runJDI).\n//\n// It resolves the job by ID or directory name, then repeatedly asks\n// internal/orchestrate what to do next given the job's current\n// job.Stage() and git-derived retry-round state, invokes that agent\n// non-interactively (internal/session's --print path, see scripts/entrypoint.sh),\n// and loops — until the job's verdict is APPROVED or it needs a human (the\n// retry budget is exhausted, an agent asked a question via the\n// NEEDS-HUMAN-INPUT marker, or the same agent made no progress twice in a\n// row).\n//\n// It does not auto-merge the finished branch.\n//\n// Run from anywhere inside a project that has a docs/ directory:\n//\n//\tmg jdi --job/-j <id-or-name>\npackage main","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/cmd/mg/jdi.go","text":"// mg jdi (\"just do it\") drives a job's fixed agent sequence —\n// @analyst → @developer → @reviewer — end to end without a human manually\n// triggering each stage. It is the fold of the former cmd/jdi main into\n// the single mg binary (runJDI).\n//\n// It resolves the job by ID or directory name, then repeatedly asks\n// internal/orchestrate what to do next given the job's current\n// job.Stage() and git-derived retry-round state, invokes that agent\n// non-interactively (internal/session's --print path, see scripts/entrypoint.sh),\n// and loops — until the job's verdict is APPROVED or it needs a human (the\n// retry budget is exhausted, an agent asked a question via the\n// NEEDS-HUMAN-INPUT marker, or the same agent made no progress twice in a\n// row).\n//\n// It does not auto-merge the finished branch.\n//\n// Run from anywhere inside a project that has a docs/ directory:\n//\n//\tmg jdi --job/-j <id-or-name>\npackage main\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/notify\"\n\t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n\t\"github.com/lmuskalla/manigot/internal/session\"\n)\n\n// jdiVersion is the mg-jdi version. Overridden at build time with:\n//\n//\tgo build -ldflags \"-X main.jdiVersion=1.2.3\"\nvar jdiVersion = \"0.1.0-dev\"\n\n// runJDI implements `mg jdi` (thematic alias `mg made-man`) — the fold of the\n// former cmd/jdi main into the single mg binary. It parses the flags, drives\n// the job's @analyst → @developer → @reviewer sequence end to end, and returns\n// the process exit code: 2 for flag/argument errors, 1 when the run stops\n// needing human input, 0 otherwise.\nfunc runJDI(args []string, stdout, stderr io.Writer) int {\n\tfs := flag.NewFlagSet(\"mg jdi\", flag.ContinueOnError)\n\tfs.SetOutput(stderr)\n\tvar jobArg string\n\tfs.StringVar(&jobArg, \"job\", \"\", \"job ID or directory name to drive (required)\")\n\tfs.StringVar(&jobArg, \"j\", \"\", \"short form of --job\")\n\tprofileArg := fs.String(\"profile\", \"\", \"subscription profile to run agents under: claude-pro, zai, opencode-go, opencode-zen, or opencode-zen-free (default claude-pro)\")\n\tfs.Usage = func() {\n\t\tfmt.Fprintf(stderr, \"mg jdi %s\\n\\n\", jdiVersion)\n\t\tfmt.Fprintf(stderr, \"Drives a job's @analyst -> @developer -> @reviewer sequence end to end.\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"Usage:\\n\")\n\t\tfmt.Fprintf(stderr, \"  mg jdi --job/-j <id-or-name> [--profile <profile>]\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"Run from anywhere inside a project that has a docs/ directory.\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"Flags:\\n\")\n\t\tfs.PrintDefaults()\n\t}\n\tif err := fs.Parse(args); err != nil {\n\t\treturn 2 // the flag package already printed the error + usage\n\t}\n\n\tif strings.TrimSpace(jobArg) == \"\" {\n\t\tfmt.Fprintln(stderr, \"mg jdi: --job is required\")\n\t\tfs.Usage()\n\t\treturn 2\n\t}\n\n\t// Default to claude-pro when unset, so existing callers/behavior are\n\t// unchanged; validated against config.Profiles() otherwise.\n\tprofile := strings.TrimSpace(*profileArg)\n\tif profile == \"\" {\n\t\tprofile = config.ProfileClaudePro\n\t}\n\tif _, ok := config.ProfileByID(profile); !ok {\n\t\tfmt.Fprintf(stderr, \"mg jdi: --profile must be one of: claude-pro, zai, opencode-go, opencode-zen, opencode-zen-free (got %q)\\n\", profile)\n\t\treturn 2\n\t}\n\n\troot, err := job.FindProjectRoot()\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"mg jdi: cannot read working directory: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif root == \"\" {\n\t\tfmt.Fprintln(stderr, \"mg jdi: could not find a docs/ directory in this or any parent directory\")\n\t\treturn 1\n\t}\n\n\tj, err := resolveJob(root, jobArg)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"mg jdi: %v\\n\", err)\n\t\treturn 1\n\t}\n\n\t// Crash notification (opt-in — see internal/notify): the previous run for\n\t// this job may have been killed without ever reporting a stop; detect it\n\t// here at the next run's start and push an attention notification. A\n\t// process that was SIGKILLed/OOM-killed cannot notify from inside itself,\n\t// so this stale-sidecar check on next start is the self-contained\n\t// approximation — an external watchdog is out of scope. Best-effort and\n\t// only when NTFY_TOPIC is set (unconfigured behavior unchanged).\n\tnotifyCrashedRun(stderr, root, j)\n\n\t// Best-effort: see ensureSidecarIgnored's own doc for why a failure here\n\t// does not abort the run.\n\tif err := ensureSidecarIgnored(root); err != nil {\n\t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not exclude the status sidecar from git: %v\\n\", err)\n\t}\n\n\trunner, err := newCommandAgentRunner(root, profile)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"mg jdi: %v\\n\", err)\n\t\treturn 1\n\t}\n\n\t// Fan-out: every invocation's formatted output\n\t// (see jdioutput.go's logInvocation) goes to both mg-jdi's own stdout —\n\t// which has an audience only for a direct CLI run; a TUI-launched run is\n\t// detached with no terminal attached to this leg at all — and the\n\t// sidecar's run.log, which the TUI log tab reads and is therefore the\n\t// only visibility path for a TUI-launched run. Writing to both\n\t// unconditionally is simplest and harmless: stdout always exists as a\n\t// file descriptor whether or not anything is reading it.\n\tlogDest := io.Writer(stdout)\n\twroteSection := false\n\tif logFile, hadContent, ferr := openRunLog(root, j.Name); ferr != nil {\n\t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not open run log, continuing with stdout only: %v\\n\", ferr)\n\t} else {\n\t\tdefer logFile.Close()\n\t\tlogDest = io.MultiWriter(stdout, logFile)\n\t\twroteSection = hadContent\n\t}\n\t// Wrap the destination in a sectionWriter (see jdioutput.go) so every\n\t// \"=== ... ===\" state-log header is preceded by a blank line instead of\n\t// the events getting crumbled together — the very first run ever written\n\t// to a fresh log excepted, which is what wroteSection captures.\n\tlogDest = &sectionWriter{w: logDest, wroteSection: wroteSection}\n\n\t// Ensure the job's session.log exists before the loop so the TUI's \"l\"\n\t// tail gate — the file's existence, see internal/ui's sessionLogExists —\n\t// is stable from the moment a run begins, mirroring run.log's own\n\t// up-front creation above. Best-effort: a failure only warns; the loop\n\t// still creates the file per invocation (see openSessionLog).\n\tif err := ensureSessionLogFile(filepath.Join(j.Dir, \"session.log\")); err != nil {\n\t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not create session log: %v\\n\", err)\n\t}\n\n\t// Status sidecar: best-effort — a write failure\n\t// (e.g. a read-only filesystem) must not abort the loop itself, only\n\t// mean the TUI's list-row badge and stop-notification dedup won't see it.\n\t// mg-jdi's own stdout/run.log remain authoritative for a human watching\n\t// directly either way.\n\tstatusFn := func(state job.JDIState, agent string) {\n\t\tif err := job.WriteJDIStatus(root, j.Name, state, agent); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not write status sidecar: %v\\n\", err)\n\t\t}\n\t}\n\n\tlogStarted(logDest, j.Name, profile)\n\tresult := Run(root, j, runner, logDest, statusFn)\n\tfmt.Fprintf(stdout, \"\\nmg jdi: %s — %s\\n\", result.Kind, result.Reason)\n\n\t// Stop notification, CLI path: ring the terminal bell\n\t// at both loop-exit points (finished, needs human) — this process is\n\t// attached to the human's own terminal for a direct `mg jdi` run, which\n\t// is the only case this leg has an audience for. A TUI-launched run has\n\t// no terminal to ring into at all; the TUI rings on its own next poll\n\t// tick instead (see pollJDIBell in internal/ui/app.go), once it observes\n\t// this job's status sidecar (just written above) transition into a\n\t// stopped state.\n\tfmt.Fprint(stdout, \"\\a\")\n\n\t// Stop notification, ntfy path (opt-in — see internal/notify): both the\n\t// CLI path and a TUI-launched run go through this same runJDI stop path,\n\t// so notifying here covers both. Best-effort like the sidecar/run-log\n\t// warnings above — a send failure warns on stderr and never aborts the\n\t// exit path.\n\tnotifyStop(stderr, j.Name, result)\n\n\tif result.Kind == orchestrate.StopNeedsHuman {\n\t\treturn 1\n\t}\n\treturn 0\n}\n\n// notifyStop sends the opt-in ntfy stop notification for a finished mg-jdi\n// run: a default-priority success message (tag white_check_mark) when the\n// run finished (result.Kind == StopFinished), and a high-priority attention\n// message (tag warning, priority 4) when it stopped needing a human. Both\n// messages carry the job name and the stop reason. It is a strict no-op when\n// NTFY_TOPIC is unset (nothing is sent, no error), and a send failure only\n// warns on stderr — never aborting the caller.\nfunc notifyStop(stderr io.Writer, jobName string, result LoopResult) {\n\tc := notify.FromConfig()\n\tif !c.Enabled() {\n\t\treturn\n\t}\n\n\tmsg := notify.Message{Message: result.Reason}\n\tswitch result.Kind {\n\tcase orchestrate.StopFinished:\n\t\tmsg.Title = \"mg jdi: \" + jobName + \" finished\"\n\t\tmsg.Tags = []string{\"white_check_mark\"}\n\tdefault: // orchestrate.StopNeedsHuman\n\t\tmsg.Title = \"mg jdi: \" + jobName + \" needs attention\"\n\t\tmsg.Tags = []string{\"warning\"}\n\t\tmsg.Priority = 4\n\t}\n\tif err := c.Publish(msg); err != nil {\n\t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not send ntfy notification: %v\\n\", err)\n\t}\n}\n\n// notifyCrashedRun checks, at a new `mg jdi` run's start, whether the\n// previous run for job j died without ever reporting a stop — a JDIRunning\n// status in the sidecar stale past job's jdiRunningStaleAfter (see\n// job.StaleRunningJDI) — and pushes a high-priority attention notification\n// (tag warning, priority 4) about it. Once the crash has been notified, the\n// stale sidecar is overwritten with JDIStoppedNeedsHuman so a later start\n// does not re-notify about the same already-known crash; a failed send does\n// not mark it, so the notification is retried on the next start instead.\n//\n// It is a strict no-op when ntfy is unconfigured (no NTFY_TOPIC): nothing is\n// read-modify-written, keeping unconfigured behavior byte-for-byte identical\n// (the TUI still degrades the stale sidecar away on its own). Failures warn\n// on stderr and never abort the run.\nfunc notifyCrashedRun(stderr io.Writer, root string, j job.Job) {\n\tc := notify.FromConfig()\n\tif !c.Enabled() {\n\t\treturn\n\t}\n\n\tst, crashed := job.StaleRunningJDI(root, j.Name)\n\tif !crashed {\n\t\treturn\n\t}\n\n\tmsg := notify.Message{\n\t\tTitle:    \"mg jdi: \" + j.Name + \" crashed\",\n\t\tMessage:  fmt.Sprintf(\"The previous mg jdi run appears to have crashed or been killed (status stale since %s).\", st.Updated.Format(time.RFC3339)),\n\t\tTags:     []string{\"warning\"},\n\t\tPriority: 4,\n\t}\n\tif st.Agent != \"\" {\n\t\tmsg.Message += fmt.Sprintf(\" Last agent: %s.\", st.Agent)\n\t}\n\tif err := c.Publish(msg); err != nil {\n\t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not send ntfy notification: %v\\n\", err)\n\t\treturn\n\t}\n\n\t// Mark the crash as known so the next start doesn't re-notify about it.\n\tif err := job.WriteJDIStatus(root, j.Name, job.JDIStoppedNeedsHuman, st.Agent); err != nil {\n\t\tfmt.Fprintf(stderr, \"mg jdi: warning: could not mark the crashed run as known: %v\\n\", err)\n\t}\n}\n\n// resolveJob finds the job named or ID-prefixed by arg among every job\n// job.Discover can see (cross-branch — see internal/job), mirroring the\n// session launcher's own --job resolution: an exact job-directory-name match\n// first, then an exact ID match, then a directory-name prefix match.\nfunc resolveJob(root, arg string) (job.Job, error) {\n\tjobs, err := job.Discover(root)\n\tif err != nil {\n\t\treturn job.Job{}, fmt.Errorf(\"could not list jobs: %w\", err)\n\t}\n\n\t// A job's Name is its id_slug — the same concept as a branch tail — so\n\t// the exact-name and name-prefix matching below reuses the branch-matching\n\t// primitives in internal/git rather than re-implementing them.\n\tbyName := make(map[string]job.Job, len(jobs))\n\tnames := make([]string, len(jobs))\n\tfor i, j := range jobs {\n\t\tbyName[j.Name] = j\n\t\tnames[i] = j.Name\n\t}\n\n\tif name := git.ExactBranchMatch(names, arg); name != \"\" {\n\t\treturn byName[name], nil\n\t}\n\tfor _, j := range jobs {\n\t\tif j.ID == arg {\n\t\t\treturn j, nil\n\t\t}\n\t}\n\n\tswitch matches := git.PrefixBranchMatches(names, arg); len(matches) {\n\tcase 0:\n\t\treturn job.Job{}, fmt.Errorf(\"job %q not found under docs/jobs/\", arg)\n\tcase 1:\n\t\treturn byName[matches[0]], nil\n\tdefault:\n\t\treturn job.Job{}, fmt.Errorf(\"job %q is ambiguous — matches %d jobs\", arg, len(matches))\n\t}\n}\n\n// AgentRunner runs one non-interactive agent invocation for job j and\n// returns its captured output (the session launcher's --print path — a\n// `claude --print --verbose --output-format stream-json` event stream, an\n// `opencode run --format json` event stream, or plain text; see\n// internal/orchestrate.DetectSignal, which handles all three). live is the\n// writer the invocation's raw output is streamed into as it arrives — Run's\n// loop passes the job's open session.log section (see openSessionLog), so\n// the verbose log grows live during the invocation instead of only after it\n// finishes; implementations must tee every captured byte into it (the real\n// runner does via io.MultiWriter — see commandAgentRunner.Run). Run's loop\n// persists the returned bytes to run.log's per-invocation summary\n// (logInvocation) and extracts the response prose via\n// orchestrate.ResultText.\n//\n// Implemented by commandAgentRunner for real invocations; the tests use a\n// fake instead of spawning real containers.\ntype AgentRunner interface {\n\tRun(agent string, j job.Job, live io.Writer) ([]byte, error)\n}\n\n// commandAgentRunner is the real AgentRunner: it calls the session package's\n// --print path in-process (the replacement for exec'ing the resolved run.sh),\n// capturing the agent's stdout and routing diagnostics to a buffer that only\n// surfaces on error — the same visibility the exec'd run.sh's fd-3\n// diagnostics had.\ntype commandAgentRunner struct {\n\tprojectRoot string\n\tprofile     string\n}\n\n// newCommandAgentRunner builds the in-process runner. projectRoot is where\n// --job resolution starts from (run.sh used $PWD, which the old runner set to\n// the project root); profile is passed through unchanged to every Run\n// invocation — see its own doc.\nfunc newCommandAgentRunner(projectRoot, profile string) (*commandAgentRunner, error) {\n\treturn &commandAgentRunner{projectRoot: projectRoot, profile: profile}, nil\n}\n\n// agentInvocation builds the session options for one agent run — the --print\n// invocation with the runner's pinned profile, the agent, and the exact job\n// directory name.\nfunc (r *commandAgentRunner) agentInvocation(agent string, j job.Job) session.Options {\n\treturn session.Options{Print: true, Profile: r.profile, Agent: agent, Job: j.Name}\n}\n\n// Run invokes the session launcher's --print path synchronously and returns\n// its stdout. The --print path keeps stdout clean of its own diagnostics\n// (they go to the diag writer), so stdout here is exactly the agent's own\n// response. live receives the exact same bytes as they arrive — the io.\n// MultiWriter tee that makes the job's session.log grow live during the\n// invocation (the loop passes the open sessionLog section; see Run). j.Name\n// (the exact job directory name) is passed rather than j.ID to remove any\n// ambiguity in the --job resolution.\n//\n// r.profile is passed explicitly rather than left to the launcher's own\n// default (main's --profile flag, validated and defaulted to\n// config.ProfileClaudePro there) so a run keeps using the profile it was\n// started with even when the user later changes their default profile via\n// `mg profiles` mid-run.\nfunc (r *commandAgentRunner) Run(agent string, j job.Job, live io.Writer) ([]byte, error) {\n\topts := r.agentInvocation(agent, j)\n\tinfo, err := session.ResolveProfile(opts)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\troot, err := session.ResolveRootFrom(opts, r.projectRoot)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif err := info.CheckAuth(); err != nil {\n\t\treturn nil, err\n\t}\n\n\tvar diag bytes.Buffer\n\tinv, err := session.BuildDockerInvocation(opts, info, root, false, &diag)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\t// Prune orphaned manigot containers before the run — the same fail-soft\n\t// self-healing cleanup as the interactive session path. Warnings go into\n\t// the diag buffer, which only surfaces on error; a prune failure never\n\t// aborts the invocation.\n\tif _, err := pruneOrphans(&diag); err != nil {\n\t\tfmt.Fprintf(&diag, \"mg: warning: could not prune orphaned containers: %v\\n\", err)\n\t}\n\n\t// Tee the container's stdout into both the capture buffer (returned to\n\t// the loop for DetectSignal/ResultText) and the live session.log writer,\n\t// so the verbose log grows as the bytes arrive rather than post-hoc.\n\tvar stdout bytes.Buffer\n\tcode, ran := inv.Run(os.Stdin, io.MultiWriter(&stdout, live), &diag)\n\t// The same host-side sweep as the interactive session path: every mg-jdi\n\t// --print invocation ends with leftover changes committed, including the\n\t// analyst's tasks.md (the analyst is read-only and cannot commit it\n\t// itself) and this invocation's just-streamed session.log section (the\n\t// header was written before the run and the raw bytes during it, so the\n\t// section is complete by the time this sweep runs). The sweep runs before\n\t// the loop's post-run stall probe reads HEAD, so the sweep commit\n\t// correctly counts as agent progress. Sweep only when the container\n\t// actually ran — an agent that never started must not trigger a commit.\n\tif ran {\n\t\tsession.SweepJobWorktree(root, &diag)\n\t}\n\tif code != 0 {\n\t\treturn stdout.Bytes(), fmt.Errorf(\"mg --print --agent %s --job %s: exit code %d: %s\", agent, j.Name, code, strings.TrimSpace(diag.String()))\n\t}\n\treturn stdout.Bytes(), nil\n}\n\n// LoopResult is Run's outcome: always one of orchestrate.StopFinished or\n// orchestrate.StopNeedsHuman — Run never returns while orchestrate.Next\n// keeps saying RunAgent.\ntype LoopResult struct {\n\tKind   orchestrate.Kind\n\tReason string\n}\n\n// maxIterations is a hard safety cap on loop iterations, independent of\n// orchestrate.Next's own one-bounce retry budget — a defensive backstop\n// against an unforeseen bug in the state machine looping forever rather than\n// trusting Next's own termination alone.\nconst maxIterations = 20\n\n// jdiProbeTimeout bounds each loop iteration's git probes (HeadCommit,\n// CountVerdictCommits, LatestCommitIsVerdict): local, fast reads, so 10s is\n// generous — the point is that a hung git stalls one probe rather than the\n// whole run. The probe errors are already read with `_` (the loop tolerates a\n// failed probe as \"no information\"), so a timeout degrades exactly like any\n// other probe failure and surfaces in the stop reason only if it's the last\n// thing that happened before a stop.\n//\n// A var rather than a const so tests can lower it: the stall-backstop test\n// needs a runner whose Run call outlives the probe timeout, which would be\n// a 10s test at the production value.\nvar jdiProbeTimeout = 10 * time.Second\n\n// StatusFunc is called by Run at each state transition: once\n// before invoking an agent (job.JDIRunning, that agent's name) and once\n// more at loop exit (the terminal state, and the last agent that ran, or \"\"\n// if none ever did — e.g. a job stuck at StageDefine). May be nil, in which\n// case Run simply doesn't report status — used by tests that don't care\n// about the sidecar file.\ntype StatusFunc func(state job.JDIState, agent string)\n\n// jdiTerminalState maps a LoopResult's orchestrate.Kind (always\n// StopFinished or StopNeedsHuman by the time Run returns) to the\n// corresponding job.JDIState reported to StatusFunc.\nfunc jdiTerminalState(k orchestrate.Kind) job.JDIState {\n\tif k == orchestrate.StopFinished {\n\t\treturn job.JDIStoppedFinished\n\t}\n\treturn job.JDIStoppedNeedsHuman\n}\n\n// Run drives job j through the agent sequence via runner, writing each\n// invocation's formatted output to log (see jdioutput.go's logInvocation) and\n// reporting state transitions to status (may be nil), until\n// orchestrate.Next reports StopFinished or StopNeedsHuman.\n//\n// The attempt number in each invocation's log header (logAgentInvoked /\n// logInvocation) counts that agent's own invocations within this run — per\n// agent, not a run-wide counter — so a bounce back to the developer logs\n// that developer's second call as attempt 2, not attempt 4. The counter is\n// seeded at 0 before the loop and reset at the start of every run, matching\n// the loop index's old behavior.\n//\n// Each iteration re-derives its decision from job.Stage() and git — the\n// job.Job struct's identity fields (Dir/Root/Branch/ID/Name) never change\n// across iterations, but Stage() and the git.CountVerdictCommits/\n// LatestCommitIsVerdict reads underneath it are re-evaluated fresh every\n// time, since they read from disk/git rather than a cached snapshot — so\n// Run never needs to re-fetch or mutate j itself mid-loop.\nfunc Run(root string, j job.Job, runner AgentRunner, log io.Writer, status StatusFunc) LoopResult {\n\tvar lastAgent string\n\tvar lastNoChange bool\n\tvar agentEverRan bool\n\n\treport := func(state job.JDIState, agent string) {\n\t\tif status != nil {\n\t\t\tstatus(state, agent)\n\t\t}\n\t}\n\t// finish reports the terminal status, logs the \"job finished\" event,\n\t// and builds the LoopResult every exit point returns.\n\t// includeReason is normally true; it's false only for the\n\t// stop-before-any-agent-ran case below, whose reason was already printed\n\t// by logImmediateStop a line above — see logJobFinished's own doc.\n\t//\n\t// Loop-exit sweep first: the per-invocation sweep\n\t// (session.SweepJobWorktree inside commandAgentRunner.Run) now runs AFTER\n\t// each invocation's live session.log writes — the section header is\n\t// written before the invocation and the raw bytes are tee'd into the\n\t// file during it, so by the time the sweep runs the section is complete,\n\t// and the sweep's `git add -A` commits it (untracked on iteration 1,\n\t// a tracked modification thereafter) exactly as it commits the agent's\n\t// own files. What the per-invocation sweep can't cover is a run whose\n\t// container never started (ran=false — the sweep is skipped, but the\n\t// header may already be in the file) or a test fake runner that sweeps\n\t// nothing at all; without this loop-exit sweep the final section would\n\t// then stay an uncommitted tracked modification — git.WorkingTreeDirty\n\t// DOES report tracked modifications, so mg done's clean-tree check\n\t// (finish.go) would refuse to finish the job. Commit everything left —\n\t// the final session.log section above all — with the sweep's own\n\t// message. Linked worktrees only: for a pre-worktree job\n\t// (branch checked out in the MAIN worktree itself — an explicitly\n\t// supported, Discover-visible state) the resolved worktree IS j.Root,\n\t// where the user's own uncommitted work lives — sweeping there would\n\t// commit it, an unexcluded .env included, onto the job branch, the\n\t// exact hazard session.SweepJobWorktree's ProjectRoot == InvocationRoot\n\t// gate exists for — so the sweep is skipped when WorktreeForBranch\n\t// resolves to the main worktree. The stop-before-any-agent path has\n\t// nothing to commit and ErrNothingToCommit is swallowed.\n\tfinish := func(kind orchestrate.Kind, reason string, includeReason bool) LoopResult {\n\t\tif wt, ok, err := git.WorktreeForBranch(j.Root, j.Branch); err != nil {\n\t\t\tfmt.Fprintf(log, \"mg jdi: warning: could not resolve worktree for the final session-log sweep: %v\\n\", err)\n\t\t} else if ok && filepath.Clean(wt) != filepath.Clean(j.Root) {\n\t\t\tif err := git.CommitAll(wt, fmt.Sprintf(\"[%s] chore: commit all\", j.ID)); err != nil && !errors.Is(err, git.ErrNothingToCommit) && !errors.Is(err, git.ErrNotARepo) {\n\t\t\t\tfmt.Fprintf(log, \"mg jdi: warning: could not commit the session log: %v\\n\", err)\n\t\t\t}\n\t\t}\n\t\treport(jdiTerminalState(kind), lastAgent)\n\t\tlogJobFinished(log, kind, reason, includeReason)\n\t\treturn LoopResult{Kind: kind, Reason: reason}\n\t}\n\n\t// attempts counts each agent's invocations within this run, keyed by\n\t// agent name — per agent, not run-wide — and feeds the \"attempt N\" in\n\t// both logAgentInvoked's and logInvocation's headers below. Seeded at 0\n\t// before the loop, so the first call of every agent is attempt 1.\n\tattempts := make(map[string]int)\n\n\tfor i := 0; i < maxIterations; i++ {\n\t\t// One bounded context for this iteration's pre-agent git probes\n\t\t// (see jdiProbeTimeout): a hung git must stall one probe, not the\n\t\t// whole run. Each context is cancelled at its point of use — never\n\t\t// deferred, which would accumulate up to maxIterations timers until\n\t\t// Run returns. The post-agent stall probe gets its own fresh context\n\t\t// below: runner.Run is a minutes-long docker/LLM invocation, so a\n\t\t// context created here would be long expired by the time that probe\n\t\t// runs and would read \"\" for HEAD, silently defeating the stall\n\t\t// backstop.\n\t\tprobeCtx, cancelProbes := context.WithTimeout(context.Background(), jdiProbeTimeout)\n\n\t\tstageBefore := j.Stage()\n\t\trounds, _ := git.CountVerdictCommitsWithContext(probeCtx, root, j.Branch, j.ID)\n\t\ttipIsVerdict, _ := git.LatestCommitIsVerdictWithContext(probeCtx, root, j.Branch, j.ID)\n\t\tdecision := orchestrate.Next(stageBefore, rounds, tipIsVerdict)\n\n\t\tif decision.Kind != orchestrate.RunAgent {\n\t\t\tcancelProbes()\n\t\t\tincludeReason := true\n\t\t\tif !agentEverRan {\n\t\t\t\t// No agent has run yet this whole loop (typically the very\n\t\t\t\t// first iteration, e.g. an unwritten brief.md) — logInvocation\n\t\t\t\t// never gets a chance to run for this stop, which otherwise\n\t\t\t\t// leaves run.log at 0 bytes for a case that has just as much\n\t\t\t\t// reason to explain itself there as any agent invocation does.\n\t\t\t\tlogImmediateStop(log, decision.Reason)\n\t\t\t\tincludeReason = false\n\t\t\t}\n\t\t\treturn finish(decision.Kind, decision.Reason, includeReason)\n\t\t}\n\n\t\treport(job.JDIRunning, decision.Agent)\n\t\tattempts[decision.Agent]++\n\t\tlogAgentInvoked(log, decision.Agent, attempts[decision.Agent])\n\t\theadBefore, _ := git.HeadCommitWithContext(probeCtx, root, j.Branch)\n\t\tcancelProbes() // pre-agent probes done; the agent invocation below can take minutes\n\n\t\t// Session log: open the job's session.log and write the section\n\t\t// header (agent, attempt, timestamp) BEFORE the invocation, then\n\t\t// stream the invocation's raw bytes into it live as they arrive —\n\t\t// the runner tees through the live writer (see commandAgentRunner.\n\t\t// Run's io.MultiWriter), so a `tail -f` on the file sees the\n\t\t// blow-by-blow grow during the run instead of only after it\n\t\t// finishes. This replaces the old post-hoc appendSessionLog call.\n\t\t// The section is written for EVERY invocation, failed ones included,\n\t\t// so what an agent did during an unattended run survives. Best-effort:\n\t\t// an open failure only warns through the log writer (Run has no\n\t\t// stderr) and never aborts the loop — the invocation still runs and\n\t\t// its output still lands in run.log's summary; only this invocation's\n\t\t// verbose persistence is lost, and the next invocation retries the\n\t\t// open on its own.\n\t\tsess, sessErr := openSessionLog(filepath.Join(j.Dir, \"session.log\"), decision.Agent, attempts[decision.Agent])\n\t\tif sessErr != nil {\n\t\t\tfmt.Fprintf(log, \"mg jdi: warning: could not open session log: %v\\n\", sessErr)\n\t\t}\n\t\tlive := io.Writer(io.Discard)\n\t\tif sess != nil {\n\t\t\tlive = sess\n\t\t}\n\t\tout, runErr := runner.Run(decision.Agent, j, live)\n\t\tagentEverRan = true\n\t\tif sess != nil {\n\t\t\tif cerr := sess.Close(); cerr != nil {\n\t\t\t\tfmt.Fprintf(log, \"mg jdi: warning: could not finalize session log: %v\\n\", cerr)\n\t\t\t}\n\t\t}\n\n\t\t// Read the just-run agent's expected target file fresh off\n\t\t// disk, so logInvocation can skip re-printing output that's already\n\t\t// the same as what got written to the job's own markdown file. Safe\n\t\t// to read directly from j.Dir — see orchestrate.AgentTargetFile's own\n\t\t// doc. A missing/unreadable file (targetContent left \"\") just means\n\t\t// logInvocation's dedup check never matches, which is the same as\n\t\t// not having this feature at all for that call.\n\t\tvar targetContent string\n\t\ttargetFile := orchestrate.AgentTargetFile[decision.Agent]\n\t\tif targetFile != \"\" {\n\t\t\tif data, rerr := os.ReadFile(filepath.Join(j.Dir, targetFile)); rerr == nil {\n\t\t\t\ttargetContent = string(data)\n\t\t\t}\n\t\t}\n\n\t\t// Fan-out: log gets the same formatted section\n\t\t// regardless of whether it's os.Stdout, the sidecar run.log, or (in\n\t\t// tests) an in-memory buffer — see main()'s io.MultiWriter and\n\t\t// jdioutput.go's logInvocation. DetectSignal below scans the raw bytes\n\t\t// directly (it does its own JSON extraction), independent of what\n\t\t// logInvocation writes for a human to read.\n\t\tlogInvocation(log, decision.Agent, attempts[decision.Agent], out, targetFile, targetContent)\n\n\t\tif sig, ok := orchestrate.DetectSignal(out); ok {\n\t\t\tlastAgent = decision.Agent\n\t\t\treturn finish(orchestrate.StopNeedsHuman, fmt.Sprintf(\"%s asked for human input: %s\", decision.Agent, sig.Reason), true)\n\t\t}\n\t\tif runErr != nil {\n\t\t\tlastAgent = decision.Agent\n\t\t\treturn finish(orchestrate.StopNeedsHuman, fmt.Sprintf(\"%s invocation failed: %v\", decision.Agent, runErr), true)\n\t\t}\n\n\t\t// Stall backstop: the same agent invoked twice in a\n\t\t// row, each time persisting nothing at all (neither Stage() nor the\n\t\t// branch HEAD moved across that invocation), stops on the second\n\t\t// such occurrence — a single no-op invocation is tolerated (it may\n\t\t// be transient), but two in a row for the same agent means it's\n\t\t// genuinely stuck, regardless of whether the NEEDS-HUMAN-INPUT\n\t\t// marker was present.\n\t\tstageAfter := j.Stage()\n\t\t// Fresh context for the post-agent probe: the pre-agent probeCtx\n\t\t// above was cancelled before runner.Run and would in any case be\n\t\t// long expired after a minutes-long invocation — reusing it would\n\t\t// make this probe fail instantly and read \"\", which noChange would\n\t\t// take as a HEAD change and the stall backstop would never fire.\n\t\tprobeAfterCtx, cancelProbeAfter := context.WithTimeout(context.Background(), jdiProbeTimeout)\n\t\theadAfter, _ := git.HeadCommitWithContext(probeAfterCtx, root, j.Branch)\n\t\tcancelProbeAfter()\n\t\tnoChange := stageAfter == stageBefore && headAfter == headBefore\n\n\t\tif noChange && lastNoChange && decision.Agent == lastAgent {\n\t\t\treturn finish(orchestrate.StopNeedsHuman, fmt.Sprintf(\"%s made no progress on two consecutive runs (Stage and branch HEAD unchanged both times) — stopping rather than looping indefinitely\", decision.Agent), true)\n\t\t}\n\t\tlastAgent, lastNoChange = decision.Agent, noChange\n\t}\n\n\treturn finish(orchestrate.StopNeedsHuman, fmt.Sprintf(\"exceeded %d iterations without finishing\", maxIterations), true)\n}","lineStart":1,"lineEnd":664,"totalLines":664,"truncated":false}},"title":"src/cmd/mg/jdi.go","time":{"start":1787921088635,"end":1787921088639}},"id":"prt_04866c001001Z5VS0KHhSrLn1r","sessionID":"ses_fb7999c4fffe1anLtOEgzjXUGJ","messageID":"msg_04866b6a2001LWt8hsYX7pXele"}}
