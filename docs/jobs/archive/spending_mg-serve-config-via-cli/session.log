{"type":"tool_use","timestamp":1787993314034,"sessionID":"ses_fb34d9020ffe9TT7hHKcNCMGib","part":{"type":"tool","tool":"read","callID":"call_09ce73f3d8f44499b88dbad1","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/home/home.go"},"output":"<path>/workspace/src/internal/home/home.go</path>\n<type>file</type>\n<content>\n1: // Package home locates the manigot checkout the running binary belongs to —\n2: // the source of .env, config/tui-settings.json, agents/, skills/, assets/,\n3: // prompts/ (the system-wide meta prompt) and the project template. It\n4: // replaced the resolve package's checkout derivation: once the single `mg`\n5: // binary became the whole host-side tool there were no host scripts left to\n6: // resolve, but the checkout that provides the binary's data files still needs\n7: // locating — for an installed symlink (whose real target lives in a checkout),\n8: // a checkout's own bin/mg, and `go run` from the checkout root.\n9: package home\n10: \n11: import (\n12: \t\"os\"\n13: \t\"path/filepath\"\n14: \t\"strings\"\n15: \t\"sync\"\n16: )\n17: \n18: // EnvHome is the environment variable that overrides the checkout location\n19: // ($MANIGOT_HOME). It is a public, user-facing contract — renaming it breaks\n20: // anyone who has put it in their shell profile.\n21: const EnvHome = \"MANIGOT_HOME\"\n22: \n23: // Root returns the manigot checkout root, or \"\" when it cannot be located.\n24: // Resolution order:\n25: //\n26: //  1. $MANIGOT_HOME (an explicit, user-set override);\n27: //  2. the running binary's own location — bin/mg inside the checkout, or a\n28: //     symlinked install resolved back into it (the binary one directory\n29: //     below the checkout root, and the root itself);\n30: //  3. the working directory (covers `cd src && go run ./cmd/mg` from the\n31: //     checkout root, where the binary lives in a temp build dir that looks\n32: //     like nothing).\n33: func Root() string {\n34: \tif home := strings.TrimSpace(os.Getenv(EnvHome)); home != \"\" {\n35: \t\treturn absOrSame(home)\n36: \t}\n37: \tfor _, dir := range executableRoots() {\n38: \t\treturn dir\n39: \t}\n40: \tif cwd, err := os.Getwd(); err == nil {\n41: \t\tif looksLikeCheckout(cwd) {\n42: \t\t\treturn cwd\n43: \t\t}\n44: \t}\n45: \treturn \"\"\n46: }\n47: \n48: // Seed sets $MANIGOT_HOME for this process (and therefore for every child it\n49: // spawns) when it is not already set and a checkout could be derived from the\n50: // binary's own location. Call it once at startup — it means a directly\n51: // invoked bin/mg carries its checkout context the same way a wrapper script\n52: // would have. It returns the value in effect, or \"\".\n53: func Seed() string {\n54: \tif home := strings.TrimSpace(os.Getenv(EnvHome)); home != \"\" {\n55: \t\treturn home\n56: \t}\n57: \tfor _, dir := range executableRoots() {\n58: \t\tif err := os.Setenv(EnvHome, dir); err == nil {\n59: \t\t\treturn dir\n60: \t\t}\n61: \t}\n62: \treturn \"\"\n63: }\n64: \n65: // executableRoots derives candidate manigot checkouts from the location of the\n66: // running binary. Two shapes are considered, for both the literal path and the\n67: // symlink-resolved one (an install is typically a symlink from /usr/local/bin\n68: // into a checkout): the binary sitting in the checkout root, and one directory\n69: // below it (bin/). Under `go run` the binary lives in a temporary build\n70: // directory, which is not a checkout — looksLikeCheckout rejects it, so that\n71: // case falls through to the working-directory fallback.\n72: func executableRoots() []string {\n73: \texecutableRootsOnce.Do(func() {\n74: \t\texecutableRootsCache = computeExecutableRoots()\n75: \t})\n76: \treturn executableRootsCache\n77: }\n78: \n79: // executableRootsOnce / executableRootsCache memoize computeExecutableRoots:\n80: // os.Executable and filepath.EvalSymlinks are process-constant and not cheap,\n81: // and Root() sits on config's env-read hot path — deriving them once per\n82: // process is the win. The MANIGOT_HOME env check in Root() stays uncached: it\n83: // is cheap and must be read fresh (Seed sets it at startup, and tests set it\n84: // per-test).\n85: var (\n86: \texecutableRootsOnce  sync.Once\n87: \texecutableRootsCache []string\n88: )\n89: \n90: // computeExecutableRoots is executableRoots' uncached body.\n91: func computeExecutableRoots() []string {\n92: \texe, err := os.Executable()\n93: \tif err != nil {\n94: \t\treturn nil\n95: \t}\n96: \n97: \tpaths := []string{exe}\n98: \t// EvalSymlinks fails on a broken link; ignore it and keep the literal path.\n99: \tif real, err := filepath.EvalSymlinks(exe); err == nil && real != exe {\n100: \t\tpaths = append(paths, real)\n101: \t}\n102: \n103: \tvar roots []string\n104: \tseen := map[string]bool{}\n105: \tfor _, p := range paths {\n106: \t\tdir := filepath.Dir(p)\n107: \t\tfor _, candidate := range []string{dir, filepath.Dir(dir)} {\n108: \t\t\tif candidate == \"\" || seen[candidate] || !looksLikeCheckout(candidate) {\n109: \t\t\t\tcontinue\n110: \t\t\t}\n111: \t\t\tseen[candidate] = true\n112: \t\t\troots = append(roots, candidate)\n113: \t\t}\n114: \t}\n115: \treturn roots\n116: }\n117: \n118: // looksLikeCheckout reports whether dir is plausibly a manigot checkout. It\n119: // keys off scripts/entrypoint.sh — the one script that survives the\n120: // consolidation (it runs inside the container image, not the host) — so that\n121: // neither a coincidental directory layout nor a `go run` temp dir is mistaken\n122: // for one.\n123: func looksLikeCheckout(dir string) bool {\n124: \tif dir == \"\" || dir == \".\" || dir == string(filepath.Separator) {\n125: \t\treturn false\n126: \t}\n127: \tinfo, err := os.Stat(filepath.Join(dir, \"scripts\", \"entrypoint.sh\"))\n128: \treturn err == nil && !info.IsDir()\n129: }\n130: \n131: // absOrSame makes path absolute, falling back to the input if the working\n132: // directory cannot be determined.\n133: func absOrSame(path string) string {\n134: \tif abs, err := filepath.Abs(path); err == nil {\n135: \t\treturn abs\n136: \t}\n137: \treturn path\n138: }\n\n(End of file - total 138 lines)\n</content>","metadata":{"preview":"// Package home locates the manigot checkout the running binary belongs to —\n// the source of .env, config/tui-settings.json, agents/, skills/, assets/,\n// prompts/ (the system-wide meta prompt) and the project template. It\n// replaced the resolve package's checkout derivation: once the single `mg`\n// binary became the whole host-side tool there were no host scripts left to\n// resolve, but the checkout that provides the binary's data files still needs\n// locating — for an installed symlink (whose real target lives in a checkout),\n// a checkout's own bin/mg, and `go run` from the checkout root.\npackage home\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n)\n\n// EnvHome is the environment variable that overrides the checkout location\n// ($MANIGOT_HOME). It is a public, user-facing contract — renaming it breaks\n// anyone who has put it in their shell profile.","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/home/home.go","text":"// Package home locates the manigot checkout the running binary belongs to —\n// the source of .env, config/tui-settings.json, agents/, skills/, assets/,\n// prompts/ (the system-wide meta prompt) and the project template. It\n// replaced the resolve package's checkout derivation: once the single `mg`\n// binary became the whole host-side tool there were no host scripts left to\n// resolve, but the checkout that provides the binary's data files still needs\n// locating — for an installed symlink (whose real target lives in a checkout),\n// a checkout's own bin/mg, and `go run` from the checkout root.\npackage home\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n)\n\n// EnvHome is the environment variable that overrides the checkout location\n// ($MANIGOT_HOME). It is a public, user-facing contract — renaming it breaks\n// anyone who has put it in their shell profile.\nconst EnvHome = \"MANIGOT_HOME\"\n\n// Root returns the manigot checkout root, or \"\" when it cannot be located.\n// Resolution order:\n//\n//  1. $MANIGOT_HOME (an explicit, user-set override);\n//  2. the running binary's own location — bin/mg inside the checkout, or a\n//     symlinked install resolved back into it (the binary one directory\n//     below the checkout root, and the root itself);\n//  3. the working directory (covers `cd src && go run ./cmd/mg` from the\n//     checkout root, where the binary lives in a temp build dir that looks\n//     like nothing).\nfunc Root() string {\n\tif home := strings.TrimSpace(os.Getenv(EnvHome)); home != \"\" {\n\t\treturn absOrSame(home)\n\t}\n\tfor _, dir := range executableRoots() {\n\t\treturn dir\n\t}\n\tif cwd, err := os.Getwd(); err == nil {\n\t\tif looksLikeCheckout(cwd) {\n\t\t\treturn cwd\n\t\t}\n\t}\n\treturn \"\"\n}\n\n// Seed sets $MANIGOT_HOME for this process (and therefore for every child it\n// spawns) when it is not already set and a checkout could be derived from the\n// binary's own location. Call it once at startup — it means a directly\n// invoked bin/mg carries its checkout context the same way a wrapper script\n// would have. It returns the value in effect, or \"\".\nfunc Seed() string {\n\tif home := strings.TrimSpace(os.Getenv(EnvHome)); home != \"\" {\n\t\treturn home\n\t}\n\tfor _, dir := range executableRoots() {\n\t\tif err := os.Setenv(EnvHome, dir); err == nil {\n\t\t\treturn dir\n\t\t}\n\t}\n\treturn \"\"\n}\n\n// executableRoots derives candidate manigot checkouts from the location of the\n// running binary. Two shapes are considered, for both the literal path and the\n// symlink-resolved one (an install is typically a symlink from /usr/local/bin\n// into a checkout): the binary sitting in the checkout root, and one directory\n// below it (bin/). Under `go run` the binary lives in a temporary build\n// directory, which is not a checkout — looksLikeCheckout rejects it, so that\n// case falls through to the working-directory fallback.\nfunc executableRoots() []string {\n\texecutableRootsOnce.Do(func() {\n\t\texecutableRootsCache = computeExecutableRoots()\n\t})\n\treturn executableRootsCache\n}\n\n// executableRootsOnce / executableRootsCache memoize computeExecutableRoots:\n// os.Executable and filepath.EvalSymlinks are process-constant and not cheap,\n// and Root() sits on config's env-read hot path — deriving them once per\n// process is the win. The MANIGOT_HOME env check in Root() stays uncached: it\n// is cheap and must be read fresh (Seed sets it at startup, and tests set it\n// per-test).\nvar (\n\texecutableRootsOnce  sync.Once\n\texecutableRootsCache []string\n)\n\n// computeExecutableRoots is executableRoots' uncached body.\nfunc computeExecutableRoots() []string {\n\texe, err := os.Executable()\n\tif err != nil {\n\t\treturn nil\n\t}\n\n\tpaths := []string{exe}\n\t// EvalSymlinks fails on a broken link; ignore it and keep the literal path.\n\tif real, err := filepath.EvalSymlinks(exe); err == nil && real != exe {\n\t\tpaths = append(paths, real)\n\t}\n\n\tvar roots []string\n\tseen := map[string]bool{}\n\tfor _, p := range paths {\n\t\tdir := filepath.Dir(p)\n\t\tfor _, candidate := range []string{dir, filepath.Dir(dir)} {\n\t\t\tif candidate == \"\" || seen[candidate] || !looksLikeCheckout(candidate) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tseen[candidate] = true\n\t\t\troots = append(roots, candidate)\n\t\t}\n\t}\n\treturn roots\n}\n\n// looksLikeCheckout reports whether dir is plausibly a manigot checkout. It\n// keys off scripts/entrypoint.sh — the one script that survives the\n// consolidation (it runs inside the container image, not the host) — so that\n// neither a coincidental directory layout nor a `go run` temp dir is mistaken\n// for one.\nfunc looksLikeCheckout(dir string) bool {\n\tif dir == \"\" || dir == \".\" || dir == string(filepath.Separator) {\n\t\treturn false\n\t}\n\tinfo, err := os.Stat(filepath.Join(dir, \"scripts\", \"entrypoint.sh\"))\n\treturn err == nil && !info.IsDir()\n}\n\n// absOrSame makes path absolute, falling back to the input if the working\n// directory cannot be determined.\nfunc absOrSame(path string) string {\n\tif abs, err := filepath.Abs(path); err == nil {\n\t\treturn abs\n\t}\n\treturn path\n}","lineStart":1,"lineEnd":138,"totalLines":138,"truncated":false}},"title":"src/internal/home/home.go","time":{"start":1787993314029,"end":1787993314031}},"id":"prt_04cb4d2eb001gLyWAEWwJsAN0E","sessionID":"ses_fb34d9020ffe9TT7hHKcNCMGib","messageID":"msg_04cb4cc01001NAM2iJVWRhm2qs"}}
