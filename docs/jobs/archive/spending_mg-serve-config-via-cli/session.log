{"type":"tool_use","timestamp":1787992694311,"sessionID":"ses_fb356b356ffep6vyvmzQINQBoz","part":{"type":"tool","tool":"read","callID":"call_2e1a55ea82c547d3a3238415","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/registry_test.go"},"output":"<path>/workspace/src/internal/serve/registry_test.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"os\"\n5: \t\"path/filepath\"\n6: \t\"strings\"\n7: \t\"testing\"\n8: )\n9: \n10: // writeRegistry writes a registry config file at path with the given\n11: // projects JSON.\n12: func writeRegistry(t *testing.T, path, projectsJSON string) {\n13: \tt.Helper()\n14: \tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n15: \t\tt.Fatal(err)\n16: \t}\n17: \tif err := os.WriteFile(path, []byte(projectsJSON), 0o644); err != nil {\n18: \t\tt.Fatal(err)\n19: \t}\n20: }\n21: \n22: // namedProjectsJSON renders a {\"projects\": [{\"name\":..., \"path\":...}, ...]}\n23: // registry config body from name/path pairs.\n24: func namedProjectsJSON(pairs ...[2]string) string {\n25: \tvar b strings.Builder\n26: \tb.WriteString(`{\"projects\": [`)\n27: \tfor i, p := range pairs {\n28: \t\tif i > 0 {\n29: \t\t\tb.WriteString(\", \")\n30: \t\t}\n31: \t\tb.WriteString(`{\"name\": \"` + p[0] + `\", \"path\": \"` + p[1] + `\"}`)\n32: \t}\n33: \tb.WriteString(`]}`)\n34: \treturn b.String()\n35: }\n36: \n37: // TestLoadRegistryMissingFileIsEmptyRegistry pins the degrade: a registry\n38: // config that does not exist yet (a fresh checkout) is an empty registry, not\n39: // an error — the daemon starts with nothing registered.\n40: func TestLoadRegistryMissingFileIsEmptyRegistry(t *testing.T) {\n41: \treg, err := LoadRegistry(filepath.Join(t.TempDir(), \"does-not-exist.json\"))\n42: \tif err != nil {\n43: \t\tt.Fatalf(\"LoadRegistry on missing file: %v\", err)\n44: \t}\n45: \tif got := reg.Projects(); len(got) != 0 {\n46: \t\tt.Errorf(\"Projects() = %v, want empty registry\", got)\n47: \t}\n48: \tif _, ok := reg.Project(\"anything\"); ok {\n49: \t\tt.Errorf(\"Project on empty registry resolved, want not-found\")\n50: \t}\n51: }\n52: \n53: // TestLoadRegistryParsesAndValidatesRoots: a valid config of named entries\n54: // yields the registered roots in order, each cleaned to an absolute path.\n55: func TestLoadRegistryParsesAndValidatesRoots(t *testing.T) {\n56: \ta := t.TempDir()\n57: \tb := t.TempDir()\n58: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n59: \twriteRegistry(t, path, namedProjectsJSON([2]string{\"proj-a\", a}, [2]string{\"proj-b\", b}))\n60: \n61: \treg, err := LoadRegistry(path)\n62: \tif err != nil {\n63: \t\tt.Fatalf(\"LoadRegistry: %v\", err)\n64: \t}\n65: \tgot := reg.Projects()\n66: \tif len(got) != 2 {\n67: \t\tt.Fatalf(\"Projects() = %v, want 2 roots\", got)\n68: \t}\n69: \tif got[0] != filepath.Clean(a) || got[1] != filepath.Clean(b) {\n70: \t\tt.Errorf(\"Projects() = %v, want [%s %s]\", got, a, b)\n71: \t}\n72: \n73: \tentries := reg.Entries()\n74: \tif len(entries) != 2 || entries[0].Name != \"proj-a\" || entries[1].Name != \"proj-b\" {\n75: \t\tt.Errorf(\"Entries() = %+v, want proj-a then proj-b\", entries)\n76: \t}\n77: }\n78: \n79: // TestLoadRegistryRejectsNonDirectoryEntries: an entry that exists but is not\n80: // a directory (a file), and an entry that does not exist at all, are both\n81: // errors — a broken registry must never silently serve a subset.\n82: func TestLoadRegistryRejectsNonDirectoryEntries(t *testing.T) {\n83: \tfile := filepath.Join(t.TempDir(), \"some-file\")\n84: \tif err := os.WriteFile(file, []byte(\"x\"), 0o644); err != nil {\n85: \t\tt.Fatal(err)\n86: \t}\n87: \tmissing := filepath.Join(t.TempDir(), \"does-not-exist\")\n88: \n89: \tfor _, bad := range []string{file, missing} {\n90: \t\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n91: \t\twriteRegistry(t, path, namedProjectsJSON([2]string{\"proj\", bad}))\n92: \t\tif _, err := LoadRegistry(path); err == nil {\n93: \t\t\tt.Errorf(\"LoadRegistry with entry %q = nil error, want an error\", bad)\n94: \t\t}\n95: \t}\n96: }\n97: \n98: // TestLoadRegistryRejectsUnparseableFile: a present-but-garbage config is an\n99: // error (distinct from the missing-file empty-registry degrade).\n100: func TestLoadRegistryRejectsUnparseableFile(t *testing.T) {\n101: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n102: \twriteRegistry(t, path, `{not json`)\n103: \tif _, err := LoadRegistry(path); err == nil {\n104: \t\tt.Fatal(\"LoadRegistry on garbage = nil error, want an error\")\n105: \t}\n106: }\n107: \n108: // TestLoadRegistryRejectsFlatStringForm pins the \"no backwards compatibility\"\n109: // requirement: the old flat-string schema (\"projects\": [\"/path\", ...]) fails\n110: // to parse under the object schema.\n111: func TestLoadRegistryRejectsFlatStringForm(t *testing.T) {\n112: \troot := t.TempDir()\n113: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n114: \twriteRegistry(t, path, `{\"projects\": [\"`+root+`\"]}`)\n115: \tif _, err := LoadRegistry(path); err == nil {\n116: \t\tt.Fatal(\"LoadRegistry on the flat-string form = nil error, want an error\")\n117: \t}\n118: }\n119: \n120: // TestLoadRegistryRejectsEmptyName: an entry with no name is refused.\n121: func TestLoadRegistryRejectsEmptyName(t *testing.T) {\n122: \troot := t.TempDir()\n123: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n124: \twriteRegistry(t, path, namedProjectsJSON([2]string{\"\", root}))\n125: \tif _, err := LoadRegistry(path); err == nil {\n126: \t\tt.Fatal(\"LoadRegistry with an empty name = nil error, want an error\")\n127: \t}\n128: }\n129: \n130: // TestLoadRegistryRejectsNameWithSeparators: a name containing a forward or\n131: // backward slash is refused — a name must be a single URL path segment.\n132: func TestLoadRegistryRejectsNameWithSeparators(t *testing.T) {\n133: \troot := t.TempDir()\n134: \tfor _, bad := range []string{\"solyto/api\", `solyto\\api`} {\n135: \t\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n136: \t\twriteRegistry(t, path, namedProjectsJSON([2]string{bad, root}))\n137: \t\tif _, err := LoadRegistry(path); err == nil {\n138: \t\t\tt.Errorf(\"LoadRegistry with name %q = nil error, want an error\", bad)\n139: \t\t}\n140: \t}\n141: }\n142: \n143: // TestLoadRegistryRejectsDotNames: names \".\" and \"..\" are refused (traversal\n144: // segments, even though they'd otherwise pass the charset check).\n145: func TestLoadRegistryRejectsDotNames(t *testing.T) {\n146: \troot := t.TempDir()\n147: \tfor _, bad := range []string{\".\", \"..\"} {\n148: \t\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n149: \t\twriteRegistry(t, path, namedProjectsJSON([2]string{bad, root}))\n150: \t\tif _, err := LoadRegistry(path); err == nil {\n151: \t\t\tt.Errorf(\"LoadRegistry with name %q = nil error, want an error\", bad)\n152: \t\t}\n153: \t}\n154: }\n155: \n156: // TestLoadRegistryRejectsNonURLSafeName: a name outside the conservative\n157: // [A-Za-z0-9._-] charset is refused.\n158: func TestLoadRegistryRejectsNonURLSafeName(t *testing.T) {\n159: \troot := t.TempDir()\n160: \tfor _, bad := range []string{\"solyto api\", \"solyto@api\", \"solyto:api\", \"sölyto\"} {\n161: \t\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n162: \t\twriteRegistry(t, path, namedProjectsJSON([2]string{bad, root}))\n163: \t\tif _, err := LoadRegistry(path); err == nil {\n164: \t\t\tt.Errorf(\"LoadRegistry with name %q = nil error, want an error\", bad)\n165: \t\t}\n166: \t}\n167: }\n168: \n169: // TestLoadRegistryRejectsDuplicateNames: two entries with the same name are\n170: // refused, regardless of their paths.\n171: func TestLoadRegistryRejectsDuplicateNames(t *testing.T) {\n172: \ta := t.TempDir()\n173: \tb := t.TempDir()\n174: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n175: \twriteRegistry(t, path, namedProjectsJSON([2]string{\"dup\", a}, [2]string{\"dup\", b}))\n176: \tif _, err := LoadRegistry(path); err == nil {\n177: \t\tt.Fatal(\"LoadRegistry with duplicate names = nil error, want an error\")\n178: \t}\n179: }\n180: \n181: // TestLoadRegistryRejectsDuplicatePaths: two entries with different names\n182: // registering the same path are refused — the pinned duplicate-path\n183: // behavior (see LoadRegistry's doc comment).\n184: func TestLoadRegistryRejectsDuplicatePaths(t *testing.T) {\n185: \troot := t.TempDir()\n186: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n187: \twriteRegistry(t, path, namedProjectsJSON([2]string{\"name-a\", root}, [2]string{\"name-b\", root}))\n188: \tif _, err := LoadRegistry(path); err == nil {\n189: \t\tt.Fatal(\"LoadRegistry with duplicate paths = nil error, want an error\")\n190: \t}\n191: }\n192: \n193: // TestRegistryProjectNameOnlyResolution: Project resolves strictly by\n194: // configured name — an entry registered under a name different from its\n195: // directory's base name resolves by the configured name and NOT by the base\n196: // name, and an unknown segment is not-found.\n197: func TestRegistryProjectNameOnlyResolution(t *testing.T) {\n198: \troot := t.TempDir() // base name is whatever t.TempDir() picked\n199: \treg := &Registry{entries: []Entry{{Name: \"custom-name\", Path: filepath.Clean(root)}}}\n200: \n201: \tif root2, ok := reg.Project(\"custom-name\"); !ok || root2 != filepath.Clean(root) {\n202: \t\tt.Errorf(\"Project(configured name) = %q, %v; want %q, true\", root2, ok, filepath.Clean(root))\n203: \t}\n204: \tif _, ok := reg.Project(filepath.Base(root)); ok {\n205: \t\tt.Errorf(\"Project(base name) resolved, want not-found — resolution is by configured name only\")\n206: \t}\n207: \tif _, ok := reg.Project(filepath.Clean(root)); ok {\n208: \t\tt.Errorf(\"Project(exact path) resolved, want not-found — resolution is by configured name only\")\n209: \t}\n210: \tif _, ok := reg.Project(\"no-such-project\"); ok {\n211: \t\tt.Errorf(\"Project(unknown) resolved, want not-found\")\n212: \t}\n213: }\n214: \n215: // TestLoadRegistryAcceptsRootWithoutDocs: a registered root without docs/ is\n216: // accepted (it lists no jobs rather than failing startup), and\n217: // WarnMissingDocs flags it.\n218: func TestLoadRegistryAcceptsRootWithoutDocs(t *testing.T) {\n219: \troot := t.TempDir() // no docs/ inside\n220: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n221: \twriteRegistry(t, path, namedProjectsJSON([2]string{\"docsless\", root}))\n222: \n223: \treg, err := LoadRegistry(path)\n224: \tif err != nil {\n225: \t\tt.Fatalf(\"LoadRegistry with docs-less root: %v\", err)\n226: \t}\n227: \tif len(reg.Projects()) != 1 {\n228: \t\tt.Fatalf(\"Projects() = %v, want the docs-less root registered\", reg.Projects())\n229: \t}\n230: \n231: \tvar warnings strings.Builder\n232: \treg.WarnMissingDocs(&warnings)\n233: \tif !strings.Contains(warnings.String(), \"no docs/ directory\") {\n234: \t\tt.Errorf(\"WarnMissingDocs = %q, want a no-docs warning\", warnings.String())\n235: \t}\n236: \n237: \t// A root WITH docs/ produces no warning.\n238: \twithDocs := t.TempDir()\n239: \tif err := os.MkdirAll(filepath.Join(withDocs, \"docs\"), 0o755); err != nil {\n240: \t\tt.Fatal(err)\n241: \t}\n242: \treg2 := &Registry{entries: []Entry{{Name: \"withdocs\", Path: filepath.Clean(withDocs)}}}\n243: \tvar w2 strings.Builder\n244: \treg2.WarnMissingDocs(&w2)\n245: \tif w2.Len() != 0 {\n246: \t\tt.Errorf(\"WarnMissingDocs for a root with docs/ = %q, want empty\", w2.String())\n247: \t}\n248: }\n249: \n250: // TestDefaultRegistryPathPinsConfigLocation: the default registry path is\n251: // <checkout>/config/serve.json, derived via config.Dir like every other\n252: // checkout data file.\n253: func TestDefaultRegistryPathPinsConfigLocation(t *testing.T) {\n254: \tdir := t.TempDir()\n255: \tif err := os.MkdirAll(filepath.Join(dir, \"scripts\"), 0o755); err != nil {\n256: \t\tt.Fatal(err)\n257: \t}\n258: \tif err := os.WriteFile(filepath.Join(dir, \"scripts\", \"entrypoint.sh\"), []byte(\"#!/bin/sh\\n\"), 0o755); err != nil {\n259: \t\tt.Fatal(err)\n260: \t}\n261: \tt.Setenv(\"MANIGOT_HOME\", dir)\n262: \n263: \twant := filepath.Join(dir, \"config\", RegistryFileName)\n264: \tif got := DefaultRegistryPath(); got != want {\n265: \t\tt.Errorf(\"DefaultRegistryPath() = %q, want %q\", got, want)\n266: \t}\n267: }\n\n(End of file - total 267 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// writeRegistry writes a registry config file at path with the given\n// projects JSON.\nfunc writeRegistry(t *testing.T, path, projectsJSON string) {\n\tt.Helper()\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(path, []byte(projectsJSON), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/registry_test.go","text":"package serve\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// writeRegistry writes a registry config file at path with the given\n// projects JSON.\nfunc writeRegistry(t *testing.T, path, projectsJSON string) {\n\tt.Helper()\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(path, []byte(projectsJSON), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\n// namedProjectsJSON renders a {\"projects\": [{\"name\":..., \"path\":...}, ...]}\n// registry config body from name/path pairs.\nfunc namedProjectsJSON(pairs ...[2]string) string {\n\tvar b strings.Builder\n\tb.WriteString(`{\"projects\": [`)\n\tfor i, p := range pairs {\n\t\tif i > 0 {\n\t\t\tb.WriteString(\", \")\n\t\t}\n\t\tb.WriteString(`{\"name\": \"` + p[0] + `\", \"path\": \"` + p[1] + `\"}`)\n\t}\n\tb.WriteString(`]}`)\n\treturn b.String()\n}\n\n// TestLoadRegistryMissingFileIsEmptyRegistry pins the degrade: a registry\n// config that does not exist yet (a fresh checkout) is an empty registry, not\n// an error — the daemon starts with nothing registered.\nfunc TestLoadRegistryMissingFileIsEmptyRegistry(t *testing.T) {\n\treg, err := LoadRegistry(filepath.Join(t.TempDir(), \"does-not-exist.json\"))\n\tif err != nil {\n\t\tt.Fatalf(\"LoadRegistry on missing file: %v\", err)\n\t}\n\tif got := reg.Projects(); len(got) != 0 {\n\t\tt.Errorf(\"Projects() = %v, want empty registry\", got)\n\t}\n\tif _, ok := reg.Project(\"anything\"); ok {\n\t\tt.Errorf(\"Project on empty registry resolved, want not-found\")\n\t}\n}\n\n// TestLoadRegistryParsesAndValidatesRoots: a valid config of named entries\n// yields the registered roots in order, each cleaned to an absolute path.\nfunc TestLoadRegistryParsesAndValidatesRoots(t *testing.T) {\n\ta := t.TempDir()\n\tb := t.TempDir()\n\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\twriteRegistry(t, path, namedProjectsJSON([2]string{\"proj-a\", a}, [2]string{\"proj-b\", b}))\n\n\treg, err := LoadRegistry(path)\n\tif err != nil {\n\t\tt.Fatalf(\"LoadRegistry: %v\", err)\n\t}\n\tgot := reg.Projects()\n\tif len(got) != 2 {\n\t\tt.Fatalf(\"Projects() = %v, want 2 roots\", got)\n\t}\n\tif got[0] != filepath.Clean(a) || got[1] != filepath.Clean(b) {\n\t\tt.Errorf(\"Projects() = %v, want [%s %s]\", got, a, b)\n\t}\n\n\tentries := reg.Entries()\n\tif len(entries) != 2 || entries[0].Name != \"proj-a\" || entries[1].Name != \"proj-b\" {\n\t\tt.Errorf(\"Entries() = %+v, want proj-a then proj-b\", entries)\n\t}\n}\n\n// TestLoadRegistryRejectsNonDirectoryEntries: an entry that exists but is not\n// a directory (a file), and an entry that does not exist at all, are both\n// errors — a broken registry must never silently serve a subset.\nfunc TestLoadRegistryRejectsNonDirectoryEntries(t *testing.T) {\n\tfile := filepath.Join(t.TempDir(), \"some-file\")\n\tif err := os.WriteFile(file, []byte(\"x\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tmissing := filepath.Join(t.TempDir(), \"does-not-exist\")\n\n\tfor _, bad := range []string{file, missing} {\n\t\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\t\twriteRegistry(t, path, namedProjectsJSON([2]string{\"proj\", bad}))\n\t\tif _, err := LoadRegistry(path); err == nil {\n\t\t\tt.Errorf(\"LoadRegistry with entry %q = nil error, want an error\", bad)\n\t\t}\n\t}\n}\n\n// TestLoadRegistryRejectsUnparseableFile: a present-but-garbage config is an\n// error (distinct from the missing-file empty-registry degrade).\nfunc TestLoadRegistryRejectsUnparseableFile(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\twriteRegistry(t, path, `{not json`)\n\tif _, err := LoadRegistry(path); err == nil {\n\t\tt.Fatal(\"LoadRegistry on garbage = nil error, want an error\")\n\t}\n}\n\n// TestLoadRegistryRejectsFlatStringForm pins the \"no backwards compatibility\"\n// requirement: the old flat-string schema (\"projects\": [\"/path\", ...]) fails\n// to parse under the object schema.\nfunc TestLoadRegistryRejectsFlatStringForm(t *testing.T) {\n\troot := t.TempDir()\n\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\twriteRegistry(t, path, `{\"projects\": [\"`+root+`\"]}`)\n\tif _, err := LoadRegistry(path); err == nil {\n\t\tt.Fatal(\"LoadRegistry on the flat-string form = nil error, want an error\")\n\t}\n}\n\n// TestLoadRegistryRejectsEmptyName: an entry with no name is refused.\nfunc TestLoadRegistryRejectsEmptyName(t *testing.T) {\n\troot := t.TempDir()\n\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\twriteRegistry(t, path, namedProjectsJSON([2]string{\"\", root}))\n\tif _, err := LoadRegistry(path); err == nil {\n\t\tt.Fatal(\"LoadRegistry with an empty name = nil error, want an error\")\n\t}\n}\n\n// TestLoadRegistryRejectsNameWithSeparators: a name containing a forward or\n// backward slash is refused — a name must be a single URL path segment.\nfunc TestLoadRegistryRejectsNameWithSeparators(t *testing.T) {\n\troot := t.TempDir()\n\tfor _, bad := range []string{\"solyto/api\", `solyto\\api`} {\n\t\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\t\twriteRegistry(t, path, namedProjectsJSON([2]string{bad, root}))\n\t\tif _, err := LoadRegistry(path); err == nil {\n\t\t\tt.Errorf(\"LoadRegistry with name %q = nil error, want an error\", bad)\n\t\t}\n\t}\n}\n\n// TestLoadRegistryRejectsDotNames: names \".\" and \"..\" are refused (traversal\n// segments, even though they'd otherwise pass the charset check).\nfunc TestLoadRegistryRejectsDotNames(t *testing.T) {\n\troot := t.TempDir()\n\tfor _, bad := range []string{\".\", \"..\"} {\n\t\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\t\twriteRegistry(t, path, namedProjectsJSON([2]string{bad, root}))\n\t\tif _, err := LoadRegistry(path); err == nil {\n\t\t\tt.Errorf(\"LoadRegistry with name %q = nil error, want an error\", bad)\n\t\t}\n\t}\n}\n\n// TestLoadRegistryRejectsNonURLSafeName: a name outside the conservative\n// [A-Za-z0-9._-] charset is refused.\nfunc TestLoadRegistryRejectsNonURLSafeName(t *testing.T) {\n\troot := t.TempDir()\n\tfor _, bad := range []string{\"solyto api\", \"solyto@api\", \"solyto:api\", \"sölyto\"} {\n\t\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\t\twriteRegistry(t, path, namedProjectsJSON([2]string{bad, root}))\n\t\tif _, err := LoadRegistry(path); err == nil {\n\t\t\tt.Errorf(\"LoadRegistry with name %q = nil error, want an error\", bad)\n\t\t}\n\t}\n}\n\n// TestLoadRegistryRejectsDuplicateNames: two entries with the same name are\n// refused, regardless of their paths.\nfunc TestLoadRegistryRejectsDuplicateNames(t *testing.T) {\n\ta := t.TempDir()\n\tb := t.TempDir()\n\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\twriteRegistry(t, path, namedProjectsJSON([2]string{\"dup\", a}, [2]string{\"dup\", b}))\n\tif _, err := LoadRegistry(path); err == nil {\n\t\tt.Fatal(\"LoadRegistry with duplicate names = nil error, want an error\")\n\t}\n}\n\n// TestLoadRegistryRejectsDuplicatePaths: two entries with different names\n// registering the same path are refused — the pinned duplicate-path\n// behavior (see LoadRegistry's doc comment).\nfunc TestLoadRegistryRejectsDuplicatePaths(t *testing.T) {\n\troot := t.TempDir()\n\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\twriteRegistry(t, path, namedProjectsJSON([2]string{\"name-a\", root}, [2]string{\"name-b\", root}))\n\tif _, err := LoadRegistry(path); err == nil {\n\t\tt.Fatal(\"LoadRegistry with duplicate paths = nil error, want an error\")\n\t}\n}\n\n// TestRegistryProjectNameOnlyResolution: Project resolves strictly by\n// configured name — an entry registered under a name different from its\n// directory's base name resolves by the configured name and NOT by the base\n// name, and an unknown segment is not-found.\nfunc TestRegistryProjectNameOnlyResolution(t *testing.T) {\n\troot := t.TempDir() // base name is whatever t.TempDir() picked\n\treg := &Registry{entries: []Entry{{Name: \"custom-name\", Path: filepath.Clean(root)}}}\n\n\tif root2, ok := reg.Project(\"custom-name\"); !ok || root2 != filepath.Clean(root) {\n\t\tt.Errorf(\"Project(configured name) = %q, %v; want %q, true\", root2, ok, filepath.Clean(root))\n\t}\n\tif _, ok := reg.Project(filepath.Base(root)); ok {\n\t\tt.Errorf(\"Project(base name) resolved, want not-found — resolution is by configured name only\")\n\t}\n\tif _, ok := reg.Project(filepath.Clean(root)); ok {\n\t\tt.Errorf(\"Project(exact path) resolved, want not-found — resolution is by configured name only\")\n\t}\n\tif _, ok := reg.Project(\"no-such-project\"); ok {\n\t\tt.Errorf(\"Project(unknown) resolved, want not-found\")\n\t}\n}\n\n// TestLoadRegistryAcceptsRootWithoutDocs: a registered root without docs/ is\n// accepted (it lists no jobs rather than failing startup), and\n// WarnMissingDocs flags it.\nfunc TestLoadRegistryAcceptsRootWithoutDocs(t *testing.T) {\n\troot := t.TempDir() // no docs/ inside\n\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\twriteRegistry(t, path, namedProjectsJSON([2]string{\"docsless\", root}))\n\n\treg, err := LoadRegistry(path)\n\tif err != nil {\n\t\tt.Fatalf(\"LoadRegistry with docs-less root: %v\", err)\n\t}\n\tif len(reg.Projects()) != 1 {\n\t\tt.Fatalf(\"Projects() = %v, want the docs-less root registered\", reg.Projects())\n\t}\n\n\tvar warnings strings.Builder\n\treg.WarnMissingDocs(&warnings)\n\tif !strings.Contains(warnings.String(), \"no docs/ directory\") {\n\t\tt.Errorf(\"WarnMissingDocs = %q, want a no-docs warning\", warnings.String())\n\t}\n\n\t// A root WITH docs/ produces no warning.\n\twithDocs := t.TempDir()\n\tif err := os.MkdirAll(filepath.Join(withDocs, \"docs\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\treg2 := &Registry{entries: []Entry{{Name: \"withdocs\", Path: filepath.Clean(withDocs)}}}\n\tvar w2 strings.Builder\n\treg2.WarnMissingDocs(&w2)\n\tif w2.Len() != 0 {\n\t\tt.Errorf(\"WarnMissingDocs for a root with docs/ = %q, want empty\", w2.String())\n\t}\n}\n\n// TestDefaultRegistryPathPinsConfigLocation: the default registry path is\n// <checkout>/config/serve.json, derived via config.Dir like every other\n// checkout data file.\nfunc TestDefaultRegistryPathPinsConfigLocation(t *testing.T) {\n\tdir := t.TempDir()\n\tif err := os.MkdirAll(filepath.Join(dir, \"scripts\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(dir, \"scripts\", \"entrypoint.sh\"), []byte(\"#!/bin/sh\\n\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Setenv(\"MANIGOT_HOME\", dir)\n\n\twant := filepath.Join(dir, \"config\", RegistryFileName)\n\tif got := DefaultRegistryPath(); got != want {\n\t\tt.Errorf(\"DefaultRegistryPath() = %q, want %q\", got, want)\n\t}\n}","lineStart":1,"lineEnd":267,"totalLines":267,"truncated":false}},"title":"src/internal/serve/registry_test.go","time":{"start":1787992694263,"end":1787992694308}},"id":"prt_04cab5df0001tT68ELFFiDELyj","sessionID":"ses_fb356b356ffep6vyvmzQINQBoz","messageID":"msg_04caa7759001tCMHt66vaDGeAh"}}
