{"type":"tool_use","timestamp":1787992622614,"sessionID":"ses_fb356b356ffep6vyvmzQINQBoz","part":{"type":"tool","tool":"read","callID":"call_7e847429ee59475385d9d4e0","state":{"status":"completed","input":{"filePath":"/workspace/src/cmd/mg/token.go"},"output":"<path>/workspace/src/cmd/mg/token.go</path>\n<type>file</type>\n<content>\n1: // mg serve-token — generate a fresh secure bearer token for `mg serve` and\n2: // write it into the manigot checkout's .env as MG_SERVE_TOKEN. The daemon\n3: // reads the token once at startup (config.EnvValue: .env first, then the\n4: // process environment), so the new token is picked up on the next start.\n5: // This is the out-of-band token provisioning the listener design calls for —\n6: // the API itself never issues, creates, or returns a token; the operator is\n7: // the only mint, and this command is the ergonomic way to do it.\n8: package main\n9: \n10: import (\n11: \t\"crypto/rand\"\n12: \t\"encoding/hex\"\n13: \t\"fmt\"\n14: \t\"io\"\n15: \n16: \t\"github.com/lmuskalla/manigot/internal/config\"\n17: )\n18: \n19: // serveTokenBytes is the token's entropy: 32 random bytes -> 64 hex chars\n20: // (256 bits), the same ballpark as a strong API key.\n21: const serveTokenBytes = 32\n22: \n23: // runServeToken implements `mg serve-token`.\n24: func runServeToken(args []string, stdout, stderr io.Writer) int {\n25: \tif len(args) > 0 {\n26: \t\tfmt.Fprintf(stderr, \"Unknown argument: %s\\n\", args[0])\n27: \t\treturn 1\n28: \t}\n29: \n30: \tbuf := make([]byte, serveTokenBytes)\n31: \tif _, err := rand.Read(buf); err != nil {\n32: \t\tcliError(stderr, fmt.Errorf(\"generate token: %v\", err))\n33: \t\treturn 1\n34: \t}\n35: \ttoken := hex.EncodeToString(buf)\n36: \n37: \tif err := config.UpsertEnv(\"MG_SERVE_TOKEN\", token); err != nil {\n38: \t\tcliError(stderr, err)\n39: \t\treturn 1\n40: \t}\n41: \n42: \tfmt.Fprintf(stdout, \"Generated a new secure token for mg serve (%d random bytes) and wrote it to %s as MG_SERVE_TOKEN.\\n\", serveTokenBytes, config.EnvFile())\n43: \tfmt.Fprintln(stdout, \"It is read once at daemon startup - start mg serve to pick it up.\")\n44: \tfmt.Fprintln(stdout, \"Clients authenticate with: Authorization: Bearer <token>\")\n45: \treturn 0\n46: }\n\n(End of file - total 46 lines)\n</content>","metadata":{"preview":"// mg serve-token — generate a fresh secure bearer token for `mg serve` and\n// write it into the manigot checkout's .env as MG_SERVE_TOKEN. The daemon\n// reads the token once at startup (config.EnvValue: .env first, then the\n// process environment), so the new token is picked up on the next start.\n// This is the out-of-band token provisioning the listener design calls for —\n// the API itself never issues, creates, or returns a token; the operator is\n// the only mint, and this command is the ergonomic way to do it.\npackage main\n\nimport (\n\t\"crypto/rand\"\n\t\"encoding/hex\"\n\t\"fmt\"\n\t\"io\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n)\n\n// serveTokenBytes is the token's entropy: 32 random bytes -> 64 hex chars\n// (256 bits), the same ballpark as a strong API key.","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/cmd/mg/token.go","text":"// mg serve-token — generate a fresh secure bearer token for `mg serve` and\n// write it into the manigot checkout's .env as MG_SERVE_TOKEN. The daemon\n// reads the token once at startup (config.EnvValue: .env first, then the\n// process environment), so the new token is picked up on the next start.\n// This is the out-of-band token provisioning the listener design calls for —\n// the API itself never issues, creates, or returns a token; the operator is\n// the only mint, and this command is the ergonomic way to do it.\npackage main\n\nimport (\n\t\"crypto/rand\"\n\t\"encoding/hex\"\n\t\"fmt\"\n\t\"io\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n)\n\n// serveTokenBytes is the token's entropy: 32 random bytes -> 64 hex chars\n// (256 bits), the same ballpark as a strong API key.\nconst serveTokenBytes = 32\n\n// runServeToken implements `mg serve-token`.\nfunc runServeToken(args []string, stdout, stderr io.Writer) int {\n\tif len(args) > 0 {\n\t\tfmt.Fprintf(stderr, \"Unknown argument: %s\\n\", args[0])\n\t\treturn 1\n\t}\n\n\tbuf := make([]byte, serveTokenBytes)\n\tif _, err := rand.Read(buf); err != nil {\n\t\tcliError(stderr, fmt.Errorf(\"generate token: %v\", err))\n\t\treturn 1\n\t}\n\ttoken := hex.EncodeToString(buf)\n\n\tif err := config.UpsertEnv(\"MG_SERVE_TOKEN\", token); err != nil {\n\t\tcliError(stderr, err)\n\t\treturn 1\n\t}\n\n\tfmt.Fprintf(stdout, \"Generated a new secure token for mg serve (%d random bytes) and wrote it to %s as MG_SERVE_TOKEN.\\n\", serveTokenBytes, config.EnvFile())\n\tfmt.Fprintln(stdout, \"It is read once at daemon startup - start mg serve to pick it up.\")\n\tfmt.Fprintln(stdout, \"Clients authenticate with: Authorization: Bearer <token>\")\n\treturn 0\n}","lineStart":1,"lineEnd":46,"totalLines":46,"truncated":false}},"title":"src/cmd/mg/token.go","time":{"start":1787992622571,"end":1787992622608}},"id":"prt_04caa45e50011Z0AOhYNFo3epu","sessionID":"ses_fb356b356ffep6vyvmzQINQBoz","messageID":"msg_04ca9f8600017YqTMl6Qdhvm3m"}}
{"type":"tool_use","timestamp":1787992622614,"sessionID":"ses_fb356b356ffep6vyvmzQINQBoz","part":{"type":"tool","tool":"read","callID":"call_74a6a5d3a96b4b1baf9c0cf1","state":{"status":"completed","input":{"filePath":"/workspace/src/cmd/mg/serve_test.go"},"output":"<path>/workspace/src/cmd/mg/serve_test.go</path>\n<type>file</type>\n<content>\n1: package main\n2: \n3: import (\n4: \t\"net\"\n5: \t\"net/http\"\n6: \t\"os\"\n7: \t\"path/filepath\"\n8: \t\"strings\"\n9: \t\"syscall\"\n10: \t\"testing\"\n11: \t\"time\"\n12: )\n13: \n14: // emptyRegistryFile writes an empty registry config ({\"projects\": []}) to a\n15: // temp path and returns it — the --registry flag value for tests that don't\n16: // need any registered projects.\n17: func emptyRegistryFile(t *testing.T) string {\n18: \tt.Helper()\n19: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n20: \tif err := os.WriteFile(path, []byte(`{\"projects\": []}`), 0o644); err != nil {\n21: \t\tt.Fatal(err)\n22: \t}\n23: \treturn path\n24: }\n25: \n26: // startServe launches serveCommand in a goroutine with a pre-bound loopback\n27: // listener (the testable seam) and waits until the server answers /health,\n28: // returning the base URL and the exit-code channel. The caller must drain\n29: // done — typically by sending SIGINT and reading the exit code, or with\n30: // t.Cleanup.\n31: func startServe(t *testing.T, args []string) (base string, done chan int, stdout, stderr *strings.Builder) {\n32: \tt.Helper()\n33: \tln, err := net.Listen(\"tcp\", \"127.0.0.1:0\")\n34: \tif err != nil {\n35: \t\tt.Fatal(err)\n36: \t}\n37: \tbase = \"http://\" + ln.Addr().String()\n38: \tdone = make(chan int, 1)\n39: \tstdout = &strings.Builder{}\n40: \tstderr = &strings.Builder{}\n41: \tgo func() { done <- serveCommand(args, stdout, stderr, ln) }()\n42: \n43: \tdeadline := time.Now().Add(5 * time.Second)\n44: \tfor {\n45: \t\tresp, err := http.Get(base + \"/health\")\n46: \t\tif err == nil {\n47: \t\t\tresp.Body.Close()\n48: \t\t\t// 200 (tokenless) or 401 (token configured) both mean the server\n49: \t\t\t// is up and the middleware chain is live.\n50: \t\t\tif resp.StatusCode == http.StatusOK || resp.StatusCode == http.StatusUnauthorized {\n51: \t\t\t\tbreak\n52: \t\t\t}\n53: \t\t}\n54: \t\tif time.Now().After(deadline) {\n55: \t\t\tt.Fatalf(\"server did not come up in time (last err %v)\", err)\n56: \t\t}\n57: \t\ttime.Sleep(10 * time.Millisecond)\n58: \t}\n59: \treturn base, done, stdout, stderr\n60: }\n61: \n62: // stopServe sends SIGINT (the daemon's shutdown signal) and waits for the\n63: // exit code.\n64: func stopServe(t *testing.T, done chan int) int {\n65: \tt.Helper()\n66: \tif err := syscall.Kill(os.Getpid(), syscall.SIGINT); err != nil {\n67: \t\tt.Fatal(err)\n68: \t}\n69: \tselect {\n70: \tcase code := <-done:\n71: \t\treturn code\n72: \tcase <-time.After(10 * time.Second):\n73: \t\tt.Fatal(\"daemon did not shut down within 10s of SIGINT\")\n74: \t\treturn -1\n75: \t}\n76: }\n77: \n78: // TestServeDefaultBindAndServes: the default flags bind a loopback listener\n79: // and the daemon answers /health; SIGINT shuts it down gracefully with exit\n80: // code 0.\n81: func TestServeDefaultBindAndServes(t *testing.T) {\n82: \tbase, done, stdout, _ := startServe(t, []string{\"--registry\", emptyRegistryFile(t)})\n83: \tdefer func() {\n84: \t\tif code := stopServe(t, done); code != 0 {\n85: \t\t\tt.Errorf(\"exit code after SIGINT = %d, want 0\", code)\n86: \t\t}\n87: \t}()\n88: \n89: \tresp, err := http.Get(base + \"/health\")\n90: \tif err != nil {\n91: \t\tt.Fatalf(\"GET /health: %v\", err)\n92: \t}\n93: \tresp.Body.Close()\n94: \tif resp.StatusCode != http.StatusOK {\n95: \t\tt.Errorf(\"status = %d, want 200 (tokenless default)\", resp.StatusCode)\n96: \t}\n97: \tif !strings.Contains(stdout.String(), \"listening on\") {\n98: \t\tt.Errorf(\"stdout = %q, want the listening announcement\", stdout.String())\n99: \t}\n100: }\n101: \n102: // TestServeTokenFromEnv: with no --token flag, $MG_SERVE_TOKEN (read via\n103: // config.EnvValue, the same path the daemon uses for every credential)\n104: // configures auth — a request without it is a 401, with it a 200.\n105: func TestServeTokenFromEnv(t *testing.T) {\n106: \t// Isolate the checkout so config.EnvValue falls through to the process\n107: \t// environment (no .env in a fresh fake checkout).\n108: \tt.Setenv(\"MANIGOT_HOME\", t.TempDir())\n109: \tt.Setenv(\"MG_SERVE_TOKEN\", \"env-token\")\n110: \tbase, done, _, _ := startServe(t, []string{\"--registry\", emptyRegistryFile(t)})\n111: \tdefer func() {\n112: \t\tif code := stopServe(t, done); code != 0 {\n113: \t\t\tt.Errorf(\"exit code after SIGINT = %d, want 0\", code)\n114: \t\t}\n115: \t}()\n116: \n117: \tresp, err := http.Get(base + \"/health\")\n118: \tif err != nil {\n119: \t\tt.Fatal(err)\n120: \t}\n121: \tresp.Body.Close()\n122: \tif resp.StatusCode != http.StatusUnauthorized {\n123: \t\tt.Errorf(\"no token: status = %d, want 401 (env token must be enforced)\", resp.StatusCode)\n124: \t}\n125: \n126: \treq, err := http.NewRequest(http.MethodGet, base+\"/health\", nil)\n127: \tif err != nil {\n128: \t\tt.Fatal(err)\n129: \t}\n130: \treq.Header.Set(\"Authorization\", \"Bearer env-token\")\n131: \tresp, err = http.DefaultClient.Do(req)\n132: \tif err != nil {\n133: \t\tt.Fatal(err)\n134: \t}\n135: \tresp.Body.Close()\n136: \tif resp.StatusCode != http.StatusOK {\n137: \t\tt.Errorf(\"with env token: status = %d, want 200\", resp.StatusCode)\n138: \t}\n139: }\n140: \n141: // TestServeTokenFlagWinsOverEnv: an explicit --token flag takes precedence\n142: // over $MG_SERVE_TOKEN — the env token must no longer authenticate.\n143: func TestServeTokenFlagWinsOverEnv(t *testing.T) {\n144: \tt.Setenv(\"MANIGOT_HOME\", t.TempDir())\n145: \tt.Setenv(\"MG_SERVE_TOKEN\", \"env-token\")\n146: \tbase, done, _, _ := startServe(t, []string{\"--registry\", emptyRegistryFile(t), \"--token\", \"flag-token\"})\n147: \tdefer func() {\n148: \t\tif code := stopServe(t, done); code != 0 {\n149: \t\t\tt.Errorf(\"exit code after SIGINT = %d, want 0\", code)\n150: \t\t}\n151: \t}()\n152: \n153: \treq, _ := http.NewRequest(http.MethodGet, base+\"/health\", nil)\n154: \treq.Header.Set(\"Authorization\", \"Bearer env-token\")\n155: \tresp, err := http.DefaultClient.Do(req)\n156: \tif err != nil {\n157: \t\tt.Fatal(err)\n158: \t}\n159: \tresp.Body.Close()\n160: \tif resp.StatusCode != http.StatusUnauthorized {\n161: \t\tt.Errorf(\"env token after --token flag: status = %d, want 401 (flag must win)\", resp.StatusCode)\n162: \t}\n163: \n164: \treq2, _ := http.NewRequest(http.MethodGet, base+\"/health\", nil)\n165: \treq2.Header.Set(\"Authorization\", \"Bearer flag-token\")\n166: \tresp2, err := http.DefaultClient.Do(req2)\n167: \tif err != nil {\n168: \t\tt.Fatal(err)\n169: \t}\n170: \tresp2.Body.Close()\n171: \tif resp2.StatusCode != http.StatusOK {\n172: \t\tt.Errorf(\"flag token: status = %d, want 200\", resp2.StatusCode)\n173: \t}\n174: }\n175: \n176: // TestServeRefusesNonLoopbackWithoutToken pins the startup guard wiring: a\n177: // non-loopback bind with no token exits non-zero before ever listening.\n178: func TestServeRefusesNonLoopbackWithoutToken(t *testing.T) {\n179: \tvar stdout, stderr strings.Builder\n180: \tcode := serveCommand([]string{\"--registry\", emptyRegistryFile(t), \"--addr\", \"0.0.0.0\"}, &stdout, &stderr, nil)\n181: \tif code == 0 {\n182: \t\tt.Fatal(\"serveCommand with 0.0.0.0 and no token = exit 0, want refusal\")\n183: \t}\n184: \tif !strings.Contains(stderr.String(), \"refusing to start\") {\n185: \t\tt.Errorf(\"stderr = %q, want the refusal message\", stderr.String())\n186: \t}\n187: }\n188: \n189: // TestServeRefusesUnreadableRegistryPath: a registry path that exists but\n190: // cannot be read as a config file is a clear error and non-zero exit. (A\n191: // MISSING file is deliberately the opposite — an empty registry, not an\n192: // error; see TestServeMissingRegistryIsEmptyRegistry. The registry degrade\n193: // is pinned in internal/serve's registry_test.go.)\n194: func TestServeRefusesUnreadableRegistryPath(t *testing.T) {\n195: \t// A directory is present but unreadable as a file — os.ReadFile fails\n196: \t// with a non-IsNotExist error, which LoadRegistry surfaces.\n197: \tdir := t.TempDir()\n198: \tvar stdout, stderr strings.Builder\n199: \tcode := serveCommand([]string{\"--registry\", dir}, &stdout, &stderr, nil)\n200: \tif code == 0 {\n201: \t\tt.Fatal(\"serveCommand with an unreadable registry = exit 0, want an error\")\n202: \t}\n203: \tif !strings.Contains(stderr.String(), \"registry\") {\n204: \t\tt.Errorf(\"stderr = %q, want a registry error\", stderr.String())\n205: \t}\n206: }\n207: \n208: // TestServeMissingRegistryIsEmptyRegistry pins the missing-file degrade\n209: // end-to-end through serveCommand: a registry config that does not exist yet\n210: // is an empty registry (the daemon starts, serving nothing), not a startup\n211: // error.\n212: func TestServeMissingRegistryIsEmptyRegistry(t *testing.T) {\n213: \tbase, done, stdout, _ := startServe(t, []string{\"--registry\", filepath.Join(t.TempDir(), \"missing.json\")})\n214: \tdefer func() {\n215: \t\tif code := stopServe(t, done); code != 0 {\n216: \t\t\tt.Errorf(\"exit code after SIGINT = %d, want 0\", code)\n217: \t\t}\n218: \t}()\n219: \n220: \tresp, err := http.Get(base + \"/projects\")\n221: \tif err != nil {\n222: \t\tt.Fatal(err)\n223: \t}\n224: \tdefer resp.Body.Close()\n225: \tif resp.StatusCode != http.StatusOK {\n226: \t\tt.Errorf(\"GET /projects with empty registry: status = %d, want 200\", resp.StatusCode)\n227: \t}\n228: \tif !strings.Contains(stdout.String(), \"no projects registered\") {\n229: \t\tt.Errorf(\"stdout = %q, want the no-projects warning\", stdout.String())\n230: \t}\n231: }\n232: \n233: // TestServeRefusesNoRegistryLocation: with no --registry and no resolvable\n234: // checkout (the default registry path cannot be determined), mg serve exits\n235: // with the clear ErrNoRegistryPath error.\n236: func TestServeRefusesNoRegistryLocation(t *testing.T) {\n237: \t// Hide any real checkout from both the env and the executable/cwd\n238: \t// fallbacks.\n239: \tt.Setenv(\"MANIGOT_HOME\", \"\")\n240: \tt.Setenv(\"PATH\", t.TempDir())\n241: \tvar stdout, stderr strings.Builder\n242: \tcode := serveCommand(nil, &stdout, &stderr, nil)\n243: \tif code == 0 {\n244: \t\tt.Fatal(\"serveCommand with no registry location = exit 0, want an error\")\n245: \t}\n246: \tif !strings.Contains(stderr.String(), \"registry\") {\n247: \t\tt.Errorf(\"stderr = %q, want the no-registry-location error\", stderr.String())\n248: \t}\n249: }\n250: \n251: // TestServeUnknownArgument: an unexpected positional argument is a clear\n252: // error.\n253: func TestServeUnknownArgument(t *testing.T) {\n254: \tvar stdout, stderr strings.Builder\n255: \tcode := serveCommand([]string{\"--registry\", emptyRegistryFile(t), \"stray\"}, &stdout, &stderr, nil)\n256: \tif code == 0 {\n257: \t\tt.Fatal(\"serveCommand with a stray argument = exit 0, want an error\")\n258: \t}\n259: \tif !strings.Contains(stderr.String(), \"Unknown argument: stray\") {\n260: \t\tt.Errorf(\"stderr = %q, want the unknown-argument error\", stderr.String())\n261: \t}\n262: }\n263: \n264: // TestServeShutdownClosesListener: after SIGINT and graceful shutdown, the\n265: // listener is closed — a request fails instead of hanging or being served.\n266: func TestServeShutdownClosesListener(t *testing.T) {\n267: \tbase, done, _, _ := startServe(t, []string{\"--registry\", emptyRegistryFile(t)})\n268: \tif code := stopServe(t, done); code != 0 {\n269: \t\tt.Fatalf(\"exit code after SIGINT = %d, want 0\", code)\n270: \t}\n271: \t// The listener is gone — the request must fail (connection refused), not\n272: \t// hang.\n273: \tclient := &http.Client{Timeout: 2 * time.Second}\n274: \tif resp, err := client.Get(base + \"/health\"); err == nil {\n275: \t\tresp.Body.Close()\n276: \t\tt.Error(\"server still answering after shutdown\")\n277: \t}\n278: }\n\n(End of file - total 278 lines)\n</content>","metadata":{"preview":"package main\n\nimport (\n\t\"net\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"syscall\"\n\t\"testing\"\n\t\"time\"\n)\n\n// emptyRegistryFile writes an empty registry config ({\"projects\": []}) to a\n// temp path and returns it — the --registry flag value for tests that don't\n// need any registered projects.\nfunc emptyRegistryFile(t *testing.T) string {\n\tt.Helper()\n\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\tif err := os.WriteFile(path, []byte(`{\"projects\": []}`), 0o644); err != nil {","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/cmd/mg/serve_test.go","text":"package main\n\nimport (\n\t\"net\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"syscall\"\n\t\"testing\"\n\t\"time\"\n)\n\n// emptyRegistryFile writes an empty registry config ({\"projects\": []}) to a\n// temp path and returns it — the --registry flag value for tests that don't\n// need any registered projects.\nfunc emptyRegistryFile(t *testing.T) string {\n\tt.Helper()\n\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\tif err := os.WriteFile(path, []byte(`{\"projects\": []}`), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn path\n}\n\n// startServe launches serveCommand in a goroutine with a pre-bound loopback\n// listener (the testable seam) and waits until the server answers /health,\n// returning the base URL and the exit-code channel. The caller must drain\n// done — typically by sending SIGINT and reading the exit code, or with\n// t.Cleanup.\nfunc startServe(t *testing.T, args []string) (base string, done chan int, stdout, stderr *strings.Builder) {\n\tt.Helper()\n\tln, err := net.Listen(\"tcp\", \"127.0.0.1:0\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tbase = \"http://\" + ln.Addr().String()\n\tdone = make(chan int, 1)\n\tstdout = &strings.Builder{}\n\tstderr = &strings.Builder{}\n\tgo func() { done <- serveCommand(args, stdout, stderr, ln) }()\n\n\tdeadline := time.Now().Add(5 * time.Second)\n\tfor {\n\t\tresp, err := http.Get(base + \"/health\")\n\t\tif err == nil {\n\t\t\tresp.Body.Close()\n\t\t\t// 200 (tokenless) or 401 (token configured) both mean the server\n\t\t\t// is up and the middleware chain is live.\n\t\t\tif resp.StatusCode == http.StatusOK || resp.StatusCode == http.StatusUnauthorized {\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif time.Now().After(deadline) {\n\t\t\tt.Fatalf(\"server did not come up in time (last err %v)\", err)\n\t\t}\n\t\ttime.Sleep(10 * time.Millisecond)\n\t}\n\treturn base, done, stdout, stderr\n}\n\n// stopServe sends SIGINT (the daemon's shutdown signal) and waits for the\n// exit code.\nfunc stopServe(t *testing.T, done chan int) int {\n\tt.Helper()\n\tif err := syscall.Kill(os.Getpid(), syscall.SIGINT); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tselect {\n\tcase code := <-done:\n\t\treturn code\n\tcase <-time.After(10 * time.Second):\n\t\tt.Fatal(\"daemon did not shut down within 10s of SIGINT\")\n\t\treturn -1\n\t}\n}\n\n// TestServeDefaultBindAndServes: the default flags bind a loopback listener\n// and the daemon answers /health; SIGINT shuts it down gracefully with exit\n// code 0.\nfunc TestServeDefaultBindAndServes(t *testing.T) {\n\tbase, done, stdout, _ := startServe(t, []string{\"--registry\", emptyRegistryFile(t)})\n\tdefer func() {\n\t\tif code := stopServe(t, done); code != 0 {\n\t\t\tt.Errorf(\"exit code after SIGINT = %d, want 0\", code)\n\t\t}\n\t}()\n\n\tresp, err := http.Get(base + \"/health\")\n\tif err != nil {\n\t\tt.Fatalf(\"GET /health: %v\", err)\n\t}\n\tresp.Body.Close()\n\tif resp.StatusCode != http.StatusOK {\n\t\tt.Errorf(\"status = %d, want 200 (tokenless default)\", resp.StatusCode)\n\t}\n\tif !strings.Contains(stdout.String(), \"listening on\") {\n\t\tt.Errorf(\"stdout = %q, want the listening announcement\", stdout.String())\n\t}\n}\n\n// TestServeTokenFromEnv: with no --token flag, $MG_SERVE_TOKEN (read via\n// config.EnvValue, the same path the daemon uses for every credential)\n// configures auth — a request without it is a 401, with it a 200.\nfunc TestServeTokenFromEnv(t *testing.T) {\n\t// Isolate the checkout so config.EnvValue falls through to the process\n\t// environment (no .env in a fresh fake checkout).\n\tt.Setenv(\"MANIGOT_HOME\", t.TempDir())\n\tt.Setenv(\"MG_SERVE_TOKEN\", \"env-token\")\n\tbase, done, _, _ := startServe(t, []string{\"--registry\", emptyRegistryFile(t)})\n\tdefer func() {\n\t\tif code := stopServe(t, done); code != 0 {\n\t\t\tt.Errorf(\"exit code after SIGINT = %d, want 0\", code)\n\t\t}\n\t}()\n\n\tresp, err := http.Get(base + \"/health\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tresp.Body.Close()\n\tif resp.StatusCode != http.StatusUnauthorized {\n\t\tt.Errorf(\"no token: status = %d, want 401 (env token must be enforced)\", resp.StatusCode)\n\t}\n\n\treq, err := http.NewRequest(http.MethodGet, base+\"/health\", nil)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treq.Header.Set(\"Authorization\", \"Bearer env-token\")\n\tresp, err = http.DefaultClient.Do(req)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tresp.Body.Close()\n\tif resp.StatusCode != http.StatusOK {\n\t\tt.Errorf(\"with env token: status = %d, want 200\", resp.StatusCode)\n\t}\n}\n\n// TestServeTokenFlagWinsOverEnv: an explicit --token flag takes precedence\n// over $MG_SERVE_TOKEN — the env token must no longer authenticate.\nfunc TestServeTokenFlagWinsOverEnv(t *testing.T) {\n\tt.Setenv(\"MANIGOT_HOME\", t.TempDir())\n\tt.Setenv(\"MG_SERVE_TOKEN\", \"env-token\")\n\tbase, done, _, _ := startServe(t, []string{\"--registry\", emptyRegistryFile(t), \"--token\", \"flag-token\"})\n\tdefer func() {\n\t\tif code := stopServe(t, done); code != 0 {\n\t\t\tt.Errorf(\"exit code after SIGINT = %d, want 0\", code)\n\t\t}\n\t}()\n\n\treq, _ := http.NewRequest(http.MethodGet, base+\"/health\", nil)\n\treq.Header.Set(\"Authorization\", \"Bearer env-token\")\n\tresp, err := http.DefaultClient.Do(req)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tresp.Body.Close()\n\tif resp.StatusCode != http.StatusUnauthorized {\n\t\tt.Errorf(\"env token after --token flag: status = %d, want 401 (flag must win)\", resp.StatusCode)\n\t}\n\n\treq2, _ := http.NewRequest(http.MethodGet, base+\"/health\", nil)\n\treq2.Header.Set(\"Authorization\", \"Bearer flag-token\")\n\tresp2, err := http.DefaultClient.Do(req2)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tresp2.Body.Close()\n\tif resp2.StatusCode != http.StatusOK {\n\t\tt.Errorf(\"flag token: status = %d, want 200\", resp2.StatusCode)\n\t}\n}\n\n// TestServeRefusesNonLoopbackWithoutToken pins the startup guard wiring: a\n// non-loopback bind with no token exits non-zero before ever listening.\nfunc TestServeRefusesNonLoopbackWithoutToken(t *testing.T) {\n\tvar stdout, stderr strings.Builder\n\tcode := serveCommand([]string{\"--registry\", emptyRegistryFile(t), \"--addr\", \"0.0.0.0\"}, &stdout, &stderr, nil)\n\tif code == 0 {\n\t\tt.Fatal(\"serveCommand with 0.0.0.0 and no token = exit 0, want refusal\")\n\t}\n\tif !strings.Contains(stderr.String(), \"refusing to start\") {\n\t\tt.Errorf(\"stderr = %q, want the refusal message\", stderr.String())\n\t}\n}\n\n// TestServeRefusesUnreadableRegistryPath: a registry path that exists but\n// cannot be read as a config file is a clear error and non-zero exit. (A\n// MISSING file is deliberately the opposite — an empty registry, not an\n// error; see TestServeMissingRegistryIsEmptyRegistry. The registry degrade\n// is pinned in internal/serve's registry_test.go.)\nfunc TestServeRefusesUnreadableRegistryPath(t *testing.T) {\n\t// A directory is present but unreadable as a file — os.ReadFile fails\n\t// with a non-IsNotExist error, which LoadRegistry surfaces.\n\tdir := t.TempDir()\n\tvar stdout, stderr strings.Builder\n\tcode := serveCommand([]string{\"--registry\", dir}, &stdout, &stderr, nil)\n\tif code == 0 {\n\t\tt.Fatal(\"serveCommand with an unreadable registry = exit 0, want an error\")\n\t}\n\tif !strings.Contains(stderr.String(), \"registry\") {\n\t\tt.Errorf(\"stderr = %q, want a registry error\", stderr.String())\n\t}\n}\n\n// TestServeMissingRegistryIsEmptyRegistry pins the missing-file degrade\n// end-to-end through serveCommand: a registry config that does not exist yet\n// is an empty registry (the daemon starts, serving nothing), not a startup\n// error.\nfunc TestServeMissingRegistryIsEmptyRegistry(t *testing.T) {\n\tbase, done, stdout, _ := startServe(t, []string{\"--registry\", filepath.Join(t.TempDir(), \"missing.json\")})\n\tdefer func() {\n\t\tif code := stopServe(t, done); code != 0 {\n\t\t\tt.Errorf(\"exit code after SIGINT = %d, want 0\", code)\n\t\t}\n\t}()\n\n\tresp, err := http.Get(base + \"/projects\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer resp.Body.Close()\n\tif resp.StatusCode != http.StatusOK {\n\t\tt.Errorf(\"GET /projects with empty registry: status = %d, want 200\", resp.StatusCode)\n\t}\n\tif !strings.Contains(stdout.String(), \"no projects registered\") {\n\t\tt.Errorf(\"stdout = %q, want the no-projects warning\", stdout.String())\n\t}\n}\n\n// TestServeRefusesNoRegistryLocation: with no --registry and no resolvable\n// checkout (the default registry path cannot be determined), mg serve exits\n// with the clear ErrNoRegistryPath error.\nfunc TestServeRefusesNoRegistryLocation(t *testing.T) {\n\t// Hide any real checkout from both the env and the executable/cwd\n\t// fallbacks.\n\tt.Setenv(\"MANIGOT_HOME\", \"\")\n\tt.Setenv(\"PATH\", t.TempDir())\n\tvar stdout, stderr strings.Builder\n\tcode := serveCommand(nil, &stdout, &stderr, nil)\n\tif code == 0 {\n\t\tt.Fatal(\"serveCommand with no registry location = exit 0, want an error\")\n\t}\n\tif !strings.Contains(stderr.String(), \"registry\") {\n\t\tt.Errorf(\"stderr = %q, want the no-registry-location error\", stderr.String())\n\t}\n}\n\n// TestServeUnknownArgument: an unexpected positional argument is a clear\n// error.\nfunc TestServeUnknownArgument(t *testing.T) {\n\tvar stdout, stderr strings.Builder\n\tcode := serveCommand([]string{\"--registry\", emptyRegistryFile(t), \"stray\"}, &stdout, &stderr, nil)\n\tif code == 0 {\n\t\tt.Fatal(\"serveCommand with a stray argument = exit 0, want an error\")\n\t}\n\tif !strings.Contains(stderr.String(), \"Unknown argument: stray\") {\n\t\tt.Errorf(\"stderr = %q, want the unknown-argument error\", stderr.String())\n\t}\n}\n\n// TestServeShutdownClosesListener: after SIGINT and graceful shutdown, the\n// listener is closed — a request fails instead of hanging or being served.\nfunc TestServeShutdownClosesListener(t *testing.T) {\n\tbase, done, _, _ := startServe(t, []string{\"--registry\", emptyRegistryFile(t)})\n\tif code := stopServe(t, done); code != 0 {\n\t\tt.Fatalf(\"exit code after SIGINT = %d, want 0\", code)\n\t}\n\t// The listener is gone — the request must fail (connection refused), not\n\t// hang.\n\tclient := &http.Client{Timeout: 2 * time.Second}\n\tif resp, err := client.Get(base + \"/health\"); err == nil {\n\t\tresp.Body.Close()\n\t\tt.Error(\"server still answering after shutdown\")\n\t}\n}","lineStart":1,"lineEnd":278,"totalLines":278,"truncated":false}},"title":"src/cmd/mg/serve_test.go","time":{"start":1787992622586,"end":1787992622611}},"id":"prt_04caa45f60017PS5amCmzcyO88","sessionID":"ses_fb356b356ffep6vyvmzQINQBoz","messageID":"msg_04ca9f8600017YqTMl6Qdhvm3m"}}
