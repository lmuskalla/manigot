{"type":"tool_use","timestamp":1787993320562,"sessionID":"ses_fb34d9020ffe9TT7hHKcNCMGib","part":{"type":"tool","tool":"read","callID":"call_d4f5c07497424e47941a5d43","state":{"status":"completed","input":{"filePath":"/workspace/src/cmd/mg/serve.go","limit":110},"output":"<path>/workspace/src/cmd/mg/serve.go</path>\n<type>file</type>\n<content>\n1: // mg serve — the listener: a long-running daemon exposing a control API over a\n2: // registry of project roots, so any surface (a web UI, a native GUI, a future\n3: // CLI) can attach to it as a client — from localhost or from a VPS. This is\n4: // the control-plane sequence described in docs/listener.md: `mg serve` +\n5: // project registry + read-only API + localhost default + audit log +\n6: // serialization skeleton, then the mutating lifecycle endpoints and the live\n7: // session-log SSE stream.\n8: //\n9: // The daemon is additive: the TUI stays in-process, and every existing\n10: // command keeps working untouched. It binds to 127.0.0.1:8080 by default\n11: // (tokenless — the machine's own user is the trust boundary, as it is for the\n12: // CLI today); a non-loopback bind REQUIRES a bearer token (--token or\n13: // $MG_SERVE_TOKEN) or the daemon refuses to start. TLS is the reverse proxy's\n14: // job (Caddy/nginx), never the daemon's.\n15: package main\n16: \n17: import (\n18: \t\"context\"\n19: \t\"errors\"\n20: \t\"flag\"\n21: \t\"fmt\"\n22: \t\"io\"\n23: \t\"net\"\n24: \t\"net/http\"\n25: \t\"os\"\n26: \t\"os/signal\"\n27: \t\"strconv\"\n28: \t\"syscall\"\n29: \t\"time\"\n30: \n31: \t\"github.com/lmuskalla/manigot/internal/config\"\n32: \t\"github.com/lmuskalla/manigot/internal/serve\"\n33: )\n34: \n35: // serveShutdownDrain bounds how long mg serve waits for in-flight requests to\n36: // finish on SIGINT/SIGTERM before giving up — a hung request must never wedge\n37: // the exit.\n38: const serveShutdownDrain = 10 * time.Second\n39: \n40: // runServe implements `mg serve` — the listener daemon. It parses the flags,\n41: // loads the project registry, enforces the bind/auth startup guard, then\n42: // blocks serving until SIGINT/SIGTERM, shutting down gracefully with a\n43: // bounded drain. Returns the process exit code.\n44: func runServe(args []string, stdout, stderr io.Writer) int {\n45: \treturn serveCommand(args, stdout, stderr, nil)\n46: }\n47: \n48: // serveCommand is runServe's testable core: it differs only in the listener\n49: // source. When ln is non-nil it serves on that already-bound listener (tests\n50: // hand over a bound 127.0.0.1:0 listener); when nil it binds one itself from\n51: // the --addr/--port flags. Signal handling and the graceful shutdown path are\n52: // identical in both shapes.\n53: func serveCommand(args []string, stdout, stderr io.Writer, ln net.Listener) int {\n54: \tfs := flag.NewFlagSet(\"mg serve\", flag.ContinueOnError)\n55: \tfs.SetOutput(stderr)\n56: \taddr := fs.String(\"addr\", \"127.0.0.1\", \"bind host (loopback default; a non-loopback bind requires a token)\")\n57: \tport := fs.Int(\"port\", 8080, \"bind port\")\n58: \tregistry := fs.String(\"registry\", \"\", \"path to the project registry config (default <checkout>/config/serve.json)\")\n59: \ttokenFlag := fs.String(\"token\", \"\", \"bearer token required on every request (default $MG_SERVE_TOKEN)\")\n60: \tfs.Usage = func() {\n61: \t\tfmt.Fprintf(stderr, \"mg serve %s\\n\\n\", version)\n62: \t\tfmt.Fprintf(stderr, \"The listener: a long-running daemon exposing a control API\\n\")\n63: \t\tfmt.Fprintf(stderr, \"over a registry of project roots (the basis for the web UI / native GUI\\n\")\n64: \t\tfmt.Fprintf(stderr, \"control-plane sequence).\\n\\n\")\n65: \t\tfmt.Fprintf(stderr, \"Usage:\\n\")\n66: \t\tfmt.Fprintf(stderr, \"  mg serve [flags]\\n\\n\")\n67: \t\tfmt.Fprintf(stderr, \"The registry config file holds the named project roots the daemon serves:\\n\")\n68: \t\tfmt.Fprintf(stderr, \"  {\\\"projects\\\": [{\\\"name\\\": \\\"my-project\\\", \\\"path\\\": \\\"/abs/project/root\\\"}, ...]}\\n\")\n69: \t\tfmt.Fprintf(stderr, \"\\\"name\\\" is the URL segment the project is served under (a single URL-safe\\n\")\n70: \t\tfmt.Fprintf(stderr, \"path segment, unique across the registry); it is required and chosen by you.\\n\")\n71: \t\tfmt.Fprintf(stderr, \"Default location: <manigot checkout>/config/serve.json (override with --registry).\\n\")\n72: \t\tfmt.Fprintf(stderr, \"Manage the registered roots with `mg serve-projects` (or edit the file by\\n\")\n73: \t\tfmt.Fprintf(stderr, \"hand); the daemon reads it once at startup, so restart to pick up changes.\\n\\n\")\n74: \t\tfmt.Fprintf(stderr, \"Flags:\\n\")\n75: \t\tfs.PrintDefaults()\n76: \t}\n77: \tif err := fs.Parse(args); err != nil {\n78: \t\treturn 2 // the flag package already printed the error + usage\n79: \t}\n80: \tif fs.NArg() > 0 {\n81: \t\tfmt.Fprintf(stderr, \"Unknown argument: %s\\n\", fs.Arg(0))\n82: \t\treturn 1\n83: \t}\n84: \n85: \t// Token precedence: --token flag, then $MG_SERVE_TOKEN (config.EnvValue —\n86: \t// the .env file first, then the process environment, exactly like every\n87: \t// other credential the daemon reads). A token is never issued, created, or\n88: \t// returned by the API.\n89: \ttoken := *tokenFlag\n90: \tif token == \"\" {\n91: \t\ttoken = config.EnvValue(\"MG_SERVE_TOKEN\")\n92: \t}\n93: \n94: \t// The project registry: an explicit config file of project roots, read\n95: \t// once at startup. No scanning, no auto-adopting.\n96: \tregistryPath := *registry\n97: \tif registryPath == \"\" {\n98: \t\tregistryPath = serve.DefaultRegistryPath()\n99: \t\tif registryPath == \"\" {\n100: \t\t\tcliError(stderr, serve.ErrNoRegistryPath)\n101: \t\t\treturn 1\n102: \t\t}\n103: \t}\n104: \treg, err := serve.LoadRegistry(registryPath)\n105: \tif err != nil {\n106: \t\tcliError(stderr, err)\n107: \t\treturn 1\n108: \t}\n109: \treg.WarnMissingDocs(stderr)\n110: \n\n(Showing lines 1-110 of 166. Use offset=111 to continue.)\n</content>","metadata":{"preview":"// mg serve — the listener: a long-running daemon exposing a control API over a\n// registry of project roots, so any surface (a web UI, a native GUI, a future\n// CLI) can attach to it as a client — from localhost or from a VPS. This is\n// the control-plane sequence described in docs/listener.md: `mg serve` +\n// project registry + read-only API + localhost default + audit log +\n// serialization skeleton, then the mutating lifecycle endpoints and the live\n// session-log SSE stream.\n//\n// The daemon is additive: the TUI stays in-process, and every existing\n// command keeps working untouched. It binds to 127.0.0.1:8080 by default\n// (tokenless — the machine's own user is the trust boundary, as it is for the\n// CLI today); a non-loopback bind REQUIRES a bearer token (--token or\n// $MG_SERVE_TOKEN) or the daemon refuses to start. TLS is the reverse proxy's\n// job (Caddy/nginx), never the daemon's.\npackage main\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"flag\"","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/src/cmd/mg/serve.go","text":"// mg serve — the listener: a long-running daemon exposing a control API over a\n// registry of project roots, so any surface (a web UI, a native GUI, a future\n// CLI) can attach to it as a client — from localhost or from a VPS. This is\n// the control-plane sequence described in docs/listener.md: `mg serve` +\n// project registry + read-only API + localhost default + audit log +\n// serialization skeleton, then the mutating lifecycle endpoints and the live\n// session-log SSE stream.\n//\n// The daemon is additive: the TUI stays in-process, and every existing\n// command keeps working untouched. It binds to 127.0.0.1:8080 by default\n// (tokenless — the machine's own user is the trust boundary, as it is for the\n// CLI today); a non-loopback bind REQUIRES a bearer token (--token or\n// $MG_SERVE_TOKEN) or the daemon refuses to start. TLS is the reverse proxy's\n// job (Caddy/nginx), never the daemon's.\npackage main\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"net\"\n\t\"net/http\"\n\t\"os\"\n\t\"os/signal\"\n\t\"strconv\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/serve\"\n)\n\n// serveShutdownDrain bounds how long mg serve waits for in-flight requests to\n// finish on SIGINT/SIGTERM before giving up — a hung request must never wedge\n// the exit.\nconst serveShutdownDrain = 10 * time.Second\n\n// runServe implements `mg serve` — the listener daemon. It parses the flags,\n// loads the project registry, enforces the bind/auth startup guard, then\n// blocks serving until SIGINT/SIGTERM, shutting down gracefully with a\n// bounded drain. Returns the process exit code.\nfunc runServe(args []string, stdout, stderr io.Writer) int {\n\treturn serveCommand(args, stdout, stderr, nil)\n}\n\n// serveCommand is runServe's testable core: it differs only in the listener\n// source. When ln is non-nil it serves on that already-bound listener (tests\n// hand over a bound 127.0.0.1:0 listener); when nil it binds one itself from\n// the --addr/--port flags. Signal handling and the graceful shutdown path are\n// identical in both shapes.\nfunc serveCommand(args []string, stdout, stderr io.Writer, ln net.Listener) int {\n\tfs := flag.NewFlagSet(\"mg serve\", flag.ContinueOnError)\n\tfs.SetOutput(stderr)\n\taddr := fs.String(\"addr\", \"127.0.0.1\", \"bind host (loopback default; a non-loopback bind requires a token)\")\n\tport := fs.Int(\"port\", 8080, \"bind port\")\n\tregistry := fs.String(\"registry\", \"\", \"path to the project registry config (default <checkout>/config/serve.json)\")\n\ttokenFlag := fs.String(\"token\", \"\", \"bearer token required on every request (default $MG_SERVE_TOKEN)\")\n\tfs.Usage = func() {\n\t\tfmt.Fprintf(stderr, \"mg serve %s\\n\\n\", version)\n\t\tfmt.Fprintf(stderr, \"The listener: a long-running daemon exposing a control API\\n\")\n\t\tfmt.Fprintf(stderr, \"over a registry of project roots (the basis for the web UI / native GUI\\n\")\n\t\tfmt.Fprintf(stderr, \"control-plane sequence).\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"Usage:\\n\")\n\t\tfmt.Fprintf(stderr, \"  mg serve [flags]\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"The registry config file holds the named project roots the daemon serves:\\n\")\n\t\tfmt.Fprintf(stderr, \"  {\\\"projects\\\": [{\\\"name\\\": \\\"my-project\\\", \\\"path\\\": \\\"/abs/project/root\\\"}, ...]}\\n\")\n\t\tfmt.Fprintf(stderr, \"\\\"name\\\" is the URL segment the project is served under (a single URL-safe\\n\")\n\t\tfmt.Fprintf(stderr, \"path segment, unique across the registry); it is required and chosen by you.\\n\")\n\t\tfmt.Fprintf(stderr, \"Default location: <manigot checkout>/config/serve.json (override with --registry).\\n\")\n\t\tfmt.Fprintf(stderr, \"Manage the registered roots with `mg serve-projects` (or edit the file by\\n\")\n\t\tfmt.Fprintf(stderr, \"hand); the daemon reads it once at startup, so restart to pick up changes.\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"Flags:\\n\")\n\t\tfs.PrintDefaults()\n\t}\n\tif err := fs.Parse(args); err != nil {\n\t\treturn 2 // the flag package already printed the error + usage\n\t}\n\tif fs.NArg() > 0 {\n\t\tfmt.Fprintf(stderr, \"Unknown argument: %s\\n\", fs.Arg(0))\n\t\treturn 1\n\t}\n\n\t// Token precedence: --token flag, then $MG_SERVE_TOKEN (config.EnvValue —\n\t// the .env file first, then the process environment, exactly like every\n\t// other credential the daemon reads). A token is never issued, created, or\n\t// returned by the API.\n\ttoken := *tokenFlag\n\tif token == \"\" {\n\t\ttoken = config.EnvValue(\"MG_SERVE_TOKEN\")\n\t}\n\n\t// The project registry: an explicit config file of project roots, read\n\t// once at startup. No scanning, no auto-adopting.\n\tregistryPath := *registry\n\tif registryPath == \"\" {\n\t\tregistryPath = serve.DefaultRegistryPath()\n\t\tif registryPath == \"\" {\n\t\t\tcliError(stderr, serve.ErrNoRegistryPath)\n\t\t\treturn 1\n\t\t}\n\t}\n\treg, err := serve.LoadRegistry(registryPath)\n\tif err != nil {\n\t\tcliError(stderr, err)\n\t\treturn 1\n\t}\n\treg.WarnMissingDocs(stderr)\n","lineStart":1,"lineEnd":110,"totalLines":166,"truncated":true}},"title":"src/cmd/mg/serve.go","time":{"start":1787993320551,"end":1787993320558}},"id":"prt_04cb4ec62001783wBFXe8dUgjy","sessionID":"ses_fb34d9020ffe9TT7hHKcNCMGib","messageID":"msg_04cb4d309001DX9th60BSdYant"}}
