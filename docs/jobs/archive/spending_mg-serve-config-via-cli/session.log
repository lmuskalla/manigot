n\tcase \"delete\":\n\t\tos.Exit(runDelete(args[1:], os.Stdin, os.Stdout, os.Stderr))\n\tcase \"prune\":\n\t\tos.Exit(runPrune(args[1:], os.Stdout, os.Stderr))\n\tcase \"diff\":\n\t\tos.Exit(runDiff(args[1:], os.Stdout, os.Stderr))\n\tcase \"init\":\n\t\tos.Exit(runInit(args[1:], os.Stdin, os.Stdout, os.Stderr, cli.IsTerminal(os.Stdin)))\n\tcase \"host\", \"wild\":\n\t\tos.Exit(runHost(args[1:], os.Stdin, os.Stdout, os.Stderr))\n\tdefault:\n\t\t// Bare `mg`, or the session flags (--agent/--job/--tool/--profile/\n\t\t// --print with passthrough) — the in-process session launcher.\n\t\tos.Exit(runSession(args, os.Stdin, os.Stdout, os.Stderr))\n\t}\n}\n\nfunc printHelp() {\n\t// Built with concatenation because the text itself contains backticks\n\t// (`` bare `mg` ``), which cannot appear inside a raw string literal.\n\tconst (\n\t\thead = `mg — isolated agent environment per project (Claude Code or OpenCode, sandboxed in Docker)\n\nProfiles bundle an agent CLI with one of your subscriptions. The built-ins are:\n  claude-pro        Claude Code, billed to your Claude Pro/Max subscription\n  zai               OpenCode, billed to your Z.AI Coding Plan\n  opencode-go       OpenCode, billed to the OpenCode Go subscription\n  opencode-zen      OpenCode, billed to OpenCode Zen (DeepSeek V4 Flash)\n  opencode-zen-free OpenCode, billed to OpenCode Zen (DeepSeek V4 Flash Free)\nYou can also define your own profiles (e.g. OpenCode Zen with a different\nmodel) with 'mg profiles add', stored in config/profiles.json.\n\nUsage:\n  mg                              Start a session in the current project\n  mg --profile <name>             ...with the given profile (claude-pro|zai|opencode-go|opencode-zen|opencode-zen-free)\n  mg --agent/-a <name>            Start straight in an agent (e.g. analyst)\n  mg --job/-j <id>                Start with a job's brief.md as the prompt\n  mg --agent <name> --job <id>    Combine the two\n\nCommands:\n  mg profiles [name|add|rm]      List the profiles (and which is the default),\n                                   set the default used by bare `\n\t\tmid = `, or pick\n                                   one via an interactive picker on a TTY\n                                   (type to filter, enter to choose,\n                                   esc/q cancel); add/rm manage your own\n                                   user-defined profiles (config/profiles.json)\n  mg setup [name] [--check]       Configure credentials for your subscriptions,\n                                   interactively, or report status with --check\n  mg theme [name]                 Show or set the global OpenCode theme\n                                   (OPENCODE_THEME), or pick one via an\n                                   interactive picker on a TTY\n  mg agents                       List available agents and pick one to start,\n                                   via an interactive picker on a TTY\n                                   (type to filter, enter to choose;\n                                   thematic alias: mg crew)\n  mg init [--profile <name>]      Bootstrap this project for the job workflow\n  mg job \"<title>\" [--type feature|fix|chore]\n                                   Create a job directory + branch + worktree\n                                   (off main)\n  mg jobs                         List jobs and pick one to start a session\n                                   in, via an interactive picker on a TTY\n                                   (type to filter, enter to choose); the\n                                   session launches in the agent appropriate\n                                   to the job's stage (analyst/developer/\n                                   reviewer)\n  mg done <id>                    Archive a finished job (merge + remove worktree)\n  mg delete <id>                  Permanently delete a job (worktree + branch, no merge)\n  mg prune                        Remove orphaned docker containers left behind\n                                   by abnormal session ends, and report how\n                                   many manigot containers are still running\n  mg diff <id> [--full|--name-only|--tig]\n                                   Show what a job's branch changed, three-dot\n                                   against the base branch (log + diff --stat\n                                   by default; --full for the patch, --name-only\n                                   for filenames, --tig to browse in tig)\n  mg tui                          Terminal UI for browsing jobs and firing agents\n  mg jdi --job/-j <id> [--profile <name>]\n                                   Drive a job's analyst -> developer ->\n                                   reviewer sequence unattended\n                                   (thematic alias: mg made-man)\n  mg host                         Run a session directly on the host — no\n                                   docker container; the CLI runs as-is, so\n                                   the agent can touch the host itself\n                                   (thematic alias: mg wild)\nmg serve                        The listener: a long-running daemon exposing\n                                    a read-only control API over a registry of\n                                    project roots (localhost default, tokenless;\n                                    a non-loopback bind requires a bearer token)\n   mg serve-token                   Generate a fresh secure token for mg serve\n                                    (writes MG_SERVE_TOKEN into manigot's .env)\n\n  mg -h, --help, help             Show this help\n\nA bare `\n\t\ttail = ` works in any project — no setup required. Project context and the\njob workflow (mg job/tui/jdi) additionally need a docs/ directory; see\n'Per-project setup' in the manigot README to add one.\n`\n\t)\n\tfmt.Print(head + \"`mg`\" + mid + \"`mg`\" + tail)\n}","lineStart":1,"lineEnd":158,"totalLines":158,"truncated":false}},"title":"src/cmd/mg/main.go","time":{"start":1787992598000,"end":1787992598020}},"id":"prt_04ca9e5eb001D2S76tJMuyWAH8","sessionID":"ses_fb356b356ffep6vyvmzQINQBoz","messageID":"msg_04ca9c39b001k2GFaharfB3e6w"}}
{"type":"tool_use","timestamp":1787992598034,"sessionID":"ses_fb356b356ffep6vyvmzQINQBoz","part":{"type":"tool","tool":"read","callID":"call_747caa31733b4e208d8d896d","state":{"status":"completed","input":{"filePath":"/workspace/src/cmd/mg/profiles.go"},"output":"<path>/workspace/src/cmd/mg/profiles.go</path>\n<type>file</type>\n<content>\n1: package main\n2: \n3: import (\n4: \t\"bufio\"\n5: \t\"errors\"\n6: \t\"flag\"\n7: \t\"fmt\"\n8: \t\"io\"\n9: \t\"strings\"\n10: \n11: \t\"github.com/lmuskalla/manigot/internal/cli\"\n12: \t\"github.com/lmuskalla/manigot/internal/config\"\n13: \t\"github.com/lmuskalla/manigot/internal/ui\"\n14: )\n15: \n16: const profilesHelp = `mg profiles [name|add|rm]\n17: \n18: Lists manigot's subscription profiles — the built-ins claude-pro, zai,\n19: opencode-go, opencode-zen, opencode-zen-free plus any you've added — showing\n20: which are configured and which is the default used by bare ` + \"`mg`\" + `. With a name,\n21: sets that profile as the default (written as MANIGOT_PROFILE in manigot/.env);\n22: with no name and an interactive terminal, picks the default via an interactive\n23: picker on a TTY (type to filter, enter to choose, esc/q cancel).\n24: sets that profile as the default (written as MANIGOT_PROFILE in manigot/.env);\n25: with no name and an interactive terminal, picks the default via an interactive\n26: picker on a TTY (type to filter, enter to choose, esc/q cancel).\n27: \n28:   mg profiles add [<id>]   interactively create a user-defined profile\n29:                            (e.g. OpenCode Zen with a different model),\n30:                            stored in config/profiles.json\n31:   mg profiles rm <id>      remove a user-defined profile; removing the current\n32:                            default falls back to claude-pro (built-ins cannot\n33:                            be removed)\n34: \n35: The default is shared: the TUI's settings screen reads and writes the same\n36: MANIGOT_PROFILE, so TUI-launched sessions use whatever this command sets, and\n37: vice versa.\n38: `\n39: \n40: // runProfiles implements `mg profiles` — the port of scripts/profiles.sh with\n41: // identical output wording. r is the interactive input (kept for signature\n42: // uniformity with runAgents/runJobs even though the picker reads the terminal\n43: // itself), stdout carries the listing/confirmations, stderr the errors. On a\n44: // TTY the default-profile selection is the injected picker seam (pick) — the\n45: // same one runJobs/runAgents use — so tests never start a real Bubble Tea\n46: // program.\n47: func runProfiles(args []string, r io.Reader, stdout, stderr io.Writer, tty bool, pick pickerRunFunc) int {\n48: \tfs := flag.NewFlagSet(\"mg profiles\", flag.ContinueOnError)\n49: \tfs.SetOutput(io.Discard)\n50: \tfs.Usage = func() { fmt.Fprint(stdout, profilesHelp) }\n51: \tif err := fs.Parse(args); err != nil {\n52: \t\tif errors.Is(err, flag.ErrHelp) {\n53: \t\t\treturn 0 // usage already printed to stdout\n54: \t\t}\n55: \t\t// An unknown flag — the script's parser had no flags at all, so any\n56: \t\t// single argument was a candidate profile name.\n57: \t\tfmt.Fprintln(stderr, flagParseError(err))\n58: \t\tfmt.Fprintln(stderr, \"Usage: mg profiles [name]\")\n59: \t\treturn 1\n60: \t}\n61: \n62: \trest := fs.Args()\n63: \tif len(rest) == 1 && rest[0] == \"help\" {\n64: \t\t// The script's bare-word help alias.\n65: \t\tfmt.Fprint(stdout, profilesHelp)\n66: \t\treturn 0\n67: \t}\n68: \tif len(rest) == 0 {\n69: \t\treturn profilesList(r, stdout, tty, pick)\n70: \t}\n71: \tswitch rest[0] {\n72: \tcase \"add\":\n73: \t\treturn profilesAdd(rest[1:], r, stdout, stderr, tty)\n74: \tcase \"rm\", \"remove\":\n75: \t\treturn profilesRm(rest[1:], stdout, stderr)\n76: \t}\n77: \tif len(rest) > 1 {\n78: \t\tfmt.Fprintln(stderr, \"Error: too many arguments.\")\n79: \t\tfmt.Fprintln(stderr, \"Usage: mg profiles [name|add|rm]\")\n80: \t\treturn 1\n81: \t}\n82: \treturn profilesSet(rest[0], stdout, stderr)\n83: }\n84: \n85: // profilesAdd implements `mg profiles add [<id>]` — the interactive\n86: // user-defined-profile creation wizard. On a TTY it walks the fields of a\n87: // profile (tool, credential key(s), model env/default for opencode) with the\n88: // built-ins' values offered as defaults, then persists the profile to\n89: // config/profiles.json via config.AddProfile. Off a TTY it refuses — profile\n90: // creation is inherently interactive, matching `mg setup`'s stance.\n91: func profilesAdd(args []string, r io.Reader, stdout, stderr io.Writer, tty bool) int {\n92: \tif !tty {\n93: \t\tfmt.Fprintln(stderr, \"mg profiles add: interactive profile creation needs a terminal.\")\n94: \t\tfmt.Fprintln(stderr, \"Define the profile in config/profiles.json instead, or run inside a terminal.\")\n95: \t\treturn 1\n96: \t}\n97: \tif len(args) > 1 {\n98: \t\tfmt.Fprintln(stderr, \"Error: mg profiles add takes at most a single profile id.\")\n99: \t\treturn 1\n100: \t}\n101: \n102: \t// One buffered reader for the whole wizard — a fresh bufio.Reader per\n103: \t// prompt would lose whatever the previous one buffered past its newline.\n104: \tbr := bufio.NewReader(r)\n105: \n106: \tid := \"\"\n107: \tif len(args) == 1 {\n108: \t\tid = args[0]\n109: \t}\n110: \tif strings.TrimSpace(id) == \"\" {\n111: \t\tv, err := promptLine(\"  Profile id: \", br, stdout)\n112: \t\tif err != nil {\n113: \t\t\tfmt.Fprintf(stderr, \"mg profiles add: %v\\n\", err)\n114: \t\t\treturn 1\n115: \t\t}\n116: \t\tid = v\n117: \t}\n118: \tif strings.TrimSpace(id) == \"\" {\n119: \t\tfmt.Fprintln(stderr, \"Error: a profile id is required.\")\n120: \t\treturn 1\n121: \t}\n122: \tif _, ok := config.ProfileByID(id); ok {\n123: \t\tfmt.Fprintf(stderr, \"Error: a profile with id %q already exists.\\n\", id)\n124: \t\treturn 1\n125: \t}\n126: \n127: \ttool, _ := cli.PromptValue(\"Tool (claude-code|opencode)\", \"\", config.ToolOpenCode, br, stdout)\n128: \tif tool != config.ToolClaudeCode && tool != config.ToolOpenCode {\n129: \t\tfmt.Fprintf(stderr, \"Error: tool must be 'claude-code' or 'opencode' (got '%s').\\n\", tool)\n130: \t\treturn 1\n131: \t}\n132: \tlabel, _ := cli.PromptValue(\"Label\", \"\", id, br, stdout)\n133: \tif label == \"\" {\n134: \t\tlabel = id\n135: \t}\n136: \n137: \tdefKey := \"OPENCODE_API_KEY\"\n138: \tif tool == config.ToolClaudeCode {\n139: \t\tdefKey = \"CLAUDE_CODE_OAUTH_TOKEN\"\n140: \t}\n141: \tauthKeysRaw, _ := cli.PromptValue(\"Credential key(s), comma-separated\", \"\", defKey, br, stdout)\n142: \tvar authKeys []string\n143: \tfor _, k := range strings.Split(authKeysRaw, \",\") {\n144: \t\tif k = strings.TrimSpace(k); k != \"\" {\n145: \t\t\tauthKeys = append(authKeys, k)\n146: \t\t}\n147: \t}\n148: \tif len(authKeys) == 0 {\n149: \t\tfmt.Fprintln(stderr, \"Error: at least one credential key is required.\")\n150: \t\treturn 1\n151: \t}\n152: \tbilled, _ := cli.PromptValue(\"Billed via (description)\", \"\", authKeys[0], br, stdout)\n153: \tif billed == \"\" {\n154: \t\tbilled = authKeys[0]\n155: \t}\n156: \n157: \tp := config.Profile{\n158: \t\tID:       id,\n159: \t\tLabel:    label,\n160: \t\tTool:     tool,\n161: \t\tAuth:     billed,\n162: \t\tAuthKeys: authKeys,\n163: \t}\n164: \tif tool == config.ToolOpenCode {\n165: \t\tmodelEnv, _ := cli.PromptValue(\"Model .env key\", \"\", \"OPENCODE_MODEL\", br, stdout)\n166: \t\tmodelDefault, _ := cli.PromptValue(\"Default model\", \"\", \"\", br, stdout)\n167: \t\tif strings.TrimSpace(modelDefault) == \"\" {\n168: \t\t\tfmt.Fprintln(stderr, \"Error: an opencode profile needs a default model.\")\n169: \t\t\treturn 1\n170: \t\t}\n171: \t\tp.ModelEnv = modelEnv\n172: \t\tp.ModelDefault = modelDefault\n173: \t}\n174: \n175: \tif err := config.AddProfile(p); err != nil {\n176: \t\tfmt.Fprintf(stderr, \"mg profiles add: %v\\n\", err)\n177: \t\treturn 1\n178: \t}\n179: \tfmt.Fprintf(stdout, \"Added profile '%s' (%s).\\n\", p.ID, p.Label)\n180: \tfmt.Fprintf(stdout, \"Configure its credentials with: mg setup %s\\n\", p.ID)\n181: \tfmt.Fprintf(stdout, \"Make it the default with: mg profiles %s\\n\", p.ID)\n182: \treturn 0\n183: }\n184: \n185: // profilesRm implements `mg profiles rm <id>` — removes a user-defined\n186: // profile from config/profiles.json. Built-in profiles are not deletable\n187: // (they are the defaults every user starts from), so rm only ever touches the\n188: // user store. Removing the currently-set MANIGOT_PROFILE default falls back\n189: // to claude-pro so bare `mg` keeps a valid default.\n190: func profilesRm(args []string, stdout, stderr io.Writer) int {\n191: \tif len(args) != 1 {\n192: \t\tfmt.Fprintln(stderr, \"Usage: mg profiles rm <id>\")\n193: \t\treturn 1\n194: \t}\n195: \tid := args[0]\n196: \tif _, ok := config.ProfileByID(id); !ok {\n197: \t\tfmt.Fprintf(stderr, \"Error: unknown profile '%s'.\\n\", id)\n198: \t\treturn 1\n199: \t}\n200: \tif err := config.RemoveProfile(id); err != nil {\n201: \t\t// Covers the built-in profiles (not present in the user store) and\n202: \t\t// any corrupt-store/unresolvable-home write failure.\n203: \t\tfmt.Fprintf(stderr, \"mg profiles rm: %v\\n\", err)\n204: \t\treturn 1\n205: \t}\n206: \tif config.EnvValue(\"MANIGOT_PROFILE\") == id {\n207: \t\tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", config.ProfileClaudePro); err != nil {\n208: \t\t\tfmt.Fprintf(stderr, \"mg profiles rm: %v\\n\", err)\n209: \t\t\treturn 1\n210: \t\t}\n211: \t\tfmt.Fprintf(stdout, \"Removed profile '%s'. The default fell back to %s.\\n\", id, config.ProfileClaudePro)\n212: \t\treturn 0\n213: \t}\n214: \tfmt.Fprintf(stdout, \"Removed profile '%s'.\\n\", id)\n215: \treturn 0\n216: }\n217: \n218: // promptLine prints label and reads one trimmed line from br (no default\n219: // shown) — for the add wizard's required, default-less fields like the profile\n220: // id. On EOF it returns whatever was read, like cli's readLine.\n221: func promptLine(label string, br *bufio.Reader, w io.Writer) (string, error) {\n222: \tfmt.Fprint(w, label)\n223: \tline, err := br.ReadString('\\n')\n224: \tif err != nil && !errors.Is(err, io.EOF) {\n225: \t\treturn \"\", err\n226: \t}\n227: \treturn strings.TrimSpace(line), nil\n228: }\n229: \n230: // profilesSet writes MANIGOT_PROFILE=<name> into .env and prints the same\n231: // confirmation + missing-credentials warning profiles.sh's confirm_set did.\n232: func profilesSet(name string, stdout, stderr io.Writer) int {\n233: \tif _, ok := config.ProfileByID(name); !ok {\n234: \t\tfmt.Fprintf(stderr, \"Error: unknown profile '%s'.\\n\", name)\n235: \t\tfmt.Fprintf(stderr, \"Valid profiles: %s\\n\", strings.Join(profileIDs(), \" \"))\n236: \t\treturn 1\n237: \t}\n238: \tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", name); err != nil {\n239: \t\tfmt.Fprintf(stderr, \"mg profiles: %v\\n\", err)\n240: \t\treturn 1\n241: \t}\n242: \tconfirmSet(name, stdout)\n243: \treturn 0\n244: }\n245: \n246: // confirmSet prints the shared set confirmation, warning when the profile's\n247: // auth key is not in .env yet.\n248: func confirmSet(name string, w io.Writer) {\n249: \tenvFile := config.EnvFile()\n250: \tfmt.Fprintf(w, \"Default profile set to %s (MANIGOT_PROFILE in %s).\\n\", name, envFile)\n251: \tfmt.Fprintln(w, \"Bare `mg` sessions and TUI-launched sessions share this default.\")\n252: \n253: \tif p, ok := config.ProfileByID(name); ok && len(p.AuthKeys) > 0 {\n254: \t\tif key := p.AuthKeys[0]; config.EnvValue(key) == \"\" {\n255: \t\t\tfmt.Fprintf(w, \"Warning: %s is not set in %s — run 'mg setup %s' first, or sessions will fail at launch.\\n\", key, envFile, name)\n256: \t\t}\n257: \t}\n258: }\n259: \n260: // profilesList prints the profile table, then offers the interactive picker\n261: // on a TTY — same listing, and the picker rows carry the same padded columns\n262: // (byte-padded by padBytes, matching bash printf's byte-based padding: the\n263: // label column contains a multi-byte ·, so rune-based fmt padding would\n264: // misalign every row by one). The picker replaces the old numbered\n265: // `[1-N, Enter keeps X, q quits]` loop; the cursor opens on the active\n266: // default so a bare enter keeps it. Off a TTY the listing alone is the whole\n267: // command (exit 0 — listing is `mg profiles`' documented purpose, unlike\n268: // jobs/agents which refuse because selection is their only purpose).\n269: func profilesList(r io.Reader, w io.Writer, tty bool, pick pickerRunFunc) int {\n270: \tactive := config.EnvValue(\"MANIGOT_PROFILE\")\n271: \tif active == \"\" {\n272: \t\tactive = config.ProfileClaudePro\n273: \t}\n274: \tfmt.Fprintf(w, \"Active default: %s   (shared with the TUI; switch with: mg profiles <name>, or pick one below)\\n\", active)\n275: \tfmt.Fprintln(w, \"\")\n276: \tfmt.Fprintf(w, \"  %-13s %-28s %-10s %-26s %s\\n\", \"profile\", \"label\", \"tool\", \"model\", \"creds\")\n277: \tfmt.Fprintf(w, \"  %-13s %-28s %-10s %-26s %s\\n\", \"---------\", \"----------------------------\", \"----------\", \"--------------------------\", \"-----\")\n278: \tfor _, p := range config.Profiles() {\n279: \t\tmark := \" \"\n280: \t\tif p.ID == active {\n281: \t\t\tmark = \"*\"\n282: \t\t}\n283: \t\trow := \"  \" + mark + padBytes(p.ID, 12) + \" \" + padBytes(p.Label, 28) + \" \" +\n284: \t\t\tpadBytes(p.Tool, 10) + \" \" + padBytes(profileModel(p.ID), 26) + \" \" + creds(p.ID)\n285: \t\tfmt.Fprintln(w, row)\n286: \t}\n287: \tfmt.Fprintln(w, \"\")\n288: \tfmt.Fprintln(w, \"  * = default. Configure credentials with: mg setup [name]\")\n289: \n290: \tif !tty {\n291: \t\treturn 0\n292: \t}\n293: \n294: \tprofiles := config.Profiles()\n295: \trows := make([]ui.PickerRow, 0, len(profiles))\n296: \tstart := 0\n297: \tfor i, p := range profiles {\n298: \t\tif p.ID == active {\n299: \t\t\tstart = i\n300: \t\t}\n301: \t\tmodel := profileModel(p.ID)\n302: \t\tcred := creds(p.ID)\n303: \t\tmark := \" \"\n304: \t\tif p.ID == active {\n305: \t\t\tmark = \"*\"\n306: \t\t}\n307: \t\trows = append(rows, ui.PickerRow{\n308: \t\t\tID:        p.ID,\n309: \t\t\tSearchKey: p.ID + \" \" + p.Label + \" \" + p.Tool + \" \" + model + \" \" + cred,\n310: \t\t\t// The same padded columns as the plain listing (minus the leading\n311: \t\t\t// indent, which the picker's own cursor/blank prefix provides),\n312: \t\t\t// keeping the * active mark.\n313: \t\t\tLabel: mark + padBytes(p.ID, 12) + \" \" + padBytes(p.Label, 28) + \" \" +\n314: \t\t\t\tpadBytes(p.Tool, 10) + \" \" + padBytes(model, 26) + \" \" + cred,\n315: \t\t})\n316: \t}\n317: \n318: \tchosen, ok, err := pick(\"Select the default profile\", rows, start)\n319: \tif err != nil {\n320: \t\tfmt.Fprintf(w, \"mg profiles: %v\\n\", err)\n321: \t\treturn 1\n322: \t}\n323: \tif !ok {\n324: \t\t// Cancelled (esc/q) — a quiet exit 0, not the old \"quit\" error.\n325: \t\treturn 0\n326: \t}\n327: \tif chosen == active {\n328: \t\tfmt.Fprintf(w, \"Keeping %s.\\n\", active)\n329: \t\treturn 0\n330: \t}\n331: \tfmt.Fprintln(w, \"\")\n332: \tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", chosen); err != nil {\n333: \t\tfmt.Fprintf(w, \"mg profiles: %v\\n\", err)\n334: \t\treturn 1\n335: \t}\n336: \tconfirmSet(chosen, w)\n337: \treturn 0\n338: }\n339: \n340: // profileModel returns the model column for a profile: the effective .env /\n341: // environment override when set, else the compiled-in default. Both come from\n342: // the profile's definition (config.ProfileByID), so a user-defined profile\n343: // renders its own model env/default.\n344: func profileModel(id string) string {\n345: \tp, ok := config.ProfileByID(id)\n346: \tif !ok {\n347: \t\treturn \"\"\n348: \t}\n349: \tif p.ModelEnv != \"\" {\n350: \t\tif v := config.EnvValue(p.ModelEnv); v != \"\" {\n351: \t\t\treturn v\n352: \t\t}\n353: \t}\n354: \treturn p.ModelDefault\n355: }\n356: \n357: // creds returns the creds column for a profile: \"✓ ready\" when every required\n358: // key is set, else \"✗ missing <first missing key>\". The required keys are the\n359: // profile's AuthKeys. Checks the effective value (process env + .env),\n360: // matching the scripts' sourced-env ${!KEY:-} reads.\n361: func creds(id string) string {\n362: \tp, ok := config.ProfileByID(id)\n363: \tif !ok {\n364: \t\t// An unknown id has no keys, so the old loop ran zero times and\n365: \t\t// reported \"ready\" — preserved for identical output.\n366: \t\treturn \"✓ ready\"\n367: \t}\n368: \tfor _, k := range p.AuthKeys {\n369: \t\tif config.EnvValue(k) == \"\" {\n370: \t\t\treturn \"✗ missing \" + k\n371: \t\t}\n372: \t}\n373: \treturn \"✓ ready\"\n374: }\n375: \n376: // profileIDs returns the ordered profile ids for error messages.\n377: func profileIDs() []string {\n378: \tps := config.Profiles()\n379: \tids := make([]string, len(ps))\n380: \tfor i, p := range ps {\n381: \t\tids[i] = p.ID\n382: \t}\n383: \treturn ids\n384: }\n385: \n386: // padBytes returns s padded with trailing spaces to the given byte width —\n387: // bash printf pads %s by byte length, and the profile table's label column\n388: // contains a multi-byte ·, so fmt's rune-based width would misalign.\n389: func padBytes(s string, width int) string {\n390: \tif n := len(s); n >= width {\n391: \t\treturn s\n392: \t}\n393: \treturn s + strings.Repeat(\" \", width-len(s))\n394: }\n\n(End of file - total 394 lines)\n</content>","metadata":{"preview":"package main\n\nimport (\n\t\"bufio\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/cli\"\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/ui\"\n)\n\nconst profilesHelp = `mg profiles [name|add|rm]\n\nLists manigot's subscription profiles — the built-ins claude-pro, zai,\nopencode-go, opencode-zen, opencode-zen-free plus any you've added — showing\nwhich are configured and which is the default used by bare ` + \"`mg`\" + `. With a name,","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/cmd/mg/profiles.go","text":"package main\n\nimport (\n\t\"bufio\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/cli\"\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/ui\"\n)\n\nconst profilesHelp = `mg profiles [name|add|rm]\n\nLists manigot's subscription profiles — the built-ins claude-pro, zai,\nopencode-go, opencode-zen, opencode-zen-free plus any you've added — showing\nwhich are configured and which is the default used by bare ` + \"`mg`\" + `. With a name,\nsets that profile as the default (written as MANIGOT_PROFILE in manigot/.env);\nwith no name and an interactive terminal, picks the default via an interactive\npicker on a TTY (type to filter, enter to choose, esc/q cancel).\nsets that profile as the default (written as MANIGOT_PROFILE in manigot/.env);\nwith no name and an interactive terminal, picks the default via an interactive\npicker on a TTY (type to filter, enter to choose, esc/q cancel).\n\n  mg profiles add [<id>]   interactively create a user-defined profile\n                           (e.g. OpenCode Zen with a different model),\n                           stored in config/profiles.json\n  mg profiles rm <id>      remove a user-defined profile; removing the current\n                           default falls back to claude-pro (built-ins cannot\n                           be removed)\n\nThe default is shared: the TUI's settings screen reads and writes the same\nMANIGOT_PROFILE, so TUI-launched sessions use whatever this command sets, and\nvice versa.\n`\n\n// runProfiles implements `mg profiles` — the port of scripts/profiles.sh with\n// identical output wording. r is the interactive input (kept for signature\n// uniformity with runAgents/runJobs even though the picker reads the terminal\n// itself), stdout carries the listing/confirmations, stderr the errors. On a\n// TTY the default-profile selection is the injected picker seam (pick) — the\n// same one runJobs/runAgents use — so tests never start a real Bubble Tea\n// program.\nfunc runProfiles(args []string, r io.Reader, stdout, stderr io.Writer, tty bool, pick pickerRunFunc) int {\n\tfs := flag.NewFlagSet(\"mg profiles\", flag.ContinueOnError)\n\tfs.SetOutput(io.Discard)\n\tfs.Usage = func() { fmt.Fprint(stdout, profilesHelp) }\n\tif err := fs.Parse(args); err != nil {\n\t\tif errors.Is(err, flag.ErrHelp) {\n\t\t\treturn 0 // usage already printed to stdout\n\t\t}\n\t\t// An unknown flag — the script's parser had no flags at all, so any\n\t\t// single argument was a candidate profile name.\n\t\tfmt.Fprintln(stderr, flagParseError(err))\n\t\tfmt.Fprintln(stderr, \"Usage: mg profiles [name]\")\n\t\treturn 1\n\t}\n\n\trest := fs.Args()\n\tif len(rest) == 1 && rest[0] == \"help\" {\n\t\t// The script's bare-word help alias.\n\t\tfmt.Fprint(stdout, profilesHelp)\n\t\treturn 0\n\t}\n\tif len(rest) == 0 {\n\t\treturn profilesList(r, stdout, tty, pick)\n\t}\n\tswitch rest[0] {\n\tcase \"add\":\n\t\treturn profilesAdd(rest[1:], r, stdout, stderr, tty)\n\tcase \"rm\", \"remove\":\n\t\treturn profilesRm(rest[1:], stdout, stderr)\n\t}\n\tif len(rest) > 1 {\n\t\tfmt.Fprintln(stderr, \"Error: too many arguments.\")\n\t\tfmt.Fprintln(stderr, \"Usage: mg profiles [name|add|rm]\")\n\t\treturn 1\n\t}\n\treturn profilesSet(rest[0], stdout, stderr)\n}\n\n// profilesAdd implements `mg profiles add [<id>]` — the interactive\n// user-defined-profile creation wizard. On a TTY it walks the fields of a\n// profile (tool, credential key(s), model env/default for opencode) with the\n// built-ins' values offered as defaults, then persists the profile to\n// config/profiles.json via config.AddProfile. Off a TTY it refuses — profile\n// creation is inherently interactive, matching `mg setup`'s stance.\nfunc profilesAdd(args []string, r io.Reader, stdout, stderr io.Writer, tty bool) int {\n\tif !tty {\n\t\tfmt.Fprintln(stderr, \"mg profiles add: interactive profile creation needs a terminal.\")\n\t\tfmt.Fprintln(stderr, \"Define the profile in config/profiles.json instead, or run inside a terminal.\")\n\t\treturn 1\n\t}\n\tif len(args) > 1 {\n\t\tfmt.Fprintln(stderr, \"Error: mg profiles add takes at most a single profile id.\")\n\t\treturn 1\n\t}\n\n\t// One buffered reader for the whole wizard — a fresh bufio.Reader per\n\t// prompt would lose whatever the previous one buffered past its newline.\n\tbr := bufio.NewReader(r)\n\n\tid := \"\"\n\tif len(args) == 1 {\n\t\tid = args[0]\n\t}\n\tif strings.TrimSpace(id) == \"\" {\n\t\tv, err := promptLine(\"  Profile id: \", br, stdout)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"mg profiles add: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tid = v\n\t}\n\tif strings.TrimSpace(id) == \"\" {\n\t\tfmt.Fprintln(stderr, \"Error: a profile id is required.\")\n\t\treturn 1\n\t}\n\tif _, ok := config.ProfileByID(id); ok {\n\t\tfmt.Fprintf(stderr, \"Error: a profile with id %q already exists.\\n\", id)\n\t\treturn 1\n\t}\n\n\ttool, _ := cli.PromptValue(\"Tool (claude-code|opencode)\", \"\", config.ToolOpenCode, br, stdout)\n\tif tool != config.ToolClaudeCode && tool != config.ToolOpenCode {\n\t\tfmt.Fprintf(stderr, \"Error: tool must be 'claude-code' or 'opencode' (got '%s').\\n\", tool)\n\t\treturn 1\n\t}\n\tlabel, _ := cli.PromptValue(\"Label\", \"\", id, br, stdout)\n\tif label == \"\" {\n\t\tlabel = id\n\t}\n\n\tdefKey := \"OPENCODE_API_KEY\"\n\tif tool == config.ToolClaudeCode {\n\t\tdefKey = \"CLAUDE_CODE_OAUTH_TOKEN\"\n\t}\n\tauthKeysRaw, _ := cli.PromptValue(\"Credential key(s), comma-separated\", \"\", defKey, br, stdout)\n\tvar authKeys []string\n\tfor _, k := range strings.Split(authKeysRaw, \",\") {\n\t\tif k = strings.TrimSpace(k); k != \"\" {\n\t\t\tauthKeys = append(authKeys, k)\n\t\t}\n\t}\n\tif len(authKeys) == 0 {\n\t\tfmt.Fprintln(stderr, \"Error: at least one credential key is required.\")\n\t\treturn 1\n\t}\n\tbilled, _ := cli.PromptValue(\"Billed via (description)\", \"\", authKeys[0], br, stdout)\n\tif billed == \"\" {\n\t\tbilled = authKeys[0]\n\t}\n\n\tp := config.Profile{\n\t\tID:       id,\n\t\tLabel:    label,\n\t\tTool:     tool,\n\t\tAuth:     billed,\n\t\tAuthKeys: authKeys,\n\t}\n\tif tool == config.ToolOpenCode {\n\t\tmodelEnv, _ := cli.PromptValue(\"Model .env key\", \"\", \"OPENCODE_MODEL\", br, stdout)\n\t\tmodelDefault, _ := cli.PromptValue(\"Default model\", \"\", \"\", br, stdout)\n\t\tif strings.TrimSpace(modelDefault) == \"\" {\n\t\t\tfmt.Fprintln(stderr, \"Error: an opencode profile needs a default model.\")\n\t\t\treturn 1\n\t\t}\n\t\tp.ModelEnv = modelEnv\n\t\tp.ModelDefault = modelDefault\n\t}\n\n\tif err := config.AddProfile(p); err != nil {\n\t\tfmt.Fprintf(stderr, \"mg profiles add: %v\\n\", err)\n\t\treturn 1\n\t}\n\tfmt.Fprintf(stdout, \"Added profile '%s' (%s).\\n\", p.ID, p.Label)\n\tfmt.Fprintf(stdout, \"Configure its credentials with: mg setup %s\\n\", p.ID)\n\tfmt.Fprintf(stdout, \"Make it the default with: mg profiles %s\\n\", p.ID)\n\treturn 0\n}\n\n// profilesRm implements `mg profiles rm <id>` — removes a user-defined\n// profile from config/profiles.json. Built-in profiles are not deletable\n// (they are the defaults every user starts from), so rm only ever touches the\n// user store. Removing the currently-set MANIGOT_PROFILE default falls back\n// to claude-pro so bare `mg` keeps a valid default.\nfunc profilesRm(args []string, stdout, stderr io.Writer) int {\n\tif len(args) != 1 {\n\t\tfmt.Fprintln(stderr, \"Usage: mg profiles rm <id>\")\n\t\treturn 1\n\t}\n\tid := args[0]\n\tif _, ok := config.ProfileByID(id); !ok {\n\t\tfmt.Fprintf(stderr, \"Error: unknown profile '%s'.\\n\", id)\n\t\treturn 1\n\t}\n\tif err := config.RemoveProfile(id); err != nil {\n\t\t// Covers the built-in profiles (not present in the user store) and\n\t\t// any corrupt-store/unresolvable-home write failure.\n\t\tfmt.Fprintf(stderr, \"mg profiles rm: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif config.EnvValue(\"MANIGOT_PROFILE\") == id {\n\t\tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", config.ProfileClaudePro); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"mg profiles rm: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintf(stdout, \"Removed profile '%s'. The default fell back to %s.\\n\", id, config.ProfileClaudePro)\n\t\treturn 0\n\t}\n\tfmt.Fprintf(stdout, \"Removed profile '%s'.\\n\", id)\n\treturn 0\n}\n\n// promptLine prints label and reads one trimmed line from br (no default\n// shown) — for the add wizard's required, default-less fields like the profile\n// id. On EOF it returns whatever was read, like cli's readLine.\nfunc promptLine(label string, br *bufio.Reader, w io.Writer) (string, error) {\n\tfmt.Fprint(w, label)\n\tline, err := br.ReadString('\\n')\n\tif err != nil && !errors.Is(err, io.EOF) {\n\t\treturn \"\", err\n\t}\n\treturn strings.TrimSpace(line), nil\n}\n\n// profilesSet writes MANIGOT_PROFILE=<name> into .env and prints the same\n// confirmation + missing-credentials warning profiles.sh's confirm_set did.\nfunc profilesSet(name string, stdout, stderr io.Writer) int {\n\tif _, ok := config.ProfileByID(name); !ok {\n\t\tfmt.Fprintf(stderr, \"Error: unknown profile '%s'.\\n\", name)\n\t\tfmt.Fprintf(stderr, \"Valid profiles: %s\\n\", strings.Join(profileIDs(), \" \"))\n\t\treturn 1\n\t}\n\tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", name); err != nil {\n\t\tfmt.Fprintf(stderr, \"mg profiles: %v\\n\", err)\n\t\treturn 1\n\t}\n\tconfirmSet(name, stdout)\n\treturn 0\n}\n\n// confirmSet prints the shared set confirmation, warning when the profile's\n// auth key is not in .env yet.\nfunc confirmSet(name string, w io.Writer) {\n\tenvFile := config.EnvFile()\n\tfmt.Fprintf(w, \"Default profile set to %s (MANIGOT_PROFILE in %s).\\n\", name, envFile)\n\tfmt.Fprintln(w, \"Bare `mg` sessions and TUI-launched sessions share this default.\")\n\n\tif p, ok := config.ProfileByID(name); ok && len(p.AuthKeys) > 0 {\n\t\tif key := p.AuthKeys[0]; config.EnvValue(key) == \"\" {\n\t\t\tfmt.Fprintf(w, \"Warning: %s is not set in %s — run 'mg setup %s' first, or sessions will fail at launch.\\n\", key, envFile, name)\n\t\t}\n\t}\n}\n\n// profilesList prints the profile table, then offers the interactive picker\n// on a TTY — same listing, and the picker rows carry the same padded columns\n// (byte-padded by padBytes, matching bash printf's byte-based padding: the\n// label column contains a multi-byte ·, so rune-based fmt padding would\n// misalign every row by one). The picker replaces the old numbered\n// `[1-N, Enter keeps X, q quits]` loop; the cursor opens on the active\n// default so a bare enter keeps it. Off a TTY the listing alone is the whole\n// command (exit 0 — listing is `mg profiles`' documented purpose, unlike\n// jobs/agents which refuse because selection is their only purpose).\nfunc profilesList(r io.Reader, w io.Writer, tty bool, pick pickerRunFunc) int {\n\tactive := config.EnvValue(\"MANIGOT_PROFILE\")\n\tif active == \"\" {\n\t\tactive = config.ProfileClaudePro\n\t}\n\tfmt.Fprintf(w, \"Active default: %s   (shared with the TUI; switch with: mg profiles <name>, or pick one below)\\n\", active)\n\tfmt.Fprintln(w, \"\")\n\tfmt.Fprintf(w, \"  %-13s %-28s %-10s %-26s %s\\n\", \"profile\", \"label\", \"tool\", \"model\", \"creds\")\n\tfmt.Fprintf(w, \"  %-13s %-28s %-10s %-26s %s\\n\", \"---------\", \"----------------------------\", \"----------\", \"--------------------------\", \"-----\")\n\tfor _, p := range config.Profiles() {\n\t\tmark := \" \"\n\t\tif p.ID == active {\n\t\t\tmark = \"*\"\n\t\t}\n\t\trow := \"  \" + mark + padBytes(p.ID, 12) + \" \" + padBytes(p.Label, 28) + \" \" +\n\t\t\tpadBytes(p.Tool, 10) + \" \" + padBytes(profileModel(p.ID), 26) + \" \" + creds(p.ID)\n\t\tfmt.Fprintln(w, row)\n\t}\n\tfmt.Fprintln(w, \"\")\n\tfmt.Fprintln(w, \"  * = default. Configure credentials with: mg setup [name]\")\n\n\tif !tty {\n\t\treturn 0\n\t}\n\n\tprofiles := config.Profiles()\n\trows := make([]ui.PickerRow, 0, len(profiles))\n\tstart := 0\n\tfor i, p := range profiles {\n\t\tif p.ID == active {\n\t\t\tstart = i\n\t\t}\n\t\tmodel := profileModel(p.ID)\n\t\tcred := creds(p.ID)\n\t\tmark := \" \"\n\t\tif p.ID == active {\n\t\t\tmark = \"*\"\n\t\t}\n\t\trows = append(rows, ui.PickerRow{\n\t\t\tID:        p.ID,\n\t\t\tSearchKey: p.ID + \" \" + p.Label + \" \" + p.Tool + \" \" + model + \" \" + cred,\n\t\t\t// The same padded columns as the plain listing (minus the leading\n\t\t\t// indent, which the picker's own cursor/blank prefix provides),\n\t\t\t// keeping the * active mark.\n\t\t\tLabel: mark + padBytes(p.ID, 12) + \" \" + padBytes(p.Label, 28) + \" \" +\n\t\t\t\tpadBytes(p.Tool, 10) + \" \" + padBytes(model, 26) + \" \" + cred,\n\t\t})\n\t}\n\n\tchosen, ok, err := pick(\"Select the default profile\", rows, start)\n\tif err != nil {\n\t\tfmt.Fprintf(w, \"mg profiles: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif !ok {\n\t\t// Cancelled (esc/q) — a quiet exit 0, not the old \"quit\" error.\n\t\treturn 0\n\t}\n\tif chosen == active {\n\t\tfmt.Fprintf(w, \"Keeping %s.\\n\", active)\n\t\treturn 0\n\t}\n\tfmt.Fprintln(w, \"\")\n\tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", chosen); err != nil {\n\t\tfmt.Fprintf(w, \"mg profiles: %v\\n\", err)\n\t\treturn 1\n\t}\n\tconfirmSet(chosen, w)\n\treturn 0\n}\n\n// profileModel returns the model column for a profile: the effective .env /\n// environment override when set, else the compiled-in default. Both come from\n// the profile's definition (config.ProfileByID), so a user-defined profile\n// renders its own model env/default.\nfunc profileModel(id string) string {\n\tp, ok := config.ProfileByID(id)\n\tif !ok {\n\t\treturn \"\"\n\t}\n\tif p.ModelEnv != \"\" {\n\t\tif v := config.EnvValue(p.ModelEnv); v != \"\" {\n\t\t\treturn v\n\t\t}\n\t}\n\treturn p.ModelDefault\n}\n\n// creds returns the creds column for a profile: \"✓ ready\" when every required\n// key is set, else \"✗ missing <first missing key>\". The required keys are the\n// profile's AuthKeys. Checks the effective value (process env + .env),\n// matching the scripts' sourced-env ${!KEY:-} reads.\nfunc creds(id string) string {\n\tp, ok := config.ProfileByID(id)\n\tif !ok {\n\t\t// An unknown id has no keys, so the old loop ran zero times and\n\t\t// reported \"ready\" — preserved for identical output.\n\t\treturn \"✓ ready\"\n\t}\n\tfor _, k := range p.AuthKeys {\n\t\tif config.EnvValue(k) == \"\" {\n\t\t\treturn \"✗ missing \" + k\n\t\t}\n\t}\n\treturn \"✓ ready\"\n}\n\n// profileIDs returns the ordered profile ids for error messages.\nfunc profileIDs() []string {\n\tps := config.Profiles()\n\tids := make([]string, len(ps))\n\tfor i, p := range ps {\n\t\tids[i] = p.ID\n\t}\n\treturn ids\n}\n\n// padBytes returns s padded with trailing spaces to the given byte width —\n// bash printf pads %s by byte length, and the profile table's label column\n// contains a multi-byte ·, so fmt's rune-based width would misalign.\nfunc padBytes(s string, width int) string {\n\tif n := len(s); n >= width {\n\t\treturn s\n\t}\n\treturn s + strings.Repeat(\" \", width-len(s))\n}","lineStart":1,"lineEnd":394,"totalLines":394,"truncated":false}},"title":"src/cmd/mg/profiles.go","time":{"start":1787992598008,"end":1787992598026}},"id":"prt_04ca9e5f3001q51ertnkw7RWRH","sessionID":"ses_fb356b356ffep6vyvmzQINQBoz","messageID":"msg_04ca9c39b001k2GFaharfB3e6w"}}
