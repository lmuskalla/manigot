{"type":"tool_use","timestamp":1787993311070,"sessionID":"ses_fb34d9020ffe9TT7hHKcNCMGib","part":{"type":"tool","tool":"grep","callID":"call_01bb3569cd3c4185a5a4be32","state":{"status":"completed","input":{"path":"/workspace/src/internal/home","pattern":"func Root|Executable|Getenv|lookPath|LookPath|Getwd"},"output":"Found 11 matches\n/workspace/src/internal/home/home_test.go:\n  Line 68: \tif got := os.Getenv(EnvHome); got != dir {\n\n\n/workspace/src/internal/home/home.go:\n  Line 33: func Root() string {\n\n  Line 34: \tif home := strings.TrimSpace(os.Getenv(EnvHome)); home != \"\" {\n\n  Line 40: \tif cwd, err := os.Getwd(); err == nil {\n\n  Line 54: \tif home := strings.TrimSpace(os.Getenv(EnvHome)); home != \"\" {\n\n  Line 74: \t\texecutableRootsCache = computeExecutableRoots()\n\n  Line 79: // executableRootsOnce / executableRootsCache memoize computeExecutableRoots:\n\n  Line 80: // os.Executable and filepath.EvalSymlinks are process-constant and not cheap,\n\n  Line 90: // computeExecutableRoots is executableRoots' uncached body.\n\n  Line 91: func computeExecutableRoots() []string {\n\n  Line 92: \texe, err := os.Executable()\n","metadata":{"matches":11,"truncated":false},"title":"func Root|Executable|Getenv|lookPath|LookPath|Getwd","time":{"start":1787993311066,"end":1787993311068}},"id":"prt_04cb4c757001UDcOHI6UGHN1do","sessionID":"ses_fb34d9020ffe9TT7hHKcNCMGib","messageID":"msg_04cb4a910001Fbv6mbfd1s33gJ"}}
