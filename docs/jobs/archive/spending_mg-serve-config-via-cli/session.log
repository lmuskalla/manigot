{"type":"tool_use","timestamp":1787992589046,"sessionID":"ses_fb356b356ffep6vyvmzQINQBoz","part":{"type":"tool","tool":"read","callID":"call_e1dc0ffc5b3245c0ac4afe38","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/registry.go"},"output":"<path>/workspace/src/internal/serve/registry.go</path>\n<type>file</type>\n<content>\n1: // Package serve is the manigot daemon — the \"listener\" control plane\n2: // described in docs/web-interface.md and the listener brief: a long-running\n3: // `mg serve` process exposing a read-only control API over the existing\n4: // in-process machinery (internal/job, internal/git, the mg jdi state machine,\n5: // the session launcher), so any surface — a web UI, a native GUI, a future\n6: // CLI — can attach to it as a client, from localhost or from a VPS.\n7: //\n8: // One package owns the daemon: the project registry, the HTTP server and its\n9: // handlers, auth, the audit log, and the per-project serialization skeleton —\n10: // mirroring how internal/session owns the session launcher. The scope of the\n11: // v1 API is deliberately read-only (see the brief's out-of-scope list);\n12: // mutating endpoints are a later job and inherit the serialization pattern\n13: // established here.\n14: package serve\n15: \n16: import (\n17: \t\"encoding/json\"\n18: \t\"errors\"\n19: \t\"fmt\"\n20: \t\"io\"\n21: \t\"os\"\n22: \t\"path/filepath\"\n23: \t\"regexp\"\n24: \n25: \t\"github.com/lmuskalla/manigot/internal/config\"\n26: \t\"github.com/lmuskalla/manigot/internal/fs\"\n27: )\n28: \n29: // RegistryFileName is the name of the registry config file inside the\n30: // manigot checkout's config/ directory.\n31: const RegistryFileName = \"serve.json\"\n32: \n33: // DefaultRegistryPath returns the default registry config location:\n34: // <manigot checkout>/config/serve.json (config.Dir()). \"\" when the checkout\n35: // cannot be located — the caller (mg serve) then reports a clear error.\n36: func DefaultRegistryPath() string {\n37: \tdir := config.Dir()\n38: \tif dir == \"\" {\n39: \t\treturn \"\"\n40: \t}\n41: \treturn filepath.Join(dir, \"serve.json\")\n42: }\n43: \n44: // registryEntry is the on-disk JSON shape of one registry entry: an\n45: // operator-chosen name (the URL segment the daemon serves it under) and its\n46: // filesystem root. The flat-string form (\"projects\": [\"/abs/root\"]) is not\n47: // supported — json.Unmarshal of a string into this struct fails naturally,\n48: // which is exactly the \"no backwards compatibility\" behavior the brief calls\n49: // for.\n50: type registryEntry struct {\n51: \tName string `json:\"name\"`\n52: \tPath string `json:\"path\"`\n53: }\n54: \n55: // registryFile is the on-disk JSON shape of the registry config file.\n56: type registryFile struct {\n57: \tProjects []registryEntry `json:\"projects\"`\n58: }\n59: \n60: // Entry is one registered project: an operator-chosen name (the URL segment\n61: // that resolves to it) and its absolute, cleaned filesystem root.\n62: type Entry struct {\n63: \tName string\n64: \tPath string\n65: }\n66: \n67: // projectNamePattern is the URL-safe charset a registry entry's name must\n68: // match: ASCII letters, digits, dot, underscore, hyphen. A name is served\n69: // verbatim in /projects and matched byte-for-byte against incoming URL\n70: // segments (see api.go's resolveProject), so keeping the charset\n71: // conservative avoids any ambiguity from encoding, case-folding, or reserved\n72: // URL characters — a stricter requirement than validSegment's structural\n73: // no-traversal/no-separator discipline, which this also reuses.\n74: var projectNamePattern = regexp.MustCompile(`^[A-Za-z0-9._-]+$`)\n75: \n76: // validProjectName reports whether name is an acceptable registry entry\n77: // name: validSegment's structural discipline (non-empty, not \".\" or \"..\", no\n78: // path separator, no NUL) plus the conservative URL-safe charset above.\n79: func validProjectName(name string) bool {\n80: \treturn validSegment(name) && projectNamePattern.MatchString(name)\n81: }\n82: \n83: // Registry is the daemon's explicit list of named project entries. It is\n84: // read once at startup from a config file — no scanning, no auto-adopting\n85: // directories the daemon finds. Changing the registered entries means\n86: // editing the config file and restarting (v1). Every handler resolves ONLY\n87: // against these entries via Entries()/Project() — the single choke point the\n88: // zero-path-inputs enforcement (see api.go's resolution helpers) builds on.\n89: type Registry struct {\n90: \tentries []Entry // name + absolute, cleaned path, in config-file order\n91: }\n92: \n93: // LoadRegistry reads the registry config file at path and validates every\n94: // entry. A missing file is an empty registry, not an error (a fresh checkout\n95: // simply has nothing registered yet). An unreadable-but-present file, an\n96: // unparseable file, an invalid or duplicate name, a duplicate path, or an\n97: // entry whose path is not an existing directory is an error — a broken\n98: // registry must never silently serve a subset.\n99: //\n100: // Each entry's name must be non-empty, a single URL-safe path segment\n101: // (validProjectName), and unique across the registry. Each entry's path must\n102: // exist as a directory; a root without docs/ is accepted (it lists no jobs\n103: // rather than failing startup) — the caller may warn about it, see\n104: // (*Registry).WarnMissingDocs. Two entries registering the same path (under\n105: // different names) are also refused: a path is intended to be reachable\n106: // under exactly one operator-chosen identity, and rejecting keeps the\n107: // \"refuse to start on anything surprising\" discipline the rest of the\n108: // registry's validation follows, rather than silently picking one name over\n109: // the other.\n110: func LoadRegistry(path string) (*Registry, error) {\n111: \tdata, err := os.ReadFile(path)\n112: \tif err != nil {\n113: \t\tif os.IsNotExist(err) {\n114: \t\t\treturn &Registry{}, nil\n115: \t\t}\n116: \t\treturn nil, fmt.Errorf(\"read registry %s: %w\", path, err)\n117: \t}\n118: \n119: \tvar raw registryFile\n120: \tif err := json.Unmarshal(data, &raw); err != nil {\n121: \t\treturn nil, fmt.Errorf(\"parse registry %s: %w\", path, err)\n122: \t}\n123: \n124: \treg := &Registry{}\n125: \tseenNames := make(map[string]bool)\n126: \tseenPaths := make(map[string]string) // abs path -> the name that claimed it\n127: \tfor _, e := range raw.Projects {\n128: \t\tif !validProjectName(e.Name) {\n129: \t\t\treturn nil, fmt.Errorf(\"registry %s: entry name %q is invalid — it must be non-empty, a single URL-safe path segment (%s), not \\\".\\\" or \\\"..\\\"\", path, e.Name, projectNamePattern.String())\n130: \t\t}\n131: \t\tif seenNames[e.Name] {\n132: \t\t\treturn nil, fmt.Errorf(\"registry %s: duplicate entry name %q\", path, e.Name)\n133: \t\t}\n134: \n135: \t\tabs, err := filepath.Abs(e.Path)\n136: \t\tif err != nil {\n137: \t\t\treturn nil, fmt.Errorf(\"registry %s: entry %q: resolve %q: %w\", path, e.Name, e.Path, err)\n138: \t\t}\n139: \t\tabs = filepath.Clean(abs)\n140: \t\tif other, ok := seenPaths[abs]; ok {\n141: \t\t\treturn nil, fmt.Errorf(\"registry %s: entry %q and %q both register path %q\", path, other, e.Name, abs)\n142: \t\t}\n143: \t\tinfo, err := os.Stat(abs)\n144: \t\tif err != nil {\n145: \t\t\treturn nil, fmt.Errorf(\"registry %s: entry %q: %q is not an existing directory: %w\", path, e.Name, e.Path, err)\n146: \t\t}\n147: \t\tif !info.IsDir() {\n148: \t\t\treturn nil, fmt.Errorf(\"registry %s: entry %q: %q is not a directory\", path, e.Name, e.Path)\n149: \t\t}\n150: \n151: \t\tseenNames[e.Name] = true\n152: \t\tseenPaths[abs] = e.Name\n153: \t\treg.entries = append(reg.entries, Entry{Name: e.Name, Path: abs})\n154: \t}\n155: \treturn reg, nil\n156: }\n157: \n158: // Entries returns an ordered copy of the registered entries (name + path).\n159: // The copy guarantees a caller cannot mutate the registry's internal slice.\n160: func (r *Registry) Entries() []Entry {\n161: \treturn append([]Entry(nil), r.entries...)\n162: }\n163: \n164: // Projects returns an ordered copy of the registered project roots' paths.\n165: // The copy guarantees a caller cannot mutate the registry's internal slice.\n166: func (r *Registry) Projects() []string {\n167: \tpaths := make([]string, len(r.entries))\n168: \tfor i, e := range r.entries {\n169: \t\tpaths[i] = e.Path\n170: \t}\n171: \treturn paths\n172: }\n173: \n174: // Project resolves a URL project segment against the registered entries by\n175: // configured name ONLY — names are validated unique at load time, so there\n176: // is no ambiguity to resolve. Nothing is ever joined into a filesystem path\n177: // here — the returned root IS one of the registered paths, never a\n178: // derivation from the input. ok is false when the segment matches no entry's\n179: // name.\n180: func (r *Registry) Project(segment string) (string, bool) {\n181: \tfor _, e := range r.entries {\n182: \t\tif e.Name == segment {\n183: \t\t\treturn e.Path, true\n184: \t\t}\n185: \t}\n186: \treturn \"\", false\n187: }\n188: \n189: // WarnMissingDocs writes a warning line for every registered root without a\n190: // docs/ directory to w — the \"a registered project needs docs/ for jobs, but\n191: // a root without docs/ lists no jobs rather than failing startup\" behavior\n192: // the brief calls for. w may be nil (no warnings).\n193: func (r *Registry) WarnMissingDocs(w io.Writer) {\n194: \tfor _, e := range r.entries {\n195: \t\tif !fs.IsDir(filepath.Join(e.Path, \"docs\")) {\n196: \t\t\tfmt.Fprintf(w, \"Warning: registered project %s (%s) has no docs/ directory — it will list no jobs.\\n\", e.Name, e.Path)\n197: \t\t}\n198: \t}\n199: }\n200: \n201: // ErrNoRegistryPath is returned by mg serve when the registry path cannot be\n202: // determined (no --registry flag and the manigot checkout cannot be located).\n203: var ErrNoRegistryPath = errors.New(\"cannot determine the registry config location (set $MANIGOT_HOME or pass --registry)\")\n\n(End of file - total 203 lines)\n</content>","metadata":{"preview":"// Package serve is the manigot daemon — the \"listener\" control plane\n// described in docs/web-interface.md and the listener brief: a long-running\n// `mg serve` process exposing a read-only control API over the existing\n// in-process machinery (internal/job, internal/git, the mg jdi state machine,\n// the session launcher), so any surface — a web UI, a native GUI, a future\n// CLI — can attach to it as a client, from localhost or from a VPS.\n//\n// One package owns the daemon: the project registry, the HTTP server and its\n// handlers, auth, the audit log, and the per-project serialization skeleton —\n// mirroring how internal/session owns the session launcher. The scope of the\n// v1 API is deliberately read-only (see the brief's out-of-scope list);\n// mutating endpoints are a later job and inherit the serialization pattern\n// established here.\npackage serve\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/registry.go","text":"// Package serve is the manigot daemon — the \"listener\" control plane\n// described in docs/web-interface.md and the listener brief: a long-running\n// `mg serve` process exposing a read-only control API over the existing\n// in-process machinery (internal/job, internal/git, the mg jdi state machine,\n// the session launcher), so any surface — a web UI, a native GUI, a future\n// CLI — can attach to it as a client, from localhost or from a VPS.\n//\n// One package owns the daemon: the project registry, the HTTP server and its\n// handlers, auth, the audit log, and the per-project serialization skeleton —\n// mirroring how internal/session owns the session launcher. The scope of the\n// v1 API is deliberately read-only (see the brief's out-of-scope list);\n// mutating endpoints are a later job and inherit the serialization pattern\n// established here.\npackage serve\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/fs\"\n)\n\n// RegistryFileName is the name of the registry config file inside the\n// manigot checkout's config/ directory.\nconst RegistryFileName = \"serve.json\"\n\n// DefaultRegistryPath returns the default registry config location:\n// <manigot checkout>/config/serve.json (config.Dir()). \"\" when the checkout\n// cannot be located — the caller (mg serve) then reports a clear error.\nfunc DefaultRegistryPath() string {\n\tdir := config.Dir()\n\tif dir == \"\" {\n\t\treturn \"\"\n\t}\n\treturn filepath.Join(dir, \"serve.json\")\n}\n\n// registryEntry is the on-disk JSON shape of one registry entry: an\n// operator-chosen name (the URL segment the daemon serves it under) and its\n// filesystem root. The flat-string form (\"projects\": [\"/abs/root\"]) is not\n// supported — json.Unmarshal of a string into this struct fails naturally,\n// which is exactly the \"no backwards compatibility\" behavior the brief calls\n// for.\ntype registryEntry struct {\n\tName string `json:\"name\"`\n\tPath string `json:\"path\"`\n}\n\n// registryFile is the on-disk JSON shape of the registry config file.\ntype registryFile struct {\n\tProjects []registryEntry `json:\"projects\"`\n}\n\n// Entry is one registered project: an operator-chosen name (the URL segment\n// that resolves to it) and its absolute, cleaned filesystem root.\ntype Entry struct {\n\tName string\n\tPath string\n}\n\n// projectNamePattern is the URL-safe charset a registry entry's name must\n// match: ASCII letters, digits, dot, underscore, hyphen. A name is served\n// verbatim in /projects and matched byte-for-byte against incoming URL\n// segments (see api.go's resolveProject), so keeping the charset\n// conservative avoids any ambiguity from encoding, case-folding, or reserved\n// URL characters — a stricter requirement than validSegment's structural\n// no-traversal/no-separator discipline, which this also reuses.\nvar projectNamePattern = regexp.MustCompile(`^[A-Za-z0-9._-]+$`)\n\n// validProjectName reports whether name is an acceptable registry entry\n// name: validSegment's structural discipline (non-empty, not \".\" or \"..\", no\n// path separator, no NUL) plus the conservative URL-safe charset above.\nfunc validProjectName(name string) bool {\n\treturn validSegment(name) && projectNamePattern.MatchString(name)\n}\n\n// Registry is the daemon's explicit list of named project entries. It is\n// read once at startup from a config file — no scanning, no auto-adopting\n// directories the daemon finds. Changing the registered entries means\n// editing the config file and restarting (v1). Every handler resolves ONLY\n// against these entries via Entries()/Project() — the single choke point the\n// zero-path-inputs enforcement (see api.go's resolution helpers) builds on.\ntype Registry struct {\n\tentries []Entry // name + absolute, cleaned path, in config-file order\n}\n\n// LoadRegistry reads the registry config file at path and validates every\n// entry. A missing file is an empty registry, not an error (a fresh checkout\n// simply has nothing registered yet). An unreadable-but-present file, an\n// unparseable file, an invalid or duplicate name, a duplicate path, or an\n// entry whose path is not an existing directory is an error — a broken\n// registry must never silently serve a subset.\n//\n// Each entry's name must be non-empty, a single URL-safe path segment\n// (validProjectName), and unique across the registry. Each entry's path must\n// exist as a directory; a root without docs/ is accepted (it lists no jobs\n// rather than failing startup) — the caller may warn about it, see\n// (*Registry).WarnMissingDocs. Two entries registering the same path (under\n// different names) are also refused: a path is intended to be reachable\n// under exactly one operator-chosen identity, and rejecting keeps the\n// \"refuse to start on anything surprising\" discipline the rest of the\n// registry's validation follows, rather than silently picking one name over\n// the other.\nfunc LoadRegistry(path string) (*Registry, error) {\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn &Registry{}, nil\n\t\t}\n\t\treturn nil, fmt.Errorf(\"read registry %s: %w\", path, err)\n\t}\n\n\tvar raw registryFile\n\tif err := json.Unmarshal(data, &raw); err != nil {\n\t\treturn nil, fmt.Errorf(\"parse registry %s: %w\", path, err)\n\t}\n\n\treg := &Registry{}\n\tseenNames := make(map[string]bool)\n\tseenPaths := make(map[string]string) // abs path -> the name that claimed it\n\tfor _, e := range raw.Projects {\n\t\tif !validProjectName(e.Name) {\n\t\t\treturn nil, fmt.Errorf(\"registry %s: entry name %q is invalid — it must be non-empty, a single URL-safe path segment (%s), not \\\".\\\" or \\\"..\\\"\", path, e.Name, projectNamePattern.String())\n\t\t}\n\t\tif seenNames[e.Name] {\n\t\t\treturn nil, fmt.Errorf(\"registry %s: duplicate entry name %q\", path, e.Name)\n\t\t}\n\n\t\tabs, err := filepath.Abs(e.Path)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"registry %s: entry %q: resolve %q: %w\", path, e.Name, e.Path, err)\n\t\t}\n\t\tabs = filepath.Clean(abs)\n\t\tif other, ok := seenPaths[abs]; ok {\n\t\t\treturn nil, fmt.Errorf(\"registry %s: entry %q and %q both register path %q\", path, other, e.Name, abs)\n\t\t}\n\t\tinfo, err := os.Stat(abs)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"registry %s: entry %q: %q is not an existing directory: %w\", path, e.Name, e.Path, err)\n\t\t}\n\t\tif !info.IsDir() {\n\t\t\treturn nil, fmt.Errorf(\"registry %s: entry %q: %q is not a directory\", path, e.Name, e.Path)\n\t\t}\n\n\t\tseenNames[e.Name] = true\n\t\tseenPaths[abs] = e.Name\n\t\treg.entries = append(reg.entries, Entry{Name: e.Name, Path: abs})\n\t}\n\treturn reg, nil\n}\n\n// Entries returns an ordered copy of the registered entries (name + path).\n// The copy guarantees a caller cannot mutate the registry's internal slice.\nfunc (r *Registry) Entries() []Entry {\n\treturn append([]Entry(nil), r.entries...)\n}\n\n// Projects returns an ordered copy of the registered project roots' paths.\n// The copy guarantees a caller cannot mutate the registry's internal slice.\nfunc (r *Registry) Projects() []string {\n\tpaths := make([]string, len(r.entries))\n\tfor i, e := range r.entries {\n\t\tpaths[i] = e.Path\n\t}\n\treturn paths\n}\n\n// Project resolves a URL project segment against the registered entries by\n// configured name ONLY — names are validated unique at load time, so there\n// is no ambiguity to resolve. Nothing is ever joined into a filesystem path\n// here — the returned root IS one of the registered paths, never a\n// derivation from the input. ok is false when the segment matches no entry's\n// name.\nfunc (r *Registry) Project(segment string) (string, bool) {\n\tfor _, e := range r.entries {\n\t\tif e.Name == segment {\n\t\t\treturn e.Path, true\n\t\t}\n\t}\n\treturn \"\", false\n}\n\n// WarnMissingDocs writes a warning line for every registered root without a\n// docs/ directory to w — the \"a registered project needs docs/ for jobs, but\n// a root without docs/ lists no jobs rather than failing startup\" behavior\n// the brief calls for. w may be nil (no warnings).\nfunc (r *Registry) WarnMissingDocs(w io.Writer) {\n\tfor _, e := range r.entries {\n\t\tif !fs.IsDir(filepath.Join(e.Path, \"docs\")) {\n\t\t\tfmt.Fprintf(w, \"Warning: registered project %s (%s) has no docs/ directory — it will list no jobs.\\n\", e.Name, e.Path)\n\t\t}\n\t}\n}\n\n// ErrNoRegistryPath is returned by mg serve when the registry path cannot be\n// determined (no --registry flag and the manigot checkout cannot be located).\nvar ErrNoRegistryPath = errors.New(\"cannot determine the registry config location (set $MANIGOT_HOME or pass --registry)\")","lineStart":1,"lineEnd":203,"totalLines":203,"truncated":false}},"title":"src/internal/serve/registry.go","time":{"start":1787992589041,"end":1787992589043}},"id":"prt_04ca9c2ee0013zh6zVA529Ir9z","sessionID":"ses_fb356b356ffep6vyvmzQINQBoz","messageID":"msg_04ca9bc61001xDjhsAZs6QDDw5"}}
{"type":"tool_use","timestamp":1787992589196,"sessionID":"ses_fb356b356ffep6vyvmzQINQBoz","part":{"type":"tool","tool":"read","callID":"call_e3b803ce7f404c13a01a5040","state":{"status":"completed","input":{"filePath":"/workspace/src/cmd/mg/serve.go"},"output":"<path>/workspace/src/cmd/mg/serve.go</path>\n<type>file</type>\n<content>\n1: // mg serve — the listener: a long-running daemon exposing a control API over a\n2: // registry of project roots, so any surface (a web UI, a native GUI, a future\n3: // CLI) can attach to it as a client — from localhost or from a VPS. This is\n4: // the control-plane sequence described in docs/listener.md: `mg serve` +\n5: // project registry + read-only API + localhost default + audit log +\n6: // serialization skeleton, then the mutating lifecycle endpoints and the live\n7: // session-log SSE stream.\n8: //\n9: // The daemon is additive: the TUI stays in-process, and every existing\n10: // command keeps working untouched. It binds to 127.0.0.1:8080 by default\n11: // (tokenless — the machine's own user is the trust boundary, as it is for the\n12: // CLI today); a non-loopback bind REQUIRES a bearer token (--token or\n13: // $MG_SERVE_TOKEN) or the daemon refuses to start. TLS is the reverse proxy's\n14: // job (Caddy/nginx), never the daemon's.\n15: package main\n16: \n17: import (\n18: \t\"context\"\n19: \t\"errors\"\n20: \t\"flag\"\n21: \t\"fmt\"\n22: \t\"io\"\n23: \t\"net\"\n24: \t\"net/http\"\n25: \t\"os\"\n26: \t\"os/signal\"\n27: \t\"strconv\"\n28: \t\"syscall\"\n29: \t\"time\"\n30: \n31: \t\"github.com/lmuskalla/manigot/internal/config\"\n32: \t\"github.com/lmuskalla/manigot/internal/serve\"\n33: )\n34: \n35: // serveShutdownDrain bounds how long mg serve waits for in-flight requests to\n36: // finish on SIGINT/SIGTERM before giving up — a hung request must never wedge\n37: // the exit.\n38: const serveShutdownDrain = 10 * time.Second\n39: \n40: // runServe implements `mg serve` — the listener daemon. It parses the flags,\n41: // loads the project registry, enforces the bind/auth startup guard, then\n42: // blocks serving until SIGINT/SIGTERM, shutting down gracefully with a\n43: // bounded drain. Returns the process exit code.\n44: func runServe(args []string, stdout, stderr io.Writer) int {\n45: \treturn serveCommand(args, stdout, stderr, nil)\n46: }\n47: \n48: // serveCommand is runServe's testable core: it differs only in the listener\n49: // source. When ln is non-nil it serves on that already-bound listener (tests\n50: // hand over a bound 127.0.0.1:0 listener); when nil it binds one itself from\n51: // the --addr/--port flags. Signal handling and the graceful shutdown path are\n52: // identical in both shapes.\n53: func serveCommand(args []string, stdout, stderr io.Writer, ln net.Listener) int {\n54: \tfs := flag.NewFlagSet(\"mg serve\", flag.ContinueOnError)\n55: \tfs.SetOutput(stderr)\n56: \taddr := fs.String(\"addr\", \"127.0.0.1\", \"bind host (loopback default; a non-loopback bind requires a token)\")\n57: \tport := fs.Int(\"port\", 8080, \"bind port\")\n58: \tregistry := fs.String(\"registry\", \"\", \"path to the project registry config (default <checkout>/config/serve.json)\")\n59: \ttokenFlag := fs.String(\"token\", \"\", \"bearer token required on every request (default $MG_SERVE_TOKEN)\")\n60: \tfs.Usage = func() {\n61: \t\tfmt.Fprintf(stderr, \"mg serve %s\\n\\n\", version)\n62: \t\tfmt.Fprintf(stderr, \"The listener: a long-running daemon exposing a control API\\n\")\n63: \t\tfmt.Fprintf(stderr, \"over a registry of project roots (the basis for the web UI / native GUI\\n\")\n64: \t\tfmt.Fprintf(stderr, \"control-plane sequence).\\n\\n\")\n65: \t\tfmt.Fprintf(stderr, \"Usage:\\n\")\n66: \t\tfmt.Fprintf(stderr, \"  mg serve [flags]\\n\\n\")\n67: \t\tfmt.Fprintf(stderr, \"The registry config file holds the named project roots the daemon serves:\\n\")\n68: \t\tfmt.Fprintf(stderr, \"  {\\\"projects\\\": [{\\\"name\\\": \\\"my-project\\\", \\\"path\\\": \\\"/abs/project/root\\\"}, ...]}\\n\")\n69: \t\tfmt.Fprintf(stderr, \"\\\"name\\\" is the URL segment the project is served under (a single URL-safe\\n\")\n70: \t\tfmt.Fprintf(stderr, \"path segment, unique across the registry); it is required and chosen by you.\\n\")\n71: \t\tfmt.Fprintf(stderr, \"Default location: <manigot checkout>/config/serve.json (override with --registry).\\n\")\n72: \t\tfmt.Fprintf(stderr, \"Changing the registered roots means editing the file and restarting.\\n\\n\")\n73: \t\tfmt.Fprintf(stderr, \"Flags:\\n\")\n74: \t\tfs.PrintDefaults()\n75: \t}\n76: \tif err := fs.Parse(args); err != nil {\n77: \t\treturn 2 // the flag package already printed the error + usage\n78: \t}\n79: \tif fs.NArg() > 0 {\n80: \t\tfmt.Fprintf(stderr, \"Unknown argument: %s\\n\", fs.Arg(0))\n81: \t\treturn 1\n82: \t}\n83: \n84: \t// Token precedence: --token flag, then $MG_SERVE_TOKEN (config.EnvValue —\n85: \t// the .env file first, then the process environment, exactly like every\n86: \t// other credential the daemon reads). A token is never issued, created, or\n87: \t// returned by the API.\n88: \ttoken := *tokenFlag\n89: \tif token == \"\" {\n90: \t\ttoken = config.EnvValue(\"MG_SERVE_TOKEN\")\n91: \t}\n92: \n93: \t// The project registry: an explicit config file of project roots, read\n94: \t// once at startup. No scanning, no auto-adopting.\n95: \tregistryPath := *registry\n96: \tif registryPath == \"\" {\n97: \t\tregistryPath = serve.DefaultRegistryPath()\n98: \t\tif registryPath == \"\" {\n99: \t\t\tcliError(stderr, serve.ErrNoRegistryPath)\n100: \t\t\treturn 1\n101: \t\t}\n102: \t}\n103: \treg, err := serve.LoadRegistry(registryPath)\n104: \tif err != nil {\n105: \t\tcliError(stderr, err)\n106: \t\treturn 1\n107: \t}\n108: \treg.WarnMissingDocs(stderr)\n109: \n110: \t// The startup guard — the hard invariant: a non-loopback bind with no\n111: \t// token refuses to start. Unskippable: there is no flag that turns it off.\n112: \tif err := serve.ValidateStartup(*addr, token); err != nil {\n113: \t\tcliError(stderr, err)\n114: \t\treturn 1\n115: \t}\n116: \n117: \tsrv := serve.New(reg, version, token, stderr)\n118: \n119: \t// Bind (or accept the test-supplied listener) and announce.\n120: \tif ln == nil {\n121: \t\tbindAddr := net.JoinHostPort(*addr, strconv.Itoa(*port))\n122: \t\tln, err = net.Listen(\"tcp\", bindAddr)\n123: \t\tif err != nil {\n124: \t\t\tcliError(stderr, fmt.Errorf(\"mg serve: cannot listen on %s: %v\", bindAddr, err))\n125: \t\t\treturn 1\n126: \t\t}\n127: \t}\n128: \tfmt.Fprintf(stdout, \"mg serve %s — listening on %s\\n\", version, ln.Addr())\n129: \tif token != \"\" {\n130: \t\tfmt.Fprintln(stdout, \"Bearer-token auth enabled — every request must carry Authorization: Bearer <token>.\")\n131: \t\tfmt.Fprintln(stdout, \"TLS is the reverse proxy's job (Caddy/nginx); the daemon always serves plain HTTP.\")\n132: \t} else {\n133: \t\tfmt.Fprintln(stdout, \"No token configured — tokenless mode (safe only on a loopback bind).\")\n134: \t}\n135: \tif len(reg.Projects()) == 0 {\n136: \t\tfmt.Fprintln(stdout, \"Warning: no projects registered — edit the registry config and restart to serve any.\")\n137: \t}\n138: \n139: \t// Serve until SIGINT/SIGTERM, then drain in-flight requests within a\n140: \t// bounded window and exit cleanly.\n141: \tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n142: \tdefer stop()\n143: \n144: \terrCh := make(chan error, 1)\n145: \tgo func() { errCh <- srv.Serve(ln) }()\n146: \n147: \tselect {\n148: \tcase err := <-errCh:\n149: \t\tif err != nil && !errors.Is(err, http.ErrServerClosed) {\n150: \t\t\tcliError(stderr, fmt.Errorf(\"mg serve: %v\", err))\n151: \t\t\treturn 1\n152: \t\t}\n153: \t\treturn 0\n154: \tcase <-ctx.Done():\n155: \t\tdrainCtx, cancel := context.WithTimeout(context.Background(), serveShutdownDrain)\n156: \t\tdefer cancel()\n157: \t\tif err := srv.Shutdown(drainCtx); err != nil {\n158: \t\t\tcliError(stderr, fmt.Errorf(\"mg serve: graceful shutdown: %v\", err))\n159: \t\t\treturn 1\n160: \t\t}\n161: \t\t<-errCh // the serve loop returns http.ErrServerClosed\n162: \t\tfmt.Fprintln(stdout, \"mg serve: shutting down.\")\n163: \t\treturn 0\n164: \t}\n165: }\n\n(End of file - total 165 lines)\n</content>","metadata":{"preview":"// mg serve — the listener: a long-running daemon exposing a control API over a\n// registry of project roots, so any surface (a web UI, a native GUI, a future\n// CLI) can attach to it as a client — from localhost or from a VPS. This is\n// the control-plane sequence described in docs/listener.md: `mg serve` +\n// project registry + read-only API + localhost default + audit log +\n// serialization skeleton, then the mutating lifecycle endpoints and the live\n// session-log SSE stream.\n//\n// The daemon is additive: the TUI stays in-process, and every existing\n// command keeps working untouched. It binds to 127.0.0.1:8080 by default\n// (tokenless — the machine's own user is the trust boundary, as it is for the\n// CLI today); a non-loopback bind REQUIRES a bearer token (--token or\n// $MG_SERVE_TOKEN) or the daemon refuses to start. TLS is the reverse proxy's\n// job (Caddy/nginx), never the daemon's.\npackage main\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"flag\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/cmd/mg/serve.go","text":"// mg serve — the listener: a long-running daemon exposing a control API over a\n// registry of project roots, so any surface (a web UI, a native GUI, a future\n// CLI) can attach to it as a client — from localhost or from a VPS. This is\n// the control-plane sequence described in docs/listener.md: `mg serve` +\n// project registry + read-only API + localhost default + audit log +\n// serialization skeleton, then the mutating lifecycle endpoints and the live\n// session-log SSE stream.\n//\n// The daemon is additive: the TUI stays in-process, and every existing\n// command keeps working untouched. It binds to 127.0.0.1:8080 by default\n// (tokenless — the machine's own user is the trust boundary, as it is for the\n// CLI today); a non-loopback bind REQUIRES a bearer token (--token or\n// $MG_SERVE_TOKEN) or the daemon refuses to start. TLS is the reverse proxy's\n// job (Caddy/nginx), never the daemon's.\npackage main\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"net\"\n\t\"net/http\"\n\t\"os\"\n\t\"os/signal\"\n\t\"strconv\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/serve\"\n)\n\n// serveShutdownDrain bounds how long mg serve waits for in-flight requests to\n// finish on SIGINT/SIGTERM before giving up — a hung request must never wedge\n// the exit.\nconst serveShutdownDrain = 10 * time.Second\n\n// runServe implements `mg serve` — the listener daemon. It parses the flags,\n// loads the project registry, enforces the bind/auth startup guard, then\n// blocks serving until SIGINT/SIGTERM, shutting down gracefully with a\n// bounded drain. Returns the process exit code.\nfunc runServe(args []string, stdout, stderr io.Writer) int {\n\treturn serveCommand(args, stdout, stderr, nil)\n}\n\n// serveCommand is runServe's testable core: it differs only in the listener\n// source. When ln is non-nil it serves on that already-bound listener (tests\n// hand over a bound 127.0.0.1:0 listener); when nil it binds one itself from\n// the --addr/--port flags. Signal handling and the graceful shutdown path are\n// identical in both shapes.\nfunc serveCommand(args []string, stdout, stderr io.Writer, ln net.Listener) int {\n\tfs := flag.NewFlagSet(\"mg serve\", flag.ContinueOnError)\n\tfs.SetOutput(stderr)\n\taddr := fs.String(\"addr\", \"127.0.0.1\", \"bind host (loopback default; a non-loopback bind requires a token)\")\n\tport := fs.Int(\"port\", 8080, \"bind port\")\n\tregistry := fs.String(\"registry\", \"\", \"path to the project registry config (default <checkout>/config/serve.json)\")\n\ttokenFlag := fs.String(\"token\", \"\", \"bearer token required on every request (default $MG_SERVE_TOKEN)\")\n\tfs.Usage = func() {\n\t\tfmt.Fprintf(stderr, \"mg serve %s\\n\\n\", version)\n\t\tfmt.Fprintf(stderr, \"The listener: a long-running daemon exposing a control API\\n\")\n\t\tfmt.Fprintf(stderr, \"over a registry of project roots (the basis for the web UI / native GUI\\n\")\n\t\tfmt.Fprintf(stderr, \"control-plane sequence).\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"Usage:\\n\")\n\t\tfmt.Fprintf(stderr, \"  mg serve [flags]\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"The registry config file holds the named project roots the daemon serves:\\n\")\n\t\tfmt.Fprintf(stderr, \"  {\\\"projects\\\": [{\\\"name\\\": \\\"my-project\\\", \\\"path\\\": \\\"/abs/project/root\\\"}, ...]}\\n\")\n\t\tfmt.Fprintf(stderr, \"\\\"name\\\" is the URL segment the project is served under (a single URL-safe\\n\")\n\t\tfmt.Fprintf(stderr, \"path segment, unique across the registry); it is required and chosen by you.\\n\")\n\t\tfmt.Fprintf(stderr, \"Default location: <manigot checkout>/config/serve.json (override with --registry).\\n\")\n\t\tfmt.Fprintf(stderr, \"Changing the registered roots means editing the file and restarting.\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"Flags:\\n\")\n\t\tfs.PrintDefaults()\n\t}\n\tif err := fs.Parse(args); err != nil {\n\t\treturn 2 // the flag package already printed the error + usage\n\t}\n\tif fs.NArg() > 0 {\n\t\tfmt.Fprintf(stderr, \"Unknown argument: %s\\n\", fs.Arg(0))\n\t\treturn 1\n\t}\n\n\t// Token precedence: --token flag, then $MG_SERVE_TOKEN (config.EnvValue —\n\t// the .env file first, then the process environment, exactly like every\n\t// other credential the daemon reads). A token is never issued, created, or\n\t// returned by the API.\n\ttoken := *tokenFlag\n\tif token == \"\" {\n\t\ttoken = config.EnvValue(\"MG_SERVE_TOKEN\")\n\t}\n\n\t// The project registry: an explicit config file of project roots, read\n\t// once at startup. No scanning, no auto-adopting.\n\tregistryPath := *registry\n\tif registryPath == \"\" {\n\t\tregistryPath = serve.DefaultRegistryPath()\n\t\tif registryPath == \"\" {\n\t\t\tcliError(stderr, serve.ErrNoRegistryPath)\n\t\t\treturn 1\n\t\t}\n\t}\n\treg, err := serve.LoadRegistry(registryPath)\n\tif err != nil {\n\t\tcliError(stderr, err)\n\t\treturn 1\n\t}\n\treg.WarnMissingDocs(stderr)\n\n\t// The startup guard — the hard invariant: a non-loopback bind with no\n\t// token refuses to start. Unskippable: there is no flag that turns it off.\n\tif err := serve.ValidateStartup(*addr, token); err != nil {\n\t\tcliError(stderr, err)\n\t\treturn 1\n\t}\n\n\tsrv := serve.New(reg, version, token, stderr)\n\n\t// Bind (or accept the test-supplied listener) and announce.\n\tif ln == nil {\n\t\tbindAddr := net.JoinHostPort(*addr, strconv.Itoa(*port))\n\t\tln, err = net.Listen(\"tcp\", bindAddr)\n\t\tif err != nil {\n\t\t\tcliError(stderr, fmt.Errorf(\"mg serve: cannot listen on %s: %v\", bindAddr, err))\n\t\t\treturn 1\n\t\t}\n\t}\n\tfmt.Fprintf(stdout, \"mg serve %s — listening on %s\\n\", version, ln.Addr())\n\tif token != \"\" {\n\t\tfmt.Fprintln(stdout, \"Bearer-token auth enabled — every request must carry Authorization: Bearer <token>.\")\n\t\tfmt.Fprintln(stdout, \"TLS is the reverse proxy's job (Caddy/nginx); the daemon always serves plain HTTP.\")\n\t} else {\n\t\tfmt.Fprintln(stdout, \"No token configured — tokenless mode (safe only on a loopback bind).\")\n\t}\n\tif len(reg.Projects()) == 0 {\n\t\tfmt.Fprintln(stdout, \"Warning: no projects registered — edit the registry config and restart to serve any.\")\n\t}\n\n\t// Serve until SIGINT/SIGTERM, then drain in-flight requests within a\n\t// bounded window and exit cleanly.\n\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n\tdefer stop()\n\n\terrCh := make(chan error, 1)\n\tgo func() { errCh <- srv.Serve(ln) }()\n\n\tselect {\n\tcase err := <-errCh:\n\t\tif err != nil && !errors.Is(err, http.ErrServerClosed) {\n\t\t\tcliError(stderr, fmt.Errorf(\"mg serve: %v\", err))\n\t\t\treturn 1\n\t\t}\n\t\treturn 0\n\tcase <-ctx.Done():\n\t\tdrainCtx, cancel := context.WithTimeout(context.Background(), serveShutdownDrain)\n\t\tdefer cancel()\n\t\tif err := srv.Shutdown(drainCtx); err != nil {\n\t\t\tcliError(stderr, fmt.Errorf(\"mg serve: graceful shutdown: %v\", err))\n\t\t\treturn 1\n\t\t}\n\t\t<-errCh // the serve loop returns http.ErrServerClosed\n\t\tfmt.Fprintln(stdout, \"mg serve: shutting down.\")\n\t\treturn 0\n\t}\n}","lineStart":1,"lineEnd":165,"totalLines":165,"truncated":false}},"title":"src/cmd/mg/serve.go","time":{"start":1787992589186,"end":1787992589192}},"id":"prt_04ca9c37e0014R021Zdv2KSOzT","sessionID":"ses_fb356b356ffep6vyvmzQINQBoz","messageID":"msg_04ca9bc61001xDjhsAZs6QDDw5"}}
