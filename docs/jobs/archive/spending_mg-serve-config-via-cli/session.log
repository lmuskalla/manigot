{"type":"tool_use","timestamp":1787993285880,"sessionID":"ses_fb34d9020ffe9TT7hHKcNCMGib","part":{"type":"tool","tool":"read","callID":"call_87c87c392d1a46be9a1b4b2a","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/registry_store_test.go"},"output":"<path>/workspace/src/internal/serve/registry_store_test.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"os\"\n5: \t\"path/filepath\"\n6: \t\"strings\"\n7: \t\"testing\"\n8: )\n9: \n10: // TestAddRegistryEntryCreatesFile: adding to a registry that does not exist\n11: // yet (a fresh checkout) creates the file with the one entry, in the\n12: // daemon-readable shape.\n13: func TestAddRegistryEntryCreatesFile(t *testing.T) {\n14: \troot := t.TempDir()\n15: \tpath := filepath.Join(t.TempDir(), \"config\", \"serve.json\")\n16: \n17: \tentry, err := AddRegistryEntry(path, \"proj\", root)\n18: \tif err != nil {\n19: \t\tt.Fatalf(\"AddRegistryEntry on missing file: %v\", err)\n20: \t}\n21: \tif entry.Name != \"proj\" || entry.Path != filepath.Clean(root) {\n22: \t\tt.Errorf(\"returned entry = %+v, want {proj %s}\", entry, filepath.Clean(root))\n23: \t}\n24: \n25: \treg, err := LoadRegistry(path)\n26: \tif err != nil {\n27: \t\tt.Fatalf(\"LoadRegistry after add: %v\", err)\n28: \t}\n29: \tif got := reg.Entries(); len(got) != 1 || got[0].Name != \"proj\" || got[0].Path != filepath.Clean(root) {\n30: \t\tt.Errorf(\"Entries() = %+v, want the added entry\", got)\n31: \t}\n32: }\n33: \n34: // TestAddRegistryEntryAppendsInOrder: a second add keeps the first entry and\n35: // the file order (append, never prepend or reorder).\n36: func TestAddRegistryEntryAppendsInOrder(t *testing.T) {\n37: \ta := t.TempDir()\n38: \tb := t.TempDir()\n39: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n40: \twriteRegistry(t, path, namedProjectsJSON([2]string{\"first\", a}))\n41: \n42: \tif _, err := AddRegistryEntry(path, \"second\", b); err != nil {\n43: \t\tt.Fatalf(\"AddRegistryEntry: %v\", err)\n44: \t}\n45: \treg, err := LoadRegistry(path)\n46: \tif err != nil {\n47: \t\tt.Fatalf(\"LoadRegistry after add: %v\", err)\n48: \t}\n49: \tnames := []string{reg.Entries()[0].Name, reg.Entries()[1].Name}\n50: \tif names[0] != \"first\" || names[1] != \"second\" {\n51: \t\tt.Errorf(\"entry order after add = %v, want [first second]\", names)\n52: \t}\n53: }\n54: \n55: // TestAddRegistryEntryRejectsInvalidNames: the add path enforces the same\n56: // name rule the daemon enforces at startup.\n57: func TestAddRegistryEntryRejectsInvalidNames(t *testing.T) {\n58: \troot := t.TempDir()\n59: \tfor _, bad := range []string{\"\", \"solyto/api\", `solyto\\api`, \".\", \"..\", \"solyto api\", \"sölyto\"} {\n60: \t\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n61: \t\tif _, err := AddRegistryEntry(path, bad, root); err == nil {\n62: \t\t\tt.Errorf(\"AddRegistryEntry with name %q = nil error, want an error\", bad)\n63: \t\t}\n64: \t}\n65: }\n66: \n67: // TestAddRegistryEntryRejectsDuplicateName: a name already registered is an\n68: // error, and the file is left unchanged.\n69: func TestAddRegistryEntryRejectsDuplicateName(t *testing.T) {\n70: \ta := t.TempDir()\n71: \tb := t.TempDir()\n72: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n73: \twriteRegistry(t, path, namedProjectsJSON([2]string{\"dup\", a}))\n74: \n75: \tif _, err := AddRegistryEntry(path, \"dup\", b); err == nil {\n76: \t\tt.Fatal(\"AddRegistryEntry with a duplicate name = nil error, want an error\")\n77: \t}\n78: \treg, err := LoadRegistry(path)\n79: \tif err != nil {\n80: \t\tt.Fatalf(\"LoadRegistry after the refused add: %v\", err)\n81: \t}\n82: \tif got := reg.Entries(); len(got) != 1 {\n83: \t\tt.Errorf(\"Entries() after the refused add = %+v, want the original single entry\", got)\n84: \t}\n85: }\n86: \n87: // TestAddRegistryEntryRejectsDuplicatePath: a path already registered under\n88: // another name is an error — including when spelled differently (relative vs\n89: // absolute), since entries are compared on the resolved absolute path.\n90: func TestAddRegistryEntryRejectsDuplicatePath(t *testing.T) {\n91: \troot := t.TempDir()\n92: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n93: \twriteRegistry(t, path, namedProjectsJSON([2]string{\"name-a\", root}))\n94: \n95: \t// Same path, different name, absolute spelling.\n96: \tif _, err := AddRegistryEntry(path, \"name-b\", root); err == nil {\n97: \t\tt.Fatal(\"AddRegistryEntry with a duplicate path = nil error, want an error\")\n98: \t}\n99: \t// Same path via a relative spelling (relative to root's parent).\n100: \tcwd, err := os.Getwd()\n101: \tif err != nil {\n102: \t\tt.Fatal(err)\n103: \t}\n104: \tif err := os.Chdir(filepath.Dir(root)); err != nil {\n105: \t\tt.Fatal(err)\n106: \t}\n107: \tdefer func() { os.Chdir(cwd) }()\n108: \tif _, err := AddRegistryEntry(path, \"name-c\", \".\"+string(filepath.Separator)+filepath.Base(root)); err == nil {\n109: \t\tt.Fatal(\"AddRegistryEntry with a relative spelling of a registered path = nil error, want an error\")\n110: \t}\n111: }\n112: \n113: // TestAddRegistryEntryRejectsMissingRootAndNonDirectory: the root being\n114: // registered must be an existing directory — a missing path and a file are\n115: // both errors, with the daemon's wording.\n116: func TestAddRegistryEntryRejectsMissingRootAndNonDirectory(t *testing.T) {\n117: \tfile := filepath.Join(t.TempDir(), \"some-file\")\n118: \tif err := os.WriteFile(file, []byte(\"x\"), 0o644); err != nil {\n119: \t\tt.Fatal(err)\n120: \t}\n121: \tmissing := filepath.Join(t.TempDir(), \"does-not-exist\")\n122: \n123: \tfor _, bad := range []string{file, missing} {\n124: \t\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n125: \t\t_, err := AddRegistryEntry(path, \"proj\", bad)\n126: \t\tif err == nil {\n127: \t\t\tt.Errorf(\"AddRegistryEntry with root %q = nil error, want an error\", bad)\n128: \t\t\tcontinue\n129: \t\t}\n130: \t\tif !strings.Contains(err.Error(), \"is not an existing directory\") && !strings.Contains(err.Error(), \"is not a directory\") {\n131: \t\t\tt.Errorf(\"error for root %q = %v, want the not-a-directory wording\", bad, err)\n132: \t\t}\n133: \t}\n134: }\n135: \n136: // TestAddRegistryEntryRefusesCorruptRegistry: a present-but-garbage config is\n137: // an error (the LoadRegistry reuse), and the file is never touched.\n138: func TestAddRegistryEntryRefusesCorruptRegistry(t *testing.T) {\n139: \troot := t.TempDir()\n140: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n141: \twriteRegistry(t, path, `{not json`)\n142: \n143: \tif _, err := AddRegistryEntry(path, \"proj\", root); err == nil {\n144: \t\tt.Fatal(\"AddRegistryEntry on a corrupt registry = nil error, want an error\")\n145: \t}\n146: \tdata, err := os.ReadFile(path)\n147: \tif err != nil {\n148: \t\tt.Fatal(err)\n149: \t}\n150: \tif string(data) != `{not json` {\n151: \t\tt.Errorf(\"registry after the refused add = %q, want it untouched\", data)\n152: \t}\n153: }\n154: \n155: // TestRemoveRegistryEntryRemovesByName: rm keeps the other entries in order\n156: // and the daemon still loads the file afterwards.\n157: func TestRemoveRegistryEntryRemovesByName(t *testing.T) {\n158: \ta := t.TempDir()\n159: \tb := t.TempDir()\n160: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n161: \twriteRegistry(t, path, namedProjectsJSON([2]string{\"proj-a\", a}, [2]string{\"proj-b\", b}))\n162: \n163: \tremoved, err := RemoveRegistryEntry(path, \"proj-a\")\n164: \tif err != nil {\n165: \t\tt.Fatalf(\"RemoveRegistryEntry: %v\", err)\n166: \t}\n167: \tif removed.Name != \"proj-a\" || removed.Path != filepath.Clean(a) {\n168: \t\tt.Errorf(\"removed entry = %+v, want {proj-a %s}\", removed, filepath.Clean(a))\n169: \t}\n170: \n171: \treg, err := LoadRegistry(path)\n172: \tif err != nil {\n173: \t\tt.Fatalf(\"LoadRegistry after remove: %v\", err)\n174: \t}\n175: \tgot := reg.Entries()\n176: \tif len(got) != 1 || got[0].Name != \"proj-b\" {\n177: \t\tt.Errorf(\"Entries() after remove = %+v, want only proj-b\", got)\n178: \t}\n179: }\n180: \n181: // TestRemoveRegistryEntryToEmptyWritesEmptyList: removing the last entry\n182: // keeps the file on disk with an empty projects list (never `null`, never a\n183: // deleted file) — the missing-file and empty-list shapes must both stay\n184: // daemon-loadable, and `null` would be a hand-hostile shape.\n185: func TestRemoveRegistryEntryToEmptyWritesEmptyList(t *testing.T) {\n186: \ta := t.TempDir()\n187: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n188: \twriteRegistry(t, path, namedProjectsJSON([2]string{\"only\", a}))\n189: \n190: \tif _, err := RemoveRegistryEntry(path, \"only\"); err != nil {\n191: \t\tt.Fatalf(\"RemoveRegistryEntry: %v\", err)\n192: \t}\n193: \tdata, err := os.ReadFile(path)\n194: \tif err != nil {\n195: \t\tt.Fatalf(\"registry file after removing the last entry: %v (want it kept)\", err)\n196: \t}\n197: \tif strings.Contains(string(data), \"null\") {\n198: \t\tt.Errorf(\"registry after removing the last entry = %q, want an empty list (never null)\", data)\n199: \t}\n200: \tif reg, err := LoadRegistry(path); err != nil || len(reg.Projects()) != 0 {\n201: \t\tt.Errorf(\"LoadRegistry after removing the last entry = %v, %v; want an empty registry, nil\", reg, err)\n202: \t}\n203: }\n204: \n205: // TestRemoveRegistryEntryUnknownName: removing a name that is not registered\n206: // is an error.\n207: func TestRemoveRegistryEntryUnknownName(t *testing.T) {\n208: \ta := t.TempDir()\n209: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n210: \twriteRegistry(t, path, namedProjectsJSON([2]string{\"proj\", a}))\n211: \n212: \tif _, err := RemoveRegistryEntry(path, \"nope\"); err == nil {\n213: \t\tt.Fatal(\"RemoveRegistryEntry with an unknown name = nil error, want an error\")\n214: \t}\n215: }\n216: \n217: // TestValidProjectName pins the exported wrapper against validProjectName's\n218: // rule (single URL-safe segment, not \".\" or \"..\").\n219: func TestValidProjectName(t *testing.T) {\n220: \tfor _, good := range []string{\"a\", \"My-Project_2\", \"x.y\", \"0\"} {\n221: \t\tif !ValidProjectName(good) {\n222: \t\t\tt.Errorf(\"ValidProjectName(%q) = false, want true\", good)\n223: \t\t}\n224: \t}\n225: \tfor _, bad := range []string{\"\", \".\", \"..\", \"a/b\", `a\\b`, \"a b\", \"a:b\"} {\n226: \t\tif ValidProjectName(bad) {\n227: \t\t\tt.Errorf(\"ValidProjectName(%q) = true, want false\", bad)\n228: \t\t}\n229: \t}\n230: }\n\n(End of file - total 230 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// TestAddRegistryEntryCreatesFile: adding to a registry that does not exist\n// yet (a fresh checkout) creates the file with the one entry, in the\n// daemon-readable shape.\nfunc TestAddRegistryEntryCreatesFile(t *testing.T) {\n\troot := t.TempDir()\n\tpath := filepath.Join(t.TempDir(), \"config\", \"serve.json\")\n\n\tentry, err := AddRegistryEntry(path, \"proj\", root)\n\tif err != nil {\n\t\tt.Fatalf(\"AddRegistryEntry on missing file: %v\", err)\n\t}","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/registry_store_test.go","text":"package serve\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// TestAddRegistryEntryCreatesFile: adding to a registry that does not exist\n// yet (a fresh checkout) creates the file with the one entry, in the\n// daemon-readable shape.\nfunc TestAddRegistryEntryCreatesFile(t *testing.T) {\n\troot := t.TempDir()\n\tpath := filepath.Join(t.TempDir(), \"config\", \"serve.json\")\n\n\tentry, err := AddRegistryEntry(path, \"proj\", root)\n\tif err != nil {\n\t\tt.Fatalf(\"AddRegistryEntry on missing file: %v\", err)\n\t}\n\tif entry.Name != \"proj\" || entry.Path != filepath.Clean(root) {\n\t\tt.Errorf(\"returned entry = %+v, want {proj %s}\", entry, filepath.Clean(root))\n\t}\n\n\treg, err := LoadRegistry(path)\n\tif err != nil {\n\t\tt.Fatalf(\"LoadRegistry after add: %v\", err)\n\t}\n\tif got := reg.Entries(); len(got) != 1 || got[0].Name != \"proj\" || got[0].Path != filepath.Clean(root) {\n\t\tt.Errorf(\"Entries() = %+v, want the added entry\", got)\n\t}\n}\n\n// TestAddRegistryEntryAppendsInOrder: a second add keeps the first entry and\n// the file order (append, never prepend or reorder).\nfunc TestAddRegistryEntryAppendsInOrder(t *testing.T) {\n\ta := t.TempDir()\n\tb := t.TempDir()\n\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\twriteRegistry(t, path, namedProjectsJSON([2]string{\"first\", a}))\n\n\tif _, err := AddRegistryEntry(path, \"second\", b); err != nil {\n\t\tt.Fatalf(\"AddRegistryEntry: %v\", err)\n\t}\n\treg, err := LoadRegistry(path)\n\tif err != nil {\n\t\tt.Fatalf(\"LoadRegistry after add: %v\", err)\n\t}\n\tnames := []string{reg.Entries()[0].Name, reg.Entries()[1].Name}\n\tif names[0] != \"first\" || names[1] != \"second\" {\n\t\tt.Errorf(\"entry order after add = %v, want [first second]\", names)\n\t}\n}\n\n// TestAddRegistryEntryRejectsInvalidNames: the add path enforces the same\n// name rule the daemon enforces at startup.\nfunc TestAddRegistryEntryRejectsInvalidNames(t *testing.T) {\n\troot := t.TempDir()\n\tfor _, bad := range []string{\"\", \"solyto/api\", `solyto\\api`, \".\", \"..\", \"solyto api\", \"sölyto\"} {\n\t\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\t\tif _, err := AddRegistryEntry(path, bad, root); err == nil {\n\t\t\tt.Errorf(\"AddRegistryEntry with name %q = nil error, want an error\", bad)\n\t\t}\n\t}\n}\n\n// TestAddRegistryEntryRejectsDuplicateName: a name already registered is an\n// error, and the file is left unchanged.\nfunc TestAddRegistryEntryRejectsDuplicateName(t *testing.T) {\n\ta := t.TempDir()\n\tb := t.TempDir()\n\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\twriteRegistry(t, path, namedProjectsJSON([2]string{\"dup\", a}))\n\n\tif _, err := AddRegistryEntry(path, \"dup\", b); err == nil {\n\t\tt.Fatal(\"AddRegistryEntry with a duplicate name = nil error, want an error\")\n\t}\n\treg, err := LoadRegistry(path)\n\tif err != nil {\n\t\tt.Fatalf(\"LoadRegistry after the refused add: %v\", err)\n\t}\n\tif got := reg.Entries(); len(got) != 1 {\n\t\tt.Errorf(\"Entries() after the refused add = %+v, want the original single entry\", got)\n\t}\n}\n\n// TestAddRegistryEntryRejectsDuplicatePath: a path already registered under\n// another name is an error — including when spelled differently (relative vs\n// absolute), since entries are compared on the resolved absolute path.\nfunc TestAddRegistryEntryRejectsDuplicatePath(t *testing.T) {\n\troot := t.TempDir()\n\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\twriteRegistry(t, path, namedProjectsJSON([2]string{\"name-a\", root}))\n\n\t// Same path, different name, absolute spelling.\n\tif _, err := AddRegistryEntry(path, \"name-b\", root); err == nil {\n\t\tt.Fatal(\"AddRegistryEntry with a duplicate path = nil error, want an error\")\n\t}\n\t// Same path via a relative spelling (relative to root's parent).\n\tcwd, err := os.Getwd()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.Chdir(filepath.Dir(root)); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer func() { os.Chdir(cwd) }()\n\tif _, err := AddRegistryEntry(path, \"name-c\", \".\"+string(filepath.Separator)+filepath.Base(root)); err == nil {\n\t\tt.Fatal(\"AddRegistryEntry with a relative spelling of a registered path = nil error, want an error\")\n\t}\n}\n\n// TestAddRegistryEntryRejectsMissingRootAndNonDirectory: the root being\n// registered must be an existing directory — a missing path and a file are\n// both errors, with the daemon's wording.\nfunc TestAddRegistryEntryRejectsMissingRootAndNonDirectory(t *testing.T) {\n\tfile := filepath.Join(t.TempDir(), \"some-file\")\n\tif err := os.WriteFile(file, []byte(\"x\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tmissing := filepath.Join(t.TempDir(), \"does-not-exist\")\n\n\tfor _, bad := range []string{file, missing} {\n\t\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\t\t_, err := AddRegistryEntry(path, \"proj\", bad)\n\t\tif err == nil {\n\t\t\tt.Errorf(\"AddRegistryEntry with root %q = nil error, want an error\", bad)\n\t\t\tcontinue\n\t\t}\n\t\tif !strings.Contains(err.Error(), \"is not an existing directory\") && !strings.Contains(err.Error(), \"is not a directory\") {\n\t\t\tt.Errorf(\"error for root %q = %v, want the not-a-directory wording\", bad, err)\n\t\t}\n\t}\n}\n\n// TestAddRegistryEntryRefusesCorruptRegistry: a present-but-garbage config is\n// an error (the LoadRegistry reuse), and the file is never touched.\nfunc TestAddRegistryEntryRefusesCorruptRegistry(t *testing.T) {\n\troot := t.TempDir()\n\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\twriteRegistry(t, path, `{not json`)\n\n\tif _, err := AddRegistryEntry(path, \"proj\", root); err == nil {\n\t\tt.Fatal(\"AddRegistryEntry on a corrupt registry = nil error, want an error\")\n\t}\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif string(data) != `{not json` {\n\t\tt.Errorf(\"registry after the refused add = %q, want it untouched\", data)\n\t}\n}\n\n// TestRemoveRegistryEntryRemovesByName: rm keeps the other entries in order\n// and the daemon still loads the file afterwards.\nfunc TestRemoveRegistryEntryRemovesByName(t *testing.T) {\n\ta := t.TempDir()\n\tb := t.TempDir()\n\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\twriteRegistry(t, path, namedProjectsJSON([2]string{\"proj-a\", a}, [2]string{\"proj-b\", b}))\n\n\tremoved, err := RemoveRegistryEntry(path, \"proj-a\")\n\tif err != nil {\n\t\tt.Fatalf(\"RemoveRegistryEntry: %v\", err)\n\t}\n\tif removed.Name != \"proj-a\" || removed.Path != filepath.Clean(a) {\n\t\tt.Errorf(\"removed entry = %+v, want {proj-a %s}\", removed, filepath.Clean(a))\n\t}\n\n\treg, err := LoadRegistry(path)\n\tif err != nil {\n\t\tt.Fatalf(\"LoadRegistry after remove: %v\", err)\n\t}\n\tgot := reg.Entries()\n\tif len(got) != 1 || got[0].Name != \"proj-b\" {\n\t\tt.Errorf(\"Entries() after remove = %+v, want only proj-b\", got)\n\t}\n}\n\n// TestRemoveRegistryEntryToEmptyWritesEmptyList: removing the last entry\n// keeps the file on disk with an empty projects list (never `null`, never a\n// deleted file) — the missing-file and empty-list shapes must both stay\n// daemon-loadable, and `null` would be a hand-hostile shape.\nfunc TestRemoveRegistryEntryToEmptyWritesEmptyList(t *testing.T) {\n\ta := t.TempDir()\n\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\twriteRegistry(t, path, namedProjectsJSON([2]string{\"only\", a}))\n\n\tif _, err := RemoveRegistryEntry(path, \"only\"); err != nil {\n\t\tt.Fatalf(\"RemoveRegistryEntry: %v\", err)\n\t}\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatalf(\"registry file after removing the last entry: %v (want it kept)\", err)\n\t}\n\tif strings.Contains(string(data), \"null\") {\n\t\tt.Errorf(\"registry after removing the last entry = %q, want an empty list (never null)\", data)\n\t}\n\tif reg, err := LoadRegistry(path); err != nil || len(reg.Projects()) != 0 {\n\t\tt.Errorf(\"LoadRegistry after removing the last entry = %v, %v; want an empty registry, nil\", reg, err)\n\t}\n}\n\n// TestRemoveRegistryEntryUnknownName: removing a name that is not registered\n// is an error.\nfunc TestRemoveRegistryEntryUnknownName(t *testing.T) {\n\ta := t.TempDir()\n\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n\twriteRegistry(t, path, namedProjectsJSON([2]string{\"proj\", a}))\n\n\tif _, err := RemoveRegistryEntry(path, \"nope\"); err == nil {\n\t\tt.Fatal(\"RemoveRegistryEntry with an unknown name = nil error, want an error\")\n\t}\n}\n\n// TestValidProjectName pins the exported wrapper against validProjectName's\n// rule (single URL-safe segment, not \".\" or \"..\").\nfunc TestValidProjectName(t *testing.T) {\n\tfor _, good := range []string{\"a\", \"My-Project_2\", \"x.y\", \"0\"} {\n\t\tif !ValidProjectName(good) {\n\t\t\tt.Errorf(\"ValidProjectName(%q) = false, want true\", good)\n\t\t}\n\t}\n\tfor _, bad := range []string{\"\", \".\", \"..\", \"a/b\", `a\\b`, \"a b\", \"a:b\"} {\n\t\tif ValidProjectName(bad) {\n\t\t\tt.Errorf(\"ValidProjectName(%q) = true, want false\", bad)\n\t\t}\n\t}\n}","lineStart":1,"lineEnd":230,"totalLines":230,"truncated":false}},"title":"src/internal/serve/registry_store_test.go","time":{"start":1787993285865,"end":1787993285877}},"id":"prt_04cb464dc001OkR3B20kPGo1ws","sessionID":"ses_fb34d9020ffe9TT7hHKcNCMGib","messageID":"msg_04cb429d7001EnpsTT9J3LjUYl"}}
