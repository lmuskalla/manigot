{"type":"tool_use","timestamp":1787993914918,"sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","part":{"type":"tool","tool":"read","callID":"call_4338e1f1bd904bc6aa576eca","state":{"status":"completed","input":{"filePath":"/workspace/src/cmd/mg/serve.go"},"output":"<path>/workspace/src/cmd/mg/serve.go</path>\n<type>file</type>\n<content>\n1: // mg serve — the listener: a long-running daemon exposing a control API over a\n2: // registry of project roots, so any surface (a web UI, a native GUI, a future\n3: // CLI) can attach to it as a client — from localhost or from a VPS. This is\n4: // the control-plane sequence described in docs/listener.md: `mg serve` +\n5: // project registry + read-only API + localhost default + audit log +\n6: // serialization skeleton, then the mutating lifecycle endpoints and the live\n7: // session-log SSE stream.\n8: //\n9: // The daemon is additive: the TUI stays in-process, and every existing\n10: // command keeps working untouched. It binds to 127.0.0.1:8080 by default\n11: // (tokenless — the machine's own user is the trust boundary, as it is for the\n12: // CLI today); a non-loopback bind REQUIRES a bearer token (--token or\n13: // $MG_SERVE_TOKEN) or the daemon refuses to start. TLS is the reverse proxy's\n14: // job (Caddy/nginx), never the daemon's.\n15: package main\n16: \n17: import (\n18: \t\"context\"\n19: \t\"errors\"\n20: \t\"flag\"\n21: \t\"fmt\"\n22: \t\"io\"\n23: \t\"net\"\n24: \t\"net/http\"\n25: \t\"os\"\n26: \t\"os/signal\"\n27: \t\"strconv\"\n28: \t\"syscall\"\n29: \t\"time\"\n30: \n31: \t\"github.com/lmuskalla/manigot/internal/config\"\n32: \t\"github.com/lmuskalla/manigot/internal/serve\"\n33: )\n34: \n35: // serveShutdownDrain bounds how long mg serve waits for in-flight requests to\n36: // finish on SIGINT/SIGTERM before giving up — a hung request must never wedge\n37: // the exit.\n38: const serveShutdownDrain = 10 * time.Second\n39: \n40: // runServe implements `mg serve` — the listener daemon. It parses the flags,\n41: // loads the project registry, enforces the bind/auth startup guard, then\n42: // blocks serving until SIGINT/SIGTERM, shutting down gracefully with a\n43: // bounded drain. Returns the process exit code.\n44: func runServe(args []string, stdout, stderr io.Writer) int {\n45: \treturn serveCommand(args, stdout, stderr, nil)\n46: }\n47: \n48: // serveCommand is runServe's testable core: it differs only in the listener\n49: // source. When ln is non-nil it serves on that already-bound listener (tests\n50: // hand over a bound 127.0.0.1:0 listener); when nil it binds one itself from\n51: // the --addr/--port flags. Signal handling and the graceful shutdown path are\n52: // identical in both shapes.\n53: func serveCommand(args []string, stdout, stderr io.Writer, ln net.Listener) int {\n54: \tfs := flag.NewFlagSet(\"mg serve\", flag.ContinueOnError)\n55: \tfs.SetOutput(stderr)\n56: \taddr := fs.String(\"addr\", \"127.0.0.1\", \"bind host (loopback default; a non-loopback bind requires a token)\")\n57: \tport := fs.Int(\"port\", 8080, \"bind port\")\n58: \tregistry := fs.String(\"registry\", \"\", \"path to the project registry config (default <checkout>/config/serve.json)\")\n59: \ttokenFlag := fs.String(\"token\", \"\", \"bearer token required on every request (default $MG_SERVE_TOKEN)\")\n60: \tfs.Usage = func() {\n61: \t\tfmt.Fprintf(stderr, \"mg serve %s\\n\\n\", version)\n62: \t\tfmt.Fprintf(stderr, \"The listener: a long-running daemon exposing a control API\\n\")\n63: \t\tfmt.Fprintf(stderr, \"over a registry of project roots (the basis for the web UI / native GUI\\n\")\n64: \t\tfmt.Fprintf(stderr, \"control-plane sequence).\\n\\n\")\n65: \t\tfmt.Fprintf(stderr, \"Usage:\\n\")\n66: \t\tfmt.Fprintf(stderr, \"  mg serve [flags]\\n\\n\")\n67: \t\tfmt.Fprintf(stderr, \"The registry config file holds the named project roots the daemon serves:\\n\")\n68: \t\tfmt.Fprintf(stderr, \"  {\\\"projects\\\": [{\\\"name\\\": \\\"my-project\\\", \\\"path\\\": \\\"/abs/project/root\\\"}, ...]}\\n\")\n69: \t\tfmt.Fprintf(stderr, \"\\\"name\\\" is the URL segment the project is served under (a single URL-safe\\n\")\n70: \t\tfmt.Fprintf(stderr, \"path segment, unique across the registry); it is required and chosen by you.\\n\")\n71: \t\tfmt.Fprintf(stderr, \"Default location: <manigot checkout>/config/serve.json (override with --registry).\\n\")\n72: \t\tfmt.Fprintf(stderr, \"Changing the registered roots means editing the file and restarting.\\n\\n\")\n73: \t\tfmt.Fprintf(stderr, \"Flags:\\n\")\n74: \t\tfs.PrintDefaults()\n75: \t}\n76: \tif err := fs.Parse(args); err != nil {\n77: \t\treturn 2 // the flag package already printed the error + usage\n78: \t}\n79: \tif fs.NArg() > 0 {\n80: \t\tfmt.Fprintf(stderr, \"Unknown argument: %s\\n\", fs.Arg(0))\n81: \t\treturn 1\n82: \t}\n83: \n84: \t// Token precedence: --token flag, then $MG_SERVE_TOKEN (config.EnvValue —\n85: \t// the .env file first, then the process environment, exactly like every\n86: \t// other credential the daemon reads). A token is never issued, created, or\n87: \t// returned by the API.\n88: \ttoken := *tokenFlag\n89: \tif token == \"\" {\n90: \t\ttoken = config.EnvValue(\"MG_SERVE_TOKEN\")\n91: \t}\n92: \n93: \t// The project registry: an explicit config file of project roots, read\n94: \t// once at startup. No scanning, no auto-adopting.\n95: \tregistryPath := *registry\n96: \tif registryPath == \"\" {\n97: \t\tregistryPath = serve.DefaultRegistryPath()\n98: \t\tif registryPath == \"\" {\n99: \t\t\tcliError(stderr, serve.ErrNoRegistryPath)\n100: \t\t\treturn 1\n101: \t\t}\n102: \t}\n103: \treg, err := serve.LoadRegistry(registryPath)\n104: \tif err != nil {\n105: \t\tcliError(stderr, err)\n106: \t\treturn 1\n107: \t}\n108: \treg.WarnMissingDocs(stderr)\n109: \n110: \t// The startup guard — the hard invariant: a non-loopback bind with no\n111: \t// token refuses to start. Unskippable: there is no flag that turns it off.\n112: \tif err := serve.ValidateStartup(*addr, token); err != nil {\n113: \t\tcliError(stderr, err)\n114: \t\treturn 1\n115: \t}\n116: \n117: \tsrv := serve.New(reg, version, token, stderr)\n118: \n119: \t// Bind (or accept the test-supplied listener) and announce.\n120: \tif ln == nil {\n121: \t\tbindAddr := net.JoinHostPort(*addr, strconv.Itoa(*port))\n122: \t\tln, err = net.Listen(\"tcp\", bindAddr)\n123: \t\tif err != nil {\n124: \t\t\tcliError(stderr, fmt.Errorf(\"mg serve: cannot listen on %s: %v\", bindAddr, err))\n125: \t\t\treturn 1\n126: \t\t}\n127: \t}\n128: \tfmt.Fprintf(stdout, \"mg serve %s — listening on %s\\n\", version, ln.Addr())\n129: \tif token != \"\" {\n130: \t\tfmt.Fprintln(stdout, \"Bearer-token auth enabled — every request must carry Authorization: Bearer <token>.\")\n131: \t\tfmt.Fprintln(stdout, \"TLS is the reverse proxy's job (Caddy/nginx); the daemon always serves plain HTTP.\")\n132: \t} else {\n133: \t\tfmt.Fprintln(stdout, \"No token configured — tokenless mode (safe only on a loopback bind).\")\n134: \t}\n135: \tif len(reg.Projects()) == 0 {\n136: \t\tfmt.Fprintln(stdout, \"Warning: no projects registered — edit the registry config and restart to serve any.\")\n137: \t}\n138: \n139: \t// Serve until SIGINT/SIGTERM, then drain in-flight requests within a\n140: \t// bounded window and exit cleanly.\n141: \tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n142: \tdefer stop()\n143: \n144: \terrCh := make(chan error, 1)\n145: \tgo func() { errCh <- srv.Serve(ln) }()\n146: \n147: \tselect {\n148: \tcase err := <-errCh:\n149: \t\tif err != nil && !errors.Is(err, http.ErrServerClosed) {\n150: \t\t\tcliError(stderr, fmt.Errorf(\"mg serve: %v\", err))\n151: \t\t\treturn 1\n152: \t\t}\n153: \t\treturn 0\n154: \tcase <-ctx.Done():\n155: \t\tdrainCtx, cancel := context.WithTimeout(context.Background(), serveShutdownDrain)\n156: \t\tdefer cancel()\n157: \t\tif err := srv.Shutdown(drainCtx); err != nil {\n158: \t\t\tcliError(stderr, fmt.Errorf(\"mg serve: graceful shutdown: %v\", err))\n159: \t\t\treturn 1\n160: \t\t}\n161: \t\t<-errCh // the serve loop returns http.ErrServerClosed\n162: \t\tfmt.Fprintln(stdout, \"mg serve: shutting down.\")\n163: \t\treturn 0\n164: \t}\n165: }\n\n(End of file - total 165 lines)\n</content>","metadata":{"preview":"// mg serve — the listener: a long-running daemon exposing a control API over a\n// registry of project roots, so any surface (a web UI, a native GUI, a future\n// CLI) can attach to it as a client — from localhost or from a VPS. This is\n// the control-plane sequence described in docs/listener.md: `mg serve` +\n// project registry + read-only API + localhost default + audit log +\n// serialization skeleton, then the mutating lifecycle endpoints and the live\n// session-log SSE stream.\n//\n// The daemon is additive: the TUI stays in-process, and every existing\n// command keeps working untouched. It binds to 127.0.0.1:8080 by default\n// (tokenless — the machine's own user is the trust boundary, as it is for the\n// CLI today); a non-loopback bind REQUIRES a bearer token (--token or\n// $MG_SERVE_TOKEN) or the daemon refuses to start. TLS is the reverse proxy's\n// job (Caddy/nginx), never the daemon's.\npackage main\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"flag\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/cmd/mg/serve.go","text":"// mg serve — the listener: a long-running daemon exposing a control API over a\n// registry of project roots, so any surface (a web UI, a native GUI, a future\n// CLI) can attach to it as a client — from localhost or from a VPS. This is\n// the control-plane sequence described in docs/listener.md: `mg serve` +\n// project registry + read-only API + localhost default + audit log +\n// serialization skeleton, then the mutating lifecycle endpoints and the live\n// session-log SSE stream.\n//\n// The daemon is additive: the TUI stays in-process, and every existing\n// command keeps working untouched. It binds to 127.0.0.1:8080 by default\n// (tokenless — the machine's own user is the trust boundary, as it is for the\n// CLI today); a non-loopback bind REQUIRES a bearer token (--token or\n// $MG_SERVE_TOKEN) or the daemon refuses to start. TLS is the reverse proxy's\n// job (Caddy/nginx), never the daemon's.\npackage main\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"net\"\n\t\"net/http\"\n\t\"os\"\n\t\"os/signal\"\n\t\"strconv\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/serve\"\n)\n\n// serveShutdownDrain bounds how long mg serve waits for in-flight requests to\n// finish on SIGINT/SIGTERM before giving up — a hung request must never wedge\n// the exit.\nconst serveShutdownDrain = 10 * time.Second\n\n// runServe implements `mg serve` — the listener daemon. It parses the flags,\n// loads the project registry, enforces the bind/auth startup guard, then\n// blocks serving until SIGINT/SIGTERM, shutting down gracefully with a\n// bounded drain. Returns the process exit code.\nfunc runServe(args []string, stdout, stderr io.Writer) int {\n\treturn serveCommand(args, stdout, stderr, nil)\n}\n\n// serveCommand is runServe's testable core: it differs only in the listener\n// source. When ln is non-nil it serves on that already-bound listener (tests\n// hand over a bound 127.0.0.1:0 listener); when nil it binds one itself from\n// the --addr/--port flags. Signal handling and the graceful shutdown path are\n// identical in both shapes.\nfunc serveCommand(args []string, stdout, stderr io.Writer, ln net.Listener) int {\n\tfs := flag.NewFlagSet(\"mg serve\", flag.ContinueOnError)\n\tfs.SetOutput(stderr)\n\taddr := fs.String(\"addr\", \"127.0.0.1\", \"bind host (loopback default; a non-loopback bind requires a token)\")\n\tport := fs.Int(\"port\", 8080, \"bind port\")\n\tregistry := fs.String(\"registry\", \"\", \"path to the project registry config (default <checkout>/config/serve.json)\")\n\ttokenFlag := fs.String(\"token\", \"\", \"bearer token required on every request (default $MG_SERVE_TOKEN)\")\n\tfs.Usage = func() {\n\t\tfmt.Fprintf(stderr, \"mg serve %s\\n\\n\", version)\n\t\tfmt.Fprintf(stderr, \"The listener: a long-running daemon exposing a control API\\n\")\n\t\tfmt.Fprintf(stderr, \"over a registry of project roots (the basis for the web UI / native GUI\\n\")\n\t\tfmt.Fprintf(stderr, \"control-plane sequence).\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"Usage:\\n\")\n\t\tfmt.Fprintf(stderr, \"  mg serve [flags]\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"The registry config file holds the named project roots the daemon serves:\\n\")\n\t\tfmt.Fprintf(stderr, \"  {\\\"projects\\\": [{\\\"name\\\": \\\"my-project\\\", \\\"path\\\": \\\"/abs/project/root\\\"}, ...]}\\n\")\n\t\tfmt.Fprintf(stderr, \"\\\"name\\\" is the URL segment the project is served under (a single URL-safe\\n\")\n\t\tfmt.Fprintf(stderr, \"path segment, unique across the registry); it is required and chosen by you.\\n\")\n\t\tfmt.Fprintf(stderr, \"Default location: <manigot checkout>/config/serve.json (override with --registry).\\n\")\n\t\tfmt.Fprintf(stderr, \"Changing the registered roots means editing the file and restarting.\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"Flags:\\n\")\n\t\tfs.PrintDefaults()\n\t}\n\tif err := fs.Parse(args); err != nil {\n\t\treturn 2 // the flag package already printed the error + usage\n\t}\n\tif fs.NArg() > 0 {\n\t\tfmt.Fprintf(stderr, \"Unknown argument: %s\\n\", fs.Arg(0))\n\t\treturn 1\n\t}\n\n\t// Token precedence: --token flag, then $MG_SERVE_TOKEN (config.EnvValue —\n\t// the .env file first, then the process environment, exactly like every\n\t// other credential the daemon reads). A token is never issued, created, or\n\t// returned by the API.\n\ttoken := *tokenFlag\n\tif token == \"\" {\n\t\ttoken = config.EnvValue(\"MG_SERVE_TOKEN\")\n\t}\n\n\t// The project registry: an explicit config file of project roots, read\n\t// once at startup. No scanning, no auto-adopting.\n\tregistryPath := *registry\n\tif registryPath == \"\" {\n\t\tregistryPath = serve.DefaultRegistryPath()\n\t\tif registryPath == \"\" {\n\t\t\tcliError(stderr, serve.ErrNoRegistryPath)\n\t\t\treturn 1\n\t\t}\n\t}\n\treg, err := serve.LoadRegistry(registryPath)\n\tif err != nil {\n\t\tcliError(stderr, err)\n\t\treturn 1\n\t}\n\treg.WarnMissingDocs(stderr)\n\n\t// The startup guard — the hard invariant: a non-loopback bind with no\n\t// token refuses to start. Unskippable: there is no flag that turns it off.\n\tif err := serve.ValidateStartup(*addr, token); err != nil {\n\t\tcliError(stderr, err)\n\t\treturn 1\n\t}\n\n\tsrv := serve.New(reg, version, token, stderr)\n\n\t// Bind (or accept the test-supplied listener) and announce.\n\tif ln == nil {\n\t\tbindAddr := net.JoinHostPort(*addr, strconv.Itoa(*port))\n\t\tln, err = net.Listen(\"tcp\", bindAddr)\n\t\tif err != nil {\n\t\t\tcliError(stderr, fmt.Errorf(\"mg serve: cannot listen on %s: %v\", bindAddr, err))\n\t\t\treturn 1\n\t\t}\n\t}\n\tfmt.Fprintf(stdout, \"mg serve %s — listening on %s\\n\", version, ln.Addr())\n\tif token != \"\" {\n\t\tfmt.Fprintln(stdout, \"Bearer-token auth enabled — every request must carry Authorization: Bearer <token>.\")\n\t\tfmt.Fprintln(stdout, \"TLS is the reverse proxy's job (Caddy/nginx); the daemon always serves plain HTTP.\")\n\t} else {\n\t\tfmt.Fprintln(stdout, \"No token configured — tokenless mode (safe only on a loopback bind).\")\n\t}\n\tif len(reg.Projects()) == 0 {\n\t\tfmt.Fprintln(stdout, \"Warning: no projects registered — edit the registry config and restart to serve any.\")\n\t}\n\n\t// Serve until SIGINT/SIGTERM, then drain in-flight requests within a\n\t// bounded window and exit cleanly.\n\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n\tdefer stop()\n\n\terrCh := make(chan error, 1)\n\tgo func() { errCh <- srv.Serve(ln) }()\n\n\tselect {\n\tcase err := <-errCh:\n\t\tif err != nil && !errors.I