{"type":"tool_use","timestamp":1787994269631,"sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","part":{"type":"tool","tool":"read","callID":"call_9f8358052d6a4f8fb669eb19","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/settings.go"},"output":"<path>/workspace/src/internal/serve/settings.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"fmt\"\n5: \t\"net/http\"\n6: \t\"strings\"\n7: \n8: \t\"github.com/lmuskalla/manigot/internal/config\"\n9: \t\"github.com/lmuskalla/manigot/internal/project\"\n10: )\n11: \n12: // --- GET/PUT /settings — the global default profile (TASK-1) ------------------\n13: //\n14: // The one global setting this API exposes is the default subscription profile\n15: // (the brief's \"set the profile\"). Its storage and its write primitive are\n16: // exactly `mg profiles <name>`'s: MANIGOT_PROFILE in manigot's .env, written\n17: // via config.UpsertEnv — so CLI, TUI, and this API share one default, and a\n18: // profile switch made over HTTP changes what the next bare `mg`, TUI, and\n19: // mg-jdi launch use, with no daemon-side caching to drift.\n20: \n21: // settingsResponse is the GET /settings response: the effective default\n22: // profile id — config.EnvValue(\"MANIGOT_PROFILE\") with the ProfileClaudePro\n23: // fallback, the same \"Active default\" chain `mg profiles` displays. The\n24: // profile id is a plain identifier, never credential material (readiness\n25: // lives in /health as a boolean).\n26: type settingsResponse struct {\n27: \tProfile string `json:\"profile\"`\n28: }\n29: \n30: // settingsRequest is the PUT /settings request body. Profile is required: an\n31: // empty body or an absent field is a 400, not a silent reset to claude-pro —\n32: // the endpoint exists to set the default, and a defaulting write would let a\n33: // caller believe it changed something it did not.\n34: type settingsRequest struct {\n35: \tProfile string `json:\"profile\"`\n36: }\n37: \n38: // handleGetSettings serves the effective default profile. No lock: a pure\n39: // .env read, no project-scoped state.\n40: func (s *Server) handleGetSettings(w http.ResponseWriter, r *http.Request) {\n41: \twriteJSON(w, http.StatusOK, settingsResponse{Profile: activeProfile()})\n42: }\n43: \n44: // activeProfile returns the effective default profile the way `mg profiles`\n45: // reports it: MANIGOT_PROFILE via config.EnvValue (the .env file first, then\n46: // the process environment), falling back to ProfileClaudePro when unset.\n47: func activeProfile() string {\n48: \tif p := strings.TrimSpace(config.EnvValue(\"MANIGOT_PROFILE\")); p != \"\" {\n49: \t\treturn p\n50: \t}\n51: \treturn config.ProfileClaudePro\n52: }\n53: \n54: // handlePutSettings sets the default profile (config.UpsertEnv — the same\n55: // write `mg profiles <name>` makes, so every launch path picks it up). The id\n56: // is validated against config.ProfileByID first: an unknown profile is a 400\n57: // listing nothing about credentials, not a launch failure surfacing later. No\n58: // project lock: this setting is global (manigot's .env), scoped to no\n59: // registered root.\n60: func (s *Server) handlePutSettings(w http.ResponseWriter, r *http.Request) {\n61: \tvar req settingsRequest\n62: \tif !decodeJSONBody(w, r, &req) {\n63: \t\treturn\n64: \t}\n65: \tprofile := strings.TrimSpace(req.Profile)\n66: \tif profile == \"\" {\n67: \t\twriteError(w, http.StatusBadRequest, \"profile is required\")\n68: \t\treturn\n69: \t}\n70: \tif _, known := config.ProfileByID(profile); !known {\n71: \t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"unknown profile %q\", profile))\n72: \t\treturn\n73: \t}\n74: \tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", profile); err != nil {\n75: \t\twriteError(w, http.StatusInternalServerError, err.Error())\n76: \t\treturn\n77: \t}\n78: \twriteJSON(w, http.StatusOK, settingsResponse{Profile: profile})\n79: }\n80: \n81: // --- GET/PUT /projects/{project}/settings (TASK-2) ---------------------------\n82: //\n83: // The per-project settings this API exposes are the brief's baseBranch and\n84: // prefix (jobBranchPrefix). Their storage and writer are exactly the TUI\n85: // settings screen's: .manigot/manigot.json in the target project, read via\n86: // project.Load and written via project.Save — the sanctioned host-side writer\n87: // for the one directory outside docs/ manigot tooling owns.\n88: \n89: // projectSettingsResponse is the project settings response shape. BaseBranch\n90: // is the effective value (project.Settings.BaseBranchValue — \"main\" when\n91: // unset), so a client always gets a usable ref; JobBranchPrefix is the stored\n92: // value, empty meaning no prefix (it has no non-empty default).\n93: type projectSettingsResponse struct {\n94: \tBaseBranch      string `json:\"baseBranch\"`\n95: \tJobBranchPrefix string `json:\"jobBranchPrefix\"`\n96: }\n97: \n98: // projectSettingsResponseFrom builds the response from stored settings.\n99: func projectSettingsResponseFrom(s project.Settings) projectSettingsResponse {\n100: \treturn projectSettingsResponse{\n101: \t\tBaseBranch:      s.BaseBranchValue(),\n102: \t\tJobBranchPrefix: s.JobBranchPrefix,\n103: \t}\n104: }\n105: \n106: // projectSettingsRequest is the PUT request body — a wholesale replacement\n107: // (the PUT files/brief precedent: the whole settings object, not a patch), so\n108: // an absent field clears that setting to its default. Both fields are\n109: // optional; empty means \"unset\" (baseBranch → main fallback, prefix → none).\n110: type projectSettingsRequest struct {\n111: \tBaseBranch      string `json:\"baseBranch\"`\n112: \tJobBranchPrefix string `json:\"jobBranchPrefix\"`\n113: }\n114: \n115: // handleGetProjectSettings serves a project's baseBranch + jobBranchPrefix.\n116: // No lock: a pure read, like every other read endpoint.\n117: func (s *Server) handleGetProjectSettings(w http.ResponseWriter, r *http.Request) {\n118: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n119: \tif !ok {\n120: \t\treturn\n121: \t}\n122: \tsettings, err := project.Load(root)\n123: \tif err != nil {\n124: \t\twriteError(w, http.StatusInternalServerError, \"cannot read project settings\")\n125: \t\treturn\n126: \t}\n127: \twriteJSON(w, http.StatusOK, projectSettingsResponseFrom(settings))\n128: }\n129: \n130: // handlePutProjectSettings replaces a project's baseBranch + jobBranchPrefix\n131: // (project.Save — the same writer the TUI settings screen uses) under the\n132: // project lock: the write itself is a plain file write, but create/done read\n133: // these very settings inside their own locked sections (job.CreateJob's base\n134: // branch, FinishJob's merge target), so serializing keeps a settings change\n135: // from interleaving with a job lifecycle decision mid-flight.\n136: //\n137: // Validation is deliberately this layer's: the TUI form free-accepts these\n138: // fields, but an HTTP caller cannot be shown a form — garbage would surface\n139: // later as opaque git failures (mg job's \"base branch '...' does not exist\",\n140: // or worse, a git argv a ref-shaped string was never meant for). A non-empty\n141: // value must therefore be a sane ref component (validRefComponent); an empty\n142: // value clears the setting to its default.\n143: func (s *Server) handlePutProjectSettings(w http.ResponseWriter, r *http.Request) {\n144: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n145: \tif !ok {\n146: \t\treturn\n147: \t}\n148: \n149: \tvar req projectSettingsRequest\n150: \tif !decodeJSONBody(w, r, &req) {\n151: \t\treturn\n152: \t}\n153: \tbaseBranch := strings.TrimSpace(req.BaseBranch)\n154: \tjobBranchPrefix := strings.TrimSpace(req.JobBranchPrefix)\n155: \tfor _, field := range []struct{ name, value string }{\n156: \t\t{\"baseBranch\", baseBranch},\n157: \t\t{\"jobBranchPrefix\", jobBranchPrefix},\n158: \t} {\n159: \t\tif reason, ok := refComponentProblem(field.value); !ok {\n160: \t\t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"invalid %s %q: %s\", field.name, field.value, reason))\n161: \t\t\treturn\n162: \t\t}\n163: \t}\n164: \n165: \ts.locks.Lock(root)\n166: \tdefer s.locks.Unlock(root)\n167: \n168: \tsettings := project.Settings{\n169: \t\tBaseBranch:      baseBranch,\n170: \t\tJobBranchPrefix: jobBranchPrefix,\n171: \t}\n172: \tif err := project.Save(root, settings); err != nil {\n173: \t\twriteError(w, http.StatusInternalServerError, \"cannot write project settings\")\n174: \t\treturn\n175: \t}\n176: \twriteJSON(w, http.StatusOK, projectSettingsResponseFrom(settings))\n177: }\n178: \n179: // refRefComponentMaxLen bounds a single settings value — far above any real\n180: // ref name (git's own documented ceiling is 255 bytes for a full ref; these\n181: // are components) while refusing an unbounded write.\n182: const refComponentMaxLen = 200\n183: \n184: // refComponentProblem checks value as a git ref *component chain* — the shape\n185: // baseBranch and jobBranchPrefix actually hold: namespaced branch names like\n186: // \"release/1.2\" or prefix chains like \"team/feature\", where '/' separates\n187: // legal components. It enforces git's own ref rules where they matter for\n188: // correctness and safety (a value that reaches internal/git as an argv\n189: // element must never be an option — hence the leading '-' rejection — nor\n190: // contain shell-irrelevant but git-forbidden characters that make every later\n191: // operation fail), without shelling out: no repo is needed (a non-git project\n192: // may still store settings for later), and the check stays deterministic and\n193: // testable. ok=false with a human-readable reason means reject.\n194: //\n195: // Empty is valid (it means \"clear the setting\") — callers decide whether an\n196: // empty value is allowed; this check is about shape.\n197: func refComponentProblem(value string) (reason string, ok bool) {\n198: \tif value == \"\" {\n199: \t\treturn \"\", true\n200: \t}\n201: \tif len(value) > refComponentMaxLen {\n202: \t\treturn \"longer than the 200-character limit\", false\n203: \t}\n204: \tif strings.HasPrefix(value, \"-\") {\n205: \t\treturn \"must not start with '-' (git would parse it as an option)\", false\n206: \t}\n207: \tif strings.HasPrefix(value, \"/\") || strings.HasSuffix(value, \"/\") {\n208: \t\treturn \"must not start or end with '/'\", false\n209: \t}\n210: \tif strings.HasPrefix(value, \".\") || strings.HasSuffix(value, \".\") {\n211: \t\treturn \"must not start or end with '.'\", false\n212: \t}\n213: \tif strings.HasSuffix(value, \".lock\") {\n214: \t\treturn \"must not end with '.lock' (reserved by git)\", false\n215: \t}\n216: \tif strings.Contains(value, \"..\") {\n217: \t\treturn \"must not contain '..'\", false\n218: \t}\n219: \tif strings.Contains(value, \"@{\") || value == \"@\" {\n220: \t\treturn \"must not contain '@{' or be a lone '@'\", false\n221: \t}\n222: \tfor _, bad := range \"~^:?*[\\\\\" {\n223: \t\tif strings.ContainsRune(value, bad) {\n224: \t\t\treturn fmt.Sprintf(\"must not contain %q\", bad), false\n225: \t\t}\n226: \t}\n227: \tfor i := 0; i < len(value); i++ {\n228: \t\tif c := value[i]; c <= 0x20 || c == 0x7f {\n229: \t\t\treturn \"must not contain control characters or spaces\", false\n230: \t\t}\n231: \t}\n232: \treturn \"\", true\n233: }\n\n(End of file - total 233 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"fmt\"\n\t\"net/http\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// --- GET/PUT /settings — the global default profile (TASK-1) ------------------\n//\n// The one global setting this API exposes is the default subscription profile\n// (the brief's \"set the profile\"). Its storage and its write primitive are\n// exactly `mg profiles <name>`'s: MANIGOT_PROFILE in manigot's .env, written\n// via config.UpsertEnv — so CLI, TUI, and this API share one default, and a\n// profile switch made over HTTP changes what the next bare `mg`, TUI, and\n// mg-jdi launch use, with no daemon-side caching to drift.\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/settings.go","text":"package serve\n\nimport (\n\t\"fmt\"\n\t\"net/http\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// --- GET/PUT /settings — the global default profile (TASK-1) ------------------\n//\n// The one global setting this API exposes is the default subscription profile\n// (the brief's \"set the profile\"). Its storage and its write primitive are\n// exactly `mg profiles <name>`'s: MANIGOT_PROFILE in manigot's .env, written\n// via config.UpsertEnv — so CLI, TUI, and this API share one default, and a\n// profile switch made over HTTP changes what the next bare `mg`, TUI, and\n// mg-jdi launch use, with no daemon-side caching to drift.\n\n// settingsResponse is the GET /settings response: the effective default\n// profile id — config.EnvValue(\"MANIGOT_PROFILE\") with the ProfileClaudePro\n// fallback, the same \"Active default\" chain `mg profiles` displays. The\n// profile id is a plain identifier, never credential material (readiness\n// lives in /health as a boolean).\ntype settingsResponse struct {\n\tProfile string `json:\"profile\"`\n}\n\n// settingsRequest is the PUT /settings request body. Profile is required: an\n// empty body or an absent field is a 400, not a silent reset to claude-pro —\n// the endpoint exists to set the default, and a defaulting write would let a\n// caller believe it changed something it did not.\ntype settingsRequest struct {\n\tProfile string `json:\"profile\"`\n}\n\n// handleGetSettings serves the effective default profile. No lock: a pure\n// .env read, no project-scoped state.\nfunc (s *Server) handleGetSettings(w http.ResponseWriter, r *http.Request) {\n\twriteJSON(w, http.StatusOK, settingsResponse{Profile: activeProfile()})\n}\n\n// activeProfile returns the effective default profile the way `mg profiles`\n// reports it: MANIGOT_PROFILE via config.EnvValue (the .env file first, then\n// the process environment), falling back to ProfileClaudePro when unset.\nfunc activeProfile() string {\n\tif p := strings.TrimSpace(config.EnvValue(\"MANIGOT_PROFILE\")); p != \"\" {\n\t\treturn p\n\t}\n\treturn config.ProfileClaudePro\n}\n\n// handlePutSettings sets the default profile (config.UpsertEnv — the same\n// write `mg profiles <name>` makes, so every launch path picks it up). The id\n// is validated against config.ProfileByID first: an unknown profile is a 400\n// listing nothing about credentials, not a launch failure surfacing later. No\n// project lock: this setting is global (manigot's .env), scoped to no\n// registered root.\nfunc (s *Server) handlePutSettings(w http.ResponseWriter, r *http.Request) {\n\tvar req settingsRequest\n\tif !decodeJSONBody(w, r, &req) {\n\t\treturn\n\t}\n\tprofile := strings.TrimSpace(req.Profile)\n\tif profile == \"\" {\n\t\twriteError(w, http.StatusBadRequest, \"profile is required\")\n\t\treturn\n\t}\n\tif _, known := config.ProfileByID(profile); !known {\n\t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"unknown profile %q\", profile))\n\t\treturn\n\t}\n\tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", profile); err != nil {\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, settingsResponse{Profile: profile})\n}\n\n// --- GET/PUT /projects/{project}/settings (TASK-2) ---------------------------\n//\n// The per-project settings this API exposes are the brief's baseBranch and\n// prefix (jobBranchPrefix). Their storage and writer are exactly the TUI\n// settings screen's: .manigot/manigot.json in the target project, read via\n// project.Load and written via project.Save — the sanctioned host-side writer\n// for the one directory outside docs/ manigot tooling owns.\n\n// projectSettingsResponse is the project settings response shape. BaseBranch\n// is the effective value (project.Settings.BaseBranchValue — \"main\" when\n// unset), so a client always gets a usable ref; JobBranchPrefix is the stored\n// value, empty meaning no prefix (it has no non-empty default).\ntype projectSettingsResponse struct {\n\tBaseBranch      string `json:\"baseBranch\"`\n\tJobBranchPrefix string `json:\"jobBranchPrefix\"`\n}\n\n// projectSettingsResponseFrom builds the response from stored settings.\nfunc projectSettingsResponseFrom(s project.Settings) projectSettingsResponse {\n\treturn projectSettingsResponse{\n\t\tBaseBranch:      s.BaseBranchValue(),\n\t\tJobBranchPrefix: s.JobBranchPrefix,\n\t}\n}\n\n// projectSettingsRequest is the PUT request body — a wholesale replacement\n// (the PUT files/brief precedent: the whole settings object, not a patch), so\n// an absent field clears that setting to its default. Both fields are\n// optional; empty means \"unset\" (baseBranch → main fallback, prefix → none).\ntype projectSettingsRequest struct {\n\tBaseBranch      string `json:\"baseBranch\"`\n\tJobBranchPrefix string `json:\"jobBranchPrefix\"`\n}\n\n// handleGetProjectSettings serves a project's baseBranch + jobBranchPrefix.\n// No lock: a pure read, like every other read endpoint.\nfunc (s *Server) handleGetProjectSettings(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tsettings, err := project.Load(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read project settings\")\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, projectSettingsResponseFrom(settings))\n}\n\n// handlePutProjectSettings replaces a project's baseBranch + jobBranchPrefix\n// (project.Save — the same writer the TUI settings screen uses) under the\n// project lock: the write itself is a plain file write, but create/done read\n// these very settings inside their own locked sections (job.CreateJob's base\n// branch, FinishJob's merge target), so serializing keeps a settings change\n// from interleaving with a job lifecycle decision mid-flight.\n//\n// Validation is deliberately this layer's: the TUI form free-accepts these\n// fields, but an HTTP caller cannot be shown a form — garbage would surface\n// later as opaque git failures (mg job's \"base branch '...' does not exist\",\n// or worse, a git argv a ref-shaped string was never meant for). A non-empty\n// value must therefore be a sane ref component (validRefComponent); an empty\n// value clears the setting to its default.\nfunc (s *Server) handlePutProjectSettings(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\tvar req projectSettingsRequest\n\tif !decodeJSONBody(w, r, &req) {\n\t\treturn\n\t}\n\tbaseBranch := strings.TrimSpace(req.BaseBranch)\n\tjobBranchPrefix := strings.TrimSpace(req.JobBranchPrefix)\n\tfor _, field := range []struct{ name, value string }{\n\t\t{\"baseBranch\", baseBranch},\n\t\t{\"jobBranchPrefix\", jobBranchPrefix},\n\t} {\n\t\tif reason, ok := refComponentProblem(field.value); !ok {\n\t\t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"invalid %s %q: %s\", field.name, field.value, reason))\n\t\t\treturn\n\t\t}\n\t}\n\n\ts.locks.Lock(root)\n\tdefer s.locks.Unlock(root)\n\n\tsettings := project.Settings{\n\t\tBaseBranch:      baseBranch,\n\t\tJobBranchPrefix: jobBranchPrefix,\n\t}\n\tif err := project.Save(root, settings); err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot write project settings\")\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, projectSettingsResponseFrom(settings))\n}\n\n// refRefComponentMaxLen bounds a single settings value — far above any real\n// ref name (git's own documented ceiling is 255 bytes for a full ref; these\n// are components) while refusing an unbounded write.\nconst refComponentMaxLen = 200\n\n// refComponentProblem checks value as a git ref *component chain* — the shape\n// baseBranch and jobBranchPrefix actually hold: namespaced branch names like\n// \"release/1.2\" or prefix chains like \"team/feature\", where '/' separates\n// legal components. It enforces git's own ref rules where they matter for\n// correctness and safety (a value that reaches internal/git as an argv\n// element must never be an option — hence the leading '-' rejection — nor\n// contain shell-irrelevant but git-forbidden characters that make every later\n// operation fail), without shelling out: no repo is needed (a non-git project\n// may still store settings for later), and the check stays deterministic and\n// testable. ok=false with a human-readable reason means reject.\n//\n// Empty is valid (it means \"clear the setting\") — callers decide whether an\n// empty value is allowed; this check is about shape.\nfunc refComponentProblem(value string) (reason string, ok bool) {\n\tif value == \"\" {\n\t\treturn \"\", true\n\t}\n\tif len(value) > refComponentMaxLen {\n\t\treturn \"longer than the 200-character limit\", false\n\t}\n\tif strings.HasPrefix(value, \"-\") {\n\t\treturn \"must not start with '-' (git would parse it as an option)\", false\n\t}\n\tif strings.HasPrefix(value, \"/\") || strings.HasSuffix(value, \"/\") {\n\t\treturn \"must not start or end with '/'\", false\n\t}\n\tif strings.HasPrefix(value, \".\") || strings.HasSuffix(value, \".\") {\n\t\treturn \"must not start or end with '.'\", false\n\t}\n\tif strings.HasSuffix(value, \".lock\") {\n\t\treturn \"must not end with '.lock' (reserved by git)\", false\n\t}\n\tif strings.Contains(value, \"..\") {\n\t\treturn \"must not contain '..'\", false\n\t}\n\tif strings.Contains(value, \"@{\") || value == \"@\" {\n\t\treturn \"must not contain '@{' or be a lone '@'\", false\n\t}\n\tfor _, bad := range \"~^:?*[\\\\\" {\n\t\tif strings.ContainsRune(value, bad) {\n\t\t\treturn fmt.Sprintf(\"must not contain %q\", bad), false\n\t\t}\n\t}\n\tfor i := 0; i < len(value); i++ {\n\t\tif c := value[i]; c <= 0x20 || c == 0x7f {\n\t\t\treturn \"must not contain control characters or spaces\", false\n\t\t}\n\t}\n\treturn \"\", true\n}","lineStart":1,"lineEnd":233,"totalLines":233,"truncated":false}},"title":"src/internal/serve/settings.go","time":{"start":1787994269619,"end":1787994269627}},"id":"prt_04cc367af0017Je9eUwSptM9xz","sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","messageID":"msg_04cc339cc001ubLiYTGQVRmTXg"}}
