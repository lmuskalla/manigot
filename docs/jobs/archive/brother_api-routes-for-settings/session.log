{"type":"tool_use","timestamp":1787993749170,"sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","part":{"type":"tool","tool":"read","callID":"call_271dacb909bc4039b2e05cfd","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/mutate_test.go"},"output":"<path>/workspace/src/internal/serve/mutate_test.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"bytes\"\n5: \t\"encoding/json\"\n6: \t\"io\"\n7: \t\"net/http\"\n8: \t\"os\"\n9: \t\"os/exec\"\n10: \t\"path/filepath\"\n11: \t\"strings\"\n12: \t\"testing\"\n13: \t\"time\"\n14: \n15: \t\"github.com/lmuskalla/manigot/internal/job\"\n16: \t\"github.com/lmuskalla/manigot/internal/launch\"\n17: )\n18: \n19: // fixedID forces CreateJob to use the given id — the deterministic-id\n20: // counterpart of internal/job's own test helper, needed here so endpoint tests\n21: // know the exact branch/job name a created job will carry.\n22: func fixedID(id string) func() (string, error) {\n23: \treturn func() (string, error) { return id, nil }\n24: }\n25: \n26: // yesConfirm answers every prompt with yes — the same pre-approved confirm the\n27: // HTTP delete endpoint relies on.\n28: func yesConfirm(prompt string) (bool, error) { return true, nil }\n29: \n30: // gitJobProject creates a real git project (initGitRepo: main + initial\n31: // commit) with a docs/jobs dir, then creates a job with the fixed id \"ab12cd\"\n32: // via job.CreateJob (branch feature/ab12cd_roundtrip-job, real worktree).\n33: // Requires real git on PATH — the caller must t.Setenv(\"PATH\",\n34: // pathWithRealGitOnly(t)) first. Returns the project root and the create\n35: // result.\n36: func gitJobProject(t *testing.T) (root string, res job.CreateResult) {\n37: \tt.Helper()\n38: \troot = initGitRepo(t)\n39: \tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n40: \t\tt.Fatal(err)\n41: \t}\n42: \tvar out bytes.Buffer\n43: \tres, err := job.CreateJob(root, \"Roundtrip Job\", job.CreateOptions{RandomID: fixedID(\"ab12cd\")}, &out)\n44: \tif err != nil {\n45: \t\tt.Fatalf(\"CreateJob: %v\\n%s\", err, out.String())\n46: \t}\n47: \treturn root, res\n48: }\n49: \n50: // --- TASK-3: POST /projects/{project}/jobs -----------------------------------\n51: \n52: // TestHandleCreateJobGitProject: a real git project gets a real branch +\n53: // worktree, reported in the response.\n54: func TestHandleCreateJobGitProject(t *testing.T) {\n55: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n56: \troot := initGitRepo(t)\n57: \tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n58: \t\tt.Fatal(err)\n59: \t}\n60: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n61: \tbase := filepath.Base(root)\n62: \n63: \trec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Add Gallery Block\"}`)\n64: \tif rec.Code != http.StatusCreated {\n65: \t\tt.Fatalf(\"status = %d, want 201 (body %s)\", rec.Code, rec.Body.String())\n66: \t}\n67: \tvar body createJobResponse\n68: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n69: \t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n70: \t}\n71: \tif body.Job.ID == \"\" || body.Job.Name == \"\" {\n72: \t\tt.Errorf(\"job row missing id/name: %+v\", body.Job)\n73: \t}\n74: \tif body.Job.Title != \"Add Gallery Block\" || body.Job.Type != \"feature\" || body.Job.Status != \"open\" {\n75: \t\tt.Errorf(\"job row = %+v, want title/type/status\", body.Job)\n76: \t}\n77: \tif body.Branch == \"\" || !strings.HasPrefix(body.Branch, \"feature/\") {\n78: \t\tt.Errorf(\"branch = %q, want feature/...\", body.Branch)\n79: \t}\n80: \tif body.WorktreePath == \"\" {\n81: \t\tt.Errorf(\"worktreePath empty for a git project\")\n82: \t} else if _, err := os.Stat(body.WorktreePath); err != nil {\n83: \t\tt.Errorf(\"worktreePath %q does not exist: %v\", body.WorktreePath, err)\n84: \t}\n85: \n86: \t// The created job is discoverable through the API.\n87: \trec = get(t, srv, \"/projects/\"+base+\"/jobs\", \"\")\n88: \tvar list struct {\n89: \t\tJobs []jobRow `json:\"jobs\"`\n90: \t}\n91: \tif err := json.Unmarshal(rec.Body.Bytes(), &list); err != nil {\n92: \t\tt.Fatalf(\"list not JSON: %v\", err)\n93: \t}\n94: \tfound := false\n95: \tfor _, j := range list.Jobs {\n96: \t\tif j.Name == body.Job.Name {\n97: \t\t\tfound = true\n98: \t\t}\n99: \t}\n100: \tif !found {\n101: \t\tt.Errorf(\"created job %q not listed after creation:\\n%s\", body.Job.Name, rec.Body.String())\n102: \t}\n103: \n104: \t// Clean up the created worktree + branch.\n105: \tif _, err := job.DeleteJob(root, body.Job.Name, yesConfirm, io.Discard); err != nil {\n106: \t\tt.Errorf(\"cleanup DeleteJob: %v\", err)\n107: \t}\n108: }\n109: \n110: // TestHandleCreateJobNonGitProject: a non-git project takes the plain-directory\n111: // fallback — branch \"(no git)\", no worktree path.\n112: func TestHandleCreateJobNonGitProject(t *testing.T) {\n113: \troot := fakeJobProject(t, \"existing_job\", minimalBrief(\"Existing\", \"ex\", \"open\", \"feature\", \"2026-08-01\"))\n114: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n115: \tbase := filepath.Base(root)\n116: \n117: \trec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Plain Job\"}`)\n118: \tif rec.Code != http.StatusCreated {\n119: \t\tt.Fatalf(\"status = %d, want 201 (body %s)\", rec.Code, rec.Body.String())\n120: \t}\n121: \tvar body createJobResponse\n122: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n123: \t\tt.Fatalf(\"body not JSON: %v\", err)\n124: \t}\n125: \tif body.Branch != \"(no git)\" {\n126: \t\tt.Errorf(\"branch = %q, want (no git)\", body.Branch)\n127: \t}\n128: \tif body.WorktreePath != \"\" {\n129: \t\tt.Errorf(\"worktreePath = %q, want empty for a non-git project\", body.WorktreePath)\n130: \t}\n131: \t// The job directory exists under docs/jobs.\n132: \tif _, err := os.Stat(filepath.Join(root, \"docs\", \"jobs\", body.Job.Name)); err != nil {\n133: \t\tt.Errorf(\"created job dir missing: %v\", err)\n134: \t}\n135: }\n136: \n137: // TestHandleCreateJobValidation: bad type and empty title are clean 400s —\n138: // not CreateJob's own \"Invalid type\" text surfacing as a 500.\n139: func TestHandleCreateJobValidation(t *testing.T) {\n140: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n141: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n142: \tbase := filepath.Base(root)\n143: \n144: \tif rec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"X\",\"type\":\"bogus\"}`); rec.Code != http.StatusBadRequest {\n145: \t\tt.Errorf(\"bad type: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n146: \t}\n147: \tif rec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"type\":\"feature\"}`); rec.Code != http.StatusBadRequest {\n148: \t\tt.Errorf(\"missing title: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n149: \t}\n150: \tif rec := post(t, srv, \"/projects/no-such-project/jobs\", \"\", `{\"title\":\"X\"}`); rec.Code != http.StatusNotFound {\n151: \t\tt.Errorf(\"unknown project: status = %d, want 404\", rec.Code)\n152: \t}\n153: }\n154: \n155: // --- TASK-4: PUT /projects/{project}/jobs/{job}/files/brief ------------------\n156: \n157: // TestHandleEditBriefReplacesAndCommits: a git-project job's brief.md is\n158: // replaced AND committed in the job's own worktree (the sweep commit), so the\n159: // edit never sits as an uncommitted change.\n160: func TestHandleEditBriefReplacesAndCommits(t *testing.T) {\n161: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n162: \troot, res := gitJobProject(t)\n163: \tdefer os.RemoveAll(res.WorktreePath)\n164: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n165: \tbase := filepath.Base(root)\n166: \n167: \tnewBrief := \"# Brief: Edited\\n\\nstatus: open\\ntype: feature\\nid: ab12cd\\n\\n## What\\n\\nChanged.\\n\"\n168: \trec := put(t, srv, \"/projects/\"+base+\"/jobs/ab12cd/files/brief\", \"\", newBrief)\n169: \tif rec.Code != http.StatusOK {\n170: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n171: \t}\n172: \tvar body editBriefResponse\n173: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n174: \t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n175: \t}\n176: \tif body.Status != \"ok\" {\n177: \t\tt.Errorf(\"status field = %q, want ok\", body.Status)\n178: \t}\n179: \n180: \t// The file on disk (in the job's worktree) was replaced.\n181: \tgot, err := os.ReadFile(filepath.Join(res.Job.Dir, \"brief.md\"))\n182: \tif err != nil {\n183: \t\tt.Fatal(err)\n184: \t}\n185: \tif string(got) != newBrief {\n186: \t\tt.Errorf(\"brief.md = %q, want the PUT body\", string(got))\n187: \t}\n188: \n189: \t// The edit was committed in the job's worktree — the sweep commit.\n190: \tlast := gitCmd(t, res.WorktreePath, \"log\", \"-1\", \"--format=%s\")\n191: \tif !strings.Contains(last, \"[ab12cd] chore: commit all\") {\n192: \t\tt.Errorf(\"worktree HEAD = %q, want the [ab12cd] chore: commit all sweep commit\", last)\n193: \t}\n194: }\n195: \n196: // TestHandleEditBriefNonGitProject: on a non-git project the write still\n197: // succeeds; only the commit cannot happen (no worktree to resolve) — reported\n198: // as a warning, not a failure.\n199: func TestHandleEditBriefNonGitProject(t *testing.T) {\n200: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n201: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n202: \tbase := filepath.Base(root)\n203: \n204: \tnewBrief := \"# Brief: Changed\\n\\nstatus: open\\n\"\n205: \trec := put(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/files/brief\", \"\", newBrief)\n206: \tif rec.Code != http.StatusOK {\n207: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n208: \t}\n209: \tgot, err := os.ReadFile(filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\", \"brief.md\"))\n210: \tif err != nil {\n211: \t\tt.Fatal(err)\n212: \t}\n213: \tif string(got) != newBrief {\n214: \t\tt.Errorf(\"brief.md = %q, want the PUT body\", string(got))\n215: \t}\n216: }\n217: \n218: // TestHandleEditBriefValidation: an empty body and an unknown job are clean\n219: // 400/404s.\n220: func TestHandleEditBriefValidation(t *testing.T) {\n221: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n222: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n223: \tbase := filepath.Base(root)\n224: \n225: \tif rec := put(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/files/brief\", \"\", \"\"); rec.Code != http.StatusBadRequest {\n226: \t\tt.Errorf(\"empty body: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n227: \t}\n228: \tif rec := put(t, srv, \"/projects/\"+base+\"/jobs/no-such-job/files/brief\", \"\", \"# Brief: X\\n\"); rec.Code != http.StatusNotFound {\n229: \t\tt.Errorf(\"unknown job: status = %d, want 404\", rec.Code)\n230: \t}\n231: }\n232: \n233: // --- TASK-5: POST /projects/{project}/jobs/{job}/agents/{agent} --------------\n234: \n235: // TestHandleLaunchAgentDetached: a known agent returns 202 immediately (the\n236: // run happens in a background goroutine) and writes a session.log section for\n237: // the job — the caller's only window onto the detached run.\n238: func TestHandleLaunchAgentDetached(t *testing.T) {\n239: \tfakeCheckout(t, map[string]string{\n240: \t\t\"analyst\":  \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n241: \t\t\"reviewer\": \"name: reviewer\\ndescription: Reviews changes.\\n\",\n242: \t})\n243: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n244: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n245: \tbase := filepath.Base(root)\n246: \n247: \trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/agents/analyst\", \"\", \"\")\n248: \tif rec.Code != http.StatusAccepted {\n249: \t\tt.Fatalf(\"status = %d, want 202 (body %s)\", rec.Code, rec.Body.String())\n250: \t}\n251: \tvar body map[string]string\n252: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n253: \t\tt.Fatalf(\"body not JSON: %v\", err)\n254: \t}\n255: \tif body[\"status\"] != \"started\" || body[\"agent\"] != \"analyst\" || body[\"job\"] != \"wood_oak\" {\n256: \t\tt.Errorf(\"body = %v, want status=started agent=analyst job=wood_oak\", body)\n257: \t}\n258: \n259: \t// The detached run opens a session.log section in the job dir (the\n260: \t// goroutine writes its section header immediately, before the invocation\n261: \t// itself runs — which will fail fast in this test env without docker).\n262: \tlogPath := filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\", \"session.log\")\n263: \twaitFor(t, func() bool {\n264: \t\tdata, err := os.ReadFile(logPath)\n265: \t\treturn err == nil && strings.Contains(string(data), \"=== \")\n266: \t}, \"session.log section header\")\n267: }\n268: \n269: // TestHandleLaunchAgentUnknownAndBadProfile: an unknown agent is a fast 404\n270: // (validated against agentlist.Discover before any container spin-up); a bad\n271: // profile is a 400.\n272: func TestHandleLaunchAgentUnknownAndBadProfile(t *testing.T) {\n273: \tfakeCheckout(t, map[string]string{\n274: \t\t\"analyst\": \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n275: \t})\n276: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n277: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n278: \tbase := filepath.Base(root)\n279: \n280: \tif rec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/agents/no-such-agent\", \"\", \"\"); rec.Code != http.StatusNotFound {\n281: \t\tt.Errorf(\"unknown agent: status = %d, want 404 (body %s)\", rec.Code, rec.Body.String())\n282: \t}\n283: \tif rec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/agents/analyst\", \"\", `{\"profile\":\"bogus-profile\"}`); rec.Code != http.StatusBadRequest {\n284: \t\tt.Errorf(\"bad profile: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n285: \t}\n286: }\n287: \n288: // --- TASK-6: POST /projects/{project}/jobs/{job}/jdi -------------------------\n289: \n290: // stubJdiExe points the launch package's executable lookup at a harmless\n291: // command for the duration of a test — launch.Jdi spawns whatever JdiExe\n292: // returns with the mg-jdi argv, and the default (os.Executable()) would be the\n293: // test binary itself, recursively re-running the whole suite. Mirrors\n294: // internal/launch's own stubJdiExe.\n295: func stubJdiExe(t *testing.T, stub string) {\n296: \tt.Helper()\n297: \told := launch.JdiExe\n298: \tlaunch.JdiExe = func() (string, error) { return stub, nil }\n299: \tt.Cleanup(func() { launch.JdiExe = old })\n300: }\n301: \n302: // TestHandleLaunchJDIDetached: launching mg jdi detached returns 202; an\n303: // already-running mg-jdi (per the status sidecar) is a 409.\n304: func TestHandleLaunchJDIDetached(t *testing.T) {\n305: \tstubJdiExe(t, \"/bin/true\") // never spawn the real mg (or the test binary)\n306: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n307: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n308: \tbase := filepath.Base(root)\n309: \n310: \trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/jdi\", \"\", \"\")\n311: \tif rec.Code != http.StatusAccepted {\n312: \t\tt.Fatalf(\"status = %d, want 202 (body %s)\", rec.Code, rec.Body.String())\n313: \t}\n314: \n315: \t// Now mark the job as already running → the next launch is a 409.\n316: \tif err := job.WriteJDIStatus(root, \"wood_oak\", job.JDIRunning, \"reviewer\"); err != nil {\n317: \t\tt.Fatal(err)\n318: \t}\n319: \trec = post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/jdi\", \"\", \"\")\n320: \tif rec.Code != http.StatusConflict {\n321: \t\tt.Errorf(\"already-running launch: status = %d, want 409 (body %s)\", rec.Code, rec.Body.String())\n322: \t}\n323: }\n324: \n325: // --- TASK-7: POST /projects/{project}/jobs/{job}/done ------------------------\n326: \n327: // TestHandleDoneJobVerdictWarningRequiresForce: a job without an approved\n328: // verdict is refused with a 409 echoing the CLI's warning text unless the\n329: // caller passes {\"force\": true}.\n330: func TestHandleDoneJobVerdictWarningRequiresForce(t *testing.T) {\n331: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n332: \troot, res := gitJobProject(t)\n333: \tdefer os.RemoveAll(res.WorktreePath)\n334: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n335: \tbase := filepath.Base(root)\n336: \n337: \trec := post(t, srv, \"/projects/\"+base+\"/jobs/ab12cd/done\", \"\", \"\")\n338: \tif rec.Code != http.StatusConflict {\n339: \t\tt.Fatalf(\"status = %d, want 409 (body %s)\", rec.Code, rec.Body.String())\n340: \t}\n341: \tif !strings.Contains(rec.Body.String(), \"Warning:\") {\n342: \t\tt.Errorf(\"409 body missing the verdict warning: %s\", rec.Body.String())\n343: \t}\n344: \tif !strings.Contains(rec.Body.String(), \"force\") {\n345: \t\tt.Errorf(\"409 body missing the force hint: %s\", rec.Body.String())\n346: \t}\n347: }\n348: \n349: // TestHandleDoneJobForceFinishes: with {\"force\": true} the done endpoint runs\n350: // FinishJob to completion — archive, squash merge, branch delete, worktree\n351: // removal.\n352: func TestHandleDoneJobForceFinishes(t *testing.T) {\n353: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n354: \troot, res := gitJobProject(t)\n355: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n356: \tbase := filepath.Base(root)\n357: \n358: \trec := post(t, srv, \"/projects/\"+base+\"/jobs/ab12cd/done\", \"\", `{\"force\":true}`)\n359: \tif rec.Code != http.StatusOK {\n360: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n361: \t}\n362: \tvar body doneResponse\n363: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n364: \t\tt.Fatalf(\"body not JSON: %v\", err)\n365: \t}\n366: \tif body.JobName != \"ab12cd_roundtrip-job\" || body.Branch != \"feature/ab12cd_roundtrip-job\" || body.BaseBranch != \"main\" {\n367: \t\tt.Errorf(\"doneResponse = %+v\", body)\n368: \t}\n369: \t// Branch deleted, worktree removed, main back on main.\n370: \tif ok, _ := gitExists(root, \"feature/ab12cd_roundtrip-job\"); ok {\n371: \t\tt.Error(\"job branch still exists after done\")\n372: \t}\n373: \tif _, err := os.Stat(res.WorktreePath); !os.IsNotExist(err) {\n374: \t\tt.Errorf(\"job worktree still exists after done\")\n375: \t}\n376: \tif cur := gitCmd(t, root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\"); cur != \"main\" {\n377: \t\tt.Errorf(\"main worktree on %q, want main\", cur)\n378: \t}\n379: }\n380: \n381: // TestHandleDoneJobConflictIsStructured409: a squash-merge conflict under the\n382: // done endpoint returns a structured 409 (ErrSquashMergeConflict) — no\n383: // automatic rollback, no git-solver handoff — leaving the main worktree in its\n384: // conflicted state for an explicit follow-up.\n385: func TestHandleDoneJobConflictIsStructured409(t *testing.T) {\n386: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n387: \troot, res := gitJobProject(t)\n388: \tdefer os.RemoveAll(res.WorktreePath)\n389: \t// Both sides modify docs/jobs/.gitkeep differently → the squash merge\n390: \t// conflicts.\n391: \twriteTestFile(t, filepath.Join(root, \"docs\", \"jobs\", \".gitkeep\"), \"main side\\n\")\n392: \tgitCmd(t, root, \"add\", \"-A\")\n393: \tgitCmd(t, root, \"commit\", \"-q\", \"-m\", \"main side change\")\n394: \twriteTestFile(t, filepath.Join(res.WorktreePath, \"docs\", \"jobs\", \".gitkeep\"), \"job side\\n\")\n395: \tgitCmd(t, res.WorktreePath, \"add\", \"-A\")\n396: \tgitCmd(t, res.WorktreePath, \"commit\", \"-q\", \"-m\", \"job side change\")\n397: \n398: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n399: \tbase := filepath.Base(root)\n400: \trec := post(t, srv, \"/projects/\"+base+\"/jobs/ab12cd/done\", \"\", `{\"force\":true}`)\n401: \tif rec.Code != http.StatusConflict {\n402: \t\tt.Fatalf(\"status = %d, want 409 (body %s)\", rec.Code, rec.Body.String())\n403: \t}\n404: \tif !strings.Contains(rec.Body.String(), \"squash merge conflict\") {\n405: \t\tt.Errorf(\"409 body missing the conflict marker: %s\", rec.Body.String())\n406: \t}\n407: \t// The 409 must state explicitly that the job is already archived-and-\n408: \t// committed in its own worktree (the task's requirement that the response\n409: \t// not imply \"nothing happened\") — a naive retry of done would otherwise\n410: \t// fail confusingly with \"brief.md not found\" once the job dir is archived.\n411: \tif !strings.Contains(rec.Body.String(), \"already archived\") {\n412: \t\tt.Errorf(\"409 body must state the job is already archived: %s\", rec.Body.String())\n413: \t}\n414: \t// The conflict is left in place (no automatic rollback).\n415: \tif u := gitCmd(t, root, \"ls-files\", \"-u\"); u == \"\" {\n416: \t\tt.Errorf(\"no unmerged entries left in place — the done endpoint must not auto-rollback\")\n417: \t}\n418: }\n419: \n420: // --- TASK-8: POST /projects/{project}/jobs/{job}/delete ----------------------\n421: \n422: // TestHandleDeleteJobGitProject: deleting a git-project job removes its\n423: // worktree and branch, reporting the DeleteResult.\n424: func TestHandleDeleteJobGitProject(t *testing.T) {\n425: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n426: \troot, res := gitJobProject(t)\n427: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n428: \tbase := filepath.Base(root)\n429: \n430: \trec := post(t, srv, \"/projects/\"+base+\"/jobs/ab12cd/delete\", \"\", \"\")\n431: \tif rec.Code != http.StatusOK {\n432: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n433: \t}\n434: \tvar body deleteJobResponse\n435: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n436: \t\tt.Fatalf(\"body not JSON: %v\", err)\n437: \t}\n438: \tif body.JobName != \"ab12cd_roundtrip-job\" || body.Branch != \"feature/ab12cd_roundtrip-job\" {\n439: \t\tt.Errorf(\"deleteJobResponse = %+v\", body)\n440: \t}\n441: \tif _, err := os.Stat(res.WorktreePath); !os.IsNotExist(err) {\n442: \t\tt.Errorf(\"worktree still exists after delete\")\n443: \t}\n444: \tif ok, _ := gitExists(root, \"feature/ab12cd_roundtrip-job\"); ok {\n445: \t\tt.Error(\"branch still exists after delete\")\n446: \t}\n447: }\n448: \n449: // TestHandleDeleteJobNonGitProject: deleting a non-git job is a plain\n450: // directory delete.\n451: func TestHandleDeleteJobNonGitProject(t *testing.T) {\n452: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n453: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n454: \tbase := filepath.Base(root)\n455: \n456: \trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/delete\", \"\", \"\")\n457: \tif rec.Code != http.StatusOK {\n458: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n459: \t}\n460: \tvar body deleteJobResponse\n461: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n462: \t\tt.Fatalf(\"body not JSON: %v\", err)\n463: \t}\n464: \tif body.JobName != \"wood_oak\" || body.Dir == \"\" {\n465: \t\tt.Errorf(\"deleteJobResponse = %+v\", body)\n466: \t}\n467: \tif _, err := os.Stat(filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\")); !os.IsNotExist(err) {\n468: \t\tt.Errorf(\"job dir still exists after delete\")\n469: \t}\n470: }\n471: \n472: // TestHandleDeleteJobUnknownJob: unknown job → 404.\n473: func TestHandleDeleteJobUnknownJob(t *testing.T) {\n474: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n475: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n476: \tbase := filepath.Base(root)\n477: \n478: \tif rec := post(t, srv, \"/projects/\"+base+\"/jobs/no-such-job/delete\", \"\", \"\"); rec.Code != http.StatusNotFound {\n479: \t\tt.Errorf(\"status = %d, want 404\", rec.Code)\n480: \t}\n481: }\n482: \n483: // --- TASK-9: POST /projects/{project}/jobs/{job}/push ------------------------\n484: \n485: // TestHandlePushJobNoRemote: pushing with no origin remote is a structured\n486: // error carrying git's own message — never silently swallowed, never a hang.\n487: func TestHandlePushJobNoRemote(t *testing.T) {\n488: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n489: \troot, res := gitJobProject(t)\n490: \tdefer os.RemoveAll(res.WorktreePath)\n491: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n492: \tbase := filepath.Base(root)\n493: \n494: \trec := post(t, srv, \"/projects/\"+base+\"/jobs/ab12cd/push\", \"\", \"\")\n495: \tif rec.Code != http.StatusInternalServerError {\n496: \t\tt.Fatalf(\"status = %d, want 500 (body %s)\", rec.Code, rec.Body.String())\n497: \t}\n498: \tif !strings.Contains(rec.Body.String(), \"origin\") {\n499: \t\tt.Errorf(\"500 body missing git's origin error: %s\", rec.Body.String())\n500: \t}\n501: }\n502: \n503: // TestHandlePushJobWithRemote: with a real (bare) origin remote configured,\n504: // the push succeeds.\n505: func TestHandlePushJobWithRemote(t *testing.T) {\n506: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n507: \troot, res := gitJobProject(t)\n508: \tdefer os.RemoveAll(res.WorktreePath)\n509: \n510: \t// A bare remote the push can reach.\n511: \tbare := t.TempDir()\n512: \trunGitT(t, bare, \"init\", \"-q\", \"--bare\")\n513: \trunGitT(t, root, \"remote\", \"add\", \"origin\", bare)\n514: \n515: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n516: \tbase := filepath.Base(root)\n517: \n518: \trec := post(t, srv, \"/projects/\"+base+\"/jobs/ab12cd/push\", \"\", \"\")\n519: \tif rec.Code != http.StatusOK {\n520: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n521: \t}\n522: \tvar body map[string]string\n523: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n524: \t\tt.Fatalf(\"body not JSON: %v\", err)\n525: \t}\n526: \tif body[\"status\"] != \"pushed\" {\n527: \t\tt.Errorf(\"body = %v, want status=pushed\", body)\n528: \t}\n529: \t// The branch exists on the remote.\n530: \tbranches := gitCmd(t, bare, \"branch\", \"--list\")\n531: \tif !strings.Contains(branches, \"feature/ab12cd_roundtrip-job\") {\n532: \t\tt.Errorf(\"remote branches = %q, want the pushed job branch\", branches)\n533: \t}\n534: }\n535: \n536: // --- TASK-10: POST /prune ----------------------------------------------------\n537: \n538: // TestHandlePruneReportsCounts: /prune mirrors mg prune's reporting. Docker is\n539: // absent in this environment, so the endpoint surfaces the docker error as a\n540: // structured 500 — the meaningful contract here is that the response is a\n541: // JSON envelope, never a silent no-op.\n542: func TestHandlePrune(t *testing.T) {\n543: \tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n544: \trec := post(t, srv, \"/prune\", \"\", \"\")\n545: \t// Docker is not available in the test env → 500 with the docker error.\n546: \tif rec.Code != http.StatusInternalServerError {\n547: \t\tt.Fatalf(\"status = %d, want 500 (docker unavailable) (body %s)\", rec.Code, rec.Body.String())\n548: \t}\n549: \tif !strings.Contains(rec.Body.String(), \"docker\") {\n550: \t\tt.Errorf(\"500 body missing the docker error: %s\", rec.Body.String())\n551: \t}\n552: }\n553: \n554: // --- TASK-11: /projects/{project}/orphans ------------------------------------\n555: \n556: // fakeOrphan creates a leftover worktree dir (a .git file pointing at a\n557: // nonexistent gitdir) under the project's nested .manigot-worktrees parent —\n558: // the shape DiscoverOrphans reports as an orphan.\n559: func fakeOrphan(t *testing.T, root, name string) {\n560: \tt.Helper()\n561: \tdir := filepath.Join(root, \".manigot-worktrees\", name)\n562: \tif err := os.MkdirAll(dir, 0o755); err != nil {\n563: \t\tt.Fatal(err)\n564: \t}\n565: \t// A .git pointer naming a gitdir that no longer exists.\n566: \tif err := os.WriteFile(filepath.Join(dir, \".git\"), []byte(\"gitdir: /nonexistent/\"+name+\"-gitdir\\n\"), 0o644); err != nil {\n567: \t\tt.Fatal(err)\n568: \t}\n569: }\n570: \n571: // TestHandleOrphansListAndDelete: GET lists the project's orphaned worktrees;\n572: // POST /orphans/{name}/delete removes one named orphan.\n573: func TestHandleOrphansListAndDelete(t *testing.T) {\n574: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n575: \tfakeOrphan(t, root, \"abandoned_1\")\n576: \tfakeOrphan(t, root, \"abandoned_2\")\n577: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n578: \tbase := filepath.Base(root)\n579: \n580: \trec := get(t, srv, \"/projects/\"+base+\"/orphans\", \"\")\n581: \tif rec.Code != http.StatusOK {\n582: \t\tt.Fatalf(\"GET orphans: status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n583: \t}\n584: \tvar list orphansResponse\n585: \tif err := json.Unmarshal(rec.Body.Bytes(), &list); err != nil {\n586: \t\tt.Fatalf(\"list not JSON: %v\", err)\n587: \t}\n588: \tif len(list.Orphans) != 2 {\n589: \t\tt.Fatalf(\"orphans = %d, want 2:\\n%s\", len(list.Orphans), rec.Body.String())\n590: \t}\n591: \tif list.Orphans[0].Name != \"abandoned_1\" || list.Orphans[1].Name != \"abandoned_2\" {\n592: \t\tt.Errorf(\"orphan rows = %+v, want sorted by name\", list.Orphans)\n593: \t}\n594: \n595: \t// Delete one named orphan.\n596: \trec = post(t, srv, \"/projects/\"+base+\"/orphans/abandoned_1/delete\", \"\", \"\")\n597: \tif rec.Code != http.StatusOK {\n598: \t\tt.Fatalf(\"delete orphan: status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n599: \t}\n600: \tif _, err := os.Stat(filepath.Join(root, \".manigot-worktrees\", \"abandoned_1\")); !os.IsNotExist(err) {\n601: \t\tt.Errorf(\"orphan dir still exists after delete\")\n602: \t}\n603: \t// The other orphan is untouched.\n604: \tif _, err := os.Stat(filepath.Join(root, \".manigot-worktrees\", \"abandoned_2\")); err != nil {\n605: \t\tt.Errorf(\"unrelated orphan removed: %v\", err)\n606: \t}\n607: \n608: \t// Unknown orphan → 404.\n609: \trec = post(t, srv, \"/projects/\"+base+\"/orphans/no-such-orphan/delete\", \"\", \"\")\n610: \tif rec.Code != http.StatusNotFound {\n611: \t\tt.Errorf(\"unknown orphan: status = %d, want 404 (body %s)\", rec.Code, rec.Body.String())\n612: \t}\n613: }\n614: \n615: // writeTestFile writes a file, failing the test on error.\n616: func writeTestFile(t *testing.T, path, content string) {\n617: \tt.Helper()\n618: \tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n619: \t\tt.Fatal(err)\n620: \t}\n621: }\n622: \n623: // gitCmd runs git -C dir args, failing the test on error, returning trimmed\n624: // stdout.\n625: func gitCmd(t *testing.T, dir string, args ...string) string {\n626: \tt.Helper()\n627: \treturn runGitOut(t, dir, args...)\n628: }\n629: \n630: // runGitOut runs git -C dir args, failing the test on error, returning trimmed\n631: // stdout.\n632: func runGitOut(t *testing.T, dir string, args ...string) string {\n633: \tt.Helper()\n634: \tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n635: \tout, err := cmd.CombinedOutput()\n636: \tif err != nil {\n637: \t\tt.Fatalf(\"git %v in %s: %v\\n%s\", args, dir, err, out)\n638: \t}\n639: \treturn strings.TrimSpace(string(out))\n640: }\n641: \n642: // gitExists reports whether the branch exists in the repo at root.\n643: func gitExists(root, branch string) (bool, error) {\n644: \tout, err := exec.Command(\"git\", \"-C\", root, \"rev-parse\", \"--verify\", \"--quiet\", \"refs/heads/\"+branch).CombinedOutput()\n645: \tif err != nil {\n646: \t\treturn false, nil // ref does not exist\n647: \t}\n648: \t_ = out\n649: \treturn true, nil\n650: }\n651: \n652: // waitFor polls cond until it returns true or the deadline passes.\n653: func waitFor(t *testing.T, cond func() bool, what string) {\n654: \tt.Helper()\n655: \tdeadline := time.Now().Add(5 * time.Second)\n656: \tfor {\n657: \t\tif cond() {\n658: \t\t\treturn\n659: \t\t}\n660: \t\tif time.Now().After(deadline) {\n661: \t\t\tt.Fatalf(\"timed out waiting for %s\", what)\n662: \t\t}\n663: \t\ttime.Sleep(20 * time.Millisecond)\n664: \t}\n665: }\n\n(End of file - total 665 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/launch\"\n)\n\n// fixedID forces CreateJob to use the given id — the deterministic-id\n// counterpart of internal/job's own test helper, needed here so endpoint tests","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/mutate_test.go","text":"package serve\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/launch\"\n)\n\n// fixedID forces CreateJob to use the given id — the deterministic-id\n// counterpart of internal/job's own test helper, needed here so endpoint tests\n// know the exact branch/job name a created job will carry.\nfunc fixedID(id string) func() (string, error) {\n\treturn func() (string, error) { return id, nil }\n}\n\n// yesConfirm answers every prompt with yes — the same pre-approved confirm the\n// HTTP delete endpoint relies on.\nfunc yesConfirm(prompt string) (bool, error) { return true, nil }\n\n// gitJobProject creates a real git project (initGitRepo: main + initial\n// commit) with a docs/jobs dir, then creates a job with the fixed id \"ab12cd\"\n// via job.CreateJob (branch feature/ab12cd_roundtrip-job, real worktree).\n// Requires real git on PATH — the caller must t.Setenv(\"PATH\",\n// pathWithRealGitOnly(t)) first. Returns the project root and the create\n// result.\nfunc gitJobProject(t *testing.T) (root string, res job.CreateResult) {\n\tt.Helper()\n\troot = initGitRepo(t)\n\tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tvar out bytes.Buffer\n\tres, err := job.CreateJob(root, \"Roundtrip Job\", job.CreateOptions{RandomID: fixedID(\"ab12cd\")}, &out)\n\tif err != nil {\n\t\tt.Fatalf(\"CreateJob: %v\\n%s\", err, out.String())\n\t}\n\treturn root, res\n}\n\n// --- TASK-3: POST /projects/{project}/jobs -----------------------------------\n\n// TestHandleCreateJobGitProject: a real git project gets a real branch +\n// worktree, reported in the response.\nfunc TestHandleCreateJobGitProject(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\troot := initGitRepo(t)\n\tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\trec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Add Gallery Block\"}`)\n\tif rec.Code != http.StatusCreated {\n\t\tt.Fatalf(\"status = %d, want 201 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body createJobResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif body.Job.ID == \"\" || body.Job.Name == \"\" {\n\t\tt.Errorf(\"job row missing id/name: %+v\", body.Job)\n\t}\n\tif body.Job.Title != \"Add Gallery Block\" || body.Job.Type != \"feature\" || body.Job.Status != \"open\" {\n\t\tt.Errorf(\"job row = %+v, want title/type/status\", body.Job)\n\t}\n\tif body.Branch == \"\" || !strings.HasPrefix(body.Branch, \"feature/\") {\n\t\tt.Errorf(\"branch = %q, want feature/...\", body.Branch)\n\t}\n\tif body.WorktreePath == \"\" {\n\t\tt.Errorf(\"worktreePath empty for a git project\")\n\t} else if _, err := os.Stat(body.WorktreePath); err != nil {\n\t\tt.Errorf(\"worktreePath %q does not exist: %v\", body.WorktreePath, err)\n\t}\n\n\t// The created job is discoverable through the API.\n\trec = get(t, srv, \"/projects/\"+base+\"/jobs\", \"\")\n\tvar list struct {\n\t\tJobs []jobRow `json:\"jobs\"`\n\t}\n\tif err := json.Unmarshal(rec.Body.Bytes(), &list); err != nil {\n\t\tt.Fatalf(\"list not JSON: %v\", err)\n\t}\n\tfound := false\n\tfor _, j := range list.Jobs {\n\t\tif j.Name == body.Job.Name {\n\t\t\tfound = true\n\t\t}\n\t}\n\tif !found {\n\t\tt.Errorf(\"created job %q not listed after creation:\\n%s\", body.Job.Name, rec.Body.String())\n\t}\n\n\t// Clean up the created worktree + branch.\n\tif _, err := job.DeleteJob(root, body.Job.Name, yesConfirm, io.Discard); err != nil {\n\t\tt.Errorf(\"cleanup DeleteJob: %v\", err)\n\t}\n}\n\n// TestHandleCreateJobNonGitProject: a non-git project takes the plain-directory\n// fallback — branch \"(no git)\", no worktree path.\nfunc TestHandleCreateJobNonGitProject(t *testing.T) {\n\troot := fakeJobProject(t, \"existing_job\", minimalBrief(\"Existing\", \"ex\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\trec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Plain Job\"}`)\n\tif rec.Code != http.StatusCreated {\n\t\tt.Fatalf(\"status = %d, want 201 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body createJobResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif body.Branch != \"(no git)\" {\n\t\tt.Errorf(\"branch = %q, want (no git)\", body.Branch)\n\t}\n\tif body.WorktreePath != \"\" {\n\t\tt.Errorf(\"worktreePath = %q, want empty for a non-git project\", body.WorktreePath)\n\t}\n\t// The job directory exists under docs/jobs.\n\tif _, err := os.Stat(filepath.Join(root, \"docs\", \"jobs\", body.Job.Name)); err != nil {\n\t\tt.Errorf(\"created job dir missing: %v\", err)\n\t}\n}\n\n// TestHandleCreateJobValidation: bad type and empty title are clean 400s —\n// not CreateJob's own \"Invalid type\" text surfacing as a 500.\nfunc TestHandleCreateJobValidation(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tif rec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"X\",\"type\":\"bogus\"}`); rec.Code != http.StatusBadRequest {\n\t\tt.Errorf(\"bad type: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif rec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"type\":\"feature\"}`); rec.Code != http.StatusBadRequest {\n\t\tt.Errorf(\"missing title: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif rec := post(t, srv, \"/projects/no-such-project/jobs\", \"\", `{\"title\":\"X\"}`); rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"unknown project: status = %d, want 404\", rec.Code)\n\t}\n}\n\n// --- TASK-4: PUT /projects/{project}/jobs/{job}/files/brief ------------------\n\n// TestHandleEditBriefReplacesAndCommits: a git-project job's brief.md is\n// replaced AND committed in the job's own worktree (the sweep commit), so the\n// edit never sits as an uncommitted change.\nfunc TestHandleEditBriefReplacesAndCommits(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\troot, res := gitJobProject(t)\n\tdefer os.RemoveAll(res.WorktreePath)\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tnewBrief := \"# Brief: Edited\\n\\nstatus: open\\ntype: feature\\nid: ab12cd\\n\\n## What\\n\\nChanged.\\n\"\n\trec := put(t, srv, \"/projects/\"+base+\"/jobs/ab12cd/files/brief\", \"\", newBrief)\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body editBriefResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif body.Status != \"ok\" {\n\t\tt.Errorf(\"status field = %q, want ok\", body.Status)\n\t}\n\n\t// The file on disk (in the job's worktree) was replaced.\n\tgot, err := os.ReadFile(filepath.Join(res.Job.Dir, \"brief.md\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif string(got) != newBrief {\n\t\tt.Errorf(\"brief.md = %q, want the PUT body\", string(got))\n\t}\n\n\t// The edit was committed in the job's worktree — the sweep commit.\n\tlast := gitCmd(t, res.WorktreePath, \"log\", \"-1\", \"--format=%s\")\n\tif !strings.Contains(last, \"[ab12cd] chore: commit all\") {\n\t\tt.Errorf(\"worktree HEAD = %q, want the [ab12cd] chore: commit all sweep commit\", last)\n\t}\n}\n\n// TestHandleEditBriefNonGitProject: on a non-git project the write still\n// succeeds; only the commit cannot happen (no worktree to resolve) — reported\n// as a warning, not a failure.\nfunc TestHandleEditBriefNonGitProject(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tnewBrief := \"# Brief: Changed\\n\\nstatus: open\\n\"\n\trec := put(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/files/brief\", \"\", newBrief)\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tgot, err := os.ReadFile(filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\", \"brief.md\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif string(got) != newBrief {\n\t\tt.Errorf(\"brief.md = %q, want the PUT body\", string(got))\n\t}\n}\n\n// TestHandleEditBriefValidation: an empty body and an unknown job are clean\n// 400/404s.\nfunc TestHandleEditBriefValidation(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tif rec := put(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/files/brief\", \"\", \"\"); rec.Code != http.StatusBadRequest {\n\t\tt.Errorf(\"empty body: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif rec := put(t, srv, \"/projects/\"+base+\"/jobs/no-such-job/files/brief\", \"\", \"# Brief: X\\n\"); rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"unknown job: status = %d, want 404\", rec.Code)\n\t}\n}\n\n// --- TASK-5: POST /projects/{project}/jobs/{job}/agents/{agent} --------------\n\n// TestHandleLaunchAgentDetached: a known agent returns 202 immediately (the\n// run happens in a background goroutine) and writes a session.log section for\n// the job — the caller's only window onto the detached run.\nfunc TestHandleLaunchAgentDetached(t *testing.T) {\n\tfakeCheckout(t, map[string]string{\n\t\t\"analyst\":  \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n\t\t\"reviewer\": \"name: reviewer\\ndescription: Reviews changes.\\n\",\n\t})\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/agents/analyst\", \"\", \"\")\n\tif rec.Code != http.StatusAccepted {\n\t\tt.Fatalf(\"status = %d, want 202 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body map[string]string\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif body[\"status\"] != \"started\" || body[\"agent\"] != \"analyst\" || body[\"job\"] != \"wood_oak\" {\n\t\tt.Errorf(\"body = %v, want status=started agent=analyst job=wood_oak\", body)\n\t}\n\n\t// The detached run opens a session.log section in the job dir (the\n\t// goroutine writes its section header immediately, before the invocation\n\t// itself runs — which will fail fast in this test env without docker).\n\tlogPath := filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\", \"session.log\")\n\twaitFor(t, func() bool {\n\t\tdata, err := os.ReadFile(logPath)\n\t\treturn err == nil && strings.Contains(string(data), \"=== \")\n\t}, \"session.log section header\")\n}\n\n// TestHandleLaunchAgentUnknownAndBadProfile: an unknown agent is a fast 404\n// (validated against agentlist.Discover before any container spin-up); a bad\n// profile is a 400.\nfunc TestHandleLaunchAgentUnknownAndBadProfile(t *testing.T) {\n\tfakeCheckout(t, map[string]string{\n\t\t\"analyst\": \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n\t})\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tif rec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/agents/no-such-agent\", \"\", \"\"); rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"unknown agent: status = %d, want 404 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif rec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/agents/analyst\", \"\", `{\"profile\":\"bogus-profile\"}`); rec.Code != http.StatusBadRequest {\n\t\tt.Errorf(\"bad profile: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n\t}\n}\n\n// --- TASK-6: POST /projects/{project}/jobs/{job}/jdi -------------------------\n\n// stubJdiExe points the launch package's executable lookup at a harmless\n// command for the duration of a test — launch.Jdi spawns whatever JdiExe\n// returns with the mg-jdi argv, and the default (os.Executable()) would be the\n// test binary itself, recursively re-running the whole suite. Mirrors\n// internal/launch's own stubJdiExe.\nfunc stubJdiExe(t *testing.T, stub string) {\n\tt.Helper()\n\told := launch.JdiExe\n\tlaunch.JdiExe = func() (string, error) { return stub, nil }\n\tt.Cleanup(func() { launch.JdiExe = old })\n}\n\n// TestHandleLaunchJDIDetached: launching mg jdi detached returns 202; an\n// already-running mg-jdi (per the status sidecar) is a 409.\nfunc TestHandleLaunchJDIDetached(t *testing.T) {\n\tstubJdiExe(t, \"/bin/true\") // never spawn the real mg (or the test binary)\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/jdi\", \"\", \"\")\n\tif rec.Code != http.StatusAccepted {\n\t\tt.Fatalf(\"status = %d, want 202 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\n\t// Now mark the job as already running → the next launch is a 409.\n\tif err := job.WriteJDIStatus(root, \"wood_oak\", job.JDIRunning, \"reviewer\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trec = post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/jdi\", \"\", \"\")\n\tif rec.Code != http.StatusConflict {\n\t\tt.Errorf(\"already-running launch: status = %d, want 409 (body %s)\", rec.Code, rec.Body.String())\n\t}\n}\n\n// --- TASK-7: POST /projects/{project}/jobs/{job}/done ------------------------\n\n// TestHandleDoneJobVerdictWarningRequiresForce: a job without an approved\n// verdict is refused with a 409 echoing the CLI's warning text unless the\n// caller passes {\"force\": true}.\nfunc TestHandleDoneJobVerdictWarningRequiresForce(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\troot, res := gitJobProject(t)\n\tdefer os.RemoveAll(res.WorktreePath)\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\trec := post(t, srv, \"/projects/\"+base+\"/jobs/ab12cd/done\", \"\", \"\")\n\tif rec.Code != http.StatusConflict {\n\t\tt.Fatalf(\"status = %d, want 409 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif !strings.Contains(rec.Body.String(), \"Warning:\") {\n\t\tt.Errorf(\"409 body missing the verdict warning: %s\", rec.Body.String())\n\t}\n\tif !strings.Contains(rec.Body.String(), \"force\") {\n\t\tt.Errorf(\"409 body missing the force hint: %s\", rec.Body.String())\n\t}\n}\n\n// TestHandleDoneJobForceFinishes: with {\"force\": true} the done endpoint runs\n// FinishJob to completion — archive, squash merge, branch delete, worktree\n// removal.\nfunc TestHandleDoneJobForceFinishes(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\troot, res := gitJobProject(t)\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\trec := post(t, srv, \"/projects/\"+base+\"/jobs/ab12cd/done\", \"\", `{\"force\":true}`)\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body doneResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif body.JobName != \"ab12cd_roundtrip-job\" || body.Branch != \"feature/ab12cd_roundtrip-job\" || body.BaseBranch != \"main\" {\n\t\tt.Errorf(\"doneResponse = %+v\", body)\n\t}\n\t// Branch deleted, worktree removed, main back on main.\n\tif ok, _ := gitExists(root, \"feature/ab12cd_roundtrip-job\"); ok {\n\t\tt.Error(\"job branch still exists after done\")\n\t}\n\tif _, err := os.Stat(res.WorktreePath); !os.IsNotExist(err) {\n\t\tt.Errorf(\"job worktree still exists after done\")\n\t}\n\tif cur := gitCmd(t, root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\"); cur != \"main\" {\n\t\tt.Errorf(\"main worktree on %q, want main\", cur)\n\t}\n}\n\n// TestHandleDoneJobConflictIsStructured409: a squash-merge conflict under the\n// done endpoint returns a structured 409 (ErrSquashMergeConflict) — no\n// automatic rollback, no git-solver handoff — leaving the main worktree in its\n// conflicted state for an explicit follow-up.\nfunc TestHandleDoneJobConflictIsStructured409(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\troot, res := gitJobProject(t)\n\tdefer os.RemoveAll(res.WorktreePath)\n\t// Both sides modify docs/jobs/.gitkeep differently → the squash merge\n\t// conflicts.\n\twriteTestFile(t, filepath.Join(root, \"docs\", \"jobs\", \".gitkeep\"), \"main side\\n\")\n\tgitCmd(t, root, \"add\", \"-A\")\n\tgitCmd(t, root, \"commit\", \"-q\", \"-m\", \"main side change\")\n\twriteTestFile(t, filepath.Join(res.WorktreePath, \"docs\", \"jobs\", \".gitkeep\"), \"job side\\n\")\n\tgitCmd(t, res.WorktreePath, \"add\", \"-A\")\n\tgitCmd(t, res.WorktreePath, \"commit\", \"-q\", \"-m\", \"job side change\")\n\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\trec := post(t, srv, \"/projects/\"+base+\"/jobs/ab12cd/done\", \"\", `{\"force\":true}`)\n\tif rec.Code != http.StatusConflict {\n\t\tt.Fatalf(\"status = %d, want 409 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif !strings.Contains(rec.Body.String(), \"squash merge conflict\") {\n\t\tt.Errorf(\"409 body missing the conflict marker: %s\", rec.Body.String())\n\t}\n\t// The 409 must state explicitly that the job is already archived-and-\n\t// committed in its own worktree (the task's requirement that the response\n\t// not imply \"nothing happened\") — a naive retry of done would otherwise\n\t// fail confusingly with \"brief.md not found\" once the job dir is archived.\n\tif !strings.Contains(rec.Body.String(), \"already archived\") {\n\t\tt.Errorf(\"409 body must state the job is already archived: %s\", rec.Body.String())\n\t}\n\t// The conflict is left in place (no automatic rollback).\n\tif u := gitCmd(t, root, \"ls-files\", \"-u\"); u == \"\" {\n\t\tt.Errorf(\"no unmerged entries left in place — the done endpoint must not auto-rollback\")\n\t}\n}\n\n// --- TASK-8: POST /projects/{project}/jobs/{job}/delete ----------------------\n\n// TestHandleDeleteJobGitProject: deleting a git-project job removes its\n// worktree and branch, reporting the DeleteResult.\nfunc TestHandleDeleteJobGitProject(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\troot, res := gitJobProject(t)\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\trec := post(t, srv, \"/projects/\"+base+\"/jobs/ab12cd/delete\", \"\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body deleteJobResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif body.JobName != \"ab12cd_roundtrip-job\" || body.Branch != \"feature/ab12cd_roundtrip-job\" {\n\t\tt.Errorf(\"deleteJobResponse = %+v\", body)\n\t}\n\tif _, err := os.Stat(res.WorktreePath); !os.IsNotExist(err) {\n\t\tt.Errorf(\"worktree still exists after delete\")\n\t}\n\tif ok, _ := gitExists(root, \"feature/ab12cd_roundtrip-job\"); ok {\n\t\tt.Error(\"branch still exists after delete\")\n\t}\n}\n\n// TestHandleDeleteJobNonGitProject: deleting a non-git job is a plain\n// directory delete.\nfunc TestHandleDeleteJobNonGitProject(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/delete\", \"\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body deleteJobResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif body.JobName != \"wood_oak\" || body.Dir == \"\" {\n\t\tt.Errorf(\"deleteJobResponse = %+v\", body)\n\t}\n\tif _, err := os.Stat(filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\")); !os.IsNotExist(err) {\n\t\tt.Errorf(\"job dir still exists after delete\")\n\t}\n}\n\n// TestHandleDeleteJobUnknownJob: unknown job → 404.\nfunc TestHandleDeleteJobUnknownJob(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tif rec := post(t, srv, \"/projects/\"+base+\"/jobs/no-such-job/delete\", \"\", \"\"); rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"status = %d, want 404\", rec.Code)\n\t}\n}\n\n// --- TASK-9: POST /projects/{project}/jobs/{job}/push ------------------------\n\n// TestHandlePushJobNoRemote: pushing with no origin remote is a structured\n// error carrying git's own message — never silently swallowed, never a hang.\nfunc TestHandlePushJobNoRemote(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\troot, res := gitJobProject(t)\n\tdefer os.RemoveAll(res.WorktreePath)\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\trec := post(t, srv, \"/projects/\"+base+\"/jobs/ab12cd/push\", \"\", \"\")\n\tif rec.Code != http.StatusInternalServerError {\n\t\tt.Fatalf(\"status = %d, want 500 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif !strings.Contains(rec.Body.String(), \"origin\") {\n\t\tt.Errorf(\"500 body missing git's origin error: %s\", rec.Body.String())\n\t}\n}\n\n// TestHandlePushJobWithRemote: with a real (bare) origin remote configured,\n// the push succeeds.\nfunc TestHandlePushJobWithRemote(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\troot, res := gitJobProject(t)\n\tdefer os.RemoveAll(res.WorktreePath)\n\n\t// A bare remote the push can reach.\n\tbare := t.TempDir()\n\trunGitT(t, bare, \"init\", \"-q\", \"--bare\")\n\trunGitT(t, root, \"remote\", \"add\", \"origin\", bare)\n\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\trec := post(t, srv, \"/projects/\"+base+\"/jobs/ab12cd/push\", \"\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body map[string]string\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif body[\"status\"] != \"pushed\" {\n\t\tt.Errorf(\"body = %v, want status=pushed\", body)\n\t}\n\t// The branch exists on the remote.\n\tbranches := gitCmd(t, bare, \"branch\", \"--list\")\n\tif !strings.Contains(branches, \"feature/ab12cd_roundtrip-job\") {\n\t\tt.Errorf(\"remote branches = %q, want the pushed job branch\", branches)\n\t}\n}\n\n// --- TASK-10: POST /prune ----------------------------------------------------\n\n// TestHandlePruneReportsCounts: /prune mirrors mg prune's reporting. Docker is\n// absent in this environment, so the endpoint surfaces the docker error as a\n// structured 500 — the meaningful contract here is that the response is a\n// JSON envelope, never a silent no-op.\nfunc TestHandlePrune(t *testing.T) {\n\tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n\trec := post(t, srv, \"/prune\", \"\", \"\")\n\t// Docker is not available in the test env → 500 with the docker error.\n\tif rec.Code != http.StatusInternalServerError {\n\t\tt.Fatalf(\"status = %d, want 500 (docker unavailable) (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif !strings.Contains(rec.Body.String(), \"docker\") {\n\t\tt.Errorf(\"500 body missing the docker error: %s\", rec.Body.String())\n\t}\n}\n\n// --- TASK-11: /projects/{project}/orphans ------------------------------------\n\n// fakeOrphan creates a leftover worktree dir (a .git file pointing at a\n// nonexistent gitdir) under the project's nested .manigot-worktrees parent —\n// the shape DiscoverOrphans reports as an orphan.\nfunc fakeOrphan(t *testing.T, root, name string) {\n\tt.Helper()\n\tdir := filepath.Join(root, \".manigot-worktrees\", name)\n\tif err := os.MkdirAll(dir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// A .git pointer naming a gitdir that no longer exists.\n\tif err := os.WriteFile(filepath.Join(dir, \".git\"), []byte(\"gitdir: /nonexistent/\"+name+\"-gitdir\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\n// TestHandleOrphansListAndDelete: GET lists the project's orphaned worktrees;\n// POST /orphans/{name}/delete removes one named orphan.\nfunc TestHandleOrphansListAndDelete(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tfakeOrphan(t, root, \"abandoned_1\")\n\tfakeOrphan(t, root, \"abandoned_2\")\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\trec := get(t, srv, \"/projects/\"+base+\"/orphans\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"GET orphans: status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar list orphansResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &list); err != nil {\n\t\tt.Fatalf(\"list not JSON: %v\", err)\n\t}\n\tif len(list.Orphans) != 2 {\n\t\tt.Fatalf(\"orphans = %d, want 2:\\n%s\", len(list.Orphans), rec.Body.String())\n\t}\n\tif list.Orphans[0].Name != \"abandoned_1\" || list.Orphans[1].Name != \"abandoned_2\" {\n\t\tt.Errorf(\"orphan rows = %+v, want sorted by name\", list.Orphans)\n\t}\n\n\t// Delete one named orphan.\n\trec = post(t, srv, \"/projects/\"+base+\"/orphans/abandoned_1/delete\", \"\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"delete orphan: status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif _, err := os.Stat(filepath.Join(root, \".manigot-worktrees\", \"abandoned_1\")); !os.IsNotExist(err) {\n\t\tt.Errorf(\"orphan dir still exists after delete\")\n\t}\n\t// The other orphan is untouched.\n\tif _, err := os.Stat(filepath.Join(root, \".manigot-worktrees\", \"abandoned_2\")); err != nil {\n\t\tt.Errorf(\"unrelated orphan removed: %v\", err)\n\t}\n\n\t// Unknown orphan → 404.\n\trec = post(t, srv, \"/projects/\"+base+\"/orphans/no-such-orphan/delete\", \"\", \"\")\n\tif rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"unknown orphan: status = %d, want 404 (body %s)\", rec.Code, rec.Body.String())\n\t}\n}\n\n// writeTestFile writes a file, failing the test on error.\nfunc writeTestFile(t *testing.T, path, content string) {\n\tt.Helper()\n\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\n// gitCmd runs git -C dir args, failing the test on error, returning trimmed\n// stdout.\nfunc gitCmd(t *testing.T, dir string, args ...string) string {\n\tt.Helper()\n\treturn runGitOut(t, dir, args...)\n}\n\n// runGitOut runs git -C dir args, failing the test on error, returning trimmed\n// stdout.\nfunc runGitOut(t *testing.T, dir string, args ...string) string {\n\tt.Helper()\n\tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n\tout, err := cmd.CombinedOutput()\n\tif err != nil {\n\t\tt.Fatalf(\"git %v in %s: %v\\n%s\", args, dir, err, out)\n\t}\n\treturn strings.TrimSpace(string(out))\n}\n\n// gitExists reports whether the branch exists in the repo at root.\nfunc gitExists(root, branch string) (bool, error) {\n\tout, err := exec.Command(\"git\", \"-C\", root, \"rev-parse\", \"--verify\", \"--quiet\", \"refs/heads/\"+branch).CombinedOutput()\n\tif err != nil {\n\t\treturn false, nil // ref does not exist\n\t}\n\t_ = out\n\treturn true, nil\n}\n\n// waitFor polls cond until it returns true or the deadline passes.\nfunc waitFor(t *testing.T, cond func() bool, what string) {\n\tt.Helper()\n\tdeadline := time.Now().Add(5 * time.Second)\n\tfor {\n\t\tif cond() {\n\t\t\treturn\n\t\t}\n\t\tif time.Now().After(deadline) {\n\t\t\tt.Fatalf(\"timed out waiting for %s\", what)\n\t\t}\n\t\ttime.Sleep(20 * time.Millisecond)\n\t}\n}","lineStart":1,"lineEnd":665,"totalLines":665,"truncated":false}},"title":"src/internal/serve/mutate_test.go","time":{"start":1787993749159,"end":1787993749165}},"id":"prt_04cbb76a4001DfSMHvasbpyJyk","sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","messageID":"msg_04cbb6554001W6HRmWS137tE85"}}
