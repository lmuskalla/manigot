{"type":"tool_use","timestamp":1787993698148,"sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","part":{"type":"tool","tool":"read","callID":"call_d91766ba1efd4fb3a6645384","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/server.go"},"output":"<path>/workspace/src/internal/serve/server.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"context\"\n5: \t\"io\"\n6: \t\"net\"\n7: \t\"net/http\"\n8: \t\"time\"\n9: )\n10: \n11: // Server is the manigot listener daemon: a long-running HTTP server exposing\n12: // the control API (projects, jobs, job files, jdi status + logs, diff,\n13: // agents, health — read-only; plus job two's mutating endpoints and the\n14: // session-log SSE stream) over the registered projects. Mutating handlers\n15: // serialize per project via locks (see locks.go's own doc for which\n16: // operations take it and why).\n17: type Server struct {\n18: \treg     *Registry\n19: \tversion string\n20: \ttoken   string\n21: \taudit   io.Writer\n22: \thttp    *http.Server\n23: \tlocks   *ProjectLocks\n24: \n25: \t// shutdownCtx/shutdownCancel let a long-lived handler (the session-log SSE\n26: \t// stream, see stream.go) notice a graceful Shutdown even though\n27: \t// http.Server.Shutdown itself only stops accepting new connections and\n28: \t// waits for in-flight handlers to return — it does not interrupt a\n29: \t// handler stuck in its own poll loop. Shutdown cancels shutdownCtx before\n30: \t// calling s.http.Shutdown, so every streaming handler selecting on it\n31: \t// unblocks and returns promptly instead of forcing the drain to wait out\n32: \t// its full timeout.\n33: \tshutdownCtx    context.Context\n34: \tshutdownCancel context.CancelFunc\n35: }\n36: \n37: // New builds the server: the route table, the middleware chain (auth, then\n38: // audit — audit outermost so it sees every request including 401s), and the\n39: // http.Server wrapper. version is the mg version passed in from main (the\n40: // health endpoint reports it; internal/serve cannot import package main).\n41: // token is the bearer token (\"\" = tokenless localhost mode). audit is the\n42: // request-log destination (mg serve passes stderr).\n43: func New(reg *Registry, version, token string, audit io.Writer) *Server {\n44: \tshutdownCtx, shutdownCancel := context.WithCancel(context.Background())\n45: \ts := &Server{\n46: \t\treg:            reg,\n47: \t\tversion:        version,\n48: \t\ttoken:          token,\n49: \t\taudit:          audit,\n50: \t\tlocks:          NewProjectLocks(),\n51: \t\tshutdownCtx:    shutdownCtx,\n52: \t\tshutdownCancel: shutdownCancel,\n53: \t}\n54: \tmux := http.NewServeMux()\n55: \ts.routes(mux)\n56: \tvar h http.Handler = mux\n57: \th = s.tokenMiddleware(h)\n58: \th = s.auditMiddleware(h)\n59: \ts.http = &http.Server{\n60: \t\tHandler:           h,\n61: \t\tReadHeaderTimeout: 10 * time.Second,\n62: \t}\n63: \treturn s\n64: }\n65: \n66: // routes registers every v1+v2 endpoint. The resolution helpers (see api.go)\n67: // are the only way any handler obtains a root, job or file path — the\n68: // zero-path-inputs choke point. Mutating routes and their ProjectLocks\n69: // boundary are documented at each handler; see locks.go for the summary.\n70: func (s *Server) routes(mux *http.ServeMux) {\n71: \t// Read-only (job one).\n72: \tmux.HandleFunc(\"GET /health\", s.handleHealth)\n73: \tmux.HandleFunc(\"GET /projects\", s.handleProjects)\n74: \tmux.HandleFunc(\"GET /projects/{project}/jobs\", s.handleProjectJobs)\n75: \tmux.HandleFunc(\"GET /projects/{project}/jobs/{job}/files/{file}\", s.handleJobFile)\n76: \tmux.HandleFunc(\"GET /projects/{project}/jobs/{job}/jdi\", s.handleJobJDI)\n77: \tmux.HandleFunc(\"GET /projects/{project}/jobs/{job}/diff\", s.handleJobDiff)\n78: \tmux.HandleFunc(\"GET /projects/{project}/agents\", s.handleProjectAgents)\n79: \n80: \t// Mutating (job two).\n81: \tmux.HandleFunc(\"POST /projects/{project}/jobs\", s.handleCreateJob)\n82: \tmux.HandleFunc(\"PUT /projects/{project}/jobs/{job}/files/brief\", s.handleEditBrief)\n83: \tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/agents/{agent}\", s.handleLaunchAgent)\n84: \tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/jdi\", s.handleLaunchJDI)\n85: \tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/done\", s.handleDoneJob)\n86: \tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/delete\", s.handleDeleteJob)\n87: \tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/push\", s.handlePushJob)\n88: \tmux.HandleFunc(\"POST /prune\", s.handlePrune)\n89: \tmux.HandleFunc(\"GET /projects/{project}/orphans\", s.handleProjectOrphans)\n90: \tmux.HandleFunc(\"POST /projects/{project}/orphans/{name}/delete\", s.handleDeleteOrphan)\n91: \n92: \t// Live run supervision (job two).\n93: \tmux.HandleFunc(\"GET /projects/{project}/jobs/{job}/session-log/stream\", s.handleSessionLogStream)\n94: }\n95: \n96: // Handler returns the fully-wrapped http.Handler — the httptest-able seam for\n97: // endpoint tests (httptest.NewServer(srv.Handler())).\n98: func (s *Server) Handler() http.Handler { return s.http.Handler }\n99: \n100: // Serve serves on ln until Shutdown or a fatal error — the httptest-able\n101: // seam for the serve loop (mg serve calls this on its bound listener; tests\n102: // hand over a bound 127.0.0.1:0 listener).\n103: func (s *Server) Serve(ln net.Listener) error { return s.http.Serve(ln) }\n104: \n105: // Shutdown gracefully drains in-flight requests and closes the listener. The\n106: // caller bounds the wait with the context (mg serve uses a bounded drain so a\n107: // hung request cannot wedge the exit). shutdownCtx is cancelled first, so any\n108: // long-lived streaming handler (see stream.go) unblocks its own poll loop and\n109: // returns immediately rather than forcing the drain to wait out its full\n110: // timeout.\n111: func (s *Server) Shutdown(ctx context.Context) error {\n112: \ts.shutdownCancel()\n113: \treturn s.http.Shutdown(ctx)\n114: }\n\n(End of file - total 114 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"context\"\n\t\"io\"\n\t\"net\"\n\t\"net/http\"\n\t\"time\"\n)\n\n// Server is the manigot listener daemon: a long-running HTTP server exposing\n// the control API (projects, jobs, job files, jdi status + logs, diff,\n// agents, health — read-only; plus job two's mutating endpoints and the\n// session-log SSE stream) over the registered projects. Mutating handlers\n// serialize per project via locks (see locks.go's own doc for which\n// operations take it and why).\ntype Server struct {\n\treg     *Registry\n\tversion string\n\ttoken   string","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/server.go","text":"package serve\n\nimport (\n\t\"context\"\n\t\"io\"\n\t\"net\"\n\t\"net/http\"\n\t\"time\"\n)\n\n// Server is the manigot listener daemon: a long-running HTTP server exposing\n// the control API (projects, jobs, job files, jdi status + logs, diff,\n// agents, health — read-only; plus job two's mutating endpoints and the\n// session-log SSE stream) over the registered projects. Mutating handlers\n// serialize per project via locks (see locks.go's own doc for which\n// operations take it and why).\ntype Server struct {\n\treg     *Registry\n\tversion string\n\ttoken   string\n\taudit   io.Writer\n\thttp    *http.Server\n\tlocks   *ProjectLocks\n\n\t// shutdownCtx/shutdownCancel let a long-lived handler (the session-log SSE\n\t// stream, see stream.go) notice a graceful Shutdown even though\n\t// http.Server.Shutdown itself only stops accepting new connections and\n\t// waits for in-flight handlers to return — it does not interrupt a\n\t// handler stuck in its own poll loop. Shutdown cancels shutdownCtx before\n\t// calling s.http.Shutdown, so every streaming handler selecting on it\n\t// unblocks and returns promptly instead of forcing the drain to wait out\n\t// its full timeout.\n\tshutdownCtx    context.Context\n\tshutdownCancel context.CancelFunc\n}\n\n// New builds the server: the route table, the middleware chain (auth, then\n// audit — audit outermost so it sees every request including 401s), and the\n// http.Server wrapper. version is the mg version passed in from main (the\n// health endpoint reports it; internal/serve cannot import package main).\n// token is the bearer token (\"\" = tokenless localhost mode). audit is the\n// request-log destination (mg serve passes stderr).\nfunc New(reg *Registry, version, token string, audit io.Writer) *Server {\n\tshutdownCtx, shutdownCancel := context.WithCancel(context.Background())\n\ts := &Server{\n\t\treg:            reg,\n\t\tversion:        version,\n\t\ttoken:          token,\n\t\taudit:          audit,\n\t\tlocks:          NewProjectLocks(),\n\t\tshutdownCtx:    shutdownCtx,\n\t\tshutdownCancel: shutdownCancel,\n\t}\n\tmux := http.NewServeMux()\n\ts.routes(mux)\n\tvar h http.Handler = mux\n\th = s.tokenMiddleware(h)\n\th = s.auditMiddleware(h)\n\ts.http = &http.Server{\n\t\tHandler:           h,\n\t\tReadHeaderTimeout: 10 * time.Second,\n\t}\n\treturn s\n}\n\n// routes registers every v1+v2 endpoint. The resolution helpers (see api.go)\n// are the only way any handler obtains a root, job or file path — the\n// zero-path-inputs choke point. Mutating routes and their ProjectLocks\n// boundary are documented at each handler; see locks.go for the summary.\nfunc (s *Server) routes(mux *http.ServeMux) {\n\t// Read-only (job one).\n\tmux.HandleFunc(\"GET /health\", s.handleHealth)\n\tmux.HandleFunc(\"GET /projects\", s.handleProjects)\n\tmux.HandleFunc(\"GET /projects/{project}/jobs\", s.handleProjectJobs)\n\tmux.HandleFunc(\"GET /projects/{project}/jobs/{job}/files/{file}\", s.handleJobFile)\n\tmux.HandleFunc(\"GET /projects/{project}/jobs/{job}/jdi\", s.handleJobJDI)\n\tmux.HandleFunc(\"GET /projects/{project}/jobs/{job}/diff\", s.handleJobDiff)\n\tmux.HandleFunc(\"GET /projects/{project}/agents\", s.handleProjectAgents)\n\n\t// Mutating (job two).\n\tmux.HandleFunc(\"POST /projects/{project}/jobs\", s.handleCreateJob)\n\tmux.HandleFunc(\"PUT /projects/{project}/jobs/{job}/files/brief\", s.handleEditBrief)\n\tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/agents/{agent}\", s.handleLaunchAgent)\n\tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/jdi\", s.handleLaunchJDI)\n\tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/done\", s.handleDoneJob)\n\tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/delete\", s.handleDeleteJob)\n\tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/push\", s.handlePushJob)\n\tmux.HandleFunc(\"POST /prune\", s.handlePrune)\n\tmux.HandleFunc(\"GET /projects/{project}/orphans\", s.handleProjectOrphans)\n\tmux.HandleFunc(\"POST /projects/{project}/orphans/{name}/delete\", s.handleDeleteOrphan)\n\n\t// Live run supervision (job two).\n\tmux.HandleFunc(\"GET /projects/{project}/jobs/{job}/session-log/stream\", s.handleSessionLogStream)\n}\n\n// Handler returns the fully-wrapped http.Handler — the httptest-able seam for\n// endpoint tests (httptest.NewServer(srv.Handler())).\nfunc (s *Server) Handler() http.Handler { return s.http.Handler }\n\n// Serve serves on ln until Shutdown or a fatal error — the httptest-able\n// seam for the serve loop (mg serve calls this on its bound listener; tests\n// hand over a bound 127.0.0.1:0 listener).\nfunc (s *Server) Serve(ln net.Listener) error { return s.http.Serve(ln) }\n\n// Shutdown gracefully drains in-flight requests and closes the listener. The\n// caller bounds the wait with the context (mg serve uses a bounded drain so a\n// hung request cannot wedge the exit). shutdownCtx is cancelled first, so any\n// long-lived streaming handler (see stream.go) unblocks its own poll loop and\n// returns immediately rather than forcing the drain to wait out its full\n// timeout.\nfunc (s *Server) Shutdown(ctx context.Context) error {\n\ts.shutdownCancel()\n\treturn s.http.Shutdown(ctx)\n}","lineStart":1,"lineEnd":114,"totalLines":114,"truncated":false}},"title":"src/internal/serve/server.go","time":{"start":1787993698140,"end":1787993698146}},"id":"prt_04cbaaf59001eyU5wUSWSf2H7F","sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","messageID":"msg_04cba96dd001RUxsoonFItyVoy"}}
{"type":"tool_use","timestamp":1787993698511,"sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","part":{"type":"tool","tool":"read","callID":"call_b9408784356040ca856f6e77","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/mutate.go"},"output":"<path>/workspace/src/internal/serve/mutate.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"bytes\"\n5: \t\"context\"\n6: \t\"encoding/json\"\n7: \t\"errors\"\n8: \t\"fmt\"\n9: \t\"io\"\n10: \t\"net/http\"\n11: \t\"os\"\n12: \t\"path/filepath\"\n13: \t\"strings\"\n14: \t\"time\"\n15: \n16: \t\"github.com/lmuskalla/manigot/internal/agentlist\"\n17: \t\"github.com/lmuskalla/manigot/internal/config\"\n18: \t\"github.com/lmuskalla/manigot/internal/git\"\n19: \t\"github.com/lmuskalla/manigot/internal/job\"\n20: \t\"github.com/lmuskalla/manigot/internal/launch\"\n21: \t\"github.com/lmuskalla/manigot/internal/session\"\n22: )\n23: \n24: // maxJSONBodyBytes bounds every JSON request body this API decodes — a sane\n25: // cap well above any realistic request (a title, a profile name, a force\n26: // flag) while still refusing an unbounded upload.\n27: const maxJSONBodyBytes = 1 << 20 // 1 MiB\n28: \n29: // approvedConfirm is the pre-approved job.ConfirmFunc every mutating endpoint\n30: // that wraps a confirm-gated job.* function passes: the HTTP call itself is\n31: // the confirmation, mirroring internal/ui/app.go's own yesConfirm — the same\n32: // precedent the TUI already established for its confirm-then-call pattern.\n33: // Any warning this API wants to gate behind an explicit decision (see\n34: // handleDoneJob's {\"force\":true} requirement) is intercepted before the\n35: // wrapped function's own confirm prompts are ever reached.\n36: func approvedConfirm(prompt string) (bool, error) { return true, nil }\n37: \n38: // decodeJSONBody decodes r's body into v, tolerating a fully empty body (a\n39: // zero-value v — every mutating endpoint's request body is either optional\n40: // or has every field itself optional). A non-empty-but-invalid body is a 400.\n41: func decodeJSONBody(w http.ResponseWriter, r *http.Request, v any) bool {\n42: \tif r.Body == nil || r.ContentLength == 0 {\n43: \t\treturn true\n44: \t}\n45: \tdec := json.NewDecoder(io.LimitReader(r.Body, maxJSONBodyBytes))\n46: \tif err := dec.Decode(v); err != nil {\n47: \t\tif errors.Is(err, io.EOF) {\n48: \t\t\treturn true // an empty body decodes as EOF — same as no body\n49: \t\t}\n50: \t\twriteError(w, http.StatusBadRequest, \"invalid JSON body\")\n51: \t\treturn false\n52: \t}\n53: \treturn true\n54: }\n55: \n56: // resolveProfile validates an optional profile string (from a request body),\n57: // defaulting to config.ProfileClaudePro like every other launch path (mg\n58: // jdi's own --profile flag, the session launcher). An unrecognized non-empty\n59: // value is reported to the caller (ok=false; the handler must return\n60: // immediately) rather than silently falling through to a launch failure deep\n61: // inside a container spin-up.\n62: func resolveProfile(w http.ResponseWriter, raw string) (profile string, ok bool) {\n63: \tprofile = strings.TrimSpace(raw)\n64: \tif profile == \"\" {\n65: \t\treturn config.ProfileClaudePro, true\n66: \t}\n67: \tif _, known := config.ProfileByID(profile); !known {\n68: \t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"unknown profile %q\", profile))\n69: \t\treturn \"\", false\n70: \t}\n71: \treturn profile, true\n72: }\n73: \n74: // --- POST /projects/{project}/jobs (TASK-3) ----------------------------------\n75: \n76: // createJobRequest is the create-job endpoint's request body. Type defaults\n77: // to \"feature\" when empty; BaseBranch optionally overrides the project's\n78: // configured base branch for this one job.\n79: type createJobRequest struct {\n80: \tTitle      string `json:\"title\"`\n81: \tType       string `json:\"type\"`\n82: \tBaseBranch string `json:\"baseBranch\"`\n83: }\n84: \n85: // createJobResponse is the create-job endpoint's response: the created job's\n86: // row (the same shape GET .../jobs returns) plus the branch/worktree path\n87: // from job.CreateResult.\n88: type createJobResponse struct {\n89: \tJob          jobRow `json:\"job\"`\n90: \tBranch       string `json:\"branch\"`\n91: \tWorktreePath string `json:\"worktreePath,omitempty\"`\n92: }\n93: \n94: // validJobTypes mirrors job.CreateJob's own accepted set (internal/job/\n95: // create.go) — checked here so a bad value is a clean 400 instead of\n96: // CreateJob's own \"Invalid type '...' ...\" error text surfacing as a 500.\n97: var validJobTypes = map[string]bool{\"\": true, \"feature\": true, \"fix\": true, \"chore\": true}\n98: \n99: // jobRowFromJob builds a jobRow — the exact shape handleProjectJobs returns —\n100: // from an already-resolved job.Job, so a mutating endpoint's response carries\n101: // the identical fields a subsequent GET .../jobs listing would show for it.\n102: func jobRowFromJob(j job.Job) jobRow {\n103: \treturn jobRow{\n104: \t\tID:     j.ID,\n105: \t\tName:   j.Name,\n106: \t\tStatus: j.Status,\n107: \t\tStage:  string(j.Stage()),\n108: \t\tType:   j.Type,\n109: \t\tDate:   j.Date,\n110: \t\tTitle:  j.Title,\n111: \t\tBranch: j.Branch,\n112: \t}\n113: }\n114: \n115: // handleCreateJob creates a new job (job.CreateJob) under the project lock —\n116: // git-mutating: it creates a branch + worktree, one of the operations the\n117: // brief's Notes names explicitly.\n118: func (s *Server) handleCreateJob(w http.ResponseWriter, r *http.Request) {\n119: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n120: \tif !ok {\n121: \t\treturn\n122: \t}\n123: \n124: \tvar req createJobRequest\n125: \tif !decodeJSONBody(w, r, &req) {\n126: \t\treturn\n127: \t}\n128: \tif strings.TrimSpace(req.Title) == \"\" {\n129: \t\twriteError(w, http.StatusBadRequest, \"title is required\")\n130: \t\treturn\n131: \t}\n132: \tif !validJobTypes[req.Type] {\n133: \t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"invalid type %q — use feature, fix, or chore\", req.Type))\n134: \t\treturn\n135: \t}\n136: \n137: \ts.locks.Lock(root)\n138: \tdefer s.locks.Unlock(root)\n139: \n140: \tres, err := job.CreateJob(root, req.Title, job.CreateOptions{Type: req.Type, BaseBranchOverride: req.BaseBranch}, io.Discard)\n141: \tif err != nil {\n142: \t\twriteError(w, http.StatusInternalServerError, err.Error())\n143: \t\treturn\n144: \t}\n145: \twriteJSON(w, http.StatusCreated, createJobResponse{\n146: \t\tJob:          jobRowFromJob(res.Job),\n147: \t\tBranch:       res.Branch,\n148: \t\tWorktreePath: res.WorktreePath,\n149: \t})\n150: }\n151: \n152: // --- PUT /projects/{project}/jobs/{job}/files/brief (TASK-4) -----------------\n153: \n154: // maxBriefBytes bounds the edit-brief endpoint's request body — a sane cap\n155: // well above any realistic brief.md while still refusing an unbounded upload.\n156: const maxBriefBytes = 1 << 20 // 1 MiB\n157: \n158: // editBriefResponse is the edit-brief endpoint's response. Warning is set\n159: // only when the post-write commit sweep could not be attempted or failed —\n160: // the write itself already succeeded either way, so this is a diagnostic, not\n161: // a failure of the request.\n162: type editBriefResponse struct {\n163: \tStatus  string `json:\"status\"`\n164: \tWarning string `json:\"warning,omitempty\"`\n165: }\n166: \n167: // handleEditBrief replaces a job's brief.md wholesale with the raw request\n168: // body — the one job file this API makes writable (tasks/implementation/\n169: // verdict stay read-only, written only by their respective agents: no\n170: // $EDITOR here, this is an HTTP body write) — then commits the change in the\n171: // job's own worktree via session.SweepJobWorktree (the same \"commit\n172: // everything uncommitted\" primitive every session-ending sweep already\n173: // uses), so the edit never sits as an uncommitted change waiting for\n174: // something else to sweep it.\n175: //\n176: // Takes the project lock: the commit itself touches git, even though the\n177: // brief's Notes paragraph only names create/done/delete/push explicitly in\n178: // its git-mutating set — a real race against a concurrent done/delete on the\n179: // same worktree otherwise (this task's own reasoned addition, not something\n180: // the brief pins either way).\n181: func (s *Server) handleEditBrief(w http.ResponseWriter, r *http.Request) {\n182: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n183: \tif !ok {\n184: \t\treturn\n185: \t}\n186: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n187: \tif !ok {\n188: \t\treturn\n189: \t}\n190: \n191: \tbody, err := io.ReadAll(io.LimitReader(r.Body, maxBriefBytes+1))\n192: \tif err != nil {\n193: \t\twriteError(w, http.StatusBadRequest, \"could not read request body\")\n194: \t\treturn\n195: \t}\n196: \tif len(body) == 0 {\n197: \t\twriteError(w, http.StatusBadRequest, \"request body must not be empty\")\n198: \t\treturn\n199: \t}\n200: \tif len(body) > maxBriefBytes {\n201: \t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"request body exceeds the %d byte limit\", maxBriefBytes))\n202: \t\treturn\n203: \t}\n204: \n205: \ts.locks.Lock(root)\n206: \tdefer s.locks.Unlock(root)\n207: \n208: \tif err := os.WriteFile(filepath.Join(j.Dir, \"brief.md\"), body, 0o644); err != nil {\n209: \t\twriteError(w, http.StatusInternalServerError, \"could not write brief.md\")\n210: \t\treturn\n211: \t}\n212: \n213: \tresp := editBriefResponse{Status: \"ok\"}\n214: \tvar diag bytes.Buffer\n215: \tif wt, wtOK, werr := git.WorktreeForBranch(root, j.Branch); werr != nil {\n216: \t\tresp.Warning = \"brief.md written, but could not resolve the job's worktree to commit it: \" + werr.Error()\n217: \t} else if wtOK {\n218: \t\tsession.SweepJobWorktree(session.Root{ProjectRoot: wt, InvocationRoot: root, Job: j.Name}, &diag)\n219: \t\tif diag.Len() > 0 {\n220: \t\t\tresp.Warning = strings.TrimSpace(diag.String())\n221: \t\t}\n222: \t} else {\n223: \t\t// A branch with no registered worktree is an inconsistent state — the\n224: \t\t// edit is written but cannot be committed, so say so rather than\n225: \t\t// claiming a clean ok.\n226: \t\tresp.Warning = fmt.Sprintf(\"brief.md written, but branch '%s' has no registered worktree to commit it — the edit may be lost on a later checkout\", j.Branch)\n227: \t}\n228: \twriteJSON(w, http.StatusOK, resp)\n229: }\n230: \n231: // --- POST /projects/{project}/jobs/{job}/agents/{agent} (TASK-5) ------------\n232: \n233: // handleLaunchAgent launches one agent, one-shot, via internal/session's\n234: // RunOneShot/CommandAgentRunner (TASK-2) — never an attached/interactive\n235: // session, per the brief's explicit out-of-scope note. The agent name is\n236: // validated against agentlist.Discover(root) first, for a fast 404 on an\n237: // unknown agent rather than letting an invalid agent fail deep inside a\n238: // container spin-up. Does NOT take s.locks: launching an agent doesn't touch\n239: // git state and shouldn't block behind an unrelated done/delete (the brief's\n240: // own Notes).\n241: //\n242: // Responds 202 Accepted immediately — the run happens in a background\n243: // goroutine; the caller watches it via the session-log SSE stream (TASK-12)\n244: // or by polling GET .../jdi's sessionLog tail.\n245: func (s *Server) handleLaunchAgent(w http.ResponseWriter, r *http.Request) {\n246: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n247: \tif !ok {\n248: \t\treturn\n249: \t}\n250: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n251: \tif !ok {\n252: \t\treturn\n253: \t}\n254: \n255: \tagent := r.PathValue(\"agent\")\n256: \tif !validSegment(agent) {\n257: \t\twriteError(w, http.StatusNotFound, \"agent not found\")\n258: \t\treturn\n259: \t}\n260: \tagents, err := agentlist.Discover(root)\n261: \tif err != nil {\n262: \t\twriteError(w, http.StatusInternalServerError, \"cannot list agents\")\n263: \t\treturn\n264: \t}\n265: \tknown := false\n266: \tfor _, a := range agents {\n267: \t\tif a.Name == agent {\n268: \t\t\tknown = true\n269: \t\t\tbreak\n270: \t\t}\n271: \t}\n272: \tif !known {\n273: \t\twriteError(w, http.StatusNotFound, fmt.Sprintf(\"agent '%s' not found\", agent))\n274: \t\treturn\n275: \t}\n276: \n277: \tvar req struct {\n278: \t\tProfile string `json:\"profile\"`\n279: \t}\n280: \tif !decodeJSONBody(w, r, &req) {\n281: \t\treturn\n282: \t}\n283: \tprofile, ok := resolveProfile(w, req.Profile)\n284: \tif !ok {\n285: \t\treturn\n286: \t}\n287: \n288: \trunner := &session.CommandAgentRunner{ProjectRoot: root, Profile: profile}\n289: \tgo session.RunOneShot(runner, agent, j)\n290: \n291: \twriteJSON(w, http.StatusAccepted, map[string]string{\"status\": \"started\", \"agent\": agent, \"job\": j.Name})\n292: }\n293: \n294: // --- POST /projects/{project}/jobs/{job}/jdi (TASK-6) -----------------------\n295: \n296: // handleLaunchJDI launches `mg jdi` detached for a job (launch.Jdi — already\n297: // exactly the shape this needs: a detached subprocess, no attached terminal,\n298: // stdio discarded, reaped asynchronously). Before launching it checks\n299: // job.ReadJDIStatus for an already-running state and rejects with 409 if\n300: // found — a best-effort guard (not airtight: two launches issued\n301: // back-to-back before the first process writes its own status sidecar could\n302: // still both proceed) against two concurrent mg-jdi loops racing on the same\n303: // job's git branch. No s.locks — same reasoning as handleLaunchAgent.\n304: func (s *Server) handleLaunchJDI(w http.ResponseWriter, r *http.Request) {\n305: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n306: \tif !ok {\n307: \t\treturn\n308: \t}\n309: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n310: \tif !ok {\n311: \t\treturn\n312: \t}\n313: \n314: \tif st, running := job.ReadJDIStatus(root, j.Name); running && st.State == job.JDIRunning {\n315: \t\twriteError(w, http.StatusConflict, fmt.Sprintf(\"mg jdi is already running for job '%s'\", j.Name))\n316: \t\treturn\n317: \t}\n318: \n319: \tvar req struct {\n320: \t\tProfile string `json:\"profile\"`\n321: \t}\n322: \tif !decodeJSONBody(w, r, &req) {\n323: \t\treturn\n324: \t}\n325: \tprofile, ok := resolveProfile(w, req.Profile)\n326: \tif !ok {\n327: \t\treturn\n328: \t}\n329: \n330: \tif err := launch.Jdi(j.Name, root, profile); err != nil {\n331: \t\twriteError(w, http.StatusInternalServerError, err.Error())\n332: \t\treturn\n333: \t}\n334: \twriteJSON(w, http.StatusAccepted, map[string]string{\"status\": \"started\", \"job\": j.Name})\n335: }\n336: \n337: // --- POST /projects/{project}/jobs/{job}/done (TASK-7) ----------------------\n338: \n339: // doneRequest is the done endpoint's request body: force, when true,\n340: // proceeds past the \"verdict not approved\" / \"no verdict.md\" warnings the CLI\n341: // would otherwise interactively confirm past — there is no human physically\n342: // reading a terminal warning over this API, so the default is to refuse\n343: // (409) rather than silently auto-approve a risky merge the way the TUI's\n344: // yesConfirm does today.\n345: type doneRequest struct {\n346: \tForce bool `json:\"force\"`\n347: }\n348: \n349: // doneResponse is the done endpoint's response: the finished job's name, the\n350: // branch that was merged and deleted, and the base branch it was merged into.\n351: type doneResponse struct {\n352: \tJobName    string `json:\"jobName\"`\n353: \tBranch     string `json:\"branch\"`\n354: \tBaseBranch string `json:\"baseBranch\"`\n355: }\n356: \n357: // doneVerdictWarning reproduces FinishJob's own pre-merge verdict check\n358: // (internal/job/finish.go) without duplicating its regex classification: it\n359: // reads the same job.Job.VerdictStatus/job.VerdictNotApproved exported\n360: // helpers FinishJob itself is built on, so the two can never drift. hasWarning\n361: // is true — with the CLI's own warning text — for exactly the three cases\n362: // FinishJob would otherwise interactively confirm past: an undetermined\n363: // status, a REJECTED/NEEDS WORK status, or a missing verdict.md.\n364: func doneVerdictWarning(j job.Job) (warning string, hasWarning bool) {\n365: \tverdictPath := filepath.Join(j.Dir, \"verdict.md\")\n366: \tswitch _, err := os.Stat(verdictPath); {\n367: \tcase err == nil:\n368: \t\tstatus := j.VerdictStatus()\n369: \t\tswitch {\n370: \t\tcase status == \"\":\n371: \t\t\treturn \"Warning: could not determine verdict status from verdict.md\", true\n372: \t\tcase job.VerdictNotApproved(status):\n373: \t\t\treturn fmt.Sprintf(\"Warning: verdict is '%s' — job is not approved.\", status), true\n374: \t\tdefault:\n375: \t\t\treturn \"\", false\n376: \t\t}\n377: \tcase os.IsNotExist(err):\n378: \t\treturn \"Warning: no verdict.md found — job has not been reviewed.\", true\n379: \tdefault:\n380: \t\treturn \"\", false // unreadable for some other reason — let FinishJob itself surface it\n381: \t}\n382: }\n383: \n384: // handleDoneJob archives a finished job (job.FinishJobWithOptions) under the\n385: // project lock (git-mutating, named explicitly in the brief's Notes).\n386: //\n387: // A squash-merge conflict is reported as a structured 409 error\n388: // (job.ErrSquashMergeConflict, via FinishOptions.NoConflictRecovery) and the\n389: // job is left exactly where FinishJob left it — no automatic rollback, no\n390: // automatic @git-solver handoff — per the brief's own explicit pinning that\n391: // this must not silently fall back to either of FinishJob's two interactive\n392: // behaviors; resolving it is an explicit follow-up decision through some\n393: // other call (e.g. launching @git-solver via the agent-launch endpoint, or\n394: // `mg host` from a terminal).\n395: //\n396: // Separately (not pinned by the brief at all): the earlier \"verdict not\n397: // approved\" / \"no verdict.md\" warnings require {\"force\": true} to proceed\n398: // past — a 409 echoing the CLI's own warning text when force is absent —\n399: // rather than silently auto-approving a risky merge the way the TUI's\n400: // yesConfirm does today.\n401: func (s *Server) handleDoneJob(w http.ResponseWriter, r *http.Request) {\n402: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n403: \tif !ok {\n404: \t\treturn\n405: \t}\n406: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n407: \tif !ok {\n408: \t\treturn\n409: \t}\n410: \n411: \tvar req doneRequest\n412: \tif !decodeJSONBody(w, r, &req) {\n413: \t\treturn\n414: \t}\n415: \n416: \tif warning, has := doneVerdictWarning(j); has && !req.Force {\n417: \t\twriteError(w, http.StatusConflict, warning+\" Pass {\\\"force\\\": true} to proceed anyway.\")\n418: \t\treturn\n419: \t}\n420: \n421: \ts.locks.Lock(root)\n422: \tdefer s.locks.Unlock(root)\n423: \n424: \tvar out bytes.Buffer\n425: \tres, err := job.FinishJobWithOptions(root, j.Name, approvedConfirm, &out, job.FinishOptions{NoConflictRecovery: true})\n426: \tif err != nil {\n427: \t\tif errors.Is(err, job.ErrSquashMergeConflict) {\n428: \t\t\t// The 409 must say explicitly that the job is already\n429: \t\t\t// archived-and-committed in its own worktree — FinishJobWithOptions\n430: \t\t\t// writes that explanation to out before returning the error (the\n431: \t\t\t// archive step runs before the merge attempt and cannot be undone).\n432: \t\t\t// A client reading only err.Error() would assume \"nothing happened\"\n433: \t\t\t// and retry done, which then fails confusingly with \"brief.md not\n434: \t\t\t// found\" because the job dir was renamed into docs/jobs/archive/.\n435: \t\t\tmsg := err.Error()\n436: \t\t\tif s := strings.TrimSpace(out.String()); s != \"\" {\n437: \t\t\t\tmsg += \"\\n\\n\" + s\n438: \t\t\t}\n439: \t\t\twriteError(w, http.StatusConflict, msg)\n440: \t\t\treturn\n441: \t\t}\n442: \t\twriteError(w, http.StatusInternalServerError, err.Error())\n443: \t\treturn\n444: \t}\n445: \twriteJSON(w, http.StatusOK, doneResponse{JobName: res.JobName, Branch: res.Branch, BaseBranch: res.BaseBranch})\n446: }\n447: \n448: // --- POST /projects/{project}/jobs/{job}/delete (TASK-8) --------------------\n449: \n450: // deleteJobResponse is the delete endpoint's response — job.DeleteResult's\n451: // fields.\n452: type deleteJobResponse struct {\n453: \tJobName string `json:\"jobName\"`\n454: \tBranch  string `json:\"branch,omitempty\"`\n455: \tDir     string `json:\"dir\"`\n456: }\n457: \n458: // handleDeleteJob permanently deletes a job (job.DeleteJob) under the project\n459: // lock (git-mutating, named explicitly in the brief's Notes). The HTTP call\n460: // itself is the confirmation (approvedConfirm) — no merge step, so unlike\n461: // done there is no conflict-handling ambiguity here.\n462: func (s *Server) handleDeleteJob(w http.ResponseWriter, r *http.Request) {\n463: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n464: \tif !ok {\n465: \t\treturn\n466: \t}\n467: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n468: \tif !ok {\n469: \t\treturn\n470: \t}\n471: \n472: \ts.locks.Lock(root)\n473: \tdefer s.locks.Unlock(root)\n474: \n475: \tvar out bytes.Buffer\n476: \tres, err := job.DeleteJob(root, j.Name, approvedConfirm, &out)\n477: \tif err != nil {\n478: \t\twriteError(w, http.StatusInternalServerError, err.Error())\n479: \t\treturn\n480: \t}\n481: \twriteJSON(w, http.StatusOK, deleteJobResponse{JobName: res.JobName, Branch: res.Branch, Dir: res.Dir})\n482: }\n483: \n484: // --- POST /projects/{project}/jobs/{job}/push (TASK-9) ----------------------\n485: \n486: // pushTimeout bounds the push endpoint's git call, mirroring the TUI git\n487: // panel's own hostGitTimeout (src/internal/ui/app.go): long enough for a\n488: // real push, short enough that a stalled/unreachable remote can't hang the\n489: // request forever.\n490: const pushTimeout = 30 * time.Second\n491: \n492: // handlePushJob pushes a job's branch to origin (git.PushWithContext — `git\n493: // push -u origin <branch>`, mirroring the TUI git panel's \"Push to origin\"\n494: // action) under the project lock (git-mutating, named explicitly in the\n495: // brief's Notes). A push failure (auth, network, non-fast-forward) surfaces\n496: // as a structured error with git's own message, never silently swallowed.\n497: func (s *Server) handlePushJob(w http.ResponseWriter, r *http.Request) {\n498: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n499: \tif !ok {\n500: \t\treturn\n501: \t}\n502: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n503: \tif !ok {\n504: \t\treturn\n505: \t}\n506: \n507: \ts.locks.Lock(root)\n508: \tdefer s.locks.Unlock(root)\n509: \n510: \tctx, cancel := context.WithTimeout(r.Context(), pushTimeout)\n511: \tdefer cancel()\n512: \tif err := git.PushWithContext(ctx, root, j.Branch); err != nil {\n513: \t\twriteError(w, http.StatusInternalServerError, err.Error())\n514: \t\treturn\n515: \t}\n516: \twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"pushed\", \"branch\": j.Branch})\n517: }\n518: \n519: // --- POST /prune (TASK-10) ---------------------------------------------------\n520: \n521: // pruneResponse mirrors mg prune's own reporting (session.PruneResult).\n522: type pruneResponse struct {\n523: \tRemoved int `json:\"removed\"`\n524: \tRunning int `json:\"running\"`\n525: }\n526: \n527: // handlePrune wraps session.PruneOrphans — the same function cmd/mg/prune.go's\n528: // runPrune calls. Deliberately top-level (not nested under /projects/{project})\n529: // rather than project-scoped: orphaned manigot-* containers are not\n530: // partitioned by project (docker has no concept of \"which registered project\"\n531: // a leftover container belongs to). No s.locks: no git or project-scoped\n532: // state at all.\n533: func (s *Server) handlePrune(w http.ResponseWriter, r *http.Request) {\n534: \tres, err := session.PruneOrphans(io.Discard)\n535: \tif err != nil {\n536: \t\twriteError(w, http.StatusInternalServerError, err.Error())\n537: \t\treturn\n538: \t}\n539: \twriteJSON(w, http.StatusOK, pruneResponse{Removed: res.Removed, Running: res.Running})\n540: }\n541: \n542: // --- /projects/{project}/orphans (TASK-11) ----------------------------------\n543: \n544: // orphanRow is one orphaned worktree in the response — job.Orphan's fields.\n545: type orphanRow struct {\n546: \tName   string `json:\"name\"`\n547: \tDir    string `json:\"dir\"`\n548: \tGitDir string `json:\"gitDir\"`\n549: }\n550: \n551: // orphansResponse is the list-orphans endpoint's response shape.\n552: type orphansResponse struct {\n553: \tOrphans []orphanRow `json:\"orphans\"`\n554: }\n555: \n556: // handleProjectOrphans lists a project's orphaned worktrees (job.\n557: // DiscoverOrphans) — read-only, no lock.\n558: func (s *Server) handleProjectOrphans(w http.ResponseWriter, r *http.Request) {\n559: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n560: \tif !ok {\n561: \t\treturn\n562: \t}\n563: \torphans, err := job.DiscoverOrphans(root)\n564: \tif err != nil {\n565: \t\twriteError(w, http.StatusInternalServerError, \"cannot list orphaned worktrees\")\n566: \t\treturn\n567: \t}\n568: \trows := make([]orphanRow, 0, len(orphans))\n569: \tfor _, o := range orphans {\n570: \t\trows = append(rows, orphanRow{Name: o.Name, Dir: o.Dir, GitDir: o.GitDir})\n571: \t}\n572: \twriteJSON(w, http.StatusOK, orphansResponse{Orphans: rows})\n573: }\n574: \n575: // handleDeleteOrphan resolves one named orphan (job.MatchOrphan, exact then\n576: // prefix on the orphan's base name) and removes it (job.\n577: // RemoveOrphansConfirmed — the HTTP call itself is the confirmation, no\n578: // further prompt) under the project lock: RemoveOrphansConfirmed calls\n579: // git.WorktreePrune, which touches git worktree metadata and can race with a\n580: // concurrent create/done/delete on the same project — this task's own\n581: // reasoned addition, since the brief's Notes paragraph does not name orphan\n582: // cleanup in its git-mutating set at all.\n583: //\n584: // One named resource per call, consistent with every other mutating endpoint\n585: // in this API, rather than a single \"delete everything\" call that risks\n586: // removing something the caller didn't expect to see gone.\n587: func (s *Server) handleDeleteOrphan(w http.ResponseWriter, r *http.Request) {\n588: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n589: \tif !ok {\n590: \t\treturn\n591: \t}\n592: \tname := r.PathValue(\"name\")\n593: \tif !validSegment(name) {\n594: \t\twriteError(w, http.StatusNotFound, \"orphan not found\")\n595: \t\treturn\n596: \t}\n597: \to, found := job.MatchOrphan(root, name)\n598: \tif !found {\n599: \t\twriteError(w, http.StatusNotFound, fmt.Sprintf(\"orphan '%s' not found among the project's orphaned worktrees\", name))\n600: \t\treturn\n601: \t}\n602: \n603: \ts.locks.Lock(root)\n604: \tdefer s.locks.Unlock(root)\n605: \n606: \tvar out bytes.Buffer\n607: \tif err := job.RemoveOrphansConfirmed(root, []job.Orphan{o}, &out); err != nil {\n608: \t\twriteError(w, http.StatusInternalServerError, err.Error())\n609: \t\treturn\n610: \t}\n611: \twriteJSON(w, http.StatusOK, orphanRow{Name: o.Name, Dir: o.Dir, GitDir: o.GitDir})\n612: }\n\n(End of file - total 612 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/agentlist\"\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/launch\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/mutate.go","text":"package serve\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/agentlist\"\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/launch\"\n\t\"github.com/lmuskalla/manigot/internal/session\"\n)\n\n// maxJSONBodyBytes bounds every JSON request body this API decodes — a sane\n// cap well above any realistic request (a title, a profile name, a force\n// flag) while still refusing an unbounded upload.\nconst maxJSONBodyBytes = 1 << 20 // 1 MiB\n\n// approvedConfirm is the pre-approved job.ConfirmFunc every mutating endpoint\n// that wraps a confirm-gated job.* function passes: the HTTP call itself is\n// the confirmation, mirroring internal/ui/app.go's own yesConfirm — the same\n// precedent the TUI already established for its confirm-then-call pattern.\n// Any warning this API wants to gate behind an explicit decision (see\n// handleDoneJob's {\"force\":true} requirement) is intercepted before the\n// wrapped function's own confirm prompts are ever reached.\nfunc approvedConfirm(prompt string) (bool, error) { return true, nil }\n\n// decodeJSONBody decodes r's body into v, tolerating a fully empty body (a\n// zero-value v — every mutating endpoint's request body is either optional\n// or has every field itself optional). A non-empty-but-invalid body is a 400.\nfunc decodeJSONBody(w http.ResponseWriter, r *http.Request, v any) bool {\n\tif r.Body == nil || r.ContentLength == 0 {\n\t\treturn true\n\t}\n\tdec := json.NewDecoder(io.LimitReader(r.Body, maxJSONBodyBytes))\n\tif err := dec.Decode(v); err != nil {\n\t\tif errors.Is(err, io.EOF) {\n\t\t\treturn true // an empty body decodes as EOF — same as no body\n\t\t}\n\t\twriteError(w, http.StatusBadRequest, \"invalid JSON body\")\n\t\treturn false\n\t}\n\treturn true\n}\n\n// resolveProfile validates an optional profile string (from a request body),\n// defaulting to config.ProfileClaudePro like every other launch path (mg\n// jdi's own --profile flag, the session launcher). An unrecognized non-empty\n// value is reported to the caller (ok=false; the handler must return\n// immediately) rather than silently falling through to a launch failure deep\n// inside a container spin-up.\nfunc resolveProfile(w http.ResponseWriter, raw string) (profile string, ok bool) {\n\tprofile = strings.TrimSpace(raw)\n\tif profile == \"\" {\n\t\treturn config.ProfileClaudePro, true\n\t}\n\tif _, known := config.ProfileByID(profile); !known {\n\t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"unknown profile %q\", profile))\n\t\treturn \"\", false\n\t}\n\treturn profile, true\n}\n\n// --- POST /projects/{project}/jobs (TASK-3) ----------------------------------\n\n// createJobRequest is the create-job endpoint's request body. Type defaults\n// to \"feature\" when empty; BaseBranch optionally overrides the project's\n// configured base branch for this one job.\ntype createJobRequest struct {\n\tTitle      string `json:\"title\"`\n\tType       string `json:\"type\"`\n\tBaseBranch string `json:\"baseBranch\"`\n}\n\n// createJobResponse is the create-job endpoint's response: the created job's\n// row (the same shape GET .../jobs returns) plus the branch/worktree path\n// from job.CreateResult.\ntype createJobResponse struct {\n\tJob          jobRow `json:\"job\"`\n\tBranch       string `json:\"branch\"`\n\tWorktreePath string `json:\"worktreePath,omitempty\"`\n}\n\n// validJobTypes mirrors job.CreateJob's own accepted set (internal/job/\n// create.go) — checked here so a bad value is a clean 400 instead of\n// CreateJob's own \"Invalid type '...' ...\" error text surfacing as a 500.\nvar validJobTypes = map[string]bool{\"\": true, \"feature\": true, \"fix\": true, \"chore\": true}\n\n// jobRowFromJob builds a jobRow — the exact shape handleProjectJobs returns —\n// from an already-resolved job.Job, so a mutating endpoint's response carries\n// the identical fields a subsequent GET .../jobs listing would show for it.\nfunc jobRowFromJob(j job.Job) jobRow {\n\treturn jobRow{\n\t\tID:     j.ID,\n\t\tName:   j.Name,\n\t\tStatus: j.Status,\n\t\tStage:  string(j.Stage()),\n\t\tType:   j.Type,\n\t\tDate:   j.Date,\n\t\tTitle:  j.Title,\n\t\tBranch: j.Branch,\n\t}\n}\n\n// handleCreateJob creates a new job (job.CreateJob) under the project lock —\n// git-mutating: it creates a branch + worktree, one of the operations the\n// brief's Notes names explicitly.\nfunc (s *Server) handleCreateJob(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\tvar req createJobRequest\n\tif !decodeJSONBody(w, r, &req) {\n\t\treturn\n\t}\n\tif strings.TrimSpace(req.Title) == \"\" {\n\t\twriteError(w, http.StatusBadRequest, \"title is required\")\n\t\treturn\n\t}\n\tif !validJobTypes[req.Type] {\n\t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"invalid type %q — use feature, fix, or chore\", req.Type))\n\t\treturn\n\t}\n\n\ts.locks.Lock(root)\n\tdefer s.locks.Unlock(root)\n\n\tres, err := job.CreateJob(root, req.Title, job.CreateOptions{Type: req.Type, BaseBranchOverride: req.BaseBranch}, io.Discard)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusCreated, createJobResponse{\n\t\tJob:          jobRowFromJob(res.Job),\n\t\tBranch:       res.Branch,\n\t\tWorktreePath: res.WorktreePath,\n\t})\n}\n\n// --- PUT /projects/{project}/jobs/{job}/files/brief (TASK-4) -----------------\n\n// maxBriefBytes bounds the edit-brief endpoint's request body — a sane cap\n// well above any realistic brief.md while still refusing an unbounded upload.\nconst maxBriefBytes = 1 << 20 // 1 MiB\n\n// editBriefResponse is the edit-brief endpoint's response. Warning is set\n// only when the post-write commit sweep could not be attempted or failed —\n// the write itself already succeeded either way, so this is a diagnostic, not\n// a failure of the request.\ntype editBriefResponse struct {\n\tStatus  string `json:\"status\"`\n\tWarning string `json:\"warning,omitempty\"`\n}\n\n// handleEditBrief replaces a job's brief.md wholesale with the raw request\n// body — the one job file this API makes writable (tasks/implementation/\n// verdict stay read-only, written only by their respective agents: no\n// $EDITOR here, this is an HTTP body write) — then commits the change in the\n// job's own worktree via session.SweepJobWorktree (the same \"commit\n// everything uncommitted\" primitive every session-ending sweep already\n// uses), so the edit never sits as an uncommitted change waiting for\n// something else to sweep it.\n//\n// Takes the project lock: the commit itself touches git, even though the\n// brief's Notes paragraph only names create/done/delete/push explicitly in\n// its git-mutating set — a real race against a concurrent done/delete on the\n// same worktree otherwise (this task's own reasoned addition, not something\n// the brief pins either way).\nfunc (s *Server) handleEditBrief(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\tbody, err := io.ReadAll(io.LimitReader(r.Body, maxBriefBytes+1))\n\tif err != nil {\n\t\twriteError(w, http.StatusBadRequest, \"could not read request body\")\n\t\treturn\n\t}\n\tif len(body) == 0 {\n\t\twriteError(w, http.StatusBadRequest, \"request body must not be empty\")\n\t\treturn\n\t}\n\tif len(body) > maxBriefBytes {\n\t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"request body exceeds the %d byte limit\", maxBriefBytes))\n\t\treturn\n\t}\n\n\ts.locks.Lock(root)\n\tdefer s.locks.Unlock(root)\n\n\tif err := os.WriteFile(filepath.Join(j.Dir, \"brief.md\"), body, 0o644); err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"could not write brief.md\")\n\t\treturn\n\t}\n\n\tresp := editBriefResponse{Status: \"ok\"}\n\tvar diag bytes.Buffer\n\tif wt, wtOK, werr := git.WorktreeForBranch(root, j.Branch); werr != nil {\n\t\tresp.Warning = \"brief.md written, but could not resolve the job's worktree to commit it: \" + werr.Error()\n\t} else if wtOK {\n\t\tsession.SweepJobWorktree(session.Root{ProjectRoot: wt, InvocationRoot: root, Job: j.Name}, &diag)\n\t\tif diag.Len() > 0 {\n\t\t\tresp.Warning = strings.TrimSpace(diag.String())\n\t\t}\n\t} else {\n\t\t// A branch with no registered worktree is an inconsistent state — the\n\t\t// edit is written but cannot be committed, so say so rather than\n\t\t// claiming a clean ok.\n\t\tresp.Warning = fmt.Sprintf(\"brief.md written, but branch '%s' has no registered worktree to commit it — the edit may be lost on a later checkout\", j.Branch)\n\t}\n\twriteJSON(w, http.StatusOK, resp)\n}\n\n// --- POST /projects/{project}/jobs/{job}/agents/{agent} (TASK-5) ------------\n\n// handleLaunchAgent launches one agent, one-shot, via internal/session's\n// RunOneShot/CommandAgentRunner (TASK-2) — never an attached/interactive\n// session, per the brief's explicit out-of-scope note. The agent name is\n// validated against agentlist.Discover(root) first, for a fast 404 on an\n// unknown agent rather than letting an invalid agent fail deep inside a\n// container spin-up. Does NOT take s.locks: launching an agent doesn't touch\n// git state and shouldn't block behind an unrelated done/delete (the brief's\n// own Notes).\n//\n// Responds 202 Accepted immediately — the run happens in a background\n// goroutine; the caller watches it via the session-log SSE stream (TASK-12)\n// or by polling GET .../jdi's sessionLog tail.\nfunc (s *Server) handleLaunchAgent(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\tagent := r.PathValue(\"agent\")\n\tif !validSegment(agent) {\n\t\twriteError(w, http.StatusNotFound, \"agent not found\")\n\t\treturn\n\t}\n\tagents, err := agentlist.Discover(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot list agents\")\n\t\treturn\n\t}\n\tknown := false\n\tfor _, a := range agents {\n\t\tif a.Name == agent {\n\t\t\tknown = true\n\t\t\tbreak\n\t\t}\n\t}\n\tif !known {\n\t\twriteError(w, http.StatusNotFound, fmt.Sprintf(\"agent '%s' not found\", agent))\n\t\treturn\n\t}\n\n\tvar req struct {\n\t\tProfile string `json:\"profile\"`\n\t}\n\tif !decodeJSONBody(w, r, &req) {\n\t\treturn\n\t}\n\tprofile, ok := resolveProfile(w, req.Profile)\n\tif !ok {\n\t\treturn\n\t}\n\n\trunner := &session.CommandAgentRunner{ProjectRoot: root, Profile: profile}\n\tgo session.RunOneShot(runner, agent, j)\n\n\twriteJSON(w, http.StatusAccepted, map[string]string{\"status\": \"started\", \"agent\": agent, \"job\": j.Name})\n}\n\n// --- POST /projects/{project}/jobs/{job}/jdi (TASK-6) -----------------------\n\n// handleLaunchJDI launches `mg jdi` detached for a job (launch.Jdi — already\n// exactly the shape this needs: a detached subprocess, no attached terminal,\n// stdio discarded, reaped asynchronously). Before launching it checks\n// job.ReadJDIStatus for an already-running state and rejects with 409 if\n// found — a best-effort guard (not airtight: two launches issued\n// back-to-back before the first process writes its own status sidecar could\n// still both proceed) against two concurrent mg-jdi loops racing on the same\n// job's git branch. No s.locks — same reasoning as handleLaunchAgent.\nfunc (s *Server) handleLaunchJDI(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\tif st, running := job.ReadJDIStatus(root, j.Name); running && st.State == job.JDIRunning {\n\t\twriteError(w, http.StatusConflict, fmt.Sprintf(\"mg jdi is already running for job '%s'\", j.Name))\n\t\treturn\n\t}\n\n\tvar req struct {\n\t\tProfile string `json:\"profile\"`\n\t}\n\tif !decodeJSONBody(w, r, &req) {\n\t\treturn\n\t}\n\tprofile, ok := resolveProfile(w, req.Profile)\n\tif !ok {\n\t\treturn\n\t}\n\n\tif err := launch.Jdi(j.Name, root, profile); err != nil {\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusAccepted, map[string]string{\"status\": \"started\", \"job\": j.Name})\n}\n\n// --- POST /projects/{project}/jobs/{job}/done (TASK-7) ----------------------\n\n// doneRequest is the done endpoint's request body: force, when true,\n// proceeds past the \"verdict not approved\" / \"no verdict.md\" warnings the CLI\n// would otherwise interactively confirm past — there is no human physically\n// reading a terminal warning over this API, so the default is to refuse\n// (409) rather than silently auto-approve a risky merge the way the TUI's\n// yesConfirm does today.\ntype doneRequest struct {\n\tForce bool `json:\"force\"`\n}\n\n// doneResponse is the done endpoint's response: the finished job's name, the\n// branch that was merged and deleted, and the base branch it was merged into.\ntype doneResponse struct {\n\tJobName    string `json:\"jobName\"`\n\tBranch     string `json:\"branch\"`\n\tBaseBranch string `json:\"baseBranch\"`\n}\n\n// doneVerdictWarning reproduces FinishJob's own pre-merge verdict check\n// (internal/job/finish.go) without duplicating its regex classification: it\n// reads the same job.Job.VerdictStatus/job.VerdictNotApproved exported\n// helpers FinishJob itself is built on, so the two can never drift. hasWarning\n// is true — with the CLI's own warning text — for exactly the three cases\n// FinishJob would otherwise interactively confirm past: an undetermined\n// status, a REJECTED/NEEDS WORK status, or a missing verdict.md.\nfunc doneVerdictWarning(j job.Job) (warning string, hasWarning bool) {\n\tverdictPath := filepath.Join(j.Dir, \"verdict.md\")\n\tswitch _, err := os.Stat(verdictPath); {\n\tcase err == nil:\n\t\tstatus := j.VerdictStatus()\n\t\tswitch {\n\t\tcase status == \"\":\n\t\t\treturn \"Warning: could not determine verdict status from verdict.md\", true\n\t\tcase job.VerdictNotApproved(status):\n\t\t\treturn fmt.Sprintf(\"Warning: verdict is '%s' — job is not approved.\", status), true\n\t\tdefault:\n\t\t\treturn \"\", false\n\t\t}\n\tcase os.IsNotExist(err):\n\t\treturn \"Warning: no verdict.md found — job has not been reviewed.\", true\n\tdefault:\n\t\treturn \"\", false // unreadable for some other reason — let FinishJob itself surface it\n\t}\n}\n\n// handleDoneJob archives a finished job (job.FinishJobWithOptions) under the\n// project lock (git-mutating, named explicitly in the brief's Notes).\n//\n// A squash-merge conflict is reported as a structured 409 error\n// (job.ErrSquashMergeConflict, via FinishOptions.NoConflictRecovery) and the\n// job is left exactly where FinishJob left it — no automatic rollback, no\n// automatic @git-solver handoff — per the brief's own explicit pinning that\n// this must not silently fall back to either of FinishJob's two interactive\n// behaviors; resolving it is an explicit follow-up decision through some\n// other call (e.g. launching @git-solver via the agent-launch endpoint, or\n// `mg host` from a terminal).\n//\n// Separately (not pinned by the brief at all): the earlier \"verdict not\n// approved\" / \"no verdict.md\" warnings require {\"force\": true} to proceed\n// past — a 409 echoing the CLI's own warning text when force is absent —\n// rather than silently auto-approving a risky merge the way the TUI's\n// yesConfirm does today.\nfunc (s *Server) handleDoneJob(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\tvar req doneRequest\n\tif !decodeJSONBody(w, r, &req) {\n\t\treturn\n\t}\n\n\tif warning, has := doneVerdictWarning(j); has && !req.Force {\n\t\twriteError(w, http.StatusConflict, warning+\" Pass {\\\"force\\\": true} to proceed anyway.\")\n\t\treturn\n\t}\n\n\ts.locks.Lock(root)\n\tdefer s.locks.Unlock(root)\n\n\tvar out bytes.Buffer\n\tres, err := job.FinishJobWithOptions(root, j.Name, approvedConfirm, &out, job.FinishOptions{NoConflictRecovery: true})\n\tif err != nil {\n\t\tif errors.Is(err, job.ErrSquashMergeConflict) {\n\t\t\t// The 409 must say explicitly that the job is already\n\t\t\t// archived-and-committed in its own worktree — FinishJobWithOptions\n\t\t\t// writes that explanation to out before returning the error (the\n\t\t\t// archive step runs before the merge attempt and cannot be undone).\n\t\t\t// A client reading only err.Error() would assume \"nothing happened\"\n\t\t\t// and retry done, which then fails confusingly with \"brief.md not\n\t\t\t// found\" because the job dir was renamed into docs/jobs/archive/.\n\t\t\tmsg := err.Error()\n\t\t\tif s := strings.TrimSpace(out.String()); s != \"\" {\n\t\t\t\tmsg += \"\\n\\n\" + s\n\t\t\t}\n\t\t\twriteError(w, http.StatusConflict, msg)\n\t\t\treturn\n\t\t}\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, doneResponse{JobName: res.JobName, Branch: res.Branch, BaseBranch: res.BaseBranch})\n}\n\n// --- POST /projects/{project}/jobs/{job}/delete (TASK-8) --------------------\n\n// deleteJobResponse is the delete endpoint's response — job.DeleteResult's\n// fields.\ntype deleteJobResponse struct {\n\tJobName string `json:\"jobName\"`\n\tBranch  string `json:\"branch,omitempty\"`\n\tDir     string `json:\"dir\"`\n}\n\n// handleDeleteJob permanently deletes a job (job.DeleteJob) under the project\n// lock (git-mutating, named explicitly in the brief's Notes). The HTTP call\n// itself is the confirmation (approvedConfirm) — no merge step, so unlike\n// done there is no conflict-handling ambiguity here.\nfunc (s *Server) handleDeleteJob(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\ts.locks.Lock(root)\n\tdefer s.locks.Unlock(root)\n\n\tvar out bytes.Buffer\n\tres, err := job.DeleteJob(root, j.Name, approvedConfirm, &out)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, deleteJobResponse{JobName: res.JobName, Branch: res.Branch, Dir: res.Dir})\n}\n\n// --- POST /projects/{project}/jobs/{job}/push (TASK-9) ----------------------\n\n// pushTimeout bounds the push endpoint's git call, mirroring the TUI git\n// panel's own hostGitTimeout (src/internal/ui/app.go): long enough for a\n// real push, short enough that a stalled/unreachable remote can't hang the\n// request forever.\nconst pushTimeout = 30 * time.Second\n\n// handlePushJob pushes a job's branch to origin (git.PushWithContext — `git\n// push -u origin <branch>`, mirroring the TUI git panel's \"Push to origin\"\n// action) under the project lock (git-mutating, named explicitly in the\n// brief's Notes). A push failure (auth, network, non-fast-forward) surfaces\n// as a structured error with git's own message, never silently swallowed.\nfunc (s *Server) handlePushJob(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\ts.locks.Lock(root)\n\tdefer s.locks.Unlock(root)\n\n\tctx, cancel := context.WithTimeout(r.Context(), pushTimeout)\n\tdefer cancel()\n\tif err := git.PushWithContext(ctx, root, j.Branch); err != nil {\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"pushed\", \"branch\": j.Branch})\n}\n\n// --- POST /prune (TASK-10) ---------------------------------------------------\n\n// pruneResponse mirrors mg prune's own reporting (session.PruneResult).\ntype pruneResponse struct {\n\tRemoved int `json:\"removed\"`\n\tRunning int `json:\"running\"`\n}\n\n// handlePrune wraps session.PruneOrphans — the same function cmd/mg/prune.go's\n// runPrune calls. Deliberately top-level (not nested under /projects/{project})\n// rather than project-scoped: orphaned manigot-* containers are not\n// partitioned by project (docker has no concept of \"which registered project\"\n// a leftover container belongs to). No s.locks: no git or project-scoped\n// state at all.\nfunc (s *Server) handlePrune(w http.ResponseWriter, r *http.Request) {\n\tres, err := session.PruneOrphans(io.Discard)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, pruneResponse{Removed: res.Removed, Running: res.Running})\n}\n\n// --- /projects/{project}/orphans (TASK-11) ----------------------------------\n\n// orphanRow is one orphaned worktree in the response — job.Orphan's fields.\ntype orphanRow struct {\n\tName   string `json:\"name\"`\n\tDir    string `json:\"dir\"`\n\tGitDir string `json:\"gitDir\"`\n}\n\n// orphansResponse is the list-orphans endpoint's response shape.\ntype orphansResponse struct {\n\tOrphans []orphanRow `json:\"orphans\"`\n}\n\n// handleProjectOrphans lists a project's orphaned worktrees (job.\n// DiscoverOrphans) — read-only, no lock.\nfunc (s *Server) handleProjectOrphans(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\torphans, err := job.DiscoverOrphans(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot list orphaned worktrees\")\n\t\treturn\n\t}\n\trows := make([]orphanRow, 0, len(orphans))\n\tfor _, o := range orphans {\n\t\trows = append(rows, orphanRow{Name: o.Name, Dir: o.Dir, GitDir: o.GitDir})\n\t}\n\twriteJSON(w, http.StatusOK, orphansResponse{Orphans: rows})\n}\n\n// handleDeleteOrphan resolves one named orphan (job.MatchOrphan, exact then\n// prefix on the orphan's base name) and removes it (job.\n// RemoveOrphansConfirmed — the HTTP call itself is the confirmation, no\n// further prompt) under the project lock: RemoveOrphansConfirmed calls\n// git.WorktreePrune, which touches git worktree metadata and can race with a\n// concurrent create/done/delete on the same project — this task's own\n// reasoned addition, since the brief's Notes paragraph does not name orphan\n// cleanup in its git-mutating set at all.\n//\n// One named resource per call, consistent with every other mutating endpoint\n// in this API, rather than a single \"delete everything\" call that risks\n// removing something the caller didn't expect to see gone.\nfunc (s *Server) handleDeleteOrphan(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tname := r.PathValue(\"name\")\n\tif !validSegment(name) {\n\t\twriteError(w, http.StatusNotFound, \"orphan not found\")\n\t\treturn\n\t}\n\to, found := job.MatchOrphan(root, name)\n\tif !found {\n\t\twriteError(w, http.StatusNotFound, fmt.Sprintf(\"orphan '%s' not found among the project's orphaned worktrees\", name))\n\t\treturn\n\t}\n\n\ts.locks.Lock(root)\n\tdefer s.locks.Unlock(root)\n\n\tvar out bytes.Buffer\n\tif err := job.RemoveOrphansConfirmed(root, []job.Orphan{o}, &out); err != nil {\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, orphanRow{Name: o.Name, Dir: o.Dir, GitDir: o.GitDir})\n}","lineStart":1,"lineEnd":612,"totalLines":612,"truncated":false}},"title":"src/internal/serve/mutate.go","time":{"start":1787993698491,"end":1787993698503}},"id":"prt_04cbab0b5001PjkppYbVCDtp53","sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","messageID":"msg_04cba96dd001RUxsoonFItyVoy"}}
{"type":"step_finish","timestamp":1787993698543,"sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","part":{"id":"prt_04cbab0e8001DE7m16FIF4xPwd","reason":"tool-calls","snapshot":"","messageID":"msg_04cba96dd001RUxsoonFItyVoy","sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","type":"step-finish","tokens":{"total":36999,"input":560,"output":34,"reasoning":181,"cache":{"write":0,"read":36224}},"cost":0}}
{"type":"step_start","timestamp":1787993700815,"sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","part":{"id":"prt_04cbab9c9001BT3gLQ26YBUj0y","messageID":"msg_04cbab0ed001FOs0ygD5XlWc8Z","sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","snapshot":"","type":"step-start"}}
{"type":"tool_use","timestamp":1787993701357,"sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","part":{"type":"tool","tool":"read","callID":"call_f288fa9189484d7aa3060d24","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/api.go"},"output":"<path>/workspace/src/internal/serve/api.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"encoding/json\"\n5: \t\"errors\"\n6: \t\"fmt\"\n7: \t\"io\"\n8: \t\"net/http\"\n9: \t\"os\"\n10: \t\"path/filepath\"\n11: \t\"strings\"\n12: \t\"time\"\n13: \n14: \t\"github.com/lmuskalla/manigot/internal/agentlist\"\n15: \t\"github.com/lmuskalla/manigot/internal/config\"\n16: \t\"github.com/lmuskalla/manigot/internal/git\"\n17: \t\"github.com/lmuskalla/manigot/internal/job\"\n18: \t\"github.com/lmuskalla/manigot/internal/project\"\n19: \t\"github.com/lmuskalla/manigot/internal/session\"\n20: )\n21: \n22: // --- JSON helpers ------------------------------------------------------------\n23: \n24: // writeJSON writes v as a JSON response with the given status.\n25: func writeJSON(w http.ResponseWriter, status int, v any) {\n26: \tw.Header().Set(\"Content-Type\", \"application/json\")\n27: \tw.WriteHeader(status)\n28: \t_ = json.NewEncoder(w).Encode(v)\n29: }\n30: \n31: // apiError is the JSON error envelope every non-2xx response carries.\n32: type apiError struct {\n33: \tError string `json:\"error\"`\n34: }\n35: \n36: // writeError writes a JSON error envelope with the given status.\n37: func writeError(w http.ResponseWriter, status int, msg string) {\n38: \twriteJSON(w, status, apiError{Error: msg})\n39: }\n40: \n41: // --- Resolution helpers — the zero-path-inputs choke point -------------------\n42: //\n43: // Every handler resolves its URL segments ONLY through these helpers. A\n44: // segment is validated as a plain identifier (validSegment), then matched —\n45: // never joined into a filesystem path. The registered roots (TASK-1), the\n46: // discovered jobs, and the file whitelist are the only sources of paths the\n47: // handlers ever open.\n48: \n49: // validSegment reports whether a URL segment is a plain, trustworthy\n50: // identifier: non-empty, not \".\" or \"..\" (traversal), containing no path\n51: // separator (forward or backslash — the backslash is a Windows separator and\n52: // must never reach a filesystem path), and no NUL byte. Percent-encoded and\n53: // double-encoded variants all decode to one of these forms before matching,\n54: // so rejecting the decoded form rejects them all.\n55: func validSegment(seg string) bool {\n56: \tif seg == \"\" || seg == \".\" || seg == \"..\" {\n57: \t\treturn false\n58: \t}\n59: \tif strings.ContainsAny(seg, \"/\\\\\") {\n60: \t\treturn false\n61: \t}\n62: \treturn !strings.ContainsRune(seg, 0)\n63: }\n64: \n65: // resolveProject maps a URL project segment to a registered root. The segment\n66: // is validated, then matched against the registry by configured entry name\n67: // only (Registry.Project) — it is never joined into a filesystem path. An\n68: // invalid segment or no match is a 404; the handler returns false and must\n69: // return immediately.\n70: func (s *Server) resolveProject(w http.ResponseWriter, segment string) (string, bool) {\n71: \tif !validSegment(segment) {\n72: \t\twriteError(w, http.StatusNotFound, \"project not found\")\n73: \t\treturn \"\", false\n74: \t}\n75: \troot, ok := s.reg.Project(segment)\n76: \tif !ok {\n77: \t\twriteError(w, http.StatusNotFound, \"project not found\")\n78: \t\treturn \"\", false\n79: \t}\n80: \treturn root, true\n81: }\n82: \n83: // resolveJob maps a URL job segment to a discovered job under root. The\n84: // segment is validated, then matched against the project's discovered jobs by\n85: // ID, then by id_slug name (the job directory name — the same identity the\n86: // CLI's branch-tail matching uses), then by unique name prefix. It is never\n87: // treated as a path. Not-found is a 404; an ambiguous prefix is a 409; the\n88: // handler returns false and must return immediately.\n89: func (s *Server) resolveJob(w http.ResponseWriter, root, segment string) (job.Job, bool) {\n90: \tif !validSegment(segment) {\n91: \t\twriteError(w, http.StatusNotFound, \"job not found\")\n92: \t\treturn job.Job{}, false\n93: \t}\n94: \tjobs, err := job.Discover(root)\n95: \tif err != nil {\n96: \t\twriteError(w, http.StatusInternalServerError, \"cannot read jobs\")\n97: \t\treturn job.Job{}, false\n98: \t}\n99: \n100: \t// Exact by ID, then by name.\n101: \tfor _, j := range jobs {\n102: \t\tif j.ID == segment || j.Name == segment {\n103: \t\t\treturn j, true\n104: \t\t}\n105: \t}\n106: \n107: \t// Unique prefix on the name.\n108: \tvar matches []job.Job\n109: \tfor _, j := range jobs {\n110: \t\tif strings.HasPrefix(j.Name, segment) {\n111: \t\t\tmatches = append(matches, j)\n112: \t\t}\n113: \t}\n114: \tswitch len(matches) {\n115: \tcase 0:\n116: \t\twriteError(w, http.StatusNotFound, fmt.Sprintf(\"job '%s' not found among the project's jobs\", segment))\n117: \t\treturn job.Job{}, false\n118: \tcase 1:\n119: \t\treturn matches[0], true\n120: \tdefault:\n121: \t\tnames := make([]string, 0, len(matches))\n122: \t\tfor _, j := range matches {\n123: \t\t\tnames = append(names, j.Name)\n124: \t\t}\n125: \t\twriteError(w, http.StatusConflict, fmt.Sprintf(\"job '%s' is ambiguous — matches jobs: %s\", segment, strings.Join(names, \" \")))\n126: \t\treturn job.Job{}, false\n127: \t}\n128: }\n129: \n130: // jobFileNames is the whitelist of job files the API serves: a job's four\n131: // markdown files, read as raw markdown text. Nothing else under the job dir\n132: // is ever served.\n133: var jobFileNames = map[string]bool{\n134: \t\"brief.md\":          true,\n135: \t\"tasks.md\":          true,\n136: \t\"implementation.md\": true,\n137: \t\"verdict.md\":        true,\n138: }\n139: \n140: // --- /health -----------------------------------------------------------------\n141: \n142: // healthProfileRow is one profile's credential readiness in the /health\n143: // response: ready = the profile's ResolveProfile + CheckAuth succeed (the\n144: // same check the session launcher runs). A missing key is \"not ready\", never\n145: // an error; the credential values themselves are never reported.\n146: type healthProfileRow struct {\n147: \tID    string `json:\"id\"`\n148: \tReady bool   `json:\"ready\"`\n149: }\n150: \n151: // healthResponse is the /health response shape: the mg version, whether the\n152: // docker image is present (session.ImagePresent), and per-profile readiness.\n153: type healthResponse struct {\n154: \tVersion      string             `json:\"version\"`\n155: \tImagePresent bool               `json:\"imagePresent\"`\n156: \tProfiles     []healthProfileRow `json:\"profiles\"`\n157: }\n158: \n159: // profileReady reduces a profile's credential check to a boolean.\n160: func profileReady(id string) bool {\n161: \tinfo, err := session.ResolveProfile(session.Options{Profile: id})\n162: \tif err != nil {\n163: \t\treturn false\n164: \t}\n165: \treturn info.CheckAuth() == nil\n166: }\n167: \n168: // handleHealth serves the daemon's health/status: version, docker image\n169: // presence, and profile readiness — pure booleans and identifiers, never\n170: // credential material.\n171: func (s *Server) handleHealth(w http.ResponseWriter, r *http.Request) {\n172: \tresp := healthResponse{\n173: \t\tVersion:      s.version,\n174: \t\tImagePresent: session.ImagePresent(),\n175: \t}\n176: \tfor _, p := range config.Profiles() {\n177: \t\tresp.Profiles = append(resp.Profiles, healthProfileRow{ID: p.ID, Ready: profileReady(p.ID)})\n178: \t}\n179: \twriteJSON(w, http.StatusOK, resp)\n180: }\n181: \n182: // --- /projects ---------------------------------------------------------------\n183: \n184: // projectRow is one entry in the /projects response: a registered root and\n185: // its configured name (the URL segment that resolves to it).\n186: type projectRow struct {\n187: \tPath string `json:\"path\"`\n188: \tName string `json:\"name\"`\n189: }\n190: \n191: // projectsResponse is the /projects response shape.\n192: type projectsResponse struct {\n193: \tProjects []projectRow `json:\"projects\"`\n194: }\n195: \n196: // handleProjects lists the registered project roots — pure registry data, the\n197: // daemon never scans for projects it does not know.\n198: func (s *Server) handleProjects(w http.ResponseWriter, r *http.Request) {\n199: \tentries := s.reg.Entries()\n200: \trows := make([]projectRow, 0, len(entries))\n201: \tfor _, e := range entries {\n202: \t\trows = append(rows, projectRow{Path: e.Path, Name: e.Name})\n203: \t}\n204: \twriteJSON(w, http.StatusOK, projectsResponse{Projects: rows})\n205: }\n206: \n207: // --- /projects/{project}/jobs ------------------------------------------------\n208: \n209: // jdiStatusRow is the mg-jdi activity state for a job: state / agent / last\n210: // update, from the job's status sidecar. Omitted when there is no live run\n211: // state (a job mg-jdi never drove, or a stale/unreadable sidecar).\n212: type jdiStatusRow struct {\n213: \tState   string `json:\"state\"`\n214: \tAgent   string `json:\"agent\"`\n215: \tUpdated string `json:\"updated\"` // RFC3339\n216: }\n217: \n218: // jobRow is one row in the jobs response — the TUI's info design: id / status\n219: // / stage / type / date / title, one row per job, in job.Discover's sort\n220: // order (newest first).\n221: type jobRow struct {\n222: \tID     string        `json:\"id\"`\n223: \tName   string        `json:\"name\"`\n224: \tStatus string        `json:\"status\"`\n225: \tStage  string        `json:\"stage\"`\n226: \tType   string        `json:\"type\"`\n227: \tDate   string        `json:\"date\"`\n228: \tTitle  string        `json:\"title\"`\n229: \tBranch string        `json:\"branch,omitempty\"`\n230: \tJDI    *jdiStatusRow `json:\"jdi,omitempty\"`\n231: }\n232: \n233: // jobsResponse is the /projects/{project}/jobs response shape.\n234: type jobsResponse struct {\n235: \tJobs []jobRow `json:\"jobs\"`\n236: }\n237: \n238: // handleProjectJobs lists a project's open jobs with the mg-jdi activity\n239: // state per job.\n240: func (s *Server) handleProjectJobs(w http.ResponseWriter, r *http.Request) {\n241: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n242: \tif !ok {\n243: \t\treturn\n244: \t}\n245: \tjobs, err := job.Discover(root)\n246: \tif err != nil {\n247: \t\twriteError(w, http.StatusInternalServerError, \"cannot read jobs\")\n248: \t\treturn\n249: \t}\n250: \trows := make([]jobRow, 0, len(jobs))\n251: \tfor _, j := range jobs {\n252: \t\trow := jobRow{\n253: \t\t\tID:     j.ID,\n254: \t\t\tName:   j.Name,\n255: \t\t\tStatus: j.Status,\n256: \t\t\tStage:  string(j.Stage()),\n257: \t\t\tType:   j.Type,\n258: \t\t\tDate:   j.Date,\n259: \t\t\tTitle:  j.Title,\n260: \t\t\tBranch: j.Branch,\n261: \t\t}\n262: \t\tif st, ok := job.ReadJDIStatus(root, j.Name); ok {\n263: \t\t\trow.JDI = &jdiStatusRow{\n264: \t\t\t\tState:   string(st.State),\n265: \t\t\t\tAgent:   st.Agent,\n266: \t\t\t\tUpdated: st.Updated.Format(time.RFC3339),\n267: \t\t\t}\n268: \t\t}\n269: \t\trows = append(rows, row)\n270: \t}\n271: \twriteJSON(w, http.StatusOK, jobsResponse{Jobs: rows})\n272: }\n273: \n274: // --- /projects/{project}/jobs/{job}/files/{file} -----------------------------\n275: \n276: // handleJobFile serves one of a job's four markdown files as raw markdown\n277: // text. The file segment is whitelisted (jobFileNames); a missing file is a\n278: // normal 404 (e.g. verdict.md before review).\n279: func (s *Server) handleJobFile(w http.ResponseWriter, r *http.Request) {\n280: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n281: \tif !ok {\n282: \t\treturn\n283: \t}\n284: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n285: \tif !ok {\n286: \t\treturn\n287: \t}\n288: \tfile := r.PathValue(\"file\")\n289: \tif !jobFileNames[file] {\n290: \t\twriteError(w, http.StatusNotFound, \"file not found\")\n291: \t\treturn\n292: \t}\n293: \tdata, err := os.ReadFile(filepath.Join(j.Dir, file))\n294: \tif err != nil {\n295: \t\twriteError(w, http.StatusNotFound, \"file not found\")\n296: \t\treturn\n297: \t}\n298: \tw.Header().Set(\"Content-Type\", \"text/markdown; charset=utf-8\")\n299: \tw.WriteHeader(http.StatusOK)\n300: \t_, _ = w.Write(data)\n301: }\n302: \n303: // --- /projects/{project}/jobs/{job}/jdi -------------------------------------\n304: \n305: // jobJDIResponse is the /projects/{project}/jobs/{job}/jdi response shape:\n306: // the mg-jdi status (state/agent/updated — null when there is no live run\n307: // state), the run.log tail (null when mg-jdi never ran the job), and the\n308: // job's session.log tail (null when no run output was captured yet — a\n309: // normal \"no run yet\", not an error).\n310: type jobJDIResponse struct {\n311: \tStatus     *jdiStatusRow `json:\"status\"`\n312: \tRunLog     *string       `json:\"runLog\"`\n313: \tSessionLog *string       `json:\"sessionLog\"`\n314: }\n315: \n316: // tailBytes bounds how much of a log file the jdi endpoint loads into memory\n317: // — a tail, not \"load everything\", the same bounded-viewport approach\n318: // job.ReadJDIRunLogTail already uses for run.log (256 KiB, generous enough\n319: // for many invocations' worth of text while a small, fixed cost).\n320: const tailBytes = 256 * 1024\n321: \n322: // readFileTail returns the last tailBytes of the file at path — the\n323: // session.log counterpart of job.ReadJDIRunLogTail, applied to a job-dir file\n324: // (docs/jobs/<name>/session.log). A possibly-partial first line is dropped so\n325: // the tail starts at a clean boundary, with a truncation marker. ok is false\n326: // only when the file is missing; an existing-but-empty file is (\"\", true).\n327: func readFileTail(path string) (string, bool) {\n328: \tf, err := os.Open(path)\n329: \tif err != nil {\n330: \t\treturn \"\", false\n331: \t}\n332: \tdefer f.Close()\n333: \n334: \tinfo, err := f.Stat()\n335: \tif err != nil {\n336: \t\treturn \"\", false\n337: \t}\n338: \tsize := info.Size()\n339: \tif size == 0 {\n340: \t\treturn \"\", true\n341: \t}\n342: \n343: \tstart := int64(0)\n344: \ttruncated := false\n345: \tif size > tailBytes {\n346: \t\tstart = size - tailBytes\n347: \t\ttruncated = true\n348: \t}\n349: \tif _, err := f.Seek(start, io.SeekStart); err != nil {\n350: \t\treturn \"\", false\n351: \t}\n352: \tdata, err := io.ReadAll(f)\n353: \tif err != nil {\n354: \t\treturn \"\", false\n355: \t}\n356: \n357: \ttext := string(data)\n358: \tif truncated {\n359: \t\tif idx := strings.IndexByte(text, '\\n'); idx >= 0 {\n360: \t\t\ttext = text[idx+1:]\n361: \t\t}\n362: \t\ttext = \"… (log truncated — showing the most recent portion)\\n\\n\" + text\n363: \t}\n364: \treturn text, true\n365: }\n366: \n367: // handleJobJDI serves a job's mg-jdi run state and its captured logs: the\n368: // status sidecar (ReadJDIStatus), the run.log tail (ReadJDIRunLogTail), and\n369: // the job's own session.log tail. All three are file reads scoped to the\n370: // resolved root/job — never client-supplied paths.\n371: func (s *Server) handleJobJDI(w http.ResponseWriter, r *http.Request) {\n372: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n373: \tif !ok {\n374: \t\treturn\n375: \t}\n376: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n377: \tif !ok {\n378: \t\treturn\n379: \t}\n380: \n381: \tresp := jobJDIResponse{}\n382: \tif st, ok := job.ReadJDIStatus(root, j.Name); ok {\n383: \t\tresp.Status = &jdiStatusRow{\n384: \t\t\tState:   string(st.State),\n385: \t\t\tAgent:   st.Agent,\n386: \t\t\tUpdated: st.Updated.Format(time.RFC3339),\n387: \t\t}\n388: \t}\n389: \tif text, ok := job.ReadJDIRunLogTail(root, j.Name); ok {\n390: \t\tresp.RunLog = &text\n391: \t}\n392: \tif text, ok := readFileTail(filepath.Join(j.Dir, \"session.log\")); ok {\n393: \t\tresp.SessionLog = &text\n394: \t}\n395: \twriteJSON(w, http.StatusOK, resp)\n396: }\n397: \n398: // --- /projects/{project}/jobs/{job}/diff ------------------------------------\n399: \n400: // jobDiffResponse is the /projects/{project}/jobs/{job}/diff response shape.\n401: // Without ?full=1 it is the \"quick eyeball\" — the branch's commits\n402: // (git.LogOneline) and its changed files (git.DiffStat), the same two calls\n403: // `mg diff` makes. With ?full=1 it is the complete patch (git.Diff). The\n404: // three-dot range <base>...<branch> is resolved exactly as mg diff resolves\n405: // it.\n406: type jobDiffResponse struct {\n407: \tLog   *string `json:\"log,omitempty\"`\n408: \tStat  *string `json:\"stat,omitempty\"`\n409: \tPatch *string `json:\"patch,omitempty\"`\n410: }\n411: \n412: // errJobBranchNotFound / errJobBranchAmbiguous classify a failed job→branch\n413: // resolution so the handler can map them to 404 / 409 with the CLI's wording.\n414: var (\n415: \terrJobBranchNotFound  = errors.New(\"job branch not found\")\n416: \terrJobBranchAmbiguous = errors.New(\"job branch ambiguous\")\n417: )\n418: \n419: // resolveJobBranch mirrors cmd/mg/diff.go's resolveJobBranch — the same\n420: // exact-then-prefix matching on the branch's id_slug tail segment, with the\n421: // same error wording. Not-found and ambiguity are classified (errors.Is) so\n422: // the API can map them onto 404 / 409.\n423: func resolveJobBranch(branches []string, jobArg string) (string, error) {\n424: \tif branch := git.ExactBranchMatch(branches, jobArg); branch != \"\" {\n425: \t\treturn branch, nil\n426: \t}\n427: \tprefixMatches := git.PrefixBranchMatches(branches, jobArg)\n428: \tswitch len(prefixMatches) {\n429: \tcase 0:\n430: \t\tmsg := fmt.Sprintf(\"job '%s' not found among local branches.\\nActive job branches:\", jobArg)\n431: \t\tfor _, b := range branches {\n432: \t\t\tmsg += \"\\n  \" + b\n433: \t\t}\n434: \t\treturn \"\", fmt.Errorf(\"%w: %s\", errJobBranchNotFound, msg)\n435: \tcase 1:\n436: \t\treturn prefixMatches[0], nil\n437: \tdefault:\n438: \t\treturn \"\", fmt.Errorf(\"%w: job '%s' is ambiguous — matches branches: %s\", errJobBranchAmbiguous, jobArg, strings.Join(prefixMatches, \" \"))\n439: \t}\n440: }\n441: \n442: // handleJobDiff serves a job's branch diff against the project's base branch\n443: // — the `mg diff` quick eyeball (log + stat) or, with ?full=1, the complete\n444: // patch. The base branch resolves exactly as mg diff does (the project's\n445: // configured baseBranch, falling back to origin/HEAD → main); the job→branch\n446: // resolution is the CLI's exact-then-prefix chain. All git access goes\n447: // through internal/git — the package that owns every git shell-out. Read-only\n448: // git commands only.\n449: func (s *Server) handleJobDiff(w http.ResponseWriter, r *http.Request) {\n450: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n451: \tif !ok {\n452: \t\treturn\n453: \t}\n454: \tjobArg := r.PathValue(\"job\")\n455: \tif !validSegment(jobArg) {\n456: \t\twriteError(w, http.StatusNotFound, \"job not found\")\n457: \t\treturn\n458: \t}\n459: \n460: \tbranches, err := git.LocalBranches(root)\n461: \tif err != nil {\n462: \t\twriteError(w, http.StatusInternalServerError, \"cannot read branches\")\n463: \t\treturn\n464: \t}\n465: \tbranch, err := resolveJobBranch(branches, jobArg)\n466: \tif err != nil {\n467: \t\tswitch {\n468: \t\tcase errors.Is(err, errJobBranchAmbiguous):\n469: \t\t\twriteError(w, http.StatusConflict, strings.TrimPrefix(err.Error(), \"job branch ambiguous: \"))\n470: \t\tdefault:\n471: \t\t\twriteError(w, http.StatusNotFound, strings.TrimPrefix(err.Error(), \"job branch not found: \"))\n472: \t\t}\n473: \t\treturn\n474: \t}\n475: \n476: \tsettings, err := project.Load(root)\n477: \tif err != nil {\n478: \t\twriteError(w, http.StatusInternalServerError, \"cannot read project settings\")\n479: \t\treturn\n480: \t}\n481: \tbase := settings.BaseBranch\n482: \tif base == \"\" {\n483: \t\tbase = git.SymbolicRefHead(root)\n484: \t}\n485: \n486: \tif r.URL.Query().Get(\"full\") == \"1\" {\n487: \t\tpatch, err := git.Diff(root, base, branch)\n488: \t\tif err != nil {\n489: \t\t\twriteError(w, http.StatusInternalServerError, \"cannot compute diff\")\n490: \t\t\treturn\n491: \t\t}\n492: \t\twriteJSON(w, http.StatusOK, jobDiffResponse{Patch: &patch})\n493: \t\treturn\n494: \t}\n495: \n496: \tlogs, err := git.LogOneline(root, base, branch)\n497: \tif err != nil {\n498: \t\twriteError(w, http.StatusInternalServerError, \"cannot read log\")\n499: \t\treturn\n500: \t}\n501: \tstat, err := git.DiffStat(root, base, branch)\n502: \tif err != nil {\n503: \t\twriteError(w, http.StatusInternalServerError, \"cannot read diff stat\")\n504: \t\treturn\n505: \t}\n506: \twriteJSON(w, http.StatusOK, jobDiffResponse{Log: &logs, Stat: &stat})\n507: }\n508: \n509: // --- /projects/{project}/agents ---------------------------------------------\n510: \n511: // agentRow is one entry in the agents response: name and one-line description\n512: // only — never the agent files' contents beyond the description line.\n513: type agentRow struct {\n514: \tName        string `json:\"name\"`\n515: \tDescription string `json:\"description\"`\n516: }\n517: \n518: // agentsResponse is the /projects/{project}/agents response shape.\n519: type agentsResponse struct {\n520: \tAgents []agentRow `json:\"agents\"`\n521: }\n522: \n523: // handleProjectAgents lists the agents available to a project — the `mg\n524: // agents` list (agentlist.Discover), name + description only.\n525: func (s *Server) handleProjectAgents(w http.ResponseWriter, r *http.Request) {\n526: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n527: \tif !ok {\n528: \t\treturn\n529: \t}\n530: \tagents, err := agentlist.Discover(root)\n531: \tif err != nil {\n532: \t\twriteError(w, http.StatusInternalServerError, \"cannot list agents\")\n533: \t\treturn\n534: \t}\n535: \trows := make([]agentRow, 0, len(agents))\n536: \tfor _, a := range agents {\n537: \t\trows = append(rows, agentRow{Name: a.Name, Description: a.Description})\n538: \t}\n539: \twriteJSON(w, http.StatusOK, agentsResponse{Agents: rows})\n540: }\n\n(End of file - total 540 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/agentlist\"\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n\t\"github.com/lmuskalla/manigot/internal/session\"\n)","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/api.go","text":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/agentlist\"\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n\t\"github.com/lmuskalla/manigot/internal/session\"\n)\n\n// --- JSON helpers ------------------------------------------------------------\n\n// writeJSON writes v as a JSON response with the given status.\nfunc writeJSON(w http.ResponseWriter, status int, v any) {\n\tw.Header().Set(\"Content-Type\", \"application/json\")\n\tw.WriteHeader(status)\n\t_ = json.NewEncoder(w).Encode(v)\n}\n\n// apiError is the JSON error envelope every non-2xx response carries.\ntype apiError struct {\n\tError string `json:\"error\"`\n}\n\n// writeError writes a JSON error envelope with the given status.\nfunc writeError(w http.ResponseWriter, status int, msg string) {\n\twriteJSON(w, status, apiError{Error: msg})\n}\n\n// --- Resolution helpers — the zero-path-inputs choke point -------------------\n//\n// Every handler resolves its URL segments ONLY through these helpers. A\n// segment is validated as a plain identifier (validSegment), then matched —\n// never joined into a filesystem path. The registered roots (TASK-1), the\n// discovered jobs, and the file whitelist are the only sources of paths the\n// handlers ever open.\n\n// validSegment reports whether a URL segment is a plain, trustworthy\n// identifier: non-empty, not \".\" or \"..\" (traversal), containing no path\n// separator (forward or backslash — the backslash is a Windows separator and\n// must never reach a filesystem path), and no NUL byte. Percent-encoded and\n// double-encoded variants all decode to one of these forms before matching,\n// so rejecting the decoded form rejects them all.\nfunc validSegment(seg string) bool {\n\tif seg == \"\" || seg == \".\" || seg == \"..\" {\n\t\treturn false\n\t}\n\tif strings.ContainsAny(seg, \"/\\\\\") {\n\t\treturn false\n\t}\n\treturn !strings.ContainsRune(seg, 0)\n}\n\n// resolveProject maps a URL project segment to a registered root. The segment\n// is validated, then matched against the registry by configured entry name\n// only (Registry.Project) — it is never joined into a filesystem path. An\n// invalid segment or no match is a 404; the handler returns false and must\n// return immediately.\nfunc (s *Server) resolveProject(w http.ResponseWriter, segment string) (string, bool) {\n\tif !validSegment(segment) {\n\t\twriteError(w, http.StatusNotFound, \"project not found\")\n\t\treturn \"\", false\n\t}\n\troot, ok := s.reg.Project(segment)\n\tif !ok {\n\t\twriteError(w, http.StatusNotFound, \"project not found\")\n\t\treturn \"\", false\n\t}\n\treturn root, true\n}\n\n// resolveJob maps a URL job segment to a discovered job under root. The\n// segment is validated, then matched against the project's discovered jobs by\n// ID, then by id_slug name (the job directory name — the same identity the\n// CLI's branch-tail matching uses), then by unique name prefix. It is never\n// treated as a path. Not-found is a 404; an ambiguous prefix is a 409; the\n// handler returns false and must return immediately.\nfunc (s *Server) resolveJob(w http.ResponseWriter, root, segment string) (job.Job, bool) {\n\tif !validSegment(segment) {\n\t\twriteError(w, http.StatusNotFound, \"job not found\")\n\t\treturn job.Job{}, false\n\t}\n\tjobs, err := job.Discover(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read jobs\")\n\t\treturn job.Job{}, false\n\t}\n\n\t// Exact by ID, then by name.\n\tfor _, j := range jobs {\n\t\tif j.ID == segment || j.Name == segment {\n\t\t\treturn j, true\n\t\t}\n\t}\n\n\t// Unique prefix on the name.\n\tvar matches []job.Job\n\tfor _, j := range jobs {\n\t\tif strings.HasPrefix(j.Name, segment) {\n\t\t\tmatches = append(matches, j)\n\t\t}\n\t}\n\tswitch len(matches) {\n\tcase 0:\n\t\twriteError(w, http.StatusNotFound, fmt.Sprintf(\"job '%s' not found among the project's jobs\", segment))\n\t\treturn job.Job{}, false\n\tcase 1:\n\t\treturn matches[0], true\n\tdefault:\n\t\tnames := make([]string, 0, len(matches))\n\t\tfor _, j := range matches {\n\t\t\tnames = append(names, j.Name)\n\t\t}\n\t\twriteError(w, http.StatusConflict, fmt.Sprintf(\"job '%s' is ambiguous — matches jobs: %s\", segment, strings.Join(names, \" \")))\n\t\treturn job.Job{}, false\n\t}\n}\n\n// jobFileNames is the whitelist of job files the API serves: a job's four\n// markdown files, read as raw markdown text. Nothing else under the job dir\n// is ever served.\nvar jobFileNames = map[string]bool{\n\t\"brief.md\":          true,\n\t\"tasks.md\":          true,\n\t\"implementation.md\": true,\n\t\"verdict.md\":        true,\n}\n\n// --- /health -----------------------------------------------------------------\n\n// healthProfileRow is one profile's credential readiness in the /health\n// response: ready = the profile's ResolveProfile + CheckAuth succeed (the\n// same check the session launcher runs). A missing key is \"not ready\", never\n// an error; the credential values themselves are never reported.\ntype healthProfileRow struct {\n\tID    string `json:\"id\"`\n\tReady bool   `json:\"ready\"`\n}\n\n// healthResponse is the /health response shape: the mg version, whether the\n// docker image is present (session.ImagePresent), and per-profile readiness.\ntype healthResponse struct {\n\tVersion      string             `json:\"version\"`\n\tImagePresent bool               `json:\"imagePresent\"`\n\tProfiles     []healthProfileRow `json:\"profiles\"`\n}\n\n// profileReady reduces a profile's credential check to a boolean.\nfunc profileReady(id string) bool {\n\tinfo, err := session.ResolveProfile(session.Options{Profile: id})\n\tif err != nil {\n\t\treturn false\n\t}\n\treturn info.CheckAuth() == nil\n}\n\n// handleHealth serves the daemon's health/status: version, docker image\n// presence, and profile readiness — pure booleans and identifiers, never\n// credential material.\nfunc (s *Server) handleHealth(w http.ResponseWriter, r *http.Request) {\n\tresp := healthResponse{\n\t\tVersion:      s.version,\n\t\tImagePresent: session.ImagePresent(),\n\t}\n\tfor _, p := range config.Profiles() {\n\t\tresp.Profiles = append(resp.Profiles, healthProfileRow{ID: p.ID, Ready: profileReady(p.ID)})\n\t}\n\twriteJSON(w, http.StatusOK, resp)\n}\n\n// --- /projects ---------------------------------------------------------------\n\n// projectRow is one entry in the /projects response: a registered root and\n// its configured name (the URL segment that resolves to it).\ntype projectRow struct {\n\tPath string `json:\"path\"`\n\tName string `json:\"name\"`\n}\n\n// projectsResponse is the /projects response shape.\ntype projectsResponse struct {\n\tProjects []projectRow `json:\"projects\"`\n}\n\n// handleProjects lists the registered project roots — pure registry data, the\n// daemon never scans for projects it does not know.\nfunc (s *Server) handleProjects(w http.ResponseWriter, r *http.Request) {\n\tentries := s.reg.Entries()\n\trows := make([]projectRow, 0, len(entries))\n\tfor _, e := range entries {\n\t\trows = append(rows, projectRow{Path: e.Path, Name: e.Name})\n\t}\n\twriteJSON(w, http.StatusOK, projectsResponse{Projects: rows})\n}\n\n// --- /projects/{project}/jobs ------------------------------------------------\n\n// jdiStatusRow is the mg-jdi activity state for a job: state / agent / last\n// update, from the job's status sidecar. Omitted when there is no live run\n// state (a job mg-jdi never drove, or a stale/unreadable sidecar).\ntype jdiStatusRow struct {\n\tState   string `json:\"state\"`\n\tAgent   string `json:\"agent\"`\n\tUpdated string `json:\"updated\"` // RFC3339\n}\n\n// jobRow is one row in the jobs response — the TUI's info design: id / status\n// / stage / type / date / title, one row per job, in job.Discover's sort\n// order (newest first).\ntype jobRow struct {\n\tID     string        `json:\"id\"`\n\tName   string        `json:\"name\"`\n\tStatus string        `json:\"status\"`\n\tStage  string        `json:\"stage\"`\n\tType   string        `json:\"type\"`\n\tDate   string        `json:\"date\"`\n\tTitle  string        `json:\"title\"`\n\tBranch string        `json:\"branch,omitempty\"`\n\tJDI    *jdiStatusRow `json:\"jdi,omitempty\"`\n}\n\n// jobsResponse is the /projects/{project}/jobs response shape.\ntype jobsResponse struct {\n\tJobs []jobRow `json:\"jobs\"`\n}\n\n// handleProjectJobs lists a project's open jobs with the mg-jdi activity\n// state per job.\nfunc (s *Server) handleProjectJobs(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tjobs, err := job.Discover(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read jobs\")\n\t\treturn\n\t}\n\trows := make([]jobRow, 0, len(jobs))\n\tfor _, j := range jobs {\n\t\trow := jobRow{\n\t\t\tID:     j.ID,\n\t\t\tName:   j.Name,\n\t\t\tStatus: j.Status,\n\t\t\tStage:  string(j.Stage()),\n\t\t\tType:   j.Type,\n\t\t\tDate:   j.Date,\n\t\t\tTitle:  j.Title,\n\t\t\tBranch: j.Branch,\n\t\t}\n\t\tif st, ok := job.ReadJDIStatus(root, j.Name); ok {\n\t\t\trow.JDI = &jdiStatusRow{\n\t\t\t\tState:   string(st.State),\n\t\t\t\tAgent:   st.Agent,\n\t\t\t\tUpdated: st.Updated.Format(time.RFC3339),\n\t\t\t}\n\t\t}\n\t\trows = append(rows, row)\n\t}\n\twriteJSON(w, http.StatusOK, jobsResponse{Jobs: rows})\n}\n\n// --- /projects/{project}/jobs/{job}/files/{file} -----------------------------\n\n// handleJobFile serves one of a job's four markdown files as raw markdown\n// text. The file segment is whitelisted (jobFileNames); a missing file is a\n// normal 404 (e.g. verdict.md before review).\nfunc (s *Server) handleJobFile(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\tfile := r.PathValue(\"file\")\n\tif !jobFileNames[file] {\n\t\twriteError(w, http.StatusNotFound, \"file not found\")\n\t\treturn\n\t}\n\tdata, err := os.ReadFile(filepath.Join(j.Dir, file))\n\tif err != nil {\n\t\twriteError(w, http.StatusNotFound, \"file not found\")\n\t\treturn\n\t}\n\tw.Header().Set(\"Content-Type\", \"text/markdown; charset=utf-8\")\n\tw.WriteHeader(http.StatusOK)\n\t_, _ = w.Write(data)\n}\n\n// --- /projects/{project}/jobs/{job}/jdi -------------------------------------\n\n// jobJDIResponse is the /projects/{project}/jobs/{job}/jdi response shape:\n// the mg-jdi status (state/agent/updated — null when there is no live run\n// state), the run.log tail (null when mg-jdi never ran the job), and the\n// job's session.log tail (null when no run output was captured yet — a\n// normal \"no run yet\", not an error).\ntype jobJDIResponse struct {\n\tStatus     *jdiStatusRow `json:\"status\"`\n\tRunLog     *string       `json:\"runLog\"`\n\tSessionLog *string       `json:\"sessionLog\"`\n}\n\n// tailBytes bounds how much of a log file the jdi endpoint loads into memory\n// — a tail, not \"load everything\", the same bounded-viewport approach\n// job.ReadJDIRunLogTail already uses for run.log (256 KiB, generous enough\n// for many invocations' worth of text while a small, fixed cost).\nconst tailBytes = 256 * 1024\n\n// readFileTail returns the last tailBytes of the file at path — the\n// session.log counterpart of job.ReadJDIRunLogTail, applied to a job-dir file\n// (docs/jobs/<name>/session.log). A possibly-partial first line is dropped so\n// the tail starts at a clean boundary, with a truncation marker. ok is false\n// only when the file is missing; an existing-but-empty file is (\"\", true).\nfunc readFileTail(path string) (string, bool) {\n\tf, err := os.Open(path)\n\tif err != nil {\n\t\treturn \"\", false\n\t}\n\tdefer f.Close()\n\n\tinfo, err := f.Stat()\n\tif err != nil {\n\t\treturn \"\", false\n\t}\n\tsize := info.Size()\n\tif size == 0 {\n\t\treturn \"\", true\n\t}\n\n\tstart := int64(0)\n\ttruncated := false\n\tif size > tailBytes {\n\t\tstart = size - tailBytes\n\t\ttruncated = true\n\t}\n\tif _, err := f.Seek(start, io.SeekStart); err != nil {\n\t\treturn \"\", false\n\t}\n\tdata, err := io.ReadAll(f)\n\tif err != nil {\n\t\treturn \"\", false\n\t}\n\n\ttext := string(data)\n\tif truncated {\n\t\tif idx := strings.IndexByte(text, '\\n'); idx >= 0 {\n\t\t\ttext = text[idx+1:]\n\t\t}\n\t\ttext = \"… (log truncated — showing the most recent portion)\\n\\n\" + text\n\t}\n\treturn text, true\n}\n\n// handleJobJDI serves a job's mg-jdi run state and its captured logs: the\n// status sidecar (ReadJDIStatus), the run.log tail (ReadJDIRunLogTail), and\n// the job's own session.log tail. All three are file reads scoped to the\n// resolved root/job — never client-supplied paths.\nfunc (s *Server) handleJobJDI(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\tresp := jobJDIResponse{}\n\tif st, ok := job.ReadJDIStatus(root, j.Name); ok {\n\t\tresp.Status = &jdiStatusRow{\n\t\t\tState:   string(st.State),\n\t\t\tAgent:   st.Agent,\n\t\t\tUpdated: st.Updated.Format(time.RFC3339),\n\t\t}\n\t}\n\tif text, ok := job.ReadJDIRunLogTail(root, j.Name); ok {\n\t\tresp.RunLog = &text\n\t}\n\tif text, ok := readFileTail(filepath.Join(j.Dir, \"session.log\")); ok {\n\t\tresp.SessionLog = &text\n\t}\n\twriteJSON(w, http.StatusOK, resp)\n}\n\n// --- /projects/{project}/jobs/{job}/diff ------------------------------------\n\n// jobDiffResponse is the /projects/{project}/jobs/{job}/diff response shape.\n// Without ?full=1 it is the \"quick eyeball\" — the branch's commits\n// (git.LogOneline) and its changed files (git.DiffStat), the same two calls\n// `mg diff` makes. With ?full=1 it is the complete patch (git.Diff). The\n// three-dot range <base>...<branch> is resolved exactly as mg diff resolves\n// it.\ntype jobDiffResponse struct {\n\tLog   *string `json:\"log,omitempty\"`\n\tStat  *string `json:\"stat,omitempty\"`\n\tPatch *string `json:\"patch,omitempty\"`\n}\n\n// errJobBranchNotFound / errJobBranchAmbiguous classify a failed job→branch\n// resolution so the handler can map them to 404 / 409 with the CLI's wording.\nvar (\n\terrJobBranchNotFound  = errors.New(\"job branch not found\")\n\terrJobBranchAmbiguous = errors.New(\"job branch ambiguous\")\n)\n\n// resolveJobBranch mirrors cmd/mg/diff.go's resolveJobBranch — the same\n// exact-then-prefix matching on the branch's id_slug tail segment, with the\n// same error wording. Not-found and ambiguity are classified (errors.Is) so\n// the API can map them onto 404 / 409.\nfunc resolveJobBranch(branches []string, jobArg string) (string, error) {\n\tif branch := git.ExactBranchMatch(branches, jobArg); branch != \"\" {\n\t\treturn branch, nil\n\t}\n\tprefixMatches := git.PrefixBranchMatches(branches, jobArg)\n\tswitch len(prefixMatches) {\n\tcase 0:\n\t\tmsg := fmt.Sprintf(\"job '%s' not found among local branches.\\nActive job branches:\", jobArg)\n\t\tfor _, b := range branches {\n\t\t\tmsg += \"\\n  \" + b\n\t\t}\n\t\treturn \"\", fmt.Errorf(\"%w: %s\", errJobBranchNotFound, msg)\n\tcase 1:\n\t\treturn prefixMatches[0], nil\n\tdefault:\n\t\treturn \"\", fmt.Errorf(\"%w: job '%s' is ambiguous — matches branches: %s\", errJobBranchAmbiguous, jobArg, strings.Join(prefixMatches, \" \"))\n\t}\n}\n\n// handleJobDiff serves a job's branch diff against the project's base branch\n// — the `mg diff` quick eyeball (log + stat) or, with ?full=1, the complete\n// patch. The base branch resolves exactly as mg diff does (the project's\n// configured baseBranch, falling back to origin/HEAD → main); the job→branch\n// resolution is the CLI's exact-then-prefix chain. All git access goes\n// through internal/git — the package that owns every git shell-out. Read-only\n// git commands only.\nfunc (s *Server) handleJobDiff(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tjobArg := r.PathValue(\"job\")\n\tif !validSegment(jobArg) {\n\t\twriteError(w, http.StatusNotFound, \"job not found\")\n\t\treturn\n\t}\n\n\tbranches, err := git.LocalBranches(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read branches\")\n\t\treturn\n\t}\n\tbranch, err := resolveJobBranch(branches, jobArg)\n\tif err != nil {\n\t\tswitch {\n\t\tcase errors.Is(err, errJobBranchAmbiguous):\n\t\t\twriteError(w, http.StatusConflict, strings.TrimPrefix(err.Error(), \"job branch ambiguous: \"))\n\t\tdefault:\n\t\t\twriteError(w, http.StatusNotFound, strings.TrimPrefix(err.Error(), \"job branch not found: \"))\n\t\t}\n\t\treturn\n\t}\n\n\tsettings, err := project.Load(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read project settings\")\n\t\treturn\n\t}\n\tbase := settings.BaseBranch\n\tif base == \"\" {\n\t\tbase = git.SymbolicRefHead(root)\n\t}\n\n\tif r.URL.Query().Get(\"full\") == \"1\" {\n\t\tpatch, err := git.Diff(root, base, branch)\n\t\tif err != nil {\n\t\t\twriteError(w, http.StatusInternalServerError, \"cannot compute diff\")\n\t\t\treturn\n\t\t}\n\t\twriteJSON(w, http.StatusOK, jobDiffResponse{Patch: &patch})\n\t\treturn\n\t}\n\n\tlogs, err := git.LogOneline(root, base, branch)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read log\")\n\t\treturn\n\t}\n\tstat, err := git.DiffStat(root, base, branch)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read diff stat\")\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, jobDiffResponse{Log: &logs, Stat: &stat})\n}\n\n// --- /projects/{project}/agents ---------------------------------------------\n\n// agentRow is one entry in the agents response: name and one-line description\n// only — never the agent files' contents beyond the description line.\ntype agentRow struct {\n\tName        string `json:\"name\"`\n\tDescription string `json:\"description\"`\n}\n\n// agentsResponse is the /projects/{project}/agents response shape.\ntype agentsResponse struct {\n\tAgents []agentRow `json:\"agents\"`\n}\n\n// handleProjectAgents lists the agents available to a project — the `mg\n// agents` list (agentlist.Discover), name + description only.\nfunc (s *Server) handleProjectAgents(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tagents, err := agentlist.Discover(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot list agents\")\n\t\treturn\n\t}\n\trows := make([]agentRow, 0, len(agents))\n\tfor _, a := range agents {\n\t\trows = append(rows, agentRow{Name: a.Name, Description: a.Description})\n\t}\n\twriteJSON(w, http.StatusOK, agentsResponse{Agents: rows})\n}","lineStart":1,"lineEnd":540,"totalLines":540,"truncated":false}},"title":"src/internal/serve/api.go","time":{"start":1787993701342,"end":1787993701354}},"id":"prt_04cbabbdb0019T6z2Y6VRlVlG7","sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","messageID":"msg_04cbab0ed001FOs0ygD5XlWc8Z"}}
{"type":"tool_use","timestamp":1787993701588,"sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","part":{"type":"tool","tool":"bash","callID":"call_b96219a14e0743ee9fb0560d","state":{"status":"completed","input":{"command":"ls /workspace/src/internal/config /workspace/src/internal/project"},"output":"/workspace/src/internal/config:\nconfig.go\nconfig_test.go\n\n/workspace/src/internal/project:\nsettings.go\nsettings_test.go\n","metadata":{"output":"/workspace/src/internal/config:\nconfig.go\nconfig_test.go\n\n/workspace/src/internal/project:\nsettings.go\nsettings_test.go\n","exit":0,"truncated":false},"title":"ls /workspace/src/internal/config /workspace/src/internal/project","time":{"start":1787993701583,"end":1787993701586}},"id":"prt_04cbabcc3001C3oJGHz1ZSHB0U","sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","messageID":"msg_04cbab0ed001FOs0ygD5XlWc8Z"}}
