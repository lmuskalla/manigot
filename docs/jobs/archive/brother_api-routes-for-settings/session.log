{"type":"tool_use","timestamp":1787993744541,"sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","part":{"type":"tool","tool":"read","callID":"call_d8a8bb966e5c4ea591751126","state":{"status":"completed","input":{"filePath":"/workspace/src/cmd/mg/profiles.go"},"output":"<path>/workspace/src/cmd/mg/profiles.go</path>\n<type>file</type>\n<content>\n1: package main\n2: \n3: import (\n4: \t\"bufio\"\n5: \t\"errors\"\n6: \t\"flag\"\n7: \t\"fmt\"\n8: \t\"io\"\n9: \t\"strings\"\n10: \n11: \t\"github.com/lmuskalla/manigot/internal/cli\"\n12: \t\"github.com/lmuskalla/manigot/internal/config\"\n13: \t\"github.com/lmuskalla/manigot/internal/ui\"\n14: )\n15: \n16: const profilesHelp = `mg profiles [name|add|rm]\n17: \n18: Lists manigot's subscription profiles — the built-ins claude-pro, zai,\n19: opencode-go, opencode-zen, opencode-zen-free plus any you've added — showing\n20: which are configured and which is the default used by bare ` + \"`mg`\" + `. With a name,\n21: sets that profile as the default (written as MANIGOT_PROFILE in manigot/.env);\n22: with no name and an interactive terminal, picks the default via an interactive\n23: picker on a TTY (type to filter, enter to choose, esc/q cancel).\n24: sets that profile as the default (written as MANIGOT_PROFILE in manigot/.env);\n25: with no name and an interactive terminal, picks the default via an interactive\n26: picker on a TTY (type to filter, enter to choose, esc/q cancel).\n27: \n28:   mg profiles add [<id>]   interactively create a user-defined profile\n29:                            (e.g. OpenCode Zen with a different model),\n30:                            stored in config/profiles.json\n31:   mg profiles rm <id>      remove a user-defined profile; removing the current\n32:                            default falls back to claude-pro (built-ins cannot\n33:                            be removed)\n34: \n35: The default is shared: the TUI's settings screen reads and writes the same\n36: MANIGOT_PROFILE, so TUI-launched sessions use whatever this command sets, and\n37: vice versa.\n38: `\n39: \n40: // runProfiles implements `mg profiles` — the port of scripts/profiles.sh with\n41: // identical output wording. r is the interactive input (kept for signature\n42: // uniformity with runAgents/runJobs even though the picker reads the terminal\n43: // itself), stdout carries the listing/confirmations, stderr the errors. On a\n44: // TTY the default-profile selection is the injected picker seam (pick) — the\n45: // same one runJobs/runAgents use — so tests never start a real Bubble Tea\n46: // program.\n47: func runProfiles(args []string, r io.Reader, stdout, stderr io.Writer, tty bool, pick pickerRunFunc) int {\n48: \tfs := flag.NewFlagSet(\"mg profiles\", flag.ContinueOnError)\n49: \tfs.SetOutput(io.Discard)\n50: \tfs.Usage = func() { fmt.Fprint(stdout, profilesHelp) }\n51: \tif err := fs.Parse(args); err != nil {\n52: \t\tif errors.Is(err, flag.ErrHelp) {\n53: \t\t\treturn 0 // usage already printed to stdout\n54: \t\t}\n55: \t\t// An unknown flag — the script's parser had no flags at all, so any\n56: \t\t// single argument was a candidate profile name.\n57: \t\tfmt.Fprintln(stderr, flagParseError(err))\n58: \t\tfmt.Fprintln(stderr, \"Usage: mg profiles [name]\")\n59: \t\treturn 1\n60: \t}\n61: \n62: \trest := fs.Args()\n63: \tif len(rest) == 1 && rest[0] == \"help\" {\n64: \t\t// The script's bare-word help alias.\n65: \t\tfmt.Fprint(stdout, profilesHelp)\n66: \t\treturn 0\n67: \t}\n68: \tif len(rest) == 0 {\n69: \t\treturn profilesList(r, stdout, tty, pick)\n70: \t}\n71: \tswitch rest[0] {\n72: \tcase \"add\":\n73: \t\treturn profilesAdd(rest[1:], r, stdout, stderr, tty)\n74: \tcase \"rm\", \"remove\":\n75: \t\treturn profilesRm(rest[1:], stdout, stderr)\n76: \t}\n77: \tif len(rest) > 1 {\n78: \t\tfmt.Fprintln(stderr, \"Error: too many arguments.\")\n79: \t\tfmt.Fprintln(stderr, \"Usage: mg profiles [name|add|rm]\")\n80: \t\treturn 1\n81: \t}\n82: \treturn profilesSet(rest[0], stdout, stderr)\n83: }\n84: \n85: // profilesAdd implements `mg profiles add [<id>]` — the interactive\n86: // user-defined-profile creation wizard. On a TTY it walks the fields of a\n87: // profile (tool, credential key(s), model env/default for opencode) with the\n88: // built-ins' values offered as defaults, then persists the profile to\n89: // config/profiles.json via config.AddProfile. Off a TTY it refuses — profile\n90: // creation is inherently interactive, matching `mg setup`'s stance.\n91: func profilesAdd(args []string, r io.Reader, stdout, stderr io.Writer, tty bool) int {\n92: \tif !tty {\n93: \t\tfmt.Fprintln(stderr, \"mg profiles add: interactive profile creation needs a terminal.\")\n94: \t\tfmt.Fprintln(stderr, \"Define the profile in config/profiles.json instead, or run inside a terminal.\")\n95: \t\treturn 1\n96: \t}\n97: \tif len(args) > 1 {\n98: \t\tfmt.Fprintln(stderr, \"Error: mg profiles add takes at most a single profile id.\")\n99: \t\treturn 1\n100: \t}\n101: \n102: \t// One buffered reader for the whole wizard — a fresh bufio.Reader per\n103: \t// prompt would lose whatever the previous one buffered past its newline.\n104: \tbr := bufio.NewReader(r)\n105: \n106: \tid := \"\"\n107: \tif len(args) == 1 {\n108: \t\tid = args[0]\n109: \t}\n110: \tif strings.TrimSpace(id) == \"\" {\n111: \t\tv, err := promptLine(\"  Profile id: \", br, stdout)\n112: \t\tif err != nil {\n113: \t\t\tfmt.Fprintf(stderr, \"mg profiles add: %v\\n\", err)\n114: \t\t\treturn 1\n115: \t\t}\n116: \t\tid = v\n117: \t}\n118: \tif strings.TrimSpace(id) == \"\" {\n119: \t\tfmt.Fprintln(stderr, \"Error: a profile id is required.\")\n120: \t\treturn 1\n121: \t}\n122: \tif _, ok := config.ProfileByID(id); ok {\n123: \t\tfmt.Fprintf(stderr, \"Error: a profile with id %q already exists.\\n\", id)\n124: \t\treturn 1\n125: \t}\n126: \n127: \ttool, _ := cli.PromptValue(\"Tool (claude-code|opencode)\", \"\", config.ToolOpenCode, br, stdout)\n128: \tif tool != config.ToolClaudeCode && tool != config.ToolOpenCode {\n129: \t\tfmt.Fprintf(stderr, \"Error: tool must be 'claude-code' or 'opencode' (got '%s').\\n\", tool)\n130: \t\treturn 1\n131: \t}\n132: \tlabel, _ := cli.PromptValue(\"Label\", \"\", id, br, stdout)\n133: \tif label == \"\" {\n134: \t\tlabel = id\n135: \t}\n136: \n137: \tdefKey := \"OPENCODE_API_KEY\"\n138: \tif tool == config.ToolClaudeCode {\n139: \t\tdefKey = \"CLAUDE_CODE_OAUTH_TOKEN\"\n140: \t}\n141: \tauthKeysRaw, _ := cli.PromptValue(\"Credential key(s), comma-separated\", \"\", defKey, br, stdout)\n142: \tvar authKeys []string\n143: \tfor _, k := range strings.Split(authKeysRaw, \",\") {\n144: \t\tif k = strings.TrimSpace(k); k != \"\" {\n145: \t\t\tauthKeys = append(authKeys, k)\n146: \t\t}\n147: \t}\n148: \tif len(authKeys) == 0 {\n149: \t\tfmt.Fprintln(stderr, \"Error: at least one credential key is required.\")\n150: \t\treturn 1\n151: \t}\n152: \tbilled, _ := cli.PromptValue(\"Billed via (description)\", \"\", authKeys[0], br, stdout)\n153: \tif billed == \"\" {\n154: \t\tbilled = authKeys[0]\n155: \t}\n156: \n157: \tp := config.Profile{\n158: \t\tID:       id,\n159: \t\tLabel:    label,\n160: \t\tTool:     tool,\n161: \t\tAuth:     billed,\n162: \t\tAuthKeys: authKeys,\n163: \t}\n164: \tif tool == config.ToolOpenCode {\n165: \t\tmodelEnv, _ := cli.PromptValue(\"Model .env key\", \"\", \"OPENCODE_MODEL\", br, stdout)\n166: \t\tmodelDefault, _ := cli.PromptValue(\"Default model\", \"\", \"\", br, stdout)\n167: \t\tif strings.TrimSpace(modelDefault) == \"\" {\n168: \t\t\tfmt.Fprintln(stderr, \"Error: an opencode profile needs a default model.\")\n169: \t\t\treturn 1\n170: \t\t}\n171: \t\tp.ModelEnv = modelEnv\n172: \t\tp.ModelDefault = modelDefault\n173: \t}\n174: \n175: \tif err := config.AddProfile(p); err != nil {\n176: \t\tfmt.Fprintf(stderr, \"mg profiles add: %v\\n\", err)\n177: \t\treturn 1\n178: \t}\n179: \tfmt.Fprintf(stdout, \"Added profile '%s' (%s).\\n\", p.ID, p.Label)\n180: \tfmt.Fprintf(stdout, \"Configure its credentials with: mg setup %s\\n\", p.ID)\n181: \tfmt.Fprintf(stdout, \"Make it the default with: mg profiles %s\\n\", p.ID)\n182: \treturn 0\n183: }\n184: \n185: // profilesRm implements `mg profiles rm <id>` — removes a user-defined\n186: // profile from config/profiles.json. Built-in profiles are not deletable\n187: // (they are the defaults every user starts from), so rm only ever touches the\n188: // user store. Removing the currently-set MANIGOT_PROFILE default falls back\n189: // to claude-pro so bare `mg` keeps a valid default.\n190: func profilesRm(args []string, stdout, stderr io.Writer) int {\n191: \tif len(args) != 1 {\n192: \t\tfmt.Fprintln(stderr, \"Usage: mg profiles rm <id>\")\n193: \t\treturn 1\n194: \t}\n195: \tid := args[0]\n196: \tif _, ok := config.ProfileByID(id); !ok {\n197: \t\tfmt.Fprintf(stderr, \"Error: unknown profile '%s'.\\n\", id)\n198: \t\treturn 1\n199: \t}\n200: \tif err := config.RemoveProfile(id); err != nil {\n201: \t\t// Covers the built-in profiles (not present in the user store) and\n202: \t\t// any corrupt-store/unresolvable-home write failure.\n203: \t\tfmt.Fprintf(stderr, \"mg profiles rm: %v\\n\", err)\n204: \t\treturn 1\n205: \t}\n206: \tif config.EnvValue(\"MANIGOT_PROFILE\") == id {\n207: \t\tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", config.ProfileClaudePro); err != nil {\n208: \t\t\tfmt.Fprintf(stderr, \"mg profiles rm: %v\\n\", err)\n209: \t\t\treturn 1\n210: \t\t}\n211: \t\tfmt.Fprintf(stdout, \"Removed profile '%s'. The default fell back to %s.\\n\", id, config.ProfileClaudePro)\n212: \t\treturn 0\n213: \t}\n214: \tfmt.Fprintf(stdout, \"Removed profile '%s'.\\n\", id)\n215: \treturn 0\n216: }\n217: \n218: // promptLine prints label and reads one trimmed line from br (no default\n219: // shown) — for the add wizard's required, default-less fields like the profile\n220: // id. On EOF it returns whatever was read, like cli's readLine.\n221: func promptLine(label string, br *bufio.Reader, w io.Writer) (string, error) {\n222: \tfmt.Fprint(w, label)\n223: \tline, err := br.ReadString('\\n')\n224: \tif err != nil && !errors.Is(err, io.EOF) {\n225: \t\treturn \"\", err\n226: \t}\n227: \treturn strings.TrimSpace(line), nil\n228: }\n229: \n230: // profilesSet writes MANIGOT_PROFILE=<name> into .env and prints the same\n231: // confirmation + missing-credentials warning profiles.sh's confirm_set did.\n232: func profilesSet(name string, stdout, stderr io.Writer) int {\n233: \tif _, ok := config.ProfileByID(name); !ok {\n234: \t\tfmt.Fprintf(stderr, \"Error: unknown profile '%s'.\\n\", name)\n235: \t\tfmt.Fprintf(stderr, \"Valid profiles: %s\\n\", strings.Join(profileIDs(), \" \"))\n236: \t\treturn 1\n237: \t}\n238: \tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", name); err != nil {\n239: \t\tfmt.Fprintf(stderr, \"mg profiles: %v\\n\", err)\n240: \t\treturn 1\n241: \t}\n242: \tconfirmSet(name, stdout)\n243: \treturn 0\n244: }\n245: \n246: // confirmSet prints the shared set confirmation, warning when the profile's\n247: // auth key is not in .env yet.\n248: func confirmSet(name string, w io.Writer) {\n249: \tenvFile := config.EnvFile()\n250: \tfmt.Fprintf(w, \"Default profile set to %s (MANIGOT_PROFILE in %s).\\n\", name, envFile)\n251: \tfmt.Fprintln(w, \"Bare `mg` sessions and TUI-launched sessions share this default.\")\n252: \n253: \tif p, ok := config.ProfileByID(name); ok && len(p.AuthKeys) > 0 {\n254: \t\tif key := p.AuthKeys[0]; config.EnvValue(key) == \"\" {\n255: \t\t\tfmt.Fprintf(w, \"Warning: %s is not set in %s — run 'mg setup %s' first, or sessions will fail at launch.\\n\", key, envFile, name)\n256: \t\t}\n257: \t}\n258: }\n259: \n260: // profilesList prints the profile table, then offers the interactive picker\n261: // on a TTY — same listing, and the picker rows carry the same padded columns\n262: // (byte-padded by padBytes, matching bash printf's byte-based padding: the\n263: // label column contains a multi-byte ·, so rune-based fmt padding would\n264: // misalign every row by one). The picker replaces the old numbered\n265: // `[1-N, Enter keeps X, q quits]` loop; the cursor opens on the active\n266: // default so a bare enter keeps it. Off a TTY the listing alone is the whole\n267: // command (exit 0 — listing is `mg profiles`' documented purpose, unlike\n268: // jobs/agents which refuse because selection is their only purpose).\n269: func profilesList(r io.Reader, w io.Writer, tty bool, pick pickerRunFunc) int {\n270: \tactive := config.EnvValue(\"MANIGOT_PROFILE\")\n271: \tif active == \"\" {\n272: \t\tactive = config.ProfileClaudePro\n273: \t}\n274: \tfmt.Fprintf(w, \"Active default: %s   (shared with the TUI; switch with: mg profiles <name>, or pick one below)\\n\", active)\n275: \tfmt.Fprintln(w, \"\")\n276: \tfmt.Fprintf(w, \"  %-13s %-28s %-10s %-26s %s\\n\", \"profile\", \"label\", \"tool\", \"model\", \"creds\")\n277: \tfmt.Fprintf(w, \"  %-13s %-28s %-10s %-26s %s\\n\", \"---------\", \"----------------------------\", \"----------\", \"--------------------------\", \"-----\")\n278: \tfor _, p := range config.Profiles() {\n279: \t\tmark := \" \"\n280: \t\tif p.ID == active {\n281: \t\t\tmark = \"*\"\n282: \t\t}\n283: \t\trow := \"  \" + mark + padBytes(p.ID, 12) + \" \" + padBytes(p.Label, 28) + \" \" +\n284: \t\t\tpadBytes(p.Tool, 10) + \" \" + padBytes(profileModel(p.ID), 26) + \" \" + creds(p.ID)\n285: \t\tfmt.Fprintln(w, row)\n286: \t}\n287: \tfmt.Fprintln(w, \"\")\n288: \tfmt.Fprintln(w, \"  * = default. Configure credentials with: mg setup [name]\")\n289: \n290: \tif !tty {\n291: \t\treturn 0\n292: \t}\n293: \n294: \tprofiles := config.Profiles()\n295: \trows := make([]ui.PickerRow, 0, len(profiles))\n296: \tstart := 0\n297: \tfor i, p := range profiles {\n298: \t\tif p.ID == active {\n299: \t\t\tstart = i\n300: \t\t}\n301: \t\tmodel := profileModel(p.ID)\n302: \t\tcred := creds(p.ID)\n303: \t\tmark := \" \"\n304: \t\tif p.ID == active {\n305: \t\t\tmark = \"*\"\n306: \t\t}\n307: \t\trows = append(rows, ui.PickerRow{\n308: \t\t\tID:        p.ID,\n309: \t\t\tSearchKey: p.ID + \" \" + p.Label + \" \" + p.Tool + \" \" + model + \" \" + cred,\n310: \t\t\t// The same padded columns as the plain listing (minus the leading\n311: \t\t\t// indent, which the picker's own cursor/blank prefix provides),\n312: \t\t\t// keeping the * active mark.\n313: \t\t\tLabel: mark + padBytes(p.ID, 12) + \" \" + padBytes(p.Label, 28) + \" \" +\n314: \t\t\t\tpadBytes(p.Tool, 10) + \" \" + padBytes(model, 26) + \" \" + cred,\n315: \t\t})\n316: \t}\n317: \n318: \tchosen, ok, err := pick(\"Select the default profile\", rows, start)\n319: \tif err != nil {\n320: \t\tfmt.Fprintf(w, \"mg profiles: %v\\n\", err)\n321: \t\treturn 1\n322: \t}\n323: \tif !ok {\n324: \t\t// Cancelled (esc/q) — a quiet exit 0, not the old \"quit\" error.\n325: \t\treturn 0\n326: \t}\n327: \tif chosen == active {\n328: \t\tfmt.Fprintf(w, \"Keeping %s.\\n\", active)\n329: \t\treturn 0\n330: \t}\n331: \tfmt.Fprintln(w, \"\")\n332: \tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", chosen); err != nil {\n333: \t\tfmt.Fprintf(w, \"mg profiles: %v\\n\", err)\n334: \t\treturn 1\n335: \t}\n336: \tconfirmSet(chosen, w)\n337: \treturn 0\n338: }\n339: \n340: // profileModel returns the model column for a profile: the effective .env /\n341: // environment override when set, else the compiled-in default. Both come from\n342: // the profile's definition (config.ProfileByID), so a user-defined profile\n343: // renders its own model env/default.\n344: func profileModel(id string) string {\n345: \tp, ok := config.ProfileByID(id)\n346: \tif !ok {\n347: \t\treturn \"\"\n348: \t}\n349: \tif p.ModelEnv != \"\" {\n350: \t\tif v := config.EnvValue(p.ModelEnv); v != \"\" {\n351: \t\t\treturn v\n352: \t\t}\n353: \t}\n354: \treturn p.ModelDefault\n355: }\n356: \n357: // creds returns the creds column for a profile: \"✓ ready\" when every required\n358: // key is set, else \"✗ missing <first missing key>\". The required keys are the\n359: // profile's AuthKeys. Checks the effective value (process env + .env),\n360: // matching the scripts' sourced-env ${!KEY:-} reads.\n361: func creds(id string) string {\n362: \tp, ok := config.ProfileByID(id)\n363: \tif !ok {\n364: \t\t// An unknown id has no keys, so the old loop ran zero times and\n365: \t\t// reported \"ready\" — preserved for identical output.\n366: \t\treturn \"✓ ready\"\n367: \t}\n368: \tfor _, k := range p.AuthKeys {\n369: \t\tif config.EnvValue(k) == \"\" {\n370: \t\t\treturn \"✗ missing \" + k\n371: \t\t}\n372: \t}\n373: \treturn \"✓ ready\"\n374: }\n375: \n376: // profileIDs returns the ordered profile ids for error messages.\n377: func profileIDs() []string {\n378: \tps := config.Profiles()\n379: \tids := make([]string, len(ps))\n380: \tfor i, p := range ps {\n381: \t\tids[i] = p.ID\n382: \t}\n383: \treturn ids\n384: }\n385: \n386: // padBytes returns s padded with trailing spaces to the given byte width —\n387: // bash printf pads %s by byte length, and the profile table's label column\n388: // contains a multi-byte ·, so fmt's rune-based width would misalign.\n389: func padBytes(s string, width int) string {\n390: \tif n := len(s); n >= width {\n391: \t\treturn s\n392: \t}\n393: \treturn s + strings.Repeat(\" \", width-len(s))\n394: }\n\n(End of file - total 394 lines)\n</content>","metadata":{"preview":"package main\n\nimport (\n\t\"bufio\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/cli\"\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/ui\"\n)\n\nconst profilesHelp = `mg profiles [name|add|rm]\n\nLists manigot's subscription profiles — the built-ins claude-pro, zai,\nopencode-go, opencode-zen, opencode-zen-free plus any you've added — showing\nwhich are configured and which is the default used by bare ` + \"`mg`\" + `. With a name,","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/cmd/mg/profiles.go","text":"package main\n\nimport (\n\t\"bufio\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/cli\"\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/ui\"\n)\n\nconst profilesHelp = `mg profiles [name|add|rm]\n\nLists manigot's subscription profiles — the built-ins claude-pro, zai,\nopencode-go, opencode-zen, opencode-zen-free plus any you've added — showing\nwhich are configured and which is the default used by bare ` + \"`mg`\" + `. With a name,\nsets that profile as the default (written as MANIGOT_PROFILE in manigot/.env);\nwith no name and an interactive terminal, picks the default via an interactive\npicker on a TTY (type to filter, enter to choose, esc/q cancel).\nsets that profile as the default (written as MANIGOT_PROFILE in manigot/.env);\nwith no name and an interactive terminal, picks the default via an interactive\npicker on a TTY (type to filter, enter to choose, esc/q cancel).\n\n  mg profiles add [<id>]   interactively create a user-defined profile\n                           (e.g. OpenCode Zen with a different model),\n                           stored in config/profiles.json\n  mg profiles rm <id>      remove a user-defined profile; removing the current\n                           default falls back to claude-pro (built-ins cannot\n                           be removed)\n\nThe default is shared: the TUI's settings screen reads and writes the same\nMANIGOT_PROFILE, so TUI-launched sessions use whatever this command sets, and\nvice versa.\n`\n\n// runProfiles implements `mg profiles` — the port of scripts/profiles.sh with\n// identical output wording. r is the interactive input (kept for signature\n// uniformity with runAgents/runJobs even though the picker reads the terminal\n// itself), stdout carries the listing/confirmations, stderr the errors. On a\n// TTY the default-profile selection is the injected picker seam (pick) — the\n// same one runJobs/runAgents use — so tests never start a real Bubble Tea\n// program.\nfunc runProfiles(args []string, r io.Reader, stdout, stderr io.Writer, tty bool, pick pickerRunFunc) int {\n\tfs := flag.NewFlagSet(\"mg profiles\", flag.ContinueOnError)\n\tfs.SetOutput(io.Discard)\n\tfs.Usage = func() { fmt.Fprint(stdout, profilesHelp) }\n\tif err := fs.Parse(args); err != nil {\n\t\tif errors.Is(err, flag.ErrHelp) {\n\t\t\treturn 0 // usage already printed to stdout\n\t\t}\n\t\t// An unknown flag — the script's parser had no flags at all, so any\n\t\t// single argument was a candidate profile name.\n\t\tfmt.Fprintln(stderr, flagParseError(err))\n\t\tfmt.Fprintln(stderr, \"Usage: mg profiles [name]\")\n\t\treturn 1\n\t}\n\n\trest := fs.Args()\n\tif len(rest) == 1 && rest[0] == \"help\" {\n\t\t// The script's bare-word help alias.\n\t\tfmt.Fprint(stdout, profilesHelp)\n\t\treturn 0\n\t}\n\tif len(rest) == 0 {\n\t\treturn profilesList(r, stdout, tty, pick)\n\t}\n\tswitch rest[0] {\n\tcase \"add\":\n\t\treturn profilesAdd(rest[1:], r, stdout, stderr, tty)\n\tcase \"rm\", \"remove\":\n\t\treturn profilesRm(rest[1:], stdout, stderr)\n\t}\n\tif len(rest) > 1 {\n\t\tfmt.Fprintln(stderr, \"Error: too many arguments.\")\n\t\tfmt.Fprintln(stderr, \"Usage: mg profiles [name|add|rm]\")\n\t\treturn 1\n\t}\n\treturn profilesSet(rest[0], stdout, stderr)\n}\n\n// profilesAdd implements `mg profiles add [<id>]` — the interactive\n// user-defined-profile creation wizard. On a TTY it walks the fields of a\n// profile (tool, credential key(s), model env/default for opencode) with the\n// built-ins' values offered as defaults, then persists the profile to\n// config/profiles.json via config.AddProfile. Off a TTY it refuses — profile\n// creation is inherently interactive, matching `mg setup`'s stance.\nfunc profilesAdd(args []string, r io.Reader, stdout, stderr io.Writer, tty bool) int {\n\tif !tty {\n\t\tfmt.Fprintln(stderr, \"mg profiles add: interactive profile creation needs a terminal.\")\n\t\tfmt.Fprintln(stderr, \"Define the profile in config/profiles.json instead, or run inside a terminal.\")\n\t\treturn 1\n\t}\n\tif len(args) > 1 {\n\t\tfmt.Fprintln(stderr, \"Error: mg profiles add takes at most a single profile id.\")\n\t\treturn 1\n\t}\n\n\t// One buffered reader for the whole wizard — a fresh bufio.Reader per\n\t// prompt would lose whatever the previous one buffered past its newline.\n\tbr := bufio.NewReader(r)\n\n\tid := \"\"\n\tif len(args) == 1 {\n\t\tid = args[0]\n\t}\n\tif strings.TrimSpace(id) == \"\" {\n\t\tv, err := promptLine(\"  Profile id: \", br, stdout)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"mg profiles add: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tid = v\n\t}\n\tif strings.TrimSpace(id) == \"\" {\n\t\tfmt.Fprintln(stderr, \"Error: a profile id is required.\")\n\t\treturn 1\n\t}\n\tif _, ok := config.ProfileByID(id); ok {\n\t\tfmt.Fprintf(stderr, \"Error: a profile with id %q already exists.\\n\", id)\n\t\treturn 1\n\t}\n\n\ttool, _ := cli.PromptValue(\"Tool (claude-code|opencode)\", \"\", config.ToolOpenCode, br, stdout)\n\tif tool != config.ToolClaudeCode && tool != config.ToolOpenCode {\n\t\tfmt.Fprintf(stderr, \"Error: tool must be 'claude-code' or 'opencode' (got '%s').\\n\", tool)\n\t\treturn 1\n\t}\n\tlabel, _ := cli.PromptValue(\"Label\", \"\", id, br, stdout)\n\tif label == \"\" {\n\t\tlabel = id\n\t}\n\n\tdefKey := \"OPENCODE_API_KEY\"\n\tif tool == config.ToolClaudeCode {\n\t\tdefKey = \"CLAUDE_CODE_OAUTH_TOKEN\"\n\t}\n\tauthKeysRaw, _ := cli.PromptValue(\"Credential key(s), comma-separated\", \"\", defKey, br, stdout)\n\tvar authKeys []string\n\tfor _, k := range strings.Split(authKeysRaw, \",\") {\n\t\tif k = strings.TrimSpace(k); k != \"\" {\n\t\t\tauthKeys = append(authKeys, k)\n\t\t}\n\t}\n\tif len(authKeys) == 0 {\n\t\tfmt.Fprintln(stderr, \"Error: at least one credential key is required.\")\n\t\treturn 1\n\t}\n\tbilled, _ := cli.PromptValue(\"Billed via (description)\", \"\", authKeys[0], br, stdout)\n\tif billed == \"\" {\n\t\tbilled = authKeys[0]\n\t}\n\n\tp := config.Profile{\n\t\tID:       id,\n\t\tLabel:    label,\n\t\tTool:     tool,\n\t\tAuth:     billed,\n\t\tAuthKeys: authKeys,\n\t}\n\tif tool == config.ToolOpenCode {\n\t\tmodelEnv, _ := cli.PromptValue(\"Model .env key\", \"\", \"OPENCODE_MODEL\", br, stdout)\n\t\tmodelDefault, _ := cli.PromptValue(\"Default model\", \"\", \"\", br, stdout)\n\t\tif strings.TrimSpace(modelDefault) == \"\" {\n\t\t\tfmt.Fprintln(stderr, \"Error: an opencode profile needs a default model.\")\n\t\t\treturn 1\n\t\t}\n\t\tp.ModelEnv = modelEnv\n\t\tp.ModelDefault = modelDefault\n\t}\n\n\tif err := config.AddProfile(p); err != nil {\n\t\tfmt.Fprintf(stderr, \"mg profiles add: %v\\n\", err)\n\t\treturn 1\n\t}\n\tfmt.Fprintf(stdout, \"Added profile '%s' (%s).\\n\", p.ID, p.Label)\n\tfmt.Fprintf(stdout, \"Configure its credentials with: mg setup %s\\n\", p.ID)\n\tfmt.Fprintf(stdout, \"Make it the default with: mg profiles %s\\n\", p.ID)\n\treturn 0\n}\n\n// profilesRm implements `mg profiles rm <id>` — removes a user-defined\n// profile from config/profiles.json. Built-in profiles are not deletable\n// (they are the defaults every user starts from), so rm only ever touches the\n// user store. Removing the currently-set MANIGOT_PROFILE default falls back\n// to claude-pro so bare `mg` keeps a valid default.\nfunc profilesRm(args []string, stdout, stderr io.Writer) int {\n\tif len(args) != 1 {\n\t\tfmt.Fprintln(stderr, \"Usage: mg profiles rm <id>\")\n\t\treturn 1\n\t}\n\tid := args[0]\n\tif _, ok := config.ProfileByID(id); !ok {\n\t\tfmt.Fprintf(stderr, \"Error: unknown profile '%s'.\\n\", id)\n\t\treturn 1\n\t}\n\tif err := config.RemoveProfile(id); err != nil {\n\t\t// Covers the built-in profiles (not present in the user store) and\n\t\t// any corrupt-store/unresolvable-home write failure.\n\t\tfmt.Fprintf(stderr, \"mg profiles rm: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif config.EnvValue(\"MANIGOT_PROFILE\") == id {\n\t\tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", config.ProfileClaudePro); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"mg profiles rm: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintf(stdout, \"Removed profile '%s'. The default fell back to %s.\\n\", id, config.ProfileClaudePro)\n\t\treturn 0\n\t}\n\tfmt.Fprintf(stdout, \"Removed profile '%s'.\\n\", id)\n\treturn 0\n}\n\n// promptLine prints label and reads one trimmed line from br (no default\n// shown) — for the add wizard's required, default-less fields like the profile\n// id. On EOF it returns whatever was read, like cli's readLine.\nfunc promptLine(label string, br *bufio.Reader, w io.Writer) (string, error) {\n\tfmt.Fprint(w, label)\n\tline, err := br.ReadString('\\n')\n\tif err != nil && !errors.Is(err, io.EOF) {\n\t\treturn \"\", err\n\t}\n\treturn strings.TrimSpace(line), nil\n}\n\n// profilesSet writes MANIGOT_PROFILE=<name> into .env and prints the same\n// confirmation + missing-credentials warning profiles.sh's confirm_set did.\nfunc profilesSet(name string, stdout, stderr io.Writer) int {\n\tif _, ok := config.ProfileByID(name); !ok {\n\t\tfmt.Fprintf(stderr, \"Error: unknown profile '%s'.\\n\", name)\n\t\tfmt.Fprintf(stderr, \"Valid profiles: %s\\n\", strings.Join(profileIDs(), \" \"))\n\t\treturn 1\n\t}\n\tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", name); err != nil {\n\t\tfmt.Fprintf(stderr, \"mg profiles: %v\\n\", err)\n\t\treturn 1\n\t}\n\tconfirmSet(name, stdout)\n\treturn 0\n}\n\n// confirmSet prints the shared set confirmation, warning when the profile's\n// auth key is not in .env yet.\nfunc confirmSet(name string, w io.Writer) {\n\tenvFile := config.EnvFile()\n\tfmt.Fprintf(w, \"Default profile set to %s (MANIGOT_PROFILE in %s).\\n\", name, envFile)\n\tfmt.Fprintln(w, \"Bare `mg` sessions and TUI-launched sessions share this default.\")\n\n\tif p, ok := config.ProfileByID(name); ok && len(p.AuthKeys) > 0 {\n\t\tif key := p.AuthKeys[0]; config.EnvValue(key) == \"\" {\n\t\t\tfmt.Fprintf(w, \"Warning: %s is not set in %s — run 'mg setup %s' first, or sessions will fail at launch.\\n\", key, envFile, name)\n\t\t}\n\t}\n}\n\n// profilesList prints the profile table, then offers the interactive picker\n// on a TTY — same listing, and the picker rows carry the same padded columns\n// (byte-padded by padBytes, matching bash printf's byte-based padding: the\n// label column contains a multi-byte ·, so rune-based fmt padding would\n// misalign every row by one). The picker replaces the old numbered\n// `[1-N, Enter keeps X, q quits]` loop; the cursor opens on the active\n// default so a bare enter keeps it. Off a TTY the listing alone is the whole\n// command (exit 0 — listing is `mg profiles`' documented purpose, unlike\n// jobs/agents which refuse because selection is their only purpose).\nfunc profilesList(r io.Reader, w io.Writer, tty bool, pick pickerRunFunc) int {\n\tactive := config.EnvValue(\"MANIGOT_PROFILE\")\n\tif active == \"\" {\n\t\tactive = config.ProfileClaudePro\n\t}\n\tfmt.Fprintf(w, \"Active default: %s   (shared with the TUI; switch with: mg profiles <name>, or pick one below)\\n\", active)\n\tfmt.Fprintln(w, \"\")\n\tfmt.Fprintf(w, \"  %-13s %-28s %-10s %-26s %s\\n\", \"profile\", \"label\", \"tool\", \"model\", \"creds\")\n\tfmt.Fprintf(w, \"  %-13s %-28s %-10s %-26s %s\\n\", \"---------\", \"----------------------------\", \"----------\", \"--------------------------\", \"-----\")\n\tfor _, p := range config.Profiles() {\n\t\tmark := \" \"\n\t\tif p.ID == active {\n\t\t\tmark = \"*\"\n\t\t}\n\t\trow := \"  \" + mark + padBytes(p.ID, 12) + \" \" + padBytes(p.Label, 28) + \" \" +\n\t\t\tpadBytes(p.Tool, 10) + \" \" + padBytes(profileModel(p.ID), 26) + \" \" + creds(p.ID)\n\t\tfmt.Fprintln(w, row)\n\t}\n\tfmt.Fprintln(w, \"\")\n\tfmt.Fprintln(w, \"  * = default. Configure credentials with: mg setup [name]\")\n\n\tif !tty {\n\t\treturn 0\n\t}\n\n\tprofiles := config.Profiles()\n\trows := make([]ui.PickerRow, 0, len(profiles))\n\tstart := 0\n\tfor i, p := range profiles {\n\t\tif p.ID == active {\n\t\t\tstart = i\n\t\t}\n\t\tmodel := profileModel(p.ID)\n\t\tcred := creds(p.ID)\n\t\tmark := \" \"\n\t\tif p.ID == active {\n\t\t\tmark = \"*\"\n\t\t}\n\t\trows = append(rows, ui.PickerRow{\n\t\t\tID:        p.ID,\n\t\t\tSearchKey: p.ID + \" \" + p.Label + \" \" + p.Tool + \" \" + model + \" \" + cred,\n\t\t\t// The same padded columns as the plain listing (minus the leading\n\t\t\t// indent, which the picker's own cursor/blank prefix provides),\n\t\t\t// keeping the * active mark.\n\t\t\tLabel: mark + padBytes(p.ID, 12) + \" \" + padBytes(p.Label, 28) + \" \" +\n\t\t\t\tpadBytes(p.Tool, 10) + \" \" + padBytes(model, 26) + \" \" + cred,\n\t\t})\n\t}\n\n\tchosen, ok, err := pick(\"Select the default profile\", rows, start)\n\tif err != nil {\n\t\tfmt.Fprintf(w, \"mg profiles: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif !ok {\n\t\t// Cancelled (esc/q) — a quiet exit 0, not the old \"quit\" error.\n\t\treturn 0\n\t}\n\tif chosen == active {\n\t\tfmt.Fprintf(w, \"Keeping %s.\\n\", active)\n\t\treturn 0\n\t}\n\tfmt.Fprintln(w, \"\")\n\tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", chosen); err != nil {\n\t\tfmt.Fprintf(w, \"mg profiles: %v\\n\", err)\n\t\treturn 1\n\t}\n\tconfirmSet(chosen, w)\n\treturn 0\n}\n\n// profileModel returns the model column for a profile: the effective .env /\n// environment override when set, else the compiled-in default. Both come from\n// the profile's definition (config.ProfileByID), so a user-defined profile\n// renders its own model env/default.\nfunc profileModel(id string) string {\n\tp, ok := config.ProfileByID(id)\n\tif !ok {\n\t\treturn \"\"\n\t}\n\tif p.ModelEnv != \"\" {\n\t\tif v := config.EnvValue(p.ModelEnv); v != \"\" {\n\t\t\treturn v\n\t\t}\n\t}\n\treturn p.ModelDefault\n}\n\n// creds returns the creds column for a profile: \"✓ ready\" when every required\n// key is set, else \"✗ missing <first missing key>\". The required keys are the\n// profile's AuthKeys. Checks the effective value (process env + .env),\n// matching the scripts' sourced-env ${!KEY:-} reads.\nfunc creds(id string) string {\n\tp, ok := config.ProfileByID(id)\n\tif !ok {\n\t\t// An unknown id has no keys, so the old loop ran zero times and\n\t\t// reported \"ready\" — preserved for identical output.\n\t\treturn \"✓ ready\"\n\t}\n\tfor _, k := range p.AuthKeys {\n\t\tif config.EnvValue(k) == \"\" {\n\t\t\treturn \"✗ missing \" + k\n\t\t}\n\t}\n\treturn \"✓ ready\"\n}\n\n// profileIDs returns the ordered profile ids for error messages.\nfunc profileIDs() []string {\n\tps := config.Profiles()\n\tids := make([]string, len(ps))\n\tfor i, p := range ps {\n\t\tids[i] = p.ID\n\t}\n\treturn ids\n}\n\n// padBytes returns s padded with trailing spaces to the given byte width —\n// bash printf pads %s by byte length, and the profile table's label column\n// contains a multi-byte ·, so fmt's rune-based width would misalign.\nfunc padBytes(s string, width int) string {\n\tif n := len(s); n >= width {\n\t\treturn s\n\t}\n\treturn s + strings.Repeat(\" \", width-len(s))\n}","lineStart":1,"lineEnd":394,"totalLines":394,"truncated":false}},"title":"src/cmd/mg/profiles.go","time":{"start":1787993744531,"end":1787993744538}},"id":"prt_04cbb648f001Cj6zLRnQ7gQN3S","sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","messageID":"msg_04cbb582a001EX0GMTgFxPLoE6"}}
{"type":"tool_use","timestamp":1787993744703,"sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","part":{"type":"tool","tool":"read","callID":"call_b9027467ade745cf8d2dd957","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/credentials_test.go"},"output":"<path>/workspace/src/internal/serve/credentials_test.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"encoding/json\"\n5: \t\"net/http\"\n6: \t\"os\"\n7: \t\"path/filepath\"\n8: \t\"strings\"\n9: \t\"testing\"\n10: \n11: \t\"github.com/lmuskalla/manigot/internal/job\"\n12: )\n13: \n14: // credentialKeys are the keys whose values must never appear in any response\n15: // body — the daemon's credential surface: subscription tokens, API keys, the\n16: // serve token, and the per-profile model keys. The test reads their values via\n17: // the same config.EnvValue path the daemon itself reads (the .env file in the\n18: // manigot checkout, then the process environment), so the test and the server\n19: // can never drift on what counts as a credential.\n20: var credentialKeys = []string{\n21: \t\"CLAUDE_CODE_OAUTH_TOKEN\",\n22: \t\"CLAUDE_ACCOUNT_UUID\",\n23: \t\"CLAUDE_EMAIL\",\n24: \t\"CLAUDE_ORG_UUID\",\n25: \t\"ANTHROPIC_API_KEY\",\n26: \t\"OPENCODE_API_KEY\",\n27: \t\"ZHIPU_API_KEY\",\n28: \t\"MG_SERVE_TOKEN\",\n29: \t\"OPENCODE_ZAI_MODEL\",\n30: \t\"OPENCODE_GO_MODEL\",\n31: \t\"OPENCODE_ZEN_MODEL\",\n32: \t\"OPENCODE_ZEN_FREE_MODEL\",\n33: \t\"OPENCODE_MODEL\",\n34: \t\"OPENCODE_THEME\",\n35: }\n36: \n37: // TestCredentialsNeverReturned is the brief's \"no .env content, no keys, no\n38: // tokens in any response, ever\" guarantee enforced over the whole surface: a\n39: // known credential value is planted in the daemon's real credential source\n40: // (.env + process env), every endpoint is hit (with the correct bearer token),\n41: // and every response body — including a 401 — is grepped for the values.\n42: func TestCredentialsNeverReturned(t *testing.T) {\n43: \t// The credential source: a fake checkout's .env plus the process\n44: \t// environment, both read through config.EnvValue exactly as the daemon\n45: \t// reads them.\n46: \tenvLines := map[string]string{}\n47: \tfor _, key := range credentialKeys {\n48: \t\tenvLines[key] = \"fixture-\" + key + \"-VALUE\"\n49: \t\tt.Setenv(key, envLines[key])\n50: \t}\n51: \tcheckout := fakeCheckout(t, map[string]string{\n52: \t\t\"analyst\": \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n53: \t})\n54: \t// The .env file itself — the daemon's preferred source. Two extra\n55: \t// non-credential lines ride along to pin the \"no full line of .env\n56: \t// content\" half of the guarantee.\n57: \tvar envFile strings.Builder\n58: \tfor _, key := range credentialKeys {\n59: \t\tenvFile.WriteString(key + \"=\" + envLines[key] + \"\\n\")\n60: \t}\n61: \tenvFile.WriteString(\"# a comment line in the env\\n\")\n62: \tenvFile.WriteString(\"UNRELATED_SETTING=some-value\\n\")\n63: \tif err := os.WriteFile(filepath.Join(checkout, \".env\"), []byte(envFile.String()), 0o644); err != nil {\n64: \t\tt.Fatal(err)\n65: \t}\n66: \n67: \t// A non-git project with a job (exercises projects/jobs/files/jdi/agents),\n68: \t// and a git repo with a job branch (exercises diff).\n69: \tjobProj := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"),\n70: \t\t\"tasks.md\", \"implementation.md\", \"verdict.md\")\n71: \tif err := writeJDIStatusForTest(t, jobProj, \"wood_oak\"); err != nil {\n72: \t\tt.Fatal(err)\n73: \t}\n74: \tlogDir := job.JDIStatusDir(jobProj, \"wood_oak\")\n75: \tif err := os.MkdirAll(logDir, 0o755); err != nil {\n76: \t\tt.Fatal(err)\n77: \t}\n78: \tif err := os.WriteFile(job.JDIRunLogPath(jobProj, \"wood_oak\"), []byte(\"run log content\\n\"), 0o644); err != nil {\n79: \t\tt.Fatal(err)\n80: \t}\n81: \tif err := os.WriteFile(filepath.Join(jobProj, \"docs\", \"jobs\", \"wood_oak\", \"session.log\"), []byte(\"session log content\\n\"), 0o644); err != nil {\n82: \t\tt.Fatal(err)\n83: \t}\n84: \n85: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n86: \tgitProj := initGitRepo(t)\n87: \trunGitT(t, gitProj, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n88: \tif err := os.WriteFile(filepath.Join(gitProj, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n89: \t\tt.Fatal(err)\n90: \t}\n91: \trunGitT(t, gitProj, \"add\", \"feature.txt\")\n92: \trunGitT(t, gitProj, \"commit\", \"-q\", \"-m\", \"add the feature\")\n93: \trunGitT(t, gitProj, \"checkout\", \"-q\", \"main\")\n94: \n95: \treg := &Registry{entries: []Entry{entryFor(jobProj), entryFor(gitProj)}}\n96: \ttoken := envLines[\"MG_SERVE_TOKEN\"]\n97: \tvar audit strings.Builder\n98: \tsrv := New(reg, \"test-version\", token, &audit)\n99: \tauth := \"Bearer \" + token\n100: \n101: \t// Every endpoint, plus a 401 (no token) and a 404 (unknown job) — the\n102: \t// error envelopes are response surfaces too.\n103: \tpaths := []string{\n104: \t\t\"/health\",\n105: \t\t\"/projects\",\n106: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs\",\n107: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/brief.md\",\n108: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/tasks.md\",\n109: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/implementation.md\",\n110: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/verdict.md\",\n111: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/jdi\",\n112: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/agents\",\n113: \t\t\"/projects/\" + filepath.Base(gitProj) + \"/jobs/wood_test/diff\",\n114: \t\t\"/projects/\" + filepath.Base(gitProj) + \"/jobs/wood_test/diff?full=1\",\n115: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/jdi?bogus=1\",\n116: \t\t\"/projects/no-such-project/jobs\",\n117: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/no-such-job/files/brief.md\",\n118: \t}\n119: \tfor _, p := range paths {\n120: \t\trec := get(t, srv, p, auth)\n121: \t\tassertBodyHasNoCredentials(t, rec.Body.String(), envLines, envFile.String())\n122: \t}\n123: \n124: \t// Job two's mutating surface — every mutating endpoint's response or error\n125: \t// body (the 2xx success envelopes and the 4xx/5xx structured errors alike)\n126: \t// must never echo .env content. All of these run against the fake non-git\n127: \t// jobProj (gitProj has no docs/jobs, so its mutating routes resolve no\n128: \t// job), which exercises the resolution + error-envelope paths; the success\n129: \t// envelopes (create, edit-brief, orphans-list) carry only identifiers and\n130: \t// status text.\n131: \tmutating := []struct {\n132: \t\tmethod, path, body string\n133: \t}{\n134: \t\t// create: succeeds (non-git fallback) — the 201 envelope must not echo\n135: \t\t// credentials.\n136: \t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs\", `{\"title\":\"Cred Check\"}`},\n137: \t\t// create with a bad type: a 400 error envelope.\n138: \t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs\", `{\"title\":\"X\",\"type\":\"bogus\"}`},\n139: \t\t// edit-brief: succeeds — the write + (non-git) warning envelope.\n140: \t\t{http.MethodPut, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/brief\", \"# Brief: Cred Check\\n\"},\n141: \t\t// launch-agent: 404 for an unknown agent (agentlist.Discover reads the\n142: \t\t// checkout's agents — see fakeCheckout above), never a credential echo.\n143: \t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/agents/no-such-agent\", \"\"},\n144: \t\t// launch-jdi: 202 (the mg binary is stubbed), or a structured error.\n145: \t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/jdi\", \"\"},\n146: \t\t// done: 409 verdict warning (the fake job has no verdict) — the\n147: \t\t// warning text must not echo credentials.\n148: \t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/done\", \"\"},\n149: \t\t// push: non-git project → a structured 500 git error envelope.\n150: \t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/push\", \"\"},\n151: \t\t// prune: docker absent → a structured 500 error envelope.\n152: \t\t{http.MethodPost, \"/prune\", \"\"},\n153: \t\t// orphans list: read-only, an empty (or populated) list envelope.\n154: \t\t{http.MethodGet, \"/projects/\" + filepath.Base(jobProj) + \"/orphans\", \"\"},\n155: \t\t// orphan delete: 404 for an unknown orphan — the error envelope.\n156: \t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/orphans/no-such-orphan/delete\", \"\"},\n157: \t\t// session-log stream: a bad ?from is a 400 before any SSE body — the\n158: \t\t// error envelope (the stream itself is exercised in stream_test.go).\n159: \t\t{http.MethodGet, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/session-log/stream?from=-1\", \"\"},\n160: \t\t// delete: resolves a real (non-git) job — the DeleteResult envelope.\n161: \t\t// Kept last: it removes wood_oak, so every earlier request still\n162: \t\t// resolves the job.\n163: \t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/delete\", \"\"},\n164: \t}\n165: \tstubJdiExe(t, \"/bin/true\")\n166: \tfor _, m := range mutating {\n167: \t\trec := request(t, srv, m.method, m.path, auth, m.body)\n168: \t\tassertBodyHasNoCredentials(t, rec.Body.String(), envLines, envFile.String())\n169: \t}\n170: \n171: \t// The 401 body (missing and wrong token) — an unauthenticated response\n172: \t// must not leak the token either.\n173: \tfor _, badAuth := range []string{\"\", \"Bearer wrong\"} {\n174: \t\trec := get(t, srv, \"/projects\", badAuth)\n175: \t\tif rec.Code != http.StatusUnauthorized {\n176: \t\t\tt.Fatalf(\"bad auth %q: status = %d, want 401\", badAuth, rec.Code)\n177: \t\t}\n178: \t\tassertBodyHasNoCredentials(t, rec.Body.String(), envLines, envFile.String())\n179: \t}\n180: \n181: \t// The audit log likewise never carries the Authorization header or the\n182: \t// token (the auth= field is the outcome classification only).\n183: \tif strings.Contains(audit.String(), token) {\n184: \t\tt.Errorf(\"audit log contains the token:\\n%s\", audit.String())\n185: \t}\n186: \tfor _, line := range strings.Split(audit.String(), \"\\n\") {\n187: \t\tif strings.Contains(line, \"Authorization\") || strings.Contains(line, \"Bearer \") {\n188: \t\t\tt.Errorf(\"audit log echoes the Authorization header: %q\", line)\n189: \t\t}\n190: \t}\n191: }\n192: \n193: // assertBodyHasNoCredentials fails the test if body contains any planted\n194: // credential value or any full line of the .env file.\n195: func assertBodyHasNoCredentials(t *testing.T, body string, envLines map[string]string, envFileContent string) {\n196: \tt.Helper()\n197: \tfor _, key := range credentialKeys {\n198: \t\tif strings.Contains(body, envLines[key]) {\n199: \t\t\tt.Errorf(\"response leaks the value of %s:\\n%s\", key, body)\n200: \t\t}\n201: \t}\n202: \tfor _, line := range strings.Split(envFileContent, \"\\n\") {\n203: \t\tif line == \"\" {\n204: \t\t\tcontinue\n205: \t\t}\n206: \t\tif strings.Contains(body, line) {\n207: \t\t\tt.Errorf(\"response contains a full .env line %q:\\n%s\", line, body)\n208: \t\t}\n209: \t}\n210: }\n211: \n212: // TestCredentialValuesDoNotAppearInErrorMessages: error envelopes carry only\n213: // validated identifiers — never anything that could echo a credential.\n214: func TestCredentialValuesDoNotAppearInErrorMessages(t *testing.T) {\n215: \tt.Setenv(\"MG_SERVE_TOKEN\", \"fixture-token-12345\")\n216: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n217: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"fixture-token-12345\", nil)\n218: \n219: \t// The error envelope shape is exactly {\"error\": \"...\"} — nothing else.\n220: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/nope/files/brief.md\", \"Bearer fixture-token-12345\")\n221: \tif rec.Code != http.StatusNotFound {\n222: \t\tt.Fatalf(\"status = %d, want 404\", rec.Code)\n223: \t}\n224: \tvar envelope map[string]string\n225: \tif err := json.Unmarshal(rec.Body.Bytes(), &envelope); err != nil {\n226: \t\tt.Fatalf(\"error body not a JSON envelope: %v (%s)\", err, rec.Body.String())\n227: \t}\n228: \tif len(envelope) != 1 || envelope[\"error\"] == \"\" {\n229: \t\tt.Errorf(\"error envelope = %v, want exactly one error key\", envelope)\n230: \t}\n231: \tif strings.Contains(rec.Body.String(), \"fixture-token-12345\") {\n232: \t\tt.Errorf(\"error body leaks the token: %s\", rec.Body.String())\n233: \t}\n234: }\n\n(End of file - total 234 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// credentialKeys are the keys whose values must never appear in any response\n// body — the daemon's credential surface: subscription tokens, API keys, the\n// serve token, and the per-profile model keys. The test reads their values via\n// the same config.EnvValue path the daemon itself reads (the .env file in the\n// manigot checkout, then the process environment), so the test and the server\n// can never drift on what counts as a credential.\nvar credentialKeys = []string{","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/credentials_test.go","text":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// credentialKeys are the keys whose values must never appear in any response\n// body — the daemon's credential surface: subscription tokens, API keys, the\n// serve token, and the per-profile model keys. The test reads their values via\n// the same config.EnvValue path the daemon itself reads (the .env file in the\n// manigot checkout, then the process environment), so the test and the server\n// can never drift on what counts as a credential.\nvar credentialKeys = []string{\n\t\"CLAUDE_CODE_OAUTH_TOKEN\",\n\t\"CLAUDE_ACCOUNT_UUID\",\n\t\"CLAUDE_EMAIL\",\n\t\"CLAUDE_ORG_UUID\",\n\t\"ANTHROPIC_API_KEY\",\n\t\"OPENCODE_API_KEY\",\n\t\"ZHIPU_API_KEY\",\n\t\"MG_SERVE_TOKEN\",\n\t\"OPENCODE_ZAI_MODEL\",\n\t\"OPENCODE_GO_MODEL\",\n\t\"OPENCODE_ZEN_MODEL\",\n\t\"OPENCODE_ZEN_FREE_MODEL\",\n\t\"OPENCODE_MODEL\",\n\t\"OPENCODE_THEME\",\n}\n\n// TestCredentialsNeverReturned is the brief's \"no .env content, no keys, no\n// tokens in any response, ever\" guarantee enforced over the whole surface: a\n// known credential value is planted in the daemon's real credential source\n// (.env + process env), every endpoint is hit (with the correct bearer token),\n// and every response body — including a 401 — is grepped for the values.\nfunc TestCredentialsNeverReturned(t *testing.T) {\n\t// The credential source: a fake checkout's .env plus the process\n\t// environment, both read through config.EnvValue exactly as the daemon\n\t// reads them.\n\tenvLines := map[string]string{}\n\tfor _, key := range credentialKeys {\n\t\tenvLines[key] = \"fixture-\" + key + \"-VALUE\"\n\t\tt.Setenv(key, envLines[key])\n\t}\n\tcheckout := fakeCheckout(t, map[string]string{\n\t\t\"analyst\": \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n\t})\n\t// The .env file itself — the daemon's preferred source. Two extra\n\t// non-credential lines ride along to pin the \"no full line of .env\n\t// content\" half of the guarantee.\n\tvar envFile strings.Builder\n\tfor _, key := range credentialKeys {\n\t\tenvFile.WriteString(key + \"=\" + envLines[key] + \"\\n\")\n\t}\n\tenvFile.WriteString(\"# a comment line in the env\\n\")\n\tenvFile.WriteString(\"UNRELATED_SETTING=some-value\\n\")\n\tif err := os.WriteFile(filepath.Join(checkout, \".env\"), []byte(envFile.String()), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\t// A non-git project with a job (exercises projects/jobs/files/jdi/agents),\n\t// and a git repo with a job branch (exercises diff).\n\tjobProj := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"),\n\t\t\"tasks.md\", \"implementation.md\", \"verdict.md\")\n\tif err := writeJDIStatusForTest(t, jobProj, \"wood_oak\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tlogDir := job.JDIStatusDir(jobProj, \"wood_oak\")\n\tif err := os.MkdirAll(logDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(job.JDIRunLogPath(jobProj, \"wood_oak\"), []byte(\"run log content\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(jobProj, \"docs\", \"jobs\", \"wood_oak\", \"session.log\"), []byte(\"session log content\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\tgitProj := initGitRepo(t)\n\trunGitT(t, gitProj, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n\tif err := os.WriteFile(filepath.Join(gitProj, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGitT(t, gitProj, \"add\", \"feature.txt\")\n\trunGitT(t, gitProj, \"commit\", \"-q\", \"-m\", \"add the feature\")\n\trunGitT(t, gitProj, \"checkout\", \"-q\", \"main\")\n\n\treg := &Registry{entries: []Entry{entryFor(jobProj), entryFor(gitProj)}}\n\ttoken := envLines[\"MG_SERVE_TOKEN\"]\n\tvar audit strings.Builder\n\tsrv := New(reg, \"test-version\", token, &audit)\n\tauth := \"Bearer \" + token\n\n\t// Every endpoint, plus a 401 (no token) and a 404 (unknown job) — the\n\t// error envelopes are response surfaces too.\n\tpaths := []string{\n\t\t\"/health\",\n\t\t\"/projects\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/brief.md\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/tasks.md\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/implementation.md\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/verdict.md\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/jdi\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/agents\",\n\t\t\"/projects/\" + filepath.Base(gitProj) + \"/jobs/wood_test/diff\",\n\t\t\"/projects/\" + filepath.Base(gitProj) + \"/jobs/wood_test/diff?full=1\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/jdi?bogus=1\",\n\t\t\"/projects/no-such-project/jobs\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/no-such-job/files/brief.md\",\n\t}\n\tfor _, p := range paths {\n\t\trec := get(t, srv, p, auth)\n\t\tassertBodyHasNoCredentials(t, rec.Body.String(), envLines, envFile.String())\n\t}\n\n\t// Job two's mutating surface — every mutating endpoint's response or error\n\t// body (the 2xx success envelopes and the 4xx/5xx structured errors alike)\n\t// must never echo .env content. All of these run against the fake non-git\n\t// jobProj (gitProj has no docs/jobs, so its mutating routes resolve no\n\t// job), which exercises the resolution + error-envelope paths; the success\n\t// envelopes (create, edit-brief, orphans-list) carry only identifiers and\n\t// status text.\n\tmutating := []struct {\n\t\tmethod, path, body string\n\t}{\n\t\t// create: succeeds (non-git fallback) — the 201 envelope must not echo\n\t\t// credentials.\n\t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs\", `{\"title\":\"Cred Check\"}`},\n\t\t// create with a bad type: a 400 error envelope.\n\t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs\", `{\"title\":\"X\",\"type\":\"bogus\"}`},\n\t\t// edit-brief: succeeds — the write + (non-git) warning envelope.\n\t\t{http.MethodPut, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/brief\", \"# Brief: Cred Check\\n\"},\n\t\t// launch-agent: 404 for an unknown agent (agentlist.Discover reads the\n\t\t// checkout's agents — see fakeCheckout above), never a credential echo.\n\t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/agents/no-such-agent\", \"\"},\n\t\t// launch-jdi: 202 (the mg binary is stubbed), or a structured error.\n\t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/jdi\", \"\"},\n\t\t// done: 409 verdict warning (the fake job has no verdict) — the\n\t\t// warning text must not echo credentials.\n\t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/done\", \"\"},\n\t\t// push: non-git project → a structured 500 git error envelope.\n\t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/push\", \"\"},\n\t\t// prune: docker absent → a structured 500 error envelope.\n\t\t{http.MethodPost, \"/prune\", \"\"},\n\t\t// orphans list: read-only, an empty (or populated) list envelope.\n\t\t{http.MethodGet, \"/projects/\" + filepath.Base(jobProj) + \"/orphans\", \"\"},\n\t\t// orphan delete: 404 for an unknown orphan — the error envelope.\n\t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/orphans/no-such-orphan/delete\", \"\"},\n\t\t// session-log stream: a bad ?from is a 400 before any SSE body — the\n\t\t// error envelope (the stream itself is exercised in stream_test.go).\n\t\t{http.MethodGet, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/session-log/stream?from=-1\", \"\"},\n\t\t// delete: resolves a real (non-git) job — the DeleteResult envelope.\n\t\t// Kept last: it removes wood_oak, so every earlier request still\n\t\t// resolves the job.\n\t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/delete\", \"\"},\n\t}\n\tstubJdiExe(t, \"/bin/true\")\n\tfor _, m := range mutating {\n\t\trec := request(t, srv, m.method, m.path, auth, m.body)\n\t\tassertBodyHasNoCredentials(t, rec.Body.String(), envLines, envFile.String())\n\t}\n\n\t// The 401 body (missing and wrong token) — an unauthenticated response\n\t// must not leak the token either.\n\tfor _, badAuth := range []string{\"\", \"Bearer wrong\"} {\n\t\trec := get(t, srv, \"/projects\", badAuth)\n\t\tif rec.Code != http.StatusUnauthorized {\n\t\t\tt.Fatalf(\"bad auth %q: status = %d, want 401\", badAuth, rec.Code)\n\t\t}\n\t\tassertBodyHasNoCredentials(t, rec.Body.String(), envLines, envFile.String())\n\t}\n\n\t// The audit log likewise never carries the Authorization header or the\n\t// token (the auth= field is the outcome classification only).\n\tif strings.Contains(audit.String(), token) {\n\t\tt.Errorf(\"audit log contains the token:\\n%s\", audit.String())\n\t}\n\tfor _, line := range strings.Split(audit.String(), \"\\n\") {\n\t\tif strings.Contains(line, \"Authorization\") || strings.Contains(line, \"Bearer \") {\n\t\t\tt.Errorf(\"audit log echoes the Authorization header: %q\", line)\n\t\t}\n\t}\n}\n\n// assertBodyHasNoCredentials fails the test if body contains any planted\n// credential value or any full line of the .env file.\nfunc assertBodyHasNoCredentials(t *testing.T, body string, envLines map[string]string, envFileContent string) {\n\tt.Helper()\n\tfor _, key := range credentialKeys {\n\t\tif strings.Contains(body, envLines[key]) {\n\t\t\tt.Errorf(\"response leaks the value of %s:\\n%s\", key, body)\n\t\t}\n\t}\n\tfor _, line := range strings.Split(envFileContent, \"\\n\") {\n\t\tif line == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif strings.Contains(body, line) {\n\t\t\tt.Errorf(\"response contains a full .env line %q:\\n%s\", line, body)\n\t\t}\n\t}\n}\n\n// TestCredentialValuesDoNotAppearInErrorMessages: error envelopes carry only\n// validated identifiers — never anything that could echo a credential.\nfunc TestCredentialValuesDoNotAppearInErrorMessages(t *testing.T) {\n\tt.Setenv(\"MG_SERVE_TOKEN\", \"fixture-token-12345\")\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"fixture-token-12345\", nil)\n\n\t// The error envelope shape is exactly {\"error\": \"...\"} — nothing else.\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/nope/files/brief.md\", \"Bearer fixture-token-12345\")\n\tif rec.Code != http.StatusNotFound {\n\t\tt.Fatalf(\"status = %d, want 404\", rec.Code)\n\t}\n\tvar envelope map[string]string\n\tif err := json.Unmarshal(rec.Body.Bytes(), &envelope); err != nil {\n\t\tt.Fatalf(\"error body not a JSON envelope: %v (%s)\", err, rec.Body.String())\n\t}\n\tif len(envelope) != 1 || envelope[\"error\"] == \"\" {\n\t\tt.Errorf(\"error envelope = %v, want exactly one error key\", envelope)\n\t}\n\tif strings.Contains(rec.Body.String(), \"fixture-token-12345\") {\n\t\tt.Errorf(\"error body leaks the token: %s\", rec.Body.String())\n\t}\n}","lineStart":1,"lineEnd":234,"totalLines":234,"truncated":false}},"title":"src/internal/serve/credentials_test.go","time":{"start":1787993744695,"end":1787993744700}},"id":"prt_04cbb6532001trNiAxQXfL3fDV","sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","messageID":"msg_04cbb582a001EX0GMTgFxPLoE6"}}
