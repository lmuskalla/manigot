s routes (job brother): the project position on GET/PUT\n+\t// /projects/{project}/settings — the same resolveProject choke point.\n+\tfor _, seg := range hostileSegments {\n+\t\turls = append(urls,\n+\t\t\tmutURL{http.MethodGet, \"/projects/\" + seg + \"/settings\", \"settings project segment \" + seg},\n+\t\t\tmutURL{http.MethodPut, \"/projects/\" + seg + \"/settings\", \"settings project segment \" + seg},\n+\t\t)\n+\t}\n \n \tfor _, u := range urls {\n \t\trec := request(t, srv, u.method, u.path, \"\", \"\")\ndiff --git a/src/internal/serve/server.go b/src/internal/serve/server.go\nindex 91c1152..6584de9 100644\n--- a/src/internal/serve/server.go\n+++ b/src/internal/serve/server.go\n@@ -89,6 +89,13 @@ func (s *Server) routes(mux *http.ServeMux) {\n \tmux.HandleFunc(\"GET /projects/{project}/orphans\", s.handleProjectOrphans)\n \tmux.HandleFunc(\"POST /projects/{project}/orphans/{name}/delete\", s.handleDeleteOrphan)\n \n+\t// Settings (job brother): the global default profile, and the\n+\t// per-project baseBranch + jobBranchPrefix — see settings.go.\n+\tmux.HandleFunc(\"GET /settings\", s.handleGetSettings)\n+\tmux.HandleFunc(\"PUT /settings\", s.handlePutSettings)\n+\tmux.HandleFunc(\"GET /projects/{project}/settings\", s.handleGetProjectSettings)\n+\tmux.HandleFunc(\"PUT /projects/{project}/settings\", s.handlePutProjectSettings)\n+\n \t// Live run supervision (job two).\n \tmux.HandleFunc(\"GET /projects/{project}/jobs/{job}/session-log/stream\", s.handleSessionLogStream)\n }\n","exit":0,"truncated":false},"title":"git -C /workspace diff main..HEAD -- src/internal/serve/server.go src/internal/serve/credentials_test.go src/internal/serve/security_test.go","time":{"start":1787994765231,"end":1787994765234}},"id":"prt_04ccaf6ca0016d4uqcjTrUAHBO","sessionID":"ses_fb3368eedffetvzxol071th185","messageID":"msg_04ccae8c1001asuxm1wfaC3aJF"}}
{"type":"text","timestamp":1787994765266,"sessionID":"ses_fb3368eedffetvzxol071th185","part":{"id":"prt_04ccaf346001tivCrBXYuPGnLM","messageID":"msg_04ccae8c1001asuxm1wfaC3aJF","sessionID":"ses_fb3368eedffetvzxol071th185","type":"text","text":"Every failure is the git shim refusing `git init`/`git worktree` — 284 shim-related failures, zero non-shim causes. Environmental, not my change. Verification complete: build OK, vet OK, all affected packages pass.\n\nNow the remaining work: write `implementation.md` (the developer deliverable). Let me review the full diff to document it accurately.","time":{"start":1787994764102,"end":1787994765264}}}
