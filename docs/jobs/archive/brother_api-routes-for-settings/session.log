{"type":"tool_use","timestamp":1787993741160,"sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","part":{"type":"tool","tool":"read","callID":"call_d35b381e0b8f431385171ecc","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/testutil_test.go"},"output":"<path>/workspace/src/internal/serve/testutil_test.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"net\"\n5: \t\"net/http\"\n6: \t\"os\"\n7: \t\"os/exec\"\n8: \t\"path/filepath\"\n9: \t\"strings\"\n10: \t\"testing\"\n11: \n12: \t\"github.com/lmuskalla/manigot/internal/job\"\n13: )\n14: \n15: // entryFor turns a project root into a registry Entry named after the\n16: // root's base name — the shared shape most tests use, since URL construction\n17: // throughout this package already spells out filepath.Base(root) (a holdover\n18: // from when Project matched by base name). Resolution is strictly by\n19: // configured Name now — see TestRegistryProjectNameOnlyResolution in\n20: // registry_test.go for the pin that a differently-named entry does NOT\n21: // resolve by its directory's base name.\n22: func entryFor(root string) Entry {\n23: \treturn Entry{Name: filepath.Base(root), Path: filepath.Clean(root)}\n24: }\n25: \n26: // netListen is net.Listen's tcp form, split out so tests read cleanly.\n27: func netListen(addr string) (net.Listener, error) {\n28: \treturn net.Listen(\"tcp\", addr)\n29: }\n30: \n31: // httpGet is http.Get, split out for the same reason.\n32: func httpGet(url string) (*http.Response, error) {\n33: \treturn http.Get(url)\n34: }\n35: \n36: // writeJDIStatusForTest writes a stopped:finished reviewer sidecar for the\n37: // named job under root, so job-reader tests have a live status to read.\n38: func writeJDIStatusForTest(t *testing.T, root, jobName string) error {\n39: \tt.Helper()\n40: \treturn job.WriteJDIStatus(root, jobName, job.JDIStoppedFinished, \"reviewer\")\n41: }\n42: \n43: // pathWithRealGitOnly returns a PATH value containing the real git binary and\n44: // nothing else, so tests that need `git init` (to build throwaway repos) are\n45: // not blocked by the manigot session git shim, which may sit on PATH and\n46: // refuses git init. Mirrors cmd/mg/session_test.go's same-named helper.\n47: func pathWithRealGitOnly(t *testing.T) string {\n48: \tt.Helper()\n49: \tbinDir := t.TempDir()\n50: \trealGit := \"/usr/bin/git\"\n51: \tif _, err := os.Stat(realGit); err != nil {\n52: \t\tvar lerr error\n53: \t\trealGit, lerr = exec.LookPath(\"git\")\n54: \t\tif lerr != nil {\n55: \t\t\tt.Fatalf(\"could not locate a real git: %v\", lerr)\n56: \t\t}\n57: \t}\n58: \tif err := os.Symlink(realGit, filepath.Join(binDir, \"git\")); err != nil {\n59: \t\tt.Fatal(err)\n60: \t}\n61: \treturn binDir\n62: }\n63: \n64: // runGitT runs git -C dir args, failing the test on any error — the throwaway\n65: // repo builder for tests that exercise real git (the diff endpoint).\n66: func runGitT(t *testing.T, dir string, args ...string) {\n67: \tt.Helper()\n68: \tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n69: \tif out, err := cmd.CombinedOutput(); err != nil {\n70: \t\tt.Fatalf(\"git %s in %s: %v\\n%s\", strings.Join(args, \" \"), dir, err, out)\n71: \t}\n72: }\n73: \n74: // initGitRepo creates a fresh git repo at a temp dir (default branch main, a\n75: // deterministic identity, gpg signing off) with one initial commit, returning\n76: // the dir. The caller must set PATH to pathWithRealGitOnly first.\n77: func initGitRepo(t *testing.T) string {\n78: \tt.Helper()\n79: \tdir := t.TempDir()\n80: \trunGitT(t, dir, \"init\", \"-q\", \"-b\", \"main\")\n81: \trunGitT(t, dir, \"config\", \"user.email\", \"t@example.com\")\n82: \trunGitT(t, dir, \"config\", \"user.name\", \"Test\")\n83: \trunGitT(t, dir, \"config\", \"commit.gpgsign\", \"false\")\n84: \tif err := os.WriteFile(filepath.Join(dir, \"README\"), []byte(\"init\\n\"), 0o644); err != nil {\n85: \t\tt.Fatal(err)\n86: \t}\n87: \trunGitT(t, dir, \"add\", \"README\")\n88: \trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"init\")\n89: \treturn dir\n90: }\n91: \n92: // fakeCheckout creates a minimal manigot checkout (scripts/entrypoint.sh, the\n93: // file home.looksLikeCheckout keys off, plus agents/ with the named agent\n94: // files) and points $MANIGOT_HOME at it. Returns the checkout dir.\n95: func fakeCheckout(t *testing.T, agents map[string]string) string {\n96: \tt.Helper()\n97: \tdir := t.TempDir()\n98: \tif err := os.MkdirAll(filepath.Join(dir, \"scripts\"), 0o755); err != nil {\n99: \t\tt.Fatal(err)\n100: \t}\n101: \tif err := os.WriteFile(filepath.Join(dir, \"scripts\", \"entrypoint.sh\"), []byte(\"#!/bin/sh\\n\"), 0o755); err != nil {\n102: \t\tt.Fatal(err)\n103: \t}\n104: \tif len(agents) > 0 {\n105: \t\tif err := os.MkdirAll(filepath.Join(dir, \"agents\"), 0o755); err != nil {\n106: \t\t\tt.Fatal(err)\n107: \t\t}\n108: \t\tfor name, body := range agents {\n109: \t\t\tif err := os.WriteFile(filepath.Join(dir, \"agents\", name+\".md\"), []byte(body), 0o644); err != nil {\n110: \t\t\t\tt.Fatal(err)\n111: \t\t\t}\n112: \t\t}\n113: \t}\n114: \tt.Setenv(\"MANIGOT_HOME\", dir)\n115: \treturn dir\n116: }\n\n(End of file - total 116 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"net\"\n\t\"net/http\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// entryFor turns a project root into a registry Entry named after the\n// root's base name — the shared shape most tests use, since URL construction\n// throughout this package already spells out filepath.Base(root) (a holdover\n// from when Project matched by base name). Resolution is strictly by\n// configured Name now — see TestRegistryProjectNameOnlyResolution in\n// registry_test.go for the pin that a differently-named entry does NOT","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/testutil_test.go","text":"package serve\n\nimport (\n\t\"net\"\n\t\"net/http\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// entryFor turns a project root into a registry Entry named after the\n// root's base name — the shared shape most tests use, since URL construction\n// throughout this package already spells out filepath.Base(root) (a holdover\n// from when Project matched by base name). Resolution is strictly by\n// configured Name now — see TestRegistryProjectNameOnlyResolution in\n// registry_test.go for the pin that a differently-named entry does NOT\n// resolve by its directory's base name.\nfunc entryFor(root string) Entry {\n\treturn Entry{Name: filepath.Base(root), Path: filepath.Clean(root)}\n}\n\n// netListen is net.Listen's tcp form, split out so tests read cleanly.\nfunc netListen(addr string) (net.Listener, error) {\n\treturn net.Listen(\"tcp\", addr)\n}\n\n// httpGet is http.Get, split out for the same reason.\nfunc httpGet(url string) (*http.Response, error) {\n\treturn http.Get(url)\n}\n\n// writeJDIStatusForTest writes a stopped:finished reviewer sidecar for the\n// named job under root, so job-reader tests have a live status to read.\nfunc writeJDIStatusForTest(t *testing.T, root, jobName string) error {\n\tt.Helper()\n\treturn job.WriteJDIStatus(root, jobName, job.JDIStoppedFinished, \"reviewer\")\n}\n\n// pathWithRealGitOnly returns a PATH value containing the real git binary and\n// nothing else, so tests that need `git init` (to build throwaway repos) are\n// not blocked by the manigot session git shim, which may sit on PATH and\n// refuses git init. Mirrors cmd/mg/session_test.go's same-named helper.\nfunc pathWithRealGitOnly(t *testing.T) string {\n\tt.Helper()\n\tbinDir := t.TempDir()\n\trealGit := \"/usr/bin/git\"\n\tif _, err := os.Stat(realGit); err != nil {\n\t\tvar lerr error\n\t\trealGit, lerr = exec.LookPath(\"git\")\n\t\tif lerr != nil {\n\t\t\tt.Fatalf(\"could not locate a real git: %v\", lerr)\n\t\t}\n\t}\n\tif err := os.Symlink(realGit, filepath.Join(binDir, \"git\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn binDir\n}\n\n// runGitT runs git -C dir args, failing the test on any error — the throwaway\n// repo builder for tests that exercise real git (the diff endpoint).\nfunc runGitT(t *testing.T, dir string, args ...string) {\n\tt.Helper()\n\tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"git %s in %s: %v\\n%s\", strings.Join(args, \" \"), dir, err, out)\n\t}\n}\n\n// initGitRepo creates a fresh git repo at a temp dir (default branch main, a\n// deterministic identity, gpg signing off) with one initial commit, returning\n// the dir. The caller must set PATH to pathWithRealGitOnly first.\nfunc initGitRepo(t *testing.T) string {\n\tt.Helper()\n\tdir := t.TempDir()\n\trunGitT(t, dir, \"init\", \"-q\", \"-b\", \"main\")\n\trunGitT(t, dir, \"config\", \"user.email\", \"t@example.com\")\n\trunGitT(t, dir, \"config\", \"user.name\", \"Test\")\n\trunGitT(t, dir, \"config\", \"commit.gpgsign\", \"false\")\n\tif err := os.WriteFile(filepath.Join(dir, \"README\"), []byte(\"init\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGitT(t, dir, \"add\", \"README\")\n\trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"init\")\n\treturn dir\n}\n\n// fakeCheckout creates a minimal manigot checkout (scripts/entrypoint.sh, the\n// file home.looksLikeCheckout keys off, plus agents/ with the named agent\n// files) and points $MANIGOT_HOME at it. Returns the checkout dir.\nfunc fakeCheckout(t *testing.T, agents map[string]string) string {\n\tt.Helper()\n\tdir := t.TempDir()\n\tif err := os.MkdirAll(filepath.Join(dir, \"scripts\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(dir, \"scripts\", \"entrypoint.sh\"), []byte(\"#!/bin/sh\\n\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(agents) > 0 {\n\t\tif err := os.MkdirAll(filepath.Join(dir, \"agents\"), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tfor name, body := range agents {\n\t\t\tif err := os.WriteFile(filepath.Join(dir, \"agents\", name+\".md\"), []byte(body), 0o644); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t}\n\t}\n\tt.Setenv(\"MANIGOT_HOME\", dir)\n\treturn dir\n}","lineStart":1,"lineEnd":116,"totalLines":116,"truncated":false}},"title":"src/internal/serve/testutil_test.go","time":{"start":1787993741151,"end":1787993741158}},"id":"prt_04cbb575b001qwcLdPjrOPSljg","sessionID":"ses_fb3458985ffeeMJ5OFBVh1MOcx","messageID":"msg_04cbac9b70012ocjxXdAAhhhnf"}}
