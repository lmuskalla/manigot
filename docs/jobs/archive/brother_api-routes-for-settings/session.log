nvironment, overwriting anything inherited), else the process\n// environment. The ported CLI commands use it for readiness checks so an\n// inherited export counts as configured, exactly like the scripts' `${!KEY:-}`\n// reads did.\n","exit":0,"truncated":false},"title":"cd /workspace/src && grep -n \"func envValue\\|func EnvFile\\|func GetEnv\" internal/config/config.go && sed -n '380,425p' internal/config/config.go","time":{"start":1787995113659,"end":1787995113662}},"id":"prt_04cd047150018vX9zJhaC5x9W1","sessionID":"ses_fb3337e5bffeqUmulSYU99zDKc","messageID":"msg_04ccfc8a5001Z5SBMOpZY78hP4"}}
