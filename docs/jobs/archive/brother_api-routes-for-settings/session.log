{"type":"tool_use","timestamp":1787994672286,"sessionID":"ses_fb3368eedffetvzxol071th185","part":{"type":"tool","tool":"read","callID":"call_6d1f28ee023f47cb87706a1b","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/settings.go"},"output":"<path>/workspace/src/internal/serve/settings.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"fmt\"\n5: \t\"net/http\"\n6: \t\"strings\"\n7: \n8: \t\"github.com/lmuskalla/manigot/internal/config\"\n9: \t\"github.com/lmuskalla/manigot/internal/project\"\n10: )\n11: \n12: // --- GET/PUT /settings — the global default profile (TASK-1) ------------------\n13: //\n14: // The one global setting this API exposes is the default subscription profile\n15: // (the brief's \"set the profile\"). Its storage and its write primitive are\n16: // exactly `mg profiles <name>`'s: MANIGOT_PROFILE in manigot's .env, written\n17: // via config.UpsertEnv — so CLI, TUI, and this API share one default, and a\n18: // profile switch made over HTTP changes what the next bare `mg`, TUI, and\n19: // mg-jdi launch use, with no daemon-side caching to drift.\n20: \n21: // settingsResponse is the GET /settings response: the effective default\n22: // profile id — config.EnvValue(\"MANIGOT_PROFILE\") with the ProfileClaudePro\n23: // fallback, the same \"Active default\" chain `mg profiles` displays. The\n24: // profile id is a plain identifier, never credential material (readiness\n25: // lives in /health as a boolean).\n26: type settingsResponse struct {\n27: \tProfile string `json:\"profile\"`\n28: }\n29: \n30: // settingsRequest is the PUT /settings request body. Profile is required: an\n31: // empty body or an absent field is a 400, not a silent reset to claude-pro —\n32: // the endpoint exists to set the default, and a defaulting write would let a\n33: // caller believe it changed something it did not.\n34: type settingsRequest struct {\n35: \tProfile string `json:\"profile\"`\n36: }\n37: \n38: // handleGetSettings serves the effective default profile. No lock: a pure\n39: // .env read, no project-scoped state.\n40: func (s *Server) handleGetSettings(w http.ResponseWriter, r *http.Request) {\n41: \twriteJSON(w, http.StatusOK, settingsResponse{Profile: activeProfile()})\n42: }\n43: \n44: // activeProfile returns the effective default profile the way `mg profiles`\n45: // reports it: MANIGOT_PROFILE via config.EnvValue (the .env file first, then\n46: // the process environment), falling back to ProfileClaudePro when unset.\n47: func activeProfile() string {\n48: \tif p := strings.TrimSpace(config.EnvValue(\"MANIGOT_PROFILE\")); p != \"\" {\n49: \t\treturn p\n50: \t}\n51: \treturn config.ProfileClaudePro\n52: }\n53: \n54: // handlePutSettings sets the default profile (config.UpsertEnv — the same\n55: // write `mg profiles <name>` makes, so every launch path picks it up). The id\n56: // is validated against config.ProfileByID first: an unknown profile is a 400\n57: // listing nothing about credentials, not a launch failure surfacing later. No\n58: // project lock: this setting is global (manigot's .env), scoped to no\n59: // registered root.\n60: func (s *Server) handlePutSettings(w http.ResponseWriter, r *http.Request) {\n61: \tvar req settingsRequest\n62: \tif !decodeJSONBody(w, r, &req) {\n63: \t\treturn\n64: \t}\n65: \tprofile := strings.TrimSpace(req.Profile)\n66: \tif profile == \"\" {\n67: \t\twriteError(w, http.StatusBadRequest, \"profile is required\")\n68: \t\treturn\n69: \t}\n70: \tif _, known := config.ProfileByID(profile); !known {\n71: \t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"unknown profile %q\", profile))\n72: \t\treturn\n73: \t}\n74: \tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", profile); err != nil {\n75: \t\twriteError(w, http.StatusInternalServerError, err.Error())\n76: \t\treturn\n77: \t}\n78: \twriteJSON(w, http.StatusOK, settingsResponse{Profile: profile})\n79: }\n80: \n81: // --- GET/PUT /projects/{project}/settings (TASK-2) ---------------------------\n82: //\n83: // The per-project settings this API exposes are the brief's baseBranch and\n84: // prefix (jobBranchPrefix). Their storage and writer are exactly the TUI\n85: // settings screen's: .manigot/manigot.json in the target project, read via\n86: // project.Load and written via project.Save — the sanctioned host-side writer\n87: // for the one directory outside docs/ manigot tooling owns.\n88: \n89: // projectSettingsResponse is the project settings response shape. BaseBranch\n90: // is the effective value (project.Settings.BaseBranchValue — \"main\" when\n91: // unset), so a client always gets a usable ref; JobBranchPrefix is the stored\n92: // value, empty meaning no prefix (it has no non-empty default).\n93: type projectSettingsResponse struct {\n94: \tBaseBranch      string `json:\"baseBranch\"`\n95: \tJobBranchPrefix string `json:\"jobBranchPrefix\"`\n96: }\n97: \n98: // projectSettingsResponseFrom builds the response from stored settings.\n99: func projectSettingsResponseFrom(s project.Settings) projectSettingsResponse {\n100: \treturn projectSettingsResponse{\n101: \t\tBaseBranch:      s.BaseBranchValue(),\n102: \t\tJobBranchPrefix: s.JobBranchPrefix,\n103: \t}\n104: }\n105: \n106: // projectSettingsRequest is the PUT request body — a wholesale replacement\n107: // (the PUT files/brief precedent: the whole settings object, not a patch), so\n108: // an absent field clears that setting to its default. Both fields are\n109: // optional; empty means \"unset\" (baseBranch → main fallback, prefix → none).\n110: type projectSettingsRequest struct {\n111: \tBaseBranch      string `json:\"baseBranch\"`\n112: \tJobBranchPrefix string `json:\"jobBranchPrefix\"`\n113: }\n114: \n115: // handleGetProjectSettings serves a project's baseBranch + jobBranchPrefix.\n116: // No lock: a pure read, like every other read endpoint.\n117: func (s *Server) handleGetProjectSettings(w http.ResponseWriter, r *http.Request) {\n118: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n119: \tif !ok {\n120: \t\treturn\n121: \t}\n122: \tsettings, err := project.Load(root)\n123: \tif err != nil {\n124: \t\twriteError(w, http.StatusInternalServerError, \"cannot read project settings\")\n125: \t\treturn\n126: \t}\n127: \twriteJSON(w, http.StatusOK, projectSettingsResponseFrom(settings))\n128: }\n129: \n130: // handlePutProjectSettings replaces a project's baseBranch + jobBranchPrefix\n131: // (project.Save — the same writer the TUI settings screen uses) under the\n132: // project lock: the write itself is a plain file write, but create/done read\n133: // these very settings inside their own locked sections (job.CreateJob's base\n134: // branch, FinishJob's merge target), so serializing keeps a settings change\n135: // from interleaving with a job lifecycle decision mid-flight.\n136: //\n137: // Validation is deliberately this layer's: the TUI form free-accepts these\n138: // fields, but an HTTP caller cannot be shown a form — garbage would surface\n139: // later as opaque git failures (mg job's \"base branch '...' does not exist\",\n140: // or worse, a git argv a ref-shaped string was never meant for). A non-empty\n141: // value must therefore be a sane ref component (refComponentProblem); an empty\n142: // value clears the setting to its default.\n143: func (s *Server) handlePutProjectSettings(w http.ResponseWriter, r *http.Request) {\n144: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n145: \tif !ok {\n146: \t\treturn\n147: \t}\n148: \n149: \tvar req projectSettingsRequest\n150: \tif !decodeJSONBody(w, r, &req) {\n151: \t\treturn\n152: \t}\n153: \tbaseBranch := strings.TrimSpace(req.BaseBranch)\n154: \tjobBranchPrefix := strings.TrimSpace(req.JobBranchPrefix)\n155: \tfor _, field := range []struct{ name, value string }{\n156: \t\t{\"baseBranch\", baseBranch},\n157: \t\t{\"jobBranchPrefix\", jobBranchPrefix},\n158: \t} {\n159: \t\tif reason, ok := refComponentProblem(field.value); !ok {\n160: \t\t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"invalid %s %q: %s\", field.name, field.value, reason))\n161: \t\t\treturn\n162: \t\t}\n163: \t}\n164: \n165: \ts.locks.Lock(root)\n166: \tdefer s.locks.Unlock(root)\n167: \n168: \tsettings := project.Settings{\n169: \t\tBaseBranch:      baseBranch,\n170: \t\tJobBranchPrefix: jobBranchPrefix,\n171: \t}\n172: \tif err := project.Save(root, settings); err != nil {\n173: \t\twriteError(w, http.StatusInternalServerError, \"cannot write project settings\")\n174: \t\treturn\n175: \t}\n176: \twriteJSON(w, http.StatusOK, projectSettingsResponseFrom(settings))\n177: }\n178: \n179: // refComponentMaxLen bounds a single settings value — far above any real\n180: // ref name (git's own documented ceiling is 255 bytes for a full ref; these\n181: // are components) while refusing an unbounded write.\n182: const refComponentMaxLen = 200\n183: \n184: // refComponentProblem checks value as a git ref *component chain* — the shape\n185: // baseBranch and jobBranchPrefix actually hold: namespaced branch names like\n186: // \"release/1.2\" or prefix chains like \"team/feature\", where '/' separates\n187: // legal components. It enforces git's own ref rules where they matter for\n188: // correctness and safety (a value that reaches internal/git as an argv\n189: // element must never be an option — hence the leading '-' rejection — nor\n190: // contain shell-irrelevant but git-forbidden characters that make every later\n191: // operation fail), without shelling out: no repo is needed (a non-git project\n192: // may still store settings for later), and the check stays deterministic and\n193: // testable. ok=false with a human-readable reason means reject.\n194: //\n195: // Empty is valid (it means \"clear the setting\") — callers decide whether an\n196: // empty value is allowed; this check is about shape.\n197: func refComponentProblem(value string) (reason string, ok bool) {\n198: \tif value == \"\" {\n199: \t\treturn \"\", true\n200: \t}\n201: \tif len(value) > refComponentMaxLen {\n202: \t\treturn \"longer than the 200-character limit\", false\n203: \t}\n204: \tif strings.HasPrefix(value, \"-\") {\n205: \t\treturn \"must not start with '-' (git would parse it as an option)\", false\n206: \t}\n207: \tif strings.HasPrefix(value, \"/\") || strings.HasSuffix(value, \"/\") {\n208: \t\treturn \"must not start or end with '/'\", false\n209: \t}\n210: \tif strings.HasPrefix(value, \".\") || strings.HasSuffix(value, \".\") {\n211: \t\treturn \"must not start or end with '.'\", false\n212: \t}\n213: \tif strings.HasSuffix(value, \".lock\") {\n214: \t\treturn \"must not end with '.lock' (reserved by git)\", false\n215: \t}\n216: \tif strings.Contains(value, \"..\") {\n217: \t\treturn \"must not contain '..'\", false\n218: \t}\n219: \tif strings.Contains(value, \"@{\") || value == \"@\" {\n220: \t\treturn \"must not contain '@{' or be a lone '@'\", false\n221: \t}\n222: \tfor _, bad := range \"~^:?*[\\\\\" {\n223: \t\tif strings.ContainsRune(value, bad) {\n224: \t\t\treturn fmt.Sprintf(\"must not contain %q\", bad), false\n225: \t\t}\n226: \t}\n227: \tfor i := 0; i < len(value); i++ {\n228: \t\tif c := value[i]; c <= 0x20 || c == 0x7f {\n229: \t\t\treturn \"must not contain control characters or spaces\", false\n230: \t\t}\n231: \t}\n232: \treturn \"\", true\n233: }\n\n(End of file - total 233 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"fmt\"\n\t\"net/http\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// --- GET/PUT /settings — the global default profile (TASK-1) ------------------\n//\n// The one global setting this API exposes is the default subscription profile\n// (the brief's \"set the profile\"). Its storage and its write primitive are\n// exactly `mg profiles <name>`'s: MANIGOT_PROFILE in manigot's .env, written\n// via config.UpsertEnv — so CLI, TUI, and this API share one default, and a\n// profile switch made over HTTP changes what the next bare `mg`, TUI, and\n// mg-jdi launch use, with no daemon-side caching to drift.\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/settings.go","text":"package serve\n\nimport (\n\t\"fmt\"\n\t\"net/http\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// --- GET/PUT /settings — the global default profile (TASK-1) ------------------\n//\n// The one global setting this API exposes is the default subscription profile\n// (the brief's \"set the profile\"). Its storage and its write primitive are\n// exactly `mg profiles <name>`'s: MANIGOT_PROFILE in manigot's .env, written\n// via config.UpsertEnv — so CLI, TUI, and this API share one default, and a\n// profile switch made over HTTP changes what the next bare `mg`, TUI, and\n// mg-jdi launch use, with no daemon-side caching to drift.\n\n// settingsResponse is the GET /settings response: the effective default\n// profile id — config.EnvValue(\"MANIGOT_PROFILE\") with the ProfileClaudePro\n// fallback, the same \"Active default\" chain `mg profiles` displays. The\n// profile id is a plain identifier, never credential material (readiness\n// lives in /health as a boolean).\ntype settingsResponse struct {\n\tProfile string `json:\"profile\"`\n}\n\n// settingsRequest is the PUT /settings request body. Profile is required: an\n// empty body or an absent field is a 400, not a silent reset to claude-pro —\n// the endpoint exists to set the default, and a defaulting write would let a\n// caller believe it changed something it did not.\ntype settingsRequest struct {\n\tProfile string `json:\"profile\"`\n}\n\n// handleGetSettings serves the effective default profile. No lock: a pure\n// .env read, no project-scoped state.\nfunc (s *Server) handleGetSettings(w http.ResponseWriter, r *http.Request) {\n\twriteJSON(w, http.StatusOK, settingsResponse{Profile: activeProfile()})\n}\n\n// activeProfile returns the effective default profile the way `mg profiles`\n// reports it: MANIGOT_PROFILE via config.EnvValue (the .env file first, then\n// the process environment), falling back to ProfileClaudePro when unset.\nfunc activeProfile() string {\n\tif p := strings.TrimSpace(config.EnvValue(\"MANIGOT_PROFILE\")); p != \"\" {\n\t\treturn p\n\t}\n\treturn config.ProfileClaudePro\n}\n\n// handlePutSettings sets the default profile (config.UpsertEnv — the same\n// write `mg profiles <name>` makes, so every launch path picks it up). The id\n// is validated against config.ProfileByID first: an unknown profile is a 400\n// listing nothing about credentials, not a launch failure surfacing later. No\n// project lock: this setting is global (manigot's .env), scoped to no\n// registered root.\nfunc (s *Server) handlePutSettings(w http.ResponseWriter, r *http.Request) {\n\tvar req settingsRequest\n\tif !decodeJSONBody(w, r, &req) {\n\t\treturn\n\t}\n\tprofile := strings.TrimSpace(req.Profile)\n\tif profile == \"\" {\n\t\twriteError(w, http.StatusBadRequest, \"profile is required\")\n\t\treturn\n\t}\n\tif _, known := config.ProfileByID(profile); !known {\n\t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"unknown profile %q\", profile))\n\t\treturn\n\t}\n\tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", profile); err != nil {\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, settingsResponse{Profile: profile})\n}\n\n// --- GET/PUT /projects/{project}/settings (TASK-2) ---------------------------\n//\n// The per-project settings this API exposes are the brief's baseBranch and\n// prefix (jobBranchPrefix). Their storage and writer are exactly the TUI\n// settings screen's: .manigot/manigot.json in the target project, read via\n// project.Load and written via project.Save — the sanctioned host-side writer\n// for the one directory outside docs/ manigot tooling owns.\n\n// projectSettingsResponse is the project settings response shape. BaseBranch\n// is the effective value (project.Settings.BaseBranchValue — \"main\" when\n// unset), so a client always gets a usable ref; JobBranchPrefix is the stored\n// value, empty meaning no prefix (it has no non-empty default).\ntype projectSettingsResponse struct {\n\tBaseBranch      string `json:\"baseBranch\"`\n\tJobBranchPrefix string `json:\"jobBranchPrefix\"`\n}\n\n// projectSettingsResponseFrom builds the response from stored settings.\nfunc projectSettingsResponseFrom(s project.Settings) projectSettingsResponse {\n\treturn projectSettingsResponse{\n\t\tBaseBranch:      s.BaseBranchValue(),\n\t\tJobBranchPrefix: s.JobBranchPrefix,\n\t}\n}\n\n// projectSettingsRequest is the PUT request body — a wholesale replacement\n// (the PUT files/brief precedent: the whole settings object, not a patch), so\n// an absent field clears that setting to its default. Both fields are\n// optional; empty means \"unset\" (baseBranch → main fallback, prefix → none).\ntype projectSettingsRequest struct {\n\tBaseBranch      string `json:\"baseBranch\"`\n\tJobBranchPrefix string `json:\"jobBranchPrefix\"`\n}\n\n// handleGetProjectSettings serves a project's baseBranch + jobBranchPrefix.\n// No lock: a pure read, like every other read endpoint.\nfunc (s *Server) handleGetProjectSettings(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tsettings, err := project.Load(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read project settings\")\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, projectSettingsResponseFrom(settings))\n}\n\n// handlePutProjectSettings replaces a project's baseBranch + jobBranchPrefix\n// (project.Save — the same writer the TUI settings screen uses) under the\n// project lock: the write itself is a plain file write, but create/done read\n// these very settings inside their own locked sections (job.CreateJob's base\n// branch, FinishJob's merge target), so serializing keeps a settings change\n// from interleaving with a job lifecycle decision mid-flight.\n//\n// Validation is deliberately this layer's: the TUI form free-accepts these\n// fields, but an HTTP caller cannot be shown a form — garbage would surface\n// later as opaque git failures (mg job's \"base branch '...' does not exist\",\n// or worse, a git argv a ref-shaped string was never meant for). A non-empty\n// value must therefore be a sane ref component (refComponentProblem); an empty\n// value clears the setting to its default.\nfunc (s *Server) handlePutProjectSettings(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\tvar req projectSettingsRequest\n\tif !decodeJSONBody(w, r, &req) {\n\t\treturn\n\t}\n\tbaseBranch := strings.TrimSpace(req.BaseBranch)\n\tjobBranchPrefix := strings.TrimSpace(req.JobBranchPrefix)\n\tfor _, field := range []struct{ name, value string }{\n\t\t{\"baseBranch\", baseBranch},\n\t\t{\"jobBranchPrefix\", jobBranchPrefix},\n\t} {\n\t\tif reason, ok := refComponentProblem(field.value); !ok {\n\t\t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"invalid %s %q: %s\", field.name, field.value, reason))\n\t\t\treturn\n\t\t}\n\t}\n\n\ts.locks.Lock(root)\n\tdefer s.locks.Unlock(root)\n\n\tsettings := project.Settings{\n\t\tBaseBranch:      baseBranch,\n\t\tJobBranchPrefix: jobBranchPrefix,\n\t}\n\tif err := project.Save(root, settings); err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot write project settings\")\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, projectSettingsResponseFrom(settings))\n}\n\n// refComponentMaxLen bounds a single settings value — far above any real\n// ref name (git's own documented ceiling is 255 bytes for a full ref; these\n// are components) while refusing an unbounded write.\nconst refComponentMaxLen = 200\n\n// refComponentProblem checks value as a git ref *component chain* — the shape\n// baseBranch and jobBranchPrefix actually hold: namespaced branch names like\n// \"release/1.2\" or prefix chains like \"team/feature\", where '/' separates\n// legal components. It enforces git's own ref rules where they matter for\n// correctness and safety (a value that reaches internal/git as an argv\n// element must never be an option — hence the leading '-' rejection — nor\n// contain shell-irrelevant but git-forbidden characters that make every later\n// operation fail), without shelling out: no repo is needed (a non-git project\n// may still store settings for later), and the check stays deterministic and\n// testable. ok=false with a human-readable reason means reject.\n//\n// Empty is valid (it means \"clear the setting\") — callers decide whether an\n// empty value is allowed; this check is about shape.\nfunc refComponentProblem(value string) (reason string, ok bool) {\n\tif value == \"\" {\n\t\treturn \"\", true\n\t}\n\tif len(value) > refComponentMaxLen {\n\t\treturn \"longer than the 200-character limit\", false\n\t}\n\tif strings.HasPrefix(value, \"-\") {\n\t\treturn \"must not start with '-' (git would parse it as an option)\", false\n\t}\n\tif strings.HasPrefix(value, \"/\") || strings.HasSuffix(value, \"/\") {\n\t\treturn \"must not start or end with '/'\", false\n\t}\n\tif strings.HasPrefix(value, \".\") || strings.HasSuffix(value, \".\") {\n\t\treturn \"must not start or end with '.'\", false\n\t}\n\tif strings.HasSuffix(value, \".lock\") {\n\t\treturn \"must not end with '.lock' (reserved by git)\", false\n\t}\n\tif strings.Contains(value, \"..\") {\n\t\treturn \"must not contain '..'\", false\n\t}\n\tif strings.Contains(value, \"@{\") || value == \"@\" {\n\t\treturn \"must not contain '@{' or be a lone '@'\", false\n\t}\n\tfor _, bad := range \"~^:?*[\\\\\" {\n\t\tif strings.ContainsRune(value, bad) {\n\t\t\treturn fmt.Sprintf(\"must not contain %q\", bad), false\n\t\t}\n\t}\n\tfor i := 0; i < len(value); i++ {\n\t\tif c := value[i]; c <= 0x20 || c == 0x7f {\n\t\t\treturn \"must not contain control characters or spaces\", false\n\t\t}\n\t}\n\treturn \"\", true\n}","lineStart":1,"lineEnd":233,"totalLines":233,"truncated":false}},"title":"src/internal/serve/settings.go","time":{"start":1787994672272,"end":1787994672284}},"id":"prt_04cc98c51001n3fFC5d8cWbdql","sessionID":"ses_fb3368eedffetvzxol071th185","messageID":"msg_04cc98870001QNYwqQTR13svDH"}}
{"type":"tool_use","timestamp":1787994672419,"sessionID":"ses_fb3368eedffetvzxol071th185","part":{"type":"tool","tool":"read","callID":"call_78b64587e4f94a50a6b467f5","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/settings_test.go"},"output":"<path>/workspace/src/internal/serve/settings_test.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"encoding/json\"\n5: \t\"net/http\"\n6: \t\"os\"\n7: \t\"path/filepath\"\n8: \t\"strings\"\n9: \t\"testing\"\n10: \n11: \t\"github.com/lmuskalla/manigot/internal/config\"\n12: \t\"github.com/lmuskalla/manigot/internal/project\"\n13: )\n14: \n15: // --- TASK-1: GET/PUT /settings ------------------------------------------------\n16: \n17: // TestGetSettingsDefaultsToClaudePro: with no MANIGOT_PROFILE configured,\n18: // GET /settings reports the claude-pro fallback — the same \"Active default\"\n19: // chain `mg profiles` displays.\n20: func TestGetSettingsDefaultsToClaudePro(t *testing.T) {\n21: \tfakeCheckout(t, nil) // a checkout with no .env\n22: \tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n23: \n24: \trec := get(t, srv, \"/settings\", \"\")\n25: \tif rec.Code != http.StatusOK {\n26: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n27: \t}\n28: \tvar body settingsResponse\n29: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n30: \t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n31: \t}\n32: \tif body.Profile != config.ProfileClaudePro {\n33: \t\tt.Errorf(\"profile = %q, want %q\", body.Profile, config.ProfileClaudePro)\n34: \t}\n35: }\n36: \n37: // TestGetSettingsReadsConfiguredDefault: a MANIGOT_PROFILE in the checkout's\n38: // .env is reported as the effective default.\n39: func TestGetSettingsReadsConfiguredDefault(t *testing.T) {\n40: \tcheckout := fakeCheckout(t, nil)\n41: \tif err := os.WriteFile(filepath.Join(checkout, \".env\"), []byte(\"MANIGOT_PROFILE=zai\\n\"), 0o644); err != nil {\n42: \t\tt.Fatal(err)\n43: \t}\n44: \tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n45: \n46: \trec := get(t, srv, \"/settings\", \"\")\n47: \tif rec.Code != http.StatusOK {\n48: \t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n49: \t}\n50: \tvar body settingsResponse\n51: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n52: \t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n53: \t}\n54: \tif body.Profile != config.ProfileZAI {\n55: \t\tt.Errorf(\"profile = %q, want zai\", body.Profile)\n56: \t}\n57: }\n58: \n59: // TestPutSettingsProfileWritesSharedDefault: PUT /settings persists the\n60: // default profile exactly the way `mg profiles <name>` does — MANIGOT_PROFILE\n61: // in manigot's .env, preserving every other line already in the file.\n62: func TestPutSettingsProfileWritesSharedDefault(t *testing.T) {\n63: \tcheckout := fakeCheckout(t, nil)\n64: \tif err := os.WriteFile(filepath.Join(checkout, \".env\"), []byte(\n65: \t\t\"# manigot configuration — credentials and defaults (never commit this file)\\nZHIPU_API_KEY=keep-me\\n\"), 0o644); err != nil {\n66: \t\tt.Fatal(err)\n67: \t}\n68: \tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n69: \n70: \trec := put(t, srv, \"/settings\", \"\", `{\"profile\":\"opencode-zen\"}`)\n71: \tif rec.Code != http.StatusOK {\n72: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n73: \t}\n74: \tvar body settingsResponse\n75: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n76: \t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n77: \t}\n78: \tif body.Profile != \"opencode-zen\" {\n79: \t\tt.Errorf(\"response profile = %q, want opencode-zen\", body.Profile)\n80: \t}\n81: \n82: \t// The write is the shared one: config.EnvValue (the reader every launch\n83: \t// path uses) sees it, and the pre-existing credential line survived.\n84: \tif got := config.EnvValue(\"MANIGOT_PROFILE\"); got != \"opencode-zen\" {\n85: \t\tt.Errorf(\"MANIGOT_PROFILE = %q, want opencode-zen\", got)\n86: \t}\n87: \tdata, err := os.ReadFile(filepath.Join(checkout, \".env\"))\n88: \tif err != nil {\n89: \t\tt.Fatal(err)\n90: \t}\n91: \tif !strings.Contains(string(data), \"ZHIPU_API_KEY=keep-me\") {\n92: \t\tt.Errorf(\".env lost its other lines:\\n%s\", string(data))\n93: \t}\n94: \n95: \t// And GET now reports the new default.\n96: \trec = get(t, srv, \"/settings\", \"\")\n97: \tvar after settingsResponse\n98: \tif err := json.Unmarshal(rec.Body.Bytes(), &after); err != nil {\n99: \t\tt.Fatal(err)\n100: \t}\n101: \tif after.Profile != \"opencode-zen\" {\n102: \t\tt.Errorf(\"GET after PUT = %q, want opencode-zen\", after.Profile)\n103: \t}\n104: }\n105: \n106: // TestPutSettingsValidation: an empty body/field is a 400 (never a silent\n107: // reset), and an unknown profile id is a 400 — the same wording the\n108: // launch endpoints' resolveProfile uses.\n109: func TestPutSettingsValidation(t *testing.T) {\n110: \tfakeCheckout(t, nil)\n111: \tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n112: \n113: \tif rec := put(t, srv, \"/settings\", \"\", \"\"); rec.Code != http.StatusBadRequest {\n114: \t\tt.Errorf(\"empty body: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n115: \t}\n116: \tif rec := put(t, srv, \"/settings\", \"\", `{\"profile\":\"  \"}`); rec.Code != http.StatusBadRequest {\n117: \t\tt.Errorf(\"blank profile: status = %d, want 400\", rec.Code)\n118: \t}\n119: \trec := put(t, srv, \"/settings\", \"\", `{\"profile\":\"bogus-profile\"}`)\n120: \tif rec.Code != http.StatusBadRequest {\n121: \t\tt.Fatalf(\"unknown profile: status = %d, want 400\", rec.Code)\n122: \t}\n123: \tif !strings.Contains(rec.Body.String(), \"unknown profile\") {\n124: \t\tt.Errorf(\"400 body missing the unknown-profile wording: %s\", rec.Body.String())\n125: \t}\n126: }\n127: \n128: // --- TASK-2: GET/PUT /projects/{project}/settings ------------------------------\n129: \n130: // TestGetProjectSettingsDefaults: a project without .manigot/manigot.json\n131: // reports the effective defaults — baseBranch \"main\", no prefix.\n132: func TestGetProjectSettingsDefaults(t *testing.T) {\n133: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n134: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n135: \n136: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/settings\", \"\")\n137: \tif rec.Code != http.StatusOK {\n138: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n139: \t}\n140: \tvar body projectSettingsResponse\n141: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n142: \t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n143: \t}\n144: \tif body.BaseBranch != \"main\" || body.JobBranchPrefix != \"\" {\n145: \t\tt.Errorf(\"defaults = %+v, want baseBranch=main prefix empty\", body)\n146: \t}\n147: \n148: \tif rec := get(t, srv, \"/projects/no-such-project/settings\", \"\"); rec.Code != http.StatusNotFound {\n149: \t\tt.Errorf(\"unknown project: status = %d, want 404\", rec.Code)\n150: \t}\n151: }\n152: \n153: // TestPutProjectSettingsRoundtrip: PUT persists via project.Save and both the\n154: // API's GET and project.Load (the reader mg job/done use) see the new values.\n155: func TestPutProjectSettingsRoundtrip(t *testing.T) {\n156: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n157: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n158: \n159: \trec := put(t, srv, \"/projects/\"+filepath.Base(root)+\"/settings\", \"\",\n160: \t\t`{\"baseBranch\":\"develop\",\"jobBranchPrefix\":\"jobs\"}`)\n161: \tif rec.Code != http.StatusOK {\n162: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n163: \t}\n164: \tvar body projectSettingsResponse\n165: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n166: \t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n167: \t}\n168: \tif body.BaseBranch != \"develop\" || body.JobBranchPrefix != \"jobs\" {\n169: \t\tt.Errorf(\"response = %+v, want develop/jobs\", body)\n170: \t}\n171: \n172: \tstored, err := project.Load(root)\n173: \tif err != nil {\n174: \t\tt.Fatal(err)\n175: \t}\n176: \tif stored.BaseBranch != \"develop\" || stored.JobBranchPrefix != \"jobs\" {\n177: \t\tt.Errorf(\"project.Load = %+v, want develop/jobs — the write must be the TUI's own store\", stored)\n178: \t}\n179: \n180: \t// A wholesale PUT with an absent field clears that setting (the PUT\n181: \t// files/brief precedent: replace, not patch) — baseBranch falls back to\n182: \t// the effective \"main\", the prefix to none.\n183: \trec = put(t, srv, \"/projects/\"+filepath.Base(root)+\"/settings\", \"\", `{\"baseBranch\":\"main\"}`)\n184: \tif rec.Code != http.StatusOK {\n185: \t\tt.Fatalf(\"clear prefix: status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n186: \t}\n187: \tstored, err = project.Load(root)\n188: \tif err != nil {\n189: \t\tt.Fatal(err)\n190: \t}\n191: \tif stored.BaseBranch != \"main\" || stored.JobBranchPrefix != \"\" {\n192: \t\tt.Errorf(\"after clear = %+v, want main/empty\", stored)\n193: \t}\n194: }\n195: \n196: // TestPutProjectSettingsDrivesJobCreation: the settings this endpoint writes\n197: // are the ones the lifecycle reads — after setting a jobBranchPrefix, a job\n198: // created through the API branches under the prefix's namespace.\n199: func TestPutProjectSettingsDrivesJobCreation(t *testing.T) {\n200: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n201: \troot := initGitRepo(t)\n202: \tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n203: \t\tt.Fatal(err)\n204: \t}\n205: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n206: \tbase := filepath.Base(root)\n207: \n208: \tif rec := put(t, srv, \"/projects/\"+base+\"/settings\", \"\", `{\"jobBranchPrefix\":\"mg\"}`); rec.Code != http.StatusOK {\n209: \t\tt.Fatalf(\"settings PUT: status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n210: \t}\n211: \n212: \trec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Prefixed Job\"}`)\n213: \tif rec.Code != http.StatusCreated {\n214: \t\tt.Fatalf(\"create: status = %d, want 201 (body %s)\", rec.Code, rec.Body.String())\n215: \t}\n216: \tvar created createJobResponse\n217: \tif err := json.Unmarshal(rec.Body.Bytes(), &created); err != nil {\n218: \t\tt.Fatal(err)\n219: \t}\n220: \tif !strings.HasPrefix(created.Branch, \"mg/\") {\n221: \t\tt.Errorf(\"created branch = %q, want the mg/ prefix to apply\", created.Branch)\n222: \t}\n223: }\n224: \n225: // TestPutProjectSettingsValidation: garbage ref values are 400s at write time,\n226: // never stored values that later surface as opaque git failures.\n227: func TestPutProjectSettingsValidation(t *testing.T) {\n228: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n229: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n230: \tbase := filepath.Base(root)\n231: \n232: \tbad := []string{\n233: \t\t\"fea ture\",             // space\n234: \t\t\"release/1.2/../evil\",  // '..'\n235: \t\t\".hidden\",              // leading dot\n236: \t\t\"trailing.\",            // trailing dot\n237: \t\t\"/leading\",             // leading slash\n238: \t\t\"trailing/\",            // trailing slash\n239: \t\t\"branch.lock\",          // .lock suffix\n240: \t\t\"-injected-flag\",       // would parse as a git option\n241: \t\t\"care~t\",               // ~\n242: \t\t\"caret^head\",           // ^\n243: \t\t\"colon:ref\",            // :\n244: \t\t\"star*\",                // *\n245: \t\t\"brack[et\",             // [\n246: \t\t\"back\\\\slash\",          // backslash (also a Windows separator)\n247: \t\t\"at@{brace\",            // @{\n248: \t\t\"@\",                    // lone @\n249: \t\t\"question?mark\",        // ?\n250: \t\t\"nul\\x00byte\",          // control characters\n251: \t\tstrings.Repeat(\"x\", refComponentMaxLen+1), // over the length cap\n252: \t}\n253: \tfor _, value := range bad {\n254: \t\trec := put(t, srv, \"/projects/\"+base+\"/settings\", \"\",\n255: \t\t\t`{\"baseBranch\":`+jsonString(value)+`}`)\n256: \t\tif rec.Code != http.StatusBadRequest {\n257: \t\t\tt.Errorf(\"baseBranch %q: status = %d, want 400 (body %s)\", value, rec.Code, rec.Body.String())\n258: \t\t}\n259: \t\trec = put(t, srv, \"/projects/\"+base+\"/settings\", \"\",\n260: \t\t\t`{\"jobBranchPrefix\":`+jsonString(value)+`}`)\n261: \t\tif rec.Code != http.StatusBadRequest {\n262: \t\t\tt.Errorf(\"jobBranchPrefix %q: status = %d, want 400 (body %s)\", value, rec.Code, rec.Body.String())\n263: \t\t}\n264: \t}\n265: \n266: \t// Nothing was stored by the rejected requests.\n267: \tif _, err := os.Stat(filepath.Join(root, \".manigot\", \"manigot.json\")); !os.IsNotExist(err) {\n268: \t\tt.Errorf(\"a rejected PUT still wrote the settings file\")\n269: \t}\n270: \n271: \t// The legitimate namespaced shapes pass: release branches, prefix chains.\n272: \tfor _, value := range []string{\"main\", \"develop\", \"release/1.2\", \"origin/main\", \"jobs\", \"team/feature\"} {\n273: \t\tif reason, ok := refComponentProblem(value); !ok {\n274: \t\t\tt.Errorf(\"refComponentProblem(%q) rejected: %s\", value, reason)\n275: \t\t}\n276: \t}\n277: }\n278: \n279: // jsonString marshals s as a JSON string literal — the bad-value table above\n280: // contains characters that must reach the decoder escaped, so hand-building\n281: // the body with fmt would be wrong.\n282: func jsonString(s string) string {\n283: \tb, _ := json.Marshal(s)\n284: \treturn string(b)\n285: }\n286: \n287: // TestRefComponentProblemEmptyIsValid: empty is a valid shape (it means\n288: // \"clear the setting\"); whether empty is allowed is the caller's decision.\n289: func TestRefComponentProblemEmptyIsValid(t *testing.T) {\n290: \tif reason, ok := refComponentProblem(\"\"); !ok {\n291: \t\tt.Errorf(\"refComponentProblem(\\\"\\\") rejected: %s\", reason)\n292: \t}\n293: }\n\n(End of file - total 293 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// --- TASK-1: GET/PUT /settings ------------------------------------------------\n\n// TestGetSettingsDefaultsToClaudePro: with no MANIGOT_PROFILE configured,\n// GET /settings reports the claude-pro fallback — the same \"Active default\"\n// chain `mg profiles` displays.\nfunc TestGetSettingsDefaultsToClaudePro(t *testing.T) {","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/settings_test.go","text":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// --- TASK-1: GET/PUT /settings ------------------------------------------------\n\n// TestGetSettingsDefaultsToClaudePro: with no MANIGOT_PROFILE configured,\n// GET /settings reports the claude-pro fallback — the same \"Active default\"\n// chain `mg profiles` displays.\nfunc TestGetSettingsDefaultsToClaudePro(t *testing.T) {\n\tfakeCheckout(t, nil) // a checkout with no .env\n\tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n\n\trec := get(t, srv, \"/settings\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body settingsResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif body.Profile != config.ProfileClaudePro {\n\t\tt.Errorf(\"profile = %q, want %q\", body.Profile, config.ProfileClaudePro)\n\t}\n}\n\n// TestGetSettingsReadsConfiguredDefault: a MANIGOT_PROFILE in the checkout's\n// .env is reported as the effective default.\nfunc TestGetSettingsReadsConfiguredDefault(t *testing.T) {\n\tcheckout := fakeCheckout(t, nil)\n\tif err := os.WriteFile(filepath.Join(checkout, \".env\"), []byte(\"MANIGOT_PROFILE=zai\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n\n\trec := get(t, srv, \"/settings\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n\t}\n\tvar body settingsResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif body.Profile != config.ProfileZAI {\n\t\tt.Errorf(\"profile = %q, want zai\", body.Profile)\n\t}\n}\n\n// TestPutSettingsProfileWritesSharedDefault: PUT /settings persists the\n// default profile exactly the way `mg profiles <name>` does — MANIGOT_PROFILE\n// in manigot's .env, preserving every other line already in the file.\nfunc TestPutSettingsProfileWritesSharedDefault(t *testing.T) {\n\tcheckout := fakeCheckout(t, nil)\n\tif err := os.WriteFile(filepath.Join(checkout, \".env\"), []byte(\n\t\t\"# manigot configuration — credentials and defaults (never commit this file)\\nZHIPU_API_KEY=keep-me\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n\n\trec := put(t, srv, \"/settings\", \"\", `{\"profile\":\"opencode-zen\"}`)\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body settingsResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif body.Profile != \"opencode-zen\" {\n\t\tt.Errorf(\"response profile = %q, want opencode-zen\", body.Profile)\n\t}\n\n\t// The write is the shared one: config.EnvValue (the reader every launch\n\t// path uses) sees it, and the pre-existing credential line survived.\n\tif got := config.EnvValue(\"MANIGOT_PROFILE\"); got != \"opencode-zen\" {\n\t\tt.Errorf(\"MANIGOT_PROFILE = %q, want opencode-zen\", got)\n\t}\n\tdata, err := os.ReadFile(filepath.Join(checkout, \".env\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !strings.Contains(string(data), \"ZHIPU_API_KEY=keep-me\") {\n\t\tt.Errorf(\".env lost its other lines:\\n%s\", string(data))\n\t}\n\n\t// And GET now reports the new default.\n\trec = get(t, srv, \"/settings\", \"\")\n\tvar after settingsResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &after); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif after.Profile != \"opencode-zen\" {\n\t\tt.Errorf(\"GET after PUT = %q, want opencode-zen\", after.Profile)\n\t}\n}\n\n// TestPutSettingsValidation: an empty body/field is a 400 (never a silent\n// reset), and an unknown profile id is a 400 — the same wording the\n// launch endpoints' resolveProfile uses.\nfunc TestPutSettingsValidation(t *testing.T) {\n\tfakeCheckout(t, nil)\n\tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n\n\tif rec := put(t, srv, \"/settings\", \"\", \"\"); rec.Code != http.StatusBadRequest {\n\t\tt.Errorf(\"empty body: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif rec := put(t, srv, \"/settings\", \"\", `{\"profile\":\"  \"}`); rec.Code != http.StatusBadRequest {\n\t\tt.Errorf(\"blank profile: status = %d, want 400\", rec.Code)\n\t}\n\trec := put(t, srv, \"/settings\", \"\", `{\"profile\":\"bogus-profile\"}`)\n\tif rec.Code != http.StatusBadRequest {\n\t\tt.Fatalf(\"unknown profile: status = %d, want 400\", rec.Code)\n\t}\n\tif !strings.Contains(rec.Body.String(), \"unknown profile\") {\n\t\tt.Errorf(\"400 body missing the unknown-profile wording: %s\", rec.Body.String())\n\t}\n}\n\n// --- TASK-2: GET/PUT /projects/{project}/settings ------------------------------\n\n// TestGetProjectSettingsDefaults: a project without .manigot/manigot.json\n// reports the effective defaults — baseBranch \"main\", no prefix.\nfunc TestGetProjectSettingsDefaults(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/settings\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body projectSettingsResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif body.BaseBranch != \"main\" || body.JobBranchPrefix != \"\" {\n\t\tt.Errorf(\"defaults = %+v, want baseBranch=main prefix empty\", body)\n\t}\n\n\tif rec := get(t, srv, \"/projects/no-such-project/settings\", \"\"); rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"unknown project: status = %d, want 404\", rec.Code)\n\t}\n}\n\n// TestPutProjectSettingsRoundtrip: PUT persists via project.Save and both the\n// API's GET and project.Load (the reader mg job/done use) see the new values.\nfunc TestPutProjectSettingsRoundtrip(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\n\trec := put(t, srv, \"/projects/\"+filepath.Base(root)+\"/settings\", \"\",\n\t\t`{\"baseBranch\":\"develop\",\"jobBranchPrefix\":\"jobs\"}`)\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body projectSettingsResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif body.BaseBranch != \"develop\" || body.JobBranchPrefix != \"jobs\" {\n\t\tt.Errorf(\"response = %+v, want develop/jobs\", body)\n\t}\n\n\tstored, err := project.Load(root)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif stored.BaseBranch != \"develop\" || stored.JobBranchPrefix != \"jobs\" {\n\t\tt.Errorf(\"project.Load = %+v, want develop/jobs — the write must be the TUI's own store\", stored)\n\t}\n\n\t// A wholesale PUT with an absent field clears that setting (the PUT\n\t// files/brief precedent: replace, not patch) — baseBranch falls back to\n\t// the effective \"main\", the prefix to none.\n\trec = put(t, srv, \"/projects/\"+filepath.Base(root)+\"/settings\", \"\", `{\"baseBranch\":\"main\"}`)\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"clear prefix: status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tstored, err = project.Load(root)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif stored.BaseBranch != \"main\" || stored.JobBranchPrefix != \"\" {\n\t\tt.Errorf(\"after clear = %+v, want main/empty\", stored)\n\t}\n}\n\n// TestPutProjectSettingsDrivesJobCreation: the settings this endpoint writes\n// are the ones the lifecycle reads — after setting a jobBranchPrefix, a job\n// created through the API branches under the prefix's namespace.\nfunc TestPutProjectSettingsDrivesJobCreation(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\troot := initGitRepo(t)\n\tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tif rec := put(t, srv, \"/projects/\"+base+\"/settings\", \"\", `{\"jobBranchPrefix\":\"mg\"}`); rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"settings PUT: status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\n\trec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Prefixed Job\"}`)\n\tif rec.Code != http.StatusCreated {\n\t\tt.Fatalf(\"create: status = %d, want 201 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar created createJobResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &created); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !strings.HasPrefix(created.Branch, \"mg/\") {\n\t\tt.Errorf(\"created branch = %q, want the mg/ prefix to apply\", created.Branch)\n\t}\n}\n\n// TestPutProjectSettingsValidation: garbage ref values are 400s at write time,\n// never stored values that later surface as opaque git failures.\nfunc TestPutProjectSettingsValidation(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tbad := []string{\n\t\t\"fea ture\",             // space\n\t\t\"release/1.2/../evil\",  // '..'\n\t\t\".hidden\",              // leading dot\n\t\t\"trailing.\",            // trailing dot\n\t\t\"/leading\",             // leading slash\n\t\t\"trailing/\",            // trailing slash\n\t\t\"branch.lock\",          // .lock suffix\n\t\t\"-injected-flag\",       // would parse as a git option\n\t\t\"care~t\",               // ~\n\t\t\"caret^head\",           // ^\n\t\t\"colon:ref\",            // :\n\t\t\"star*\",                // *\n\t\t\"brack[et\",             // [\n\t\t\"back\\\\slash\",          // backslash (also a Windows separator)\n\t\t\"at@{brace\",            // @{\n\t\t\"@\",                    // lone @\n\t\t\"question?mark\",        // ?\n\t\t\"nul\\x00byte\",          // control characters\n\t\tstrings.Repeat(\"x\", refComponentMaxLen+1), // over the length cap\n\t}\n\tfor _, value := range bad {\n\t\trec := put(t, srv, \"/projects/\"+base+\"/settings\", \"\",\n\t\t\t`{\"baseBranch\":`+jsonString(value)+`}`)\n\t\tif rec.Code != http.StatusBadRequest {\n\t\t\tt.Errorf(\"baseBranch %q: status = %d, want 400 (body %s)\", value, rec.Code, rec.Body.String())\n\t\t}\n\t\trec = put(t, srv, \"/projects/\"+base+\"/settings\", \"\",\n\t\t\t`{\"jobBranchPrefix\":`+jsonString(value)+`}`)\n\t\tif rec.Code != http.StatusBadRequest {\n\t\t\tt.Errorf(\"jobBranchPrefix %q: status = %d, want 400 (body %s)\", value, rec.Code, rec.Body.String())\n\t\t}\n\t}\n\n\t// Nothing was stored by the rejected requests.\n\tif _, err := os.Stat(filepath.Join(root, \".manigot\", \"manigot.json\")); !os.IsNotExist(err) {\n\t\tt.Errorf(\"a rejected PUT still wrote the settings file\")\n\t}\n\n\t// The legitimate namespaced shapes pass: release branches, prefix chains.\n\tfor _, value := range []string{\"main\", \"develop\", \"release/1.2\", \"origin/main\", \"jobs\", \"team/feature\"} {\n\t\tif reason, ok := refComponentProblem(value); !ok {\n\t\t\tt.Errorf(\"refComponentProblem(%q) rejected: %s\", value, reason)\n\t\t}\n\t}\n}\n\n// jsonString marshals s as a JSON string literal — the bad-value table above\n// contains characters that must reach the decoder escaped, so hand-building\n// the body with fmt would be wrong.\nfunc jsonString(s string) string {\n\tb, _ := json.Marshal(s)\n\treturn string(b)\n}\n\n// TestRefComponentProblemEmptyIsValid: empty is a valid shape (it means\n// \"clear the setting\"); whether empty is allowed is the caller's decision.\nfunc TestRefComponentProblemEmptyIsValid(t *testing.T) {\n\tif reason, ok := refComponentProblem(\"\"); !ok {\n\t\tt.Errorf(\"refComponentProblem(\\\"\\\") rejected: %s\", reason)\n\t}\n}","lineStart":1,"lineEnd":293,"totalLines":293,"truncated":false}},"title":"src/internal/serve/settings_test.go","time":{"start":1787994672397,"end":1787994672417}},"id":"prt_04cc98caf001B3kn8ept83o5Ru","sessionID":"ses_fb3368eedffetvzxol071th185","messageID":"msg_04cc98870001QNYwqQTR13svDH"}}
