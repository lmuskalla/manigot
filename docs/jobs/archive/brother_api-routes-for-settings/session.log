4 deletions(-)\\n===FILES AT HEAD===\\nsrc/internal/serve/credentials_test.go\\nsrc/internal/serve/security_test.go\\nsrc/internal/serve/server.go\\nsrc/internal/serve/settings.go\\nsrc/internal/serve/settings_test.go\\n\",\"metadata\":{\"output\":\"commit 19b0716bdac46630f2885719813ffb53382c0b50\\nAuthor: Leander Muskalla <muskalla@sozialit.de>\\nDate:   Sat Aug 29 09:13:21 2026 +0000\\n\\n    [brother] implementation: add summary\\n\\n .../implementation.md                              | 79 ++++++++++++++++++++--\\n 1 file changed, 75 insertions(+), 4 deletions(-)\\n===FILES AT HEAD===\\nsrc/internal/serve/credentials_test.go\\nsrc/internal/serve/security_test.go\\nsrc/internal/serve/server.go\\nsrc/internal/serve/settings.go\\nsrc/internal/serve/settings_test.go\\n\",\"exit\":0,\"truncated\":false},\"title\":\"cd /workspace && git show 19b0716 --stat | head -30 && echo \\\"===FILES AT HEAD===\\\" && git ls-files src/internal/serve/ | grep -E \\\"settings|server|credential|security\\\"\",\"time\":{\"start\":1787994949646,\"end\":1787994949651}},\"id\":\"prt_04ccdc616001SeSqEsmXzpr816\",\"sessionID\":\"ses_fb3337e5bffeqUmulSYU99zDKc\",\"messageID\":\"msg_04cccf8eb001o89FWad366uow1\"}}\n+{\"type\":\"tool_use\",\"timestamp\":1787994950024,\"sessionID\":\"ses_fb3337e5bffeqUmulSYU99zDKc\",\"part\":{\"type\":\"tool\",\"tool\":\"bash\",\"callID\":\"call_9a4372b95a8e4901a914b89b\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"cd /workspace && git log --oneline --follow -- src/internal/serve/settings.go | head; echo \\\"---\\\"; git show 839ab65 --stat | head -20\"},\"output\":\"164a3639 [brother] chore: commit all\\n---\\ncommit 839ab65f8633c27531e47b6afa868ac35f8b054c\\nAuthor: Leander Muskalla <muskalla@sozialit.de>\\nDate:   Sat Aug 29 11:14:24 2026 +0200\\n\\n    [brother] chore: commit all\\n\\n .../brother_api-routes-for-settings/session.log    | 111 +++++++++++++++++++++\\n 1 file changed, 111 insertions(+)\\n\",\"metadata\":{\"output\":\"164a3639 [brother] chore: commit all\\n---\\ncommit 839ab65f8633c27531e47b6afa868ac35f8b054c\\nAuthor: Leander Muskalla <muskalla@sozialit.de>\\nDate:   Sat Aug 29 11:14:24 2026 +0200\\n\\n    [brother] chore: commit all\\n\\n .../brother_api-routes-for-settings/session.log    | 111 +++++++++++++++++++++\\n 1 file changed, 111 insertions(+)\\n\",\"exit\":0,\"truncated\":false},\"title\":\"cd /workspace && git log --oneline --follow -- src/internal/serve/settings.go | head; echo \\\"---\\\"; git show 839ab65 --stat | head -20\",\"time\":{\"start\":1787994949998,\"end\":1787994950006}},\"id\":\"prt_04ccdc80a0010y2nqOICU7RN3d\",\"sessionID\":\"ses_fb3337e5bffeqUmulSYU99zDKc\",\"messageID\":\"msg_04cccf8eb001o89FWad366uow1\"}}\n+{\"type\":\"step_finish\",\"timestamp\":1787994950082,\"sessionID\":\"ses_fb3337e5bffeqUmulSYU99zDKc\",\"part\":{\"id\":\"prt_04ccdc9ab0010oQmqRPU7LONgz\",\"reason\":\"tool-calls\",\"snapshot\":\"\",\"messageID\":\"msg_04cccf8eb001o89FWad366uow1\",\"sessionID\":\"ses_fb3337e5bffeqUmulSYU99zDKc\",\"type\":\"step-finish\",\"tokens\":{\"total\":48610,\"input\":3071,\"output\":483,\"reasoning\":0,\"cache\":{\"write\":0,\"read\":45056}},\"cost\":0.001826748}}\n","exit":0,"truncated":true,"outputPath":"/home/claude/.local/share/opencode/tool-output/tool_04ccea0e6001tCtgl50j2ppLZi"},"title":"cd /workspace && git diff --stat; echo \"===\"; git diff | head -40","time":{"start":1787995005155,"end":1787995005159}},"id":"prt_04cce9f92001cmd4oLquWwGu2G","sessionID":"ses_fb3337e5bffeqUmulSYU99zDKc","messageID":"msg_04cce7251001WignH0M1rhuuax"}}
{"type":"tool_use","timestamp":1787995006054,"sessionID":"ses_fb3337e5bffeqUmulSYU99zDKc","part":{"type":"tool","tool":"bash","callID":"call_7d00c3fc8c564705997551bb","state":{"status":"completed","input":{"command":"cd /workspace && wc -l docs/jobs/brother_api-routes-for-settings/session.log && grep -n -i \"agent\\|developer\\|analyst\\|reviewer\\|invoke\\|prompt\" docs/jobs/brother_api-routes-for-settings/session.log | head -20"},"output":"...output truncated...\n\nFull output saved to: /home/claude/.local/share/opencode/tool-output/tool_04ccea454001UbMKfKKvYuXmFW\n\n19:{\"type\":\"tool_use\",\"timestamp\":1787993701357,\"sessionID\":\"ses_fb3458985ffeeMJ5OFBVh1MOcx\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID\":\"call_f288fa9189484d7aa3060d24\",\"state\":{\"status\":\"completed\",\"input\":{\"filePath\":\"/workspace/src/internal/serve/api.go\"},\"output\":\"<path>/workspace/src/internal/serve/api.go</path>\\n<type>file</type>\\n<content>\\n1: package serve\\n2: \\n3: import (\\n4: \\t\\\"encoding/json\\\"\\n5: \\t\\\"errors\\\"\\n6: \\t\\\"fmt\\\"\\n7: \\t\\\"io\\\"\\n8: \\t\\\"net/http\\\"\\n9: \\t\\\"os\\\"\\n10: \\t\\\"path/filepath\\\"\\n11: \\t\\\"strings\\\"\\n12: \\t\\\"time\\\"\\n13: \\n14: \\t\\\"github.com/lmuskalla/manigot/internal/agentlist\\\"\\n15: \\t\\\"github.com/lmuskalla/manigot/internal/config\\\"\\n16: \\t\\\"github.com/lmuskalla/manigot/internal/git\\\"\\n17: \\t\\\"github.com/lmuskalla/manigot/internal/job\\\"\\n18: \\t\\\"github.com/lmuskalla/manigot/internal/project\\\"\\n19: \\t\\\"github.com/lmuskalla/manigot/internal/session\\\"\\n20: )\\n21: \\n22: // --- JSON helpers ------------------------------------------------------------\\n23: \\n24: // writeJSON writes v as a JSON response with the given status.\\n25: func writeJSON(w http.ResponseWriter, status int, v any) {\\n26: \\tw.Header().Set(\\\"Content-Type\\\", \\\"application/json\\\")\\n27: \\tw.WriteHeader(status)\\n28: \\t_ = json.NewEncoder(w).Encode(v)\\n29: }\\n30: \\n31: // apiError is the JSON error envelope every non-2xx response carries.\\n32: type apiError struct {\\n33: \\tError string `json:\\\"error\\\"`\\n34: }\\n35: \\n36: // writeError writes a JSON error envelope with the given status.\\n37: func writeError(w http.ResponseWriter, status int, msg string) {\\n38: \\twriteJSON(w, status, apiError{Error: msg})\\n39: }\\n40: \\n41: // --- Resolution helpers — the zero-path-inputs choke point -------------------\\n42: //\\n43: // Every handler resolves its URL segments ONLY through these helpers. A\\n44: // segment is validated as a plain identifier (validSegment), then matched —\\n45: // never joined into a filesystem path. The registered roots (TASK-1), the\\n46: // discovered jobs, and the file whitelist are the only sources of paths the\\n47: // handlers ever open.\\n48: \\n49: // validSegment reports whether a URL segment is a plain, trustworthy\\n50: // identifier: non-empty, not \\\".\\\" or \\\"..\\\" (traversal), containing no path\\n51: // separator (forward or backslash — the backslash is a Windows separator and\\n52: // must never reach a filesystem path), and no NUL byte. Percent-encoded and\\n53: // double-encoded variants all decode to one of these forms before matching,\\n54: // so rejecting the decoded form rejects them all.\\n55: func validSegment(seg string) bool {\\n56: \\tif seg == \\\"\\\" || seg == \\\".\\\" || seg == \\\"..\\\" {\\n57: \\t\\treturn false\\n58: \\t}\\n59: \\tif strings.ContainsAny(seg, \\\"/\\\\\\\\\\\") {\\n60: \\t\\treturn false\\n61: \\t}\\n62: \\treturn !strings.ContainsRune(seg, 0)\\n63: }\\n64: \\n65: // resolveProject maps a URL project segment to a registered root. The segment\\n66: // is validated, then matched against the registry by configured entry name\\n67: // only (Registry.Project) — it is never joined into a filesystem path. An\\n68: // invalid segment or no match is a 404; the handler returns false and must\\n69: // return immediately.\\n70: func (s *Server) resolveProject(w http.ResponseWriter, segment string) (string, bool) {\\n71: \\tif !validSegment(segment) {\\n72: \\t\\twriteError(w, http.StatusNotFound, \\\"project not found\\\")\\n73: \\t\\treturn \\\"\\\", false\\n74: \\t}\\n75: \\troot, ok := s.reg.Project(segment)\\n76: \\tif !ok {\\n77: \\t\\twriteError(w, http.StatusNotFound, \\\"project not found\\\")\\n78: \\t\\treturn \\\"\\\", false\\n79: \\t}\\n80: \\treturn root, true\\n81: }\\n82: \\n83: // resolveJob maps a URL job segment to a discovered job under root. The\\n84: // segment is validated, then matched against the project's discovered jobs by\\n85: // ID, then by id_slug name (the job directory name — the same identity the\\n86: // CLI's branch-tail matching uses), then by unique name prefix. It is never\\n87: // treated as a path. Not-found is a 404; an ambiguous prefix is a 409; the\\n88: // handler returns false and must return immediately.\\n89: func (s *Server) resolveJob(w http.ResponseWriter, root, segment string) (job.Job, bool) {\\n90: \\tif !validSegment(segment) {\\n91: \\t\\twriteError(w, http.StatusNotFound, \\\"job not found\\\")\\n92: \\t\\treturn job.Job{}, false\\n93: \\t}\\n94: \\tjobs, err := job.Discover(root)\\n95: \\tif err != nil {\\n96: \\t\\twriteError(w, http.StatusInternalServerError, \\\"cannot read jobs\\\")\\n97: \\t\\treturn job.Job{}, false\\n98: \\t}\\n99: \\n100: \\t// Exact by ID, then by name.\\n101: \\tfor _, j := range jobs {\\n102: \\t\\tif j.ID == segment || j.Name == segment {\\n103: \\t\\t\\treturn j, true\\n104: \\t\\t}\\n105: \\t}\\n106: \\n107: \\t// Unique prefix on the name.\\n108: \\tvar matches []job.Job\\n109: \\tfor _, j := range jobs {\\n110: \\t\\tif strings.HasPrefix(j.Name, segment) {\\n111: \\t\\t\\tmatches = append(matches, j)\\n112: \\t\\t}\\n113: \\t}\\n114: \\tswitch len(matches) {\\n115: \\tcase 0:\\n116: \\t\\twriteError(w, http.StatusNotFound, fmt.Sprintf(\\\"job '%s' not found among the project's jobs\\\", segment))\\n117: \\t\\treturn job.Job{}, false\\n118: \\tcase 1:\\n119: \\t\\treturn matches[0], true\\n120: \\tdefault:\\n121: \\t\\tnames := make([]string, 0, len(matches))\\n122: \\t\\tfor _, j := range matches {\\n123: \\t\\t\\tnames = append(names, j.Name)\\n124: \\t\\t}\\n125: \\t\\twriteError(w, http.StatusConflict, fmt.Sprintf(\\\"job '%s' is ambiguous — matches jobs: %s\\\", segment, strings.Join(names, \\\" \\\")))\\n126: \\t\\treturn job.Job{}, false\\n127: \\t}\\n128: }\\n129: \\n130: // jobFileNames is the whitelist of job files the API serves: a job's four\\n131: // markdown files, read as raw markdown text. Nothing else under the job dir\\n132: // is ever served.\\n133: var jobFileNames = map[string]bool{\\n134: \\t\\\"brief.md\\\":          true,\\n135: \\t\\\"tasks.md\\\":          true,\\n136: \\t\\\"implementation.md\\\": true,\\n137: \\t\\\"verdict.md\\\":        true,\\n138: }\\n139: \\n140: // --- /health -----------------------------------------------------------------\\n141: \\n142: // healthProfileRow is one profile's credential readiness in the /health\\n143: // response: ready = the profile's ResolveProfile + CheckAuth succeed (the\\n144: // same check the session launcher runs). A missing key is \\\"not ready\\\", never\\n145: // an error; the credential values themselves are never reported.\\n146: type healthProfileRow struct {\\n147: \\tID    string `json:\\\"id\\\"`\\n148: \\tReady bool   `json:\\\"ready\\\"`\\n149: }\\n150: \\n151: // healthResponse is the /health response shape: the mg version, whether the\\n152: // docker image is present (session.ImagePresent), and per-profile readiness.\\n153: type healthResponse struct {\\n154: \\tVersion      string             `json:\\\"version\\\"`\\n155: \\tImagePresent bool               `json:\\\"imagePresent\\\"`\\n156: \\tProfiles     []healthProfileRow `json:\\\"profiles\\\"`\\n157: }\\n158: \\n159: // profileReady reduces a profile's credential check to a boolean.\\n160: func profileReady(id string) bool {\\n161: \\tinfo, err := session.ResolveProfile(session.Options{Profile: id})\\n162: \\tif err != nil {\\n163: \\t\\treturn false\\n164: \\t}\\n165: \\treturn info.CheckAuth() == nil\\n166: }\\n167: \\n168: // handleHealth serves the daemon's health/status: version, docker image\\n169: // presence, and profile readiness — pure booleans and identifiers, never\\n170: // credential material.\\n171: func (s *Server) handleHealth(w http.ResponseWriter, r *http.Request) {\\n172: \\tresp := healthResponse{\\n173: \\t\\tVersion:      s.version,\\n174: \\t\\tImagePresent: session.ImagePresent(),\\n175: \\t}\\n176: \\tfor _, p := range config.Profiles() {\\n177: \\t\\tresp.Profiles = append(resp.Profiles, healthProfileRow{ID: p.ID, Ready: profileReady(p.ID)})\\n178: \\t}\\n179: \\twriteJSON(w, http.StatusOK, resp)\\n180: }\\n181: \\n182: // --- /projects ---------------------------------------------------------------\\n183: \\n184: // projectRow is one entry in the /projects response: a registered root and\\n185: // its configured name (the URL segment that resolves to it).\\n186: type projectRow struct {\\n187: \\tPath string `json:\\\"path\\\"`\\n188: \\tName string `json:\\\"name\\\"`\\n189: }\\n190: \\n191: // projectsResponse is the /projects response shape.\\n192: type projectsResponse struct {\\n193: \\tProjects []projectRow `json:\\\"projects\\\"`\\n194: }\\n195: \\n196: // handleProjects lists the registered project roots — pure registry data, the\\n197: // daemon never scans for projects it does not know.\\n198: func (s *Server) handleProjects(w http.ResponseWriter, r *http.Request) {\\n199: \\tentries := s.reg.Entries()\\n200: \\trows := make([]projectRow, 0, len(entries))\\n201: \\tfor _, e := range entries {\\n202: \\t\\trows = append(rows, projectRow{Path: e.Path, Name: e.Name})\\n203: \\t}\\n204: \\twriteJSON(w, http.StatusOK, projectsResponse{Projects: rows})\\n205: }\\n206: \\n207: // --- /projects/{project}/jobs ------------------------------------------------\\n208: \\n209: // jdiStatusRow is the mg-jdi activity state for a job: state / agent / last\\n210: // update, from the job's status sidecar. Omitted when there is no live run\\n211: // state (a job mg-jdi never drove, or a stale/unreadable sidecar).\\n212: type jdiStatusRow struct {\\n213: \\tState   string `json:\\\"state\\\"`\\n214: \\tAgent   string `json:\\\"agent\\\"`\\n215: \\tUpdated string `json:\\\"updated\\\"` // RFC3339\\n216: }\\n217: \\n218: // jobRow is one row in the jobs response — the TUI's info design: id / status\\n219: // / stage / type / date / title, one row per job, in job.Discover's sort\\n220: // order (newest first).\\n221: type jobRow struct {\\n222: \\tID     string        `json:\\\"id\\\"`\\n223: \\tName   string        `json:\\\"name\\\"`\\n224: \\tStatus string        `json:\\\"status\\\"`\\n225: \\tStage  string        `json:\\\"stage\\\"`\\n226: \\tType   string        `json:\\\"type\\\"`\\n227: \\tDate   string        `json:\\\"date\\\"`\\n228: \\tTitle  string        `json:\\\"title\\\"`\\n229: \\tBranch string        `json:\\\"branch,omitempty\\\"`\\n230: \\tJDI    *jdiStatusRow `json:\\\"jdi,omitempty\\\"`\\n231: }\\n232: \\n233: // jobsResponse is the /projects/{project}/jobs response shape.\\n234: type jobsResponse struct {\\n235: \\tJobs []jobRow `json:\\\"jobs\\\"`\\n236: }\\n237: \\n238: // handleProjectJobs lists a project's open jobs with the mg-jdi activity\\n239: // state per job.\\n240: func (s *Server) handleProjectJobs(w http.ResponseWriter, r *http.Request) {\\n241: \\troot, ok := s.resolveProject(w, r.PathValue(\\\"project\\\"))\\n242: \\tif !ok {\\n243: \\t\\treturn\\n244: \\t}\\n245: \\tjobs, err := job.Discover(root)\\n246: \\tif err != nil {\\n247: \\t\\twriteError(w, http.StatusInternalServerError, \\\"cannot read jobs\\\")\\n248: \\t\\treturn\\n249: \\t}\\n250: \\trows := make([]jobRow, 0, len(jobs))\\n251: \\tfor _, j := range jobs {\\n252: \\t\\trow := jobRow{\\n253: \\t\\t\\tID:     j.ID,\\n254: \\t\\t\\tName:   j.Name,\\n255: \\t\\t\\tStatus: j.Status,\\n256: \\t\\t\\tStage:  string(j.Stage()),\\n257: \\t\\t\\tType:   j.Type,\\n258: \\t\\t\\tDate:   j.Date,\\n259: \\t\\t\\tTitle:  j.Title,\\n260: \\t\\t\\tBranch: j.Branch,\\n261: \\t\\t}\\n262: \\t\\tif st, ok := job.ReadJDIStatus(root, j.Name); ok {\\n263: \\t\\t\\trow.JDI = &jdiStatusRow{\\n264: \\t\\t\\t\\tState:   string(st.State),\\n265: \\t\\t\\t\\tAgent:   st.Agent,\\n266: \\t\\t\\t\\tUpdated: st.Updated.Format(time.RFC3339),\\n267: \\t\\t\\t}\\n268: \\t\\t}\\n269: \\t\\trows = append(rows, row)\\n270: \\t}\\n271: \\twriteJSON(w, http.StatusOK, jobsResponse{Jobs: rows})\\n272: }\\n273: \\n274: // --- /projects/{project}/jobs/{job}/files/{file} -----------------------------\\n275: \\n276: // handleJobFile serves one of a job's four markdown files as raw markdown\\n277: // text. The file segment is whitelisted (jobFileNames); a missing file is a\\n278: // normal 404 (e.g. verdict.md before review).\\n279: func (s *Server) handleJobFile(w http.ResponseWriter, r *http.Request) {\\n280: \\troot, ok := s.resolveProject(w, r.PathValue(\\\"project\\\"))\\n281: \\tif !ok {\\n282: \\t\\treturn\\n283: \\t}\\n284: \\tj, ok := s.resolveJob(w, root, r.PathValue(\\\"job\\\"))\\n285: \\tif !ok {\\n286: \\t\\treturn\\n287: \\t}\\n288: \\tfile := r.PathValue(\\\"file\\\")\\n289: \\tif !jobFileNames[file] {\\n290: \\t\\twriteError(w, http.StatusNotFound, \\\"file not found\\\")\\n291: \\t\\treturn\\n292: \\t}\\n293: \\tdata, err := os.ReadFile(filepath.Join(j.Dir, file))\\n294: \\tif err != nil {\\n295: \\t\\twriteError(w, http.StatusNotFound, \\\"file not found\\\")\\n296: \\t\\treturn\\n297: \\t}\\n298: \\tw.Header().Set(\\\"Content-Type\\\", \\\"text/markdown; charset=utf-8\\\")\\n299: \\tw.WriteHeader(http.StatusOK)\\n300: \\t_, _ = w.Write(data)\\n301: }\\n302: \\n303: // --- /projects/{project}/jobs/{job}/jdi -------------------------------------\\n304: \\n305: // jobJDIResponse is the /projects/{project}/jobs/{job}/jdi response shape:\\n306: // the mg-jdi status (state/agent/updated — null when there is no live run\\n307: // state), the run.log tail (null when mg-jdi never ran the job), and the\\n308: // job's session.log tail (null when no run output was captured yet — a\\n309: // normal \\\"no run yet\\\", not an error).\\n310: type jobJDIResponse struct {\\n311: \\tStatus     *jdiStatusRow `json:\\\"status\\\"`\\n312: \\tRunLog     *string       `json:\\\"runLog\\\"`\\n313: \\tSessionLog *string       `json:\\\"sessionLog\\\"`\\n314: }\\n315: \\n316: // tailBytes bounds how much of a log file the jdi endpoint loads into memory\\n317: // — a tail, not \\\"load everything\\\", the same bounded-viewport approach\\n318: // job.ReadJDIRunLogTail already uses for run.log (256 KiB, generous enough\\n319: // for many invocations' worth of text while a small, fixed cost).\\n320: const tailBytes = 256 * 1024\\n321: \\n322: // readFileTail returns the last tailBytes of the file at path — the\\n323: // session.log counterpart of job.ReadJDIRunLogTail, applied to a job-dir file\\n324: // (docs/jobs/<name>/session.log). A possibly-partial first line is dropped so\\n325: // the tail starts at a clean boundary, with a truncation marker. ok is false\\n326: // only when the file is missing; an existing-but-empty file is (\\\"\\\", true).\\n327: func readFileTail(path string) (string, bool) {\\n328: \\tf, err := os.Open(path)\\n329: \\tif err != nil {\\n330: \\t\\treturn \\\"\\\", false\\n331: \\t}\\n332: \\tdefer f.Close()\\n333: \\n334: \\tinfo, err := f.Stat()\\n335: \\tif err != nil {\\n336: \\t\\treturn \\\"\\\", false\\n337: \\t}\\n338: \\tsize := info.Size()\\n339: \\tif size == 0 {\\n340: \\t\\treturn \\\"\\\", true\\n341: \\t}\\n342: \\n343: \\tstart := int64(0)\\n344: \\ttruncated := false\\n345: \\tif size > tailBytes {\\n346: \\t\\tstart = size - tailBytes\\n347: \\t\\ttruncated = true\\n348: \\t}\\n349: \\tif _, err := f.Seek(start, io.SeekStart); err != nil {\\n350: \\t\\treturn \\\"\\\", false\\n351: \\t}\\n352: \\tdata, err := io.ReadAll(f)\\n353: \\tif err != nil {\\n354: \\t\\treturn \\\"\\\", false\\n355: \\t}\\n356: \\n357: \\ttext := string(data)\\n358: \\tif truncated {\\n359: \\t\\tif idx := strings.IndexByte(text, '\\\\n'); idx >= 0 {\\n360: \\t\\t\\ttext = text[idx+1:]\\n361: \\t\\t}\\n362: \\t\\ttext = \\\"… (log truncated — showing the most recent portion)\\\\n\\\\n\\\" + text\\n363: \\t}\\n364: \\treturn text, true\\n365: }\\n366: \\n367: // handleJobJDI serves a job's mg-jdi run state and its captured logs: the\\n368: // status sidecar (ReadJDIStatus), the run.log tail (ReadJDIRunLogTail), and\\n369: // the job's own session.log tail. All three are file reads scoped to the\\n370: // resolved root/job — never client-supplied paths.\\n371: func (s *Server) handleJobJDI(w http.ResponseWriter, r *http.Request) {\\n372: \\troot, ok := s.resolveProject(w, r.PathValue(\\\"project\\\"))\\n373: \\tif !ok {\\n374: \\t\\treturn\\n375: \\t}\\n376: \\tj, ok := s.resolveJob(w, root, r.PathValue(\\\"job\\\"))\\n377: \\tif !ok {\\n378: \\t\\treturn\\n379: \\t}\\n380: \\n381: \\tresp := jobJDIResponse{}\\n382: \\tif st, ok := job.ReadJDIStatus(root, j.Name); ok {\\n383: \\t\\tresp.Status = &jdiStatusRow{\\n384: \\t\\t\\tState:   string(st.State),\\n385: \\t\\t\\tAgent:   st.Agent,\\n386: \\t\\t\\tUpdated: st.Updated.Format(time.RFC3339),\\n387: \\t\\t}\\n388: \\t}\\n389: \\tif text, ok := job.ReadJDIRunLogTail(root, j.Name); ok {\\n390: \\t\\tresp.RunLog = &text\\n391: \\t}\\n392: \\tif text, ok := readFileTail(filepath.Join(j.Dir, \\\"session.log\\\")); ok {\\n393: \\t\\tresp.SessionLog = &text\\n394: \\t}\\n395: \\twriteJSON(w, http.StatusOK, resp)\\n396: }\\n397: \\n398: // --- /projects/{project}/jobs/{job}/diff ------------------------------------\\n399: \\n400: // jobDiffResponse is the /projects/{project}/jobs/{job}/diff response shape.\\n401: // Without ?full=1 it is the \\\"quick eyeball\\\" — the branch's commits\\n402: // (git.LogOneline) and its changed files (git.DiffStat), the same two calls\\n403: // `mg diff` makes. With ?full=1 it is the complete patch (git.Diff). The\\n404: // three-dot range <base>...<branch> is resolved exactly as mg diff resolves\\n405: // it.\\n406: type jobDiffResponse struct {\\n407: \\tLog   *string `json:\\\"log,omitempty\\\"`\\n408: \\tStat  *string `json:\\\"stat,omitempty\\\"`\\n409: \\tPatch *string `json:\\\"patch,omitempty\\\"`\\n410: }\\n411: \\n412: // errJobBranchNotFound / errJobBranchAmbiguous classify a failed job→branch\\n413: // resolution so the handler can map them to 404 / 409 with the CLI's wording.\\n414: var (\\n415: \\terrJobBranchNotFound  = errors.New(\\\"job branch not found\\\")\\n416: \\terrJobBranchAmbiguous = errors.New(\\\"job branch ambiguous\\\")\\n417: )\\n418: \\n419: // resolveJobBranch mirrors cmd/mg/diff.go's resolveJobBranch — the same\\n420: // exact-then-prefix matching on the branch's id_slug tail segment, with the\\n421: // same error wording. Not-found and ambiguity are classified (errors.Is) so\\n422: // the API can map them onto 404 / 409.\\n423: func resolveJobBranch(branches []string, jobArg string) (string, error) {\\n424: \\tif branch := git.ExactBranchMatch(branches, jobArg); branch != \\\"\\\" {\\n425: \\t\\treturn branch, nil\\n426: \\t}\\n427: \\tprefixMatches := git.PrefixBranchMatches(branches, jobArg)\\n428: \\tswitch len(prefixMatches) {\\n429: \\tcase 0:\\n430: \\t\\tmsg := fmt.Sprintf(\\\"job '%s' not found among local branches.\\\\nActive job branches:\\\", jobArg)\\n431: \\t\\tfor _, b := range branches {\\n432: \\t\\t\\tmsg += \\\"\\\\n  \\\" + b\\n433: \\t\\t}\\n434: \\t\\treturn \\\"\\\", fmt.Errorf(\\\"%w: %s\\\", errJobBranchNotFound, msg)\\n435: \\tcase 1:\\n436: \\t\\treturn prefixMatches[0], nil\\n437: \\tdefault:\\n438: \\t\\treturn \\\"\\\", fmt.Errorf(\\\"%w: job '%s' is ambiguous — matches branches: %s\\\", errJobBranchAmbiguous, jobArg, strings.Join(prefixMatches, \\\" \\\"))\\n439: \\t}\\n440: }\\n441: \\n442: // handleJobDiff serves a job's branch diff against the project's base branch\\n443: // — the `mg diff` quick eyeball (log + stat) or, with ?full=1, the complete\\n444: // patch. The base branch resolves exactly as mg diff does (the project's\\n445: // configured baseBranch, falling back to origin/HEAD → main); the job→branch\\n446: // resolution is the CLI's exact-then-prefix chain. All git access goes\\n447: // through internal/git — the package that owns every git shell-out. Read-only\\n448: // git commands only.\\n449: func (s *Server) handleJobDiff(w http.ResponseWriter, r","metadata":{"output":"...\n\nfirm past — there is no human physically\\n// reading a terminal warning over this API, so the default is to refuse\\n// (409) rather than silently auto-approve a risky merge the way the TUI's\\n// yesConfirm does today.\\ntype doneRequest struct {\\n\\tForce bool `json:\\\"force\\\"`\\n}\\n\\n// doneResponse is the done endpoint's response: the finished job's name, the\\n// branch that was merged and deleted, and the base branch it was merged into.\\ntype doneResponse struct {\\n\\tJobName    string `json:\\\"jobName\\\"`\\n\\tBranch     string `json:\\\"branch\\\"`\\n\\tBaseBranch string `json:\\\"baseBranch\\\"`\\n}\\n\\n// doneVerdictWarning reproduces FinishJob's own pre-merge verdict check\\n// (internal/job/finish.go) without duplicating its regex classification: it\\n// reads the same job.Job.VerdictStatus/job.VerdictNotApproved exported\\n// helpers FinishJob itself is built on, so the two can never drift. hasWarning\\n// is true — with the CLI's own warning text — for exactly the three cases\\n// FinishJob would otherwise interactively confirm past: an undetermined\\n// status, a REJECTED/NEEDS WORK status, or a missing verdict.md.\\nfunc doneVerdictWarning(j job.Job) (warning string, hasWarning bool) {\\n\\tverdictPath := filepath.Join(j.Dir, \\\"verdict.md\\\")\\n\\tswitch _, err := os.Stat(verdictPath); {\\n\\tcase err == nil:\\n\\t\\tstatus := j.VerdictStatus()\\n\\t\\tswitch {\\n\\t\\tcase status == \\\"\\\":\\n\\t\\t\\treturn \\\"Warning: could not determine verdict status from verdict.md\\\", true\\n\\t\\tcase job.VerdictNotApproved(status):\\n\\t\\t\\treturn fmt.Sprintf(\\\"Warning: verdict is '%s' — job is not approved.\\\", status), true\\n\\t\\tdefault:\\n\\t\\t\\treturn \\\"\\\", false\\n\\t\\t}\\n\\tcase os.IsNotExist(err):\\n\\t\\treturn \\\"Warning: no verdict.md found — job has not been reviewed.\\\", true\\n\\tdefault:\\n\\t\\treturn \\\"\\\", false // unreadable for some other reason — let FinishJob itself surface it\\n\\t}\\n}\\n\\n// handleDoneJob archives a finished job (job.FinishJobWithOptions) under the\\n// project lock (git-mutating, named explicitly in the brief's Notes).\\n//\\n// A squash-merge conflict is reported as a structured 409 error\\n// (job.ErrSquashMergeConflict, via FinishOptions.NoConflictRecovery) and the\\n// job is left exactly where FinishJob left it — no automatic rollback, no\\n// automatic @git-solver handoff — per the brief's own explicit pinning that\\n// this must not silently fall back to either of FinishJob's two interactive\\n// behaviors; resolving it is an explicit follow-up decision through some\\n// other call (e.g. launching @git-solver via the agent-launch endpoint, or\\n// `mg host` from a terminal).\\n//\\n// Separately (not pinned by the brief at all): the earlier \\\"verdict not\\n// approved\\\" / \\\"no verdict.md\\\" warnings require {\\\"force\\\": true} to proceed\\n// past — a 409 echoing the CLI's own warning text when force is absent —\\n// rather than silently auto-approving a risky merge the way the TUI's\\n// yesConfirm does today.\\nfunc (s *Server) handleDoneJob(w http.ResponseWriter, r *http.Request) {\\n\\troot, ok := s.resolveProject(w, r.PathValue(\\\"project\\\"))\\n\\tif !ok {\\n\\t\\treturn\\n\\t}\\n\\tj, ok := s.resolveJob(w, root, r.PathValue(\\\"job\\\"))\\n\\tif !ok {\\n\\t\\treturn\\n\\t}\\n\\n\\tvar req doneRequest\\n\\tif !decodeJSONBody(w, r, &req) {\\n\\t\\treturn\\n\\t}\\n\\n\\tif warning, has := doneVerdictWarning(j); has && !req.Force {\\n\\t\\twriteError(w, http.StatusConflict, warning+\\\" Pass {\\\\\\\"force\\\\\\\": true} to proceed anyway.\\\")\\n\\t\\treturn\\n\\t}\\n\\n\\ts.locks.Lock(root)\\n\\tdefer s.locks.Unlock(root)\\n\\n\\tvar out bytes.Buffer\\n\\tres, err := job.FinishJobWithOptions(root, j.Name, approvedConfirm, &out, job.FinishOptions{NoConflictRecovery: true})\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, job.ErrSquashMergeConflict) {\\n\\t\\t\\t// The 409 must say explicitly that the job is already\\n\\t\\t\\t// archived-and-committed in its own worktree — FinishJobWithOptions\\n\\t\\t\\t// writes that explanation to out before returning the error (the\\n\\t\\t\\t// archive step runs before the merge attempt and cannot be undone).\\n\\t\\t\\t// A client reading only err.Error() would assume \\\"nothing happened\\\"\\n\\t\\t\\t// and retry done, which then fails confusingly with \\\"brief.md not\\n\\t\\t\\t// found\\\" because the job dir was renamed into docs/jobs/archive/.\\n\\t\\t\\tmsg := err.Error()\\n\\t\\t\\tif s := strings.TrimSpace(out.String()); s != \\\"\\\" {\\n\\t\\t\\t\\tmsg += \\\"\\\\n\\\\n\\\" + s\\n\\t\\t\\t}\\n\\t\\t\\twriteError(w, http.StatusConflict, msg)\\n\\t\\t\\treturn\\n\\t\\t}\\n\\t\\twriteError(w, http.StatusInternalServerError, err.Error())\\n\\t\\treturn\\n\\t}\\n\\twriteJSON(w, http.StatusOK, doneResponse{JobName: res.JobName, Branch: res.Branch, BaseBranch: res.BaseBranch})\\n}\\n\\n// --- POST /projects/{project}/jobs/{job}/delete (TASK-8) --------------------\\n\\n// deleteJobResponse is the delete endpoint's response — job.DeleteResult's\\n// fields.\\ntype deleteJobResponse struct {\\n\\tJobName string `json:\\\"jobName\\\"`\\n\\tBranch  string `json:\\\"branch,omitempty\\\"`\\n\\tDir     string `json:\\\"dir\\\"`\\n}\\n\\n// handleDeleteJob permanently deletes a job (job.DeleteJob) under the project\\n// lock (git-mutating, named explicitly in the brief's Notes). The HTTP call\\n// itself is the confirmation (approvedConfirm) — no merge step, so unlike\\n// done there is no conflict-handling ambiguity here.\\nfunc (s *Server) handleDeleteJob(w http.ResponseWriter, r *http.Request) {\\n\\troot, ok := s.resolveProject(w, r.PathValue(\\\"project\\\"))\\n\\tif !ok {\\n\\t\\treturn\\n\\t}\\n\\tj, ok := s.resolveJob(w, root, r.PathValue(\\\"job\\\"))\\n\\tif !ok {\\n\\t\\treturn\\n\\t}\\n\\n\\ts.locks.Lock(root)\\n\\tdefer s.locks.Unlock(root)\\n\\n\\tvar out bytes.Buffer\\n\\tres, err := job.DeleteJob(root, j.Name, approvedConfirm, &out)\\n\\tif err != nil {\\n\\t\\twriteError(w, http.StatusInternalServerError, err.Error())\\n\\t\\treturn\\n\\t}\\n\\twriteJSON(w, http.StatusOK, deleteJobResponse{JobName: res.JobName, Branch: res.Branch, Dir: res.Dir})\\n}\\n\\n// --- POST /projects/{project}/jobs/{job}/push (TASK-9) ----------------------\\n\\n// pushTimeout bounds the push endpoint's git call, mirroring the TUI git\\n// panel's own hostGitTimeout (src/internal/ui/app.go): long enough for a\\n// real push, short enough that a stalled/unreachable remote can't hang the\\n// request forever.\\nconst pushTimeout = 30 * time.Second\\n\\n// handlePushJob pushes a job's branch to origin (git.PushWithContext — `git\\n// push -u origin <branch>`, mirroring the TUI git panel's \\\"Push to origin\\\"\\n// action) under the project lock (git-mutating, named explicitly in the\\n// brief's Notes). A push failure (auth, network, non-fast-forward) surfaces\\n// as a structured error with git's own message, never silently swallowed.\\nfunc (s *Server) handlePushJob(w http.ResponseWriter, r *http.Request) {\\n\\troot, ok := s.resolveProject(w, r.PathValue(\\\"project\\\"))\\n\\tif !ok {\\n\\t\\treturn\\n\\t}\\n\\tj, ok := s.resolveJob(w, root, r.PathValue(\\\"job\\\"))\\n\\tif !ok {\\n\\t\\treturn\\n\\t}\\n\\n\\ts.locks.Lock(root)\\n\\tdefer s.locks.Unlock(root)\\n\\n\\tctx, cancel := context.WithTimeout(r.Context(), pushTimeout)\\n\\tdefer cancel()\\n\\tif err := git.PushWithContext(ctx, root, j.Branch); err != nil {\\n\\t\\twriteError(w, http.StatusInternalServerError, err.Error())\\n\\t\\treturn\\n\\t}\\n\\twriteJSON(w, http.StatusOK, map[string]string{\\\"status\\\": \\\"pushed\\\", \\\"branch\\\": j.Branch})\\n}\\n\\n// --- POST /prune (TASK-10) ---------------------------------------------------\\n\\n// pruneResponse mirrors mg prune's own reporting (session.PruneResult).\\ntype pruneResponse struct {\\n\\tRemoved int `json:\\\"removed\\\"`\\n\\tRunning int `json:\\\"running\\\"`\\n}\\n\\n// handlePrune wraps session.PruneOrphans — the same function cmd/mg/prune.go's\\n// runPrune calls. Deliberately top-level (not nested under /projects/{project})\\n// rather than project-scoped: orphaned manigot-* containers are not\\n// partitioned by project (docker has no concept of \\\"which registered project\\\"\\n// a leftover container belongs to). No s.locks: no git or project-scoped\\n// state at all.\\nfunc (s *Server) handlePrune(w http.ResponseWriter, r *http.Request) {\\n\\tres, err := session.PruneOrphans(io.Discard)\\n\\tif err != nil {\\n\\t\\twriteError(w, http.StatusInternalServerError, err.Error())\\n\\t\\treturn\\n\\t}\\n\\twriteJSON(w, http.StatusOK, pruneResponse{Removed: res.Removed, Running: res.Running})\\n}\\n\\n// --- /projects/{project}/orphans (TASK-11) ----------------------------------\\n\\n// orphanRow is one orphaned worktree in the response — job.Orphan's fields.\\ntype orphanRow struct {\\n\\tName   string `json:\\\"name\\\"`\\n\\tDir    string `json:\\\"dir\\\"`\\n\\tGitDir string `json:\\\"gitDir\\\"`\\n}\\n\\n// orphansResponse is the list-orphans endpoint's response shape.\\ntype orphansResponse struct {\\n\\tOrphans []orphanRow `json:\\\"orphans\\\"`\\n}\\n\\n// handleProjectOrphans lists a project's orphaned worktrees (job.\\n// DiscoverOrphans) — read-only, no lock.\\nfunc (s *Server) handleProjectOrphans(w http.ResponseWriter, r *http.Request) {\\n\\troot, ok := s.resolveProject(w, r.PathValue(\\\"project\\\"))\\n\\tif !ok {\\n\\t\\treturn\\n\\t}\\n\\torphans, err := job.DiscoverOrphans(root)\\n\\tif err != nil {\\n\\t\\twriteError(w, http.StatusInternalServerError, \\\"cannot list orphaned worktrees\\\")\\n\\t\\treturn\\n\\t}\\n\\trows := make([]orphanRow, 0, len(orphans))\\n\\tfor _, o := range orphans {\\n\\t\\trows = append(rows, orphanRow{Name: o.Name, Dir: o.Dir, GitDir: o.GitDir})\\n\\t}\\n\\twriteJSON(w, http.StatusOK, orphansResponse{Orphans: rows})\\n}\\n\\n// handleDeleteOrphan resolves one named orphan (job.MatchOrphan, exact then\\n// prefix on the orphan's base name) and removes it (job.\\n// RemoveOrphansConfirmed — the HTTP call itself is the confirmation, no\\n// further prompt) under the project lock: RemoveOrphansConfirmed calls\\n// git.WorktreePrune, which touches git worktree metadata and can race with a\\n// concurrent create/done/delete on the same project — this task's own\\n// reasoned addition, since the brief's Notes paragraph does not name orphan\\n// cleanup in its git-mutating set at all.\\n//\\n// One named resource per call, consistent with every other mutating endpoint\\n// in this API, rather than a single \\\"delete everything\\\" call that risks\\n// removing something the caller didn't expect to see gone.\\nfunc (s *Server) handleDeleteOrphan(w http.ResponseWriter, r *http.Request) {\\n\\troot, ok := s.resolveProject(w, r.PathValue(\\\"project\\\"))\\n\\tif !ok {\\n\\t\\treturn\\n\\t}\\n\\tname := r.PathValue(\\\"name\\\")\\n\\tif !validSegment(name) {\\n\\t\\twriteError(w, http.StatusNotFound, \\\"orphan not found\\\")\\n\\t\\treturn\\n\\t}\\n\\to, found := job.MatchOrphan(root, name)\\n\\tif !found {\\n\\t\\twriteError(w, http.StatusNotFound, fmt.Sprintf(\\\"orphan '%s' not found among the project's orphaned worktrees\\\", name))\\n\\t\\treturn\\n\\t}\\n\\n\\ts.locks.Lock(root)\\n\\tdefer s.locks.Unlock(root)\\n\\n\\tvar out bytes.Buffer\\n\\tif err := job.RemoveOrphansConfirmed(root, []job.Orphan{o}, &out); err != nil {\\n\\t\\twriteError(w, http.StatusInternalServerError, err.Error())\\n\\t\\treturn\\n\\t}\\n\\twriteJSON(w, http.StatusOK, orphanRow{Name: o.Name, Dir: o.Dir, GitDir: o.GitDir})\\n}\",\"lineStart\":1,\"lineEnd\":612,\"totalLines\":612,\"truncated\":false}},\"title\":\"src/internal/serve/mutate.go\",\"time\":{\"start\":1787993698491,\"end\":1787993698503}},\"id\":\"prt_04cbab0b5001PjkppYbVCDtp53\",\"sessionID\":\"ses_fb3458985ffeeMJ5OFBVh1MOcx\",\"messageID\":\"msg_04cba96dd001RUxsoonFItyVoy\"}}\n19:{\"type\":\"tool_use\",\"timestamp\":1787993701357,\"sessionID\":\"ses_fb3458985ffeeMJ5OFBVh1MOcx\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID\":\"call_f288fa9189484d7aa3060d24\",\"state\":{\"status\":\"completed\",\"input\":{\"filePath\":\"/workspace/src/internal/serve/api.go\"},\"output\":\"<path>/workspace/src/internal/serve/api.go</path>\\n<type>file</type>\\n<content>\\n1: package serve\\n2: \\n3: import (\\n4: \\t\\\"encoding/json\\\"\\n5: \\t\\\"errors\\\"\\n6: \\t\\\"fmt\\\"\\n7: \\t\\\"io\\\"\\n8: \\t\\\"net/http\\\"\\n9: \\t\\\"os\\\"\\n10: \\t\\\"path/filepath\\\"\\n11: \\t\\\"strings\\\"\\n12: \\t\\\"time\\\"\\n13: \\n14: \\t\\\"github.com/lmuskalla/manigot/internal/agentlist\\\"\\n15: \\t\\\"github.com/lmuskalla/manigot/internal/config\\\"\\n16: \\t\\\"github.com/lmuskalla/manigot/internal/git\\\"\\n17: \\t\\\"github.com/lmuskalla/manigot/internal/job\\\"\\n18: \\t\\\"github.com/lmuskalla/manigot/internal/project\\\"\\n19: \\t\\\"github.com/lmuskalla/manigot/internal/session\\\"\\n20: )\\n21: \\n22: // --- JSON helpers ------------------------------------------------------------\\n23: \\n24: // writeJSON writes v as a JSON response with the given status.\\n25: func writeJSON(w http.ResponseWriter, status int, v any) {\\n26: \\tw.Header().Set(\\\"Content-Type\\\", \\\"application/json\\\")\\n27: \\tw.WriteHeader(status)\\n28: \\t_ = json.NewEncoder(w).Encode(v)\\n29: }\\n30: \\n31: // apiError is the JSON error envelope every non-2xx response carries.\\n32: type apiError struct {\\n33: \\tError string `json:\\\"error\\\"`\\n34: }\\n35: \\n36: // writeError writes a JSON error envelope with the given status.\\n37: func writeError(w http.ResponseWriter, status int, msg string) {\\n38: \\twriteJSON(w, status, apiError{Error: msg})\\n39: }\\n40: \\n41: // --- Resolution helpers — the zero-path-inputs choke point -------------------\\n42: //\\n43: // Every handler resolves its URL segments ONLY through these helpers. A\\n44: // segment is validated as a plain identifier (validSegment), then matched —\\n45: // never joined into a filesystem path. The registered roots (TASK-1), the\\n46: // discovered jobs, and the file whitelist are the only sources of paths the\\n47: // handlers ever open.\\n48: \\n49: // validSegment reports whether a URL segment is a plain, trustworthy\\n50: // identifier: non-empty, not \\\".\\\" or \\\"..\\\" (traversal), containing no path\\n51: // separator (forward or backslash — the backslash is a Windows separator and\\n52: // must never reach a filesystem path), and no NUL byte. Percent-encoded and\\n53: // double-encoded variants all decode to one of these forms before matching,\\n54: // so rejecting the decoded form rejects them all.\\n55: func validSegment(seg string) bool {\\n56: \\tif seg == \\\"\\\" || seg == \\\".\\\" || seg == \\\"..\\\" {\\n57: \\t\\treturn false\\n58: \\t}\\n59: \\tif strings.ContainsAny(seg, \\\"/\\\\\\\\\\\") {\\n60: \\t\\treturn false\\n61: \\t}\\n62: \\treturn !strings.ContainsRune(seg, 0)\\n63: }\\n64: \\n65: // resolveProject maps a URL project segment to a registered root. The segment\\n66: // is validated, then matched against the registry by configured entry name\\n67: // only (Registry.Project) — it is never joined into a filesystem path. An\\n68: // invalid segment or no match is a 404; the handler returns false and must\\n69: // return immediately.\\n70: func (s *Server) resolveProject(w http.ResponseWriter, segment string) (string, bool) {\\n71: \\tif !validSegment(segment) {\\n72: \\t\\twriteError(w, http.StatusNotFound, \\\"project not found\\\")\\n73: \\t\\treturn \\\"\\\", false\\n74: \\t}\\n75: \\troot, ok := s.reg.Project(segment)\\n76: \\tif !ok {\\n77: \\t\\twriteError(w, http.StatusNotFound, \\\"project not found\\\")\\n78: \\t\\treturn \\\"\\\", false\\n79: \\t}\\n80: \\treturn root, true\\n81: }\\n82: \\n83: // resolveJob maps a URL job segment to a discovered job under root. The\\n84: // segment is validated, then matched against the project's discovered jobs by\\n85: // ID, then by id_slug name (the job directory name — the same identity the\\n86: // CLI's branch-tail matching uses), then by unique name prefix. It is never\\n87: // treated as a path. Not-found is a 404; an ambiguous prefix is a 409; the\\n88: // handler returns false and must return immediately.\\n89: func (s *Server) resolveJob(w http.ResponseWriter, root, segment string) (job.Job, bool) {\\n90: \\tif !validSegment(segment) {\\n91: \\t\\twriteError(w, http.StatusNotFound, \\\"job not found\\\")\\n92: \\t\\treturn job.Job{}, false\\n93: \\t}\\n94: \\tjobs, err := job.Discover(root)\\n95: \\tif err != nil {\\n96: \\t\\twriteError(w, http.StatusInternalServerError, \\\"cannot read jobs\\\")\\n97: \\t\\treturn job.Job{}, false\\n98: \\t}\\n99: \\n100: \\t// Exact by ID, then by name.\\n101: \\tfor _, j := range jobs {\\n102: \\t\\tif j.ID == segment || j.Name == segment {\\n103: \\t\\t\\treturn j, true\\n104: \\t\\t}\\n105: \\t}\\n106: \\n107: \\t// Unique prefix on the name.\\n108: \\tvar matches []job.Job\\n109: \\tfor _, j := range jobs {\\n110: \\t\\tif strings.HasPrefix(j.Name, segment) {\\n111: \\t\\t\\tmatches = append(matches, j)\\n112: \\t\\t}\\n113: \\t}\\n114: \\tswitch len(matches) {\\n115: \\tcase 0:\\n116: \\t\\twriteError(w, http.StatusNotFound, fmt.Sprintf(\\\"job '%s' not found among the project's jobs\\\", segment))\\n117: \\t\\treturn job.Job{}, false\\n118: \\tcase 1:\\n119: \\t\\treturn matches[0], true\\n120: \\tdefault:\\n121: \\t\\tnames := make([]string, 0, len(matches))\\n122: \\t\\tfor _, j := range matches {\\n123: \\t\\t\\tnames = append(names, j.Name)\\n124: \\t\\t}\\n125: \\t\\twriteError(w, http.StatusConflict, fmt.Sprintf(\\\"job '%s' is ambiguous — matches jobs: %s\\\", segment, strings.Join(names, \\\" \\\")))\\n126: \\t\\treturn job.Job{}, false\\n127: \\t}\\n128: }\\n129: \\n130: // jobFileNames is the whitelist of job files the API serves: a job's four\\n131: // markdown files, read as raw markdown text. Nothing else under the job dir\\n132: // is ever served.\\n133: var jobFileNames = map[string]bool{\\n134: \\t\\\"brief.md\\\":          true,\\n135: \\t\\\"tasks.md\\\":          true,\\n136: \\t\\\"implementation.md\\\": true,\\n137: \\t\\\"verdict.md\\\":        true,\\n138: }\\n139: \\n140: // --- /health -----------------------------------------------------------------\\n141: \\n142: // healthProfileRow is one profile's credential readiness in the /health\\n143: // response: ready = the profile's ResolveProfile + CheckAuth succeed (the\\n144: // same check the session launcher runs). A missing key is \\\"not ready\\\", never\\n145: // an error; the credential values themselves are never reported.\\n146: type healthProfileRow struct {\\n147: \\tID    string `json:\\\"id\\\"`\\n148: \\tReady bool   `json:\\\"ready\\\"`\\n149: }\\n150: \\n151: // healthResponse is the /health response shape: the mg version, whether the\\n152: // docker image is present (session.ImagePresent), and per-profile readiness.\\n153: type healthResponse struct {\\n154: \\tVersion      string             `json:\\\"version\\\"`\\n155: \\tImagePresent bool               `json:\\\"imagePresent\\\"`\\n156: \\tProfiles     []healthProfileRow `json:\\\"profiles\\\"`\\n157: }\\n158: \\n159: // profileReady reduces a profile's credential check to a boolean.\\n160: func profileReady(id string) bool {\\n161: \\tinfo, err := session.ResolveProfile(session.Options{Profile: id})\\n162: \\tif err != nil {\\n163: \\t\\treturn false\\n164: \\t}\\n165: \\treturn info.CheckAuth() == nil\\n166: }\\n167: \\n168: // handleHealth serves the daemon's health/status: version, docker image\\n169: // presence, and profile readiness — pure booleans and identifiers, never\\n170: // credential material.\\n171: func (s *Server) handleHealth(w http.ResponseWriter, r *http.Request) {\\n172: \\tresp := healthResponse{\\n173: \\t\\tVersion:      s.version,\\n174: \\t\\tImagePresent: session.ImagePresent(),\\n175: \\t}\\n176: \\tfor _, p := range config.Profiles() {\\n177: \\t\\tresp.Profiles = append(resp.Profiles, healthProfileRow{ID: p.ID, Ready: profileReady(p.ID)})\\n178: \\t}\\n179: \\twriteJSON(w, http.StatusOK, resp)\\n180: }\\n181: \\n182: // --- /projects ---------------------------------------------------------------\\n183: \\n184: // projectRow is one entry in the /projects response: a registered root and\\n185: // its configured name (the URL segment that resolves to it).\\n186: type projectRow struct {\\n187: \\tPath string `json:\\\"path\\\"`\\n188: \\tName string `json:\\\"name\\\"`\\n189: }\\n190: \\n191: // projectsResponse is the /projects response shape.\\n192: type projectsResponse struct {\\n193: \\tProjects []projectRow `json:\\\"projects\\\"`\\n194: }\\n195: \\n196: // handleProjects lists the registered project roots — pure registry data, the\\n197: // daemon never scans for projects it does not know.\\n198: func (s *Server) handleProjects(w http.ResponseWriter, r *http.Request) {\\n199: \\tentries := s.reg.Entries()\\n200: \\trows := make([]projectRow, 0, len(entries))\\n201: \\tfor _, e := range entries {\\n202: \\t\\trows = append(rows, projectRow{Path: e.Path, Name: e.Name})\\n203: \\t}\\n204: \\twriteJSON(w, http.StatusOK, projectsResponse{Projects: rows})\\n205: }\\n206: \\n207: // --- /projects/{project}/jobs ------------------------------------------------\\n208: \\n209: // jdiStatusRow is the mg-jdi activity state for a job: state / agent / last\\n210: // update, from the job's status sidecar. Omitted when there is no live run\\n211: // state (a job mg-jdi never drove, or a stale/unreadable sidecar).\\n212: type jdiStatusRow struct {\\n213: \\tState   string `json:\\\"state\\\"`\\n214: \\tAgent   string `json:\\\"agent\\\"`\\n215: \\tUpdated string `json:\\\"updated\\\"` // RFC3339\\n216: }\\n217: \\n218: // jobRow is one row in the jobs response — the TUI's info design: id / status\\n219: // / stage / type / date / title, one row per job, in job.Discover's sort\\n220: // order (newest first).\\n221: type jobRow struct {\\n222: \\tID     string        `json:\\\"id\\\"`\\n223: \\tName   string        `json:\\\"name\\\"`\\n224: \\tStatus string        `json:\\\"status\\\"`\\n225: \\tStage  string        `json:\\\"stage\\\"`\\n226: \\tType   string        `json:\\\"type\\\"`\\n227: \\tDate   string        `json:\\\"date\\\"`\\n228: \\tTitle  string        `json:\\\"title\\\"`\\n229: \\tBranch string        `json:\\\"branch,omitempty\\\"`\\n230: \\tJDI    *jdiStatusRow `json:\\\"jdi,omitempty\\\"`\\n231: }\\n232: \\n233: // jobsResponse is the /projects/{project}/jobs response shape.\\n234: type jobsResponse struct {\\n235: \\tJobs []jobRow `json:\\\"jobs\\\"`\\n236: }\\n237: \\n238: // handleProjectJobs lists a project's open jobs with the mg-jdi activity\\n239: // state per job.\\n240: func (s *Server) handleProjectJobs(w http.ResponseWriter, r *http.Request) {\\n241: \\troot, ok := s.resolveProject(w, r.PathValue(\\\"project\\\"))\\n242: \\tif !ok {\\n243: \\t\\treturn\\n244: \\t}\\n245: \\tjobs, err := job.Discover(root)\\n246: \\tif err != nil {\\n247: \\t\\twriteError(w, http.StatusInternalServerError, \\\"cannot read jobs\\\")\\n248: \\t\\treturn\\n249: \\t}\\n250: \\trows := make([]jobRow, 0, len(jobs))\\n251: \\tfor _, j := range jobs {\\n252: \\t\\trow := jobRow{\\n253: \\t\\t\\tID:     j.ID,\\n254: \\t\\t\\tName:   j.Name,\\n255: \\t\\t\\tStatus: j.Status,\\n256: \\t\\t\\tStage:  string(j.Stage()),\\n257: \\t\\t\\tType:   j.Type,\\n258: \\t\\t\\tDate:   j.Date,\\n259: \\t\\t\\tTitle:  j.Title,\\n260: \\t\\t\\tBranch: j.Branch,\\n261: \\t\\t}\\n262: \\t\\tif st, ok := job.ReadJDIStatus(root, j.Name); ok {\\n263: \\t\\t\\trow.JDI = &jdiStatusRow{\\n264: \\t\\t\\t\\tState:   string(st.State),\\n265: \\t\\t\\t\\tAgent:   st.Agent,\\n266: \\t\\t\\t\\tUpdated: st.Updated.Format(time.RFC3339),\\n267: \\t\\t\\t}\\n268: \\t\\t}\\n269: \\t\\trows = append(rows, row)\\n270: \\t}\\n271: \\twriteJSON(w, http.StatusOK, jobsResponse{Jobs: rows})\\n272: }\\n273: \\n274: // --- /projects/{project}/jobs/{job}/files/{file} -----------------------------\\n275: \\n276: // handleJobFile serves one of a job's four markdown files as raw markdown\\n277: // text. The file segment is whitelisted (jobFileNames); a missing file is a\\n278: // normal 404 (e.g. verdict.md before review).\\n279: func (s *Server) handleJobFile(w http.ResponseWriter, r *http.Request) {\\n280: \\troot, ok := s.resolveProject(w, r.PathValue(\\\"project\\\"))\\n281: \\tif !ok {\\n282: \\t\\treturn\\n283: \\t}\\n284: \\tj, ok := s.resolveJob(w, root, r.PathValue(\\\"job\\\"))\\n285: \\tif !ok {\\n286: \\t\\treturn\\n287: \\t}\\n288: \\tfile := r.PathValue(\\\"file\\\")\\n289: \\tif !jobFileNames[file] {\\n290: \\t\\twriteError(w, http.StatusNotFound, \\\"file not found\\\")\\n291: \\t\\treturn\\n292: \\t}\\n293: \\tdata, err := os.ReadFile(filepath.Join(j.Dir, file))\\n294: \\tif err != nil {\\n295: \\t\\twriteError(w, http.StatusNotFound, \\\"file not found\\\")\\n296: \\t\\treturn\\n297: \\t}\\n298: \\tw.Header().Set(\\\"Content-Type\\\", \\\"text/markdown; charset=utf-8\\\")\\n299: \\tw.WriteHeader(http.StatusOK)\\n300: \\t_, _ = w.Write(data)\\n301: }\\n302: \\n303: // --- /projects/{project}/jobs/{job}/jdi -------------------------------------\\n304: \\n305: // jobJDIResponse is the /projects/{project}/jobs/{job}/jdi response shape:\\n306: // the mg-jdi status (state/agent/updated — null when there is no live run\\n307: // state), the run.log tail (null when mg-jdi never ran the job), and the\\n308: // job's session.log tail (null when no run output was captured yet — a\\n309: // normal \\\"no run yet\\\", not an error).\\n310: type jobJDIResponse struct {\\n311: \\tStatus     *jdiStatusRow `json:\\\"status\\\"`\\n312: \\tRunLog     *string       `json:\\\"runLog\\\"`\\n313: \\tSessionLog *string       `json:\\\"sessionLog\\\"`\\n314: }\\n315: \\n316: // tailBytes bounds how much of a log file the jdi endpoint loads into memory\\n317: // — a tail, not \\\"load everything\\\", the same bounded-viewport approach\\n318: // job.ReadJDIRunLogTail already uses for run.log (256 KiB, generous enough\\n319: // for many invocations' worth of text while a small, fixed cost).\\n320: const tailBytes = 256 * 1024\\n321: \\n322: // readFileTail returns the last tailBytes of the file at path — the\\n323: // session.log counterpart of job.ReadJDIRunLogTail, applied to a job-dir file\\n324: // (docs/jobs/<name>/session.log). A possibly-partial first line is dropped so\\n325: // the tail starts at a clean boundary, with a truncation marker. ok is false\\n326: // only when the file is missing; an existing-but-empty file is (\\\"\\\", true).\\n327: func readFileTail(path string) (string, bool) {\\n328: \\tf, err := os.Open(path)\\n329: \\tif err != nil {\\n330: \\t\\treturn \\\"\\\", false\\n331: \\t}\\n332: \\tdefer f.Close()\\n333: \\n334: \\tinfo, err := f.Stat()\\n335: \\tif err != nil {\\n336: \\t\\treturn \\\"\\\", false\\n337: \\t}\\n338: \\tsize := info.Size()\\n339: \\tif size == 0 {\\n340: \\t\\treturn \\\"\\\", true\\n341: \\t}\\n342: \\n343: \\tstart := int64(0)\\n344: \\ttruncated := false\\n345: \\tif size > tailBytes {\\n346: \\t\\tstart = size - tailBytes\\n347: \\t\\ttruncated = true\\n348: \\t}\\n349: \\tif _, err := f.Seek(start, io.SeekStart); err != nil {\\n350: \\t\\treturn \\\"\\\", false\\n351: \\t}\\n352: \\tdata, err := io.ReadAll(f)\\n353: \\tif err != nil {\\n354: \\t\\treturn \\\"\\\", false\\n355: \\t}\\n356: \\n357: \\ttext := string(data)\\n358: \\tif truncated {\\n359: \\t\\tif idx := strings.IndexByte(text, '\\\\n'); idx >= 0 {\\n360: \\t\\t\\ttext = text[idx+1:]\\n361: \\t\\t}\\n362: \\t\\ttext = \\\"… (log truncated — showing the most recent portion)\\\\n\\\\n\\\" + text\\n363: \\t}\\n364: \\treturn text, true\\n365: }\\n366: \\n367: // handleJobJDI serves a job's mg-jdi run state and its captured logs: the\\n368: // status sidecar (ReadJDIStatus), the run.log tail (ReadJDIRunLogTail), and\\n369: // the job's own session.log tail. All three are file reads scoped to the\\n370: // resolved root/job — never client-supplied paths.\\n371: func (s *Server) handleJobJDI(w http.ResponseWriter, r *http.Request) {\\n372: \\troot, ok := s.resolveProject(w, r.PathValue(\\\"project\\\"))\\n373: \\tif !ok {\\n374: \\t\\treturn\\n375: \\t}\\n376: \\tj, ok := s.resolveJob(w, root, r.PathValue(\\\"job\\\"))\\n377: \\tif !ok {\\n378: \\t\\treturn\\n379: \\t}\\n380: \\n381: \\tresp := jobJDIResponse{}\\n382: \\tif st, ok := job.ReadJDIStatus(root, j.Name); ok {\\n383: \\t\\tresp.Status = &jdiStatusRow{\\n384: \\t\\t\\tState:   string(st.State),\\n385: \\t\\t\\tAgent:   st.Agent,\\n386: \\t\\t\\tUpdated: st.Updated.Format(time.RFC3339),\\n387: \\t\\t}\\n388: \\t}\\n389: \\tif text, ok := job.ReadJDIRunLogTail(root, j.Name); ok {\\n390: \\t\\tresp.RunLog = &text\\n391: \\t}\\n392: \\tif text, ok := readFileTail(filepath.Join(j.Dir, \\\"session.log\\\")); ok {\\n393: \\t\\tresp.SessionLog = &text\\n394: \\t}\\n395: \\twriteJSON(w, http.StatusOK, resp)\\n396: }\\n397: \\n398: // --- /projects/{project}/jobs/{job}/diff ------------------------------------\\n399: \\n400: // jobDiffResponse is the /projects/{project}/jobs/{job}/diff response shape.\\n401: // Without ?full=1 it is the \\\"quick eyeball\\\" — the branch's commits\\n402: // (git.LogOneline) and its changed files (git.DiffStat), the same two calls\\n403: // `mg diff` makes. With ?full=1 it is the complete patch (git.Diff). The\\n404: // three-dot range <base>...<branch> is resolved exactly as mg diff resolves\\n405: // it.\\n406: type jobDiffResponse struct {\\n407: \\tLog   *string `json:\\\"log,omitempty\\\"`\\n408: \\tStat  *string `json:\\\"stat,omitempty\\\"`\\n409: \\tPatch *string `json:\\\"patch,omitempty\\\"`\\n410: }\\n411: \\n412: // errJobBranchNotFound / errJobBranchAmbiguous classify a failed job→branch\\n413: // resolution so the handler can map them to 404 / 409 with the CLI's wording.\\n414: var (\\n415: \\terrJobBranchNotFound  = errors.New(\\\"job branch not found\\\")\\n416: \\terrJobBranchAmbiguous = errors.New(\\\"job branch ambiguous\\\")\\n417: )\\n418: \\n419: // resolveJobBranch mirrors cmd/mg/diff.go's resolveJobBranch — the same\\n420: // exact-then-prefix matching on the branch's id_slug tail segment, with the\\n421: // same error wording. Not-found and ambiguity are classified (errors.Is) so\\n422: // the API can map them onto 404 / 409.\\n423: func resolveJobBranch(branches []string, jobArg string) (string, error) {\\n424: \\tif branch := git.ExactBranchMatch(branches, jobArg); branch != \\\"\\\" {\\n425: \\t\\treturn branch, nil\\n426: \\t}\\n427: \\tprefixMatches := git.PrefixBranchMatches(branches, jobArg)\\n428: \\tswitch len(prefixMatches) {\\n429: \\tcase 0:\\n430: \\t\\tmsg := fmt.Sprintf(\\\"job '%s' not found among local branches.\\\\nActive job branches:\\\", jobArg)\\n431: \\t\\tfor _, b := range branches {\\n432: \\t\\t\\tmsg += \\\"\\\\n  \\\" + b\\n433: \\t\\t}\\n434: \\t\\treturn \\\"\\\", fmt.Errorf(\\\"%w: %s\\\", errJobBranchNotFound, msg)\\n435: \\tcase 1:\\n436: \\t\\treturn prefixMatches[0], nil\\n437: \\tdefault:\\n438: \\t\\treturn \\\"\\\", fmt.Errorf(\\\"%w: job '%s' is ambiguous — matches branches: %s\\\", errJobBranchAmbiguous, jobArg, strings.Join(prefixMatches, \\\" \\\"))\\n439: \\t}\\n440: }\\n441: \\n442: // handleJobDiff serves a job's branch diff against the project's base branch\\n443: // — the `mg diff` quick eyeball (log + stat) or, with ?full=1, the complete\\n444: // patch. The base branch resolves exactly as mg diff does (the project's\\n445: // configured baseBranch, falling back to origin/HEAD → main); the job→branch\\n446: // resolution is the CLI's exact-then-prefix chain. All git access goes\\n447: // through internal/git — the package that owns every git shell-out. Read-only\\n448: // git commands only.\\n449: func (s *Server) handleJobDiff(w http.ResponseWriter, r","exit":0,"truncated":true,"outputPath":"/home/claude/.local/share/opencode/tool-output/tool_04ccea454001UbMKfKKvYuXmFW"},"title":"cd /workspace && wc -l docs/jobs/brother_api-routes-for-settings/session.log && grep -n -i \"agent\\|developer\\|analyst\\|reviewer\\|invoke\\|prompt\" docs/jobs/brother_api-routes-for-settings/session.log | head -20","time":{"start":1787995006018,"end":1787995006041}},"id":"prt_04ccea1740017WsOyESsFDROss","sessionID":"ses_fb3337e5bffeqUmulSYU99zDKc","messageID":"msg_04cce7251001WignH0M1rhuuax"}}
