: // independent — one project's critical section never blocks another's, the\n56: // property that keeps a multi-project daemon from serializing everything.\n57: func TestProjectLocksIndependenceAcrossKeys(t *testing.T) {\n58: \tlocks := NewProjectLocks()\n59: \n60: \tenteredA := make(chan struct{})\n61: \treleaseA := make(chan struct{})\n62: \tdoneA := make(chan struct{})\n63: \tgo func() {\n64: \t\tlocks.Lock(\"projectA\")\n65: \t\tdefer locks.Unlock(\"projectA\")\n66: \t\tclose(enteredA)\n67: \t\t<-releaseA\n68: \t\tclose(doneA)\n69: \t}()\n70: \t<-enteredA\n71: \n72: \t// Locking a different key while projectA is held must succeed immediately.\n73: \tgotB := make(chan struct{})\n74: \tgo func() {\n75: \t\tlocks.Lock(\"projectB\")\n76: \t\tdefer locks.Unlock(\"projectB\")\n77: \t\tclose(gotB)\n78: \t}()\n79: \tselect {\n80: \tcase <-gotB:\n81: \t\t// independent — B proceeded while A was held\n82: \tcase <-time.After(2 * time.Second):\n83: \t\tt.Fatal(\"Lock on a different key blocked behind projectA — locks must be per-project\")\n84: \t}\n85: \n86: \tclose(releaseA)\n87: \t<-doneA\n88: }\n89: \n90: // TestProjectLocksAPIReentrantShape pins the API shape job two's handlers\n91: // will call: New → Lock(root) → Unlock(root), repeatedly and across many\n92: // keys, without panics or cross-talk — the \"Lock/Unlock serialize one key,\n93: // ignore others\" contract in its simplest form.\n94: func TestProjectLocksAPIReentrantShape(t *testing.T) {\n95: \tlocks := NewProjectLocks()\n96: \tkeys := []string{\"/a\", \"/b\", \"/a\", \"/c\", \"/b\", \"/a\"}\n97: \tfor i := 0; i < 3; i++ {\n98: \t\tfor _, k := range keys {\n99: \t\t\tlocks.Lock(k)\n100: \t\t\t// The lock is held for the critical section, then released.\n101: \t\t\tlocks.Unlock(k)\n102: \t\t}\n103: \t}\n104: \t// An Unlock without a Lock is a no-op, not a panic (a caller bug must not\n105: \t// crash the daemon).\n106: \tlocks.Unlock(\"/never-locked\")\n107: }\n108: \n109: // TestProjectLocksContentionStress: many goroutines hammering the same key\n110: // never overlap their critical sections (a statistical smoke test of the\n111: // mutual exclusion under real concurrency).\n112: func TestProjectLocksContentionStress(t *testing.T) {\n113: \tlocks := NewProjectLocks()\n114: \tconst key = \"/contended\"\n115: \n116: \tvar mu sync.Mutex\n117: \tinCritical := 0\n118: \tmaxConcurrent := 0\n119: \n120: \tvar wg sync.WaitGroup\n121: \tfor i := 0; i < 20; i++ {\n122: \t\twg.Add(1)\n123: \t\tgo func() {\n124: \t\t\tdefer wg.Done()\n125: \t\t\tlocks.Lock(key)\n126: \t\t\tdefer locks.Unlock(key)\n127: \t\t\tmu.Lock()\n128: \t\t\tinCritical++\n129: \t\t\tif inCritical > maxConcurrent {\n130: \t\t\t\tmaxConcurrent = inCritical\n131: \t\t\t}\n132: \t\t\tmu.Unlock()\n133: \t\t\ttime.Sleep(time.Millisecond)\n134: \t\t\tmu.Lock()\n135: \t\t\tinCritical--\n136: \t\t\tmu.Unlock()\n137: \t\t}()\n138: \t}\n139: \twg.Wait()\n140: \n141: \tif maxConcurrent != 1 {\n142: \t\tt.Errorf(\"max concurrent critical sections on one key = %d, want 1\", maxConcurrent)\n143: \t}\n144: \tif inCritical != 0 {\n145: \t\tt.Errorf(\"inCritical after all goroutines = %d, want 0 (balanced Lock/Unlock)\", inCritical)\n146: \t}\n147: }\n\n(End of file - total 147 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\n// TestProjectLocksMutualExclusionWithinKey: two Lock calls on the same\n// project key serialize — the second blocks until the first releases — the\n// property job two's mutating handlers depend on.\nfunc TestProjectLocksMutualExclusionWithinKey(t *testing.T) {\n\tlocks := NewProjectLocks()\n\tconst key = \"/some/project\"\n\n\tentered := make(chan struct{})\n\trelease := make(chan struct{})\n\tdone := make(chan struct{})\n\tgo func() {\n\t\tlocks.Lock(key)","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/locks_test.go","text":"package serve\n\nimport (\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\n// TestProjectLocksMutualExclusionWithinKey: two Lock calls on the same\n// project key serialize — the second blocks until the first releases — the\n// property job two's mutating handlers depend on.\nfunc TestProjectLocksMutualExclusionWithinKey(t *testing.T) {\n\tlocks := NewProjectLocks()\n\tconst key = \"/some/project\"\n\n\tentered := make(chan struct{})\n\trelease := make(chan struct{})\n\tdone := make(chan struct{})\n\tgo func() {\n\t\tlocks.Lock(key)\n\t\tdefer locks.Unlock(key)\n\t\tclose(entered) // inside the critical section\n\t\t<-release      // hold the lock until the test tries the second Lock\n\t\tclose(done)\n\t}()\n\t<-entered\n\n\tlocked := make(chan struct{})\n\tgo func() {\n\t\tlocks.Lock(key)\n\t\tdefer locks.Unlock(key)\n\t\tclose(locked)\n\t}()\n\n\t// The second acquisition must block while the first holds the lock.\n\tselect {\n\tcase <-locked:\n\t\tt.Fatal(\"second Lock on the same key returned while the first held it\")\n\tcase <-time.After(50 * time.Millisecond):\n\t\t// blocked as expected\n\t}\n\n\tclose(release)\n\t<-done\n\n\t// After the first releases, the second proceeds.\n\tselect {\n\tcase <-locked:\n\tcase <-time.After(2 * time.Second):\n\t\tt.Fatal(\"second Lock did not proceed after the first released\")\n\t}\n}\n\n// TestProjectLocksIndependenceAcrossKeys: locks on different project keys are\n// independent — one project's critical section never blocks another's, the\n// property that keeps a multi-project daemon from serializing everything.\nfunc TestProjectLocksIndependenceAcrossKeys(t *testing.T) {\n\tlocks := NewProjectLocks()\n\n\tenteredA := make(chan struct{})\n\treleaseA := make(chan struct{})\n\tdoneA := make(chan struct{})\n\tgo func() {\n\t\tlocks.Lock(\"projectA\")\n\t\tdefer locks.Unlock(\"projectA\")\n\t\tclose(enteredA)\n\t\t<-releaseA\n\t\tclose(doneA)\n\t}()\n\t<-enteredA\n\n\t// Locking a different key while projectA is held must succeed immediately.\n\tgotB := make(chan struct{})\n\tgo func() {\n\t\tlocks.Lock(\"projectB\")\n\t\tdefer locks.Unlock(\"projectB\")\n\t\tclose(gotB)\n\t}()\n\tselect {\n\tcase <-gotB:\n\t\t// independent — B proceeded while A was held\n\tcase <-time.After(2 * time.Second):\n\t\tt.Fatal(\"Lock on a different key blocked behind projectA — locks must be per-project\")\n\t}\n\n\tclose(releaseA)\n\t<-doneA\n}\n\n// TestProjectLocksAPIReentrantShape pins the API shape job two's handlers\n// will call: New → Lock(root) → Unlock(root), repeatedly and across many\n// keys, without panics or cross-talk — the \"Lock/Unlock serialize one key,\n// ignore others\" contract in its simplest form.\nfunc TestProjectLocksAPIReentrantShape(t *testing.T) {\n\tlocks := NewProjectLocks()\n\tkeys := []string{\"/a\", \"/b\", \"/a\", \"/c\", \"/b\", \"/a\"}\n\tfor i := 0; i < 3; i++ {\n\t\tfor _, k := range keys {\n\t\t\tlocks.Lock(k)\n\t\t\t// The lock is held for the critical section, then released.\n\t\t\tlocks.Unlock(k)\n\t\t}\n\t}\n\t// An Unlock without a Lock is a no-op, not a panic (a caller bug must not\n\t// crash the daemon).\n\tlocks.Unlock(\"/never-locked\")\n}\n\n// TestProjectLocksContentionStress: many goroutines hammering the same key\n// never overlap their critical sections (a statistical smoke test of the\n// mutual exclusion under real concurrency).\nfunc TestProjectLocksContentionStress(t *testing.T) {\n\tlocks := NewProjectLocks()\n\tconst key = \"/contended\"\n\n\tvar mu sync.Mutex\n\tinCritical := 0\n\tmaxConcurrent := 0\n\n\tvar wg sync.WaitGroup\n\tfor i := 0; i < 20; i++ {\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tlocks.Lock(key)\n\t\t\tdefer locks.Unlock(key)\n\t\t\tmu.Lock()\n\t\t\tinCritical++\n\t\t\tif inCritical > maxConcurrent {\n\t\t\t\tmaxConcurrent = inCritical\n\t\t\t}\n\t\t\tmu.Unlock()\n\t\t\ttime.Sleep(time.Millisecond)\n\t\t\tmu.Lock()\n\t\t\tinCritical--\n\t\t\tmu.Unlock()\n\t\t}()\n\t}\n\twg.Wait()\n\n\tif maxConcurrent != 1 {\n\t\tt.Errorf(\"max concurrent critical sections on one key = %d, want 1\", maxConcurrent)\n\t}\n\tif inCritical != 0 {\n\t\tt.Errorf(\"inCritical after all goroutines = %d, want 0 (balanced Lock/Unlock)\", inCritical)\n\t}\n}","lineStart":1,"lineEnd":147,"totalLines":147,"truncated":false}},"title":"src/internal/serve/locks_test.go","time":{"start":1787938858703,"end":1787938858706}},"id":"prt_04975e59b001q8Jzz7yT1eof15","sessionID":"ses_fb68c3d29ffeIO0HMfdSuVup5i","messageID":"msg_049744321001dXVO7j6lfMuErr"}}
