{"type":"step_start","timestamp":1787938734842,"sessionID":"ses_fb68c3d29ffeIO0HMfdSuVup5i","part":{"id":"prt_0497402f8001OdEj43duHUZ7Lq","messageID":"msg_04973fedb001LxU3CqPmetK5In","sessionID":"ses_fb68c3d29ffeIO0HMfdSuVup5i","snapshot":"","type":"step-start"}}
{"type":"tool_use","timestamp":1787938735328,"sessionID":"ses_fb68c3d29ffeIO0HMfdSuVup5i","part":{"type":"tool","tool":"read","callID":"call_446bd8a697744d16b80b2244","state":{"status":"completed","input":{"filePath":"/workspace/src/cmd/mg/serve.go"},"output":"<path>/workspace/src/cmd/mg/serve.go</path>\n<type>file</type>\n<content>\n1: // mg serve — the listener: a long-running daemon exposing a read-only control\n2: // API over a registry of project roots, so any surface (a web UI, a native\n3: // GUI, a future CLI) can attach to it as a client — from localhost or from a\n4: // VPS. This is job one of the control-plane sequence described in\n5: // docs/web-interface.md and the listener brief: `mg serve` + project registry\n6: // + read-only API + localhost default + audit log + serialization skeleton.\n7: //\n8: // The daemon is additive: the TUI stays in-process, and every existing\n9: // command keeps working untouched. It binds to 127.0.0.1:8080 by default\n10: // (tokenless — the machine's own user is the trust boundary, as it is for the\n11: // CLI today); a non-loopback bind REQUIRES a bearer token (--token or\n12: // $MG_SERVE_TOKEN) or the daemon refuses to start. TLS is the reverse proxy's\n13: // job (Caddy/nginx), never the daemon's.\n14: package main\n15: \n16: import (\n17: \t\"context\"\n18: \t\"errors\"\n19: \t\"flag\"\n20: \t\"fmt\"\n21: \t\"io\"\n22: \t\"net\"\n23: \t\"net/http\"\n24: \t\"os\"\n25: \t\"os/signal\"\n26: \t\"strconv\"\n27: \t\"syscall\"\n28: \t\"time\"\n29: \n30: \t\"github.com/lmuskalla/manigot/internal/config\"\n31: \t\"github.com/lmuskalla/manigot/internal/serve\"\n32: )\n33: \n34: // serveShutdownDrain bounds how long mg serve waits for in-flight requests to\n35: // finish on SIGINT/SIGTERM before giving up — a hung request must never wedge\n36: // the exit.\n37: const serveShutdownDrain = 10 * time.Second\n38: \n39: // runServe implements `mg serve` — the listener daemon. It parses the flags,\n40: // loads the project registry, enforces the bind/auth startup guard, then\n41: // blocks serving until SIGINT/SIGTERM, shutting down gracefully with a\n42: // bounded drain. Returns the process exit code.\n43: func runServe(args []string, stdout, stderr io.Writer) int {\n44: \treturn serveCommand(args, stdout, stderr, nil)\n45: }\n46: \n47: // serveCommand is runServe's testable core: it differs only in the listener\n48: // source. When ln is non-nil it serves on that already-bound listener (tests\n49: // hand over a bound 127.0.0.1:0 listener); when nil it binds one itself from\n50: // the --addr/--port flags. Signal handling and the graceful shutdown path are\n51: // identical in both shapes.\n52: func serveCommand(args []string, stdout, stderr io.Writer, ln net.Listener) int {\n53: \tfs := flag.NewFlagSet(\"mg serve\", flag.ContinueOnError)\n54: \tfs.SetOutput(stderr)\n55: \taddr := fs.String(\"addr\", \"127.0.0.1\", \"bind host (loopback default; a non-loopback bind requires a token)\")\n56: \tport := fs.Int(\"port\", 8080, \"bind port\")\n57: \tregistry := fs.String(\"registry\", \"\", \"path to the project registry config (default <checkout>/config/serve.json)\")\n58: \ttokenFlag := fs.String(\"token\", \"\", \"bearer token required on every request (default $MG_SERVE_TOKEN)\")\n59: \tfs.Usage = func() {\n60: \t\tfmt.Fprintf(stderr, \"mg serve %s\\n\\n\", version)\n61: \t\tfmt.Fprintf(stderr, \"The listener: a long-running daemon exposing a read-only control API\\n\")\n62: \t\tfmt.Fprintf(stderr, \"over a registry of project roots (the basis for the web UI / native GUI\\n\")\n63: \t\tfmt.Fprintf(stderr, \"control-plane sequence).\\n\\n\")\n64: \t\tfmt.Fprintf(stderr, \"Usage:\\n\")\n65: \t\tfmt.Fprintf(stderr, \"  mg serve [flags]\\n\\n\")\n66: \t\tfmt.Fprintf(stderr, \"The registry config file holds the project roots the daemon serves:\\n\")\n67: \t\tfmt.Fprintf(stderr, \"  {\\\"projects\\\": [\\\"/abs/project/root\\\", ...]}\\n\")\n68: \t\tfmt.Fprintf(stderr, \"Default location: <manigot checkout>/config/serve.json (override with --registry).\\n\")\n69: \t\tfmt.Fprintf(stderr, \"Changing the registered roots means editing the file and restarting.\\n\\n\")\n70: \t\tfmt.Fprintf(stderr, \"Flags:\\n\")\n71: \t\tfs.PrintDefaults()\n72: \t}\n73: \tif err := fs.Parse(args); err != nil {\n74: \t\treturn 2 // the flag package already printed the error + usage\n75: \t}\n76: \tif fs.NArg() > 0 {\n77: \t\tfmt.Fprintf(stderr, \"Unknown argument: %s\\n\", fs.Arg(0))\n78: \t\treturn 1\n79: \t}\n80: \n81: \t// Token precedence: --token flag, then $MG_SERVE_TOKEN (config.EnvValue —\n82: \t// the .env file first, then the process environment, exactly like every\n83: \t// other credential the daemon reads). A token is never issued, created, or\n84: \t// returned by the API.\n85: \ttoken := *tokenFlag\n86: \tif token == \"\" {\n87: \t\ttoken = config.EnvValue(\"MG_SERVE_TOKEN\")\n88: \t}\n89: \n90: \t// The project registry: an explicit config file of project roots, read\n91: \t// once at startup. No scanning, no auto-adopting.\n92: \tregistryPath := *registry\n93: \tif registryPath == \"\" {\n94: \t\tregistryPath = serve.DefaultRegistryPath()\n95: \t\tif registryPath == \"\" {\n96: \t\t\tcliError(stderr, serve.ErrNoRegistryPath)\n97: \t\t\treturn 1\n98: \t\t}\n99: \t}\n100: \treg, err := serve.LoadRegistry(registryPath)\n101: \tif err != nil {\n102: \t\tcliError(stderr, err)\n103: \t\treturn 1\n104: \t}\n105: \treg.WarnMissingDocs(stderr)\n106: \n107: \t// The startup guard — the hard invariant: a non-loopback bind with no\n108: \t// token refuses to start. Unskippable: there is no flag that turns it off.\n109: \tif err := serve.ValidateStartup(*addr, token); err != nil {\n110: \t\tcliError(stderr, err)\n111: \t\treturn 1\n112: \t}\n113: \n114: \tsrv := serve.New(reg, version, token, stderr)\n115: \n116: \t// Bind (or accept the test-supplied listener) and announce.\n117: \tif ln == nil {\n118: \t\tbindAddr := net.JoinHostPort(*addr, strconv.Itoa(*port))\n119: \t\tln, err = net.Listen(\"tcp\", bindAddr)\n120: \t\tif err != nil {\n121: \t\t\tcliError(stderr, fmt.Errorf(\"mg serve: cannot listen on %s: %v\", bindAddr, err))\n122: \t\t\treturn 1\n123: \t\t}\n124: \t}\n125: \tfmt.Fprintf(stdout, \"mg serve %s — listening on %s\\n\", version, ln.Addr())\n126: \tif token != \"\" {\n127: \t\tfmt.Fprintln(stdout, \"Bearer-token auth enabled — every request must carry Authorization: Bearer <token>.\")\n128: \t\tfmt.Fprintln(stdout, \"TLS is the reverse proxy's job (Caddy/nginx); the daemon always serves plain HTTP.\")\n129: \t} else {\n130: \t\tfmt.Fprintln(stdout, \"No token configured — tokenless mode (safe only on a loopback bind).\")\n131: \t}\n132: \tif len(reg.Projects()) == 0 {\n133: \t\tfmt.Fprintln(stdout, \"Warning: no projects registered — edit the registry config and restart to serve any.\")\n134: \t}\n135: \n136: \t// Serve until SIGINT/SIGTERM, then drain in-flight requests within a\n137: \t// bounded window and exit cleanly.\n138: \tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n139: \tdefer stop()\n140: \n141: \terrCh := make(chan error, 1)\n142: \tgo func() { errCh <- srv.Serve(ln) }()\n143: \n144: \tselect {\n145: \tcase err := <-errCh:\n146: \t\tif err != nil && !errors.Is(err, http.ErrServerClosed) {\n147: \t\t\tcliError(stderr, fmt.Errorf(\"mg serve: %v\", err))\n148: \t\t\treturn 1\n149: \t\t}\n150: \t\treturn 0\n151: \tcase <-ctx.Done():\n152: \t\tdrainCtx, cancel := context.WithTimeout(context.Background(), serveShutdownDrain)\n153: \t\tdefer cancel()\n154: \t\tif err := srv.Shutdown(drainCtx); err != nil {\n155: \t\t\tcliError(stderr, fmt.Errorf(\"mg serve: graceful shutdown: %v\", err))\n156: \t\t\treturn 1\n157: \t\t}\n158: \t\t<-errCh // the serve loop returns http.ErrServerClosed\n159: \t\tfmt.Fprintln(stdout, \"mg serve: shutting down.\")\n160: \t\treturn 0\n161: \t}\n162: }\n\n(End of file - total 162 lines)\n</content>","metadata":{"preview":"// mg serve — the listener: a long-running daemon exposing a read-only control\n// API over a registry of project roots, so any surface (a web UI, a native\n// GUI, a future CLI) can attach to it as a client — from localhost or from a\n// VPS. This is job one of the control-plane sequence described in\n// docs/web-interface.md and the listener brief: `mg serve` + project registry\n// + read-only API + localhost default + audit log + serialization skeleton.\n//\n// The daemon is additive: the TUI stays in-process, and every existing\n// command keeps working untouched. It binds to 127.0.0.1:8080 by default\n// (tokenless — the machine's own user is the trust boundary, as it is for the\n// CLI today); a non-loopback bind REQUIRES a bearer token (--token or\n// $MG_SERVE_TOKEN) or the daemon refuses to start. TLS is the reverse proxy's\n// job (Caddy/nginx), never the daemon's.\npackage main\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/cmd/mg/serve.go","text":"// mg serve — the listener: a long-running daemon exposing a read-only control\n// API over a registry of project roots, so any surface (a web UI, a native\n// GUI, a future CLI) can attach to it as a client — from localhost or from a\n// VPS. This is job one of the control-plane sequence described in\n// docs/web-interface.md and the listener brief: `mg serve` + project registry\n// + read-only API + localhost default + audit log + serialization skeleton.\n//\n// The daemon is additive: the TUI stays in-process, and every existing\n// command keeps working untouched. It binds to 127.0.0.1:8080 by default\n// (tokenless — the machine's own user is the trust boundary, as it is for the\n// CLI today); a non-loopback bind REQUIRES a bearer token (--token or\n// $MG_SERVE_TOKEN) or the daemon refuses to start. TLS is the reverse proxy's\n// job (Caddy/nginx), never the daemon's.\npackage main\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"net\"\n\t\"net/http\"\n\t\"os\"\n\t\"os/signal\"\n\t\"strconv\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/serve\"\n)\n\n// serveShutdownDrain bounds how long mg serve waits for in-flight requests to\n// finish on SIGINT/SIGTERM before giving up — a hung request must never wedge\n// the exit.\nconst serveShutdownDrain = 10 * time.Second\n\n// runServe implements `mg serve` — the listener daemon. It parses the flags,\n// loads the project registry, enforces the bind/auth startup guard, then\n// blocks serving until SIGINT/SIGTERM, shutting down gracefully with a\n// bounded drain. Returns the process exit code.\nfunc runServe(args []string, stdout, stderr io.Writer) int {\n\treturn serveCommand(args, stdout, stderr, nil)\n}\n\n// serveCommand is runServe's testable core: it differs only in the listener\n// source. When ln is non-nil it serves on that already-bound listener (tests\n// hand over a bound 127.0.0.1:0 listener); when nil it binds one itself from\n// the --addr/--port flags. Signal handling and the graceful shutdown path are\n// identical in both shapes.\nfunc serveCommand(args []string, stdout, stderr io.Writer, ln net.Listener) int {\n\tfs := flag.NewFlagSet(\"mg serve\", flag.ContinueOnError)\n\tfs.SetOutput(stderr)\n\taddr := fs.String(\"addr\", \"127.0.0.1\", \"bind host (loopback default; a non-loopback bind requires a token)\")\n\tport := fs.Int(\"port\", 8080, \"bind port\")\n\tregistry := fs.String(\"registry\", \"\", \"path to the project registry config (default <checkout>/config/serve.json)\")\n\ttokenFlag := fs.String(\"token\", \"\", \"bearer token required on every request (default $MG_SERVE_TOKEN)\")\n\tfs.Usage = func() {\n\t\tfmt.Fprintf(stderr, \"mg serve %s\\n\\n\", version)\n\t\tfmt.Fprintf(stderr, \"The listener: a long-running daemon exposing a read-only control API\\n\")\n\t\tfmt.Fprintf(stderr, \"over a registry of project roots (the basis for the web UI / native GUI\\n\")\n\t\tfmt.Fprintf(stderr, \"control-plane sequence).\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"Usage:\\n\")\n\t\tfmt.Fprintf(stderr, \"  mg serve [flags]\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"The registry config file holds the project roots the daemon serves:\\n\")\n\t\tfmt.Fprintf(stderr, \"  {\\\"projects\\\": [\\\"/abs/project/root\\\", ...]}\\n\")\n\t\tfmt.Fprintf(stderr, \"Default location: <manigot checkout>/config/serve.json (override with --registry).\\n\")\n\t\tfmt.Fprintf(stderr, \"Changing the registered roots means editing the file and restarting.\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"Flags:\\n\")\n\t\tfs.PrintDefaults()\n\t}\n\tif err := fs.Parse(args); err != nil {\n\t\treturn 2 // the flag package already printed the error + usage\n\t}\n\tif fs.NArg() > 0 {\n\t\tfmt.Fprintf(stderr, \"Unknown argument: %s\\n\", fs.Arg(0))\n\t\treturn 1\n\t}\n\n\t// Token precedence: --token flag, then $MG_SERVE_TOKEN (config.EnvValue —\n\t// the .env file first, then the process environment, exactly like every\n\t// other credential the daemon reads). A token is never issued, created, or\n\t// returned by the API.\n\ttoken := *tokenFlag\n\tif token == \"\" {\n\t\ttoken = config.EnvValue(\"MG_SERVE_TOKEN\")\n\t}\n\n\t// The project registry: an explicit config file of project roots, read\n\t// once at startup. No scanning, no auto-adopting.\n\tregistryPath := *registry\n\tif registryPath == \"\" {\n\t\tregistryPath = serve.DefaultRegistryPath()\n\t\tif registryPath == \"\" {\n\t\t\tcliError(stderr, serve.ErrNoRegistryPath)\n\t\t\treturn 1\n\t\t}\n\t}\n\treg, err := serve.LoadRegistry(registryPath)\n\tif err != nil {\n\t\tcliError(stderr, err)\n\t\treturn 1\n\t}\n\treg.WarnMissingDocs(stderr)\n\n\t// The startup guard — the hard invariant: a non-loopback bind with no\n\t// token refuses to start. Unskippable: there is no flag that turns it off.\n\tif err := serve.ValidateStartup(*addr, token); err != nil {\n\t\tcliError(stderr, err)\n\t\treturn 1\n\t}\n\n\tsrv := serve.New(reg, version, token, stderr)\n\n\t// Bind (or accept the test-supplied listener) and announce.\n\tif ln == nil {\n\t\tbindAddr := net.JoinHostPort(*addr, strconv.Itoa(*port))\n\t\tln, err = net.Listen(\"tcp\", bindAddr)\n\t\tif err != nil {\n\t\t\tcliError(stderr, fmt.Errorf(\"mg serve: cannot listen on %s: %v\", bindAddr, err))\n\t\t\treturn 1\n\t\t}\n\t}\n\tfmt.Fprintf(stdout, \"mg serve %s — listening on %s\\n\", version, ln.Addr())\n\tif token != \"\" {\n\t\tfmt.Fprintln(stdout, \"Bearer-token auth enabled — every request must carry Authorization: Bearer <token>.\")\n\t\tfmt.Fprintln(stdout, \"TLS is the reverse proxy's job (Caddy/nginx); the daemon always serves plain HTTP.\")\n\t} else {\n\t\tfmt.Fprintln(stdout, \"No token configured — tokenless mode (safe only on a loopback bind).\")\n\t}\n\tif len(reg.Projects()) == 0 {\n\t\tfmt.Fprintln(stdout, \"Warning: no projects registered — edit the registry config and restart to serve any.\")\n\t}\n\n\t// Serve until SIGINT/SIGTERM, then drain in-flight requests within a\n\t// bounded window and exit cleanly.\n\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n\tdefer stop()\n\n\terrCh := make(chan error, 1)\n\tgo func() { errCh <- srv.Serve(ln) }()\n\n\tselect {\n\tcase err := <-errCh:\n\t\tif err != nil && !errors.Is(err, http.ErrServerClosed) {\n\t\t\tcliError(stderr, fmt.Errorf(\"mg serve: %v\", err))\n\t\t\treturn 1\n\t\t}\n\t\treturn 0\n\tcase <-ctx.Done():\n\t\tdrainCtx, cancel := context.WithTimeout(context.Background(), serveShutdownDrain)\n\t\tdefer cancel()\n\t\tif err := srv.Shutdown(drainCtx); err != nil {\n\t\t\tcliError(stderr, fmt.Errorf(\"mg serve: graceful shutdown: %v\", err))\n\t\t\treturn 1\n\t\t}\n\t\t<-errCh // the serve loop returns http.ErrServerClosed\n\t\tfmt.Fprintln(stdout, \"mg serve: shutting down.\")\n\t\treturn 0\n\t}\n}","lineStart":1,"lineEnd":162,"totalLines":162,"truncated":false}},"title":"src/cmd/mg/serve.go","time":{"start":1787938735324,"end":1787938735327}},"id":"prt_049740495001ufqtnm6hl8ukzh","sessionID":"ses_fb68c3d29ffeIO0HMfdSuVup5i","messageID":"msg_04973fedb001LxU3CqPmetK5In"}}
{"type":"tool_use","timestamp":1787938735473,"sessionID":"ses_fb68c3d29ffeIO0HMfdSuVup5i","part":{"type":"tool","tool":"read","callID":"call_2c92beacf6dc4fa3b00ecedc","state":{"status":"completed","input":{"filePath":"/workspace/src/cmd/mg/serve_test.go"},"output":"<path>/workspace/src/cmd/mg/serve_test.go</path>\n<type>file</type>\n<content>\n1: package main\n2: \n3: import (\n4: \t\"net\"\n5: \t\"net/http\"\n6: \t\"os\"\n7: \t\"path/filepath\"\n8: \t\"strings\"\n9: \t\"syscall\"\n10: \t\"testing\"\n11: \t\"time\"\n12: )\n13: \n14: // emptyRegistryFile writes an empty registry config ({\"projects\": []}) to a\n15: // temp path and returns it — the --registry flag value for tests that don't\n16: // need any registered projects.\n17: func emptyRegistryFile(t *testing.T) string {\n18: \tt.Helper()\n19: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n20: \tif err := os.WriteFile(path, []byte(`{\"projects\": []}`), 0o644); err != nil {\n21: \t\tt.Fatal(err)\n22: \t}\n23: \treturn path\n24: }\n25: \n26: // startServe launches serveCommand in a goroutine with a pre-bound loopback\n27: // listener (the testable seam) and waits until the server answers /health,\n28: // returning the base URL and the exit-code channel. The caller must drain\n29: // done — typically by sending SIGINT and reading the exit code, or with\n30: // t.Cleanup.\n31: func startServe(t *testing.T, args []string) (base string, done chan int, stdout, stderr *strings.Builder) {\n32: \tt.Helper()\n33: \tln, err := net.Listen(\"tcp\", \"127.0.0.1:0\")\n34: \tif err != nil {\n35: \t\tt.Fatal(err)\n36: \t}\n37: \tbase = \"http://\" + ln.Addr().String()\n38: \tdone = make(chan int, 1)\n39: \tstdout = &strings.Builder{}\n40: \tstderr = &strings.Builder{}\n41: \tgo func() { done <- serveCommand(args, stdout, stderr, ln) }()\n42: \n43: \tdeadline := time.Now().Add(5 * time.Second)\n44: \tfor {\n45: \t\tresp, err := http.Get(base + \"/health\")\n46: \t\tif err == nil {\n47: \t\t\tresp.Body.Close()\n48: \t\t\t// 200 (tokenless) or 401 (token configured) both mean the server\n49: \t\t\t// is up and the middleware chain is live.\n50: \t\t\tif resp.StatusCode == http.StatusOK || resp.StatusCode == http.StatusUnauthorized {\n51: \t\t\t\tbreak\n52: \t\t\t}\n53: \t\t}\n54: \t\tif time.Now().After(deadline) {\n55: \t\t\tt.Fatalf(\"server did not come up in time (last err %v)\", err)\n56: \t\t}\n57: \t\ttime.Sleep(10 * time.Millisecond)\n58: \t}\n59: \treturn base, done, stdout, stderr\n60: }\n61: \n62: // stopServe sends SIGINT (the daemon's shutdown signal) and waits for the\n63: // exit code.\n64: func stopServe(t *testing.T, done chan int) int {\n65: \tt.Helper()\n66: \tif err := syscall.Kill(os.Getpid(), syscall.SIGINT); err != nil {\n67: \t\tt.Fatal(err)\n68: \t}\n69: \tselect {\n70: \tcase code := <-done:\n71: \t\treturn code\n72: \tcase <-time.After(10 * time.Second):\n73: \t\tt.Fatal(\"daemon did not shut down within 10s of SIGINT\")\n74: \t\treturn -1\n75: \t}\n76: }\n77: \n78: // TestServeDefaultBindAndServes: the default flags bind a loopback listener\n79: // and the daemon answers /health; SIGINT shuts it down gracefully with exit\n80: // code 0.\n81: func TestServeDefaultBindAndServes(t *testing.T) {\n82: \tbase, done, stdout, _ := startServe(t, []string{\"--registry\", emptyRegistryFile(t)})\n83: \tdefer func() {\n84: \t\tif code := stopServe(t, done); code != 0 {\n85: \t\t\tt.Errorf(\"exit code after SIGINT = %d, want 0\", code)\n86: \t\t}\n87: \t}()\n88: \n89: \tresp, err := http.Get(base + \"/health\")\n90: \tif err != nil {\n91: \t\tt.Fatalf(\"GET /health: %v\", err)\n92: \t}\n93: \tresp.Body.Close()\n94: \tif resp.StatusCode != http.StatusOK {\n95: \t\tt.Errorf(\"status = %d, want 200 (tokenless default)\", resp.StatusCode)\n96: \t}\n97: \tif !strings.Contains(stdout.String(), \"listening on\") {\n98: \t\tt.Errorf(\"stdout = %q, want the listening announcement\", stdout.String())\n99: \t}\n100: }\n101: \n102: // TestServeTokenFromEnv: with no --token flag, $MG_SERVE_TOKEN (read via\n103: // config.EnvValue, the same path the daemon uses for every credential)\n104: // configures auth — a request without it is a 401, with it a 200.\n105: func TestServeTokenFromEnv(t *testing.T) {\n106: \t// Isolate the checkout so config.EnvValue falls through to the process\n107: \t// environment (no .env in a fresh fake checkout).\n108: \tt.Setenv(\"MANIGOT_HOME\", t.TempDir())\n109: \tt.Setenv(\"MG_SERVE_TOKEN\", \"env-token\")\n110: \tbase, done, _, _ := startServe(t, []string{\"--registry\", emptyRegistryFile(t)})\n111: \tdefer func() {\n112: \t\tif code := stopServe(t, done); code != 0 {\n113: \t\t\tt.Errorf(\"exit code after SIGINT = %d, want 0\", code)\n114: \t\t}\n115: \t}()\n116: \n117: \tresp, err := http.Get(base + \"/health\")\n118: \tif err != nil {\n119: \t\tt.Fatal(err)\n120: \t}\n121: \tresp.Body.Close()\n122: \tif resp.StatusCode != http.StatusUnauthorized {\n123: \t\tt.Errorf(\"no token: status = %d, want 401 (env token must be enforced)\", resp.StatusCode)\n124: \t}\n125: \n126: \treq, err := http.NewRequest(http.MethodGet, base+\"/health\", nil)\n127: \tif err != nil {\n128: \t\tt.Fatal(err)\n129: \t}\n130: \treq.Header.Set(\"Authorization\", \"Bearer env-token\")\n131: \tresp, err = http.DefaultClient.Do(req)\n132: \tif err != nil {\n133: \t\tt.Fatal(err)\n134: \t}\n135: \tresp.Body.Close()\n136: \tif resp.StatusCode != http.StatusOK {\n137: \t\tt.Errorf(\"with env token: status = %d, want 200\", resp.StatusCode)\n138: \t}\n139: }\n140: \n141: // TestServeTokenFlagWinsOverEnv: an explicit --token flag takes precedence\n142: // over $MG_SERVE_TOKEN — the env token must no longer authenticate.\n143: func TestServeTokenFlagWinsOverEnv(t *testing.T) {\n144: \tt.Setenv(\"MANIGOT_HOME\", t.TempDir())\n145: \tt.Setenv(\"MG_SERVE_TOKEN\", \"env-token\")\n146: \tbase, done, _, _ := startServe(t, []string{\"--registry\", emptyRegistryFile(t), \"--token\", \"flag-token\"})\n147: \tdefer func() {\n148: \t\tif code := stopServe(t, done); code != 0 {\n149: \t\t\tt.Errorf(\"exit code after SIGINT = %d, want 0\", code)\n150: \t\t}\n151: \t}()\n152: \n153: \treq, _ := http.NewRequest(http.MethodGet, base+\"/health\", nil)\n154: \treq.Header.Set(\"Authorization\", \"Bearer env-token\")\n155: \tresp, err := http.DefaultClient.Do(req)\n156: \tif err != nil {\n157: \t\tt.Fatal(err)\n158: \t}\n159: \tresp.Body.Close()\n160: \tif resp.StatusCode != http.StatusUnauthorized {\n161: \t\tt.Errorf(\"env token after --token flag: status = %d, want 401 (flag must win)\", resp.StatusCode)\n162: \t}\n163: \n164: \treq2, _ := http.NewRequest(http.MethodGet, base+\"/health\", nil)\n165: \treq2.Header.Set(\"Authorization\", \"Bearer flag-token\")\n166: \tresp2, err := http.DefaultClient.Do(req2)\n167: \tif err != nil {\n168: \t\tt.Fatal(err)\n169: \t}\n170: \tresp2.Body.Close()\n171: \tif resp2.StatusCode != http.StatusOK {\n172: \t\tt.Errorf(\"flag token: status = %d, want 200\", resp2.StatusCode)\n173: \t}\n174: }\n175: \n176: // TestServeRefusesNonLoopbackWithoutToken pins the startup guard wiring: a\n177: // non-loopback bind with no token exits non-zero before ever listening.\n178: func TestServeRefusesNonLoopbackWithoutToken(t *testing.T) {\n179: \tvar stdout, stderr strings.Builder\n180: \tcode := serveCommand([]string{\"--registry\", emptyRegistryFile(t), \"--addr\", \"0.0.0.0\"}, &stdout, &stderr, nil)\n181: \tif code == 0 {\n182: \t\tt.Fatal(\"serveCommand with 0.0.0.0 and no token = exit 0, want refusal\")\n183: \t}\n184: \tif !strings.Contains(stderr.String(), \"refusing to start\") {\n185: \t\tt.Errorf(\"stderr = %q, want the refusal message\", stderr.String())\n186: \t}\n187: }\n188: \n189: // TestServeRefusesUnreadableRegistryPath: a registry path that exists but\n190: // cannot be read as a config file is a clear error and non-zero exit. (A\n191: // MISSING file is deliberately the opposite — an empty registry, not an\n192: // error; see TestServeMissingRegistryIsEmptyRegistry. The registry degrade\n193: // is pinned in internal/serve's registry_test.go.)\n194: func TestServeRefusesUnreadableRegistryPath(t *testing.T) {\n195: \t// A directory is present but unreadable as a file — os.ReadFile fails\n196: \t// with a non-IsNotExist error, which LoadRegistry surfaces.\n197: \tdir := t.TempDir()\n198: \tvar stdout, stderr strings.Builder\n199: \tcode := serveCommand([]string{\"--registry\", dir}, &stdout, &stderr, nil)\n200: \tif code == 0 {\n201: \t\tt.Fatal(\"serveCommand with an unreadable registry = exit 0, want an error\")\n202: \t}\n203: \tif !strings.Contains(stderr.String(), \"registry\") {\n204: \t\tt.Errorf(\"stderr = %q, want a registry error\", stderr.String())\n205: \t}\n206: }\n207: \n208: // TestServeMissingRegistryIsEmptyRegistry pins the missing-file degrade\n209: // end-to-end through serveCommand: a registry config that does not exist yet\n210: // is an empty registry (the daemon starts, serving nothing), not a startup\n211: // error.\n212: func TestServeMissingRegistryIsEmptyRegistry(t *testing.T) {\n213: \tbase, done, stdout, _ := startServe(t, []string{\"--registry\", filepath.Join(t.TempDir(), \"missing.json\")})\n214: \tdefer func() {\n215: \t\tif code := stopServe(t, done); code != 0 {\n216: \t\t\tt.Errorf(\"exit code after SIGINT = %d, want 0\", code)\n217: \t\t}\n218: \t}()\n219: \n220: \tresp, err := http.Get(base + \"/projects\")\n221: \tif err != nil {\n222: \t\tt.Fatal(err)\n223: \t}\n224: \tdefer resp.Body.Close()\n225: \tif resp.StatusCode != http.StatusOK {\n226: \t\tt.Errorf(\"GET /projects with empty registry: status = %d, want 200\", resp.StatusCode)\n227: \t}\n228: \tif !strings.Contains(stdout.String(), \"no projects registered\") {\n229: \t\tt.Errorf(\"stdout = %q, want the no-projects warning\", stdout.String())\n230: \t}\n231: }\n232: \n233: // TestServeRefusesNoRegistryLocation: with no --registry and no resolvable\n234: // checkout (the default registry path cannot be determined), mg serve exits\n235: // with the cle