{"type":"tool_use","timestamp":1787938727242,"sessionID":"ses_fb68c3d29ffeIO0HMfdSuVup5i","part":{"type":"tool","tool":"read","callID":"call_cbfce553cb964e7ca8982250","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/registry_test.go"},"output":"<path>/workspace/src/internal/serve/registry_test.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"os\"\n5: \t\"path/filepath\"\n6: \t\"strings\"\n7: \t\"testing\"\n8: )\n9: \n10: // writeRegistry writes a registry config file at path with the given\n11: // projects JSON.\n12: func writeRegistry(t *testing.T, path, projectsJSON string) {\n13: \tt.Helper()\n14: \tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n15: \t\tt.Fatal(err)\n16: \t}\n17: \tif err := os.WriteFile(path, []byte(projectsJSON), 0o644); err != nil {\n18: \t\tt.Fatal(err)\n19: \t}\n20: }\n21: \n22: // TestLoadRegistryMissingFileIsEmptyRegistry pins the degrade: a registry\n23: // config that does not exist yet (a fresh checkout) is an empty registry, not\n24: // an error — the daemon starts with nothing registered.\n25: func TestLoadRegistryMissingFileIsEmptyRegistry(t *testing.T) {\n26: \treg, err := LoadRegistry(filepath.Join(t.TempDir(), \"does-not-exist.json\"))\n27: \tif err != nil {\n28: \t\tt.Fatalf(\"LoadRegistry on missing file: %v\", err)\n29: \t}\n30: \tif got := reg.Projects(); len(got) != 0 {\n31: \t\tt.Errorf(\"Projects() = %v, want empty registry\", got)\n32: \t}\n33: \tif _, ok := reg.Project(\"anything\"); ok {\n34: \t\tt.Errorf(\"Project on empty registry resolved, want not-found\")\n35: \t}\n36: }\n37: \n38: // TestLoadRegistryParsesAndValidatesRoots: a valid config yields the\n39: // registered roots in order, each cleaned to an absolute path, with\n40: // duplicates collapsed.\n41: func TestLoadRegistryParsesAndValidatesRoots(t *testing.T) {\n42: \ta := t.TempDir()\n43: \tb := t.TempDir()\n44: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n45: \twriteRegistry(t, path, `{\"projects\": [\"`+a+`\", \"`+b+`\", \"`+a+`\"]}`)\n46: \n47: \treg, err := LoadRegistry(path)\n48: \tif err != nil {\n49: \t\tt.Fatalf(\"LoadRegistry: %v\", err)\n50: \t}\n51: \tgot := reg.Projects()\n52: \tif len(got) != 2 {\n53: \t\tt.Fatalf(\"Projects() = %v, want 2 roots (duplicate collapsed)\", got)\n54: \t}\n55: \tif got[0] != filepath.Clean(a) || got[1] != filepath.Clean(b) {\n56: \t\tt.Errorf(\"Projects() = %v, want [%s %s]\", got, a, b)\n57: \t}\n58: }\n59: \n60: // TestLoadRegistryRejectsNonDirectoryEntries: an entry that exists but is not\n61: // a directory (a file), and an entry that does not exist at all, are both\n62: // errors — a broken registry must never silently serve a subset.\n63: func TestLoadRegistryRejectsNonDirectoryEntries(t *testing.T) {\n64: \tfile := filepath.Join(t.TempDir(), \"some-file\")\n65: \tif err := os.WriteFile(file, []byte(\"x\"), 0o644); err != nil {\n66: \t\tt.Fatal(err)\n67: \t}\n68: \tmissing := filepath.Join(t.TempDir(), \"does-not-exist\")\n69: \n70: \tfor _, bad := range []string{file, missing} {\n71: \t\tpath := filepath.Join(t.TempDir(), \"serve.json\")\n72: \t\twriteRegistry(t, path, `{\"projects\": [\"`+bad+`\"]}`)\n73: \t\tif _, err := LoadRegistry(path); err == nil {\n74: \t\t\tt.Errorf(\"LoadRegistry with entry %q = nil error, want an error\", bad)\n75: \t\t}\n76: \t}\n77: }\n78: \n79: // TestLoadRegistryRejectsUnparseableFile: a present-but-garbage config is an\n80: // error (distinct from the missing-file empty-registry degrade).\n81: func TestLoadRegistryRejectsUnparseableFile(t *testing.T) {\n82: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n83: \twriteRegistry(t, path, `{not json`)\n84: \tif _, err := LoadRegistry(path); err == nil {\n85: \t\tt.Fatal(\"LoadRegistry on garbage = nil error, want an error\")\n86: \t}\n87: }\n88: \n89: // TestRegistryProjectLookupExactPathThenBaseName: Project resolves an exact\n90: // registered path first, then a unique base name — and never invents a root.\n91: func TestRegistryProjectLookupExactPathThenBaseName(t *testing.T) {\n92: \ta := t.TempDir()\n93: \tb := t.TempDir()\n94: \treg := &Registry{projects: []string{filepath.Clean(a), filepath.Clean(b)}}\n95: \n96: \t// Exact path match.\n97: \tif root, ok := reg.Project(filepath.Clean(a)); !ok || root != filepath.Clean(a) {\n98: \t\tt.Errorf(\"Project(exact path) = %q, %v; want %q, true\", root, ok, filepath.Clean(a))\n99: \t}\n100: \t// Base name match.\n101: \tif root, ok := reg.Project(filepath.Base(b)); !ok || root != filepath.Clean(b) {\n102: \t\tt.Errorf(\"Project(base name) = %q, %v; want %q, true\", root, ok, filepath.Clean(b))\n103: \t}\n104: \t// Unknown segment: not-found.\n105: \tif _, ok := reg.Project(\"no-such-project\"); ok {\n106: \t\tt.Errorf(\"Project(unknown) resolved, want not-found\")\n107: \t}\n108: }\n109: \n110: // TestRegistryProjectAmbiguousBaseName: two roots sharing a base name resolve\n111: // to not-found rather than guessing.\n112: func TestRegistryProjectAmbiguousBaseName(t *testing.T) {\n113: \tparent := t.TempDir()\n114: \ta := filepath.Join(parent, \"same\")\n115: \tb := filepath.Join(parent, \"other\", \"same\")\n116: \tfor _, d := range []string{a, filepath.Dir(b)} {\n117: \t\tif err := os.MkdirAll(d, 0o755); err != nil {\n118: \t\t\tt.Fatal(err)\n119: \t\t}\n120: \t}\n121: \treg := &Registry{projects: []string{filepath.Clean(a), filepath.Clean(b)}}\n122: \tif _, ok := reg.Project(\"same\"); ok {\n123: \t\tt.Errorf(\"Project with ambiguous base name resolved, want not-found\")\n124: \t}\n125: }\n126: \n127: // TestLoadRegistryAcceptsRootWithoutDocs: a registered root without docs/ is\n128: // accepted (it lists no jobs rather than failing startup), and\n129: // WarnMissingDocs flags it.\n130: func TestLoadRegistryAcceptsRootWithoutDocs(t *testing.T) {\n131: \troot := t.TempDir() // no docs/ inside\n132: \tpath := filepath.Join(t.TempDir(), \"serve.json\")\n133: \twriteRegistry(t, path, `{\"projects\": [\"`+root+`\"]}`