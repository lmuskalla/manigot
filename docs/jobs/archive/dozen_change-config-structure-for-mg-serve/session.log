{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016Emmm8FWf6N1KenBeBLoET","type":"tool_result","content":"1\tpackage serve\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"io\"\n6\t\t\"net/http\"\n7\t\t\"net/http/httptest\"\n8\t\t\"path/filepath\"\n9\t\t\"strings\"\n10\t\t\"testing\"\n11\t)\n12\t\n13\t// testServer builds a Server over a registry holding one temp project root,\n14\t// returning the server and the registered root. audit is the audit writer\n15\t// (nil for tests that don't assert audit lines).\n16\tfunc testServer(t *testing.T, token string, audit io.Writer) (*Server, string) {\n17\t\tt.Helper()\n18\t\troot := t.TempDir()\n19\t\treg := &Registry{projects: []string{filepath.Clean(root)}}\n20\t\treturn New(reg, \"test-version\", token, audit), root\n21\t}\n22\t\n23\t// get performs a GET against the handler with the given Authorization header.\n24\tfunc get(t *testing.T, srv *Server, path, auth string) *httptest.ResponseRecorder {\n25\t\tt.Helper()\n26\t\treq := httptest.NewRequest(http.MethodGet, path, nil)\n27\t\tif auth != \"\" {\n28\t\t\treq.Header.Set(\"Authorization\", auth)\n29\t\t}\n30\t\trec := httptest.NewRecorder()\n31\t\tsrv.Handler().ServeHTTP(rec, req)\n32\t\treturn rec\n33\t}\n34\t\n35\t// TestTokenRequiredPins the auth contract: with a token configured, the\n36\t// correct bearer header passes, and a missing or wrong token is a 401 before\n37\t// any handler logic runs.\n38\tfunc TestTokenRequiredPins(t *testing.T) {\n39\t\tsrv, _ := testServer(t, \"sekrit-token\", nil)\n40\t\n41\t\tif rec := get(t, srv, \"/projects\", \"Bearer sekrit-token\"); rec.Code != http.StatusOK {\n42\t\t\tt.Errorf(\"correct token: status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n43\t\t}\n44\t\tif rec := get(t, srv, \"/projects\", \"\"); rec.Code != http.StatusUnauthorized {\n45\t\t\tt.Errorf(\"missing token: status = %d, want 401\", rec.Code)\n46\t\t}\n47\t\tif rec := get(t, srv, \"/projects\", \"Bearer wrong-token\"); rec.Code != http.StatusUnauthorized {\n48\t\t\tt.Errorf(\"wrong token: status = %d, want 401\", rec.Code)\n49\t\t}\n50\t\tif rec := get(t, srv, \"/projects\", \"Basic sekrit-token\"); rec.Code != http.StatusUnauthorized {\n51\t\t\tt.Errorf(\"non-bearer scheme: status = %d, want 401\", rec.Code)\n52\t\t}\n53\t\tif rec := get(t, srv, \"/projects\", \"Bearer sekrit-token-extra\"); rec.Code != http.StatusUnauthorized {\n54\t\t\tt.Errorf(\"token with wrong length: status = %d, want 401\", rec.Code)\n55\t\t}\n56\t}\n57\t\n58\t// TestTokenlessLocalhostPins the default: no token configured means every\n59\t// request passes (the machine's own user is the trust boundary, as it is for\n60\t// the CLI today).\n61\tfunc TestTokenlessLocalhostPins(t *testing.T) {\n62\t\tsrv, _ := testServer(t, \"\", nil)\n63\t\tif rec := get(t, srv, \"/projects\", \"\"); rec.Code != http.StatusOK {\n64\t\t\tt.Errorf(\"tokenless: status = %d, want 200\", rec.Code)\n65\t\t}\n66\t\t// An Authorization header on a tokenless daemon is ignored, not rejected.\n67\t\tif rec := get(t, srv, \"/projects\", \"Bearer anything\"); rec.Code != http.StatusOK {\n68\t\t\tt.Errorf(\"tokenless with stray header: status = %d, want 200\", rec.Code)\n69\t\t}\n70\t}\n71\t\n72\t// TestUnauthorizedIsJSONError: the 401 body is the JSON error envelope, never\n73\t// a hint about the expected token.\n74\tfunc TestUnauthorizedIsJSONError(t *testing.T) {\n75\t\tsrv, _ := testServer(t, \"sekrit-token\", nil)\n76\t\trec := get(t, srv, \"/projects\", \"\")\n77\t\tvar body map[string]string\n78\t\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n79\t\t\tt.Fatalf(\"401 body not JSON: %v (%s)\", err, rec.Body.String())\n80\t\t}\n81\t\tif body[\"error\"] == \"\" {\n82\t\t\tt.Errorf(\"401 body = %v, want an error envelope\", body)\n83\t\t}\n84\t\tif strings.Contains(rec.Body.String(), \"sekrit-token\") {\n85\t\t\tt.Errorf(\"401 body echoes the token: %s\", rec.Body.String())\n86\t\t}\n87\t}\n88\t\n89\t// TestTokenMatchesConstantTimeCompare: the comparison goes through\n90\t// crypto/subtle.ConstantTimeCompare (the value path) once the length\n91\t// matches — asserted structurally by pinning the accept/reject behavior at\n92\t// the tokenMatches level, the function the middleware uses.\n93\tfunc TestTokenMatchesConstantTimeCompare(t *testing.T) {\n94\t\treq := httptest.NewRequest(http.MethodGet, \"/\", nil)\n95\t\treq.Header.Set(\"Authorization\", \"Bearer correct-horse\")\n96\t\tif !tokenMatches(req, \"correct-horse\") {\n97\t\t\tt.Error(\"tokenMatches with the right token = false, want true\")\n98\t\t}\n99\t\treq.Header.Set(\"Authorization\", \"Bearer correct-horsf\") // same length, wrong value\n100\t\tif tokenMatches(req, \"correct-horse\") {\n101\t\t\tt.Error(\"tokenMatches with a same-length wrong token = true, want false\")\n102\t\t}\n103\t\treq.Header.Set(\"Authorization\", \"Bearer short\")\n104\t\tif tokenMatches(req, \"correct-horse\") {\n105\t\t\tt.Error(\"tokenMatches with a different-length token = true, want false\")\n106\t\t}\n107\t\treq.Header.Set(\"Authorization\", \"Basic correct-horse\")\n108\t\tif tokenMatches(req, \"correct-horse\") {\n109\t\t\tt.Error(\"tokenMatches with a non-Bearer scheme = true, want false\")\n110\t\t}\n111\t}\n112\t\n113\t// TestIsLoopback pins the binding classification: 127.0.0.0/8, ::1 and\n114\t// localhost are loopback; everything else — including the empty host (binds\n115\t// all interfaces) — is not.\n116\tfunc TestIsLoopback(t *testing.T) {\n117\t\tfor _, host := range []string{\"127.0.0.1\", \"127.0.0.0\", \"127.99.99.99\", \"::1\", \"localhost\"} {\n118\t\t\tif !IsLoopback(host) {\n119\t\t\t\tt.Errorf(\"IsLoopback(%q) = false, want true\", host)\n120\t\t\t}\n121\t\t}\n122\t\tfor _, host := range []string{\"\", \"0.0.0.0\", \"::\", \"192.168.1.10\", \"10.0.0.5\", \"example.com\", \"2001:db8::1\"} {\n123\t\t\tif IsLoopback(host) {\n124\t\t\t\tt.Errorf(\"IsLoopback(%q) = true, want false\", host)\n125\t\t\t}\n126\t\t}\n127\t}\n128\t\n129\t// TestValidateStartupPins the hard invariant: a non-loopback bind without a\n130\t// token refuses to start; a token (or a loopback bind) permits it. There is\n131\t// no flag that turns the refusal off — only a token or a loopback bind.\n132\tfunc TestValidateStartupPins(t *testing.T) {\n133\t\tif err := ValidateStartup(\"0.0.0.0\", \"\"); err == nil {\n134\t\t\tt.Error(\"ValidateStartup(0.0.0.0, no token) = nil, want refusal\")\n135\t\t}\n136\t\tif err := ValidateStartup(\"192.168.1.10\", \"\"); err == nil {\n137\t\t\tt.Error(\"ValidateStartup(non-loopback, no token) = nil, want refusal\")\n138\t\t}\n139\t\tif err := ValidateStartup(\"2001:db8::1\", \"\"); err == nil {\n140\t\t\tt.Error(\"ValidateStartup(non-loopback IPv6, no token) = nil, want refusal\")\n141\t\t}\n142\t\tif err := ValidateStartup(\"0.0.0.0\", \"some-token\"); err != nil {\n143\t\t\tt.Errorf(\"ValidateStartup(0.0.0.0, token) = %v, want nil\", err)\n144\t\t}\n145\t\tif err := ValidateStartup(\"127.0.0.1\", \"\"); err != nil {\n146\t\t\tt.Errorf(\"ValidateStartup(127.0.0.1, no token) = %v, want nil\", err)\n147\t\t}\n148\t\tif err := ValidateStartup(\"::1\", \"\"); err != nil {\n149\t\t\tt.Errorf(\"ValidateStartup(::1, no token) = %v, want nil\", err)\n150\t\t}\n151\t\tif err := ValidateStartup(\"localhost\", \"\"); err != nil {\n152\t\t\tt.Errorf(\"ValidateStartup(localhost, no token) = %v, want nil\", err)\n153\t\t}\n154\t}\n155\t"}]},"parent_tool_use_id":null,"session_id":"c0a07b2b-e4d4-47fe-bb0c-9b7aa946ef87","uuid":"10ba6f51-b98b-4415-a75f-2b48bb466dc2","timestamp":"2026-08-28T17:48:22.053Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/serve/auth_test.go","content":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// testServer builds a Server over a registry holding one temp project root,\n// returning the server and the registered root. audit is the audit writer\n// (nil for tests that don't assert audit lines).\nfunc testServer(t *testing.T, token string, audit io.Writer) (*Server, string) {\n\tt.Helper()\n\troot := t.TempDir()\n\treg := &Registry{projects: []string{filepath.Clean(root)}}\n\treturn New(reg, \"test-version\", token, audit), root\n}\n\n// get performs a GET against the handler with the given Authorization header.\nfunc get(t *testing.T, srv *Server, path, auth string) *httptest.ResponseRecorder {\n\tt.Helper()\n\treq := httptest.NewRequest(http.MethodGet, path, nil)\n\tif auth != \"\" {\n\t\treq.Header.Set(\"Authorization\", auth)\n\t}\n\trec := httptest.NewRecorder()\n\tsrv.Handler().ServeHTTP(rec, req)\n\treturn rec\n}\n\n// TestTokenRequiredPins the auth contract: with a token configured, the\n// correct bearer header passes, and a missing or wrong token is a 401 before\n// any handler logic runs.\nfunc TestTokenRequiredPins(t *testing.T) {\n\tsrv, _ := testServer(t, \"sekrit-token\", nil)\n\n\tif rec := get(t, srv, \"/projects\", \"Bearer sekrit-token\"); rec.Code != http.StatusOK {\n\t\tt.Errorf(\"correct token: status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif rec := get(t, srv, \"/projects\", \"\"); rec.Code != http.StatusUnauthorized {\n\t\tt.Errorf(\"missing token: status = %d, want 401\", rec.Code)\n\t}\n\tif rec := get(t, srv, \"/projects\", \"Bearer wrong-token\"); rec.Code != http.StatusUnauthorized {\n\t\tt.Errorf(\"wrong token: status = %d, want 401\", rec.Code)\n\t}\n\tif rec := get(t, srv, \"/projects\", \"Basic sekrit-token\"); rec.Code != http.StatusUnauthorized {\n\t\tt.Errorf(\"non-bearer scheme: status = %d, want 401\", rec.Code)\n\t}\n\tif rec := get(t, srv, \"/projects\", \"Bearer sekrit-token-extra\"); rec.Code != http.StatusUnauthorized {\n\t\tt.Errorf(\"token with wrong length: status = %d, want 401\", rec.Code)\n\t}\n}\n\n// TestTokenlessLocalhostPins the default: no token configured means every\n// request passes (the machine's own user is the trust boundary, as it is for\n// the CLI today).\nfunc TestTokenlessLocalhostPins(t *testing.T) {\n\tsrv, _ := testServer(t, \"\", nil)\n\tif rec := get(t, srv, \"/projects\", \"\"); rec.Code != http.StatusOK {\n\t\tt.Errorf(\"tokenless: status = %d, want 200\", rec.Code)\n\t}\n\t// An Authorization header on a tokenless daemon is ignored, not rejected.\n\tif rec := get(t, srv, \"/projects\", \"Bearer anything\"); rec.Code != http.StatusOK {\n\t\tt.Errorf(\"tokenless with stray header: status = %d, want 200\", rec.Code)\n\t}\n}\n\n// TestUnauthorizedIsJSONError: the 401 body is the JSON error envelope, never\n// a hint about the expected token.\nfunc TestUnauthorizedIsJSONError(t *testing.T) {\n\tsrv, _ := testServer(t, \"sekrit-token\", nil)\n\trec := get(t, srv, \"/projects\", \"\")\n\tvar body map[string]string\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"401 body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif body[\"error\"] == \"\" {\n\t\tt.Errorf(\"401 body = %v, want an error envelope\", body)\n\t}\n\tif strings.Contains(rec.Body.String(), \"sekrit-token\") {\n\t\tt.Errorf(\"401 body echoes the token: %s\", rec.Body.String())\n\t}\n}\n\n// TestTokenMatchesConstantTimeCompare: the comparison goes through\n// crypto/subtle.ConstantTimeCompare (the value path) once the length\n// matches — asserted structurally by pinning the accept/reject behavior at\n// the tokenMatches level, the function the middleware uses.\nfunc TestTokenMatchesConstantTimeCompare(t *testing.T) {\n\treq := httptest.NewRequest(http.MethodGet, \"/\", nil)\n\treq.Header.Set(\"Authorization\", \"Bearer correct-horse\")\n\tif !tokenMatches(req, \"correct-horse\") {\n\t\tt.Error(\"tokenMatches with the right token = false, want true\")\n\t}\n\treq.Header.Set(\"Authorization\", \"Bearer correct-horsf\") // same length, wrong value\n\tif tokenMatches(req, \"correct-horse\") {\n\t\tt.Error(\"tokenMatches with a same-length wrong token = true, want false\")\n\t}\n\treq.Header.Set(\"Authorization\", \"Bearer short\")\n\tif tokenMatches(req, \"correct-horse\") {\n\t\tt.Error(\"tokenMatches with a different-length token = true, want false\")\n\t}\n\treq.Header.Set(\"Authorization\", \"Basic correct-horse\")\n\tif tokenMatches(req, \"correct-horse\") {\n\t\tt.Error(\"tokenMatches with a non-Bearer scheme = true, want false\")\n\t}\n}\n\n// TestIsLoopback pins the binding classification: 127.0.0.0/8, ::1 and\n// localhost are loopback; everything else — including the empty host (binds\n// all interfaces) — is not.\nfunc TestIsLoopback(t *testing.T) {\n\tfor _, host := range []string{\"127.0.0.1\", \"127.0.0.0\", \"127.99.99.99\", \"::1\", \"localhost\"} {\n\t\tif !IsLoopback(host) {\n\t\t\tt.Errorf(\"IsLoopback(%q) = false, want true\", host)\n\t\t}\n\t}\n\tfor _, host := range []string{\"\", \"0.0.0.0\", \"::\", \"192.168.1.10\", \"10.0.0.5\", \"example.com\", \"2001:db8::1\"} {\n\t\tif IsLoopback(host) {\n\t\t\tt.Errorf(\"IsLoopback(%q) = true, want false\", host)\n\t\t}\n\t}\n}\n\n// TestValidateStartupPins the hard invariant: a non-loopback bind without a\n// token refuses to start; a token (or a loopback bind) permits it. There is\n// no flag that turns the refusal off — only a token or a loopback bind.\nfunc TestValidateStartupPins(t *testing.T) {\n\tif err := ValidateStartup(\"0.0.0.0\", \"\"); err == nil {\n\t\tt.Error(\"ValidateStartup(0.0.0.0, no token) = nil, want refusal\")\n\t}\n\tif err := ValidateStartup(\"192.168.1.10\", \"\"); err == nil {\n\t\tt.Error(\"ValidateStartup(non-loopback, no token) = nil, want refusal\")\n\t}\n\tif err := ValidateStartup(\"2001:db8::1\", \"\"); err == nil {\n\t\tt.Error(\"ValidateStartup(non-loopback IPv6, no token) = nil, want refusal\")\n\t}\n\tif err := ValidateStartup(\"0.0.0.0\", \"some-token\"); err != nil {\n\t\tt.Errorf(\"ValidateStartup(0.0.0.0, token) = %v, want nil\", err)\n\t}\n\tif err := ValidateStartup(\"127.0.0.1\", \"\"); err != nil {\n\t\tt.Errorf(\"ValidateStartup(127.0.0.1, no token) = %v, want nil\", err)\n\t}\n\tif err := ValidateStartup(\"::1\", \"\"); err != nil {\n\t\tt.Errorf(\"ValidateStartup(::1, no token) = %v, want nil\", err)\n\t}\n\tif err := ValidateStartup(\"localhost\", \"\"); err != nil {\n\t\tt.Errorf(\"ValidateStartup(localhost, no token) = %v, want nil\", err)\n\t}\n}\n","numLines":155,"startLine":1,"totalLines":155}}}
