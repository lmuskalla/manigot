{"type":"tool_use","timestamp":1787938728807,"sessionID":"ses_fb68c3d29ffeIO0HMfdSuVup5i","part":{"type":"tool","tool":"read","callID":"call_28c4f2f34ef640a588d419a1","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/api_test.go"},"output":"<path>/workspace/src/internal/serve/api_test.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"encoding/json\"\n5: \t\"net/http\"\n6: \t\"os\"\n7: \t\"path/filepath\"\n8: \t\"strings\"\n9: \t\"testing\"\n10: \n11: \t\"github.com/lmuskalla/manigot/internal/job\"\n12: )\n13: \n14: // fakeJobProject creates a project root at a temp dir with a job dir\n15: // docs/jobs/<name>/ carrying a brief.md with the given content, plus the\n16: // named extra files (each written with a one-line body). Returns the root.\n17: func fakeJobProject(t *testing.T, name, brief string, extraFiles ...string) string {\n18: \tt.Helper()\n19: \troot := t.TempDir()\n20: \tjobDir := filepath.Join(root, \"docs\", \"jobs\", name)\n21: \tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n22: \t\tt.Fatal(err)\n23: \t}\n24: \tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n25: \t\tt.Fatal(err)\n26: \t}\n27: \tfor _, f := range extraFiles {\n28: \t\tif err := os.WriteFile(filepath.Join(jobDir, f), []byte(\"content of \"+f+\"\\n\"), 0o644); err != nil {\n29: \t\t\tt.Fatal(err)\n30: \t\t}\n31: \t}\n32: \treturn root\n33: }\n34: \n35: // minimalBrief returns a brief.md body with the given frontmatter fields.\n36: func minimalBrief(title, id, status, typ, date string) string {\n37: \treturn \"# Brief: \" + title + \"\\n\\n\" +\n38: \t\t\"status: \" + status + \"\\n\" +\n39: \t\t\"type: \" + typ + \"\\n\" +\n40: \t\t\"id: \" + id + \"\\n\" +\n41: \t\t\"date: \" + date + \"\\n\" +\n42: \t\t\"author: Test\\n\\n## What\\n\\nA test job.\\n\"\n43: }\n44: \n45: // TestHandleProjectsListsRegisteredRoots: /projects returns the registry data\n46: // — each root's absolute path and base name — and nothing else.\n47: func TestHandleProjectsListsRegisteredRoots(t *testing.T) {\n48: \troot := t.TempDir()\n49: \treg := &Registry{projects: []string{filepath.Clean(root)}}\n50: \tsrv := New(reg, \"test-version\", \"\", nil)\n51: \n52: \trec := get(t, srv, \"/projects\", \"\")\n53: \tif rec.Code != http.StatusOK {\n54: \t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n55: \t}\n56: \tvar body struct {\n57: \t\tProjects []projectRow `json:\"projects\"`\n58: \t}\n59: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n60: \t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n61: \t}\n62: \tif len(body.Projects) != 1 {\n63: \t\tt.Fatalf(\"projects = %v, want 1\", body.Projects)\n64: \t}\n65: \tif body.Projects[0].Path != filepath.Clean(root) || body.Projects[0].Name != filepath.Base(root) {\n66: \t\tt.Errorf(\"project row = %+v, want path=%s name=%s\", body.Projects[0], filepath.Clean(root), filepath.Base(root))\n67: \t}\n68: }\n69: \n70: // TestHandleProjectsEmptyRegistry: an empty registry lists no projects — a\n71: // valid, normal response.\n72: func TestHandleProjectsEmptyRegistry(t *testing.T) {\n73: \tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n74: \trec := get(t, srv, \"/projects\", \"\")\n75: \tif rec.Code != http.StatusOK {\n76: \t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n77: \t}\n78: \tif !strings.Contains(rec.Body.String(), `\"projects\":[]`) {\n79: \t\tt.Errorf(\"body = %s, want an empty projects list\", rec.Body.String())\n80: \t}\n81: }\n82: \n83: // TestHandleProjectJobsInfoDesign: one row per job in Discover's sort order\n84: // (date descending), carrying the TUI's info-design fields: id / status /\n85: // stage / type / date / title.\n86: func TestHandleProjectJobsInfoDesign(t *testing.T) {\n87: \troot := fakeJobProject(t, \"older_job\", minimalBrief(\"Older\", \"old\", \"open\", \"feature\", \"2026-08-01\"), \"tasks.md\")\n88: \t_ = fakeJobProjectInto(t, root, \"newer_job\", minimalBrief(\"Newer\", \"new\", \"open\", \"fix\", \"2026-08-10\"), \"tasks.md\", \"implementation.md\")\n89: \n90: \treg := &Registry{projects: []string{filepath.Clean(root)}}\n91: \tsrv := New(reg, \"test-version\", \"\", nil)\n92: \n93: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs\", \"\")\n94: \tif rec.Code != http.StatusOK {\n95: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n96: \t}\n97: \tvar body struct {\n98: \t\tJobs []jobRow `json:\"jobs\"`\n99: \t}\n100: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n101: \t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n102: \t}\n103: \tif len(body.Jobs) != 2 {\n104: \t\tt.Fatalf(\"jobs = %d, want 2:\\n%s\", len(body.Jobs), rec.Body.String())\n105: \t}\n106: \n107: \t// Newest first: \"newer_job\" (2026-08-10) before \"older_job\" (2026-08-01).\n108: \tfirst := body.Jobs[0]\n109: \tif first.Name != \"newer_job\" {\n110: \t\tt.Errorf(\"first job = %q, want newer_job (date-sorted)\", first.Name)\n111: \t}\n112: \tif first.ID != \"new\" || first.Status != \"open\" || first.Type != \"fix\" || first.Date != \"2026-08-10\" || first.Title != \"Newer\" {\n113: \t\tt.Errorf(\"newer_job row = %+v, want the brief's frontmatter fields\", first)\n114: \t}\n115: \t// newer_job has implementation.md but no verdict → stage review.\n116: \tif first.Stage != \"review\" {\n117: \t\tt.Errorf(\"newer_job stage = %q, want review\", first.Stage)\n118: \t}\n119: \t// older_job has tasks.md but no implementation.md → stage implement.\n120: \tsecond := body.Jobs[1]\n121: \tif second.Name != \"older_job\" || second.Stage != \"implement\" {\n122: \t\tt.Errorf(\"older_job row = %+v, want name=older_job stage=implement\", second)\n123: \t}\n124: }\n125: \n126: // fakeJobProjectInto adds another job dir into an existing project root —\n127: // the second half of a two-job project (fakeJobProject creates its own root).\n128: func fakeJobProjectInto(t *testing.T, root, name, brief string, extraFiles ...string) string {\n129: \tt.Helper()\n130: \tjobDir := filepath.Join(root, \"docs\", \"jobs\", name)\n131: \tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n132: \t\tt.Fatal(err)\n133: \t}\n134: \tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n135: \t\tt.Fatal(err)\n136: \t}\n137: \tfor _, f := range extraFiles {\n138: \t\tif err := os.WriteFile(filepath.Join(jobDir, f), []byte(\"content of \"+f+\"\\n\"), 0o644); err != nil {\n139: \t\t\tt.Fatal(err)\n140: \t\t}\n141: \t}\n142: \treturn root\n143: }\n144: \n145: // TestHandleProjectJobsJDIState: a job with a mg-jdi status sidecar carries\n146: // its state/agent/updated in the row; one without carries no jdi field.\n147: func TestHandleProjectJobsJDIState(t *testing.T) {\n148: \troot := fakeJobProject(t, \"driven_job\", minimalBrief(\"Driven\", \"drv\", \"open\", \"feature\", \"2026-08-01\"))\n149: \n150: \t// Write a jdi status sidecar for the job (job.WriteJDIStatus).\n151: \tif err := writeJDIStatusForTest(t, root, \"driven_job\"); err != nil {\n152: \t\tt.Fatal(err)\n153: \t}\n154: \n155: \treg := &Registry{projects: []string{filepath.Clean(root)}}\n156: \tsrv := New(reg, \"test-version\", \"\", nil)\n157: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs\", \"\")\n158: \tif rec.Code != http.StatusOK {\n159: \t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n160: \t}\n161: \tvar body struct {\n162: \t\tJobs []jobRow `json:\"jobs\"`\n163: \t}\n164: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n165: \t\tt.Fatalf(\"body not JSON: %v\", err)\n166: \t}\n167: \tif len(body.Jobs) != 1 || body.Jobs[0].JDI == nil {\n168: \t\tt.Fatalf(\"jdi state missing: %s\", rec.Body.String())\n169: \t}\n170: \tif body.Jobs[0].JDI.State != \"stopped:finished\" || body.Jobs[0].JDI.Agent != \"reviewer\" {\n171: \t\tt.Errorf(\"jdi row = %+v, want the written sidecar state\", body.Jobs[0].JDI)\n172: \t}\n173: \tif body.Jobs[0].JDI.Updated == \"\" {\n174: \t\tt.Errorf(\"jdi row updated = empty, want RFC3339\")\n175: \t}\n176: }\n177: \n178: // TestHandleProjectJobsNoJDIState: a job mg-jdi never drove has no jdi field\n179: // in its row.\n180: func TestHandleProjectJobsNoJDIState(t *testing.T) {\n181: \troot := fakeJobProject(t, \"plain_job\", minimalBrief(\"Plain\", \"pln\", \"open\", \"feature\", \"2026-08-01\"))\n182: \tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n183: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs\", \"\")\n184: \tvar body struct {\n185: \t\tJobs []jobRow `json:\"jobs\"`\n186: \t}\n187: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n188: \t\tt.Fatalf(\"body not JSON: %v\", err)\n189: \t}\n190: \tif len(body.Jobs) != 1 || body.Jobs[0].JDI != nil {\n191: \t\tt.Errorf(\"job row = %+v, want nil jdi for an undriven job\", body.Jobs[0])\n192: \t}\n193: }\n194: \n195: // TestHandleJobFileServesRawMarkdown: a whitelisted file comes back as raw\n196: // markdown text with the markdown content type.\n197: func TestHandleJobFileServesRawMarkdown(t *testing.T) {\n198: \troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"), \"tasks.md\")\n199: \tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n200: \n201: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/some_job/files/brief.md\", \"\")\n202: \tif rec.Code != http.StatusOK {\n203: \t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n204: \t}\n205: \tif ct := rec.Header().Get(\"Content-Type\"); !strings.HasPrefix(ct, \"text/markdown\") {\n206: \t\tt.Errorf(\"Content-Type = %q, want text/markdown\", ct)\n207: \t}\n208: \tif !strings.Contains(rec.Body.String(), \"# Brief: Some\") {\n209: \t\tt.Errorf(\"body = %q, want the raw brief content\", rec.Body.String())\n210: \t}\n211: }\n212: \n213: // TestHandleJobFileMissingIs404: a whitelisted file that has not been written\n214: // yet (e.g. verdict.md before review) is a normal 404, not an error.\n215: func TestHandleJobFileMissingIs404(t *testing.T) {\n216: \troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"))\n217: \tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n218: \tif rec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/some_job/files/verdict.md\", \"\"); rec.Code != http.StatusNotFound {\n219: \t\tt.Errorf(\"missing verdict.md: status = %d, want 404\", rec.Code)\n220: \t}\n221: }\n222: \n223: // TestHandleJobFileNonWhitelistedIs404: the file whitelist (brief|tasks|\n224: // implementation|verdict) is airtight — a session.log, an encoded traversal,\n225: // or any other file under the job dir is never served. (Raw `..` segments in\n226: // the URL path never even reach the handler — ServeMux's own path\n227: // sanitization redirects them — so the encoded forms are the ones that must\n228: // be rejected here.)\n229: func TestHandleJobFileNonWhitelistedIs404(t *testing.T) {\n230: \troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"), \"session.log\")\n231: \tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n232: \n233: \tfor _, file := range []string{\"session.log\", \"run.log\", \"brief\", \"README.md\", \"..%2fbrief.md\", \"..%2f..%2fetc%2fpasswd\", \"%2e%2e%2fbrief.md\", \"brief.md%00\"} {\n234: \t\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/some_job/files/\"+file, \"\")\n235: \t\tif rec.Code != http.StatusNotFound {\n236: \t\t\tt.Errorf(\"file %q: status = %d, want 404\", file, rec.Code)\n237: \t\t}\n238: \t}\n239: \n240: \t// Raw `..` in the path is redirected by ServeMux's sanitization — still\n241: \t// never served, never read.\n242: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/some_job/files/../brief.md\", \"\")\n243: \tif rec.Code < 300 || rec.Code >= 400 {\n244: \t\tt.Errorf(\"raw .. file segment: status = %d, want a 3xx sanitization redirect\", rec.Code)\n245: \t}\n246: }\n247: \n248: // TestHandleProjectJobsUnknownProjectIs404: an unregistered project segment\n249: // (and an invalid one) is a 404 — nothing is ever resolved outside the\n250: // registry. Encoded traversal reaches the handler and is rejected there; raw\n251: // `..` is redirected by ServeMux's own sanitization first.\n252: func TestHandleProjectJobsUnknownProjectIs404(t *testing.T) {\n253: \troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"))\n254: \tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n255: \n256: \tfor _, seg := range []string{\"no-such-project\", \"%2e%2e\", \"%2e\", \"%2fetc\", \"a%2fb\", \"a%5cb\", \"a%00b\", \"..%2f..%2fetc%2fpasswd\"} {\n257: \t\trec := get(t, srv, \"/projects/\"+seg+\"/jobs\", \"\")\n258: \t\tif rec.Code != http.StatusNotFound {\n259: \t\t\tt.Errorf(\"project segment %q: status = %d, want 404\", seg, rec.Code)\n260: \t\t}\n261: \t}\n262: \n263: \t// Raw `..` and `.` segments are cleaned to a redirect by ServeMux before\n264: \t// routing — still never resolved against anything.\n265: \tfor _, seg := range []string{\"..\", \".\"} {\n266: \t\trec := get(t, srv, \"/projects/\"+seg+\"/jobs\", \"\")\n267: \t\tif rec.Code < 300 || rec.Code >= 400 {\n268: \t\t\tt.Errorf(\"raw project segment %q: status = %d, want a 3xx sanitization redirect\", seg, rec.Code)\n269: \t\t}\n270: \t}\n271: }\n272: \n273: // TestHandleJobFileUnknownJobIs404: an unknown job segment (no ID, name or\n274: // unique prefix match) is a 404.\n275: func TestHandleJobFileUnknownJobIs404(t *testing.T) {\n276: \troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"))\n277: \tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n278: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/no-such-job/files/brief.md\", \"\")\n279: \tif rec.Code != http.StatusNotFound {\n280: \t\tt.Errorf(\"status = %d, want 404\", rec.Code)\n281: \t}\n282: }\n283: \n284: // TestHandleJobResolvesByIDNameAndPrefix: the job segment resolves by ID,\n285: // then by name, then by unique name prefix.\n286: func TestHandleJobResolvesByIDNameAndPrefix(t *testing.T) {\n287: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n288: \t_ = fakeJobProjectInto(t, root, \"iron_steel\", minimalBrief(\"Steel\", \"irn\", \"open\", \"fix\", \"2026-08-02\"))\n289: \tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n290: \n291: \tbase := \"/projects/\" + filepath.Base(root) + \"/jobs/\"\n292: \tfor _, seg := range []string{\"wod\", \"wood_oak\", \"wood\", \"iron\", \"irn\"} {\n293: \t\trec := get(t, srv, base+seg+\"/files/brief.md\", \"\")\n294: \t\tif rec.Code != http.StatusOK {\n295: \t\t\tt.Errorf(\"job segment %q: status = %d, want 200 (body %s)\", seg, rec.Code, rec.Body.String())\n296: \t\t}\n297: \t}\n298: }\n299: \n300: // TestHandleJobAmbiguousPrefixIs409: a job segment matching several job names\n301: // by prefix is a 409 with the CLI's ambiguity wording.\n302: func TestHandleJobAmbiguousPrefixIs409(t *testing.T) {\n303: \troot := fakeJobProject(t, \"wood_a\", minimalBrief(\"A\", \"aaa\", \"open\", \"feature\", \"2026-08-01\"))\n304: \t_ = fakeJobProjectInto(t, root, \"wood_b\", minimalBrief(\"B\", \"bbb\", \"open\", \"feature\", \"2026-08-02\"))\n305: \tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n306: \n307: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/wood/files/brief.md\", \"\")\n308: \tif rec.Code != http.StatusConflict {\n309: \t\tt.Errorf(\"status = %d, want 409 (body %s)\", rec.Code, rec.Body.String())\n310: \t}\n311: \tif !strings.Contains(rec.Body.String(), \"ambiguous\") {\n312: \t\tt.Errorf(\"body = %s, want the ambiguity wording\", rec.Body.String())\n313: \t}\n314: }\n315: \n316: // TestServeShutdownSeam pins the httptest-able serve loop: Serve on a bound\n317: // listener answers requests until Shutdown drains and returns.\n318: func TestServeShutdownSeam(t *testing.T) {\n319: \tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n320: \tln, err := netListen(\"127.0.0.1:0\")\n321: \tif err != nil {\n322: \t\tt.Fatal(err)\n323: \t}\n324: \tdone := make(chan error, 1)\n325: \tgo func() { done <- srv.Serve(ln) }()\n326: \n327: \t// The server answers on the bound listener.\n328: \tbase := \"http://\" + ln.Addr().String()\n329: \tresp, err := httpGet(base + \"/projects\")\n330: \tif err != nil {\n331: \t\tt.Fatalf(\"GET before shutdown: %v\", err)\n332: \t}\n333: \tresp.Body.Close()\n334: \tif resp.StatusCode != http.StatusOK {\n335: \t\tt.Errorf(\"status = %d, want 200\", resp.StatusCode)\n336: \t}\n337: \n338: \t// Shutdown drains and the serve loop returns http.ErrServerClosed.\n339: \tif err := srv.Shutdown(t.Context()); err != nil {\n340: \t\tt.Fatalf(\"Shutdown: %v\", err)\n341: \t}\n342: \tif err := <-done; err != nil && err != http.ErrServerClosed {\n343: \t\tt.Errorf(\"Serve returned %v, want ErrServerClosed\", err)\n344: \t}\n345: }\n346: \n347: // --- TASK-4: jdi / diff / agents endpoints ----------------------------------\n348: \n349: // TestHandleJobJDIStatusAndLogs: the jdi endpoint serves the mg-jdi status\n350: // sidecar, the run.log tail, and the job's session.log tail.\n351: func TestHandleJobJDIStatusAndLogs(t *testing.T) {\n352: \troot := fakeJobProject(t, \"driven_job\", minimalBrief(\"Driven\", \"drv\", \"open\", \"feature\", \"2026-08-01\"))\n353: \tif err := writeJDIStatusForTest(t, root, \"driven_job\"); err != nil {\n354: \t\tt.Fatal(err)\n355: \t}\n356: \t// run.log under .manigot/jdi-status/<name>/.\n357: \tlogDir := job.JDIStatusDir(root, \"driven_job\")\n358: \tif err := os.MkdirAll(logDir, 0o755); err != nil {\n359: \t\tt.Fatal(err)\n360: \t}\n361: \tif err := os.WriteFile(job.JDIRunLogPath(root, \"driven_job\"), []byte(\"run log line\\n\"), 0o644); err != nil {\n362: \t\tt.Fatal(err)\n363: \t}\n364: \t// session.log in the job's own dir.\n365: \tif err := os.WriteFile(filepath.Join(root, \"docs\", \"jobs\", \"driven_job\", \"session.log\"), []byte(\"session log line\\n\"), 0o644); err != nil {\n366: \t\tt.Fatal(err)\n367: \t}\n368: \n369: \tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n370: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/driven_job/jdi\", \"\")\n371: \tif rec.Code != http.StatusOK {\n372: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n373: \t}\n374: \tvar body jobJDIResponse\n375: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n376: \t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n377: \t}\n378: \tif body.Status == nil || body.Status.State != \"stopped:finished\" || body.Status.Agent != \"reviewer\" {\n379: \t\tt.Errorf(\"status = %+v, want the written sidecar\", body.Status)\n380: \t}\n381: \tif body.RunLog == nil || !strings.Contains(*body.RunLog, \"run log line\") {\n382: \t\tt.Errorf(\"runLog = %v, want the run.log tail\", body.RunLog)\n383: \t}\n384: \tif body.SessionLog == nil || !strings.Contains(*body.SessionLog, \"session log line\") {\n385: \t\tt.Errorf(\"sessionLog = %v, want the session.log tail\", body.SessionLog)\n386: \t}\n387: }\n388: \n389: // TestHandleJobJDIUndrivenJobIsNulls: a job mg-jdi never drove returns nulls\n390: // (no status, no run.log, no session.log) — a normal \"no run yet\", not an\n391: // error.\n392: func TestHandleJobJDIUndrivenJobIsNulls(t *testing.T) {\n393: \troot := fakeJobProject(t, \"plain_job\", minimalBrief(\"Plain\", \"pln\", \"open\", \"feature\", \"2026-08-01\"))\n394: \tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n395: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/plain_job/jdi\", \"\")\n396: \tif rec.Code != http.StatusOK {\n397: \t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n398: \t}\n399: \tvar body jobJDIResponse\n400: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n401: \t\tt.Fatalf(\"body not JSON: %v\", err)\n402: \t}\n403: \tif body.Status != nil || body.RunLog != nil || body.SessionLog != nil {\n404: \t\tt.Errorf(\"undriven job = %+v, want all-null fields\", body)\n405: \t}\n406: }\n407: \n408: // TestHandleJobJDIEmptyLogsPresent: an existing-but-empty run.log is \"there is\n409: // a run happening, nothing logged yet\" — an empty string, not null.\n410: func TestHandleJobJDIEmptyLogsPresent(t *testing.T) {\n411: \troot := fakeJobProject(t, \"driven_job\", minimalBrief(\"Driven\", \"drv\", \"open\", \"feature\", \"2026-08-01\"))\n412: \tif err := writeJDIStatusForTest(t, root, \"driven_job\"); err != nil {\n413: \t\tt.Fatal(err)\n414: \t}\n415: \tlogDir := job.JDIStatusDir(root, \"driven_job\")\n416: \tif err := os.MkdirAll(logDir, 0o755); err != nil {\n417: \t\tt.Fatal(err)\n418: \t}\n419: \tif err := os.WriteFile(job.JDIRunLogPath(root, \"driven_job\"), nil, 0o644); err != nil {\n420: \t\tt.Fatal(err)\n421: \t}\n422: \n423: \tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n424: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/driven_job/jdi\", \"\")\n425: \tvar body jobJDIResponse\n426: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n427: \t\tt.Fatalf(\"body not JSON: %v\", err)\n428: \t}\n429: \tif body.RunLog == nil || *body.RunLog != \"\" {\n430: \t\tt.Errorf(\"runLog = %v, want an empty present string\", body.RunLog)\n431: \t}\n432: }\n433: \n434: // TestHandleJobJDIAllMissingStatusNoJDI — the jdi endpoint's job resolution is\n435: // the same choke point: an unknown job is a 404.\n436: func TestHandleJobJDIUnknownJobIs404(t *testing.T) {\n437: \troot := fakeJobProject(t, \"plain_job\", minimalBrief(\"Plain\", \"pln\", \"open\", \"feature\", \"2026-08-01\"))\n438: \tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n439: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/nope/jdi\", \"\")\n440: \tif rec.Code != http.StatusNotFound {\n441: \t\tt.Errorf(\"status = %d, want 404\", rec.Code)\n442: \t}\n443: }\n444: \n445: // TestHandleJobDiffQuickEyeball: the diff endpoint returns the quick eyeball\n446: // (log + stat) for the resolved job branch against the base branch — the same\n447: // two calls mg diff makes. Needs a real git repo (PATH restricted to real\n448: // git, since the session shim refuses git init).\n449: func TestHandleJobDiffQuickEyeball(t *testing.T) {\n450: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n451: \tdir := initGitRepo(t)\n452: \trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n453: \tif err := os.WriteFile(filepath.Join(dir, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n454: \t\tt.Fatal(err)\n455: \t}\n456: \trunGitT(t, dir, \"add\", \"feature.txt\")\n457: \trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"add the feature\")\n458: \trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n459: \n460: \tsrv := New(&Registry{projects: []string{filepath.Clean(dir)}}, \"test-version\", \"\", nil)\n461: \trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/wood_test/diff\", \"\")\n462: \tif rec.Code != http.StatusOK {\n463: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n464: \t}\n465: \tvar body jobDiffResponse\n466: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n467: \t\tt.Fatalf(\"body not JSON: %v\", err)\n468: \t}\n469: \tif body.Log == nil || !strings.Contains(*body.Log, \"add the feature\") {\n470: \t\tt.Errorf(\"log = %v, want the branch's commit\", body.Log)\n471: \t}\n472: \tif body.Stat == nil || !strings.Contains(*body.Stat, \"feature.txt\") {\n473: \t\tt.Errorf(\"stat = %v, want the changed file\", body.Stat)\n474: \t}\n475: \tif body.Patch != nil {\n476: \t\tt.Errorf(\"patch = %v, want nil for the quick eyeball\", body.Patch)\n477: \t}\n478: }\n479: \n480: // TestHandleJobDiffFullPatch: ?full=1 returns the complete patch.\n481: func TestHandleJobDiffFullPatch(t *testing.T) {\n482: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n483: \tdir := initGitRepo(t)\n484: \trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n485: \tif err := os.WriteFile(filepath.Join(dir, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n486: \t\tt.Fatal(err)\n487: \t}\n488: \trunGitT(t, dir, \"add\", \"feature.txt\")\n489: \trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"add the feature\")\n490: \trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n491: \n492: \tsrv := New(&Registry{projects: []string{filepath.Clean(dir)}}, \"test-version\", \"\", nil)\n493: \trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/wood_test/diff?full=1\", \"\")\n494: \tif rec.Code != http.StatusOK {\n495: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n496: \t}\n497: \tvar body jobDiffResponse\n498: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n499: \t\tt.Fatalf(\"body not JSON: %v\", err)\n500: \t}\n501: \tif body.Patch == nil || !strings.Contains(*body.Patch, \"+feature\") {\n502: \t\tt.Errorf(\"patch = %v, want the full patch\", body.Patch)\n503: \t}\n504: \tif body.Log != nil || body.Stat != nil {\n505: \t\tt.Errorf(\"log/stat = %v/%v, want nil for ?full=1\", body.Log, body.Stat)\n506: \t}\n507: }\n508: \n509: // TestHandleJobDiffResolvesBaseBranchFromConfig: the base branch comes from\n510: // the project's configured baseBranch (project.Load), exactly as mg diff\n511: // resolves it — proven by a repo where main and the configured base differ,\n512: // so the wrong base would show an extra commit.\n513: func TestHandleJobDiffResolvesBaseBranchFromConfig(t *testing.T) {\n514: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n515: \tdir := initGitRepo(t)\n516: \t// trunk = main + one extra commit; baseBranch is configured to trunk.\n517: \trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"trunk\")\n518: \tif err := os.WriteFile(filepath.Join(dir, \"trunk.txt\"), []byte(\"trunk\\n\"), 0o644); err != nil {\n519: \t\tt.Fatal(err)\n520: \t}\n521: \trunGitT(t, dir, \"add\", \"trunk.txt\")\n522: \trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"trunk work\")\n523: \t// The job branch is cut from trunk and adds one commit of its own.\n524: \trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n525: \tif err := os.WriteFile(filepath.Join(dir, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n526: \t\tt.Fatal(err)\n527: \t}\n528: \trunGitT(t, dir, \"add\", \"feature.txt\")\n529: \trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"job work\")\n530: \trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n531: \t// Configure baseBranch=trunk.\n532: \tif err := os.MkdirAll(filepath.Join(dir, \".manigot\"), 0o755); err != nil {\n533: \t\tt.Fatal(err)\n534: \t}\n535: \tif err := os.WriteFile(filepath.Join(dir, \".manigot\", \"manigot.json\"), []byte(`{\"baseBranch\": \"trunk\"}`), 0o644); err != nil {\n536: \t\tt.Fatal(err)\n537: \t}\n538: \n539: \tsrv := New(&Registry{projects: []string{filepath.Clean(dir)}}, \"test-version\", \"\", nil)\n540: \trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/wood_test/diff\", \"\")\n541: \tif rec.Code != http.StatusOK {\n542: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n543: \t}\n544: \tvar body jobDiffResponse\n545: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n546: \t\tt.Fatalf(\"body not JSON: %v\", err)\n547: \t}\n548: \t// Only the job's own commit — had the base fallen back to main, the\n549: \t// trunk commit would appear too.\n550: \tif body.Log == nil || strings.Contains(*body.Log, \"trunk work\") || !strings.Contains(*body.Log, \"job work\") {\n551: \t\tt.Errorf(\"log = %v, want only the job's commit against base trunk\", body.Log)\n552: \t}\n553: }\n554: \n555: // TestHandleJobDiffUnknownJobIs404: an unresolvable job segment is a 404 with\n556: // the CLI's not-found wording.\n557: func TestHandleJobDiffUnknownJobIs404(t *testing.T) {\n558: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n559: \tdir := initGitRepo(t)\n560: \tsrv := New(&Registry{projects: []string{filepath.Clean(dir)}}, \"test-version\", \"\", nil)\n561: \trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/nope/diff\", \"\")\n562: \tif rec.Code != http.StatusNotFound {\n563: \t\tt.Errorf(\"status = %d, want 404 (body %s)\", rec.Code, rec.Body.String())\n564: \t}\n565: \tif !strings.Contains(rec.Body.String(), \"not found among local branches\") {\n566: \t\tt.Errorf(\"body = %s, want the CLI's not-found wording\", rec.Body.String())\n567: \t}\n568: }\n569: \n570: // TestHandleJobDiffAmbiguousIs409: a job segment matching several branches by\n571: // prefix is a 409 with the CLI's ambiguity wording.\n572: func TestHandleJobDiffAmbiguousIs409(t *testing.T) {\n573: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n574: \tdir := initGitRepo(t)\n575: \trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_a\")\n576: \trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n577: \trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_b\")\n578: \trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n579: \n580: \tsrv := New(&Registry{projects: []string{filepath.Clean(dir)}}, \"test-version\", \"\", nil)\n581: \trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/wood/diff\", \"\")\n582: \tif rec.Code != http.StatusConflict {\n583: \t\tt.Errorf(\"status = %d, want 409 (body %s)\", rec.Code, rec.Body.String())\n584: \t}\n585: \tif !strings.Contains(rec.Body.String(), \"ambiguous\") {\n586: \t\tt.Errorf(\"body = %s, want the CLI's ambiguity wording\", rec.Body.String())\n587: \t}\n588: }\n589: \n590: // TestHandleProjectAgentsNameAndDescription: the agents endpoint lists name +\n591: // description only, from the same agentlist.Discover the mg agents picker\n592: // uses.\n593: func TestHandleProjectAgentsNameAndDescription(t *testing.T) {\n594: \tfakeCheckout(t, map[string]string{\n595: \t\t\"analyst\":  \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n596: \t\t\"reviewer\": \"name: reviewer\\ndescription: Reviews changes.\\n\",\n597: \t})\n598: \troot := t.TempDir() // no docs/ needed — agents are global\n599: \tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n600: \n601: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/agents\", \"\")\n602: \tif rec.Code != http.StatusOK {\n603: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n604: \t}\n605: \tvar body agentsResponse\n606: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n607: \t\tt.Fatalf(\"body not JSON: %v\", err)\n608: \t}\n609: \tif len(body.Agents) != 2 {\n610: \t\tt.Fatalf(\"agents = %d, want 2:\\n%s\", len(body.Agents), rec.Body.String())\n611: \t}\n612: \t// Sorted by name: analyst first.\n613: \tif body.Agents[0].Name != \"analyst\" || !strings.Contains(body.Agents[0].Description, \"tasks\") {\n614: \t\tt.Errorf(\"agent[0] = %+v, want analyst with its description\", body.Agents[0])\n615: \t}\n616: \tif body.Agents[1].Name != \"reviewer\" {\n617: \t\tt.Errorf(\"agent[1] = %+v, want reviewer\", body.Agents[1])\n618: \t}\n619: \t// No full agent-file contents leak into the response.\n620: \tif strings.Contains(rec.Body.String(), \"name: analyst\") {\n621: \t\tt.Errorf(\"response leaks the raw agent file: %s\", rec.Body.String())\n622: \t}\n623: }\n624: \n625: // --- TASK-5: /health ---------------------------------------------------------\n626: \n627: // TestHandleHealthReportsVersionImageAndProfiles: /health reports the version,\n628: // docker image presence, and per-profile readiness — identifiers and booleans\n629: // only, never credential values. The docker presence and readiness booleans\n630: // depend on the machine the test runs on (session.ImagePresent degrades to\n631: // false when docker is missing; profile readiness is an env read), so the\n632: // shape — every profile present, every field present — is what is pinned.\n633: func TestHandleHealthReportsVersionImageAndProfiles(t *testing.T) {\n634: \tsrv := New(&Registry{}, \"1.2.3-test\", \"\", nil)\n635: \trec := get(t, srv, \"/health\", \"\")\n636: \tif rec.Code != http.StatusOK {\n637: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n638: \t}\n639: \tvar body healthResponse\n640: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n641: \t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n642: \t}\n643: \tif body.Version != \"1.2.3-test\" {\n644: \t\tt.Errorf(\"version = %q, want the version passed into New\", body.Version)\n645: \t}\n646: \t// imagePresent must be a real boolean (present in the JSON), whatever its\n647: \t// value on this machine.\n648: \tvar raw map[string]json.RawMessage\n649: \tif err := json.Unmarshal(rec.Body.Bytes(), &raw); err != nil {\n650: \t\tt.Fatal(err)\n651: \t}\n652: \tif _, ok := raw[\"imagePresent\"]; !ok {\n653: \t\tt.Errorf(\"imagePresent missing from /health: %s\", rec.Body.String())\n654: \t}\n655: \n656: \tif len(body.Profiles) != 5 {\n657: \t\tt.Fatalf(\"profiles = %d, want 5 (claude-pro, zai, opencode-go, opencode-zen, opencode-zen-free):\\n%s\",\n658: \t\t\tlen(body.Profiles), rec.Body.String())\n659: \t}\n660: \tseen := map[string]bool{}\n661: \tfor _, p := range body.Profiles {\n662: \t\tif p.ID == \"\" {\n663: \t\t\tt.Errorf(\"profile row with empty id: %+v\", p)\n664: \t\t}\n665: \t\tseen[p.ID] = true\n666: \t}\n667: \tfor _, id := range []string{\"claude-pro\", \"zai\", \"opencode-go\", \"opencode-zen\", \"opencode-zen-free\"} {\n668: \t\tif !seen[id] {\n669: \t\t\tt.Errorf(\"profile %q missing from /health\", id)\n670: \t\t}\n671: \t}\n672: }\n673: \n674: // TestHandleHealthRequiresAuth: /health is inside the same auth boundary as\n675: // every other endpoint — with a token configured, it is a 401 without one.\n676: func TestHandleHealthRequiresAuth(t *testing.T) {\n677: \tsrv := New(&Registry{}, \"1.2.3-test\", \"sekrit-token\", nil)\n678: \tif rec := get(t, srv, \"/health\", \"\"); rec.Code != http.StatusUnauthorized {\n679: \t\tt.Errorf(\"no token: status = %d, want 401\", rec.Code)\n680: \t}\n681: \tif rec := get(t, srv, \"/health\", \"Bearer sekrit-token\"); rec.Code != http.StatusOK {\n682: \t\tt.Errorf(\"with token: status = %d, want 200\", rec.Code)\n683: \t}\n684: }\n\n(End of file - total 684 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// fakeJobProject creates a project root at a temp dir with a job dir\n// docs/jobs/<name>/ carrying a brief.md with the given content, plus the\n// named extra files (each written with a one-line body). Returns the root.\nfunc fakeJobProject(t *testing.T, name, brief string, extraFiles ...string) string {\n\tt.Helper()\n\troot := t.TempDir()\n\tjobDir := filepath.Join(root, \"docs\", \"jobs\", name)","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/api_test.go","text":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// fakeJobProject creates a project root at a temp dir with a job dir\n// docs/jobs/<name>/ carrying a brief.md with the given content, plus the\n// named extra files (each written with a one-line body). Returns the root.\nfunc fakeJobProject(t *testing.T, name, brief string, extraFiles ...string) string {\n\tt.Helper()\n\troot := t.TempDir()\n\tjobDir := filepath.Join(root, \"docs\", \"jobs\", name)\n\tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, f := range extraFiles {\n\t\tif err := os.WriteFile(filepath.Join(jobDir, f), []byte(\"content of \"+f+\"\\n\"), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\treturn root\n}\n\n// minimalBrief returns a brief.md body with the given frontmatter fields.\nfunc minimalBrief(title, id, status, typ, date string) string {\n\treturn \"# Brief: \" + title + \"\\n\\n\" +\n\t\t\"status: \" + status + \"\\n\" +\n\t\t\"type: \" + typ + \"\\n\" +\n\t\t\"id: \" + id + \"\\n\" +\n\t\t\"date: \" + date + \"\\n\" +\n\t\t\"author: Test\\n\\n## What\\n\\nA test job.\\n\"\n}\n\n// TestHandleProjectsListsRegisteredRoots: /projects returns the registry data\n// — each root's absolute path and base name — and nothing else.\nfunc TestHandleProjectsListsRegisteredRoots(t *testing.T) {\n\troot := t.TempDir()\n\treg := &Registry{projects: []string{filepath.Clean(root)}}\n\tsrv := New(reg, \"test-version\", \"\", nil)\n\n\trec := get(t, srv, \"/projects\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n\t}\n\tvar body struct {\n\t\tProjects []projectRow `json:\"projects\"`\n\t}\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif len(body.Projects) != 1 {\n\t\tt.Fatalf(\"projects = %v, want 1\", body.Projects)\n\t}\n\tif body.Projects[0].Path != filepath.Clean(root) || body.Projects[0].Name != filepath.Base(root) {\n\t\tt.Errorf(\"project row = %+v, want path=%s name=%s\", body.Projects[0], filepath.Clean(root), filepath.Base(root))\n\t}\n}\n\n// TestHandleProjectsEmptyRegistry: an empty registry lists no projects — a\n// valid, normal response.\nfunc TestHandleProjectsEmptyRegistry(t *testing.T) {\n\tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n\t}\n\tif !strings.Contains(rec.Body.String(), `\"projects\":[]`) {\n\t\tt.Errorf(\"body = %s, want an empty projects list\", rec.Body.String())\n\t}\n}\n\n// TestHandleProjectJobsInfoDesign: one row per job in Discover's sort order\n// (date descending), carrying the TUI's info-design fields: id / status /\n// stage / type / date / title.\nfunc TestHandleProjectJobsInfoDesign(t *testing.T) {\n\troot := fakeJobProject(t, \"older_job\", minimalBrief(\"Older\", \"old\", \"open\", \"feature\", \"2026-08-01\"), \"tasks.md\")\n\t_ = fakeJobProjectInto(t, root, \"newer_job\", minimalBrief(\"Newer\", \"new\", \"open\", \"fix\", \"2026-08-10\"), \"tasks.md\", \"implementation.md\")\n\n\treg := &Registry{projects: []string{filepath.Clean(root)}}\n\tsrv := New(reg, \"test-version\", \"\", nil)\n\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body struct {\n\t\tJobs []jobRow `json:\"jobs\"`\n\t}\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif len(body.Jobs) != 2 {\n\t\tt.Fatalf(\"jobs = %d, want 2:\\n%s\", len(body.Jobs), rec.Body.String())\n\t}\n\n\t// Newest first: \"newer_job\" (2026-08-10) before \"older_job\" (2026-08-01).\n\tfirst := body.Jobs[0]\n\tif first.Name != \"newer_job\" {\n\t\tt.Errorf(\"first job = %q, want newer_job (date-sorted)\", first.Name)\n\t}\n\tif first.ID != \"new\" || first.Status != \"open\" || first.Type != \"fix\" || first.Date != \"2026-08-10\" || first.Title != \"Newer\" {\n\t\tt.Errorf(\"newer_job row = %+v, want the brief's frontmatter fields\", first)\n\t}\n\t// newer_job has implementation.md but no verdict → stage review.\n\tif first.Stage != \"review\" {\n\t\tt.Errorf(\"newer_job stage = %q, want review\", first.Stage)\n\t}\n\t// older_job has tasks.md but no implementation.md → stage implement.\n\tsecond := body.Jobs[1]\n\tif second.Name != \"older_job\" || second.Stage != \"implement\" {\n\t\tt.Errorf(\"older_job row = %+v, want name=older_job stage=implement\", second)\n\t}\n}\n\n// fakeJobProjectInto adds another job dir into an existing project root —\n// the second half of a two-job project (fakeJobProject creates its own root).\nfunc fakeJobProjectInto(t *testing.T, root, name, brief string, extraFiles ...string) string {\n\tt.Helper()\n\tjobDir := filepath.Join(root, \"docs\", \"jobs\", name)\n\tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, f := range extraFiles {\n\t\tif err := os.WriteFile(filepath.Join(jobDir, f), []byte(\"content of \"+f+\"\\n\"), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\treturn root\n}\n\n// TestHandleProjectJobsJDIState: a job with a mg-jdi status sidecar carries\n// its state/agent/updated in the row; one without carries no jdi field.\nfunc TestHandleProjectJobsJDIState(t *testing.T) {\n\troot := fakeJobProject(t, \"driven_job\", minimalBrief(\"Driven\", \"drv\", \"open\", \"feature\", \"2026-08-01\"))\n\n\t// Write a jdi status sidecar for the job (job.WriteJDIStatus).\n\tif err := writeJDIStatusForTest(t, root, \"driven_job\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\treg := &Registry{projects: []string{filepath.Clean(root)}}\n\tsrv := New(reg, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n\t}\n\tvar body struct {\n\t\tJobs []jobRow `json:\"jobs\"`\n\t}\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif len(body.Jobs) != 1 || body.Jobs[0].JDI == nil {\n\t\tt.Fatalf(\"jdi state missing: %s\", rec.Body.String())\n\t}\n\tif body.Jobs[0].JDI.State != \"stopped:finished\" || body.Jobs[0].JDI.Agent != \"reviewer\" {\n\t\tt.Errorf(\"jdi row = %+v, want the written sidecar state\", body.Jobs[0].JDI)\n\t}\n\tif body.Jobs[0].JDI.Updated == \"\" {\n\t\tt.Errorf(\"jdi row updated = empty, want RFC3339\")\n\t}\n}\n\n// TestHandleProjectJobsNoJDIState: a job mg-jdi never drove has no jdi field\n// in its row.\nfunc TestHandleProjectJobsNoJDIState(t *testing.T) {\n\troot := fakeJobProject(t, \"plain_job\", minimalBrief(\"Plain\", \"pln\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs\", \"\")\n\tvar body struct {\n\t\tJobs []jobRow `json:\"jobs\"`\n\t}\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif len(body.Jobs) != 1 || body.Jobs[0].JDI != nil {\n\t\tt.Errorf(\"job row = %+v, want nil jdi for an undriven job\", body.Jobs[0])\n\t}\n}\n\n// TestHandleJobFileServesRawMarkdown: a whitelisted file comes back as raw\n// markdown text with the markdown content type.\nfunc TestHandleJobFileServesRawMarkdown(t *testing.T) {\n\troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"), \"tasks.md\")\n\tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/some_job/files/brief.md\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n\t}\n\tif ct := rec.Header().Get(\"Content-Type\"); !strings.HasPrefix(ct, \"text/markdown\") {\n\t\tt.Errorf(\"Content-Type = %q, want text/markdown\", ct)\n\t}\n\tif !strings.Contains(rec.Body.String(), \"# Brief: Some\") {\n\t\tt.Errorf(\"body = %q, want the raw brief content\", rec.Body.String())\n\t}\n}\n\n// TestHandleJobFileMissingIs404: a whitelisted file that has not been written\n// yet (e.g. verdict.md before review) is a normal 404, not an error.\nfunc TestHandleJobFileMissingIs404(t *testing.T) {\n\troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n\tif rec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/some_job/files/verdict.md\", \"\"); rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"missing verdict.md: status = %d, want 404\", rec.Code)\n\t}\n}\n\n// TestHandleJobFileNonWhitelistedIs404: the file whitelist (brief|tasks|\n// implementation|verdict) is airtight — a session.log, an encoded traversal,\n// or any other file under the job dir is never served. (Raw `..` segments in\n// the URL path never even reach the handler — ServeMux's own path\n// sanitization redirects them — so the encoded forms are the ones that must\n// be rejected here.)\nfunc TestHandleJobFileNonWhitelistedIs404(t *testing.T) {\n\troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"), \"session.log\")\n\tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n\n\tfor _, file := range []string{\"session.log\", \"run.log\", \"brief\", \"README.md\", \"..%2fbrief.md\", \"..%2f..%2fetc%2fpasswd\", \"%2e%2e%2fbrief.md\", \"brief.md%00\"} {\n\t\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/some_job/files/\"+file, \"\")\n\t\tif rec.Code != http.StatusNotFound {\n\t\t\tt.Errorf(\"file %q: status = %d, want 404\", file, rec.Code)\n\t\t}\n\t}\n\n\t// Raw `..` in the path is redirected by ServeMux's sanitization — still\n\t// never served, never read.\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/some_job/files/../brief.md\", \"\")\n\tif rec.Code < 300 || rec.Code >= 400 {\n\t\tt.Errorf(\"raw .. file segment: status = %d, want a 3xx sanitization redirect\", rec.Code)\n\t}\n}\n\n// TestHandleProjectJobsUnknownProjectIs404: an unregistered project segment\n// (and an invalid one) is a 404 — nothing is ever resolved outside the\n// registry. Encoded traversal reaches the handler and is rejected there; raw\n// `..` is redirected by ServeMux's own sanitization first.\nfunc TestHandleProjectJobsUnknownProjectIs404(t *testing.T) {\n\troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n\n\tfor _, seg := range []string{\"no-such-project\", \"%2e%2e\", \"%2e\", \"%2fetc\", \"a%2fb\", \"a%5cb\", \"a%00b\", \"..%2f..%2fetc%2fpasswd\"} {\n\t\trec := get(t, srv, \"/projects/\"+seg+\"/jobs\", \"\")\n\t\tif rec.Code != http.StatusNotFound {\n\t\t\tt.Errorf(\"project segment %q: status = %d, want 404\", seg, rec.Code)\n\t\t}\n\t}\n\n\t// Raw `..` and `.` segments are cleaned to a redirect by ServeMux before\n\t// routing — still never resolved against anything.\n\tfor _, seg := range []string{\"..\", \".\"} {\n\t\trec := get(t, srv, \"/projects/\"+seg+\"/jobs\", \"\")\n\t\tif rec.Code < 300 || rec.Code >= 400 {\n\t\t\tt.Errorf(\"raw project segment %q: status = %d, want a 3xx sanitization redirect\", seg, rec.Code)\n\t\t}\n\t}\n}\n\n// TestHandleJobFileUnknownJobIs404: an unknown job segment (no ID, name or\n// unique prefix match) is a 404.\nfunc TestHandleJobFileUnknownJobIs404(t *testing.T) {\n\troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/no-such-job/files/brief.md\", \"\")\n\tif rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"status = %d, want 404\", rec.Code)\n\t}\n}\n\n// TestHandleJobResolvesByIDNameAndPrefix: the job segment resolves by ID,\n// then by name, then by unique name prefix.\nfunc TestHandleJobResolvesByIDNameAndPrefix(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\t_ = fakeJobProjectInto(t, root, \"iron_steel\", minimalBrief(\"Steel\", \"irn\", \"open\", \"fix\", \"2026-08-02\"))\n\tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n\n\tbase := \"/projects/\" + filepath.Base(root) + \"/jobs/\"\n\tfor _, seg := range []string{\"wod\", \"wood_oak\", \"wood\", \"iron\", \"irn\"} {\n\t\trec := get(t, srv, base+seg+\"/files/brief.md\", \"\")\n\t\tif rec.Code != http.StatusOK {\n\t\t\tt.Errorf(\"job segment %q: status = %d, want 200 (body %s)\", seg, rec.Code, rec.Body.String())\n\t\t}\n\t}\n}\n\n// TestHandleJobAmbiguousPrefixIs409: a job segment matching several job names\n// by prefix is a 409 with the CLI's ambiguity wording.\nfunc TestHandleJobAmbiguousPrefixIs409(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_a\", minimalBrief(\"A\", \"aaa\", \"open\", \"feature\", \"2026-08-01\"))\n\t_ = fakeJobProjectInto(t, root, \"wood_b\", minimalBrief(\"B\", \"bbb\", \"open\", \"feature\", \"2026-08-02\"))\n\tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/wood/files/brief.md\", \"\")\n\tif rec.Code != http.StatusConflict {\n\t\tt.Errorf(\"status = %d, want 409 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif !strings.Contains(rec.Body.String(), \"ambiguous\") {\n\t\tt.Errorf(\"body = %s, want the ambiguity wording\", rec.Body.String())\n\t}\n}\n\n// TestServeShutdownSeam pins the httptest-able serve loop: Serve on a bound\n// listener answers requests until Shutdown drains and returns.\nfunc TestServeShutdownSeam(t *testing.T) {\n\tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n\tln, err := netListen(\"127.0.0.1:0\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdone := make(chan error, 1)\n\tgo func() { done <- srv.Serve(ln) }()\n\n\t// The server answers on the bound listener.\n\tbase := \"http://\" + ln.Addr().String()\n\tresp, err := httpGet(base + \"/projects\")\n\tif err != nil {\n\t\tt.Fatalf(\"GET before shutdown: %v\", err)\n\t}\n\tresp.Body.Close()\n\tif resp.StatusCode != http.StatusOK {\n\t\tt.Errorf(\"status = %d, want 200\", resp.StatusCode)\n\t}\n\n\t// Shutdown drains and the serve loop returns http.ErrServerClosed.\n\tif err := srv.Shutdown(t.Context()); err != nil {\n\t\tt.Fatalf(\"Shutdown: %v\", err)\n\t}\n\tif err := <-done; err != nil && err != http.ErrServerClosed {\n\t\tt.Errorf(\"Serve returned %v, want ErrServerClosed\", err)\n\t}\n}\n\n// --- TASK-4: jdi / diff / agents endpoints ----------------------------------\n\n// TestHandleJobJDIStatusAndLogs: the jdi endpoint serves the mg-jdi status\n// sidecar, the run.log tail, and the job's session.log tail.\nfunc TestHandleJobJDIStatusAndLogs(t *testing.T) {\n\troot := fakeJobProject(t, \"driven_job\", minimalBrief(\"Driven\", \"drv\", \"open\", \"feature\", \"2026-08-01\"))\n\tif err := writeJDIStatusForTest(t, root, \"driven_job\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// run.log under .manigot/jdi-status/<name>/.\n\tlogDir := job.JDIStatusDir(root, \"driven_job\")\n\tif err := os.MkdirAll(logDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(job.JDIRunLogPath(root, \"driven_job\"), []byte(\"run log line\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// session.log in the job's own dir.\n\tif err := os.WriteFile(filepath.Join(root, \"docs\", \"jobs\", \"driven_job\", \"session.log\"), []byte(\"session log line\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/driven_job/jdi\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body jobJDIResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif body.Status == nil || body.Status.State != \"stopped:finished\" || body.Status.Agent != \"reviewer\" {\n\t\tt.Errorf(\"status = %+v, want the written sidecar\", body.Status)\n\t}\n\tif body.RunLog == nil || !strings.Contains(*body.RunLog, \"run log line\") {\n\t\tt.Errorf(\"runLog = %v, want the run.log tail\", body.RunLog)\n\t}\n\tif body.SessionLog == nil || !strings.Contains(*body.SessionLog, \"session log line\") {\n\t\tt.Errorf(\"sessionLog = %v, want the session.log tail\", body.SessionLog)\n\t}\n}\n\n// TestHandleJobJDIUndrivenJobIsNulls: a job mg-jdi never drove returns nulls\n// (no status, no run.log, no session.log) — a normal \"no run yet\", not an\n// error.\nfunc TestHandleJobJDIUndrivenJobIsNulls(t *testing.T) {\n\troot := fakeJobProject(t, \"plain_job\", minimalBrief(\"Plain\", \"pln\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/plain_job/jdi\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n\t}\n\tvar body jobJDIResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif body.Status != nil || body.RunLog != nil || body.SessionLog != nil {\n\t\tt.Errorf(\"undriven job = %+v, want all-null fields\", body)\n\t}\n}\n\n// TestHandleJobJDIEmptyLogsPresent: an existing-but-empty run.log is \"there is\n// a run happening, nothing logged yet\" — an empty string, not null.\nfunc TestHandleJobJDIEmptyLogsPresent(t *testing.T) {\n\troot := fakeJobProject(t, \"driven_job\", minimalBrief(\"Driven\", \"drv\", \"open\", \"feature\", \"2026-08-01\"))\n\tif err := writeJDIStatusForTest(t, root, \"driven_job\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tlogDir := job.JDIStatusDir(root, \"driven_job\")\n\tif err := os.MkdirAll(logDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(job.JDIRunLogPath(root, \"driven_job\"), nil, 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/driven_job/jdi\", \"\")\n\tvar body jobJDIResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif body.RunLog == nil || *body.RunLog != \"\" {\n\t\tt.Errorf(\"runLog = %v, want an empty present string\", body.RunLog)\n\t}\n}\n\n// TestHandleJobJDIAllMissingStatusNoJDI — the jdi endpoint's job resolution is\n// the same choke point: an unknown job is a 404.\nfunc TestHandleJobJDIUnknownJobIs404(t *testing.T) {\n\troot := fakeJobProject(t, \"plain_job\", minimalBrief(\"Plain\", \"pln\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/nope/jdi\", \"\")\n\tif rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"status = %d, want 404\", rec.Code)\n\t}\n}\n\n// TestHandleJobDiffQuickEyeball: the diff endpoint returns the quick eyeball\n// (log + stat) for the resolved job branch against the base branch — the same\n// two calls mg diff makes. Needs a real git repo (PATH restricted to real\n// git, since the session shim refuses git init).\nfunc TestHandleJobDiffQuickEyeball(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\tdir := initGitRepo(t)\n\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n\tif err := os.WriteFile(filepath.Join(dir, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGitT(t, dir, \"add\", \"feature.txt\")\n\trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"add the feature\")\n\trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n\n\tsrv := New(&Registry{projects: []string{filepath.Clean(dir)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/wood_test/diff\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body jobDiffResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif body.Log == nil || !strings.Contains(*body.Log, \"add the feature\") {\n\t\tt.Errorf(\"log = %v, want the branch's commit\", body.Log)\n\t}\n\tif body.Stat == nil || !strings.Contains(*body.Stat, \"feature.txt\") {\n\t\tt.Errorf(\"stat = %v, want the changed file\", body.Stat)\n\t}\n\tif body.Patch != nil {\n\t\tt.Errorf(\"patch = %v, want nil for the quick eyeball\", body.Patch)\n\t}\n}\n\n// TestHandleJobDiffFullPatch: ?full=1 returns the complete patch.\nfunc TestHandleJobDiffFullPatch(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\tdir := initGitRepo(t)\n\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n\tif err := os.WriteFile(filepath.Join(dir, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGitT(t, dir, \"add\", \"feature.txt\")\n\trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"add the feature\")\n\trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n\n\tsrv := New(&Registry{projects: []string{filepath.Clean(dir)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/wood_test/diff?full=1\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body jobDiffResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif body.Patch == nil || !strings.Contains(*body.Patch, \"+feature\") {\n\t\tt.Errorf(\"patch = %v, want the full patch\", body.Patch)\n\t}\n\tif body.Log != nil || body.Stat != nil {\n\t\tt.Errorf(\"log/stat = %v/%v, want nil for ?full=1\", body.Log, body.Stat)\n\t}\n}\n\n// TestHandleJobDiffResolvesBaseBranchFromConfig: the base branch comes from\n// the project's configured baseBranch (project.Load), exactly as mg diff\n// resolves it — proven by a repo where main and the configured base differ,\n// so the wrong base would show an extra commit.\nfunc TestHandleJobDiffResolvesBaseBranchFromConfig(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\tdir := initGitRepo(t)\n\t// trunk = main + one extra commit; baseBranch is configured to trunk.\n\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"trunk\")\n\tif err := os.WriteFile(filepath.Join(dir, \"trunk.txt\"), []byte(\"trunk\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGitT(t, dir, \"add\", \"trunk.txt\")\n\trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"trunk work\")\n\t// The job branch is cut from trunk and adds one commit of its own.\n\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n\tif err := os.WriteFile(filepath.Join(dir, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGitT(t, dir, \"add\", \"feature.txt\")\n\trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"job work\")\n\trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n\t// Configure baseBranch=trunk.\n\tif err := os.MkdirAll(filepath.Join(dir, \".manigot\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(dir, \".manigot\", \"manigot.json\"), []byte(`{\"baseBranch\": \"trunk\"}`), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tsrv := New(&Registry{projects: []string{filepath.Clean(dir)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/wood_test/diff\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body jobDiffResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\t// Only the job's own commit — had the base fallen back to main, the\n\t// trunk commit would appear too.\n\tif body.Log == nil || strings.Contains(*body.Log, \"trunk work\") || !strings.Contains(*body.Log, \"job work\") {\n\t\tt.Errorf(\"log = %v, want only the job's commit against base trunk\", body.Log)\n\t}\n}\n\n// TestHandleJobDiffUnknownJobIs404: an unresolvable job segment is a 404 with\n// the CLI's not-found wording.\nfunc TestHandleJobDiffUnknownJobIs404(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\tdir := initGitRepo(t)\n\tsrv := New(&Registry{projects: []string{filepath.Clean(dir)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/nope/diff\", \"\")\n\tif rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"status = %d, want 404 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif !strings.Contains(rec.Body.String(), \"not found among local branches\") {\n\t\tt.Errorf(\"body = %s, want the CLI's not-found wording\", rec.Body.String())\n\t}\n}\n\n// TestHandleJobDiffAmbiguousIs409: a job segment matching several branches by\n// prefix is a 409 with the CLI's ambiguity wording.\nfunc TestHandleJobDiffAmbiguousIs409(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\tdir := initGitRepo(t)\n\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_a\")\n\trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_b\")\n\trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n\n\tsrv := New(&Registry{projects: []string{filepath.Clean(dir)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/wood/diff\", \"\")\n\tif rec.Code != http.StatusConflict {\n\t\tt.Errorf(\"status = %d, want 409 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif !strings.Contains(rec.Body.String(), \"ambiguous\") {\n\t\tt.Errorf(\"body = %s, want the CLI's ambiguity wording\", rec.Body.String())\n\t}\n}\n\n// TestHandleProjectAgentsNameAndDescription: the agents endpoint lists name +\n// description only, from the same agentlist.Discover the mg agents picker\n// uses.\nfunc TestHandleProjectAgentsNameAndDescription(t *testing.T) {\n\tfakeCheckout(t, map[string]string{\n\t\t\"analyst\":  \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n\t\t\"reviewer\": \"name: reviewer\\ndescription: Reviews changes.\\n\",\n\t})\n\troot := t.TempDir() // no docs/ needed — agents are global\n\tsrv := New(&Registry{projects: []string{filepath.Clean(root)}}, \"test-version\", \"\", nil)\n\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/agents\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body agentsResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif len(body.Agents) != 2 {\n\t\tt.Fatalf(\"agents = %d, want 2:\\n%s\", len(body.Agents), rec.Body.String())\n\t}\n\t// Sorted by name: analyst first.\n\tif body.Agents[0].Name != \"analyst\" || !strings.Contains(body.Agents[0].Description, \"tasks\") {\n\t\tt.Errorf(\"agent[0] = %+v, want analyst with its description\", body.Agents[0])\n\t}\n\tif body.Agents[1].Name != \"reviewer\" {\n\t\tt.Errorf(\"agent[1] = %+v, want reviewer\", body.Agents[1])\n\t}\n\t// No full agent-file contents leak into the response.\n\tif strings.Contains(rec.Body.String(), \"name: analyst\") {\n\t\tt.Errorf(\"response leaks the raw agent file: %s\", rec.Body.String())\n\t}\n}\n\n// --- TASK-5: /health ---------------------------------------------------------\n\n// TestHandleHealthReportsVersionImageAndProfiles: /health reports the version,\n// docker image presence, and per-profile readiness — identifiers and booleans\n// only, never credential values. The docker presence and readiness booleans\n// depend on the machine the test runs on (session.ImagePresent degrades to\n// false when docker is missing; profile readiness is an env read), so the\n// shape — every profile present, every field present — is what is pinned.\nfunc TestHandleHealthReportsVersionImageAndProfiles(t *testing.T) {\n\tsrv := New(&Registry{}, \"1.2.3-test\", \"\", nil)\n\trec := get(t, srv, \"/health\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body healthResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif body.Version != \"1.2.3-test\" {\n\t\tt.Errorf(\"version = %q, want the version passed into New\", body.Version)\n\t}\n\t// imagePresent must be a real boolean (present in the JSON), whatever its\n\t// value on this machine.\n\tvar raw map[string]json.RawMessage\n\tif err := json.Unmarshal(rec.Body.Bytes(), &raw); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, ok := raw[\"imagePresent\"]; !ok {\n\t\tt.Errorf(\"imagePresent missing from /health: %s\", rec.Body.String())\n\t}\n\n\tif len(body.Profiles) != 5 {\n\t\tt.Fatalf(\"profiles = %d, want 5 (claude-pro, zai, opencode-go, opencode-zen, opencode-zen-free):\\n%s\",\n\t\t\tlen(body.Profiles), rec.Body.String())\n\t}\n\tseen := map[string]bool{}\n\tfor _, p := range body.Profiles {\n\t\tif p.ID == \"\" {\n\t\t\tt.Errorf(\"profile row with empty id: %+v\", p)\n\t\t}\n\t\tseen[p.ID] = true\n\t}\n\tfor _, id := range []string{\"claude-pro\", \"zai\", \"opencode-go\", \"opencode-zen\", \"opencode-zen-free\"} {\n\t\tif !seen[id] {\n\t\t\tt.Errorf(\"profile %q missing from /health\", id)\n\t\t}\n\t}\n}\n\n// TestHandleHealthRequiresAuth: /health is inside the same auth boundary as\n// every other endpoint — with a token configured, it is a 401 without one.\nfunc TestHandleHealthRequiresAuth(t *testing.T) {\n\tsrv := New(&Registry{}, \"1.2.3-test\", \"sekrit-token\", nil)\n\tif rec := get(t, srv, \"/health\", \"\"); rec.Code != http.StatusUnauthorized {\n\t\tt.Errorf(\"no token: status = %d, want 401\", rec.Code)\n\t}\n\tif rec := get(t, srv, \"/health\", \"Bearer sekrit-token\"); rec.Code != http.StatusOK {\n\t\tt.Errorf(\"with token: status = %d, want 200\", rec.Code)\n\t}\n}","lineStart":1,"lineEnd":684,"totalLines":684,"truncated":false}},"title":"src/internal/serve/api_test.go","time":{"start":1787938728802,"end":1787938728805}},"id":"prt_04973eae3001gIjDrAvDbBEmfz","sessionID":"ses_fb68c3d29ffeIO0HMfdSuVup5i","messageID":"msg_04973e6bc001ROATIzDZC2CvSY"}}
{"type":"tool_use","timestamp":1787938728962,"sessionID":"ses_fb68c3d29ffeIO0HMfdSuVup5i","part":{"type":"tool","tool":"read","callID":"call_7a4c63bbce6c4b0e85352372","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/auth_test.go"},"output":"<path>/workspace/src/internal/serve/auth_test.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"encoding/json\"\n5: \t\"io\"\n6: \t\"net/http\"\n7: \t\"net/http/httptest\"\n8: \t\"path/filepath\"\n9: \t\"strings\"\n10: \t\"testing\"\n11: )\n12: \n13: // testServer builds a Server over a registry holding one temp project root,\n14: // returning the server and the registered root. audit is the audit writer\n15: // (nil for tests that don't assert audit lines).\n16: func testServer(t *testing.T, token string, audit io.Writer) (*Server, string) {\n17: \tt.Helper()\n18: \troot := t.TempDir()\n19: \treg := &Registry{projects: []string{filepath.Clean(root)}}\n20: \treturn New(reg, \"test-version\", token, audit), root\n21: }\n22: \n23: // get performs a GET against the handler with the given Authorization header.\n24: func get(t *testing.T, srv *Server, path, auth string) *httptest.ResponseRecorder {\n25: \tt.Helper()\n26: \treq := httptest.NewRequest(http.MethodGet, path, nil)\n27: \tif auth != \"\" {\n28: \t\treq.Header.Set(\"Authorization\", auth)\n29: \t}\n30: \trec := httptest.NewRecorder()\n31: \tsrv.Handler().ServeHTTP(rec, req)\n32: \treturn rec\n33: }\n34: \n35: // TestTokenRequiredPins the auth contract: with a token configured, the\n36: // correct bearer header passes, and a missing or wrong token is a 401 before\n37: // any handler logic runs.\n38: func TestTokenRequiredPins(t *testing.T) {\n39: \tsrv, _ := testServer(t, \"sekrit-token\", nil)\n40: \n41: \tif rec := get(t, srv, \"/projects\", \"Bearer sekrit-token\"); rec.Code != http.StatusOK {\n42: \t\tt.Errorf(\"correct token: status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n43: \t}\n44: \tif rec := get(t, srv, \"/projects\", \"\"); rec.Code != http.StatusUnauthorized {\n45: \t\tt.Errorf(\"missing token: status = %d, want 401\", rec.Code)\n46: \t}\n47: \tif rec := get(t, srv, \"/projects\", \"Bearer wrong-token\"); rec.Code != http.StatusUnauthorized {\n48: \t\tt.Errorf(\"wrong token: status = %d, want 401\", rec.Code)\n49: \t}\n50: \tif rec := get(t, srv, \"/projects\", \"Basic sekrit-token\"); rec.Code != http.StatusUnauthorized {\n51: \t\tt.Errorf(\"non-bearer scheme: status = %d, want 401\", rec.Code)\n52: \t}\n53: \tif rec := get(t, srv, \"/projects\", \"Bearer sekrit-token-extra\"); rec.Code != http.StatusUnauthorized {\n54: \t\tt.Errorf(\"token with wrong length: status = %d, want 401\", rec.Code)\n55: \t}\n56: }\n57: \n58: // TestTokenlessLocalhostPins the default: no token configured means every\n59: // request passes (the machine's own user is the trust boundary, as it is for\n60: // the CLI today).\n61: func TestTokenlessLocalhostPins(t *testing.T) {\n62: \tsrv, _ := testServer(t, \"\", nil)\n63: \tif rec := get(t, srv, \"/projects\", \"\"); rec.Code != http.StatusOK {\n64: \t\tt.Errorf(\"tokenless: status = %d, want 200\", rec.Code)\n65: \t}\n66: \t// An Authorization header on a tokenless daemon is ignored, not rejected.\n67: \tif rec := get(t, srv, \"/projects\", \"Bearer anything\"); rec.Code != http.StatusOK {\n68: \t\tt.Errorf(\"tokenless with stray header: status = %d, want 200\", rec.Code)\n69: \t}\n70: }\n71: \n72: // TestUnauthorizedIsJSONError: the 401 body is the JSON error envelope, never\n73: // a hint about the expected token.\n74: func TestUnauthorizedIsJSONError(t *testing.T) {\n75: \tsrv, _ := testServer(t, \"sekrit-token\", nil)\n76: \trec := get(t, srv, \"/projects\", \"\")\n77: \tvar body map[string]string\n78: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n79: \t\tt.Fatalf(\"401 body not JSON: %v (%s)\", err, rec.Body.String())\n80: \t}\n81: \tif body[\"error\"] == \"\" {\n82: \t\tt.Errorf(\"401 body = %v, want an error envelope\", body)\n83: \t}\n84: \tif strings.Contains(rec.Body.String(), \"sekrit-token\") {\n85: \t\tt.Errorf(\"401 body echoes the token: %s\", rec.Body.String())\n86: \t}\n87: }\n88: \n89: // TestTokenMatchesConstantTimeCompare: the comparison goes through\n90: // crypto/subtle.ConstantTimeCompare (the value path) once the length\n91: // matches — asserted structurally by pinning the accept/reject behavior at\n92: // the tokenMatches level, the function the middleware uses.\n93: func TestTokenMatchesConstantTimeCompare(t *testing.T) {\n94: \treq := httptest.NewRequest(http.MethodGet, \"/\", nil)\n95: \treq.Header.Set(\"Authorization\", \"Bearer correct-horse\")\n96: \tif !tokenMatches(req, \"correct-horse\") {\n97: \t\tt.Error(\"tokenMatches with the right token = false, want true\")\n98: \t}\n99: \treq.Header.Set(\"Authorization\", \"Bearer correct-horsf\") // same length, wrong value\n100: \tif tokenMatches(req, \"correct-horse\") {\n101: \t\tt.Error(\"tokenMatches with a same-length wrong token = true, want false\")\n102: \t}\n103: \treq.Header.Set(\"Authorization\", \"Bearer short\")\n104: \tif tokenMatches(req, \"correct-horse\") {\n105: \t\tt.Error(\"tokenMatches with a different-length token = true, want false\")\n106: \t}\n107: \treq.Header.Set(\"Authorization\", \"Basic correct-horse\")\n108: \tif tokenMatches(req, \"correct-horse\") {\n109: \t\tt.Error(\"tokenMatches with a non-Bearer scheme = true, want false\")\n110: \t}\n111: }\n112: \n113: // TestIsLoopback pins the binding classification: 127.0.0.0/8, ::1 and\n114: // localhost are loopback; everything else — including the empty host (binds\n115: // all interfaces) — is not.\n116: func TestIsLoopback(t *testing.T) {\n117: \tfor _, host := range []string{\"127.0.0.1\", \"127.0.0.0\", \"127.99.99.99\", \"::1\", \"localhost\"} {\n118: \t\tif !IsLoopback(host) {\n119: \t\t\tt.Errorf(\"IsLoopback(%q) = false, want true\", host)\n120: \t\t}\n121: \t}\n122: \tfor _, host := range []string{\"\", \"0.0.0.0\", \"::\", \"192.168.1.10\", \"10.0.0.5\", \"example.com\", \"2001:db8::1\"} {\n123: \t\tif IsLoopback(host) {\n124: \t\t\tt.Errorf(\"IsLoopback(%q) = true, want false\", host)\n125: \t\t}\n126: \t}\n127: }\n128: \n129: // TestValidateStartupPins the hard invariant: a non-loopback bind without a\n130: // token refuses to start; a token (or a loopback bind) permits it. There is\n131: // no flag that turns the refusal off — only a token or a loopback bind.\n132: func TestValidateStartupPins(t *testing.T) {\n133: \tif err := ValidateStartup(\"0.0.0.0\", \"\"); err == nil {\n134: \t\tt.Error(\"ValidateStartup(0.0.0.0, no token) = nil, want refusal\")\n135: \t}\n136: \tif err := ValidateStartup(\"192.168.1.10\", \"\"); err == nil {\n137: \t\tt.Error(\"ValidateStartup(non-loopback, no token) = nil, want refusal\")\n138: \t}\n139: \tif err := ValidateStartup(\"2001:db8::1\", \"\"); err == nil {\n140: \t\tt.Error(\"ValidateStartup(non-loopback IPv6, no token) = nil, want refusal\")\n141: \t}\n142: \tif err := ValidateStartup(\"0.0.0.0\", \"some-token\"); err != nil {\n143: \t\tt.Errorf(\"ValidateStartup(0.0.0.0, token) = %v, want nil\", err)\n144: \t}\n145: \tif err := ValidateStartup(\"127.0.0.1\", \"\"); err != nil {\n146: \t\tt.Errorf(\"ValidateStartup(127.0.0.1, no token) = %v, want nil\", err)\n147: \t}\n148: \tif err := ValidateStartup(\"::1\", \"\"); err != nil {\n149: \t\tt.Errorf(\"ValidateStartup(::1, no token) = %v, want nil\", err)\n150: \t}\n151: \tif err := ValidateStartup(\"localhost\", \"\"); err != nil {\n152: \t\tt.Errorf(\"ValidateStartup(localhost, no token) = %v, want nil\", err)\n153: \t}\n154: }\n\n(End of file - total 154 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// testServer builds a Server over a registry holding one temp project root,\n// returning the server and the registered root. audit is the audit writer\n// (nil for tests that don't assert audit lines).\nfunc testServer(t *testing.T, token string, audit io.Writer) (*Server, string) {\n\tt.Helper()\n\troot := t.TempDir()\n\treg := &Registry{projects: []string{filepath.Clean(root)}}\n\treturn New(reg, \"test-version\", token, audit), root","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/auth_test.go","text":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// testServer builds a Server over a registry holding one temp project root,\n// returning the server and the registered root. audit is the audit writer\n// (nil for tests that don't assert audit lines).\nfunc testServer(t *testing.T, token string, audit io.Writer) (*Server, string) {\n\tt.Helper()\n\troot := t.TempDir()\n\treg := &Registry{projects: []string{filepath.Clean(root)}}\n\treturn New(reg, \"test-version\", token, audit), root\n}\n\n// get performs a GET against the handler with the given Authorization header.\nfunc get(t *testing.T, srv *Server, path, auth string) *httptest.ResponseRecorder {\n\tt.Helper()\n\treq := httptest.NewRequest(http.MethodGet, path, nil)\n\tif auth != \"\" {\n\t\treq.Header.Set(\"Authorization\", auth)\n\t}\n\trec := httptest.NewRecorder()\n\tsrv.Handler().ServeHTTP(rec, req)\n\treturn rec\n}\n\n// TestTokenRequiredPins the auth contract: with a token configured, the\n// correct bearer header passes, and a missing or wrong token is a 401 before\n// any handler logic runs.\nfunc TestTokenRequiredPins(t *testing.T) {\n\tsrv, _ := testServer(t, \"sekrit-token\", nil)\n\n\tif rec := get(t, srv, \"/projects\", \"Bearer sekrit-token\"); rec.Code != http.StatusOK {\n\t\tt.Errorf(\"correct token: status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif rec := get(t, srv, \"/projects\", \"\"); rec.Code != http.StatusUnauthorized {\n\t\tt.Errorf(\"missing token: status = %d, want 401\", rec.Code)\n\t}\n\tif rec := get(t, srv, \"/projects\", \"Bearer wrong-token\"); rec.Code != http.StatusUnauthorized {\n\t\tt.Errorf(\"wrong token: status = %d, want 401\", rec.Code)\n\t}\n\tif rec := get(t, srv, \"/projects\", \"Basic sekrit-token\"); rec.Code != http.StatusUnauthorized {\n\t\tt.Errorf(\"non-bearer scheme: status = %d, want 401\", rec.Code)\n\t}\n\tif rec := get(t, srv, \"/projects\", \"Bearer sekrit-token-extra\"); rec.Code != http.StatusUnauthorized {\n\t\tt.Errorf(\"token with wrong length: status = %d, want 401\", rec.Code)\n\t}\n}\n\n// TestTokenlessLocalhostPins the default: no token configured means every\n// request passes (the machine's own user is the trust boundary, as it is for\n// the CLI today).\nfunc TestTokenlessLocalhostPins(t *testing.T) {\n\tsrv, _ := testServer(t, \"\", nil)\n\tif rec := get(t, srv, \"/projects\", \"\"); rec.Code != http.StatusOK {\n\t\tt.Errorf(\"tokenless: status = %d, want 200\", rec.Code)\n\t}\n\t// An Authorization header on a tokenless daemon is ignored, not rejected.\n\tif rec := get(t, srv, \"/projects\", \"Bearer anything\"); rec.Code != http.StatusOK {\n\t\tt.Errorf(\"tokenless with stray header: status = %d, want 200\", rec.Code)\n\t}\n}\n\n// TestUnauthorizedIsJSONError: the 401 body is the JSON error envelope, never\n// a hint about the expected token.\nfunc TestUnauthorizedIsJSONError(t *testing.T) {\n\tsrv, _ := testServer(t, \"sekrit-token\", nil)\n\trec := get(t, srv, \"/projects\", \"\")\n\tvar body map[string]string\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"401 body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif body[\"error\"] == \"\" {\n\t\tt.Errorf(\"401 body = %v, want an error envelope\", body)\n\t}\n\tif strings.Contains(rec.Body.String(), \"sekrit-token\") {\n\t\tt.Errorf(\"401 body echoes the token: %s\", rec.Body.String())\n\t}\n}\n\n// TestTokenMatchesConstantTimeCompare: the comparison goes through\n// crypto/subtle.ConstantTimeCompare (the value path) once the length\n// matches — asserted structurally by pinning the accept/reject behavior at\n// the tokenMatches level, the function the middleware uses.\nfunc TestTokenMatchesConstantTimeCompare(t *testing.T) {\n\treq := httptest.NewRequest(http.MethodGet, \"/\", nil)\n\treq.Header.Set(\"Authorization\", \"Bearer correct-horse\")\n\tif !tokenMatches(req, \"correct-horse\") {\n\t\tt.Error(\"tokenMatches with the right token = false, want true\")\n\t}\n\treq.Header.Set(\"Authorization\", \"Bearer correct-horsf\") // same length, wrong value\n\tif tokenMatches(req, \"correct-horse\") {\n\t\tt.Error(\"tokenMatches with a same-length wrong token = true, want false\")\n\t}\n\treq.Header.Set(\"Authorization\", \"Bearer short\")\n\tif tokenMatches(req, \"correct-horse\") {\n\t\tt.Error(\"tokenMatches with a different-length token = true, want false\")\n\t}\n\treq.Header.Set(\"Authorization\", \"Basic correct-horse\")\n\tif tokenMatches(req, \"correct-horse\") {\n\t\tt.Error(\"tokenMatches with a non-Bearer scheme = true, want false\")\n\t}\n}\n\n// TestIsLoopback pins the binding classification: 127.0.0.0/8, ::1 and\n// localhost are loopback; everything else — including the empty host (binds\n// all interfaces) — is not.\nfunc TestIsLoopback(t *testing.T) {\n\tfor _, host := range []string{\"127.0.0.1\", \"127.0.0.0\", \"127.99.99.99\", \"::1\", \"localhost\"} {\n\t\tif !IsLoopback(host) {\n\t\t\tt.Errorf(\"IsLoopback(%q) = false, want true\", host)\n\t\t}\n\t}\n\tfor _, host := range []string{\"\", \"0.0.0.0\", \"::\", \"192.168.1.10\", \"10.0.0.5\", \"example.com\", \"2001:db8::1\"} {\n\t\tif IsLoopback(host) {\n\t\t\tt.Errorf(\"IsLoopback(%q) = true, want false\", host)\n\t\t}\n\t}\n}\n\n// TestValidateStartupPins the hard invariant: a non-loopback bind without a\n// token refuses to start; a token (or a loopback bind) permits it. There is\n// no flag that turns the refusal off — only a token or a loopback bind.\nfunc TestValidateStartupPins(t *testing.T) {\n\tif err := ValidateStartup(\"0.0.0.0\", \"\"); err == nil {\n\t\tt.Error(\"ValidateStartup(0.0.0.0, no token) = nil, want refusal\")\n\t}\n\tif err := ValidateStartup(\"192.168.1.10\", \"\"); err == nil {\n\t\tt.Error(\"ValidateStartup(non-loopback, no token) = nil, want refusal\")\n\t}\n\tif err := ValidateStartup(\"2001:db8::1\", \"\"); err == nil {\n\t\tt.Error(\"ValidateStartup(non-loopback IPv6, no token) = nil, want refusal\")\n\t}\n\tif err := ValidateStartup(\"0.0.0.0\", \"some-token\"); err != nil {\n\t\tt.Errorf(\"ValidateStartup(0.0.0.0, token) = %v, want nil\", err)\n\t}\n\tif err := ValidateStartup(\"127.0.0.1\", \"\"); err != nil {\n\t\tt.Errorf(\"ValidateStartup(127.0.0.1, no token) = %v, want nil\", err)\n\t}\n\tif err := ValidateStartup(\"::1\", \"\"); err != nil {\n\t\tt.Errorf(\"ValidateStartup(::1, no token) = %v, want nil\", err)\n\t}\n\tif err := ValidateStartup(\"localhost\", \"\"); err != nil {\n\t\tt.Errorf(\"ValidateStartup(localhost, no token) = %v, want nil\", err)\n\t}\n}","lineStart":1,"lineEnd":154,"totalLines":154,"truncated":false}},"title":"src/internal/serve/auth_test.go","time":{"start":1787938728957,"end":1787938728960}},"id":"prt_04973ebd5001rbMv7RpX0SK7wB","sessionID":"ses_fb68c3d29ffeIO0HMfdSuVup5i","messageID":"msg_04973e6bc001ROATIzDZC2CvSY"}}
