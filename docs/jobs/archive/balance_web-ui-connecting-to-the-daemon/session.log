svelte'\n  import SettingsModal from '$lib/components/SettingsModal.svelte'\n  import Confirm from '$lib/components/Confirm.svelte'\n  import { pruneContainers } from '$lib/api/client'\n\n  let showSettings = $state(false)\n  let confirmPrune = $state(false)\n  let pruning = $state(false)\n\n  onMount(() => {\n    void connection.check()\n  })\n\n  async function doPrune() {\n    pruning = true\n    try {\n      const res = await pruneContainers()\n      toasts.ok(\n        `Removed ${res.removed} exited container${res.removed === 1 ? '' : 's'} — ${res.running} manigot container${res.running === 1 ? '' : 's'} running`,\n      )\n      confirmPrune = false\n    } catch (e) {\n      const msg =\n        e instanceof Error &&\n        'capabilityMiss' in e &&\n        (e as { capabilityMiss: boolean }).capabilityMiss\n          ? 'Container pruning lands with job two of the control plane.'\n          : e instanceof Error\n            ? e.message\n            : String(e)\n      toasts.error(msg)\n      confirmPrune = false\n    } finally {\n      pruning = false\n    }\n  }\n</script>\n\n<div class=\"page\">\n  <header class=\"head\">\n    <div>\n      <p class=\"eyebrow\">daemon</p>\n      <h1>mg serve</h1>\n    </div>\n    <button class=\"btn\" onclick={() => (showSettings = true)}>Connection…</button>\n  </header>\n\n  {#if connection.status === 'up' && connection.health}\n    <section class=\"panel\">\n      <div class=\"row\">\n        <span class=\"k\">version</span>\n        <span class=\"v mono\">{connection.health.version || '—'}</span>\n      </div>\n      <div class=\"row\">\n        <span class=\"k\">docker image</span>\n        <span class=\"v\">\n          {#if connection.health.imagePresent}\n            <span class=\"chip chip-done\"><span class=\"dot\"></span> present</span>\n          {:else}\n            <span class=\"chip chip-human\"><span class=\"dot\"></span> missing — run make build</span>\n          {/if}\n        </span>\n      </div>\n      <div class=\"row\">\n        <span class=\"k\">connection</span>\n        <span class=\"v mono\">{connection.baseUrl || '(same origin)'} · {connection.token ? 'bearer token' : 'tokenless'}</span>\n      </div>\n    </section>\n\n    <section class=\"panel\">\n      <header class=\"panel-head\">\n        <h2>Profiles</h2>\n        <p class=\"sub\">Which subscription profiles have credentials ready — booleans only, never the credentials.</p>\n      </header>\n      <ul class=\"profiles\">\n        {#each connection.health.profiles ?? [] as p (p.id)}\n          <li class=\"profile\" class:ready={p.ready}>\n            <span class=\"p-dot\"></span>\n            <span class=\"p-name mono\">{p.id}</span>\n            <span class=\"p-state\">{p.ready ? 'ready' : 'not configured'}</span>\n          </li>\n        {/each}\n      </ul>\n    </section>\n  {:else if connection.status === 'connecting'}\n    <p class=\"loading\">Checking the daemon…</p>\n  {:else}\n    <section class=\"panel down\">\n      <h2>Daemon unreachable</h2>\n      <p class=\"sub\">{connection.lastError}</p>\n      <p class=\"sub\">\n        Start it with <code>mg serve</code> (localhost, tokenless) or point the connection at the\n        right URL and token.\n      </p>\n    </section>\n  {/if}\n\n  <section class=\"panel\">\n    <header class=\"panel-head\">\n      <h2>Maintenance</h2>\n      <p class=\"sub\">The cleanup a headless daemon needs — no terminal required.</p>\n    </header>\n    <div class=\"maint\">\n      <div>\n        <p class=\"m-k\">Prune containers</p>\n        <p class=\"m-d\">Remove exited manigot containers — the residue of abnormal session ends.</p>\n      </div>\n      <button class=\"btn\" onclick={() => (confirmPrune = true)}>Prune…</button>\n    </div>\n    <p class=\"fine\">\n      Orphaned-worktree cleanup lives in each project's jobs view.\n    </p>\n  </section>\n</div>\n\n{#if showSettings}\n  <SettingsModal onclose={() => (showSettings = false)} />\n{/if}\n\n{#if confirmPrune}\n  <Confirm\n    title=\"Prune containers\"\n    body=\"Remove exited manigot containers?\\nRunning containers are never touched.\"\n    confirmLabel=\"Prune\"\n    onconfirm={doPrune}\n    busy={pruning}\n    onclose={() => (confirmPrune = false)}\n  />\n{/if}\n\n<style>\n  .page {\n    max-width: 720px;\n    margin: 0 auto;\n    padding: var(--r-6) var(--r-6) var(--r-7);\n    width: 100%;\n    display: flex;\n    flex-direction: column;\n    gap: var(--r-4);\n  }\n  .head {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n    gap: var(--r-4);\n  }\n  h1 {\n    font-size: 24px;\n    letter-spacing: -0.02em;\n  }\n\n  .panel {\n    background: var(--bg-1);\n    border: 1px solid var(--line);\n    border-radius: var(--radius-m);\n    padding: var(--r-4) var(--r-5);\n  }\n  .panel-head h2 {\n    font-size: 15.5px;\n    margin-bottom: 2px;\n  }\n  .panel-head {\n    margin-bottom: var(--r-3);\n  }\n  .sub {\n    color: var(--ink-2);\n    font-size: 13px;\n  }\n  .sub code {\n    color: var(--accent-bright);\n  }\n\n  .row {\n    display: flex;\n    justify-content: space-between;\n    gap: var(--r-4);\n    padding: 7px 0;\n    border-bottom: 1px solid var(--line);\n    font-size: 13.5px;\n  }\n  .row:last-child {\n    border-bottom: none;\n  }\n  .k {\n    color: var(--ink-2);\n    font-family: var(--font-mono);\n    font-size: 12px;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n  }\n  .v {\n    color: var(--ink-0);\n  }\n  .mono {\n    font-family: var(--font-mono);\n    font-size: 12.5px;\n  }\n\n  .profiles {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));\n    gap: var(--r-2);\n  }\n  .profile {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n    background: var(--bg-2);\n    border: 1px solid var(--line);\n    border-radius: var(--radius-s);\n    padding: 8px 12px;\n    font-size: 12.5px;\n  }\n  .p-dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: var(--ink-3);\n    flex: none;\n  }\n  .profile.ready .p-dot {\n    background: var(--st-done);\n    box-shadow: 0 0 6px rgba(76, 195, 138, 0.5);\n  }\n  .p-name {\n    color: var(--ink-0);\n  }\n  .p-state {\n    margin-left: auto;\n    color: var(--ink-2);\n    font-size: 11.5px;\n  }\n  .profile.ready .p-state {\n    color: var(--st-done);\n  }\n\n  .down h2 {\n    color: #ffb3b6;\n  }\n\n  .maint {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: var(--r-4);\n  }\n  .m-k {\n    font-weight: 590;\n    font-size: 14px;\n    color: var(--ink-0);\n  }\n  .m-d {\n    font-size: 12.5px;\n    color: var(--ink-2);\n    max-width: 52ch;\n  }\n  .fine {\n    margin-top: var(--r-3);\n    font-size: 12px;\n    color: var(--ink-2);\n    border-top: 1px solid var(--line);\n    padding-top: var(--r-3);\n  }\n  .loading {\n    color: var(--ink-2);\n  }\n\n  @media (max-width: 760px) {\n    .page {\n      padding: var(--r-4) var(--r-4) var(--r-6);\n    }\n    .maint {\n      flex-direction: column;\n      align-items: flex-start;\n    }\n  }\n</style>","lineStart":1,"lineEnd":283,"totalLines":283,"truncated":false}},"title":"web-ui/src/lib/views/HealthView.svelte","time":{"start":1787992436408,"end":1787992436433}},"id":"prt_04ca76eb3001QnKj6YcwBDGgjn","sessionID":"ses_fb3594f94ffeQ3bCtRbhDqaOUL","messageID":"msg_04ca7312f0017yB67JUFVbWUTc"}}
{"type":"tool_use","timestamp":1787992436441,"sessionID":"ses_fb3594f94ffeQ3bCtRbhDqaOUL","part":{"type":"tool","tool":"read","callID":"call_fdba8ccd242b4e5999f82976","state":{"status":"completed","input":{"filePath":"/workspace/web-ui/src/lib/components/SettingsModal.svelte"},"output":"<path>/workspace/web-ui/src/lib/components/SettingsModal.svelte</path>\n<type>file</type>\n<content>\n1: <!-- Settings — where the daemon lives and how to authenticate. The token is -->\n2: <!-- configured out-of-band (mg serve-token / $MG_SERVE_TOKEN); the UI only -->\n3: <!-- remembers it. Never rendered back in full after saving. -->\n4: \n5: <script lang=\"ts\">\n6:   import Modal from './Modal.svelte'\n7:   import { connection } from '$lib/state/connection.svelte'\n8:   import { toasts } from '$lib/state/toasts.svelte'\n9: \n10:   let { onclose }: { onclose: () => void } = $props()\n11: \n12:   let baseUrl = $state(connection.baseUrl)\n13:   let token = $state(connection.token)\n14:   let busy = $state(false)\n15: \n16:   async function save() {\n17:     busy = true\n18:     connection.set(baseUrl, token)\n19:     const ok = await connection.check()\n20:     busy = false\n21:     if (ok) {\n22:       toasts.ok('Connected to the daemon')\n23:       onclose()\n24:     } else {\n25:       // connection.lastError is precise (CORS / unreachable / token / …);\n26:       // surface it instead of a generic \"check the URL\".\n27:       toasts.error(connection.lastError || 'Could not reach the daemon — check the URL')\n28:     }\n29:   }\n30: </script>\n31: \n32: <Modal title=\"Connection\" {busy} {onclose} width=\"460px\">\n33:   <div class=\"field\">\n34:     <label for=\"conn-url\">daemon URL</label>\n35:     <input\n36:       id=\"conn-url\"\n37:       class=\"input\"\n38:       bind:value={baseUrl}\n39:       placeholder=\"http://127.0.0.1:8080\"\n40:       spellcheck=\"false\"\n41:       autocomplete=\"off\"\n42:     />\n43:     <p class=\"hint\">\n44:       The daemon is a same-origin API (no CORS headers) — a cross-origin URL is blocked by the\n45:       browser. When this page runs from the vite dev server, use <code>/api</code>: vite proxies it\n46:       to <code>127.0.0.1:8080</code> for you. Leave empty when the page is served by the daemon\n47:       itself (production, same origin).\n48:     </p>\n49:   </div>\n50:   <div class=\"field\">\n51:     <label for=\"conn-token\">bearer token</label>\n52:     <input\n53:       id=\"conn-token\"\n54:       class=\"input\"\n55:       bind:value={token}\n56:       type=\"password\"\n57:       placeholder=\"tokenless (localhost)\"\n58:       spellcheck=\"false\"\n59:       autocomplete=\"off\"\n60:     />\n61:     <p class=\"hint\">\n62:       A non-loopback bind requires a token (<code>mg serve-token</code> writes one to the daemon's\n63:       .env). Over the open internet, put the daemon behind TLS.\n64:     </p>\n65:   </div>\n66:   {#snippet footer()}\n67:     <button class=\"btn\" onclick={onclose} disabled={busy}>Cancel</button>\n68:     <button class=\"btn btn-primary\" onclick={save} disabled={busy}>\n69:       {#if busy}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n70:       Save and connect\n71:     </button>\n72:   {/snippet}\n73: </Modal>\n74: \n75: <style>\n76:   .hint {\n77:     font-size: 12.5px;\n78:     color: var(--ink-2);\n79:     margin: 0;\n80:     line-height: 1.5;\n81:   }\n82:   .hint code {\n83:     color: var(--ink-1);\n84:   }\n85: </style>\n\n(End of file - total 85 lines)\n</content>","metadata":{"preview":"<!-- Settings — where the daemon lives and how to authenticate. The token is -->\n<!-- configured out-of-band (mg serve-token / $MG_SERVE_TOKEN); the UI only -->\n<!-- remembers it. Never rendered back in full after saving. -->\n\n<script lang=\"ts\">\n  import Modal from './Modal.svelte'\n  import { connection } from '$lib/state/connection.svelte'\n  import { toasts } from '$lib/state/toasts.svelte'\n\n  let { onclose }: { onclose: () => void } = $props()\n\n  let baseUrl = $state(connection.baseUrl)\n  let token = $state(connection.token)\n  let busy = $state(false)\n\n  async function save() {\n    busy = true\n    connection.set(baseUrl, token)\n    const ok = await connection.check()\n    busy = false","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/web-ui/src/lib/components/SettingsModal.svelte","text":"<!-- Settings — where the daemon lives and how to authenticate. The token is -->\n<!-- configured out-of-band (mg serve-token / $MG_SERVE_TOKEN); the UI only -->\n<!-- remembers it. Never rendered back in full after saving. -->\n\n<script lang=\"ts\">\n  import Modal from './Modal.svelte'\n  import { connection } from '$lib/state/connection.svelte'\n  import { toasts } from '$lib/state/toasts.svelte'\n\n  let { onclose }: { onclose: () => void } = $props()\n\n  let baseUrl = $state(connection.baseUrl)\n  let token = $state(connection.token)\n  let busy = $state(false)\n\n  async function save() {\n    busy = true\n    connection.set(baseUrl, token)\n    const ok = await connection.check()\n    busy = false\n    if (ok) {\n      toasts.ok('Connected to the daemon')\n      onclose()\n    } else {\n      // connection.lastError is precise (CORS / unreachable / token / …);\n      // surface it instead of a generic \"check the URL\".\n      toasts.error(connection.lastError || 'Could not reach the daemon — check the URL')\n    }\n  }\n</script>\n\n<Modal title=\"Connection\" {busy} {onclose} width=\"460px\">\n  <div class=\"field\">\n    <label for=\"conn-url\">daemon URL</label>\n    <input\n      id=\"conn-url\"\n      class=\"input\"\n      bind:value={baseUrl}\n      placeholder=\"http://127.0.0.1:8080\"\n      spellcheck=\"false\"\n      autocomplete=\"off\"\n    />\n    <p class=\"hint\">\n      The daemon is a same-origin API (no CORS headers) — a cross-origin URL is blocked by the\n      browser. When this page runs from the vite dev server, use <code>/api</code>: vite proxies it\n      to <code>127.0.0.1:8080</code> for you. Leave empty when the page is served by the daemon\n      itself (production, same origin).\n    </p>\n  </div>\n  <div class=\"field\">\n    <label for=\"conn-token\">bearer token</label>\n    <input\n      id=\"conn-token\"\n      class=\"input\"\n      bind:value={token}\n      type=\"password\"\n      placeholder=\"tokenless (localhost)\"\n      spellcheck=\"false\"\n      autocomplete=\"off\"\n    />\n    <p class=\"hint\">\n      A non-loopback bind requires a token (<code>mg serve-token</code> writes one to the daemon's\n      .env). Over the open internet, put the daemon behind TLS.\n    </p>\n  </div>\n  {#snippet footer()}\n    <button class=\"btn\" onclick={onclose} disabled={busy}>Cancel</button>\n    <button class=\"btn btn-primary\" onclick={save} disabled={busy}>\n      {#if busy}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n      Save and connect\n    </button>\n  {/snippet}\n</Modal>\n\n<style>\n  .hint {\n    font-size: 12.5px;\n    color: var(--ink-2);\n    margin: 0;\n    line-height: 1.5;\n  }\n  .hint code {\n    color: var(--ink-1);\n  }\n</style>","lineStart":1,"lineEnd":85,"totalLines":85,"truncated":false}},"title":"web-ui/src/lib/components/SettingsModal.svelte","time":{"start":1787992436419,"end":1787992436436}},"id":"prt_04ca76ebf001aDpNYQHL25kE34","sessionID":"ses_fb3594f94ffeQ3bCtRbhDqaOUL","messageID":"msg_04ca7312f0017yB67JUFVbWUTc"}}
