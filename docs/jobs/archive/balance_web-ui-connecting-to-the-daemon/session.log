{"type":"tool_use","timestamp":1787992723703,"sessionID":"ses_fb3594f94ffeQ3bCtRbhDqaOUL","part":{"type":"tool","tool":"read","callID":"call_80221998ac1e4607bfc32c5f","state":{"status":"completed","input":{"filePath":"/workspace/web-ui/src/lib/api/client.test.ts"},"output":"<path>/workspace/web-ui/src/lib/api/client.test.ts</path>\n<type>file</type>\n<content>\n1: import { afterEach, describe, expect, it, vi } from 'vitest'\n2: import * as client from '$lib/api/client'\n3: \n4: function stubFetch(handler: (url: string, init?: RequestInit) => { status: number; body: unknown; contentType?: string }) {\n5:   return vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {\n6:     const url = String(input)\n7:     const r = handler(url, init)\n8:     return new Response(r.body === undefined ? '' : typeof r.body === 'string' ? r.body : JSON.stringify(r.body), {\n9:       status: r.status,\n10:       headers: { 'Content-Type': r.contentType ?? 'application/json' },\n11:     })\n12:   })\n13: }\n14: \n15: afterEach(() => {\n16:   vi.unstubAllGlobals()\n17:   client.setConnection({ baseUrl: 'http://mg.test', token: '' })\n18: })\n19: \n20: describe('client', () => {\n21:   it('sends the bearer token when configured', async () => {\n22:     const f = stubFetch(() => ({ status: 200, body: { version: '1' } }))\n23:     vi.stubGlobal('fetch', f)\n24:     client.setConnection({ baseUrl: 'http://mg.test', token: 'sekret' })\n25:     await client.getHealth()\n26:     expect(f).toHaveBeenCalledWith(\n27:       'http://mg.test/health',\n28:       expect.objectContaining({\n29:         headers: expect.objectContaining({ Authorization: 'Bearer sekret' }),\n30:       }),\n31:     )\n32:   })\n33: \n34:   it('parses JSON responses', async () => {\n35:     vi.stubGlobal(\n36:       'fetch',\n37:       stubFetch(() => ({ status: 200, body: { projects: [{ name: 'manigot', path: '/x' }] } })),\n38:     )\n39:     const res = await client.getProjects()\n40:     expect(res.projects[0].name).toBe('manigot')\n41:   })\n42: \n43:   it('surfaces the error envelope', async () => {\n44:     vi.stubGlobal('fetch', stubFetch(() => ({ status: 404, body: { error: 'project not found' } })))\n45:     await expect(client.getProjects()).rejects.toMatchObject({ status: 404, message: 'project not found' })\n46:   })\n47: \n48:   it('maps 404 to a capability miss', async () => {\n49:     vi.stubGlobal('fetch', stubFetch(() => ({ status: 404, body: { error: 'no route' } })))\n50:     const err = await client.pruneContainers().catch((e) => e)\n51:     expect(err.capabilityMiss).toBe(true)\n52:   })\n53: \n54:   it('explains 401 as a token problem', async () => {\n55:     vi.stubGlobal('fetch', stubFetch(() => ({ status: 401, body: { error: 'unauthorized' } })))\n56:     await expect(client.getHealth()).rejects.toThrow(/token/i)\n57:   })\n58: \n59:   it('wraps network failure with the base URL', async () => {\n60:     vi.stubGlobal(\n61:       'fetch',\n62:       vi.fn(async () => {\n63:         throw new TypeError('Failed to fetch')\n64:       }),\n65:     )\n66:     // Same-origin base — the failure is a plain network error, not CORS.\n67:     client.setConnection({ baseUrl: '/api', token: '' })\n68:     await expect(client.getHealth()).rejects.toThrow(/cannot reach the daemon/)\n69:   })\n70: \n71:   it('explains cross-origin failure as a CORS block with the /api hint', async () => {\n72:     vi.stubGlobal(\n73:       'fetch',\n74:       vi.fn(async () => {\n75:         throw new TypeError('Failed to fetch')\n76:       }),\n77:     )\n78:     // jsdom's location.origin is http://localhost:3000 — an absolute daemon\n79:     // URL on another origin must be flagged as the CORS block it is.\n80:     client.setConnection({ baseUrl: 'http://127.0.0.1:8080', token: '' })\n81:     const err = await client.getHealth().catch((e) => e)\n82:     expect(err.message).toMatch(/cross-origin URL blocked/i)\n83:     expect(err.message).toContain('/api')\n84:   })\n85: \n86:   it('does not claim CORS for a same-origin base', async () => {\n87:     vi.stubGlobal(\n88:       'fetch',\n89:       vi.fn(async () => {\n90:         throw new TypeError('Failed to fetch')\n91:       }),\n92:     )\n93:     client.setConnection({ baseUrl: '/api', token: '' })\n94:     const err = await client.getHealth().catch((e) => e)\n95:     expect(err.message).toMatch(/cannot reach the daemon/)\n96:     expect(err.message).not.toMatch(/cross-origin/i)\n97:   })\n98: \n99:   it('returns raw text for job files', async () => {\n100:     vi.stubGlobal(\n101:       'fetch',\n102:       stubFetch(() => ({ status: 200, body: '# Brief: x\\n', contentType: 'text/markdown' })),\n103:     )\n104:     const text = await client.getJobFile('p', 'j', 'brief')\n105:     expect(text).toBe('# Brief: x\\n')\n106:   })\n107: \n108:   it('encodes URL segments', async () => {\n109:     const f = stubFetch(() => ({ status: 200, body: { jobs: [] } }))\n110:     vi.stubGlobal('fetch', f)\n111:     await client.getJobs('my project')\n112:     expect(f.mock.calls[0][0]).toBe('http://mg.test/projects/my%20project/jobs')\n113:   })\n114: })\n115: \n116: describe('normalizeBaseUrl', () => {\n117:   it('strips trailing slashes and adds http://', () => {\n118:     expect(client.normalizeBaseUrl('127.0.0.1:8080///')).toBe('http://127.0.0.1:8080')\n119:     expect(client.normalizeBaseUrl('https://vps.example.com')).toBe('https://vps.example.com')\n120:     expect(client.normalizeBaseUrl('/api')).toBe('/api')\n121:     expect(client.normalizeBaseUrl('  ')).toBe('')\n122:   })\n123: })\n\n(End of file - total 123 lines)\n</content>","metadata":{"preview":"import { afterEach, describe, expect, it, vi } from 'vitest'\nimport * as client from '$lib/api/client'\n\nfunction stubFetch(handler: (url: string, init?: RequestInit) => { status: number; body: unknown; contentType?: string }) {\n  return vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {\n    const url = String(input)\n    const r = handler(url, init)\n    return new Response(r.body === undefined ? '' : typeof r.body === 'string' ? r.body : JSON.stringify(r.body), {\n      status: r.status,\n      headers: { 'Content-Type': r.contentType ?? 'application/json' },\n    })\n  })\n}\n\nafterEach(() => {\n  vi.unstubAllGlobals()\n  client.setConnection({ baseUrl: 'http://mg.test', token: '' })\n})\n\ndescribe('client', () => {","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/web-ui/src/lib/api/client.test.ts","text":"import { afterEach, describe, expect, it, vi } from 'vitest'\nimport * as client from '$lib/api/client'\n\nfunction stubFetch(handler: (url: string, init?: RequestInit) => { status: number; body: unknown; contentType?: string }) {\n  return vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {\n    const url = String(input)\n    const r = handler(url, init)\n    return new Response(r.body === undefined ? '' : typeof r.body === 'string' ? r.body : JSON.stringify(r.body), {\n      status: r.status,\n      headers: { 'Content-Type': r.contentType ?? 'application/json' },\n    })\n  })\n}\n\nafterEach(() => {\n  vi.unstubAllGlobals()\n  client.setConnection({ baseUrl: 'http://mg.test', token: '' })\n})\n\ndescribe('client', () => {\n  it('sends the bearer token when configured', async () => {\n    const f = stubFetch(() => ({ status: 200, body: { version: '1' } }))\n    vi.stubGlobal('fetch', f)\n    client.setConnection({ baseUrl: 'http://mg.test', token: 'sekret' })\n    await client.getHealth()\n    expect(f).toHaveBeenCalledWith(\n      'http://mg.test/health',\n      expect.objectContaining({\n        headers: expect.objectContaining({ Authorization: 'Bearer sekret' }),\n      }),\n    )\n  })\n\n  it('parses JSON responses', async () => {\n    vi.stubGlobal(\n      'fetch',\n      stubFetch(() => ({ status: 200, body: { projects: [{ name: 'manigot', path: '/x' }] } })),\n    )\n    const res = await client.getProjects()\n    expect(res.projects[0].name).toBe('manigot')\n  })\n\n  it('surfaces the error envelope', async () => {\n    vi.stubGlobal('fetch', stubFetch(() => ({ status: 404, body: { error: 'project not found' } })))\n    await expect(client.getProjects()).rejects.toMatchObject({ status: 404, message: 'project not found' })\n  })\n\n  it('maps 404 to a capability miss', async () => {\n    vi.stubGlobal('fetch', stubFetch(() => ({ status: 404, body: { error: 'no route' } })))\n    const err = await client.pruneContainers().catch((e) => e)\n    expect(err.capabilityMiss).toBe(true)\n  })\n\n  it('explains 401 as a token problem', async () => {\n    vi.stubGlobal('fetch', stubFetch(() => ({ status: 401, body: { error: 'unauthorized' } })))\n    await expect(client.getHealth()).rejects.toThrow(/token/i)\n  })\n\n  it('wraps network failure with the base URL', async () => {\n    vi.stubGlobal(\n      'fetch',\n      vi.fn(async () => {\n        throw new TypeError('Failed to fetch')\n      }),\n    )\n    // Same-origin base — the failure is a plain network error, not CORS.\n    client.setConnection({ baseUrl: '/api', token: '' })\n    await expect(client.getHealth()).rejects.toThrow(/cannot reach the daemon/)\n  })\n\n  it('explains cross-origin failure as a CORS block with the /api hint', async () => {\n    vi.stubGlobal(\n      'fetch',\n      vi.fn(async () => {\n        throw new TypeError('Failed to fetch')\n      }),\n    )\n    // jsdom's location.origin is http://localhost:3000 — an absolute daemon\n    // URL on another origin must be flagged as the CORS block it is.\n    client.setConnection({ baseUrl: 'http://127.0.0.1:8080', token: '' })\n    const err = await client.getHealth().catch((e) => e)\n    expect(err.message).toMatch(/cross-origin URL blocked/i)\n    expect(err.message).toContain('/api')\n  })\n\n  it('does not claim CORS for a same-origin base', async () => {\n    vi.stubGlobal(\n      'fetch',\n      vi.fn(async () => {\n        throw new TypeError('Failed to fetch')\n      }),\n    )\n    client.setConnection({ baseUrl: '/api', token: '' })\n    const err = await client.getHealth().catch((e) => e)\n    expect(err.message).toMatch(/cannot reach the daemon/)\n    expect(err.message).not.toMatch(/cross-origin/i)\n  })\n\n  it('returns raw text for job files', async () => {\n    vi.stubGlobal(\n      'fetch',\n      stubFetch(() => ({ status: 200, body: '# Brief: x\\n', contentType: 'text/markdown' })),\n    )\n    const text = await client.getJobFile('p', 'j', 'brief')\n    expect(text).toBe('# Brief: x\\n')\n  })\n\n  it('encodes URL segments', async () => {\n    const f = stubFetch(() => ({ status: 200, body: { jobs: [] } }))\n    vi.stubGlobal('fetch', f)\n    await client.getJobs('my project')\n    expect(f.mock.calls[0][0]).toBe('http://mg.test/projects/my%20project/jobs')\n  })\n})\n\ndescribe('normalizeBaseUrl', () => {\n  it('strips trailing slashes and adds http://', () => {\n    expect(client.normalizeBaseUrl('127.0.0.1:8080///')).toBe('http://127.0.0.1:8080')\n    expect(client.normalizeBaseUrl('https://vps.example.com')).toBe('https://vps.example.com')\n    expect(client.normalizeBaseUrl('/api')).toBe('/api')\n    expect(client.normalizeBaseUrl('  ')).toBe('')\n  })\n})","lineStart":1,"lineEnd":123,"totalLines":123,"truncated":false}},"title":"web-ui/src/lib/api/client.test.ts","time":{"start":1787992723688,"end":1787992723700}},"id":"prt_04cabd0e00016EKMDvgzpw7pnm","sessionID":"ses_fb3594f94ffeQ3bCtRbhDqaOUL","messageID":"msg_04caa99bb001k8qlGPviY70dDY"}}
