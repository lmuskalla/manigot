\n159:     padding: var(--r-4) var(--r-5);\n160:   }\n161:   .panel-head h2 {\n162:     font-size: 15.5px;\n163:     margin-bottom: 2px;\n164:   }\n165:   .panel-head {\n166:     margin-bottom: var(--r-3);\n167:   }\n168:   .sub {\n169:     color: var(--ink-2);\n170:     font-size: 13px;\n171:   }\n172:   .sub code {\n173:     color: var(--accent-bright);\n174:   }\n175: \n176:   .row {\n177:     display: flex;\n178:     justify-content: space-between;\n179:     gap: var(--r-4);\n180:     padding: 7px 0;\n181:     border-bottom: 1px solid var(--line);\n182:     font-size: 13.5px;\n183:   }\n184:   .row:last-child {\n185:     border-bottom: none;\n186:   }\n187:   .k {\n188:     color: var(--ink-2);\n189:     font-family: var(--font-mono);\n190:     font-size: 12px;\n191:     letter-spacing: 0.06em;\n192:     text-transform: uppercase;\n193:   }\n194:   .v {\n195:     color: var(--ink-0);\n196:   }\n197:   .mono {\n198:     font-family: var(--font-mono);\n199:     font-size: 12.5px;\n200:   }\n201: \n202:   .profiles {\n203:     list-style: none;\n204:     margin: 0;\n205:     padding: 0;\n206:     display: grid;\n207:     grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));\n208:     gap: var(--r-2);\n209:   }\n210:   .profile {\n211:     display: flex;\n212:     align-items: center;\n213:     gap: 9px;\n214:     background: var(--bg-2);\n215:     border: 1px solid var(--line);\n216:     border-radius: var(--radius-s);\n217:     padding: 8px 12px;\n218:     font-size: 12.5px;\n219:   }\n220:   .p-dot {\n221:     width: 8px;\n222:     height: 8px;\n223:     border-radius: 50%;\n224:     background: var(--ink-3);\n225:     flex: none;\n226:   }\n227:   .profile.ready .p-dot {\n228:     background: var(--st-done);\n229:     box-shadow: 0 0 6px rgba(76, 195, 138, 0.5);\n230:   }\n231:   .p-name {\n232:     color: var(--ink-0);\n233:   }\n234:   .p-state {\n235:     margin-left: auto;\n236:     color: var(--ink-2);\n237:     font-size: 11.5px;\n238:   }\n239:   