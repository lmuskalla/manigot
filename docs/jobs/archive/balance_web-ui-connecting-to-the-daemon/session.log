 jobs: (p: string) => `/projects/${p}/jobs`,\\n16:   job: (p: string, j: string) => `/projects/${p}/jobs/${j}`,\\n17:   file: (p: string, j: string, f: string) => `/projects/${p}/jobs/${j}/files/${f}`,\\n18:   jdi: (p: string, j: string) => `/projects/${p}/jobs/${j}/jdi`,\\n19:   diff: (p: string, j: string) => `/projects/${p}/jobs/${j}/diff`,\\n20:   agents: (p: string) => `/projects/${p}/agents`,\\n21: \\n22:   // ── Part 2 (job two) ────────────────────────────────────────────────────\\n23:   createJob: (p: string) => `/projects/${p}/jobs`, // POST\\n24:   saveBrief: (p: string, j: string) => `/projects/${p}/jobs/${j}/files/brief`, // PUT\\n25:   launchAgent: (p: string, j: string, agent: string) =>\\n26:     `/projects/${p}/jobs/${j}/agents/${agent}/launch`, // POST\\n27:   startJdi: (p: string, j: string) => `/projects/${p}/jobs/${j}/jdi/start`, // POST\\n28:   doneJob: (p: string, j: string) => `/projects/${p}/jobs/${j}/done`, // POST\\n29:   deleteJob: (p: string, j: string) => `/projects/${p}/jobs/${j}/delete`, // POST\\n30:   pushJob: (p: string, j: string) => `/projects/${p}/jobs/${j}/push`, // POST\\n31:   orphans: (p: string) => `/projects/${p}/orphans`, // GET\\n32:   removeOrphans: (p: string) => `/projects/${p}/orphans/remove`, // POST\\n33:   pruneContainers: () => `/prune`, // POST — daemon-wide (docker), not per project\\n34:   sessionStream: (p: string, j: string) => `/projects/${p}/jobs/${j}/session-log/stream`, // GET SSE\\n35: }\\n36: \\n37: /** Escape a URL segment conservatively (names are id_slug identifiers). */\\n38: export function seg(s: string): string {\\n39:   return encodeURIComponent(s)\\n40: }\\n\\n(End of file - total 40 lines)\\n</content>\",\"metadata\":{\"preview\":\"// Endpoint paths — the single seam against the daemon.\\n//\\n// Part 1 paths are shipped (src/internal/serve/server.go routes). Part 2\\n// paths follow the job-two brief (\\\"create a job\\\", \\\"edit brief.md\\\", \\\"launch\\n// agent detached via the --print path\\\", \\\"launch mg jdi detached\\\", \\\"done /\\n// delete / push\\\", \\\"orphan cleanup\\\", \\\"stream session.log\\\"); when the pipeline\\n// job lands, re-pin anything that drifted HERE and nowhere else.\\n//\\n// Part 2 endpoints are expected to answer 404/405 on a Part 1-only daemon;\\n// the client surfaces that as a capability miss, not a crash (see client.ts).\\n\\nexport const ep = {\\n  health: '/health',\\n  projects: '/projects',\\n  jobs: (p: string) => `/projects/${p}/jobs`,\\n  job: (p: string, j: string) => `/projects/${p}/jobs/${j}`,\\n  file: (p: string, j: string, f: string) => `/projects/${p}/jobs/${j}/files/${f}`,\\n  jdi: (p: string, j: string) => `/projects/${p}/jobs/${j}/jdi`,\\n  diff: (p: string, j: string) => `/projects/${p}/jobs/${j}/diff`,\\n  agents: (p: string) => `/projects/${p}/agents`,\",\"truncated\":false,\"loaded\":[],\"display\":{\"type\":\"file\",\"path\":\"/workspace/web-ui/src/lib/api/endpoints.ts\",\"text\":\"// Endpoint paths — the single seam against the daemon.\\n//\\n// Part 1 paths are shipped (src/internal/serve/server.go routes). Part 2\\n// paths follow the job-two brief (\\\"create a job\\\", \\\"edit brief.md\\\", \\\"launch\\n// agent detached via the --print path\\\", \\\"launch mg jdi detached\\\", \\\"done /\\n// delete / push\\\", \\\"orphan cleanup\\\", \\\"stream session.log\\\"); when the pipeline\\n// job lands, re-pin anything that drifted HERE and nowhere else.\\n//\\n// Part 2 endpoints are expected to answer 404/405 on a Part 1-only daemon;\\n// the client surfaces that as a capability miss, not a crash (see client.ts).\\n\\nexport const ep = {\\n  health: '/health',\\n  projects: '/projects',\\n  jobs: (p: string) => `/projects/${p}/jobs`,\\n  job: (p: string, j: string) => `/projects/${p}/jobs/${j}`,\\n  file: (p: string, j: string, f: string) => `/projects/${p}/jobs/${j}/files/${f}`,\\n  jdi: (p: string, j: string) => `/projects/${p}/jobs/${j}/jdi`,\\n  diff: (p: string, j: string) => `/projects/${p}/jobs/${j}/diff`,\\n  agents: (p: string) => `/projects/${p}/agents`,\\n\\n  // ── Part 2 (job two) ────────────────────────────────────────────────────\\n  createJob: (p: string) => `/projects/${p}/jobs`, // POST\\n  saveBrief: (p: string, j: string) => `/projects/${p}/jobs/${j}/files/brief`, // PUT\\n  launchAgent: (p: string, j: string, agent: string) =>\\n    `/projects/${p}/jobs/${j}/agents/${agent}/launch`, // POST\\n  startJdi: (p: string, j: string) => `/projects/${p}/jobs/${j}/jdi/start`, // POST\\n  doneJob: (p: string, j: string) => `/projects/${p}/jobs/${j}/done`, // POST\\n  deleteJob: (p: string, j: string) => `/projects/${p}/jobs/${j}/delete`, // POST\\n  pushJob: (p: string, j: string) => `/projects/${p}/jobs/${j}/push`, // POST\\n  orphans: (p: string) => `/projects/${p}/orphans`, // GET\\n  removeOrphans: (p: string) => `/projects/${p}/orphans/remove`, // POST\\n  pruneContainers: () => `/prune`, // POST — daemon-wide (docker), not per project\\n  sessionStream: (p: string, j: string) => `/projects/${p}/jobs/${j}/session-log/stream`, // GET SSE\\n}\\n\\n/** Escape a URL segment conservatively (names are id_slug identifiers). */\\nexport function seg(s: string): string {\\n  return encodeURIComponent(s)\\n}\",\"lineStart\":1,\"lineEnd\":40,\"totalLines\":40,\"truncated\":false}},\"title\":\"web-ui/src/lib/api/endpoints.ts\",\"time\":{\"start\":1787992538536,\"end\":1787992538554}},\"id\":\"prt_04ca8fda400133YvES3UFAh8St\",\"sessionID\":\"ses_fb3594f94ffeQ3bCtRbhDqaOUL\",\"messageID\":\"msg_04ca817f0001RSXULucWZvIX0u\"}}\n{\"type\":\"text\",\"timestamp\":1787992538990,\"sessionID\":\"ses_fb3594f94ffeQ3bCtRbhD","metadata":{"output":"...\n\n</button>\\n262:     {/snippet}\\n263:   </Modal>\\n264: {/if}\\n265: \\n266: {#if confirmOrphans}\\n267:   <Confirm\\n268:     title=\\\"Remove orphaned worktrees\\\"\\n269:     body={'Remove ' +\\n270:       orphans.length +\\n271:       ' orphaned worktree' +\\n272:       (orphans.length === 1 ? '' : 's') +\\n273:       '?\\\\nThis cannot be undone.'}\\n274:     confirmLabel=\\\"Remove\\\"\\n275:     confirmKind=\\\"danger\\\"\\n276:     busy={removingOrphans}\\n277:     onconfirm={removeOrphans}\\n278:     onclose={() => (confirmOrphans = false)}\\n279:   />\\n280: {/if}\\n281: \\n282: <style>\\n283:   .page {\\n284:     padding: var(--r-6) var(--r-6) var(--r-7);\\n285:     max-width: 1060px;\\n286:     margin: 0 auto;\\n287:     width: 100%;\\n288:   }\\n289: \\n290:   .head {\\n291:     display: flex;\\n292:     align-items: flex-end;\\n293:     justify-content: space-between;\\n294:     gap: var(--r-4);\\n295:     flex-wrap: wrap;\\n296:     margin-bottom: var(--r-4);\\n297:   }\\n298:   h1 {\\n299:     font-size: 24px;\\n300:     letter-spacing: -0.02em;\\n301:   }\\n302:   .head .eyebrow {\\n303:     margin: 0 0 2px;\\n304:   }\\n305:   .head-actions {\\n306:     display: flex;\\n307:     gap: var(--r-2);\\n308:     align-items: center;\\n309:   }\\n310:   .search {\\n311:     width: min(280px, 60vw);\\n312:   }\\n313: \\n314:   .filters {\\n315:     display: flex;\\n316:     gap: var(--r-3);\\n317:     flex-wrap: wrap;\\n318:     margin-bottom: var(--r-4);\\n319:   }\\n320: \\n321:   .error {\\n322:     background: var(--st-human-dim);\\n323:     border: 1px solid rgba(242, 85, 90, 0.4);\\n324:     color: #ffb3b6;\\n325:     padding: var(--r-3) var(--r-4);\\n326:     border-radius: var(--radius-m);\\n327:     font-size: 13.5px;\\n328:     margin-bottom: var(--r-4);\\n329:   }\\n330: \\n331:   .jobs {\\n332:     list-style: none;\\n333:     margin: 0;\\n334:     padding: 0;\\n335:     display: flex;\\n336:     flex-direction: column;\\n337:     gap: 8px;\\n338:   }\\n339: \\n340:   .job {\\n341:     display: flex;\\n342:     align-items: center;\\n343:     justify-content: space-between;\\n344:     gap: var(--r-3) var(--r-4);\\n345:     flex-wrap: wrap;\\n346:     padding: 14px 18px;\\n347:     background: var(--bg-1);\\n348:     border: 1px solid var(--line);\\n349:     border-radius: var(--radius-m);\\n350:     text-decoration: none;\\n351:     color: var(--ink-0);\\n352:     transition:\\n353:       border-color var(--t-fast),\\n354:       background var(--t-fast),\\n355:       transform var(--t-fast);\\n356:   }\\n357:   .job:hover {\\n358:     border-color: var(--line-strong);\\n359:     background: var(--bg-2);\\n360:     text-decoration: none;\\n361:     transform: translateY(-1px);\\n362:   }\\n363:   .job.needs-human {\\n364:     border-color: rgba(242, 85, 90, 0.4);\\n365:     background: linear-gradient(90deg, rgba(242, 85, 90, 0.05), transparent 200px), var(--bg-1);\\n366:   }\\n367: \\n368:   .left {\\n369:     display: flex;\\n370:     align-items: center;\\n371:     gap: var(--r-5);\\n372:     min-width: 0;\\n373:     flex: 1 1 240px; /* below 240px of text room, the meta column wraps under */\\n374:   }\\n375:   .ident {\\n376:     display: flex;\\n377:     flex-direction: column;\\n378:     min-width: 0;\\n379:   }\\n380:   .title {\\n381:     font-weight: 590;\\n382:     font-size: 15px;\\n383:     white-space: nowrap;\\n384:     overflow: hidden;\\n385:     text-overflow: ellipsis;\\n386:   }\\n387:   .name {\\n388:     font-family: var(--font-mono);\\n389:     font-size: 12px;\\n390:     color: var(--ink-2);\\n391:     white-space: nowrap;\\n392:     overflow: hidden;\\n393:     text-overflow: ellipsis;\\n394:   }\\n395: \\n396:   .meta {\\n397:     display: flex;\\n398:     align-items: center;\\n399:     gap: 8px;\\n400:     flex: 0 1 auto;\\n401:     flex-wrap: wrap;\\n402:   }\\n403:   .when {\\n404:     font-size: 12px;\\n405:     color: var(--ink-2);\\n406:     min-width: 70px;\\n407:     text-align: right;\\n408:   }\\n409: \\n410:   .orphans {\\n411:     margin-top: var(--r-6);\\n412:     border: 1px dashed var(--line-strong);\\n413:     border-radius: var(--radius-m);\\n414:     padding: var(--r-4) var(--r-5);\\n415:   }\\n416:   .orphans-head {\\n417:     display: flex;\\n418:     justify-content: space-between;\\n419:     align-items: flex-start;\\n420:     gap: var(--r-4);\\n421:   }\\n422:   .orphans h2 {\\n423:     font-size: 16px;\\n424:   }\\n425:   .hint {\\n426:     color: var(--ink-2);\\n427:     font-size: 13px;\\n428:     max-width: 52ch;\\n429:   }\\n430:   .orphans ul {\\n431:     list-style: none;\\n432:     margin: var(--r-3) 0 0;\\n433:     padding: 0;\\n434:     display: flex;\\n435:     flex-direction: column;\\n436:     gap: 4px;\\n437:   }\\n438:   .orphans code {\\n439:     color: var(--st-open);\\n440:     font-size: 12.5px;\\n441:   }\\n442: \\n443:   @media (max-width: 760px) {\\n444:     .page {\\n445:       padding: var(--r-4) var(--r-4) var(--r-6);\\n446:     }\\n447:     .job {\\n448:       flex-direction: column;\\n449:       align-items: flex-start;\\n450:       gap: var(--r-3);\\n451:     }\\n452:     .left {\\n453:       flex-direction: column;\\n454:       align-items: flex-start;\\n455:       gap: var(--r-2);\\n456:       flex: none;\\n457:       width: 100%;\\n458:     }\\n459:     .ident {\\n460:       width: 100%;\\n461:     }\\n462:     .meta {\\n463:       flex-wrap: wrap;\\n464:     }\\n465:     .when {\\n466:       text-align: left;\\n467:       min-width: 0;\\n468:     }\\n469:     .search {\\n470:       width: 100%;\\n471:     }\\n472:     .head-actions {\\n473:       width: 100%;\\n474:     }\\n475:   }\\n476: </style>\\n\\n(End of file - total 476 lines)\\n</content>\",\"metadata\":{\"preview\":\"<script lang=\\\"ts\\\">\\n  import { onMount } from 'svelte'\\n  import Pipeline from '$lib/components/Pipeline.svelte'\\n  import EmptyState from '$lib/components/EmptyState.svelte'\\n  import Modal from '$lib/components/Modal.svelte'\\n  import Confirm from '$lib/components/Confirm.svelte'\\n  import { data } from '$lib/state/data.svelte'\\n  import { toasts } from '$lib/state/toasts.svelte'\\n  import { attention } from '$lib/stage'\\n  import { relativeTime } from '$lib/time'\\n  import { href } from '$lib/router'\\n  import * as api from '$lib/api/client'\\n  import type { JobRow, OrphanRow } from '$lib/api/types'\\n\\n  let { project }: { project: string } = $props()\\n\\n  let filter = $state<'all' | 'human' | 'running'>('all')\\n  let typeFilter = $state('')\\n  let search = $state('')\\n  let showNew = $state(false)\",\"truncated\":false,\"loaded\":[],\"display\":{\"type\":\"file\",\"path\":\"/workspace/web-ui/src/lib/views/JobsView.svelte\",\"text\":\"<script lang=\\\"ts\\\">\\n  import { onMount } from 'svelte'\\n  import Pipeline from '$lib/components/Pipeline.svelte'\\n  import EmptyState from '$lib/components/EmptyState.svelte'\\n  import Modal from '$lib/components/Modal.svelte'\\n  import Confirm from '$lib/components/Confirm.svelte'\\n  import { data } from '$lib/state/data.svelte'\\n  import { toasts } from '$lib/state/toasts.svelte'\\n  import { attention } from '$lib/stage'\\n  import { relativeTime } from '$lib/time'\\n  import { href } from '$lib/router'\\n  import * as api from '$lib/api/client'\\n  import type { JobRow, OrphanRow } from '$lib/api/types'\\n\\n  let { project }: { project: string } = $props()\\n\\n  let filter = $state<'all' | 'human' | 'running'>('all')\\n  let typeFilter = $state('')\\n  let search = $state('')\\n  let showNew = $state(false)\\n\\n  // new-job form\\n  let newTitle = $state('')\\n  let newType = $state('feature')\\n  let creating = $state(false)\\n\\n  // orphans (Part 2 — silently absent on a read-only daemon)\\n  let orphans = $state<OrphanRow[]>([])\\n  let orphansAvailable = $state(true)\\n  let confirmOrphans = $state(false)\\n  let removingOrphans = $state(false)\\n\\n  $effect(() => {\\n    // reload the list when the route's project changes\\n    project\\n    void data.refreshJobs()\\n    void loadOrphans()\\n  })\\n\\n  onMount(() => {\\n    data.startPolling()\\n    return () => data.stopPolling()\\n  })\\n\\n  async function loadOrphans() {\\n    try {\\n      const res = await api.getOrphans(project)\\n      orphans = res.orphans ?? []\\n      orphansAvailable = true\\n    } catch {\\n      orphans = []\\n      orphansAvailable = false\\n    }\\n  }\\n\\n  const filtered = $derived.by(() => {\\n    let jobs = data.active === project ? data.jobs : []\\n    if (filter === 'human') jobs = jobs.filter((j) => j.jdi?.state === 'stopped:needs-human')\\n    if (filter === 'running') jobs = jobs.filter((j) => j.jdi?.state === 'running')\\n    if (typeFilter) jobs = jobs.filter((j) => j.type === typeFilter)\\n    const needle = search.trim().toLowerCase()\\n    if (needle) {\\n      jobs = jobs.filter(\\n        (j) =>\\n          j.title.toLowerCase().includes(needle) ||\\n          j.name.toLowerCase().includes(needle) ||\\n          j.id.toLowerCase().includes(needle),\\n      )\\n    }\\n    return [...jobs].sort((a, b) => attention(a).level - attention(b).level)\\n  })\\n\\n  const counts = $derived.by(() => {\\n    const jobs = data.active === project ? data.jobs : []\\n    return {\\n      all: jobs.length,\\n      human: jobs.filter((j) => j.jdi?.state === 'stopped:needs-human').length,\\n      running: jobs.filter((j) => j.jdi?.state === 'running').length,\\n    }\\n  })\\n\\n  async function createJob() {\\n    creating = true\\n    try {\\n      const res = await api.createJob(project, newTitle.trim(), newType)\\n      toasts.ok(`Job scaffolded — ${typeof res.job === 'string' ? res.job : res.job?.name ?? newTitle}`)\\n      showNew = false\\n      newTitle = ''\\n      newType = 'feature'\\n      await data.refreshJobs()\\n    } catch (e) {\\n      toasts.error(actionError(e, 'create jobs'))\\n    } finally {\\n      creating = false\\n    }\\n  }\\n\\n  async function removeOrphans() {\\n    removingOrphans = true\\n    try {\\n      const res = await api.removeOrphans(project)\\n      toasts.ok(res.message ?? 'Orphaned worktrees removed')\\n      confirmOrphans = false\\n      await loadOrphans()\\n    } catch (e) {\\n      toasts.error(actionError(e, 'remove orphans'))\\n    } finally {\\n      removingOrphans = false\\n    }\\n  }\\n\\n  /** Degrade path: Part 2 calls on a Part 1 daemon read as a clear miss. */\\n  function actionError(e: unknown, what: string): string {\\n    if (e instanceof api.ApiError && e.capabilityMiss) {\\n      return `This daemon does not expose ${what} yet — mutating endpoints land with job two of the control plane.`\\n    }\\n    return e instanceof Error ? e.message : String(e)\\n  }\\n</script>\\n\\n<div class=\\\"page\\\">\\n  <header class=\\\"head\\\">\\n    <div>\\n      <p class=\\\"eyebrow\\\">jobs</p>\\n      <h1>{project}</h1>\\n    </div>\\n    <div class=\\\"head-actions\\\">\\n      <input\\n        class=\\\"input search\\\"\\n        placeholder=\\\"Filter by title, name, id…\\\"\\n        bind:value={search}\\n        spellcheck=\\\"false\\\"\\n        aria-label=\\\"Filter jobs\\\"\\n      />\\n      <button class=\\\"btn btn-primary\\\" onclick={() => (showNew = true)}>＋ New job</button>\\n    </div>\\n  </header>\\n\\n  <div class=\\\"filters\\\">\\n    <div class=\\\"seg-group\\\" role=\\\"group\\\" aria-label=\\\"Filter by run state\\\">\\n      <button aria-pressed={filter === 'all'} onclick={() => (filter = 'all')}>\\n        All {counts.all}\\n      </button>\\n      <button aria-pressed={filter === 'human'} onclick={() => (filter = 'human')}>\\n        Needs human {counts.human}\\n      </button>\\n      <button aria-pressed={filter === 'running'} onclick={() => (filter = 'running')}>\\n        Running {counts.running}\\n      </button>\\n    </div>\\n    <div class=\\\"seg-group\\\" role=\\\"group\\\" aria-label=\\\"Filter by type\\\">\\n      <button aria-pressed={typeFilter === ''} onclick={() => (typeFilter = '')}>any type</button>\\n      {#each ['feature', 'fix', 'chore'] as t (t)}\\n        <button aria-pressed={typeFilter === t} onclick={() => (typeFilter = t)}>{t}</button>\\n      {/each}\\n    </div>\\n  </div>\\n\\n  {#if data.jobsError}\\n    <div class=\\\"error\\\" role=\\\"alert\\\">{data.jobsError}</div>\\n  {/if}\\n\\n  {#if filtered.length === 0 && !data.loadingJobs && !data.jobsError}\\n    <EmptyState\\n      title={data.jobs.length === 0 ? 'No open jobs' : 'Nothing matches'}\\n      hint={data.jobs.length === 0\\n        ? 'A job scaffolds brief.md, a branch and its own worktree — everything the crew needs to start.'\\n        : 'Loosen the filters or clear the search.'}\\n    >\\n      {#snippet children()}\\n        {#if data.jobs.length === 0}\\n          <button class=\\\"btn\\\" onclick={() => (showNew = true)}>Scaffold the first job</button>\\n        {/if}\\n      {/snippet}\\n    </EmptyState>\\n  {:else}\\n    <ul class=\\\"jobs\\\" role=\\\"list\\\">\\n      {#each filtered as job (job.name)}\\n        <li>\\n          <a\\n            class=\\\"job\\\"\\n            class:needs-human={job.jdi?.state === 'stopped:needs-human'}\\n            href={href({ name: 'job', project, job: job.name })}\\n          >\\n            <div class=\\\"left\\\">\\n              <Pipeline stage={job.stage} jdi={job.jdi} variant=\\\"mini\\\" />\\n              <div class=\\\"ident\\\">\\n                <span class=\\\"title\\\">{job.title}</span>\\n                <span class=\\\"name\\\">{job.name}</span>\\n              </div>\\n            </div>\\n            <div class=\\\"meta\\\">\\n              {#if job.jdi?.state === 'stopped:needs-human'}\\n                <span class=\\\"chip chip-human\\\"><span class=\\\"dot\\\"></span> needs human</span>\\n              {:else if job.jdi?.state === 'running'}\\n                <span class=\\\"chip chip-running\\\"><span class=\\\"dot\\\"></span> {job.jdi.agent} running</span>\\n              {/if}\\n              <span class=\\\"chip\\\" class:chip-open={job.status === 'open'} class:chip-done={job.status === 'done'}>\\n                <span class=\\\"dot\\\"></span> {job.status}\\n              </span>\\n              <span class=\\\"chip chip-neutral\\\">{job.type}</span>\\n              <span class=\\\"when\\\" title={job.jdi ? job.jdi.updated : job.date}>\\n                {job.jdi ? relativeTime(job.jdi.updated) : job.date}\\n              </span>\\n            </div>\\n          </a>\\n        </li>\\n      {/each}\\n    </ul>\\n  {/if}\\n\\n  {#if orphans.length > 0}\\n    <section class=\\\"orphans\\\" aria-label=\\\"Orphaned worktrees\\\">\\n      <div class=\\\"orphans-head\\\">\\n        <div>\\n          <p class=\\\"eyebrow\\\">leftovers</p>\\n          <h2>Orphaned worktrees</h2>\\n          <p class=\\\"hint\\\">\\n            Directories whose git registration is gone — safe to remove; their jobs are already abandoned.\\n          </p>\\n        </div>\\n        <button class=\\\"btn\\\" onclick={() => (confirmOrphans = true)}>Clean up…</button>\\n      </div>\\n      <ul>\\n        {#each orphans as o (o.name)}\\n          <li><code>{o.name}</code></li>\\n        {/each}\\n      </ul>\\n    </section>\\n  {:else if !orphansAvailable}\\n    <!-- Part 2 endpoint absent on this daemon — nothing to show. -->\\n  {/if}\\n</div>\\n\\n{#if showNew}\\n  <Modal title=\\\"New job\\\" busy={creating} onclose={() => (showNew = false)} width=\\\"480px\\\">\\n    <div class=\\\"field\\\">\\n      <label for=\\\"nj-title\\\">title</label>\\n      <input\\n        id=\\\"nj-title\\\"\\n        class=\\\"input\\\"\\n        bind:value={newTitle}\\n        placeholder=\\\"What is this job about?\\\"\\n        onkeydown={(e) => e.key === 'Enter' && newTitle.trim() && createJob()}\\n      />\\n      <p class=\\\"hint\\\">The title seeds the slug — keep it short and plain.</p>\\n    </div>\\n    <div class=\\\"field\\\">\\n      <label for=\\\"nj-type\\\">type</label>\\n      <select id=\\\"nj-type\\\" class=\\\"select\\\" bind:value={newType}>\\n        <option value=\\\"feature\\\">feature — new capability</option>\\n        <option value=\\\"fix\\\">fix — something is broken</option>\\n        <option value=\\\"chore\\\">chore — cleanup, deps, tooling</option>\\n      </select>\\n    </div>\\n    {#snippet footer()}\\n      <button class=\\\"btn\\\" onclick={() => (showNew = false)} disabled={creating}>Cancel</button>\\n      <button class=\\\"btn btn-primary\\\" onclick={createJob} disabled={creating || !newTitle.trim()}>\\n        {#if creating}<span class=\\\"spin\\\" aria-hidden=\\\"true\\\"></span>{/if}\\n        Scaffold job\\n      </button>\\n    {/snippet}\\n  </Modal>\\n{/if}\\n\\n{#if confirmOrphans}\\n  <Confirm\\n    title=\\\"Remove orphaned worktrees\\\"\\n    body={'Remove ' +\\n      orphans.length +\\n      ' orphaned worktree' +\\n      (orphans.length === 1 ? '' : 's') +\\n      '?\\\\nThis cannot be undone.'}\\n    confirmLabel=\\\"Remove\\\"\\n    confirmKind=\\\"danger\\\"\\n    busy={removingOrphans}\\n    onconfirm={removeOrphans}\\n    onclose={() => (confirmOrphans = false)}\\n  />\\n{/if}\\n\\n<style>\\n  .page {\\n    padding: var(--r-6) var(--r-6) var(--r-7);\\n    max-width: 1060px;\\n    margin: 0 auto;\\n    width: 100%;\\n  }\\n\\n  .head {\\n    display: flex;\\n    align-items: flex-end;\\n    justify-content: space-between;\\n    gap: var(--r-4);\\n    flex-wrap: wrap;\\n    margin-bottom: var(--r-4);\\n  }\\n  h1 {\\n    font-size: 24px;\\n    letter-spacing: -0.02em;\\n  }\\n  .head .eyebrow {\\n    margin: 0 0 2px;\\n  }\\n  .head-actions {\\n    display: flex;\\n    gap: var(--r-2);\\n    align-items: center;\\n  }\\n  .search {\\n    width: min(280px, 60vw);\\n  }\\n\\n  .filters {\\n    display: flex;\\n    gap: var(--r-3);\\n    flex-wrap: wrap;\\n    margin-bottom: var(--r-4);\\n  }\\n\\n  .error {\\n    background: var(--st-human-dim);\\n    border: 1px solid rgba(242, 85, 90, 0.4);\\n    color: #ffb3b6;\\n    padding: var(--r-3) var(--r-4);\\n    border-radius: var(--radius-m);\\n    font-size: 13.5px;\\n    margin-bottom: var(--r-4);\\n  }\\n\\n  .jobs {\\n    list-style: none;\\n    margin: 0;\\n    padding: 0;\\n    display: flex;\\n    flex-direction: column;\\n    gap: 8px;\\n  }\\n\\n  .job {\\n    display: flex;\\n    align-items: center;\\n    justify-content: space-between;\\n    gap: var(--r-3) var(--r-4);\\n    flex-wrap: wrap;\\n    padding: 14px 18px;\\n    background: var(--bg-1);\\n    border: 1px solid var(--line);\\n    border-radius: var(--radius-m);\\n    text-decoration: none;\\n    color: var(--ink-0);\\n    transition:\\n      border-color var(--t-fast),\\n      background var(--t-fast),\\n      transform var(--t-fast);\\n  }\\n  .job:hover {\\n    border-color: var(--line-strong);\\n    background: var(--bg-2);\\n    text-decoration: none;\\n    transform: translateY(-1px);\\n  }\\n  .job.needs-human {\\n    border-color: rgba(242, 85, 90, 0.4);\\n    background: linear-gradient(90deg, rgba(242, 85, 90, 0.05), transparent 200px), var(--bg-1);\\n  }\\n\\n  .left {\\n    display: flex;\\n    align-items: center;\\n    gap: var(--r-5);\\n    min-width: 0;\\n    flex: 1 1 240px; /* below 240px of text room, the meta column wraps under */\\n  }\\n  .ident {\\n    display: flex;\\n    flex-direction: column;\\n    min-width: 0;\\n  }\\n  .title {\\n    font-weight: 590;\\n    font-size: 15px;\\n    white-space: nowrap;\\n    overflow: hidden;\\n    text-overflow: ellipsis;\\n  }\\n  .name {\\n    font-family: var(--font-mono);\\n    font-size: 12px;\\n    color: var(--ink-2);\\n    white-space: nowrap;\\n    overflow: hidden;\\n    text-overflow: ellipsis;\\n  }\\n\\n  .meta {\\n    display: flex;\\n    align-items: center;\\n    gap: 8px;\\n    flex: 0 1 auto;\\n    flex-wrap: wrap;\\n  }\\n  .when {\\n    font-size: 12px;\\n    color: var(--ink-2);\\n    min-width: 70px;\\n    text-align: right;\\n  }\\n\\n  .orphans {\\n    margin-top: var(--r-6);\\n    border: 1px dashed var(--line-strong);\\n    border-radius: var(--radius-m);\\n    padding: var(--r-4) var(--r-5);\\n  }\\n  .orphans-head {\\n    display: flex;\\n    justify-content: space-between;\\n    align-items: flex-start;\\n    gap: var(--r-4);\\n  }\\n  .orphans h2 {\\n    font-size: 16px;\\n  }\\n  .hint {\\n    color: var(--ink-2);\\n    font-size: 13px;\\n    max-width: 52ch;\\n  }\\n  .orphans ul {\\n    list-style: none;\\n    margin: var(--r-3) 0 0;\\n    padding: 0;\\n    display: flex;\\n    flex-direction: column;\\n    gap: 4px;\\n  }\\n  .orphans code {\\n    color: var(--st-open);\\n    font-size: 12.5px;\\n  }\\n\\n  @media (max-width: 760px) {\\n    .page {\\n      padding: var(--r-4) var(--r-4) var(--r-6);\\n    }\\n    .job {\\n      flex-direction: column;\\n      align-items: flex-start;\\n      gap: var(--r-3);\\n    }\\n    .left {\\n      flex-direction: column;\\n      align-items: flex-start;\\n      gap: var(--r-2);\\n      flex: none;\\n      width: 100%;\\n    }\\n    .ident {\\n      width: 100%;\\n    }\\n    .meta {\\n      flex-wrap: wrap;\\n    }\\n    .when {\\n      text-align: left;\\n      min-width: 0;\\n    }\\n    .search {\\n      width: 100%;\\n    }\\n    .head-actions {\\n      width: 100%;\\n    }\\n  }\\n</style>\",\"lineStart\":1,\"lineEnd\":476,\"totalLines\":476,\"truncated\":false}},\"title\":\"web-ui/src/lib/views/JobsView.svelte\",\"time\":{\"start\":1787992479661,\"end\":1787992479680}},\"id\":\"prt_04ca817a70012h7BaxwUMICKrb\",\"sessionID\":\"ses_fb3594f94ffeQ3bCtRbhDqaOUL\",\"messageID\":\"msg_04ca76efd001H7cZQYNwwBZzpC\"}}\n{\"type\":\"step_finish\",\"timestamp\":1787992479730,\"sessionID\":\"ses_fb3594f94ffeQ3bCtRbhDqaOUL\",\"part\":{\"id\":\"prt_04ca817e5001luHjmqA42Qs7nB\",\"reason\":\"tool-calls\",\"snapshot\":\"\",\"messageID\":\"msg_04ca76efd001H7cZQYNwwBZzpC\",\"sessionID\":\"ses_fb3594f94ffeQ3bCtRbhDqaOUL\",\"type\":\"step-finish\",\"tokens\":{\"total\":53186,\"input\":4823,\"output\":41,\"reasoning\":1666,\"cache\":{\"write\":0,\"read\":46656}},\"cost\":0}}\n{\"type\":\"step_start\",\"timestamp\":1787992485797,\"sessionID\":\"ses_fb3594f94ffeQ3bCtRbhDqaOUL\",\"part\":{\"id\":\"prt_04ca82f9f001GLndk2y11S2ms2\",\"messageID\":\"m