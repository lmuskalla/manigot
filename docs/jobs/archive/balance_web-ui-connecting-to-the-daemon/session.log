s=\"head\">\n    <div>\n      <p class=\"eyebrow\">daemon</p>\n      <h1>mg serve</h1>\n    </div>\n    <button class=\"btn\" onclick={() => (showSettings = true)}>Connection…</button>\n  </header>\n\n  {#if connection.status === 'up' && connection.health}\n    <section class=\"panel\">\n      <div class=\"row\">\n        <span class=\"k\">version</span>\n        <span class=\"v mono\">{connection.health.version || '—'}</span>\n      </div>\n      <div class=\"row\">\n        <span class=\"k\">docker image</span>\n        <span class=\"v\">\n          {#if connection.health.imagePresent}\n","exit":0,"truncated":false},"title":"git -C /workspace log --oneline main -- web-ui/src/lib/views/HealthView.svelte | head; echo '==='; git -C /workspace show main:web-ui/src/lib/views/HealthView.svelte 2>/dev/null | sed -n '1,60p'","time":{"start":1787994855865,"end":1787994855868}},"id":"prt_04ccc5829001ucr6Jy5644bsMP","sessionID":"ses_fb3369276ffeikF3KayngIgfbM","messageID":"msg_04ccc1603001pzom7q1bZ0po3U"}}
