{"type":"tool_use","timestamp":1787993737300,"sessionID":"ses_fb3457eb3fferiW9S1l2qfOUfr","part":{"type":"tool","tool":"read","callID":"call_1b481ca215554eed84c53035","state":{"status":"completed","input":{"filePath":"/workspace/web-ui/src/lib/api/client.ts"},"output":"<path>/workspace/web-ui/src/lib/api/client.ts</path>\n<type>file</type>\n<content>\n1: // The API client — one fetch wrapper with the daemon's conventions:\n2: //   · JSON everywhere except job files (raw markdown bodies)\n3: //   · errors as `{ \"error\": \"…\" }` envelopes on every non-2xx\n4: //   · optional bearer token (localhost daemon is tokenless; a remote bind\n5: //     requires one — tokens are configured out-of-band, the API never issues)\n6: //\n7: // Part 2 capability probing: mutating endpoints answer 404/405 on a Part 1\n8: // daemon. The client records that as a capability miss so the UI can render\n9: // \"not available on this daemon\" instead of a raw error — the same frontend\n10: // must work against both daemon generations while job two lands.\n11: \n12: import { ep, seg } from './endpoints'\n13: import type {\n14:   AgentsResponse,\n15:   Health,\n16:   JobDiffResponse,\n17:   JobJdiResponse,\n18:   JobRow,\n19:   JobsResponse,\n20:   LaunchResponse,\n21:   OrphansResponse,\n22:   ProjectsResponse,\n23:   PruneResponse,\n24: } from './types'\n25: \n26: export interface Connection {\n27:   baseUrl: string\n28:   token: string\n29: }\n30: \n31: export class ApiError extends Error {\n32:   status: number\n33:   /** True when the daemon answered \"no such route\" — a Part 2 call on a Part 1 daemon. */\n34:   capabilityMiss: boolean\n35: \n36:   constructor(status: number, message: string) {\n37:     super(message)\n38:     this.name = 'ApiError'\n39:     this.status = status\n40:     this.capabilityMiss = status === 404 || status === 405\n41:   }\n42: }\n43: \n44: export function normalizeBaseUrl(url: string): string {\n45:   const trimmed = url.trim().replace(/\\/+$/, '')\n46:   if (!trimmed) return ''\n47:   if (/^https?:\\/\\//i.test(trimmed)) return trimmed\n48:   // Same-origin (e.g. served by the daemon itself, or behind the vite proxy).\n49:   return trimmed.startsWith('/') ? trimmed : `http://${trimmed}`\n50: }\n51: \n52: let conn: Connection = { baseUrl: '', token: '' }\n53: \n54: export function setConnection(c: Connection) {\n55:   conn = { baseUrl: normalizeBaseUrl(c.baseUrl), token: c.token }\n56: }\n57: \n58: export function getConnection(): Connection {\n59:   return { ...conn }\n60: }\n61: \n62: // ── fetch plumbing ──────────────────────────────────────────────────────────\n63: \n64: type BodyInitLike = string | undefined\n65: \n66: interface ReqOpts {\n67:   body?: BodyInitLike\n68:   contentType?: string\n69:   signal?: AbortSignal\n70: }\n71: \n72: async function request(method: string, path: string, opts: ReqOpts = {}): Promise<string> {\n73:   const headers: Record<string, string> = {}\n74:   if (conn.token) headers['Authorization'] = `Bearer ${conn.token}`\n75:   if (opts.body !== undefined && opts.contentType) headers['Content-Type'] = opts.contentType\n76: \n77:   let res: Response\n78:   try {\n79:     res = await fetch(conn.baseUrl + path, {\n80:       method,\n81:       headers,\n82:       body: opts.body,\n83:       signal: opts.signal,\n84:     })\n85:   } catch (e) {\n86:     if (e instanceof Error && e.name === 'AbortError') throw e\n87:     // A fetch that throws before any response is either a network failure or\n88:     // a CORS block — the two look identical to JS (TypeError \"Failed to\n89:     // fetch\"). The daemon is deliberately CORS-less (same-origin JSON API),\n90:     // so a cross-origin absolute URL can never work from a browser: the\n91:     // request dies in the preflight with no response at all. Surface that\n92:     // as the likely cause so the user reaches for the proxy path (/api)\n93:     // instead of hunting a nonexistent URL typo.\n94:     const target = conn.baseUrl || location.origin\n95:     try {\n96:       if (new URL(target, location.href).origin !== location.origin) {\n97:         throw new ApiError(\n98:           0,\n99:           `cross-origin URL blocked by the browser — the daemon sends no CORS headers by design; in dev set the URL to /api (vite proxies it to 127.0.0.1:8080)`,\n100:         )\n101:       }\n102:     } catch (err) {\n103:       if (err instanceof ApiError) throw err\n104:       /* unparseable base — fall through to the raw fetch error */\n105:     }\n106:     throw new ApiError(\n107:       0,\n108:       `cannot reach the daemon at ${conn.baseUrl || '(same origin)'} — ${e instanceof Error ? e.message : String(e)}`,\n109:     )\n110:   }\n111: \n112:   if (res.status === 401) {\n113:     throw new ApiError(401, 'the daemon rejected the token (401) — check the connection settings')\n114:   }\n115:   if (!res.ok) {\n116:     let msg = `HTTP ${res.status}`\n117:     try {\n118:       const data = (await res.json()) as { error?: string }\n119:       if (data && typeof data.error === 'string' && data.error) msg = data.error\n120:     } catch {\n121:       /* non-JSON error body — keep the status line */\n122:     }\n123:     throw new ApiError(res.status, msg)\n124:   }\n125:   return res.text()\n126: }\n127: \n128: async function json<T>(method: string, path: string, opts: ReqOpts = {}): Promise<T> {\n129:   const text = await request(method, path, opts)\n130:   if (text === '') return undefined as T\n131:   try {\n132:     return JSON.parse(text) as T\n133:   } catch {\n134:     // A 2xx that is not JSON is a mis-pointed connection: the vite dev\n135:     // server (or any static host) happily serves index.html for GET\n136:     // /health. Name it so the user lands on the connection settings\n137:     // instead of a JSON parse error.\n138:     const where = conn.baseUrl || '(same origin)'\n139:     const looksHtml = /^\\s*<(?:!doctype|html|head)\\b/i.test(text)\n140:     throw new ApiError(\n141:       0,\n142:       