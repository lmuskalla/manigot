bs()\n41:   }\n42: \n43:   async refreshJobs(): Promise<void> {\n44:     if (!this.active) return\n45:     this.loadingJobs = true\n46:     try {\n47:       const res = await api.getJobs(this.active)\n48:       this.jobs = res.jobs ?? []\n49:       this.jobsError = ''\n50:     } catch (e) {\n51:       if (e instanceof api.ApiError && e.status === 0) return // aborted / offline — keep last\n52:       this.jobsError = e instanceof Error ? e.message : String(e)\n53:     } finally {\n54:       this.loadingJobs = false\n55:     }\n56:   }\n57: \n58:   startPolling() {\n59:     this.stopPolling()\n60:     const tick = () => {\n61:       if (document.visibilityState === 'visible') void this.refreshJobs()\n62:     }\n63:     this.#jobsTimer = setInterval(tick, POLL_MS)\n64:   }\n65: \n66:   stopPolling() {\n67:     if (this.#jobsTimer) clearInterval(this.#jobsTimer)\n68:     this.#jobsTimer = null\n69:   }\n70: }\n71: \n72: export const data = new DataStore()\n\n(End of file - total 72 lines)\n</content>","metadata":{"preview":"// Data store — projects + the active project's jobs, polled while visible.\n// The TUI re-reads state on a 1s timer; the web client polls every 2s while\n// the tab is visible and pauses when hidden (an SSE future replaces the\n// job-level polling only — the list stays a snapshot API by design).\n\nimport * as api from '$lib/api/client'\nimport type { JobRow, ProjectRow } from '$lib/api/types'\n\nconst POLL_MS = 2000\n\nclass DataStore {\n  projects = $state<ProjectRow[]>([])\n  active = $state<string>('')\n  jobs = $state<JobRow[]>([])\n  loadingProjects = $state(false)\n  loadingJobs = $state(false)\n  jobsError = $state('')\n\n  #jobsTimer: ReturnType<typeof setInterval> | null = null\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/web-ui/src/lib/state/data.svelte.ts","text":"// Data store — projects + the active project's jobs, polled while visible.\n// The TUI re-reads state on a 1s timer; the web client polls every 2s while\n// the tab is visible and pauses when hidden (an SSE future replaces the\n// job-level polling only — the list stays a snapshot API by design).\n\nimport * as api from '$lib/api/client'\nimport type { JobRow, ProjectRow } from '$lib/api/types'\n\nconst POLL_MS = 2000\n\nclass DataStore {\n  projects = $state<ProjectRow[]>([])\n  active = $state<string>('')\n  jobs = $state<JobRow[]>([])\n  loadingProjects = $state(false)\n  loadingJobs = $state(false)\n  jobsError = $state('')\n\n  #jobsTimer: ReturnType<typeof setInterval> | null = null\n\n  async loadProjects(): Promise<void> {\n    this.loadingProjects = true\n    try {\n      const res = await api.getProjects()\n      this.projects = res.projects ?? []\n      if (this.active && this.projects.some((p) => p.name === this.active)) return\n      const remembered = localStorage.getItem('mg-control.project')\n      this.active =\n        this.projects.find((p) => p.name === remembered)?.name ?? this.projects[0]?.name ?? ''\n      if (this.active) localStorage.setItem('mg-control.project', this.active)\n    } finally {\n      this.loadingProjects = false\n    }\n  }\n\n  setActive(project: string) {\n    if (!project || project === this.active) return\n    this.active = project\n    localStorage.setItem('mg-control.project', project)\n    void this.refreshJobs()\n  }\n\n  async refreshJobs(): Promise<void> {\n    if (!this.active) return\n    this.loadingJobs = true\n    try {\n      const res = await api.getJobs(this.active)\n      this.jobs = res.jobs ?? []\n      this.jobsError = ''\n    } catch (e) {\n      if (e instanceof api.ApiError && e.status === 0) return // aborted / offline — keep last\n      this.jobsError = e instanceof Error ? e.message : String(e)\n    } finally {\n      this.loadingJobs = false\n    }\n  }\n\n  startPolling() {\n    this.stopPolling()\n    const tick = () => {\n      if (document.visibilityState === 'visible') void this.refreshJobs()\n    }\n    this.#jobsTimer = setInterval(tick, POLL_MS)\n  }\n\n  stopPolling() {\n    if (this.#jobsTimer) clearInterval(this.#jobsTimer)\n    this.#jobsTimer = null\n  }\n}\n\nexport const data = new DataStore()","lineStart":1,"lineEnd":72,"totalLines":72,"truncated":false}},"title":"web-ui/src/lib/state/data.svelte.ts","time":{"start":1787992416520,"end":1787992416543}},"id":"prt_04ca72104001A51y6oYNyycX90","sessionID":"ses_fb3594f94ffeQ3bCtRbhDqaOUL","messageID":"msg_04ca70958001NzU02ipamtjuBo"}}
