{"type":"tool_use","timestamp":1787995830415,"sessionID":"ses_fb3250779ffe153rxsL511kCsf","part":{"type":"tool","tool":"read","callID":"call_2b6cfa802b344994b7f82a76","state":{"status":"completed","input":{"filePath":"/workspace/web-ui/src/lib/components/SettingsModal.svelte"},"output":"<path>/workspace/web-ui/src/lib/components/SettingsModal.svelte</path>\n<type>file</type>\n<content>\n1: <!-- Settings — where the daemon lives and how to authenticate. The token is -->\n2: <!-- configured out-of-band (mg serve-token / $MG_SERVE_TOKEN); the UI only -->\n3: <!-- remembers it. Never rendered back in full after saving. -->\n4: \n5: <script lang=\"ts\">\n6:   import Modal from './Modal.svelte'\n7:   import { connection } from '$lib/state/connection.svelte'\n8:   import { toasts } from '$lib/state/toasts.svelte'\n9: \n10:   let { onclose }: { onclose: () => void } = $props()\n11: \n12:   let baseUrl = $state(connection.baseUrl)\n13:   let token = $state(connection.token)\n14:   let busy = $state(false)\n15: \n16:   async function save() {\n17:     busy = true\n18:     connection.set(baseUrl, token)\n19:     const ok = await connection.check()\n20:     if (ok) {\n21:       busy = false\n22:       // The establishment bump already reloaded the project list (the\n23:       // App-level effect) — the dropdown fills without a page reload.\n24:       toasts.ok('Connected to the daemon')\n25:       onclose()\n26:     } else {\n27:       busy = false\n28:       // connection.lastError is precise (CORS / unreachable / token / …);\n29:       // surface it instead of a generic \"check the URL\".\n30:       toasts.error(connection.lastError || 'Could not reach the daemon — check the URL')\n31:     }\n32:   }\n33: </script>\n34: \n35: <Modal title=\"Connection\" {busy} {onclose} width=\"460px\">\n36:   <div class=\"field\">\n37:     <label for=\"conn-url\">daemon URL</label>\n38:     <input\n39:       id=\"conn-url\"\n40:       class=\"input\"\n41:       bind:value={baseUrl}\n42:       placeholder=\"http://127.0.0.1:8080\"\n43:       spellcheck=\"false\"\n44:       autocomplete=\"off\"\n45:     />\n46:     <p class=\"hint\">\n47:       The daemon is a same-origin API (no CORS headers) — a cross-origin URL is blocked by the\n48:       browser. When this page runs from the vite dev server, use <code>/api</code>: vite proxies it\n49:       to <code>127.0.0.1:8080</code> for you. Leave empty when the page is served by the daemon\n50:       itself (production, same origin).\n51:     </p>\n52:   </div>\n53:   <div class=\"field\">\n54:     <label for=\"conn-token\">bearer token</label>\n55:     <input\n56:       id=\"conn-token\"\n57:       class=\"input\"\n58:       bind:value={token}\n59:       type=\"password\"\n60:       placeholder=\"tokenless (localhost)\"\n61:       spellcheck=\"false\"\n62:       autocomplete=\"off\"\n63:     />\n64:     <p class=\"hint\">\n65:       A non-loopback bind requires a token (<code>mg serve-token</code> writes one to the daemon's\n66:       .env). Over the open internet, put the daemon behind TLS.\n67:     </p>\n68:   </div>\n69:   {#snippet footer()}\n70:     <button class=\"btn\" onclick={onclose} disabled={busy}>Cancel</button>\n71:     <button class=\"btn btn-primary\" onclick={save} disabled={busy}>\n72:       {#if busy}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n73:       Save and connect\n74:     </button>\n75:   {/snippet}\n76: </Modal>\n77: \n78: <style>\n79:   .hint {\n80:     font-size: 12.5px;\n81:     color: var(--ink-2);\n82:     margin: 0;\n83:     line-height: 1.5;\n84:   }\n85:   .hint code {\n86:     color: var(--ink-1);\n87:   }\n88: </style>\n\n(End of file - total 88 lines)\n</content>","metadata":{"preview":"<!-- Settings — where the daemon lives and how to authenticate. The token is -->\n<!-- configured out-of-band (mg serve-token / $MG_SERVE_TOKEN); the UI only -->\n<!-- remembers it. Never rendered back in full after saving. -->\n\n<script lang=\"ts\">\n  import Modal from './Modal.svelte'\n  import { connection } from '$lib/state/connection.svelte'\n  import { toasts } from '$lib/state/toasts.svelte'\n\n  let { onclose }: { onclose: () => void } = $props()\n\n  let baseUrl = $state(connection.baseUrl)\n  let token = $state(connection.token)\n  let busy = $state(false)\n\n  async function save() {\n    busy = true\n    connection.set(baseUrl, token)\n    const ok = await connection.check()\n    if (ok) {","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/web-ui/src/lib/components/SettingsModal.svelte","text":"<!-- Settings — where the daemon lives and how to authenticate. The token is -->\n<!-- configured out-of-band (mg serve-token / $MG_SERVE_TOKEN); the UI only -->\n<!-- remembers it. Never rendered back in full after saving. -->\n\n<script lang=\"ts\">\n  import Modal from './Modal.svelte'\n  import { connection } from '$lib/state/connection.svelte'\n  import { toasts } from '$lib/state/toasts.svelte'\n\n  let { onclose }: { onclose: () => void } = $props()\n\n  let baseUrl = $state(connection.baseUrl)\n  let token = $state(connection.token)\n  let busy = $state(false)\n\n  async function save() {\n    busy = true\n    connection.set(baseUrl, token)\n    const ok = await connection.check()\n    if (ok) {\n      busy = false\n      // The establishment bump already reloaded the project list (the\n      // App-level effect) — the dropdown fills without a page reload.\n      toasts.ok('Connected to the daemon')\n      onclose()\n    } else {\n      busy = false\n      // connection.lastError is precise (CORS / unreachable / token / …);\n      // surface it instead of a generic \"check the URL\".\n      toasts.error(connection.lastError || 'Could not reach the daemon — check the URL')\n    }\n  }\n</script>\n\n<Modal title=\"Connection\" {busy} {onclose} width=\"460px\">\n  <div class=\"field\">\n    <label for=\"conn-url\">daemon URL</label>\n    <input\n      id=\"conn-url\"\n      class=\"input\"\n      bind:value={baseUrl}\n      placeholder=\"http://127.0.0.1:8080\"\n      spellcheck=\"false\"\n      autocomplete=\"off\"\n    />\n    <p class=\"hint\">\n      The daemon is a same-origin API (no CORS headers) — a cross-origin URL is blocked by the\n      browser. When this page runs from the vite dev server, use <code>/api</code>: vite proxies it\n      to <code>127.0.0.1:8080</code> for you. Leave empty when the page is served by the daemon\n      itself (production, same origin).\n    </p>\n  </div>\n  <div class=\"field\">\n    <label for=\"conn-token\">bearer token</label>\n    <input\n      id=\"conn-token\"\n      class=\"input\"\n      bind:value={token}\n      type=\"password\"\n      placeholder=\"tokenless (localhost)\"\n      spellcheck=\"false\"\n      autocomplete=\"off\"\n    />\n    <p class=\"hint\">\n      A non-loopback bind requires a token (<code>mg serve-token</code> writes one to the daemon's\n      .env). Over the open internet, put the daemon behind TLS.\n    </p>\n  </div>\n  {#snippet footer()}\n    <button class=\"btn\" onclick={onclose} disabled={busy}>Cancel</button>\n    <button class=\"btn btn-primary\" onclick={save} disabled={busy}>\n      {#if busy}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n      Save and connect\n    </button>\n  {/snippet}\n</Modal>\n\n<style>\n  .hint {\n    font-size: 12.5px;\n    color: var(--ink-2);\n    margin: 0;\n    line-height: 1.5;\n  }\n  .hint code {\n    color: var(--ink-1);\n  }\n</style>","lineStart":1,"lineEnd":88,"totalLines":88,"truncated":false}},"title":"web-ui/src/lib/components/SettingsModal.svelte","time":{"start":1787995830401,"end":1787995830413}},"id":"prt_04cdb3805001Ga4z7m7wp2ipH8","sessionID":"ses_fb3250779ffe153rxsL511kCsf","messageID":"msg_04cdb33a8001vwvzufr0Du3Avj"}}
{"type":"tool_use","timestamp":1787995830728,"sessionID":"ses_fb3250779ffe153rxsL511kCsf","part":{"type":"tool","tool":"read","callID":"call_6b5dfb4edb834e6f8dd056fa","state":{"status":"completed","input":{"filePath":"/workspace/web-ui/src/lib/views/JobDetailView.svelte"},"output":"<path>/workspace/web-ui/src/lib/views/JobDetailView.svelte</path>\n<type>file</type>\n<content>\n1: <script lang=\"ts\">\n2:   import { onMount } from 'svelte'\n3:   import Pipeline from '$lib/components/Pipeline.svelte'\n4:   import MarkdownView from '$lib/components/MarkdownView.svelte'\n5:   import Modal from '$lib/components/Modal.svelte'\n6:   import Confirm from '$lib/components/Confirm.svelte'\n7:   import RunConsole from '$lib/components/RunConsole.svelte'\n8:   import DiffView from '$lib/components/DiffView.svelte'\n9:   import { data } from '$lib/state/data.svelte'\n10:   import { toasts } from '$lib/state/toasts.svelte'\n11:   import { navigate, href } from '$lib/router'\n12:   import { relativeTime } from '$lib/time'\n13:   import { verdictStatus } from '$lib/markdown'\n14:   import * as api from '$lib/api/client'\n15:   import type { AgentRow, JobRow } from '$lib/api/types'\n16: \n17:   let { project, jobName, tab = 'brief' }: { project: string; jobName: string; tab?: string } = $props()\n18: \n19:   const TABS = [\n20:     { id: 'brief', label: 'Brief' },\n21:     { id: 'tasks', label: 'Tasks' },\n22:     { id: 'implementation', label: 'Implementation' },\n23:     { id: 'verdict', label: 'Verdict' },\n24:     { id: 'diff', label: 'Diff' },\n25:     { id: 'run', label: 'Run' },\n26:   ] as const\n27: \n28:   const job = $derived<JobRow | undefined>(\n29:     (data.active === project ? data.jobs : []).find(\n30:       (j) => j.name === jobName || j.id === jobName || j.name.startsWith(jobName + '_'),\n31:     ),\n32:   )\n33: \n34:   // file content per tab\n35:   let fileContent = $state('')\n36:   let fileLoading = $state(false)\n37:   let fileMissing = $state(false)\n38: \n39:   // brief editing (Part 2)\n40:   let editing = $state(false)\n41:   let draft = $state('')\n42:   let saving = $state(false)\n43: \n44:   // agents + launches (Part 2)\n45:   let agents = $state<AgentRow[]>([])\n46:   let showAgents = $state(false)\n47:   let agentQuery = $state('')\n48:   let launchingAgent = $state('')\n49:   let profile = $state('')\n50: \n51:   // jdi run\n52:   let showJdi = $state(false)\n53:   let startingJdi = $state(false)\n54: \n55:   // lifecycle confirms\n56:   let confirmKind = $state<null | 'done' | 'delete' | 'push'>(null)\n57:   let lifecycleBusy = $state(false)\n58: \n59:   let verdict = $state('')\n60:   let verdictApproved = $state(false)\n61: \n62:   $effect(() => {\n63:     // (re)load whenever the tab or job changes\n64:     jobName\n65:     void loadTab()\n66:   })\n67: \n68:   onMount(async () => {\n69:     if (data.active !== project) {\n70:       data.setActive(project)\n71:       await data.refreshJobs()\n72:     } else if (!job) {\n73:       await data.refreshJobs() // direct link — the list may not know this job yet\n74:     }\n75:     void loadAgents()\n76:     data.startPolling()\n77:     return () => data.stopPolling()\n78:   })\n79: \n80:   async function loadTab() {\n81:     if (tab === 'diff' || tab === 'run') return\n82:     fileLoading = true\n83:     fileMissing = false\n84:     try {\n85:       fileContent = await api.getJobFile(project, jobName, tab)\n86:       if (tab === 'verdict') {\n87:         verdict = verdictStatus(fileContent)\n88:         verdictApproved = /\\bAPPROVED\\b/i.test(verdict) && !/REJECTED|NEEDS WORK/i.test(verdict)\n89:       }\n90:     } catch {\n91:       fileContent = ''\n92:       fileMissing = true\n93:     } finally {\n94:       fileLoading = false\n95:     }\n96:   }\n97: \n98:   async function loadAgents() {\n99:     try {\n100:       const res = await api.getAgents(project)\n101:       agents = res.agents ?? []\n102:     } catch {\n103:       agents = []\n104:     }\n105:   }\n106: \n107:   function goTab(t: string) {\n108:     navigate(href({ name: 'job', project, job: jobName, tab: t }))\n109:   }\n110: \n111:   function actionError(e: unknown, what: string): string {\n112:     if (e instanceof api.ApiError && e.capabilityMiss) {\n113:       return `This daemon does not expose ${what} yet — mutating endpoints land with job two of the control plane.`\n114:     }\n115:     return e instanceof Error ? e.message : String(e)\n116:   }\n117: \n118:   async function startEdit() {\n119:     draft = fileContent\n120:     editing = true\n121:   }\n122: \n123:   async function saveBrief() {\n124:     saving = true\n125:     try {\n126:       await api.saveBrief(project, jobName, draft)\n127:       toasts.ok('Brief saved')\n128:       editing = false\n129:       fileContent = draft\n130:       await data.refreshJobs()\n131:     } catch (e) {\n132:       toasts.error(actionError(e, 'brief editing'))\n133:     } finally {\n134:       saving = false\n135:     }\n136:   }\n137: \n138:   async function launch(agent: string) {\n139:     launchingAgent = agent\n140:     try {\n141:       const res = await api.launchAgent(project, jobName, agent, profile || undefined)\n142:       toasts.ok(res.message ?? `@${agent} launched detached`)\n143:       showAgents = false\n144:       await data.refreshJobs()\n145:     } catch (e) {\n146:       toasts.error(actionError(e, 'agent launches'))\n147:     } finally {\n148:       launchingAgent = ''\n149:     }\n150:   }\n151: \n152:   async function runJdi() {\n153:     startingJdi = true\n154:     try {\n155:       const res = await api.startJdi(project, jobName, profile || undefined)\n156:       toasts.ok(res.message ?? 'mg jdi detached — watch the Run tab')\n157:       showJdi = false\n158:       goTab('run')\n159:       await data.refreshJobs()\n160:     } catch (e) {\n161:       toasts.error(actionError(e, 'jdi launches'))\n162:     } finally {\n163:       startingJdi = false\n164:     }\n165:   }\n166: \n167:   async function lifecycle(kind: 'done' | 'delete' | 'push') {\n168:     lifecycleBusy = true\n169:     try {\n170:       if (kind === 'done') {\n171:         const res = await api.doneJob(project, jobName)\n172:         toasts.ok(res.message ?? 'Job archived and squash-merged')\n173:       } else if (kind === 'delete') {\n174:         const res = await api.deleteJob(project, jobName)\n175:         toasts.ok(res.message ?? 'Job deleted')\n176:       } else {\n177:         const res = await api.pushJob(project, jobName)\n178:         toasts.ok(res.message ?? 'Branch pushed')\n179:       }\n180:       confirmKind = null\n181:       if (kind === 'delete') navigate(href({ name: 'jobs', project }))\n182:       else await data.refreshJobs()\n183:     } catch (e) {\n184:       toasts.error(actionError(e, kind === 'done' ? 'done' : kind === 'delete' ? 'delete' : 'push'))\n185:     } finally {\n186:       lifecycleBusy = false\n187:     }\n188:   }\n189: \n190:   const filteredAgents = $derived.by(() => {\n191:     const q = agentQuery.trim().toLowerCase()\n192:     if (!q) return agents\n193:     return agents.filter(\n194:       (a) => a.name.toLowerCase().includes(q) || a.description.toLowerCase().includes(q),\n195:     )\n196:   })\n197: \n198:   const needsHuman = $derived(job?.jdi?.state === 'stopped:needs-human')\n199:   const isRunning = $derived(job?.jdi?.state === 'running')\n200: </script>\n201: \n202: <div class=\"detail\">\n203:   <header class=\"head\">\n204:     <a class=\"back\" href={href({ name: 'jobs', project })} aria-label=\"Back to jobs\">←</a>\n205:     <div class=\"titles\">\n206:       <h1>{job?.title ?? jobName}</h1>\n207:       <p class=\"ident\">\n208:         <span class=\"mono\">{job?.name ?? jobName}</span>\n209:         {#if job?.branch}<span class=\"sep\">·</span><span class=\"mono dim\">{job.branch}</span>{/if}\n210:         {#if job}<span class=\"sep\">·</span><span>{job.type}</span>{/if}\n211:         {#if job?.date}<span class=\"sep\">·</span><span class=\"dim\">{job.date}</span>{/if}\n212:         {#if job?.jdi}\n213:           <span class=\"sep\">·</span>\n214:           <span class=\"dim\">{job.jdi.agent} · {relativeTime(job.jdi.updated)}</span>\n215:         {/if}\n216:       </p>\n217:     </div>\n218:     <div class=\"actions\">\n219:       <button class=\"btn\" class:btn-live={isRunning} onclick={() => (showJdi = true)}>\n220:         {#if isRunning}mg jdi running…{:else}Run mg jdi{/if}\n221:       </button>\n222:       <button class=\"btn\" onclick={() => (showAgents = true)}>Launch agent</button>\n223:       <div class=\"more\" role=\"group\" aria-label=\"Lifecycle\">\n224:         <button class=\"btn btn-sm\" onclick={() => (confirmKind = 'push')} disabled={!job?.branch}>\n225:           Push\n226:         </button>\n227:         <button\n228:           class=\"btn btn-sm\"\n229:           class:btn-primary={job?.stage === 'finished'}\n230:           onclick={() => (confirmKind = 'done')}\n231:         >\n232:           Done\n233:         </button>\n234:         <button class=\"btn btn-sm btn-danger\" onclick={() => (confirmKind = 'delete')}>Delete</button>\n235:       </div>\n236:     </div>\n237:   </header>\n238: \n239:   {#if job}\n240:     <div class=\"stage-row\">\n241:       <Pipeline stage={job.stage} jdi={job.jdi} variant=\"full\" />\n242:       {#if job.jdi?.state === 'running'}\n243:         <span class=\"chip chip-running\"><span class=\"dot\"></span> {job.jdi.agent} running</span>\n244:       {:else if needsHuman}\n245:         <span class=\"chip chip-human\"><span class=\"dot\"></span> stopped for a human</span>\n246:       {/if}\n247:     </div>\n248:   {/if}\n249: \n250:   {#if needsHuman}\n251:     <aside class=\"human\" role=\"alert\">\n252:       <div class=\"human-body\">\n253:         <p class=\"eyebrow human-eyebrow\">handoff</p>\n254:         <p class=\"human-text\">\n255:           The run stopped with <code>NEEDS-HUMAN-INPUT</code> — a decision only you can make.\n256:           Answer it in the brief (or the relevant job file), then relaunch the sequence.\n257:         </p>\n258:       </div>\n259:       <div class=\"human-actions\">\n260:         <button class=\"btn\" onclick={() => (tab === 'brief' ? startEdit() : goTab('brief'))}>\n261:           Edit brief\n262:         </button>\n263:         <button class=\"btn btn-primary\" onclick={() => (showJdi = true)}>Relaunch mg jdi</button>\n264:       </div>\n265:     </aside>\n266:   {/if}\n267: \n268:   <nav class=\"tabs\" role=\"tablist\" aria-label=\"Job files\">\n269:     {#each TABS as t (t.id)}\n270:       <button role=\"tab\" aria-selected={tab === t.id} class:active={tab === t.id} onclick={() => goTab(t.id)}>\n271:         {t.label}\n272:         {#if t.id === 'verdict' && verdict && tab !== 'verdict'}\n273:           <span class=\"v-dot\" class:approved={verdictApproved}></span>\n274:         {/if}\n275:       </button>\n276:     {/each}\n277:   </nav>\n278: \n279:   <div class=\"body\" role=\"tabpanel\">\n280:     {#if tab === 'diff'}\n281:       <DiffView {project} job={jobName} />\n282:     {:else if tab === 'run'}\n283:       <RunConsole {project} job={jobName} />\n284:     {:else if editing && tab === 'brief'}\n285:       <div class=\"editor\">\n286:         <textarea\n287:           class=\"textarea\"\n288:           bind:value={draft}\n289:           spellcheck=\"false\"\n290:           aria-label=\"Editing brief.md\"\n291:         ></textarea>\n292:         <div class=\"editor-bar\">\n293:           <span class=\"hint mono\">brief.md — raw markdown replaces the file</span>\n294:           <div class=\"editor-actions\">\n295:             <button class=\"btn\" onclick={() => (editing = false)} disabled={saving}>Cancel</button>\n296:             <button class=\"btn btn-primary\" onclick={saveBrief} disabled={saving}>\n297:               {#if saving}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n298:               Save brief\n299:             </button>\n300:           </div>\n301:         </div>\n302:       </div>\n303:     {:else}\n304:       {#if fileLoading}\n305:         <p class=\"loading\">Reading {tab}.md…</p>\n306:       {:else if fileMissing}\n307:         <div class=\"missing\">\n308:           <p class=\"mono\">no {tab}.md yet</p>\n309:           <p class=\"dim\">\n310:             {#if tab === 'tasks'}The analyst writes this (@analyst, or Run mg jdi).\n311:             {:else if tab === 'implementation'}The developer writes this as tasks complete.\n312:             {:else if tab === 'verdict'}The reviewer writes this after review.\n313:             {:else}The brief is the job's first file.{/if}\n314:           </p>\n315:         </div>\n316:       {:else}\n317:         <MarkdownView source={fileContent} />\n318:         {#if tab === 'brief'}\n319:           <div class=\"file-actions\">\n320:             <button class=\"btn\" onclick={startEdit}>Edit brief</button>\n321:           </div>\n322:         {/if}\n323:         {#if tab === 'verdict' && verdict}\n324:           <p class=\"verdict-line\" class:approved={verdictApproved} class:rejected={!verdictApproved}>\n325:             Verdict: {verdict}\n326:           </p>\n327:         {/if}\n328:       {/if}\n329:     {/if}\n330:   </div>\n331: </div>\n332: \n333: {#if showAgents}\n334:   <Modal title=\"Launch agent\" onclose={() => (showAgents = false)} width=\"560px\">\n335:     <p class=\"launch-hint\">\n336:       One detached run in the job's worktree — its output lands in <code>session.log</code> and the\n337:       Run tab. Interactive sessions stay in the terminal by design.\n338:     </p>\n339:     <div class=\"field\">\n340:       <label for=\"launch-profile\">profile</label>\n341:       <select id=\"launch-profile\" class=\"select\" bind:value={profile}>\n342:         <option value=\"\">daemon default</option>\n343:         <option value=\"claude-pro\">claude-pro</option>\n344:         <option value=\"zai\">zai</option>\n345:         <option value=\"opencode-go\">opencode-go</option>\n346:         <option value=\"opencode-zen\">opencode-zen</option>\n347:         <option value=\"opencode-zen-free\">opencode-zen-free</option>\n348:       </select>\n349:     </div>\n350:     <input class=\"input\" placeholder=\"Filter the crew…\" bind:value={agentQuery} spellcheck=\"false\" aria-label=\"Filter agents\" />\n351:     <ul class=\"crew\">\n352:       {#each filteredAgents as a (a.name)}\n353:         <li>\n354:           <button class=\"crew-row\" onclick={() => launch(a.name)} disabled={launchingAgent !== ''}>\n355:             <span class=\"crew-name\">{\"@\" + a.name}</span>\n356:             <span class=\"crew-desc\">{a.description}</span>\n357:             {#if launchingAgent === a.name}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n358:           </button>\n359:         </li>\n360:       {/each}\n361:     </ul>\n362:     {#snippet footer()}\n363:       <button class=\"btn\" onclick={() => (showAgents = false)} disabled={launchingAgent !== ''}>Cancel</button>\n364:     {/snippet}\n365:   </Modal>\n366: {/if}\n367: \n368: {#if showJdi}\n369:   <Modal title=\"Run mg jdi\" busy={startingJdi} onclose={() => (showJdi = false)} width=\"460px\">\n370:     <p class=\"launch-hint\">\n371:       The fixed sequence — <code>@analyst → @developer → @reviewer</code> — runs detached, end to\n372:       end. It stops on an approved verdict, a human decision, or its retry budget.\n373:     </p>\n374:     <div class=\"field\">\n375:       <label for=\"jdi-profile\">profile</label>\n376:       <select id=\"jdi-profile\" class=\"select\" bind:value={profile}>\n377:         <option value=\"\">daemon default (claude-pro)</option>\n378:         <option value=\"claude-pro\">claude-pro</option>\n379:         <option value=\"zai\">zai</option>\n380:         <option value=\"opencode-go\">opencode-go</option>\n381:         <option value=\"opencode-zen\">opencode-zen</option>\n382:         <option value=\"opencode-zen-free\">opencode-zen-free</option>\n383:       </select>\n384:     </div>\n385:     {#snippet footer()}\n386:       <button class=\"btn\" onclick={() => (showJdi = false)} disabled={startingJdi}>Cancel</button>\n387:       <button class=\"btn btn-primary\" onclick={runJdi} disabled={startingJdi}>\n388:         {#if startingJdi}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n389:         Launch sequence\n390:       </button>\n391:     {/snippet}\n392:   </Modal>\n393: {/if}\n394: \n395: {#if confirmKind === 'done'}\n396:   <Confirm\n397:     title=\"Archive and merge\"\n398:     body={job?.stage === 'finished'\n399:       ? `Done squash-merges ${jobName} into the base branch and archives its docs.`\n400:       : `The verdict is not approved yet (${verdict || 'no verdict status found'}). mg done can still archive and merge — continue?`}\n401:     confirmLabel=\"Archive & merge\"\n402:     confirmKind=\"primary\"\n403:     busy={lifecycleBusy}\n404:     onconfirm={() => lifecycle('done')}\n405:     onclose={() => (confirmKind = null)}\n406:   />\n407: {:else if confirmKind === 'delete'}\n408:   <Confirm\n409:     title=\"Delete job\"\n410:     body={`Permanently delete ${jobName}?\\nThe worktree and branch are removed — uncommitted changes will be discarded.\\n\\nThis cannot be undone.`}\n411:     confirmLabel=\"Delete permanently\"\n412:     confirmKind=\"danger\"\n413:     busy={lifecycleBusy}\n414:     onconfirm={() => lifecycle('delete')}\n415:     onclose={() => (confirmKind = null)}\n416:   />\n417: {:else if confirmKind === 'push'}\n418:   <Confirm\n419:     title=\"Push branch\"\n420:     body={`Push ${job?.branch ?? jobName} to origin?`}\n421:     confirmLabel=\"Push\"\n422:     busy={lifecycleBusy}\n423:     onconfirm={() => lifecycle('push')}\n424:     onclose={() => (confirmKind = null)}\n425:   />\n426: {/if}\n427: \n428: <style>\n429:   .detail {\n430:     max-width: 880px;\n431:     margin: 0 auto;\n432:     width: 100%;\n433:     padding: var(--r-5) var(--r-6) var(--r-7);\n434:   }\n435: \n436:   .head {\n437:     display: flex;\n438:     gap: var(--r-4);\n439:     align-items: flex-start;\n440:   }\n441:   .back {\n442:     color: var(--ink-2);\n443:     text-decoration: none;\n444:     font-size: 18px;\n445:     padding: 4px 8px 0 0;\n446:     flex: none;\n447:     transition: color var(--t-fast);\n448:   }\n449:   .back:hover {\n450:     color: var(--accent-bright);\n451:     text-decoration: none;\n452:   }\n453:   .titles {\n454:     min-width: 0;\n455:     flex: 1;\n456:   }\n457:   h1 {\n458:     font-size: 21px;\n459:     letter-spacing: -0.015em;\n460:     overflow-wrap: anywhere;\n461:   }\n462:   .ident {\n463:     margin-top: 4px;\n464:     font-size: 12.5px;\n465:     color: var(--ink-2);\n466:     display: flex;\n467:     flex-wrap: wrap;\n468:     gap: 6px;\n469:     align-items: baseline;\n470:   }\n471:   .mono {\n472:     font-family: var(--font-mono);\n473:     font-size: 12px;\n474:   }\n475:   .dim {\n476:     color: var(--ink-2);\n477:   }\n478:   .sep {\n479:     color: var(--ink-2);\n480:   }\n481:   .actions {\n482:     display: flex;\n483:     gap: var(--r-2);\n484:     align-items: center;\n485:     flex-wrap: wrap;\n486:     justify-content: flex-end;\n487:   }\n488:   .more {\n489:     display: flex;\n490:     gap: 6px;\n491:   }\n492:   .btn-live {\n493:     border-color: rgba(139, 108, 246, 0.5);\n494:     color: var(--accent-bright);\n495:     background: var(--st-running-dim);\n496:   }\n497: \n498:   .stage-row {\n499:     display: flex;\n500:     align-items: center;\n501:     gap: var(--r-3) var(--r-4);\n502:     flex-wrap: wrap;\n503:     margin: var(--r-5) 0 var(--r-4);\n504:     padding: var(--r-3) var(--r-4);\n505:     background: var(--bg-1);\n506:     border: 1px solid var(--line);\n507:     border-radius: var(--radius-m);\n508:   }\n509: \n510:   .human {\n511:     display: flex;\n512:     gap: var(--r-4);\n513:     align-items: center;\n514:     justify-content: space-between;\n515:     flex-wrap: wrap;\n516:     border: 1px solid rgba(242, 85, 90, 0.45);\n517:     background:\n518:       radial-gradient(400px 120px at 0% 0%, rgba(242, 85, 90, 0.1), transparent),\n519:       var(--bg-1);\n520:     border-radius: var(--radius-m);\n521:     padding: var(--r-4) var(--r-5);\n522:     margin-bottom: var(--r-5);\n523:   }\n524:   .human-eyebrow {\n525:     color: #ff8d91;\n526:     margin-bottom: 4px;\n527:   }\n528:   .human-text {\n529:     color: var(--ink-1);\n530:     font-size: 13.5px;\n531:     max-width: 62ch;\n532:   }\n533:   .human-text code {\n534:     color: #ff8d91;\n535:     font-size: 0.9em;\n536:   }\n537:   .human-actions {\n538:     display: flex;\n539:     gap: var(--r-2);\n540:   }\n541: \n542:   .tabs {\n543:     display: flex;\n544:     gap: 2px;\n545:     border-bottom: 1px solid var(--line);\n546:     overflow-x: auto;\n547:     scrollbar-width: none;\n548:     position: relative;\n549:   }\n550:   .tabs::-webkit-scrollbar {\n551:     display: none;\n552:   }\n553:   /* a scrollability hint at the right edge — the strip scrolls on phones */\n554:   .tabs::after {\n555:     content: '';\n556:     position: sticky;\n557:     right: 0;\n558:     top: 0;\n559:     flex: none;\n560:     width: 28px;\n561:     align-self: stretch;\n562:     background: linear-gradient(90deg, transparent, var(--bg-0) 70%);\n563:     pointer-events: none;\n564:     margin-left: -28px;\n565:   }\n566:   .tabs button {\n567:     appearance: none;\n568:     background: none;\n569:     border: none;\n570:     color: var(--ink-2);\n571:     font: inherit;\n572:     font-size: 13.5px;\n573:     font-weight: 530;\n574:     padding: 8px 14px 10px;\n575:     cursor: pointer;\n576:     border-bottom: 2px solid transparent;\n577:     margin-bottom: -1px;\n578:     white-space: nowrap;\n579:     display: inline-flex;\n580:     align-items: center;\n581:     gap: 6px;\n582:     transition: color var(--t-fast);\n583:   }\n584:   .tabs button:hover {\n585:     color: var(--ink-0);\n586:   }\n587:   .tabs button.active {\n588:     color: var(--accent-bright);\n589:     border-bottom-color: var(--accent);\n590:   }\n591:   .v-dot {\n592:     width: 7px;\n593:     height: 7px;\n594:     border-radius: 50%;\n595:     background: var(--st-human);\n596:   }\n597:   .v-dot.approved {\n598:     background: var(--st-done);\n599:   }\n600: \n601:   .body {\n602:     padding-top: var(--r-5);\n603:     min-height: 240px;\n604:   }\n605: \n606:   .loading,\n607:   .missing {\n608:     color: var(--ink-2);\n609:     font-size: 14px;\n610:     padding: var(--r-4) 0;\n611:   }\n612:   .missing .mono {\n613:     color: var(--st-open);\n614:     margin-bottom: 4px;\n615:     display: block;\n616:   }\n617: \n618:   .file-actions {\n619:     margin-top: var(--r-4);\n620:     padding-top: var(--r-4);\n621:     border-top: 1px solid var(--line);\n622:   }\n623: \n624:   .verdict-line {\n625:     margin-top: var(--r-4);\n626:     font-family: var(--font-mono);\n627:     font-size: 12.5px;\n628:     padding: 8px 12px;\n629:     border-radius: var(--radius-s);\n630:   }\n631:   .verdict-line.approved {\n632:     color: var(--st-done);\n633:     background: var(--st-done-dim);\n634:   }\n635:   .verdict-line.rejected {\n636:     color: #ffb3b6;\n637:     background: var(--st-human-dim);\n638:   }\n639: \n640:   .editor {\n641:     display: flex;\n642:     flex-direction: column;\n643:     gap: var(--r-3);\n644:   }\n645:   .editor .textarea {\n646:     min-height: 380px;\n647:   }\n648:   .editor-bar {\n649:     display: flex;\n650:     justify-content: space-between;\n651:     align-items: center;\n652:     gap: var(--r-3);\n653:     flex-wrap: wrap;\n654:   }\n655:   .editor-actions {\n656:     display: flex;\n657:     gap: var(--r-2);\n658:   }\n659:   .hint {\n660:     font-size: 11.5px;\n661:     color: var(--ink-2);\n662:   }\n663: \n664:   .launch-hint {\n665:     font-size: 13.5px;\n666:     color: var(--ink-1);\n667:     margin-bottom: var(--r-4);\n668:     line-height: 1.6;\n669:   }\n670:   .launch-hint code {\n671:     color: var(--accent-bright);\n672:   }\n673: \n674:   .crew {\n675:     list-style: none;\n676:     margin: var(--r-3) 0 0;\n677:     padding: 0;\n678:     max-height: 300px;\n679:     overflow-y: auto;\n680:     display: flex;\n681:     flex-direction: column;\n682:     gap: 4px;\n683:   }\n684:   .crew-row {\n685:     display: flex;\n686:     align-items: baseline;\n687:     gap: var(--r-3);\n688:     width: 100%;\n689:     text-align: left;\n690:     background: var(--bg-1);\n691:     border: 1px solid var(--line);\n692:     border-radius: var(--radius-s);\n693:     padding: 9px 12px;\n694:     cursor: pointer;\n695:     font: inherit;\n696:     transition: border-color var(--t-fast), background var(--t-fast);\n697:   }\n698:   .crew-row:hover:not(:disabled) {\n699:     border-color: var(--accent);\n700:     background: var(--bg-2);\n701:   }\n702:   .crew-row:disabled {\n703:     opacity: 0.6;\n704:     cursor: wait;\n705:   }\n706:   .crew-name {\n707:     font-family: var(--font-mono);\n708:     font-size: 12.5px;\n709:     color: var(--accent-bright);\n710:     flex: none;\n711:     min-width: 96px;\n712:   }\n713:   .crew-desc {\n714:     font-size: 12.5px;\n715:     color: var(--ink-2);\n716:   }\n717: \n718:   @media (max-width: 760px) {\n719:     .detail {\n720:       padding: var(--r-4) var(--r-4) var(--r-6);\n721:     }\n722:     .head {\n723:       flex-wrap: wrap;\n724:     }\n725:     .actions {\n726:       width: 100%;\n727:       justify-content: flex-start;\n728:     }\n729:     .stage-row {\n730:       overflow-x: auto;\n731:     }\n732:   }\n733: </style>\n\n(End of file - total 733 lines)\n</content>","metadata":{"preview":"<script lang=\"ts\">\n  import { onMount } from 'svelte'\n  import Pipeline from '$lib/components/Pipeline.svelte'\n  import MarkdownView from '$lib/components/MarkdownView.svelte'\n  import Modal from '$lib/components/Modal.svelte'\n  import Confirm from '$lib/components/Confirm.svelte'\n  import RunConsole from '$lib/components/RunConsole.svelte'\n  import DiffView from '$lib/components/DiffView.svelte'\n  import { data } from '$lib/state/data.svelte'\n  import { toasts } from '$lib/state/toasts.svelte'\n  import { navigate, href } from '$lib/router'\n  import { relativeTime } from '$lib/time'\n  import { verdictStatus } from '$lib/markdown'\n  import * as api from '$lib/api/client'\n  import type { AgentRow, JobRow } from '$lib/api/types'\n\n  let { project, jobName, tab = 'brief' }: { project: string; jobName: string; tab?: string } = $props()\n\n  const TABS = [\n    { id: 'brief', label: 'Brief' },","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/web-ui/src/lib/views/JobDetailView.svelte","text":"<script lang=\"ts\">\n  import { onMount } from 'svelte'\n  import Pipeline from '$lib/components/Pipeline.svelte'\n  import MarkdownView from '$lib/components/MarkdownView.svelte'\n  import Modal from '$lib/components/Modal.svelte'\n  import Confirm from '$lib/components/Confirm.svelte'\n  import RunConsole from '$lib/components/RunConsole.svelte'\n  import DiffView from '$lib/components/DiffView.svelte'\n  import { data } from '$lib/state/data.svelte'\n  import { toasts } from '$lib/state/toasts.svelte'\n  import { navigate, href } from '$lib/router'\n  import { relativeTime } from '$lib/time'\n  import { verdictStatus } from '$lib/markdown'\n  import * as api from '$lib/api/client'\n  import type { AgentRow, JobRow } from '$lib/api/types'\n\n  let { project, jobName, tab = 'brief' }: { project: string; jobName: string; tab?: string } = $props()\n\n  const TABS = [\n    { id: 'brief', label: 'Brief' },\n    { id: 'tasks', label: 'Tasks' },\n    { id: 'implementation', label: 'Implementation' },\n    { id: 'verdict', label: 'Verdict' },\n    { id: 'diff', label: 'Diff' },\n    { id: 'run', label: 'Run' },\n  ] as const\n\n  const job = $derived<JobRow | undefined>(\n    (data.active === project ? data.jobs : []).find(\n      (j) => j.name === jobName || j.id === jobName || j.name.startsWith(jobName + '_'),\n    ),\n  )\n\n  // file content per tab\n  let fileContent = $state('')\n  let fileLoading = $state(false)\n  let fileMissing = $state(false)\n\n  // brief editing (Part 2)\n  let editing = $state(false)\n  let draft = $state('')\n  let saving = $state(false)\n\n  // agents + launches (Part 2)\n  let agents = $state<AgentRow[]>([])\n  let showAgents = $state(false)\n  let agentQuery = $state('')\n  let launchingAgent = $state('')\n  let profile = $state('')\n\n  // jdi run\n  let showJdi = $state(false)\n  let startingJdi = $state(false)\n\n  // lifecycle confirms\n  let confirmKind = $state<null | 'done' | 'delete' | 'push'>(null)\n  let lifecycleBusy = $state(false)\n\n  let verdict = $state('')\n  let verdictApproved = $state(false)\n\n  $effect(() => {\n    // (re)load whenever the tab or job changes\n    jobName\n    void loadTab()\n  })\n\n  onMount(async () => {\n    if (data.active !== project) {\n      data.setActive(project)\n      await data.refreshJobs()\n    } else if (!job) {\n      await data.refreshJobs() // direct link — the list may not know this job yet\n    }\n    void loadAgents()\n    data.startPolling()\n    return () => data.stopPolling()\n  })\n\n  async function loadTab() {\n    if (tab === 'diff' || tab === 'run') return\n    fileLoading = true\n    fileMissing = false\n    try {\n      fileContent = await api.getJobFile(project, jobName, tab)\n      if (tab === 'verdict') {\n        verdict = verdictStatus(fileContent)\n        verdictApproved = /\\bAPPROVED\\b/i.test(verdict) && !/REJECTED|NEEDS WORK/i.test(verdict)\n      }\n    } catch {\n      fileContent = ''\n      fileMissing = true\n    } finally {\n      fileLoading = false\n    }\n  }\n\n  async function loadAgents() {\n    try {\n      const res = await api.getAgents(project)\n      agents = res.agents ?? []\n    } catch {\n      agents = []\n    }\n  }\n\n  function goTab(t: string) {\n    navigate(href({ name: 'job', project, job: jobName, tab: t }))\n  }\n\n  function actionError(e: unknown, what: string): string {\n    if (e instanceof api.ApiError && e.capabilityMiss) {\n      return `This daemon does not expose ${what} yet — mutating endpoints land with job two of the control plane.`\n    }\n    return e instanceof Error ? e.message : String(e)\n  }\n\n  async function startEdit() {\n    draft = fileContent\n    editing = true\n  }\n\n  async function saveBrief() {\n    saving = true\n    try {\n      await api.saveBrief(project, jobName, draft)\n      toasts.ok('Brief saved')\n      editing = false\n      fileContent = draft\n      await data.refreshJobs()\n    } catch (e) {\n      toasts.error(actionError(e, 'brief editing'))\n    } finally {\n      saving = false\n    }\n  }\n\n  async function launch(agent: string) {\n    launchingAgent = agent\n    try {\n      const res = await api.launchAgent(project, jobName, agent, profile || undefined)\n      toasts.ok(res.message ?? `@${agent} launched detached`)\n      showAgents = false\n      await data.refreshJobs()\n    } catch (e) {\n      toasts.error(actionError(e, 'agent launches'))\n    } finally {\n      launchingAgent = ''\n    }\n  }\n\n  async function runJdi() {\n    startingJdi = true\n    try {\n      const res = await api.startJdi(project, jobName, profile || undefined)\n      toasts.ok(res.message ?? 'mg jdi detached — watch the Run tab')\n      showJdi = false\n      goTab('run')\n      await data.refreshJobs()\n    } catch (e) {\n      toasts.error(actionError(e, 'jdi launches'))\n    } finally {\n      startingJdi = false\n    }\n  }\n\n  async function lifecycle(kind: 'done' | 'delete' | 'push') {\n    lifecycleBusy = true\n    try {\n      if (kind === 'done') {\n        const res = await api.doneJob(project, jobName)\n        toasts.ok(res.message ?? 'Job archived and squash-merged')\n      } else if (kind === 'delete') {\n        const res = await api.deleteJob(project, jobName)\n        toasts.ok(res.message ?? 'Job deleted')\n      } else {\n        const res = await api.pushJob(project, jobName)\n        toasts.ok(res.message ?? 'Branch pushed')\n      }\n      confirmKind = null\n      if (kind === 'delete') navigate(href({ name: 'jobs', project }))\n      else await data.refreshJobs()\n    } catch (e) {\n      toasts.error(actionError(e, kind === 'done' ? 'done' : kind === 'delete' ? 'delete' : 'push'))\n    } finally {\n      lifecycleBusy = false\n    }\n  }\n\n  const filteredAgents = $derived.by(() => {\n    const q = agentQuery.trim().toLowerCase()\n    if (!q) return agents\n    return agents.filter(\n      (a) => a.name.toLowerCase().includes(q) || a.description.toLowerCase().includes(q),\n    )\n  })\n\n  const needsHuman = $derived(job?.jdi?.state === 'stopped:needs-human')\n  const isRunning = $derived(job?.jdi?.state === 'running')\n</script>\n\n<div class=\"detail\">\n  <header class=\"head\">\n    <a class=\"back\" href={href({ name: 'jobs', project })} aria-label=\"Back to jobs\">←</a>\n    <div class=\"titles\">\n      <h1>{job?.title ?? jobName}</h1>\n      <p class=\"ident\">\n        <span class=\"mono\">{job?.name ?? jobName}</span>\n        {#if job?.branch}<span class=\"sep\">·</span><span class=\"mono dim\">{job.branch}</span>{/if}\n        {#if job}<span class=\"sep\">·</span><span>{job.type}</span>{/if}\n        {#if job?.date}<span class=\"sep\">·</span><span class=\"dim\">{job.date}</span>{/if}\n        {#if job?.jdi}\n          <span class=\"sep\">·</span>\n          <span class=\"dim\">{job.jdi.agent} · {relativeTime(job.jdi.updated)}</span>\n        {/if}\n      </p>\n    </div>\n    <div class=\"actions\">\n      <button class=\"btn\" class:btn-live={isRunning} onclick={() => (showJdi = true)}>\n        {#if isRunning}mg jdi running…{:else}Run mg jdi{/if}\n      </button>\n      <button class=\"btn\" onclick={() => (showAgents = true)}>Launch agent</button>\n      <div class=\"more\" role=\"group\" aria-label=\"Lifecycle\">\n        <button class=\"btn btn-sm\" onclick={() => (confirmKind = 'push')} disabled={!job?.branch}>\n          Push\n        </button>\n        <button\n          class=\"btn btn-sm\"\n          class:btn-primary={job?.stage === 'finished'}\n          onclick={() => (confirmKind = 'done')}\n        >\n          Done\n        </button>\n        <button class=\"btn btn-sm btn-danger\" onclick={() => (confirmKind = 'delete')}>Delete</button>\n      </div>\n    </div>\n  </header>\n\n  {#if job}\n    <div class=\"stage-row\">\n      <Pipeline stage={job.stage} jdi={job.jdi} variant=\"full\" />\n      {#if job.jdi?.state === 'running'}\n        <span class=\"chip chip-running\"><span class=\"dot\"></span> {job.jdi.agent} running</span>\n      {:else if needsHuman}\n        <span class=\"chip chip-human\"><span class=\"dot\"></span> stopped for a human</span>\n      {/if}\n    </div>\n  {/if}\n\n  {#if needsHuman}\n    <aside class=\"human\" role=\"alert\">\n      <div class=\"human-body\">\n        <p class=\"eyebrow human-eyebrow\">handoff</p>\n        <p class=\"human-text\">\n          The run stopped with <code>NEEDS-HUMAN-INPUT</code> — a decision only you can make.\n          Answer it in the brief (or the relevant job file), then relaunch the sequence.\n        </p>\n      </div>\n      <div class=\"human-actions\">\n        <button class=\"btn\" onclick={() => (tab === 'brief' ? startEdit() : goTab('brief'))}>\n          Edit brief\n        </button>\n        <button class=\"btn btn-primary\" onclick={() => (showJdi = true)}>Relaunch mg jdi</button>\n      </div>\n    </aside>\n  {/if}\n\n  <nav class=\"tabs\" role=\"tablist\" aria-label=\"Job files\">\n    {#each TABS as t (t.id)}\n      <button role=\"tab\" aria-selected={tab === t.id} class:active={tab === t.id} onclick={() => goTab(t.id)}>\n        {t.label}\n        {#if t.id === 'verdict' && verdict && tab !== 'verdict'}\n          <span class=\"v-dot\" class:approved={verdictApproved}></span>\n        {/if}\n      </button>\n    {/each}\n  </nav>\n\n  <div class=\"body\" role=\"tabpanel\">\n    {#if tab === 'diff'}\n      <DiffView {project} job={jobName} />\n    {:else if tab === 'run'}\n      <RunConsole {project} job={jobName} />\n    {:else if editing && tab === 'brief'}\n      <div class=\"editor\">\n        <textarea\n          class=\"textarea\"\n          bind:value={draft}\n          spellcheck=\"false\"\n          aria-label=\"Editing brief.md\"\n        ></textarea>\n        <div class=\"editor-bar\">\n          <span class=\"hint mono\">brief.md — raw markdown replaces the file</span>\n          <div class=\"editor-actions\">\n            <button class=\"btn\" onclick={() => (editing = false)} disabled={saving}>Cancel</button>\n            <button class=\"btn btn-primary\" onclick={saveBrief} disabled={saving}>\n              {#if saving}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n              Save brief\n            </button>\n          </div>\n        </div>\n      </div>\n    {:else}\n      {#if fileLoading}\n        <p class=\"loading\">Reading {tab}.md…</p>\n      {:else if fileMissing}\n        <div class=\"missing\">\n          <p class=\"mono\">no {tab}.md yet</p>\n          <p class=\"dim\">\n            {#if tab === 'tasks'}The analyst writes this (@analyst, or Run mg jdi).\n            {:else if tab === 'implementation'}The developer writes this as tasks complete.\n            {:else if tab === 'verdict'}The reviewer writes this after review.\n            {:else}The brief is the job's first file.{/if}\n          </p>\n        </div>\n      {:else}\n        <MarkdownView source={fileContent} />\n        {#if tab === 'brief'}\n          <div class=\"file-actions\">\n            <button class=\"btn\" onclick={startEdit}>Edit brief</button>\n          </div>\n        {/if}\n        {#if tab === 'verdict' && verdict}\n          <p class=\"verdict-line\" class:approved={verdictApproved} class:rejected={!verdictApproved}>\n            Verdict: {verdict}\n          </p>\n        {/if}\n      {/if}\n    {/if}\n  </div>\n</div>\n\n{#if showAgents}\n  <Modal title=\"Launch agent\" onclose={() => (showAgents = false)} width=\"560px\">\n    <p class=\"launch-hint\">\n      One detached run in the job's worktree — its output lands in <code>session.log</code> and the\n      Run tab. Interactive sessions stay in the terminal by design.\n    </p>\n    <div class=\"field\">\n      <label for=\"launch-profile\">profile</label>\n      <select id=\"launch-profile\" class=\"select\" bind:value={profile}>\n        <option value=\"\">daemon default</option>\n        <option value=\"claude-pro\">claude-pro</option>\n        <option value=\"zai\">zai</option>\n        <option value=\"opencode-go\">opencode-go</option>\n        <option value=\"opencode-zen\">opencode-zen</option>\n        <option value=\"opencode-zen-free\">opencode-zen-free</option>\n      </select>\n    </div>\n    <input class=\"input\" placeholder=\"Filter the crew…\" bind:value={agentQuery} spellcheck=\"false\" aria-label=\"Filter agents\" />\n    <ul class=\"crew\">\n      {#each filteredAgents as a (a.name)}\n        <li>\n          <button class=\"crew-row\" onclick={() => launch(a.name)} disabled={launchingAgent !== ''}>\n            <span class=\"crew-name\">{\"@\" + a.name}</span>\n            <span class=\"crew-desc\">{a.description}</span>\n            {#if launchingAgent === a.name}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n          </button>\n        </li>\n      {/each}\n    </ul>\n    {#snippet footer()}\n      <button class=\"btn\" onclick={() => (showAgents = false)} disabled={launchingAgent !== ''}>Cancel</button>\n    {/snippet}\n  </Modal>\n{/if}\n\n{#if showJdi}\n  <Modal title=\"Run mg jdi\" busy={startingJdi} onclose={() => (showJdi = false)} width=\"460px\">\n    <p class=\"launch-hint\">\n      The fixed sequence — <code>@analyst → @developer → @reviewer</code> — runs detached, end to\n      end. It stops on an approved verdict, a human decision, or its retry budget.\n    </p>\n    <div class=\"field\">\n      <label for=\"jdi-profile\">profile</label>\n      <select id=\"jdi-profile\" class=\"select\" bind:value={profile}>\n        <option value=\"\">daemon default (claude-pro)</option>\n        <option value=\"claude-pro\">claude-pro</option>\n        <option value=\"zai\">zai</option>\n        <option value=\"opencode-go\">opencode-go</option>\n        <option value=\"opencode-zen\">opencode-zen</option>\n        <option value=\"opencode-zen-free\">opencode-zen-free</option>\n      </select>\n    </div>\n    {#snippet footer()}\n      <button class=\"btn\" onclick={() => (showJdi = false)} disabled={startingJdi}>Cancel</button>\n      <button class=\"btn btn-primary\" onclick={runJdi} disabled={startingJdi}>\n        {#if startingJdi}<span class=\"spin\" aria-hidden=\"true\"></span>{/if}\n        Launch sequence\n      </button>\n    {/snippet}\n  </Modal>\n{/if}\n\n{#if confirmKind === 'done'}\n  <Confirm\n    title=\"Archive and merge\"\n    body={job?.stage === 'finished'\n      ? `Done squash-merges ${jobName} into the base branch and archives its docs.`\n      : `The verdict is not approved yet (${verdict || 'no verdict status found'}). mg done can still archive and merge — continue?`}\n    confirmLabel=\"Archive & merge\"\n    confirmKind=\"primary\"\n    busy={lifecycleBusy}\n    onconfirm={() => lifecycle('done')}\n    onclose={() => (confirmKind = null)}\n  />\n{:else if confirmKind === 'delete'}\n  <Confirm\n    title=\"Delete job\"\n    body={`Permanently delete ${jobName}?\\nThe worktree and branch are removed — uncommitted changes will be discarded.\\n\\nThis cannot be undone.`}\n    confirmLabel=\"Delete permanently\"\n    confirmKind=\"danger\"\n    busy={lifecycleBusy}\n    onconfirm={() => lifecycle('delete')}\n    onclose={() => (confirmKind = null)}\n  />\n{:else if confirmKind === 'push'}\n  <Confirm\n    title=\"Push branch\"\n    body={`Push ${job?.branch ?? jobName} to origin?`}\n    confirmLabel=\"Push\"\n    busy={lifecycleBusy}\n    onconfirm={() => lifecycle('push')}\n    onclose={() => (confirmKind = null)}\n  />\n{/if}\n\n<style>\n  .detail {\n    max-width: 880px;\n    margin: 0 auto;\n    width: 100%;\n    padding: var(--r-5) var(--r-6) var(--r-7);\n  }\n\n  .head {\n    display: flex;\n    gap: var(--r-4);\n    align-items: flex-start;\n  }\n  .back {\n    color: var(--ink-2);\n    text-decoration: none;\n    font-size: 18px;\n    padding: 4px 8px 0 0;\n    flex: none;\n    transition: color var(--t-fast);\n  }\n  .back:hover {\n    color: var(--accent-bright);\n    text-decoration: none;\n  }\n  .titles {\n    min-width: 0;\n    flex: 1;\n  }\n  h1 {\n    font-size: 21px;\n    letter-spacing: -0.015em;\n    overflow-wrap: anywhere;\n  }\n  .ident {\n    margin-top: 4px;\n    font-size: 12.5px;\n    color: var(--ink-2);\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px;\n    align-items: baseline;\n  }\n  .mono {\n    font-family: var(--font-mono);\n    font-size: 12px;\n  }\n  .dim {\n    color: var(--ink-2);\n  }\n  .sep {\n    color: var(--ink-2);\n  }\n  .actions {\n    display: flex;\n    gap: var(--r-2);\n    align-items: center;\n    flex-wrap: wrap;\n    justify-content: flex-end;\n  }\n  .more {\n    display: flex;\n    gap: 6px;\n  }\n  .btn-live {\n    border-color: rgba(139, 108, 246, 0.5);\n    color: var(--accent-bright);\n    background: var(--st-running-dim);\n  }\n\n  .stage-row {\n    display: flex;\n    align-items: center;\n    gap: var(--r-3) var(--r-4);\n    flex-wrap: wrap;\n    margin: var(--r-5) 0 var(--r-4);\n    padding: var(--r-3) var(--r-4);\n    background: var(--bg-1);\n    border: 1px solid var(--line);\n    border-radius: var(--radius-m);\n  }\n\n  .human {\n    display: flex;\n    gap: var(--r-4);\n    align-items: center;\n    justify-content: space-between;\n    flex-wrap: wrap;\n    border: 1px solid rgba(242, 85, 90, 0.45);\n    background:\n      radial-gradient(400px 120px at 0% 0%, rgba(242, 85, 90, 0.1), transparent),\n      var(--bg-1);\n    border-radius: var(--radius-m);\n    padding: var(--r-4) var(--r-5);\n    margin-bottom: var(--r-5);\n  }\n  .human-eyebrow {\n    color: #ff8d91;\n    margin-bottom: 4px;\n  }\n  .human-text {\n    color: var(--ink-1);\n    font-size: 13.5px;\n    max-width: 62ch;\n  }\n  .human-text code {\n    color: #ff8d91;\n    font-size: 0.9em;\n  }\n  .human-actions {\n    display: flex;\n    gap: var(--r-2);\n  }\n\n  .tabs {\n    display: flex;\n    gap: 2px;\n    border-bottom: 1px solid var(--line);\n    overflow-x: auto;\n    scrollbar-width: none;\n    position: relative;\n  }\n  .tabs::-webkit-scrollbar {\n    display: none;\n  }\n  /* a scrollability hint at the right edge — the strip scrolls on phones */\n  .tabs::after {\n    content: '';\n    position: sticky;\n    right: 0;\n    top: 0;\n    flex: none;\n    width: 28px;\n    align-self: stretch;\n    background: linear-gradient(90deg, transparent, var(--bg-0) 70%);\n    pointer-events: none;\n    margin-left: -28px;\n  }\n  .tabs button {\n    appearance: none;\n    background: none;\n    border: none;\n    color: var(--ink-2);\n    font: inherit;\n    font-size: 13.5px;\n    font-weight: 530;\n    padding: 8px 14px 10px;\n    cursor: pointer;\n    border-bottom: 2px solid transparent;\n    margin-bottom: -1px;\n    white-space: nowrap;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    transition: color var(--t-fast);\n  }\n  .tabs button:hover {\n    color: var(--ink-0);\n  }\n  .tabs button.active {\n    color: var(--accent-bright);\n    border-bottom-color: var(--accent);\n  }\n  .v-dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: var(--st-human);\n  }\n  .v-dot.approved {\n    background: var(--st-done);\n  }\n\n  .body {\n    padding-top: var(--r-5);\n    min-height: 240px;\n  }\n\n  .loading,\n  .missing {\n    color: var(--ink-2);\n    font-size: 14px;\n    padding: var(--r-4) 0;\n  }\n  .missing .mono {\n    color: var(--st-open);\n    margin-bottom: 4px;\n    display: block;\n  }\n\n  .file-actions {\n    margin-top: var(--r-4);\n    padding-top: var(--r-4);\n    border-top: 1px solid var(--line);\n  }\n\n  .verdict-line {\n    margin-top: var(--r-4);\n    font-family: var(--font-mono);\n    font-size: 12.5px;\n    padding: 8px 12px;\n    border-radius: var(--radius-s);\n  }\n  .verdict-line.approved {\n    color: var(--st-done);\n    background: var(--st-done-dim);\n  }\n  .verdict-line.rejected {\n    color: #ffb3b6;\n    background: var(--st-human-dim);\n  }\n\n  .editor {\n    display: flex;\n    flex-direction: column;\n    gap: var(--r-3);\n  }\n  .editor .textarea {\n    min-height: 380px;\n  }\n  .editor-bar {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: var(--r-3);\n    flex-wrap: wrap;\n  }\n  .editor-actions {\n    display: flex;\n    gap: var(--r-2);\n  }\n  .hint {\n    font-size: 11.5px;\n    color: var(--ink-2);\n  }\n\n  .launch-hint {\n    font-size: 13.5px;\n    color: var(--ink-1);\n    margin-bottom: var(--r-4);\n    line-height: 1.6;\n  }\n  .launch-hint code {\n    color: var(--accent-bright);\n  }\n\n  .crew {\n    list-style: none;\n    margin: var(--r-3) 0 0;\n    padding: 0;\n    max-height: 300px;\n    overflow-y: auto;\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n  }\n  .crew-row {\n    display: flex;\n    align-items: baseline;\n    gap: var(--r-3);\n    width: 100%;\n    text-align: left;\n    background: var(--bg-1);\n    border: 1px solid var(--line);\n    border-radius: var(--radius-s);\n    padding: 9px 12px;\n    cursor: pointer;\n    font: inherit;\n    transition: border-color var(--t-fast), background var(--t-fast);\n  }\n  .crew-row:hover:not(:disabled) {\n    border-color: var(--accent);\n    background: var(--bg-2);\n  }\n  .crew-row:disabled {\n    opacity: 0.6;\n    cursor: wait;\n  }\n  .crew-name {\n    font-family: var(--font-mono);\n    font-size: 12.5px;\n    color: var(--accent-bright);\n    flex: none;\n    min-width: 96px;\n  }\n  .crew-desc {\n    font-size: 12.5px;\n    color: var(--ink-2);\n  }\n\n  @media (max-width: 760px) {\n    .detail {\n      padding: var(--r-4) var(--r-4) var(--r-6);\n    }\n    .head {\n      flex-wrap: wrap;\n    }\n    .actions {\n      width: 100%;\n      justify-content: flex-start;\n    }\n    .stage-row {\n      overflow-x: auto;\n    }\n  }\n</style>","lineStart":1,"lineEnd":733,"totalLines":733,"truncated":false}},"title":"web-ui/src/lib/views/JobDetailView.svelte","time":{"start":1787995830718,"end":1787995830725}},"id":"prt_04cdb38b8001qjGVVoDpDANtg0","sessionID":"ses_fb3250779ffe153rxsL511kCsf","messageID":"msg_04cdb33a8001vwvzufr0Du3Avj"}}
