AgentsView from '$lib/views/AgentsView.svelte'\n  import HealthView from '$lib/views/HealthView.svelte'\n  import { connection } from '$lib/state/connection.svelte'\n  import { data } from '$lib/state/data.svelte'\n  import { parseHash, href, navigate } from '$lib/router'\n\n  let route = $state(parseHash(location.hash))\n  let showSettings = $state(false)\n  let showPalette = $state(false)\n\n  $effect(() => {\n    const onHash = () => (route = parseHash(location.hash))","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/web-ui/src/App.svelte","text":"<script lang=\"ts\">\n  import { onMount } from 'svelte'\n  import Logo from '$lib/components/Logo.svelte'\n  import Toasts from '$lib/components/Toasts.svelte'\n  import Palette from '$lib/components/Palette.svelte'\n  import SettingsModal from '$lib/components/SettingsModal.svelte'\n  import JobsView from '$lib/views/JobsView.svelte'\n  import JobDetailView from '$lib/views/JobDetailView.svelte'\n  import AgentsView from '$lib/views/AgentsView.svelte'\n  import HealthView from '$lib/views/HealthView.svelte'\n  import { connection } from '$lib/state/connection.svelte'\n  import { data } from '$lib/state/data.svelte'\n  import { parseHash, href, navigate } from '$lib/router'\n\n  let route = $state(parseHash(location.hash))\n  let showSettings = $state(false)\n  let showPalette = $state(false)\n\n  $effect(() => {\n    const onHash = () => (route = parseHash(location.hash))\n    window.addEventListener('hashchange', onHash)\n    return () => window.removeEventListener('hashchange', onHash)\n  })\n\n  // Bootstrap: check the daemon, load projects, land on a real route.\n  onMount(() => {\n    void (async () => {\n      void connection.check()\n      await data.loadProjects().catch(() => {})\n      if (parseHash(location.hash).name === 'home' && data.active) {\n        navigate(href({ name: 'jobs', project: data.active }))\n      }\n    })()\n    data.startPolling()\n    const t = setInterval(() => void connection.check(), 30_000)\n    return () => clearInterval(t)\n  })\n\n  // Home with a known project redirects once projects land.\n  $effect(() => {\n    if (route.name === 'home' && data.active) navigate(href({ name: 'jobs', project: data.active }))\n  })\n\n  function onKeydown(e: KeyboardEvent) {\n    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {\n      e.preventDefault()\n      showPalette = !showPalette\n    }\n  }\n\n  const connLabel = $derived(\n    connection.status === 'up' ? 'connected' : connection.status === 'down' ? 'offline' : 'connecting…',\n  )\n\n  function switchProject(e: Event) {\n    const name = (e.currentTarget as HTMLSelectElement).value\n    data.setActive(name)\n    navigate(href({ name: 'jobs', project: name }))\n  }\n</script>\n\n<svelte:window onkeydown={onKeydown} />\n\n<div class=\"shell\">\n  <aside class=\"rail\">\n    <a class=\"brand\" href=\"#/\" aria-label=\"manigot home\">\n      <Logo size={24} />\n      <span class=\"word\">manigot</span>\n      <span class=\"role\">control plane</span>\n    </a>\n\n    <div class=\"project\">\n      <label class=\"eyebrow\" for=\"project-select\">project</label>\n      <select id=\"project-select\" class=\"select\" value={data.active} onchange={switchProject} disabled={data.projects.length === 0}>\n        {#each data.projects as p (p.name)}\n          <option value={p.name}>{p.name}</option>\n        {/each}\n      </select>\n      {#if data.projects.length === 0 && connection.status !== 'connecting'}\n        <p class=\"no-projects\">No projects registered.<br />Edit <code>config/serve.json</code> on the daemon.</p>\n      {/if}\n    </div>\n\n    <nav aria-label=\"Primary\">\n      <a\n        href={href({ name: 'jobs', project: route.project ?? data.active })}\n        class:active={route.name === 'jobs' || route.name === 'job'}\n      >\n        <svg viewBox=\"0 0 16 16\" width=\"15\" height=\"15\" aria-hidden=\"true\"><rect x=\"1.5\" y=\"1.5\" width=\"13\" height=\"13\" rx=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M4.5 5.5h7M4.5 8h7M4.5 10.5h4\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>\n        Jobs\n      </a>\n      <a\n        href={href({ name: 'agents', project: route.project ?? data.active })}\n        class:active={route.name === 'agents'}\n      >\n        <svg viewBox=\"0 0 16 16\" width=\"15\" height=\"15\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"5\" r=\"2.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M2.8 13.4c.7-2.5 2.8-3.8 5.2-3.8s4.5 1.3 5.2 3.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>\n        Crew\n      </a>\n      <a href=\"#/health\" class:active={route.name === 'health'}>\n        <svg viewBox=\"0 0 16 16\" width=\"15\" height=\"15\" aria-hidden=\"true\"><path d=\"M8 1.8l5.4 2.2v4c0 3.3-2.2 5.6-5.4 6.4-3.2-.8-5.4-3.1-5.4-6.4v-4z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M5.6 7.9l1.8 1.8 3.2-3.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        Daemon\n      </a>\n    </nav>\n\n    <div class=\"rail-foot\">\n      <button class=\"conn\" class:down={connection.status === 'down'} onclick={() => (showSettings = true)}>\n        <span class=\"conn-dot\" class:up={connection.status === 'up'} class:down={connection.status === 'down'}></span>\n        {connLabel}\n      </button>\n      <button class=\"palette-hint\" onclick={() => (showPalette = true)}>\n        <span class=\"kbd\">⌘K</span> commands\n      </button>\n    </div>\n  </aside>\n\n  <main class=\"main\">\n    {#if connection.status === 'down' && route.name !== 'health'}\n      <div class=\"offline-banner\" role=\"alert\">\n        <span>The daemon is unreachable — {connection.lastError}</span>\n        <button class=\"btn btn-sm\" onclick={() => (showSettings = true)}>Connection…</button>\n      </div>\n    {/if}\n\n    {#if route.name === 'job' && route.project && route.job}\n      <JobDetailView project={route.project} jobName={route.job} tab={route.tab ?? 'brief'} />\n    {:else if route.name === 'agents' && route.project}\n      <AgentsView project={route.project} />\n    {:else if route.name === 'health'}\n      <HealthView />\n    {:else if route.name === 'jobs' && route.project}\n      <JobsView project={route.project} />\n    {:else}\n      <div class=\"landing\">\n        <Logo size={40} />\n        <p>Connecting to the daemon{data.projects.length > 0 ? '' : '…'}</p>\n      </div>\n    {/if}\n  </main>\n\n  <nav class=\"tabbar\" aria-label=\"Primary mobile\">\n    <a href={href({ name: 'jobs', project: route.project ?? data.active })} class:active={route.name === 'jobs' || route.name === 'job'}>Jobs</a>\n    <a href={href({ name: 'agents', project: route.project ?? data.active })} class:active={route.name === 'agents'}>Crew</a>\n    <a href=\"#/health\" class:active={route.name === 'health'}>Daemon</a>\n  </nav>\n</div>\n\n<Toasts />\n{#if showSettings}\n  <SettingsModal onclose={() => (showSettings = false)} />\n{/if}\n{#if showPalette}\n  <Palette\n    onclose={() => (showPalette = false)}\n    onnavigate={(h) => {\n      showPalette = false\n      navigate(h)\n    }}\n  />\n{/if}\n\n<style>\n  .shell {\n    display: grid;\n    grid-template-columns: var(--rail-w) 1fr;\n    height: 100dvh;\n    min-height: 0;\n  }\n\n  /* ── rail ─────────────────────────────────────────────────────────────── */\n  .rail {\n    display: flex;\n    flex-direction: column;\n    gap: var(--r-5);\n    padding: var(--r-5) var(--r-4);\n    border-right: 1px solid var(--line);\n    background: linear-gradient(180deg, rgba(139, 108, 246, 0.045), transparent 240px), var(--bg-1);\n    overflow-y: auto;\n  }\n\n  .brand {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n    color: var(--ink-0);\n    text-decoration: none;\n  }\n  .brand:hover {\n    text-decoration: none;\n  }\n  .word {\n    font-weight: 680;\n    font-size: 16.5px;\n    letter-spacing: -0.02em;\n  }\n  .role {\n    font-family: var(--font-mono);\n    font-size: 9.5px;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: var(--ink-2);\n    margin-left: -2px;\n    padding-top: 3px;\n  }\n\n  .project {\n    display: flex;\n    flex-direction: column;\n    gap: 6px;\n  }\n  .no-projects {\n    font-size: 12px;\n    color: var(--ink-2);\n    margin: 4px 0 0;\n    line-height: 1.5;\n  }\n  .no-projects code {\n    color: var(--ink-1);\n  }\n\n  nav[aria-label='Primary'] {\n    display: flex;\n    flex-direction: column;\n    gap: 2px;\n  }\n  nav[aria-label='Primary'] a {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    padding: 7px 10px;\n    border-radius: var(--radius-s);\n    color: var(--ink-1);\n    text-decoration: none;\n    font-size: 14px;\n    font-weight: 520;\n    transition: background var(--t-fast), color var(--t-fast);\n  }\n  nav[aria-label='Primary'] a:hover {\n    background: var(--bg-2);\n    color: var(--ink-0);\n    text-decoration: none;\n  }\n  nav[aria-label='Primary'] a.active {\n    background: var(--accent-dim);\n    color: var(--accent-bright);\n  }\n\n  .rail-foot {\n    margin-top: auto;\n    display: flex;\n    flex-direction: column;\n    gap: var(--r-2);\n  }\n  .conn {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font: inherit;\n    font-size: 12.5px;\n    color: var(--ink-1);\n    background: none;\n    border: 1px solid var(--line);\n    border-radius: var(--radius-s);\n    padding: 6px 10px;\n    cursor: pointer;\n    transition: border-color var(--t-fast);\n  }\n  .conn:hover {\n    border-color: var(--line-strong);\n  }\n  .conn.down {\n    color: #ff8d91;\n    border-color: rgba(242, 85, 90, 0.45);\n  }\n  .conn-dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: var(--ink-3);\n    flex: none;\n  }\n  .conn-dot.up {\n    background: var(--st-done);\n    box-shadow: 0 0 6px rgba(76, 195, 138, 0.6);\n  }\n  .conn-dot.down {\n    background: var(--st-human);\n  }\n  .palette-hint {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font: inherit;\n    font-size: 12px;\n    color: var(--ink-2);\n    background: none;\n    border: none;\n    padding: 4px 2px;\n    cursor: pointer;\n  }\n  .palette-hint:hover {\n    color: var(--ink-1);\n  }\n\n  /* ── main ─────────────────────────────────────────────────────────────── */\n  .main {\n    min-width: 0;\n    min-height: 0;\n    display: flex;\n    flex-direction: column;\n    overflow-y: auto;\n    scroll-behavior: smooth;\n  }\n\n  .offline-banner {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: var(--r-3);\n    padding: 9px var(--r-5);\n    background: var(--st-human-dim);\n    border-bottom: 1px solid rgba(242, 85, 90, 0.35);\n    color: #ffb3b6;\n    font-size: 13px;\n  }\n  .offline-banner span {\n    /* the message can be long (CORS guidance); wrap instead of truncating */\n    overflow-wrap: anywhere;\n  }\n\n  .landing {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: var(--r-3);\n    color: var(--ink-2);\n  }\n\n  /* mobile tab bar — hidden on desktop */\n  .tabbar {\n    display: none;\n  }\n\n  @media (max-width: 760px) {\n    .shell {\n      grid-template-columns: 1fr;\n      grid-template-rows: 1fr auto;\n    }\n    .rail {\n      display: none;\n    }\n    .tabbar {\n      display: flex;\n      border-top: 1px solid var(--line);\n      background: var(--bg-1);\n    }\n    .tabbar a {\n      flex: 1;\n      text-align: center;\n      padding: 12px 0;\n      color: var(--ink-2);\n      text-decoration: none;\n      font-size: 13.5px;\n      font-weight: 560;\n    }\n    .tabbar a.active {\n      color: var(--accent-bright);\n      box-shadow: inset 0 2px 0 var(--accent);\n    }\n  }\n</style>","lineStart":1,"lineEnd":372,"totalLines":372,"truncated":false}},"title":"web-ui/src/App.svelte","time":{"start":1787992420605,"end":1787992420608}},"id":"prt_04ca730f9001QA2HUhpGe8gUAA","sessionID":"ses_fb3594f94ffeQ3bCtRbhDqaOUL","messageID":"msg_04ca72145001iO6pBuPs4AsF9x"}}
{"type":"tool_use","timestamp":1787992420616,"sessionID":"ses_fb3594f94ffeQ3bCtRbhDqaOUL","part":{"type":"tool","tool":"read","callID":"call_349886eb63ab4ecb8ef41f3e","state":{"status":"completed","input":{"filePath":"/workspace/web-ui/src/lib/api/client.ts"},"output":"<path>/workspace/web-ui/src/lib/api/client.ts</path>\n<type>file</type>\n<content>\n1: // The API client — one fetch wrapper with the daemon's conventions:\n2: //   · JSON everywhere except job files (raw markdown bodies)\n3: //   · errors as `{ \"error\": \"…\" }` envelopes on every non-2xx\n4: //   · optional bearer token (localhost daemon is tokenless; a remote bind\n5: //     requires one — tokens are configured out-of-band, the API never issues)\n6: //\n7: // Part 2 capability probing: mutating endpoints answer 404/405 on a Part 1\n8: // daemon. The client records that as a capability miss so the UI can render\n9: // \"not available on this daemon\" instead of a raw error — the same frontend\n10: // must work against both daemon generations while job two lands.\n11: \n12: import { ep, seg } from './endpoints'\n13: import type {\n14:   AgentsResponse,\n15:   Health,\n16:   JobDiffResponse,\n17:   JobJdiResponse,\n18:   JobRow,\n19:   JobsResponse,\n20:   LaunchResponse,\n21:   OrphansResponse,\n22:   ProjectsResponse,\n23:   PruneResponse,\n24: } from './types'\n25: \n26: export interface Connection {\n27:   baseUrl: string\n28:   token: string\n29: }\n30: \n31: export class ApiError extends Error {\n32:   status: number\n33:   /** True when the daemon answered \"no such route\" — a Part 2 call on a Part 1 daemon. */\n34:   capabilityMiss: boolean\n35: \n36:   constructor(status: number, message: string) {\n37:     super(message)\n38:     this.name = 'ApiError'\n39:     this.status = status\n40:     this.capabilityMiss = status === 404 || status === 405\n41:   }\n42: }\n43: \n44: export function normalizeBaseUrl(url: string): string {\n45:   const trimmed = url.trim().replace(/\\/+$/, '')\n46:   if (!trimmed) return ''\n47:   if (/^https?:\\/\\//i.test(trimmed)) return trimmed\n48:   // Same-origin (e.g. served by the daemon itself, or behind the vite proxy).\n49:   return trimmed.startsWith('/') ? trimmed : `http://${trimmed}`\n50: }\n51: \n52: let conn: Connection = { baseUrl: '', token: '' }\n53: \n54: export function setConnection(c: Connection) {\n55:   conn = { baseUrl: normalizeBaseUrl(c.baseUrl), token: c.token }\n56: }\n57: \n58: export function getConnection(): Connection {\n59:   return { ...conn }\n60: }\n61: \n62: // ── fetch plumbing ──────────────────────────────────────────────────────────\n63: \n64: type BodyInitLike = string | undefined\n65: \n66: interface ReqOpts {\n67:   body?: BodyInitLike\n68:   contentType?: string\n69:   signal?: AbortSignal\n70: }\n71: \n72: async function request(method: string, path: string, opts: ReqOpts = {}): Promise<string> {\n73:   const headers: Record<string, string> = {}\n74:   if (conn.token) headers['Authorization'] = `Bearer ${conn.token}`\n75:   if (opts.body !== undefined && opts.contentType) headers['Content-Type'] = opts.contentType\n76: \n77:   let res: Response\n78:   try {\n79:     res = await fetch(conn.baseUrl + path, {\n80:       method,\n81:       headers,\n82:       body: opts.body,\n83:       signal: opts.signal,\n84:     })\n85:   } catch (e) {\n86:     if (e instanceof Error && e.name === 'AbortError') throw e\n87:     // A fetch that throws before any response is either a network failure or\n88:     // a CORS block — the two look identical to JS (TypeError \"Failed to\n89:     // fetch\"). The daemon is deliberately CORS-less (same-origin JSON API),\n90:     // so a cross-origin absolute URL can never work from a browser: the\n91:     // request dies in the preflight with no response at all. Surface that\n92:     // as the likely cause so the user reaches for the proxy path (/api)\n93:     // instead of hunting a nonexistent URL typo.\n94:     const target = conn.baseUrl || location.origin\n95:     try {\n96:       if (new URL(target, location.href).origin !== location.origin) {\n97:         throw new ApiError(\n98:           0,\n99:           `cross-origin URL blocked by the browser — the daemon sends no CORS headers by design; in dev set the URL to /api (vite proxies it to 127.0.0.1:8080)`,\n100:         )\n101:       }\n102:     } catch (err) {\n103:       if (err instanceof ApiError) throw err\n104:       /* unparseable base — fall through to the raw fetch error */\n105:     }\n106:     throw new ApiError(\n107:       0,\n108:       `cannot reach the daemon at ${conn.baseUrl || '(same origin)'} — ${e instanceof Error ? e.message : String(e)}`,\n109:     )\n110:   }\n111: \n112:   if (res.status === 401) {\n113:     throw new ApiError(401, 'the daemon rejected the token (401) — check the connection settings')\n114:   }\n115:   if (!res.ok) {\n116:     let msg = `HTTP ${res.status}`\n117:     try {\n118:       const data = (await res.json()) as { error?: string }\n119:       if (data && typeof data.error === 'string' && data.error) msg = data.error\n120:     } catch {\n121:       /* non-JSON error body — keep the status line */\n122:     }\n123:     throw new ApiError(res.status, msg)\n124:   }\n125:   return res.text()\n126: }\n127: \n128: async function json<T>(method: string, path: string, opts: ReqOpts = {}): Promise<T> {\n129:   const text = await request(method, path, opts)\n130:   return (text === '' ? undefined : (JSON.parse(text) as T)) as T\n131: }\n132: \n133: function post<T>(path: string, body?: unknown): Promise<T> {\n134:   return json<T>('POST', path, {\n135:     body: body === undefined ? undefined : JSON.stringify(body),\n136:     contentType: 'application/json',\n137:   })\n138: }\n139: \n140: // ── Part 1: read-only ───────────────────────────────────────────────────────\n141: \n142: export function getHealth(signal?: AbortSignal): Promise<Health> {\n143:   return json<Health>('GET', ep.health, { signal })\n144: }\n145: \n146: export function getProjects(signal?: AbortSignal): Promise<ProjectsResponse> {\n147:   return json<ProjectsResponse>('GET', ep.projects, { signal })\n148: }\n149: \n150: export function getJobs(project: string, signal?: AbortSignal): Promise<JobsResponse> {\n151:   return json<JobsResponse>('GET', `${ep.jobs(seg(project))}`, { signal })\n152: }\n153: \n154: // The daemon's file route takes the on-disk filename (brief.md, not brief) —\n155: // job one's shipped whitelist keys are the full file names. Map the UI's\n156: // logical tab id to the real filename so the client matches the daemon.\n157: const JOB_FILENAMES: Record<string, string> = {\n158:   brief: 'brief.md',\n159:   tasks: 'tasks.md',\n160:   implementation: 'implementation.md',\n161:   verdict: 'verdict.md',\n162: }\n163: \n164: export function getJobFile(project: string, job: string, file: string, signal?: AbortSignal): Promise<string> {\n165:   const filename = JOB_FILENAMES[file] ?? file\n166:   return request('GET', ep.file(seg(project), seg(job), seg(filename)), { signal })\n167: }\n168: \n169: export function getJobJdi(project: string, job: string, signal?: AbortSignal): Promise<JobJdiResponse> {\n170:   return json<JobJdiResponse>('GET', ep.jdi(seg(project), seg(job)), { signal })\n171: }\n172: \n173: export function getJobDiff(project: string, job: string, full = false, signal?: AbortSignal): Promise<JobDiffResponse> {\n174:   return json<JobDiffResponse>('GET', `${ep.diff(seg(project), seg(job))}${full ? '?full=1' : ''}`, { signal })\n175: }\n176: \n177: export function getAgents(project: string, signal?: AbortSignal): Promise<AgentsResponse> {\n178:   return json<AgentsResponse>('GET', ep.agents(seg(project)), { signal })\n179: }\n180: \n181: // ── Part 2: mutating + supervision ──────────────────────────────────────────\n182: \n183: export function createJob(project: string, title: string, type: string): Promise<{ job: JobRow | string }> {\n184:   return post(ep.createJob(seg(project)), { title, type })\n185: }\n186: \n187: export function saveBrief(project: string, job: string, content: string): Promise<{ ok: boolean }> {\n188:   return json<{ ok: boolean }>('PUT', ep.saveBrief(seg(project), seg(job)), {\n189:     body: content,\n190:     contentType: 'text/markdown; charset=utf-8',\n191:   })\n192: }\n193: \n194: export function launchAgent(project: string, job: string, agent: string, profile?: string): Promise<LaunchResponse> {\n195:   return post(ep.launchAgent(seg(project), seg(job), seg(agent)), profile ? { profile } : {})\n196: }\n197: \n198: export function startJdi(project: string, job: string, profile?: string): Promise<LaunchResponse> {\n199:   return post(ep.startJdi(seg(project), seg(job)), profile ? { profile } : {})\n200: }\n201: \n202: export function doneJob(project: string, job: string): Promise<{ message?: string }> {\n203:   return post(ep.doneJob(seg(project), seg(job)))\n204: }\n205: \n206: export function deleteJob(project: string, job: string): Promise<{ message?: string }> {\n207:   return post(ep.deleteJob(seg(project), seg(job)))\n208: }\n209: \n210: export function pushJob(project: string, job: string): Promise<{ message?: string }> {\n211:   return post(ep.pushJob(seg(project), seg(job)))\n212: }\n213: \n214: export function getOrphans(project: string, signal?: AbortSignal): Promise<OrphansResponse> {\n215:   return json<OrphansResponse>('GET', ep.orphans(seg(project)), { signal })\n216: }\n217: \n218: export function removeOrphans(project: string): Promise<{ message?: string }> {\n219:   return post(ep.removeOrphans(seg(project)))\n220: }\n221: \n222: export function pruneContainers(): Promise<PruneResponse> {\n223:   return post(ep.pruneContainers())\n224: }\n\n(End of file - total 224 lines)\n</content>","metadata":{"preview":"// The API client — one fetch wrapper with the daemon's conventions:\n//   · JSON everywhere except job files (raw markdown bodies)\n//   · errors as `{ \"error\": \"…\" }` envelopes on every non-2xx\n//   · optional bearer token (localhost daemon is tokenless; a remote bind\n//     requires one — tokens are configured out-of-band, the API never issues)\n//\n// Part 2 capability probing: mutating endpoints answer 404/405 on a Part 1\n// daemon. The client records that as a capability miss so the UI can render\n// \"not available on this daemon\" instead of a raw error — the same frontend\n// must work against both daemon generations while job two lands.\n\nimport { ep, seg } from './endpoints'\nimport type {\n  AgentsResponse,\n  Health,\n  JobDiffResponse,\n  JobJdiResponse,\n  JobRow,\n  JobsResponse,\n  LaunchResponse,","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/web-ui/src/lib/api/client.ts","text":"// The API client — one fetch wrapper with the daemon's conventions:\n//   · JSON everywhere except job files (raw markdown bodies)\n//   · errors as `{ \"error\": \"…\" }` envelopes on every non-2xx\n//   · optional bearer token (localhost daemon is tokenless; a remote bind\n//     requires one — tokens are configured out-of-band, the API never issues)\n//\n// Part 2 capability probing: mutating endpoints answer 404/405 on a Part 1\n// daemon. The client records that as a capability miss so the UI can render\n// \"not available on this daemon\" instead of a raw error — the same frontend\n// must work against both daemon generations while job two lands.\n\nimport { ep, seg } from './endpoints'\nimport type {\n  AgentsResponse,\n  Health,\n  JobDiffResponse,\n  JobJdiResponse,\n  JobRow,\n  JobsResponse,\n  LaunchResponse,\n  OrphansResponse,\n  ProjectsResponse,\n  PruneResponse,\n} from './types'\n\nexport interface Connection {\n  baseUrl: string\n  token: string\n}\n\nexport class ApiError extends Error {\n  status: number\n  /** True when the daemon answered \"no such route\" — a Part 2 call on a Part 1 daemon. */\n  capabilityMiss: boolean\n\n  constructor(status: number, message: string) {\n    super(message)\n    this.name = 'ApiError'\n    this.status = status\n    this.capabilityMiss = status === 404 || status === 405\n  }\n}\n\nexport function normalizeBaseUrl(url: string): string {\n  const trimmed = url.trim().replace(/\\/+$/, '')\n  if (!trimmed) return ''\n  if (/^https?:\\/\\//i.test(trimmed)) return trimmed\n  // Same-origin (e.g. served by the daemon itself, or behind the vite proxy).\n  return trimmed.startsWith('/') ? trimmed : `http://${trimmed}`\n}\n\nlet conn: Connection = { baseUrl: '', token: '' }\n\nexport function setConnection(c: Connection) {\n  conn = { baseUrl: normalizeBaseUrl(c.baseUrl), token: c.token }\n}\n\nexport function getConnection(): Connection {\n  return { ...conn }\n}\n\n// ── fetch plumbing ──────────────────────────────────────────────────────────\n\ntype BodyInitLike = string | undefined\n\ninterface ReqOpts {\n  body?: BodyInitLike\n  contentType?: string\n  signal?: AbortSignal\n}\n\nasync function request(method: string, path: string, opts: ReqOpts = {}): Promise<string> {\n  const headers: Record<string, string> = {}\n  if (conn.token) headers['Authorization'] = `Bearer ${conn.token}`\n  if (opts.body !== undefined && opts.contentType) headers['Content-Type'] = opts.contentType\n\n  let res: Response\n  try {\n    res = await fetch(conn.baseUrl + path, {\n      method,\n      headers,\n      body: opts.body,\n      signal: opts.signal,\n    })\n  } catch (e) {\n    if (e instanceof Error && e.name === 'AbortError') throw e\n    // A fetch that throws before any response is either a network failure or\n    // a CORS block — the two look identical to JS (TypeError \"Failed to\n    // fetch\"). The daemon is deliberately CORS-less (same-origin JSON API),\n    // so a cross-origin absolute URL can never work from a browser: the\n    // request dies in the preflight with no response at all. Surface that\n    // as the likely cause so the user reaches for the proxy path (/api)\n    // instead of hunting a nonexistent URL typo.\n    const target = conn.baseUrl || location.origin\n    try {\n      if (new URL(target, location.href).origin !== location.origin) {\n        throw new ApiError(\n          0,\n          `cross-origin URL blocked by the browser — the daemon sends no CORS headers by design; in dev set the URL to /api (vite proxies it to 127.0.0.1:8080)`,\n        )\n      }\n    } catch (err) {\n      if (err instanceof ApiError) throw err\n      /* unparseable base — fall through to the raw fetch error */\n    }\n    throw new ApiError(\n      0,\n      `cannot reach the daemon at ${conn.baseUrl || '(same origin)'} — ${e instanceof Error ? e.message : String(e)}`,\n    )\n  }\n\n  if (res.status === 401) {\n    throw new ApiError(401, 'the daemon rejected the token (401) — check the connection settings')\n  }\n  if (!res.ok) {\n    let msg = `HTTP ${res.status}`\n    try {\n      const data = (await res.json()) as { error?: string }\n      if (data && typeof data.error === 'string' && data.error) msg = data.error\n    } catch {\n      /* non-JSON error body — keep the status line */\n    }\n    throw new ApiError(res.status, msg)\n  }\n  return res.text()\n}\n\nasync function json<T>(method: string, path: string, opts: ReqOpts = {}): Promise<T> {\n  const text = await request(method, path, opts)\n  return (text === '' ? undefined : (JSON.parse(text) as T)) as T\n}\n\nfunction post<T>(path: string, body?: unknown): Promise<T> {\n  return json<T>('POST', path, {\n    body: body === undefined ? undefined : JSON.stringify(body),\n    contentType: 'application/json',\n  })\n}\n\n// ── Part 1: read-only ───────────────────────────────────────────────────────\n\nexport function getHealth(signal?: AbortSignal): Promise<Health> {\n  return json<Health>('GET', ep.health, { signal })\n}\n\nexport function getProjects(signal?: AbortSignal): Promise<ProjectsResponse> {\n  return json<ProjectsResponse>('GET', ep.projects, { signal })\n}\n\nexport function getJobs(project: string, signal?: AbortSignal): Promise<JobsResponse> {\n  return json<JobsResponse>('GET', `${ep.jobs(seg(project))}`, { signal })\n}\n\n// The daemon's file route takes the on-disk filename (brief.md, not brief) —\n// job one's shipped whitelist keys are the full file names. Map the UI's\n// logical tab id to the real filename so the client matches the daemon.\nconst JOB_FILENAMES: Record<string, string> = {\n  brief: 'brief.md',\n  tasks: 'tasks.md',\n  implementation: 'implementation.md',\n  verdict: 'verdict.md',\n}\n\nexport function getJobFile(project: string, job: string, file: string, signal?: AbortSignal): Promise<string> {\n  const filename = JOB_FILENAMES[file] ?? file\n  return request('GET', ep.file(seg(project), seg(job), seg(filename)), { signal })\n}\n\nexport function getJobJdi(project: string, job: string, signal?: AbortSignal): Promise<JobJdiResponse> {\n  return json<JobJdiResponse>('GET', ep.jdi(seg(project), seg(job)), { signal })\n}\n\nexport function getJobDiff(project: string, job: string, full = false, signal?: AbortSignal): Promise<JobDiffResponse> {\n  return json<JobDiffResponse>('GET', `${ep.diff(seg(project), seg(job))}${full ? '?full=1' : ''}`, { signal })\n}\n\nexport function getAgents(project: string, signal?: AbortSignal): Promise<AgentsResponse> {\n  return json<AgentsResponse>('GET', ep.agents(seg(project)), { signal })\n}\n\n// ── Part 2: mutating + supervision ──────────────────────────────────────────\n\nexport function createJob(project: string, title: string, type: string): Promise<{ job: JobRow | string }> {\n  return post(ep.createJob(seg(project)), { title, type })\n}\n\nexport function saveBrief(project: string, job: string, content: string): Promise<{ ok: boolean }> {\n  return json<{ ok: boolean }>('PUT', ep.saveBrief(seg(project), seg(job)), {\n    body: content,\n    contentType: 'text/markdown; charset=utf-8',\n  })\n}\n\nexport function launchAgent(project: string, job: string, agent: string, profile?: string): Promise<LaunchResponse> {\n  return post(ep.launchAgent(seg(project), seg(job), seg(agent)), profile ? { profile } : {})\n}\n\nexport function startJdi(project: string, job: string, profile?: string): Promise<LaunchResponse> {\n  return post(ep.startJdi(seg(project), seg(job)), profile ? { profile } : {})\n}\n\nexport function doneJob(project: string, job: string): Promise<{ message?: string }> {\n  return post(ep.doneJob(seg(project), seg(job)))\n}\n\nexport function deleteJob(project: string, job: string): Promise<{ message?: string }> {\n  return post(ep.deleteJob(seg(project), seg(job)))\n}\n\nexport function pushJob(project: string, job: string): Promise<{ message?: string }> {\n  return post(ep.pushJob(seg(project), seg(job)))\n}\n\nexport function getOrphans(project: string, signal?: AbortSignal): Promise<OrphansResponse> {\n  return json<OrphansResponse>('GET', ep.orphans(seg(project)), { signal })\n}\n\nexport function removeOrphans(project: string): Promise<{ message?: string }> {\n  return post(ep.removeOrphans(seg(project)))\n}\n\nexport function pruneContainers(): Promise<PruneResponse> {\n  return post(ep.pruneContainers())\n}","lineStart":1,"lineEnd":224,"totalLines":224,"truncated":false}},"title":"web-ui/src/lib/api/client.ts","time":{"start":1787992420599,"end":1787992420612}},"id":"prt_04ca730f40015lA0K41qK7ruRQ","sessionID":"ses_fb3594f94ffeQ3bCtRbhDqaOUL","messageID":"msg_04ca72145001iO6pBuPs4AsF9x"}}
