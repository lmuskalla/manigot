{"type":"tool_use","timestamp":1787993713431,"sessionID":"ses_fb3457eb3fferiW9S1l2qfOUfr","part":{"type":"tool","tool":"read","callID":"call_e81d11336e9d4dccb8d4abfd","state":{"status":"completed","input":{"filePath":"/workspace/web-ui/src/lib/views/HealthView.svelte"},"output":"<path>/workspace/web-ui/src/lib/views/HealthView.svelte</path>\n<type>file</type>\n<content>\n1: <script lang=\"ts\">\n2:   import { onMount } from 'svelte'\n3:   import { connection } from '$lib/state/connection.svelte'\n4:   import { toasts } from '$lib/state/toasts.svelte'\n5:   import SettingsModal from '$lib/components/SettingsModal.svelte'\n6:   import Confirm from '$lib/components/Confirm.svelte'\n7:   import { pruneContainers } from '$lib/api/client'\n8: \n9:   let showSettings = $state(false)\n10:   let confirmPrune = $state(false)\n11:   let pruning = $state(false)\n12: \n13:   onMount(() => {\n14:     void connection.check()\n15:   })\n16: \n17:   async function doPrune() {\n18:     pruning = true\n19:     try {\n20:       const res = await pruneContainers()\n21:       toasts.ok(\n22:         `Removed ${res.removed} exited container${res.removed === 1 ? '' : 's'} — ${res.running} manigot container${res.running === 1 ? '' : 's'} running`,\n23:       )\n24:       confirmPrune = false\n25:     } catch (e) {\n26:       const msg =\n27:         e instanceof Error &&\n28:         'capabilityMiss' in e &&\n29:         (e as { capabilityMiss: boolean }).capabilityMiss\n30:           ? 'Container pruning lands with job two of the control plane.'\n31:           : e instanceof Error\n32:             ? e.message\n33:             : String(e)\n34:       toasts.error(msg)\n35:       confirmPrune = false\n36:     } finally {\n37:       pruning = false\n38:     }\n39:   }\n40: </script>\n41: \n42: <div class=\"page\">\n43:   <header class=\"head\">\n44:     <div>\n45:       <p class=\"eyebrow\">daemon</p>\n46:       <h1>mg serve</h1>\n47:     </div>\n48:     <button class=\"btn\" onclick={() => (showSettings = true)}>Connection…</button>\n49:   </header>\n50: \n51:   {#if connection.status === 'up' && connection.health}\n52:     <section class=\"panel\">\n53:       <div class=\"row\">\n54:         <span class=\"k\">version</span>\n55:         <span class=\"v mono\">{connection.health.version || '—'}</span>\n56:       </div>\n57:       <div class=\"row\">\n58:         <span class=\"k\">docker image</span>\n59:         <span class=\"v\">\n60:           {#if connection.health.imagePresent}\n61:             <span class=\"chip chip-done\"><span class=\"dot\"></span> present</span>\n62:           {:else}\n63:             <span class=\"chip chip-human\"><span class=\"dot\"></span> missing — run make build</span>\n64:           {/if}\n65:         </span>\n66:       </div>\n67:       <div class=\"row\">\n68:         <span class=\"k\">connection</span>\n69:         <span class=\"v mono\">{connection.baseUrl || '(same origin)'} · {connection.token ? 'bearer token' : 'tokenless'}</span>\n70:       </div>\n71:     </section>\n72: \n73:     <section class=\"panel\">\n74:       <header class=\"panel-head\">\n75:         <h2>Profiles</h2>\n76:         <p class=\"sub\">Which subscription profiles have credentials ready — booleans only, never the credentials.</p>\n77:       </header>\n78:       <ul class=\"profiles\">\n79:         {#each connection.health.profiles ?? [] as p (p.id)}\n80:           <li class=\"profile\" class:ready={p.ready}>\n81:             <span class=\"p-dot\"></span>\n82:             <span class=\"p-name mono\">{p.id}</span>\n83:             <span class=\"p-state\">{p.ready ? 'ready' : 'not configured'}</span>\n84:           </li>\n85:         {/each}\n86:       </ul>\n87:     </section>\n88:   {:else if connection.status === 'connecting'}\n89:     <p class=\"loading\">Checking the daemon…</p>\n90:   {:else}\n91:     <section class=\"panel down\">\n92:       <h2>Daemon unreachable</h2>\n93:       <p class=\"sub\">{connection.lastError}</p>\n94:       <p class=\"sub\">\n95:         Start it with <code>mg serve</code> (localhost, tokenless) or point the connection at the\n96:         right URL and token.\n97:       </p>\n98:     </section>\n99:   {/if}\n100: \n101:   <section class=\"panel\">\n102:     <header class=\"panel-head\">\n103:       <h2>Maintenance</h2>\n104:       <p class=\"sub\">The cleanup a headless daemon needs — no terminal required.</p>\n105:     </header>\n106:     <div class=\"maint\">\n107:       <div>\n108:         <p class=\"m-k\">Prune containers</p>\n109:         <p class=\"m-d\">Remove exited manigot containers — the residue of abnormal session ends.</p>\n110:       </div>\n111:       <button class=\"btn\" onclick={() => (confirmPrune = true)}>Prune…</button>\n112:     </div>\n113:     <p class=\"fine\">\n114:       Orphaned-worktree cleanup lives in each project's jobs view.\n115:     </p>\n116:   </section>\n117: </div>\n118: \n119: {#if showSettings}\n120:   <SettingsModal onclose={() => (showSettings = false)} />\n121: {/if}\n122: \n123: {#if confirmPrune}\n124:   <Confirm\n125:     title=\"Prune containers\"\n126:     body=\"Remove exited manigot containers?\\nRunning containers are never touched.\"\n127:     confirmLabel=\"Prune\"\n128:     onconfirm={doPrune}\n129:     busy={pruning}\n130:     onclose={() => (confirmPrune = false)}\n131:   />\n132: {/if}\n133: \n134: <style>\n135:   .page {\n136:     max-width: 720px;\n137:     margin: 0 auto;\n138:     padding: var(--r-6) var(--r-6) var(--r-7);\n139:     width: 100%;\n140:     display: flex;\n141:     flex-direction: column;\n142:     gap: var(--r-4);\n143:   }\n144:   .head {\n145:     display: flex;\n146:     justify-content: space-between;\n147:     align-items: flex-end;\n148:     gap: var(--r-4);\n149:   }\n150:   h1 {\n151:     font-size: 24px;\n152:     letter-spacing: -0.02em;\n153:   }\n154: \n155:   .panel {\n156:     background: var(--bg-1);\n157:     border: 1px solid var(--line);\n158:     border-radius: var(--radius-m);