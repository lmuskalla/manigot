og/stream`, // GET SSE\n}\n\n/** Escape a URL segment conservatively (names are id_slug identifiers). */\nexport function seg(s: string): string {\n  return encodeURIComponent(s)\n}","lineStart":1,"lineEnd":40,"totalLines":40,"truncated":false}},"title":"web-ui/src/lib/api/endpoints.ts","time":{"start":1787995826569,"end":1787995826574}},"id":"prt_04cdb2900001jysb3ZpK94837H","sessionID":"ses_fb3250779ffe153rxsL511kCsf","messageID":"msg_04cdb257f001QQGU1N0rhASSuR"}}
