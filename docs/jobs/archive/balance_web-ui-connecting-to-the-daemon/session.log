{"type":"tool_use","timestamp":1787996374242,"sessionID":"ses_fb3250779ffe153rxsL511kCsf","part":{"type":"tool","tool":"read","callID":"call_1e3520df6b394886b5693582","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/api.go"},"output":"<path>/workspace/src/internal/serve/api.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"encoding/json\"\n5: \t\"errors\"\n6: \t\"fmt\"\n7: \t\"io\"\n8: \t\"net/http\"\n9: \t\"os\"\n10: \t\"path/filepath\"\n11: \t\"strings\"\n12: \t\"time\"\n13: \n14: \t\"github.com/lmuskalla/manigot/internal/agentlist\"\n15: \t\"github.com/lmuskalla/manigot/internal/config\"\n16: \t\"github.com/lmuskalla/manigot/internal/git\"\n17: \t\"github.com/lmuskalla/manigot/internal/job\"\n18: \t\"github.com/lmuskalla/manigot/internal/project\"\n19: \t\"github.com/lmuskalla/manigot/internal/session\"\n20: )\n21: \n22: // --- JSON helpers ------------------------------------------------------------\n23: \n24: // writeJSON writes v as a JSON response with the given status.\n25: func writeJSON(w http.ResponseWriter, status int, v any) {\n26: \tw.Header().Set(\"Content-Type\", \"application/json\")\n27: \tw.WriteHeader(status)\n28: \t_ = json.NewEncoder(w).Encode(v)\n29: }\n30: \n31: // apiError is the JSON error envelope every non-2xx response carries.\n32: type apiError struct {\n33: \tError string `json:\"error\"`\n34: }\n35: \n36: // writeError writes a JSON error envelope with the given status.\n37: func writeError(w http.ResponseWriter, status int, msg string) {\n38: \twriteJSON(w, status, apiError{Error: msg})\n39: }\n40: \n41: // --- Resolution helpers — the zero-path-inputs choke point -------------------\n42: //\n43: // Every handler resolves its URL segments ONLY through these helpers. A\n44: // segment is validated as a plain identifier (validSegment), then matched —\n45: // never joined into a filesystem path. The registered roots (TASK-1), the\n46: // discovered jobs, and the file whitelist are the only sources of paths the\n47: // handlers ever open.\n48: \n49: // validSegment reports whether a URL segment is a plain, trustworthy\n50: // identifier: non-empty, not \".\" or \"..\" (traversal), containing no path\n51: // separator (forward or backslash — the backslash is a Windows separator and\n52: // must never reach a filesystem path), and no NUL byte. Percent-encoded and\n53: // double-encoded variants all decode to one of these forms before matching,\n54: // so rejecting the decoded form rejects them all.\n55: func validSegment(seg string) bool {\n56: \tif seg == \"\" || seg == \".\" || seg == \"..\" {\n57: \t\treturn false\n58: \t}\n59: \tif strings.ContainsAny(seg, \"/\\\\\") {\n60: \t\treturn false\n61: \t}\n62: \treturn !strings.ContainsRune(seg, 0)\n63: }\n64: \n65: // resolveProject maps a URL project segment to a registered root. The segment\n66: // is validated, then matched against the registry by configured entry name\n67: // only (Registry.Project) — it is never joined into a filesystem path. An\n68: // invalid segment or no match is a 404; the handler returns false and must\n69: // return immediately.\n70: func (s *Server) resolveProject(w http.ResponseWriter, segment string) (string, bool) {\n71: \tif !validSegment(segment) {\n72: \t\twriteError(w, http.StatusNotFound, \"project not found\")\n73: \t\treturn \"\", false\n74: \t}\n75: \troot, ok := s.reg.Project(segment)\n76: \tif !ok {\n77: \t\twriteError(w, http.StatusNotFound, \"project not found\")\n78: \t\treturn \"\", false\n79: \t}\n80: \treturn root, true\n81: }\n82: \n83: // resolveJob maps a URL job segment to a discovered job under root. The\n84: // segment is validated, then matched against the project's discovered jobs by\n85: // ID, then by id_slug name (the job directory name — the same identity the\n86: // CLI's branch-tail matching uses), then by unique name prefix. It is never\n87: // treated as a path. Not-found is a 404; an ambiguous prefix is a 409; the\n88: // handler returns false and must return immediately.\n89: func (s *Server) resolveJob(w http.ResponseWriter, root, segment string) (job.Job, bool) {\n90: \tif !validSegment(segment) {\n91: \t\twriteError(w, http.StatusNotFound, \"job not found\")\n92: \t\treturn job.Job{}, false\n93: \t}\n94: \tjobs, err := job.Discover(root)\n95: \tif err != nil {\n96: \t\twriteError(w, http.StatusInternalServerError, \"cannot read jobs\")\n97: \t\treturn job.Job{}, false\n98: \t}\n99: \n100: \t// Exact by ID, then by name.\n101: \tfor _, j := range jobs {\n102: \t\tif j.ID == segment || j.Name == segment {\n103: \t\t\treturn j, true\n104: \t\t}\n105: \t}\n106: \n107: \t// Unique prefix on the name.\n108: \tvar matches []job.Job\n109: \tfor _, j := range jobs {\n110: \t\tif strings.HasPrefix(j.Name, segment) {\n111: \t\t\tmatches = append(matches, j)\n112: \t\t}\n113: \t}\n114: \tswitch len(matches) {\n115: \tcase 0:\n116: \t\twriteError(w, http.StatusNotFound, fmt.Sprintf(\"job '%s' not found among the project's jobs\", segment))\n117: \t\treturn job.Job{}, false\n118: \tcase 1:\n119: \t\treturn matches[0], true\n120: \tdefault:\n121: \t\tnames := make([]string, 0, len(matches))\n122: \t\tfor _, j := range matches {\n123: \t\t\tnames = append(names, j.Name)\n124: \t\t}\n125: \t\twriteError(w, http.StatusConflict, fmt.Sprintf(\"job '%s' is ambiguous — matches jobs: %s\", segment, strings.Join(names, \" \")))\n126: \t\treturn job.Job{}, false\n127: \t}\n128: }\n129: \n130: // jobFileNames is the whitelist of job files the API serves: a job's four\n131: // markdown files, read as raw markdown text. Nothing else under the job dir\n132: // is ever served.\n133: var jobFileNames = map[string]bool{\n134: \t\"brief.md\":          true,\n135: \t\"tasks.md\":          true,\n136: \t\"implementation.md\": true,\n137: \t\"verdict.md\":        true,\n138: }\n139: \n140: // --- /health -----------------------------------------------------------------\n141: \n142: // healthProfileRow is one profile's credential readiness in the /health\n143: // response: ready = the profile's ResolveProfile + CheckAuth succeed (the\n144: // same check the session launcher runs). A missing key is \"not ready\", never\n145: // an error; the credential values themselves are never reported.\n146: type healthProfileRow struct {\n147: \tID    string `json:\"id\"`\n148: \tReady bool   `json:\"ready\"`\n149: }\n150: \n151: // healthResponse is the /health response shape: the mg version, whether the\n152: // docker image is present (session.ImagePresent), and per-profile readiness.\n153: type healthResponse struct {\n154: \tVersion      string             `json:\"version\"`\n155: \tImagePresent bool               `json:\"imagePresent\"`\n156: \tProfiles     []healthProfileRow `json:\"profiles\"`\n157: }\n158: \n159: // profileReady reduces a profile's credential check to a boolean.\n160: func profileReady(id string) bool {\n161: \tinfo, err := session.ResolveProfile(session.Options{Profile: id})\n162: \tif err != nil {\n163: \t\treturn false\n164: \t}\n165: \treturn info.CheckAuth() == nil\n166: }\n167: \n168: // handleHealth serves the daemon's health/status: version, docker image\n169: // presence, and profile readiness — pure booleans and identifiers, never\n170: // credential material.\n171: func (s *Server) handleHealth(w http.ResponseWriter, r *http.Request) {\n172: \tresp := healthResponse{\n173: \t\tVersion:      s.version,\n174: \t\tImagePresent: session.ImagePresent(),\n175: \t}\n176: \tfor _, p := range config.Profiles() {\n177: \t\tresp.Profiles = append(resp.Profiles, healthProfileRow{ID: p.ID, Ready: profileReady(p.ID)})\n178: \t}\n179: \twriteJSON(w, http.StatusOK, resp)\n180: }\n181: \n182: // --- /projects ---------------------------------------------------------------\n183: \n184: // projectRow is one entry in the /projects response: a registered root and\n185: // its configured name (the URL segment that resolves to it).\n186: type projectRow struct {\n187: \tPath string `json:\"path\"`\n188: \tName string `json:\"name\"`\n189: }\n190: \n191: // projectsResponse is the /projects response shape.\n192: type projectsResponse struct {\n193: \tProjects []projectRow `json:\"projects\"`\n194: }\n195: \n196: // handleProjects lists the registered project roots — pure registry data, the\n197: // daemon never scans for projects it does not know.\n198: func (s *Server) handleProjects(w http.ResponseWriter, r *http.Request) {\n199: \tentries := s.reg.Entries()\n200: \trows := make([]projectRow, 0, len(entries))\n201: \tfor _, e := range entries {\n202: \t\trows = append(rows, projectRow{Path: e.Path, Name: e.Name})\n203: \t}\n204: \twriteJSON(w, http.StatusOK, projectsResponse{Projects: rows})\n205: }\n206: \n207: // --- /projects/{project}/jobs ------------------------------------------------\n208: \n209: // jdiStatusRow is the mg-jdi activity state for a job: state / agent / last\n210: // update, from the job's status sidecar. Omitted when there is no live run\n211: // state (a job mg-jdi never drove, or a stale/unreadable sidecar).\n212: type jdiStatusRow struct {\n213: \tState   string `json:\"state\"`\n214: \tAgent   string `json:\"agent\"`\n215: \tUpdated string `json:\"updated\"` // RFC3339\n216: }\n217: \n218: // jobRow is one row in the jobs response — the TUI's info design: id / status\n219: // / stage / type / date / title, one row per job, in job.Discover's sort\n220: // order (newest first).\n221: type jobRow struct {\n222: \tID     string        `json:\"id\"`\n223: \tName   string        `json:\"name\"`\n224: \tStatus string        `json:\"status\"`\n225: \tStage  string        `json:\"stage\"`\n226: \tType   string        `json:\"type\"`\n227: \tDate   string        `json:\"date\"`\n228: \tTitle  string        `json:\"title\"`\n229: \tBranch string        `json:\"branch,omitempty\"`\n230: \tJDI    *jdiStatusRow `json:\"jdi,omitempty\"`\n231: }\n232: \n233: // jobsResponse is the /projects/{project}/jobs response shape.\n234: type jobsResponse struct {\n235: \tJobs []jobRow `json:\"jobs\"`\n236: }\n237: \n238: // handleProjectJobs lists a project's open jobs with the mg-jdi activity\n239: // state per job.\n240: func (s *Server) handleProjectJobs(w http.ResponseWriter, r *http.Request) {\n241: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n242: \tif !ok {\n243: \t\treturn\n244: \t}\n245: \tjobs, err := job.Discover(root)\n246: \tif err != nil {\n247: \t\twriteError(w, http.StatusInternalServerError, \"cannot read jobs\")\n248: \t\treturn\n249: \t}\n250: \trows := make([]jobRow, 0, len(jobs))\n251: \tfor _, j := range jobs {\n252: \t\trow := jobRow{\n253: \t\t\tID:     j.ID,\n254: \t\t\tName:   j.Name,\n255: \t\t\tStatus: j.Status,\n256: \t\t\tStage:  string(j.Stage()),\n257: \t\t\tType:   j.Type,\n258: \t\t\tDate:   j.Date,\n259: \t\t\tTitle:  j.Title,\n260: \t\t\tBranch: j.Branch,\n261: \t\t}\n262: \t\tif st, ok := job.ReadJDIStatus(root, j.Name); ok {\n263: \t\t\trow.JDI = &jdiStatusRow{\n264: \t\t\t\tState:   string(st.State),\n265: \t\t\t\tAgent:   st.Agent,\n266: \t\t\t\tUpdated: st.Updated.Format(time.RFC3339),\n267: \t\t\t}\n268: \t\t}\n269: \t\trows = append(rows, row)\n270: \t}\n271: \twriteJSON(w, http.StatusOK, jobsResponse{Jobs: rows})\n272: }\n273: \n274: // --- /projects/{project}/jobs/{job}/files/{file} -----------------------------\n275: \n276: // handleJobFile serves one of a job's four markdown files as raw markdown\n277: // text. The file segment is whitelisted (jobFileNames); a missing file is a\n278: // normal 404 (e.g. verdict.md before review).\n279: func (s *Server) handleJobFile(w http.ResponseWriter, r *http.Request) {\n280: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n281: \tif !ok {\n282: \t\treturn\n283: \t}\n284: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n285: \tif !ok {\n286: \t\treturn\n287: \t}\n288: \tfile := r.PathValue(\"file\")\n289: \tif !jobFileNames[file] {\n290: \t\twriteError(w, http.StatusNotFound, \"file not found\")\n291: \t\treturn\n292: \t}\n293: \tdata, err := os.ReadFile(filepath.Join(j.Dir, file))\n294: \tif err != nil {\n295: \t\twriteError(w, http.StatusNotFound, \"file not found\")\n296: \t\treturn\n297: \t}\n298: \tw.Header().Set(\"Content-Type\", \"text/markdown; charset=utf-8\")\n299: \tw.WriteHeader(http.StatusOK)\n300: \t_, _ = w.Write(data)\n301: }\n302: \n303: // --- /projects/{project}/jobs/{job}/jdi -------------------------------------\n304: \n305: // jobJDIResponse is the /projects/{project}/jobs/{job}/jdi response shape:\n306: // the mg-jdi status (state/agent/updated — null when there is no live run\n307: // state), the run.log tail (null when mg-jdi never ran the job), and the\n308: // job's session.log tail (null when no run output was captured yet — a\n309: // normal \"no run yet\", not an error).\n310: type jobJDIResponse struct {\n311: \tStatus     *jdiStatusRow `json:\"status\"`\n312: \tRunLog     *string       `json:\"runLog\"`\n313: \tSessionLog *string       `json:\"sessionLog\"`\n314: }\n315: \n316: // tailBytes bounds how much of a log file the jdi endpoint loads into memory\n317: // — a tail, not \"load everything\", the same bounded-viewport approach\n318: // job.ReadJDIRunLogTail already uses for run.log (256 KiB, generous enough\n319: // for many invocations' worth of text while a small, fixed cost).\n320: const tailBytes = 256 * 1024\n321: \n322: // readFileTail returns the last tailBytes of the file at path — the\n323: // session.log counterpart of job.ReadJDIRunLogTail, applied to a job-dir file\n324: // (docs/jobs/<name>/session.log). A possibly-partial first line is dropped so\n325: // the tail starts at a clean boundary, with a truncation marker. ok is false\n326: // only when the file is missing; an existing-but-empty file is (\"\", true).\n327: func readFileTail(path string) (string, bool) {\n328: \tf, err := os.Open(path)\n329: \tif err != nil {\n330: \t\treturn \"\", false\n331: \t}\n332: \tdefer f.Close()\n333: \n334: \tinfo, err := f.Stat()\n335: \tif err != nil {\n336: \t\treturn \"\", false\n337: \t}\n338: \tsize := info.Size()\n339: \tif size == 0 {\n340: \t\treturn \"\", true\n341: \t}\n342: \n343: \tstart := int64(0)\n344: \ttruncated := false\n345: \tif size > tailBytes {\n346: \t\tstart = size - tailBytes\n347: \t\ttruncated = true\n348: \t}\n349: \tif _, err := f.Seek(start, io.SeekStart); err != nil {\n350: \t\treturn \"\", false\n351: \t}\n352: \tdata, err := io.ReadAll(f)\n353: \tif err != nil {\n354: \t\treturn \"\", false\n355: \t}\n356: \n357: \ttext := string(data)\n358: \tif truncated {\n359: \t\tif idx := strings.IndexByte(text, '\\n'); idx >= 0 {\n360: \t\t\ttext = text[idx+1:]\n361: \t\t}\n362: \t\ttext = \"… (log truncated — showing the most recent portion)\\n\\n\" + text\n363: \t}\n364: \treturn text, true\n365: }\n366: \n367: // handleJobJDI serves a job's mg-jdi run state and its captured logs: the\n368: // status sidecar (ReadJDIStatus), the run.log tail (ReadJDIRunLogTail), and\n369: // the job's own session.log tail. All three are file reads scoped to the\n370: // resolved root/job — never client-supplied paths.\n371: func (s *Server) handleJobJDI(w http.ResponseWriter, r *http.Request) {\n372: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n373: \tif !ok {\n374: \t\treturn\n375: \t}\n376: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n377: \tif !ok {\n378: \t\treturn\n379: \t}\n380: \n381: \tresp := jobJDIResponse{}\n382: \tif st, ok := job.ReadJDIStatus(root, j.Name); ok {\n383: \t\tresp.Status = &jdiStatusRow{\n384: \t\t\tState:   string(st.State),\n385: \t\t\tAgent:   st.Agent,\n386: \t\t\tUpdated: st.Updated.Format(time.RFC3339),\n387: \t\t}\n388: \t}\n389: \tif text, ok := job.ReadJDIRunLogTail(root, j.Name); ok {\n390: \t\tresp.RunLog = &text\n391: \t}\n392: \tif text, ok := readFileTail(filepath.Join(j.Dir, \"session.log\")); ok {\n393: \t\tresp.SessionLog = &text\n394: \t}\n395: \twriteJSON(w, http.StatusOK, resp)\n396: }\n397: \n398: // --- /projects/{project}/jobs/{job}/diff ------------------------------------\n399: \n400: // jobDiffResponse is the /projects/{project}/jobs/{job}/diff response shape.\n401: // Without ?full=1 it is the \"quick eyeball\" — the branch's commits\n402: // (git.LogOneline) and its changed files (git.DiffStat), the same two calls\n403: // `mg diff` makes. With ?full=1 it is the complete patch (git.Diff). The\n404: // three-dot range <base>...<branch> is resolved exactly as mg diff resolves\n405: // it.\n406: type jobDiffResponse struct {\n407: \tLog   *string `json:\"log,omitempty\"`\n408: \tStat  *string `json:\"stat,omitempty\"`\n409: \tPatch *string `json:\"patch,omitempty\"`\n410: }\n411: \n412: // errJobBranchNotFound / errJobBranchAmbiguous classify a failed job→branch\n413: // resolution so the handler can map them to 404 / 409 with the CLI's wording.\n414: var (\n415: \terrJobBranchNotFound  = errors.New(\"job branch not found\")\n416: \terrJobBranchAmbiguous = errors.New(\"job branch ambiguous\")\n417: )\n418: \n419: // resolveJobBranch mirrors cmd/mg/diff.go's resolveJobBranch — the same\n420: // exact-then-prefix matching on the branch's id_slug tail segment, with the\n421: // same error wording. Not-found and ambiguity are classified (errors.Is) so\n422: // the API can map them onto 404 / 409.\n423: func resolveJobBranch(branches []string, jobArg string) (string, error) {\n424: \tif branch := git.ExactBranchMatch(branches, jobArg); branch != \"\" {\n425: \t\treturn branch, nil\n426: \t}\n427: \tprefixMatches := git.PrefixBranchMatches(branches, jobArg)\n428: \tswitch len(prefixMatches) {\n429: \tcase 0:\n430: \t\tmsg := fmt.Sprintf(\"job '%s' not found among local branches.\\nActive job branches:\", jobArg)\n431: \t\tfor _, b := range branches {\n432: \t\t\tmsg += \"\\n  \" + b\n433: \t\t}\n434: \t\treturn \"\", fmt.Errorf(\"%w: %s\", errJobBranchNotFound, msg)\n435: \tcase 1:\n436: \t\treturn prefixMatches[0], nil\n437: \tdefault:\n438: \t\treturn \"\", fmt.Errorf(\"%w: job '%s' is ambiguous — matches branches: %s\", errJobBranchAmbiguous, jobArg, strings.Join(prefixMatches, \" \"))\n439: \t}\n440: }\n441: \n442: // handleJobDiff serves a job's branch diff against the project's base branch\n443: // — the `mg diff` quick eyeball (log + stat) or, with ?full=1, the complete\n444: // patch. The base branch resolves exactly as mg diff does (the project's\n445: // configured baseBranch, falling back to origin/HEAD → main); the job→branch\n446: // resolution is the CLI's exact-then-prefix chain. All git access goes\n447: // through internal/git — the package that owns every git shell-out. Read-only\n448: // git commands only.\n449: func (s *Server) handleJobDiff(w http.ResponseWriter, r *http.Request) {\n450: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n451: \tif !ok {\n452: \t\treturn\n453: \t}\n454: \tjobArg := r.PathValue(\"job\")\n455: \tif !validSegment(jobArg) {\n456: \t\twriteError(w, http.StatusNotFound, \"job not found\")\n457: \t\treturn\n458: \t}\n459: \n460: \tbranches, err := git.LocalBranches(root)\n461: \tif err != nil {\n462: \t\twriteError(w, http.StatusInternalServerError, \"cannot read branches\")\n463: \t\treturn\n464: \t}\n465: \tbranch, err := resolveJobBranch(branches, jobArg)\n466: \tif err != nil {\n467: \t\tswitch {\n468: \t\tcase errors.Is(err, errJobBranchAmbiguous):\n469: \t\t\twriteError(w, http.StatusConflict, strings.TrimPrefix(err.Error(), \"job branch ambiguous: \"))\n470: \t\tdefault:\n471: \t\t\twriteError(w, http.StatusNotFound, strings.TrimPrefix(err.Error(), \"job branch not found: \"))\n472: \t\t}\n473: \t\treturn\n474: \t}\n475: \n476: \tsettings, err := project.Load(root)\n477: \tif err != nil {\n478: \t\twriteError(w, http.StatusInternalServerError, \"cannot read project settings\")\n479: \t\treturn\n480: \t}\n481: \tbase := settings.BaseBranch\n482: \tif base == \"\" {\n483: \t\tbase = git.SymbolicRefHead(root)\n484: \t}\n485: \n486: \tif r.URL.Query().Get(\"full\") == \"1\" {\n487: \t\tpatch, err := git.Diff(root, base, branch)\n488: \t\tif err != nil {\n489: \t\t\twriteError(w, http.StatusInternalServerError, \"cannot compute diff\")\n490: \t\t\treturn\n491: \t\t}\n492: \t\twriteJSON(w, http.StatusOK, jobDiffResponse{Patch: &patch})\n493: \t\treturn\n494: \t}\n495: \n496: \tlogs, err := git.LogOneline(root, base, branch)\n497: \tif err != nil {\n498: \t\twriteError(w, http.StatusInternalServerError, \"cannot read log\")\n499: \t\treturn\n500: \t}\n501: \tstat, err := git.DiffStat(root, base, branch)\n502: \tif err != nil {\n503: \t\twriteError(w, http.StatusInternalServerError, \"cannot read diff stat\")\n504: \t\treturn\n505: \t}\n506: \twriteJSON(w, http.StatusOK, jobDiffResponse{Log: &logs, Stat: &stat})\n507: }\n508: \n509: // --- /projects/{project}/agents ---------------------------------------------\n510: \n511: // agentRow is one entry in the agents response: name and one-line description\n512: // only — never the agent files' contents beyond the description line.\n513: type agentRow struct {\n514: \tName        string `json:\"name\"`\n515: \tDescription string `json:\"description\"`\n516: }\n517: \n518: // agentsResponse is the /projects/{project}/agents response shape.\n519: type agentsResponse struct {\n520: \tAgents []agentRow `json:\"agents\"`\n521: }\n522: \n523: // handleProjectAgents lists the agents available to a project — the `mg\n524: // agents` list (agentlist.Discover), name + description only.\n525: func (s *Server) handleProjectAgents(w http.ResponseWriter, r *http.Request) {\n526: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n527: \tif !ok {\n528: \t\treturn\n529: \t}\n530: \tagents, err := agentlist.Discover(root)\n531: \tif err != nil {\n532: \t\twriteError(w, http.StatusInternalServerError, \"cannot list agents\")\n533: \t\treturn\n534: \t}\n535: \trows := make([]agentRow, 0, len(agents))\n536: \tfor _, a := range agents {\n537: \t\trows = append(rows, agentRow{Name: a.Name, Description: a.Description})\n538: \t}\n539: \twriteJSON(w, http.StatusOK, agentsResponse{Agents: rows})\n540: }\n\n(End of file - total 540 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/agentlist\"\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n\t\"github.com/lmuskalla/manigot/internal/session\"\n)","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/api.go","text":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/agentlist\"\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n\t\"github.com/lmuskalla/manigot/internal/session\"\n)\n\n// --- JSON helpers ------------------------------------------------------------\n\n// writeJSON writes v as a JSON response with the given status.\nfunc writeJSON(w http.ResponseWriter, status int, v any) {\n\tw.Header().Set(\"Content-Type\", \"application/json\")\n\tw.WriteHeader(status)\n\t_ = json.NewEncoder(w).Encode(v)\n}\n\n// apiError is the JSON error envelope every non-2xx response carries.\ntype apiError struct {\n\tError string `json:\"error\"`\n}\n\n// writeError writes a JSON error envelope with the given status.\nfunc writeError(w http.ResponseWriter, status int, msg string) {\n\twriteJSON(w, status, apiError{Error: msg})\n}\n\n// --- Resolution helpers — the zero-path-inputs choke point -------------------\n//\n// Every handler resolves its URL segments ONLY through these helpers. A\n// segment is validated as a plain identifier (validSegment), then matched —\n// never joined into a filesystem path. The registered roots (TASK-1), the\n// discovered jobs, and the file whitelist are the only sources of paths the\n// handlers ever open.\n\n// validSegment reports whether a URL segment is a plain, trustworthy\n// identifier: non-empty, not \".\" or \"..\" (traversal), containing no path\n// separator (forward or backslash — the backslash is a Windows separator and\n// must never reach a filesystem path), and no NUL byte. Percent-encoded and\n// double-encoded variants all decode to one of these forms before matching,\n// so rejecting the decoded form rejects them all.\nfunc validSegment(seg string) bool {\n\tif seg == \"\" || seg == \".\" || seg == \"..\" {\n\t\treturn false\n\t}\n\tif strings.ContainsAny(seg, \"/\\\\\") {\n\t\treturn false\n\t}\n\treturn !strings.ContainsRune(seg, 0)\n}\n\n// resolveProject maps a URL project segment to a registered root. The segment\n// is validated, then matched against the registry by configured entry name\n// only (Registry.Project) — it is never joined into a filesystem path. An\n// invalid segment or no match is a 404; the handler returns false and must\n// return immediately.\nfunc (s *Server) resolveProject(w http.ResponseWriter, segment string) (string, bool) {\n\tif !validSegment(segment) {\n\t\twriteError(w, http.StatusNotFound, \"project not found\")\n\t\treturn \"\", false\n\t}\n\troot, ok := s.reg.Project(segment)\n\tif !ok {\n\t\twriteError(w, http.StatusNotFound, \"project not found\")\n\t\treturn \"\", false\n\t}\n\treturn root, true\n}\n\n// resolveJob maps a URL job segment to a discovered job under root. The\n// segment is validated, then matched against the project's discovered jobs by\n// ID, then by id_slug name (the job directory name — the same identity the\n// CLI's branch-tail matching uses), then by unique name prefix. It is never\n// treated as a path. Not-found is a 404; an ambiguous prefix is a 409; the\n// handler returns false and must return immediately.\nfunc (s *Server) resolveJob(w http.ResponseWriter, root, segment string) (job.Job, bool) {\n\tif !validSegment(segment) {\n\t\twriteError(w, http.StatusNotFound, \"job not found\")\n\t\treturn job.Job{}, false\n\t}\n\tjobs, err := job.Discover(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read jobs\")\n\t\treturn job.Job{}, false\n\t}\n\n\t// Exact by ID, then by name.\n\tfor _, j := range jobs {\n\t\tif j.ID == segment || j.Name == segment {\n\t\t\treturn j, true\n\t\t}\n\t}\n\n\t// Unique prefix on the name.\n\tvar matches []job.Job\n\tfor _, j := range jobs {\n\t\tif strings.HasPrefix(j.Name, segment) {\n\t\t\tmatches = append(matches, j)\n\t\t}\n\t}\n\tswitch len(matches) {\n\tcase 0:\n\t\twriteError(w, http.StatusNotFound, fmt.Sprintf(\"job '%s' not found among the project's jobs\", segment))\n\t\treturn job.Job{}, false\n\tcase 1:\n\t\treturn matches[0], true\n\tdefault:\n\t\tnames := make([]string, 0, len(matches))\n\t\tfor _, j := range matches {\n\t\t\tnames = append(names, j.Name)\n\t\t}\n\t\twriteError(w, http.StatusConflict, fmt.Sprintf(\"job '%s' is ambiguous — matches jobs: %s\", segment, strings.Join(names, \" \")))\n\t\treturn job.Job{}, false\n\t}\n}\n\n// jobFileNames is the whitelist of job files the API serves: a job's four\n// markdown files, read as raw markdown text. Nothing else under the job dir\n// is ever served.\nvar jobFileNames = map[string]bool{\n\t\"brief.md\":          true,\n\t\"tasks.md\":          true,\n\t\"implementation.md\": true,\n\t\"verdict.md\":        true,\n}\n\n// --- /health -----------------------------------------------------------------\n\n// healthProfileRow is one profile's credential readiness in the /health\n// response: ready = the profile's ResolveProfile + CheckAuth succeed (the\n// same check the session launcher runs). A missing key is \"not ready\", never\n// an error; the credential values themselves are never reported.\ntype healthProfileRow struct {\n\tID    string `json:\"id\"`\n\tReady bool   `json:\"ready\"`\n}\n\n// healthResponse is the /health response shape: the mg version, whether the\n// docker image is present (session.ImagePresent), and per-profile readiness.\ntype healthResponse struct {\n\tVersion      string             `json:\"version\"`\n\tImagePresent bool               `json:\"imagePresent\"`\n\tProfiles     []healthProfileRow `json:\"profiles\"`\n}\n\n// profileReady reduces a profile's credential check to a boolean.\nfunc profileReady(id string) bool {\n\tinfo, err := session.ResolveProfile(session.Options{Profile: id})\n\tif err != nil {\n\t\treturn false\n\t}\n\treturn info.CheckAuth() == nil\n}\n\n// handleHealth serves the daemon's health/status: version, docker image\n// presence, and profile readiness — pure booleans and identifiers, never\n// credential material.\nfunc (s *Server) handleHealth(w http.ResponseWriter, r *http.Request) {\n\tresp := healthResponse{\n\t\tVersion:      s.version,\n\t\tImagePresent: session.ImagePresent(),\n\t}\n\tfor _, p := range config.Profiles() {\n\t\tresp.Profiles = append(resp.Profiles, healthProfileRow{ID: p.ID, Ready: profileReady(p.ID)})\n\t}\n\twriteJSON(w, http.StatusOK, resp)\n}\n\n// --- /projects ---------------------------------------------------------------\n\n// projectRow is one entry in the /projects response: a registered root and\n// its configured name (the URL segment that resolves to it).\ntype projectRow struct {\n\tPath string `json:\"path\"`\n\tName string `json:\"name\"`\n}\n\n// projectsResponse is the /projects response shape.\ntype projectsResponse struct {\n\tProjects []projectRow `json:\"projects\"`\n}\n\n// handleProjects lists the registered project roots — pure registry data, the\n// daemon never scans for projects it does not know.\nfunc (s *Server) handleProjects(w http.ResponseWriter, r *http.Request) {\n\tentries := s.reg.Entries()\n\trows := make([]projectRow, 0, len(entries))\n\tfor _, e := range entries {\n\t\trows = append(rows, projectRow{Path: e.Path, Name: e.Name})\n\t}\n\twriteJSON(w, http.StatusOK, projectsResponse{Projects: rows})\n}\n\n// --- /projects/{project}/jobs ------------------------------------------------\n\n// jdiStatusRow is the mg-jdi activity state for a job: state / agent / last\n// update, from the job's status sidecar. Omitted when there is no live run\n// state (a job mg-jdi never drove, or a stale/unreadable sidecar).\ntype jdiStatusRow struct {\n\tState   string `json:\"state\"`\n\tAgent   string `json:\"agent\"`\n\tUpdated string `json:\"updated\"` // RFC3339\n}\n\n// jobRow is one row in the jobs response — the TUI's info design: id / status\n// / stage / type / date / title, one row per job, in job.Discover's sort\n// order (newest first).\ntype jobRow struct {\n\tID     string        `json:\"id\"`\n\tName   string        `json:\"name\"`\n\tStatus string        `json:\"status\"`\n\tStage  string        `json:\"stage\"`\n\tType   string        `json:\"type\"`\n\tDate   string        `json:\"date\"`\n\tTitle  string        `json:\"title\"`\n\tBranch string        `json:\"branch,omitempty\"`\n\tJDI    *jdiStatusRow `json:\"jdi,omitempty\"`\n}\n\n// jobsResponse is the /projects/{project}/jobs response shape.\ntype jobsResponse struct {\n\tJobs []jobRow `json:\"jobs\"`\n}\n\n// handleProjectJobs lists a project's open jobs with the mg-jdi activity\n// state per job.\nfunc (s *Server) handleProjectJobs(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tjobs, err := job.Discover(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read jobs\")\n\t\treturn\n\t}\n\trows := make([]jobRow, 0, len(jobs))\n\tfor _, j := range jobs {\n\t\trow := jobRow{\n\t\t\tID:     j.ID,\n\t\t\tName:   j.Name,\n\t\t\tStatus: j.Status,\n\t\t\tStage:  string(j.Stage()),\n\t\t\tType:   j.Type,\n\t\t\tDate:   j.Date,\n\t\t\tTitle:  j.Title,\n\t\t\tBranch: j.Branch,\n\t\t}\n\t\tif st, ok := job.ReadJDIStatus(root, j.Name); ok {\n\t\t\trow.JDI = &jdiStatusRow{\n\t\t\t\tState:   string(st.State),\n\t\t\t\tAgent:   st.Agent,\n\t\t\t\tUpdated: st.Updated.Format(time.RFC3339),\n\t\t\t}\n\t\t}\n\t\trows = append(rows, row)\n\t}\n\twriteJSON(w, http.StatusOK, jobsResponse{Jobs: rows})\n}\n\n// --- /projects/{project}/jobs/{job}/files/{file} -----------------------------\n\n// handleJobFile serves one of a job's four markdown files as raw markdown\n// text. The file segment is whitelisted (jobFileNames); a missing file is a\n// normal 404 (e.g. verdict.md before review).\nfunc (s *Server) handleJobFile(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\tfile := r.PathValue(\"file\")\n\tif !jobFileNames[file] {\n\t\twriteError(w, http.StatusNotFound, \"file not found\")\n\t\treturn\n\t}\n\tdata, err := os.ReadFile(filepath.Join(j.Dir, file))\n\tif err != nil {\n\t\twriteError(w, http.StatusNotFound, \"file not found\")\n\t\treturn\n\t}\n\tw.Header().Set(\"Content-Type\", \"text/markdown; charset=utf-8\")\n\tw.WriteHeader(http.StatusOK)\n\t_, _ = w.Write(data)\n}\n\n// --- /projects/{project}/jobs/{job}/jdi -------------------------------------\n\n// jobJDIResponse is the /projects/{project}/jobs/{job}/jdi response shape:\n// the mg-jdi status (state/agent/updated — null when there is no live run\n// state), the run.log tail (null when mg-jdi never ran the job), and the\n// job's session.log tail (null when no run output was captured yet — a\n// normal \"no run yet\", not an error).\ntype jobJDIResponse struct {\n\tStatus     *jdiStatusRow `json:\"status\"`\n\tRunLog     *string       `json:\"runLog\"`\n\tSessionLog *string       `json:\"sessionLog\"`\n}\n\n// tailBytes bounds how much of a log file the jdi endpoint loads into memory\n// — a tail, not \"load everything\", the same bounded-viewport approach\n// job.ReadJDIRunLogTail already uses for run.log (256 KiB, generous enough\n// for many invocations' worth of text while a small, fixed cost).\nconst tailBytes = 256 * 1024\n\n// readFileTail returns the last tailBytes of the file at path — the\n// session.log counterpart of job.ReadJDIRunLogTail, applied to a job-dir file\n// (docs/jobs/<name>/session.log). A possibly-partial first line is dropped so\n// the tail starts at a clean boundary, with a truncation marker. ok is false\n// only when the file is missing; an existing-but-empty file is (\"\", true).\nfunc readFileTail(path string) (string, bool) {\n\tf, err := os.Open(path)\n\tif err != nil {\n\t\treturn \"\", false\n\t}\n\tdefer f.Close()\n\n\tinfo, err := f.Stat()\n\tif err != nil {\n\t\treturn \"\", false\n\t}\n\tsize := info.Size()\n\tif size == 0 {\n\t\treturn \"\", true\n\t}\n\n\tstart := int64(0)\n\ttruncated := false\n\tif size > tailBytes {\n\t\tstart = size - tailBytes\n\t\ttruncated = true\n\t}\n\tif _, err := f.Seek(start, io.SeekStart); err != nil {\n\t\treturn \"\", false\n\t}\n\tdata, err := io.ReadAll(f)\n\tif err != nil {\n\t\treturn \"\", false\n\t}\n\n\ttext := string(data)\n\tif truncated {\n\t\tif idx := strings.IndexByte(text, '\\n'); idx >= 0 {\n\t\t\ttext = text[idx+1:]\n\t\t}\n\t\ttext = \"… (log truncated — showing the most recent portion)\\n\\n\" + text\n\t}\n\treturn text, true\n}\n\n// handleJobJDI serves a job's mg-jdi run state and its captured logs: the\n// status sidecar (ReadJDIStatus), the run.log tail (ReadJDIRunLogTail), and\n// the job's own session.log tail. All three are file reads scoped to the\n// resolved root/job — never client-supplied paths.\nfunc (s *Server) handleJobJDI(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\tresp := jobJDIResponse{}\n\tif st, ok := job.ReadJDIStatus(root, j.Name); ok {\n\t\tresp.Status = &jdiStatusRow{\n\t\t\tState:   string(st.State),\n\t\t\tAgent:   st.Agent,\n\t\t\tUpdated: st.Updated.Format(time.RFC3339),\n\t\t}\n\t}\n\tif text, ok := job.ReadJDIRunLogTail(root, j.Name); ok {\n\t\tresp.RunLog = &text\n\t}\n\tif text, ok := readFileTail(filepath.Join(j.Dir, \"session.log\")); ok {\n\t\tresp.SessionLog = &text\n\t}\n\twriteJSON(w, http.StatusOK, resp)\n}\n\n// --- /projects/{project}/jobs/{job}/diff ------------------------------------\n\n// jobDiffResponse is the /projects/{project}/jobs/{job}/diff response shape.\n// Without ?full=1 it is the \"quick eyeball\" — the branch's commits\n// (git.LogOneline) and its changed files (git.DiffStat), the same two calls\n// `mg diff` makes. With ?full=1 it is the complete patch (git.Diff). The\n// three-dot range <base>...<branch> is resolved exactly as mg diff resolves\n// it.\ntype jobDiffResponse struct {\n\tLog   *string `json:\"log,omitempty\"`\n\tStat  *string `json:\"stat,omitempty\"`\n\tPatch *string `json:\"patch,omitempty\"`\n}\n\n// errJobBranchNotFound / errJobBranchAmbiguous classify a failed job→branch\n// resolution so the handler can map them to 404 / 409 with the CLI's wording.\nvar (\n\terrJobBranchNotFound  = errors.New(\"job branch not found\")\n\terrJobBranchAmbiguous = errors.New(\"job branch ambiguous\")\n)\n\n// resolveJobBranch mirrors cmd/mg/diff.go's resolveJobBranch — the same\n// exact-then-prefix matching on the branch's id_slug tail segment, with the\n// same error wording. Not-found and ambiguity are classified (errors.Is) so\n// the API can map them onto 404 / 409.\nfunc resolveJobBranch(branches []string, jobArg string) (string, error) {\n\tif branch := git.ExactBranchMatch(branches, jobArg); branch != \"\" {\n\t\treturn branch, nil\n\t}\n\tprefixMatches := git.PrefixBranchMatches(branches, jobArg)\n\tswitch len(prefixMatches) {\n\tcase 0:\n\t\tmsg := fmt.Sprintf(\"job '%s' not found among local branches.\\nActive job branches:\", jobArg)\n\t\tfor _, b := range branches {\n\t\t\tmsg += \"\\n  \" + b\n\t\t}\n\t\treturn \"\", fmt.Errorf(\"%w: %s\", errJobBranchNotFound, msg)\n\tcase 1:\n\t\treturn prefixMatches[0], nil\n\tdefault:\n\t\treturn \"\", fmt.Errorf(\"%w: job '%s' is ambiguous — matches branches: %s\", errJobBranchAmbiguous, jobArg, strings.Join(prefixMatches, \" \"))\n\t}\n}\n\n// handleJobDiff serves a job's branch diff against the project's base branch\n// — the `mg diff` quick eyeball (log + stat) or, with ?full=1, the complete\n// patch. The base branch resolves exactly as mg diff does (the project's\n// configured baseBranch, falling back to origin/HEAD → main); the job→branch\n// resolution is the CLI's exact-then-prefix chain. All git access goes\n// through internal/git — the package that owns every git shell-out. Read-only\n// git commands only.\nfunc (s *Server) handleJobDiff(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tjobArg := r.PathValue(\"job\")\n\tif !validSegment(jobArg) {\n\t\twriteError(w, http.StatusNotFound, \"job not found\")\n\t\treturn\n\t}\n\n\tbranches, err := git.LocalBranches(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read branches\")\n\t\treturn\n\t}\n\tbranch, err := resolveJobBranch(branches, jobArg)\n\tif err != nil {\n\t\tswitch {\n\t\tcase errors.Is(err, errJobBranchAmbiguous):\n\t\t\twriteError(w, http.StatusConflict, strings.TrimPrefix(err.Error(), \"job branch ambiguous: \"))\n\t\tdefault:\n\t\t\twriteError(w, http.StatusNotFound, strings.TrimPrefix(err.Error(), \"job branch not found: \"))\n\t\t}\n\t\treturn\n\t}\n\n\tsettings, err := project.Load(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read project settings\")\n\t\treturn\n\t}\n\tbase := settings.BaseBranch\n\tif base == \"\" {\n\t\tbase = git.SymbolicRefHead(root)\n\t}\n\n\tif r.URL.Query().Get(\"full\") == \"1\" {\n\t\tpatch, err := git.Diff(root, base, branch)\n\t\tif err != nil {\n\t\t\twriteError(w, http.StatusInternalServerError, \"cannot compute diff\")\n\t\t\treturn\n\t\t}\n\t\twriteJSON(w, http.StatusOK, jobDiffResponse{Patch: &patch})\n\t\treturn\n\t}\n\n\tlogs, err := git.LogOneline(root, base, branch)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read log\")\n\t\treturn\n\t}\n\tstat, err := git.DiffStat(root, base, branch)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read diff stat\")\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, jobDiffResponse{Log: &logs, Stat: &stat})\n}\n\n// --- /projects/{project}/agents ---------------------------------------------\n\n// agentRow is one entry in the agents response: name and one-line description\n// only — never the agent files' contents beyond the description line.\ntype agentRow struct {\n\tName        string `json:\"name\"`\n\tDescription string `json:\"description\"`\n}\n\n// agentsResponse is the /projects/{project}/agents response shape.\ntype agentsResponse struct {\n\tAgents []agentRow `json:\"agents\"`\n}\n\n// handleProjectAgents lists the agents available to a project — the `mg\n// agents` list (agentlist.Discover), name + description only.\nfunc (s *Server) handleProjectAgents(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tagents, err := agentlist.Discover(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot list agents\")\n\t\treturn\n\t}\n\trows := make([]agentRow, 0, len(agents))\n\tfor _, a := range agents {\n\t\trows = append(rows, agentRow{Name: a.Name, Description: a.Description})\n\t}\n\twriteJSON(w, http.StatusOK, agentsResponse{Agents: rows})\n}","lineStart":1,"lineEnd":540,"totalLines":540,"truncated":false}},"title":"src/internal/serve/api.go","time":{"start":1787996374233,"end":1787996374239}},"id":"prt_04ce3839e001ePMH0SPLFoeBwK","sessionID":"ses_fb3250779ffe153rxsL511kCsf","messageID":"msg_04ce37ed1001PY4dcGgXa45lE3"}}
