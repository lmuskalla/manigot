og/stream`, // GET SSE\n}\n\n/** Escape a URL segment conservatively (names are id_slug identifiers). */\nexport function seg(s: string): string {\n  return encodeURIComponent(s)\n}","lineStart":1,"lineEnd":40,"totalLines":40,"truncated":false}},"title":"web-ui/src/lib/api/endpoints.ts","time":{"start":1787993737610,"end":1787993737618}},"id":"prt_04cbb4986001rOia9I7Nj28Sq6","sessionID":"ses_fb3457eb3fferiW9S1l2qfOUfr","messageID":"msg_04cbaeb2b001tHlniz5E8q80mi"}}
