text.slice(0, 40))})`,\n+    )\n+  }\n }\n \n function post<T>(path: string, body?: unknown): Promise<T> {\n   return json<T>('POST', path, {\n","additions":17,"deletions":1},"truncated":false},"title":"web-ui/src/lib/api/client.ts","time":{"start":1787993464971,"end":1787993464974}},"id":"prt_04cb72081001adPkpJgRB63mOk","sessionID":"ses_fb3594f94ffeQ3bCtRbhDqaOUL","messageID":"msg_04cb6cad40012vRH6Ud5PgoA40"}}
