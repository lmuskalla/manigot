boot, a settings change, or the\n39:   // daemon coming back — (re)loads the project list, so the dropdown\n40:   // populates without a page reload.\n41:   $effect(() => {\n42:     if (connection.status === 'up' && data.projects.length === 0) {\n43:       void data.loadProjects()\n44:     }\n45:   })\n46: \n47:   // Home with a known project redirects once projects land.\n48:   $effect(() => {\n49:     if (route.name === 'home' && data.active) navigate(href({ name: 'jobs', project: data.active }))\n50:   })\n51: \n52:   function onKeydown(e: KeyboardEvent) {\n53:     if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {\n54:       e.preventDefault()\n55:       showPalette = !showPalette\n56:     }\n57:   }\n58: \n59:   const connLabel = $derived(\n60:     connection.status === 'up' ? 'connected' : connection.status === 'down' ? 'offline' : 'connecting…',\n61:   )\n62: \n63:   function switchProject(e: Event) {\n64:     const name = (e.currentTarget as HTMLSelectElement).value\n65:     data.setActive(name)\n66:     navigate(href({ name: 'jobs', project: name }))\n67:   }\n68: </script>\n69: \n70: <svelte:window onkeydown={onKeydown} />\n71: \n72: <div class=\"shell\">\n73:   <aside class=\"rail\">\n74:     <a class=\"brand\" href=\"#/\" aria-label=\"manigot home\">\n75:       <Logo size={24} />\n76:       <span class=\"word\">manigot</span>\n77:       <span class=\"role\">control plane</span>\n78:     </a>\n79: \n80:     <div class=\"project\">\n81:       <label class=\"eyebrow\" for=\"project-select\">project</label>\n82:       <select id=\"project-select\" class=\"select\" value={data.active} onchange={switchProject} disabled={data.projects.length === 0}>\n83:         {#each data.projects as p (p.name)}\n84:           <option value={p.name}>{p.name}</option>\n85:         {/each}\n86:       </select>\n87:       {#if data.projectsError}\n88:         <p class=\"no-projects err\">Couldn't load projects — {data.projectsError}</p>\n89:       {:else if data.projects.length === 0 && connection.status === 'up'}\n90:         <p class=\"no-projects\">No projects registered.<br />Edit <code>config/serve.json</code> on the daemon.</p>\n91:       {/if}\n92:     </div>\n93: \n94:     <nav aria-label=\"Primary\">\n95:       <a\n96:         href={href({ name: 'jobs', project: route.project ?? data.active })}\n97:         class:active={route.name === 'jobs' || route.name === 'job'}\n98:       >\n99:         <svg viewBox=\"0 0 16 16\" width=\"15\" height=\"15\" aria-hidden=\"true\"><rect x=\"1.5\" y=\"1.5\" width=\"13\" height=\"13\" rx=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M4.5 5.5h7M4.5 8h7M4.5 10.5h4\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>\n100:         Jobs\n101:       </a>\n102:       <a\n103:         href={href({ name: 'agents', project: route.project ?? data.active })}\n104:         class:active={route.name === 'agents'}\n105:       >\n106:         <svg viewBox=\"0 0 16 16\" width=\"15\" height=\"15\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"5\" r=\"2.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M2.8 13.4c.7-2.5 2.8-3.8 5.2-3.8s4.5 1.3 5.2 3.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>\n107:         Crew\n108:       </a>\n109:       <a href=\"#/health\" class:active={route.name === 'health'}>\n110:         <svg viewBox=\"0 0 16 16\" width=\"15\" height=\"15\" aria-hidden=\"true\"><path d=\"M8 1.8l5.4 2.2v4c0 3.3-2.2 5.6-5.4 6.4-3.2-.8-5.4-3.1-5.4-6.4v-4z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M5.6 7.9l1.8 1.8 3.2-3.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n111:         Daemon\n112:       </a>\n113:     </nav>\n114: \n115:     <div class=\"rail-foot\">\n116:       <button class=\"conn\" class:down={connection.status === 'down'} onclick={() => (showSettings = true)}>\n117:         <span class=\"conn-dot\" class:up={connection.status === 'up'} class:down={connection.status === 'down'}></span>\n118:         {connLabel}\n119:       </button>\n120:       <button class=\"palette-hint\" onclick={() => (showPalette = true)}>\n121:         <span class=\"kbd\">⌘K</span> commands\n122:       </button>\n123:     </div>\n124:   </aside>\n125: \n126:   <main class=\"main\">\n127:     {#if connection.status === 'down' && route.name !== 'health'}\n128:       <div class=\"offline-banner\" role=\"alert\">\n129:         <span>The daemon is unreachable — {connection.lastError}</span>\n130:         <button class=\"btn btn-sm\" onclick={() => (showSettings = true)}>Connection…</button>\n131:       </div>\n132:     {/if}\n133: \n134:     {#if route.name === 'job' && route.project && route.job}\n135:       <JobDetailView project={route.project} jobName={route.job} tab={route.tab ?? 'brief'} />\n136:     {:else if route.name === 'agents' && route.project}\n137:       <AgentsView project={route.project} />\n138:     {:else if route.name === 'health'}\n139:       <HealthView />\n140:     {:else if route.name === 'jobs' && route.project}\n141:       <JobsView project={route.project} />\n142:     {:else}\n143:       <div class=\"landing\">\n144:         <Logo size={40} />\n145:         {#if connection.status === 'down'}\n146:           <p>The daemon is unreachable.</p>\n147:           <button class=\"btn\" onclick={() => (showSettings = true)}>Connection…</button>\n148:         {:else if data.projectsError}\n149:           <p>Couldn't load projects.</p>\n150:           <p class=\"landing-detail\">{data.projectsError}</p>\n151:         {:else if connection.status === 'up' && data.projects.length === 0}\n152:           <p>No projects registered.</p>\n153:           <p class=\"landing-detail\">\n154:             Edit <code>config/serve.json</code> on the daemon and restart <code>mg serve</code>.\n155:           </p>\n156:         {:else}\n157:           <p>Connecting to the daemon…</p>\n158:         {/if}\n159:       </div>\n160:     {/if}\n161:   </main>\n162: \n163:   <nav class=\"tabbar\" aria-label=\"Primary mobile\">\n164:     <a href={href({ name: 'jobs', project: route.project ?? data.active })} class:active={route.name === 'jobs' || route.name === 'job'}>Jobs</a>\n165:     <a href={href({ name: 'agents', project: route.project ?? data.active })} class:active={route.name === 'agents'}>Crew</a>\n166:     <a href=\"#/health\" class:active={route.name === 'health'}>Daemon</a>\n167:   </nav>\n168: </div>\n169: \n170: <Toasts />\n171: {#if showSettings}\n172:   <SettingsModal onclose={() => (showSettings = false)} />\n173: {/if}\n174: {#if showPalette}\n175:   <Palette\n176:     onclose={() => (showPalette = false)}\n177:     onnavigate={(h) => {\n178:       showPalette = false\n179:       navigate(h)\n180:     }}\n181:   />\n182: {/if}\n183: \n184: <style>\n185:   .shell {\n186:     display: grid;\n187:     grid-template-columns: var(--rail-w) 1fr;\n188:     height: 100dvh;\n189:     min-height: 0;\n190:   }\n191: \n192:   /* ── rail ─────────────────────────────────────────────────────────────── */\n193:   .rail {\n194:     display: flex;\n195:     flex-direction: column;\n196:     gap: var(--r-5);\n197:     padding: var(--r-5) var(--r-4);\n198:     border-right: 1px solid var(--line);\n199:     background: linear-gradient(180deg, rgba(139, 108, 246, 0.045), transparent 240px), var(--bg-1);\n200:     overflow-y: auto;\n201:   }\n202: \n203:   .brand {\n204:     display: flex;\n205:     align-items: center;\n206:     gap: 9px;\n207:     color: var(--ink-0);\n208:     text-decoration: none;\n209:   }\n210:   .brand:hover {\n211:     text-decoration: none;\n212:   }\n213:   .word {\n214:     font-weight: 680;\n215:     font-size: 16.5px;\n216:     letter-spacing: -0.02em;\n217:   }\n218:   .role {\n219:     font-family: var(--font-mono);\n220:     font-size: 9.5px;\n221:     letter-spacing: 0.14em;\n222:     tex