{"type":"tool_use","timestamp":1787994907317,"sessionID":"ses_fb3369276ffeikF3KayngIgfbM","part":{"type":"tool","tool":"read","callID":"call_f1daeeaedf1646bba8123846","state":{"status":"completed","input":{"filePath":"/workspace/web-ui/src/lib/api/mock.ts"},"output":"<path>/workspace/web-ui/src/lib/api/mock.ts</path>\n<type>file</type>\n<content>\n1: // Mock daemon — an in-memory stand-in for `mg serve` that implements the\n2: // whole surface: Part 1 reads exactly, Part 2 mutations for real (create /\n3: // save brief / launch / jdi / done / delete mutate the fixture state), plus\n4: // a live session.log ticker so the streaming console can be verified\n5: // without a daemon at all.\n6: //\n7: // Enabled by `--mode mock` (npm run dev:mock) or `?mock=1`. Inert otherwise.\n8: // Tests import `mockDaemon` directly and drive its fixture state.\n9: \n10: import type {\n11:   AgentRow,\n12:   Health,\n13:   JobRow,\n14:   OrphanRow,\n15:   ProjectRow,\n16: } from './types'\n17: \n18: declare const __MG_MOCK__: boolean\n19: \n20: const now = () => new Date().toISOString()\n21: const minsAgo = (m: number) => new Date(Date.now() - m * 60_000).toISOString()\n22: \n23: export interface MockState {\n24:   health: Health\n25:   projects: ProjectRow[]\n26:   jobs: Record<string, JobRow[]> // project name → jobs\n27:   files: Record<string, string> // `${project}/${job}/${file}` → content\n28:   logs: Record<string, { runLog: string; sessionLog: string }> // project/job\n29:   orphans: Record<string, OrphanRow[]>\n30: }\n31: \n32: const briefScaffold = (title: string, type: string, id: string) => `# Brief: ${title}\n33: \n34: status: open\n35: type: ${type}\n36: id: ${id}\n37: branch: feature/${id}_slug\n38: date: 2026-08-28\n39: author: Leander Muskalla\n40: \n41: ## What\n42: \n43: Add orphaned-worktree cleanup and container pruning to the mutating API, so a\n44: headless daemon with nobody running the CLI by hand does not accumulate\n45: exactly this cruft.\n46: \n47: ## Why\n48: \n49: The read-only daemon can only show what happened; nobody can act on it without\n50: going back to the terminal. That defeats the point of a remote control plane —\n51: the whole \"review from a phone, get a ping when a job needs you, act on it\"\n52: story requires write access and live output.\n53: \n54: ## Out of scope\n55: \n56: - Interactive agent sessions in any form\n57: - Host-machine config commands\n58: - Anything not listed under \"What\" above.\n59: `\n60: \n61: const tasksMd = `# Tasks: listener mutating API + run supervision\n62: \n63: TASK-1: Create-job endpoint — internal/job.CreateJob behind POST /projects/{p}/jobs, serialized per project via serve.ProjectLocks.\n64: TASK-2: Brief edit endpoint — raw content replace, no $EDITOR; HTTP body write pinned to text/markdown.\n65: TASK-3: Detached agent launch — one-shot via the --print path, never an attached session.\n66: TASK-4: mg jdi launch — detached, profile selectable, status sidecar as before.\n67: TASK-5: done / delete / push endpoints — FinishJob / DeleteJob / git push with the CLI's confirmation semantics surfaced as structured errors.\n68: TASK-6: Orphan cleanup — container prune + worktree orphan removal endpoints.\n69: TASK-7: Live session.log streaming over SSE; confirm it survives the graceful-shutdown drain.\n70: `\n71: \n72: const implMd = `# Implementation: listener mutating API + run supervision\n73: \n74: ## Summary\n75: \n76: Mutating endpoints and live run supervision landed on the listener: create\n77: job, edit brief, detached agent + jdi launches, done/delete/push, orphan\n78: cleanup, and SSE streaming of session.log growth.\n79: \n80: ## Changes\n81: \n82: TASK-1: POST /projects/{p}/jobs wired to CreateJob; per-project lock taken\n83: around scaffold + worktree creation.\n84: TASK-7: GET /projects/{p}/jobs/{j}/session-log/stream — SSE with tail\n85: semantics; client disconnect on shutdown drain verified.\n86: `\n87: \n88: const verdictApproved = `# Verdict: listener mutating API + run supervision\n89: \n90: ## Overall\n91: \n92: APPROVED — clean endpoint discipline, zero path inputs everywhere, locks held\n93: for exactly the git-mutating operations and not a line more.\n94: \n95: ## Findings\n96: \n97: - The SSE tail survives the shutdown drain (client disconnect, no hang).\n98: - Conflict on done is reported as a structured error; the job is left\n99:   untouched, exactly as pinned.\n100: `\n101: \n102: const verdictRejected = `# Verdict: listener mutating API + run supervision\n103: \n104: ## Overall\n105: \n106: NEEDS WORK — the launch endpoint does not validate the profile before\n107: detaching, so a typo silently burns the claude-pro default.\n108: \n109: ## Findings\n110: \n111: - TASK-3: validate the profile id against config.Profiles() before launch.\n112: `\n113: \n114: export function fixtureState(): MockState {\n115:   return {\n116:     health: {\n117:       version: '0.14.2',\n118:       imagePresent: true,\n119:       profiles: [\n120:         { id: 'claude-pro', ready: true },\n121:         { id: 'zai', ready: true },\n122:         { id: 'opencode-go', ready: false },\n123:         { id: 'opencode-zen', ready: true },\n124:         { id: 'opencode-zen-free', ready: true },\n125:       ],\n126:     },\n127:     projects: [\n128:       { name: 'manigot', path: '/srv/code/manigot' },\n129:       { name: 'solyto-api', path: '/srv/code/solyto/api' },\n130:     ],\n131:     jobs: {\n132:       manigot: [\n133:         {\n134:           id: 'farmer',\n135:           name: 'farmer_part-2-of-web-ui-tui-path',\n136:           status: 'open',\n137:           stage: 'implement',\n138:           type: 'feature',\n139:           date: '2026-08-28',\n140:           title: 'listener mutating API + run supervision',\n141:           branch: 'feature/farmer_part-2-of-web-ui-tui-path',\n142:           jdi: { state: 'running', agent: 'developer', updated: minsAgo(2) },\n143:         },\n144:         {\n145:           id: 'harbor',\n146:           name: 'harbor_needs-human-on-conflict-handling',\n147:           status: 'open',\n148:           stage: 'review',\n149:           type: 'feature',\n150:           date: '2026-08-27',\n151:           title: 'conflict handling over HTTP',\n152:           branch: 'feature/harbor_needs-human-on-conflict-handling',\n153:           jdi: { state: 'stopped:needs-human', agent: 'reviewer', updated: minsAgo(14) },\n154:         },\n155:         {\n156:           id: 'quartz',\n157:           name: 'quartz_prune-on-a-timer',\n158:           status: 'open',\n159:           stage: 'plan',\n160:           type: 'chore',\n161:           date: '2026-08-26',\n162:           title: 'prune orphaned containers on a timer',\n163:           branch: 'chore/quartz_prune-on-a-timer',\n164:           jdi: null,\n165:         },\n166:         {\n167:           id: 'ember',\n168:           name: 'ember_tui-bell-volume',\n169:           status: 'open',\n170:           stage: 'define',\n171:           type: 'fix',\n172:           date: '2026-08-26',\n173:           title: 'TUI bell rings at full volume',\n174:           branch: 'fix/ember_tui-bell-volume',\n175:           jdi: { state: 'stopped:finished', agent: 'reviewer', updated: minsAgo(200) },\n176:         },\n177:         {\n178:           id: 'lumen',\n179:           name: 'lumen_doctor-health-check',\n180:           status: 'open',\n181:           stage: 'finished',\n182:           type: 'feature',\n183:           date: '2026-08-24',\n184:           title: 'mg doctor health check',\n185:           branch: 'feature/lumen_doctor-health-check',\n186:           jdi: { state: 'stopped:finished', agent: 'reviewer', updated: minsAgo(1500) },\n187:         },\n188:       ],\n189:       'solyto-api': [\n190:         {\n191:           id: 'cedar',\n192:           name: 'cedar_rate-limit-headers',\n193:           status: 'open',\n194:           stage: 'implement',\n195:           type: 'fix',\n196:           date: '2026-08-27',\n197:           title: 'rate limit headers missing on 429',\n198:           branch: 'fix/cedar_rate-limit-headers',\n199:           jdi: { state: 'running', agent: 'analyst', updated: minsAgo(0) },\n200:         },\n201:       ],\n202:     },\n203:     files: {\n204:       'manigot/farmer_part-2-of-web-ui-tui-path/brief.md':\n205:         briefScaffold('listener mutating API + run supervision', 'feature', 'farmer'),\n206:       'manigot/farmer_part-2-of-web-ui-tui-path/tasks.md': tasksMd,\n207:       'manigot/farmer_part-2-of-web-ui-tui-path/implementation.md': implMd,\n208:       'manigot/harbor_needs-human-on-conflict-handling/brief.md':\n209:         briefScaffold('conflict handling over HTTP', 'feature', 'harbor') +\n210:         '\\n## Notes\\n\\nA squash-merge conflict is an interactive prompt today — there is no human\\nat a terminal to answer it over HTTP.\\n',\n211:       'manigot/harbor_needs-human-on-conflict-handling/tasks.md':\n212:         '# Tasks: conflict handling over HTTP\\n\\nTASK-1: Pin the done-conflict behavior — structured error, job untouched.\\n',\n213:       'manigot/harbor_needs-human-on-conflict-handling/implementation.md':\n214:         '# Implementation: conflict handling over HTTP\\n\\n## Summary\\nLanded the structured conflict error on done.\\n',\n215:       'manigot/harbor_needs-human-on-conflict-handling/verdict.md': verdictRejected,\n216:       'manigot/lumen_doctor-health-check/verdict.md': verdictApproved,\n217:       'manigot/quartz_prune-on-a-timer/brief.md':\n218:         briefScaffold('prune orphaned containers on a timer', 'chore', 'quartz'),\n219:     },\n220:     logs: {\n221:       'manigot/farmer_part-2-of-web-ui-tui-path': {\n222:         runLog: [\n223:           '=== 2026-08-28T16:02:11+02:00 mg jdi started: job farmer_part-2-of-web-ui-tui-path, profile claude-pro ===',\n224:           '',\n225:           '=== 2026-08-28T16:02:11+02:00 analyst invoked (attempt 1) ===',\n226:           'analyst finished — tasks.md written (3 tasks)',\n227:           '=== 2026-08-28T16:11:40+02:00 developer invoked (attempt 1) ===',\n228:           'developer finished — 5 commits, implementation.md written',\n229:           '=== 2026-08-28T18:04:02+02:00 reviewer invoked (attempt 1) ===',\n230:           'reviewer verdict: NEEDS WORK — profile validation missing',\n231:           '=== 2026-08-28T18:06:19+02:00 developer invoked (attempt 2) ===',\n232:         ].join('\\n'),\n233:         sessionLog: [\n234:           '18:06:19 developer session started (claude-pro, print mode)',\n235:           '18:06:21 reading tasks.md — 7 tasks listed',\n236:           '18:06:24 TASK-1 in progress: create-job endpoint',\n237:           '18:07:58 wrote internal/serve/create.go (h: 84)',\n238:           '18:08:03 tests green: TestCreateJobLocks',\n239:         ].join('\\n'),\n240:       },\n241:       'manigot/harbor_needs-human-on-conflict-handling': {\n242:         runLog: [\n243:           '=== 2026-08-27T09:14:00+02:00 mg jdi started: job harbor_needs-human-on-conflict-handling, profile zai ===',\n244:           'analyst finished — tasks.md written (4 tasks)',\n245:           'developer finished — 2 commits',\n246:           'reviewer verdict: NEEDS WORK',\n247:           '=== 2026-08-27T13:41:02+02:00 developer invoked (attempt 2) ===',\n248:           '=== 2026-08-27T14:02:55+02:00 stopped: needs human ===',\n249:         ].join('\\n'),\n250:         sessionLog: [\n251:           '14:02:51 NEEDS-HUMAN-INPUT: should done auto-hand-off to @git-solver when a merge conflicts over HTTP, or always require an explicit human call?',\n252:         ].join('\\n'),\n253:       },\n254:     },\n255:     orphans: {\n256:       manigot: [{ name: 'abandoned_probe-matrix', dir: '/srv/code/.manigot-worktrees/manigot/abandoned_probe-matrix' }],\n257:       'solyto-api': [],\n258:     },\n259:   }\n260: }\n261: \n262: export const mockDaemon = {\n263:   state: fixtureState(),\n264:   reset() {\n265:     this.state = fixtureState()\n266:   },\n267: }\n268: \n269: const agents: AgentRow[] = [\n270:   { name: 'analyst', description: 'Reads the brief and drafts tasks.md — one ordered task list, nothing more' },\n271:   { name: 'architect', description: 'Plans how to build it — framework, components, deployment' },\n272:   { name: 'chat', description: 'General conversational assistant' },\n273:   { name: 'designer', description: 'Directs UI/UX — typography, colour, spacing, hierarchy' },\n274:   { name: 'developer', description: 'Implements tasks one at a time, committing as it goes' },\n275:   { name: 'devops', description: 'Pipelines, builds, deployment, getting services running' },\n276:   { name: 'git-solver', description: 'Untangles broken worktrees, conflicted merges, detached HEADs' },\n277:   { name: 'mentor', description: 'Grounded tech mentor — imposter syndrome, skill growth' },\n278:   { name: 'owner', description: 'Reviews features from the product and user perspective' },\n279:   { name: 'prompter', description: 'Crafts high-quality prompts and system instructions' },\n280:   { name: 'quality', description: 'Reviews code quality — readability, DRY, modularity' },\n281:   { name: 'reviewer', description: 'Reviews changes against the task requirements — correctness only' },\n282:   { name: 'security', description: 'Reviews code for vulnerabilities and exposure risks' },\n283:   { name: 'sysadmin', description: 'Manages and administers servers' },\n284: ]\n285: \n286: const diffLog = [\n287:   '77f2ab1 (HEAD -> feature/farmer_part-2-of-web-ui-tui-path) TASK-7: SSE stream of session.log growth',\n288:   '5b31c9e TASK-5: done/delete/push endpoints',\n289:   'a9c4f82 TASK-3: detached agent launch via --print',\n290:   'e10d7aa TASK-1: create-job endpoint behind ProjectLocks',\n291:   '3fd88c0 TASK-2: brief edit — raw markdown body write',\n292: ].join('\\n')\n293: \n294: const diffStat = [\n295:   ' src/cmd/mg/serve.go                |  38 ++++++++--',\n296:   ' src/internal/serve/api.go          | 212 +++++++++++++++++++++++++++++++++++++++++++--',\n297:   ' src/internal/serve/create.go       |  84 +++++++++++++++++++++',\n298:   ' src/internal/serve/launch.go       | 156 ++++++++++++++++++++++++++++++++++++++',\n299:   ' src/internal/serve/server.go       |  18 +++-',\n300:   ' src/internal/serve/stream.go       | 197 +++++++++++++++++++++++++++++++++++++++++++++',\n301:   ' 6 files changed, 668 insertions(+), 15 deletions(-)',\n302: ].join('\\n')\n303: \n304: const diffPatch = [\n305:   'diff --git a/src/internal/serve/create.go b/src/internal/serve/create.go',\n306:   'new file mode 100644',\n307:   'index 0000000..8c1f2ab',\n308:   '--- /dev/null',\n309:   '+++ b/src/internal/serve/create.go',\n310:   '@@ -0,0 +1,84 @@',\n311:   '+package serve',\n312:   '+',\n313:   '+import (',\n314:   '+\\t\"net/http\"',\n315:   '+)',\n316:   '+',\n317:   '+// handleCreateJob scaffolds a job via internal/job.CreateJob under the',\n318:   '+// project lock — the first mutating endpoint.',\n319:   '+func (s *Server) handleCreateJob(w http.ResponseWriter, r *http.Request) {',\n320:   '+\\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))',\n321:   '+\\tif !ok {',\n322:   '+\\t\\treturn',\n323:   '+\\t}',\n324:   '+\\ts.locks.Lock(root)',\n325:   '+\\tdefer s.locks.Unlock(root)',\n326:   '+\\tname, err := job.CreateJob(root, title, jobType)',\n327:   '+\\tif err != nil {',\n328:   '+\\t\\twriteError(w, http.StatusInternalServerError, err.Error())',\n329:   '+\\t\\treturn',\n330:   '+\\t}',\n331:   '+\\twriteJSON(w, http.StatusCreated, map[string]string{\"job\": name})',\n332:   '+}',\n333:   '',\n334:   'diff --git a/src/internal/serve/server.go b/src/internal/serve/server.go',\n335:   'index 2f9d1c1..a01b3ee 100644',\n336:   '--- a/src/internal/serve/server.go',\n337:   '+++ b/src/internal/serve/server.go',\n338:   '@@ -47,6 +47,12 @@ func (s *Server) routes(mux *http.ServeMux) {',\n339:   ' \\tmux.HandleFunc(\"GET /projects/{project}/agents\", s.handleProjectAgents)',\n340:   '+\\tmux.HandleFunc(\"POST /projects/{project}/jobs\", s.handleCreateJob)',\n341:   '+\\tmux.HandleFunc(\"PUT /projects/{project}/jobs/{job}/files/brief\", s.handleSaveBrief)',\n342:   '+\\tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/jdi/start\", s.handleStartJdi)',\n343:   ' }',\n344: ].join('\\n')\n345: \n346: // ── fetch interception ──────────────────────────────────────────────────────\n347: \n348: type Route = {\n349:   method: string\n350:   pattern: RegExp\n351:   handle: (m: RegExpMatchArray, req: { body?: unknown; url: string }) => Response | Promise<Response>\n352: }\n353: \n354: const jsonRes = (v: unknown, status = 200) =>\n355:   new Response(JSON.stringify(v === undefined ? null : v), {\n356:     status,\n357:     headers: { 'Content-Type': 'application/json' },\n358:   })\n359: const errRes = (status: number, error: string) => jsonRes({ error }, status)\n360: const textRes = (t: string, type = 'text/markdown; charset=utf-8') =>\n361:   new Response(t, { status: 200, headers: { 'Content-Type': type } })\n362: \n363: let ticker: ReturnType<typeof setInterval> | null = null\n364: const tickerLines = [\n365:   '18:09:12 TASK-2 in progress: brief edit endpoint',\n366:   '18:10:47 wrote internal/serve/brief.go (h: 41)',\n367:   '18:10:52 tests green: TestSaveBriefReplaces',\n368:   '18:11:03 commit: [farmer] TASK-2: brief edit — raw markdown body write',\n369:   '18:11:20 TASK-3 in progress: detached agent launch',\n370: ]\n371: let tickerIdx = 0\n372: \n373: function ensureTicker() {\n374:   if (ticker) return\n375:   ticker = setInterval(() => {\n376:     const jobs = mockDaemon.state.jobs['manigot'] ?? []\n377:     const farmer = jobs.find((j) => j.id === 'farmer')\n378:     if (!farmer || farmer.jdi?.state !== 'running') return\n379:     const log = mockDaemon.state.logs['manigot/farmer_part-2-of-web-ui-tui-path']\n380:     if (!log) return\n381:     if (tickerIdx >= tickerLines.length) {\n382:       tickerIdx = 0\n383:       log.sessionLog += '\\n…'\n384:     }\n385:     log.sessionLog += '\\n' + tickerLines[tickerIdx++]\n386:     farmer.jdi.updated = now()\n387:   }, 4000)\n388: }\n389: \n390: function routes(): Route[] {\n391:   const S = mockDaemon.state\n392:   return [\n393:     {\n394:       method: 'GET',\n395:       pattern: /^\\/health$/,\n396:       handle: () => jsonRes(S.health),\n397:     },\n398:     {\n399:       method: 'GET',\n400:       pattern: /^\\/projects$/,\n401:       handle: () => jsonRes({ projects: S.projects }),\n402:     },\n403:     {\n404:       method: 'GET',\n405:       pattern: /^\\/projects\\/([^/]+)\\/jobs$/,\n406:       handle: (m) => {\n407:         const jobs = S.jobs[m[1]]\n408:         return jobs ? jsonRes({ jobs }) : errRes(404, 'project not found')\n409:       },\n410:     },\n411:     {\n412:       method: 'POST',\n413:       pattern: /^\\/projects\\/([^/]+)\\/jobs$/,\n414:       handle: (m, req) => {\n415:         const jobs = S.jobs[m[1]]\n416:         if (!jobs) return errRes(404, 'project not found')\n417:         const body = JSON.parse(typeof req.body === 'string' ? req.body : '{}') as {\n418:           title?: string\n419:           type?: string\n420:         }\n421:         const id = body.title?.toLowerCase().replace(/[^a-z]+/g, '').slice(0, 6) || 'newjob'\n422:         const name = `${id}_${(body.title ?? 'untitled').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40)}`\n423:         const job: JobRow = {\n424:           id,\n425:           name,\n426:           status: 'open',\n427:           stage: 'define',\n428:           type: body.type ?? 'feature',\n429:           date: new Date().toISOString().slice(0, 10),\n430:           title: body.title ?? 'untitled',\n431:           branch: `${body.type ?? 'feature'}/${name}`,\n432:           jdi: null,\n433:         }\n434:         jobs.unshift(job)\n435:         S.files[`${m[1]}/${name}/brief.md`] = briefScaffold(job.title, job.type, id)\n436:         return jsonRes({ job }, 201)\n437:       },\n438:     },\n439:     {\n440:       method: 'GET',\n441:       pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/files\\/(brief|tasks|implementation|verdict)\\.md$/,\n442:       handle: (m) => {\n443:         const content = S.files[`${m[1]}/${m[2]}/${m[3]}.md`]\n444:         return content !== undefined ? textRes(content) : errRes(404, 'file not found')\n445:       },\n446:     },\n447:     {\n448:       method: 'PUT',\n449:       pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/files\\/brief$/,\n450:       handle: async (m, req) => {\n451:         S.files[`${m[1]}/${m[2]}/brief.md`] = String(typeof req.body === 'string' ? req.body : '')\n452:         return jsonRes({ ok: true })\n453:       },\n454:     },\n455:     {\n456:       method: 'GET',\n457:       pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/jdi$/,\n458:       handle: (m) => {\n459:         const jobs = S.jobs[m[1]] ?? []\n460:         const job = jobs.find((j) => j.id === m[2] || j.name === m[2])\n461:         if (!job) return errRes(404, 'job not found')\n462:         const log = S.logs[`${m[1]}/${job.name}`]\n463:         return jsonRes({\n464:           status: job.jdi ?? null,\n465:           runLog: log?.runLog ?? null,\n466:           sessionLog: log?.sessionLog ?? null,\n467:         })\n468:       },\n469:     },\n470:     {\n471:       method: 'POST',\n472:       pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/jdi\\/start$/,\n473:       handle: (m) => {\n474:         const jobs = S.jobs[m[1]] ?? []\n475:         const job = jobs.find((j) => j.id === m[2] || j.name === m[2])\n476:         if (!job) return errRes(404, 'job not found')\n477:         job.jdi = { state: 'running', agent: 'analyst', updated: now() }\n478:         S.logs[`${m[1]}/${job.name}`] ??= { runLog: `=== ${now()} mg jdi started ===`, sessionLog: '' }\n479:         ensureTicker()\n480:         return jsonRes({ started: true, message: `mg jdi detached for ${job.name}` })\n481:       },\n482:     },\n483:     {\n484:       method: 'POST',\n485:       pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/agents\\/([^/]+)\\/launch$/,\n486:       handle: (m) => {\n487:         const jobs = S.jobs[m[1]] ?? []\n488:         const job = jobs.find((j) => j.id === m[2] || j.name === m[2])\n489:         if (!job) return errRes(404, 'job not found')\n490:         const log = S.logs[`${m[1]}/${job.name}`] ??= { runLog: '', sessionLog: '' }\n491:         log.runLog += `\\n=== ${now()} ${m[3]} invoked (detached, one-shot) ===`\n492:         job.jdi = { state: 'running', agent: m[3], updated: now() }\n493:         return jsonRes({ started: true, message: `${m[3]} launched detached on ${job.name}` })\n494:       },\n495:     },\n496:     {\n497:       method: 'GET',\n498:       pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/diff$/,\n499:       handle: (m, req) => {\n500:         const query = req.url.split('?')[1] ?? ''\n501:         if (new URLSearchParams(query).get('full') === '1') return jsonRes({ patch: diffPatch })\n502:         return jsonRes({ log: diffLog, stat: diffStat })\n503:       },\n504:     },\n505:     {\n506:       method: 'GET',\n507:       pattern: /^\\/projects\\/([^/]+)\\/agents$/,\n508:       handle: (m) => (S.jobs[m[1]] ? jsonRes({ agents }) : errRes(404, 'project not found')),\n509:     },\n510:     {\n511:       method: 'POST',\n512:       pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/done$/,\n513:       handle: (m) => {\n514:         const jobs = S.jobs[m[1]] ?? []\n515:         const idx = jobs.findIndex((j) => j.id === m[2] || j.name === m[2])\n516:         if (idx < 0) return errRes(404, 'job not found')\n517:         const [job] = jobs.splice(idx, 1)\n518:         return jsonRes({ message: `archived ${job.name} — squash-merged into main` })\n519:       },\n520:     },\n521:     {\n522:       method: 'POST',\n523:       pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/delete$/,\n524:       handle: (m) => {\n525:         const jobs = S.jobs[m[1]] ?? []\n526:         const idx = jobs.findIndex((j) => j.id === m[2] || j.name === m[2])\n527:         if (idx < 0) return errRes(404, 'job not found')\n528:         const [job] = jobs.splice(idx, 1)\n529:         return jsonRes({ message: `deleted ${job.name} — worktree and branch removed` })\n530:       },\n531:     },\n532:     {\n533:       method: 'POST',\n534:       pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/push$/,\n535:       handle: (m) => jsonRes({ message: `pushed ${m[2]} to origin` }),\n536:     },\n537:     {\n538:       method: 'GET',\n539:       pattern: /^\\/projects\\/([^/]+)\\/orphans$/,\n540:       handle: (m) => jsonRes({ orphans: S.orphans[m[1]] ?? [] }),\n541:     },\n542:     {\n543:       method: 'POST',\n544:       pattern: /^\\/projects\\/([^/]+)\\/orphans\\/remove$/,\n545:       handle: (m) => {\n546:         const count = S.orphans[m[1]]?.length ?? 0\n547:         S.orphans[m[1]] = []\n548:         return jsonRes({ message: `removed ${count} orphaned worktree${count === 1 ? '' : 's'}` })\n549:       },\n550:     },\n551:     {\n552:       method: 'POST',\n553:       pattern: /^\\/prune$/,\n554:       handle: () => jsonRes({ removed: 2, running: 1 }),\n555:     },\n556:     // SSE stream — sends the current tail, then keeps sending as the ticker\n557:     // grows it. Falls through to 404 semantics if the job has no log yet.\n558:     {\n559:       method: 'GET',\n560:       pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/session-log\\/stream$/,\n561:       handle: (m) => {\n562:         const jobs = S.jobs[m[1]] ?? []\n563:         const job = jobs.find((j) => j.id === m[2] || j.name === m[2])\n564:         const log = job && S.logs[`${m[1]}/${job.name}`]\n565:         if (!log) return errRes(404, 'no session log for this job')\n566:         const stream = new ReadableStream({\n567:           start(controller) {\n568:             const enc = new TextEncoder()\n569:             let lastLen = -1\n570:             const send = () => {\n571:               if (log.sessionLog.length !== lastLen) {\n572:                 lastLen = log.sessionLog.length\n573:                 controller.enqueue(enc.encode(`data: ${JSON.stringify(log.sessionLog).slice(1, -1)}\\n\\n`))\n574:               }\n575:             }\n576:             send()\n577:             const iv = setInterval(send, 1500)\n578:             // @ts-expect-error — signal cleanup when the client disconnects\n579:             this._iv = iv\n580:           },\n581:           cancel(reason) {\n582:             // @ts-expect-error — mirror of start's handle\n583:             clearInterval(this._iv)\n584:             void reason\n585:           },\n586:         })\n587:         return new Response(stream, { headers: { 'Content-Type': 'text/event-stream' } })\n588:       },\n589:     },\n590:   ]\n591: }\n592: \n593: let installed = false\n594: \n595: export function installMock() {\n596:   if (installed) return\n597:   installed = true\n598:   const realFetch = globalThis.fetch\n599:   mockFetch.realFetch = realFetch\n600:   globalThis.fetch = mockFetch as typeof fetch\n601:   ensureTicker()\n602: }\n603: \n604: export const mockFetch = async (input: RequestInfo | URL, init?: RequestInit): Promise<Response> => {\n605:   const url = typeof input === 'string' ? input : input instanceof URL ? input.href : input.url\n606:   const method = (\n607:     init?.method ?? (typeof input !== 'string' && !(input instanceof URL) ? input.method : 'GET')\n608:   ).toUpperCase()\n609:   const path = url.replace(/^https?:\\/\\/[^/]+/, '')\n610:   for (const r of routes()) {\n611:     if (r.method !== method) continue\n612:     const m = path.split('?')[0].match(r.pattern)\n613:     if (m) return await r.handle(m, { body: init?.body, url })\n614:   }\n615:   return errRes(404, `mock daemon: no route for ${method} ${path}`)\n616: }\n617: mockFetch.realFetch = undefined as unknown as typeof fetch\n618: \n619: /** Wire the mock into the module loader when enabled (mock mode or ?mock=1). */\n620: export function maybeInstallMockFromEnv() {\n621:   const forced = typeof __MG_MOCK__ !== 'undefined' && __MG_MOCK__\n622:   const qs = typeof location !== 'undefined' && new URLSearchParams(location.search).has('mock')\n623:   if (forced || qs) installMock()\n624: }\n\n(End of file - total 624 lines)\n</content>","metadata":{"preview":"// Mock daemon — an in-memory stand-in for `mg serve` that implements the\n// whole surface: Part 1 reads exactly, Part 2 mutations for real (create /\n// save brief / launch / jdi / done / delete mutate the fixture state), plus\n// a live session.log ticker so the streaming console can be verified\n// without a daemon at all.\n//\n// Enabled by `--mode mock` (npm run dev:mock) or `?mock=1`. Inert otherwise.\n// Tests import `mockDaemon` directly and drive its fixture state.\n\nimport type {\n  AgentRow,\n  Health,\n  JobRow,\n  OrphanRow,\n  ProjectRow,\n} from './types'\n\ndeclare const __MG_MOCK__: boolean\n\nconst now = () => new Date().toISOString()","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/web-ui/src/lib/api/mock.ts","text":"// Mock daemon — an in-memory stand-in for `mg serve` that implements the\n// whole surface: Part 1 reads exactly, Part 2 mutations for real (create /\n// save brief / launch / jdi / done / delete mutate the fixture state), plus\n// a live session.log ticker so the streaming console can be verified\n// without a daemon at all.\n//\n// Enabled by `--mode mock` (npm run dev:mock) or `?mock=1`. Inert otherwise.\n// Tests import `mockDaemon` directly and drive its fixture state.\n\nimport type {\n  AgentRow,\n  Health,\n  JobRow,\n  OrphanRow,\n  ProjectRow,\n} from './types'\n\ndeclare const __MG_MOCK__: boolean\n\nconst now = () => new Date().toISOString()\nconst minsAgo = (m: number) => new Date(Date.now() - m * 60_000).toISOString()\n\nexport interface MockState {\n  health: Health\n  projects: ProjectRow[]\n  jobs: Record<string, JobRow[]> // project name → jobs\n  files: Record<string, string> // `${project}/${job}/${file}` → content\n  logs: Record<string, { runLog: string; sessionLog: string }> // project/job\n  orphans: Record<string, OrphanRow[]>\n}\n\nconst briefScaffold = (title: string, type: string, id: string) => `# Brief: ${title}\n\nstatus: open\ntype: ${type}\nid: ${id}\nbranch: feature/${id}_slug\ndate: 2026-08-28\nauthor: Leander Muskalla\n\n## What\n\nAdd orphaned-worktree cleanup and container pruning to the mutating API, so a\nheadless daemon with nobody running the CLI by hand does not accumulate\nexactly this cruft.\n\n## Why\n\nThe read-only daemon can only show what happened; nobody can act on it without\ngoing back to the terminal. That defeats the point of a remote control plane —\nthe whole \"review from a phone, get a ping when a job needs you, act on it\"\nstory requires write access and live output.\n\n## Out of scope\n\n- Interactive agent sessions in any form\n- Host-machine config commands\n- Anything not listed under \"What\" above.\n`\n\nconst tasksMd = `# Tasks: listener mutating API + run supervision\n\nTASK-1: Create-job endpoint — internal/job.CreateJob behind POST /projects/{p}/jobs, serialized per project via serve.ProjectLocks.\nTASK-2: Brief edit endpoint — raw content replace, no $EDITOR; HTTP body write pinned to text/markdown.\nTASK-3: Detached agent launch — one-shot via the --print path, never an attached session.\nTASK-4: mg jdi launch — detached, profile selectable, status sidecar as before.\nTASK-5: done / delete / push endpoints — FinishJob / DeleteJob / git push with the CLI's confirmation semantics surfaced as structured errors.\nTASK-6: Orphan cleanup — container prune + worktree orphan removal endpoints.\nTASK-7: Live session.log streaming over SSE; confirm it survives the graceful-shutdown drain.\n`\n\nconst implMd = `# Implementation: listener mutating API + run supervision\n\n## Summary\n\nMutating endpoints and live run supervision landed on the listener: create\njob, edit brief, detached agent + jdi launches, done/delete/push, orphan\ncleanup, and SSE streaming of session.log growth.\n\n## Changes\n\nTASK-1: POST /projects/{p}/jobs wired to CreateJob; per-project lock taken\naround scaffold + worktree creation.\nTASK-7: GET /projects/{p}/jobs/{j}/session-log/stream — SSE with tail\nsemantics; client disconnect on shutdown drain verified.\n`\n\nconst verdictApproved = `# Verdict: listener mutating API + run supervision\n\n## Overall\n\nAPPROVED — clean endpoint discipline, zero path inputs everywhere, locks held\nfor exactly the git-mutating operations and not a line more.\n\n## Findings\n\n- The SSE tail survives the shutdown drain (client disconnect, no hang).\n- Conflict on done is reported as a structured error; the job is left\n  untouched, exactly as pinned.\n`\n\nconst verdictRejected = `# Verdict: listener mutating API + run supervision\n\n## Overall\n\nNEEDS WORK — the launch endpoint does not validate the profile before\ndetaching, so a typo silently burns the claude-pro default.\n\n## Findings\n\n- TASK-3: validate the profile id against config.Profiles() before launch.\n`\n\nexport function fixtureState(): MockState {\n  return {\n    health: {\n      version: '0.14.2',\n      imagePresent: true,\n      profiles: [\n        { id: 'claude-pro', ready: true },\n        { id: 'zai', ready: true },\n        { id: 'opencode-go', ready: false },\n        { id: 'opencode-zen', ready: true },\n        { id: 'opencode-zen-free', ready: true },\n      ],\n    },\n    projects: [\n      { name: 'manigot', path: '/srv/code/manigot' },\n      { name: 'solyto-api', path: '/srv/code/solyto/api' },\n    ],\n    jobs: {\n      manigot: [\n        {\n          id: 'farmer',\n          name: 'farmer_part-2-of-web-ui-tui-path',\n          status: 'open',\n          stage: 'implement',\n          type: 'feature',\n          date: '2026-08-28',\n          title: 'listener mutating API + run supervision',\n          branch: 'feature/farmer_part-2-of-web-ui-tui-path',\n          jdi: { state: 'running', agent: 'developer', updated: minsAgo(2) },\n        },\n        {\n          id: 'harbor',\n          name: 'harbor_needs-human-on-conflict-handling',\n          status: 'open',\n          stage: 'review',\n          type: 'feature',\n          date: '2026-08-27',\n          title: 'conflict handling over HTTP',\n          branch: 'feature/harbor_needs-human-on-conflict-handling',\n          jdi: { state: 'stopped:needs-human', agent: 'reviewer', updated: minsAgo(14) },\n        },\n        {\n          id: 'quartz',\n          name: 'quartz_prune-on-a-timer',\n          status: 'open',\n          stage: 'plan',\n          type: 'chore',\n          date: '2026-08-26',\n          title: 'prune orphaned containers on a timer',\n          branch: 'chore/quartz_prune-on-a-timer',\n          jdi: null,\n        },\n        {\n          id: 'ember',\n          name: 'ember_tui-bell-volume',\n          status: 'open',\n          stage: 'define',\n          type: 'fix',\n          date: '2026-08-26',\n          title: 'TUI bell rings at full volume',\n          branch: 'fix/ember_tui-bell-volume',\n          jdi: { state: 'stopped:finished', agent: 'reviewer', updated: minsAgo(200) },\n        },\n        {\n          id: 'lumen',\n          name: 'lumen_doctor-health-check',\n          status: 'open',\n          stage: 'finished',\n          type: 'feature',\n          date: '2026-08-24',\n          title: 'mg doctor health check',\n          branch: 'feature/lumen_doctor-health-check',\n          jdi: { state: 'stopped:finished', agent: 'reviewer', updated: minsAgo(1500) },\n        },\n      ],\n      'solyto-api': [\n        {\n          id: 'cedar',\n          name: 'cedar_rate-limit-headers',\n          status: 'open',\n          stage: 'implement',\n          type: 'fix',\n          date: '2026-08-27',\n          title: 'rate limit headers missing on 429',\n          branch: 'fix/cedar_rate-limit-headers',\n          jdi: { state: 'running', agent: 'analyst', updated: minsAgo(0) },\n        },\n      ],\n    },\n    files: {\n      'manigot/farmer_part-2-of-web-ui-tui-path/brief.md':\n        briefScaffold('listener mutating API + run supervision', 'feature', 'farmer'),\n      'manigot/farmer_part-2-of-web-ui-tui-path/tasks.md': tasksMd,\n      'manigot/farmer_part-2-of-web-ui-tui-path/implementation.md': implMd,\n      'manigot/harbor_needs-human-on-conflict-handling/brief.md':\n        briefScaffold('conflict handling over HTTP', 'feature', 'harbor') +\n        '\\n## Notes\\n\\nA squash-merge conflict is an interactive prompt today — there is no human\\nat a terminal to answer it over HTTP.\\n',\n      'manigot/harbor_needs-human-on-conflict-handling/tasks.md':\n        '# Tasks: conflict handling over HTTP\\n\\nTASK-1: Pin the done-conflict behavior — structured error, job untouched.\\n',\n      'manigot/harbor_needs-human-on-conflict-handling/implementation.md':\n        '# Implementation: conflict handling over HTTP\\n\\n## Summary\\nLanded the structured conflict error on done.\\n',\n      'manigot/harbor_needs-human-on-conflict-handling/verdict.md': verdictRejected,\n      'manigot/lumen_doctor-health-check/verdict.md': verdictApproved,\n      'manigot/quartz_prune-on-a-timer/brief.md':\n        briefScaffold('prune orphaned containers on a timer', 'chore', 'quartz'),\n    },\n    logs: {\n      'manigot/farmer_part-2-of-web-ui-tui-path': {\n        runLog: [\n          '=== 2026-08-28T16:02:11+02:00 mg jdi started: job farmer_part-2-of-web-ui-tui-path, profile claude-pro ===',\n          '',\n          '=== 2026-08-28T16:02:11+02:00 analyst invoked (attempt 1) ===',\n          'analyst finished — tasks.md written (3 tasks)',\n          '=== 2026-08-28T16:11:40+02:00 developer invoked (attempt 1) ===',\n          'developer finished — 5 commits, implementation.md written',\n          '=== 2026-08-28T18:04:02+02:00 reviewer invoked (attempt 1) ===',\n          'reviewer verdict: NEEDS WORK — profile validation missing',\n          '=== 2026-08-28T18:06:19+02:00 developer invoked (attempt 2) ===',\n        ].join('\\n'),\n        sessionLog: [\n          '18:06:19 developer session started (claude-pro, print mode)',\n          '18:06:21 reading tasks.md — 7 tasks listed',\n          '18:06:24 TASK-1 in progress: create-job endpoint',\n          '18:07:58 wrote internal/serve/create.go (h: 84)',\n          '18:08:03 tests green: TestCreateJobLocks',\n        ].join('\\n'),\n      },\n      'manigot/harbor_needs-human-on-conflict-handling': {\n        runLog: [\n          '=== 2026-08-27T09:14:00+02:00 mg jdi started: job harbor_needs-human-on-conflict-handling, profile zai ===',\n          'analyst finished — tasks.md written (4 tasks)',\n          'developer finished — 2 commits',\n          'reviewer verdict: NEEDS WORK',\n          '=== 2026-08-27T13:41:02+02:00 developer invoked (attempt 2) ===',\n          '=== 2026-08-27T14:02:55+02:00 stopped: needs human ===',\n        ].join('\\n'),\n        sessionLog: [\n          '14:02:51 NEEDS-HUMAN-INPUT: should done auto-hand-off to @git-solver when a merge conflicts over HTTP, or always require an explicit human call?',\n        ].join('\\n'),\n      },\n    },\n    orphans: {\n      manigot: [{ name: 'abandoned_probe-matrix', dir: '/srv/code/.manigot-worktrees/manigot/abandoned_probe-matrix' }],\n      'solyto-api': [],\n    },\n  }\n}\n\nexport const mockDaemon = {\n  state: fixtureState(),\n  reset() {\n    this.state = fixtureState()\n  },\n}\n\nconst agents: AgentRow[] = [\n  { name: 'analyst', description: 'Reads the brief and drafts tasks.md — one ordered task list, nothing more' },\n  { name: 'architect', description: 'Plans how to build it — framework, components, deployment' },\n  { name: 'chat', description: 'General conversational assistant' },\n  { name: 'designer', description: 'Directs UI/UX — typography, colour, spacing, hierarchy' },\n  { name: 'developer', description: 'Implements tasks one at a time, committing as it goes' },\n  { name: 'devops', description: 'Pipelines, builds, deployment, getting services running' },\n  { name: 'git-solver', description: 'Untangles broken worktrees, conflicted merges, detached HEADs' },\n  { name: 'mentor', description: 'Grounded tech mentor — imposter syndrome, skill growth' },\n  { name: 'owner', description: 'Reviews features from the product and user perspective' },\n  { name: 'prompter', description: 'Crafts high-quality prompts and system instructions' },\n  { name: 'quality', description: 'Reviews code quality — readability, DRY, modularity' },\n  { name: 'reviewer', description: 'Reviews changes against the task requirements — correctness only' },\n  { name: 'security', description: 'Reviews code for vulnerabilities and exposure risks' },\n  { name: 'sysadmin', description: 'Manages and administers servers' },\n]\n\nconst diffLog = [\n  '77f2ab1 (HEAD -> feature/farmer_part-2-of-web-ui-tui-path) TASK-7: SSE stream of session.log growth',\n  '5b31c9e TASK-5: done/delete/push endpoints',\n  'a9c4f82 TASK-3: detached agent launch via --print',\n  'e10d7aa TASK-1: create-job endpoint behind ProjectLocks',\n  '3fd88c0 TASK-2: brief edit — raw markdown body write',\n].join('\\n')\n\nconst diffStat = [\n  ' src/cmd/mg/serve.go                |  38 ++++++++--',\n  ' src/internal/serve/api.go          | 212 +++++++++++++++++++++++++++++++++++++++++++--',\n  ' src/internal/serve/create.go       |  84 +++++++++++++++++++++',\n  ' src/internal/serve/launch.go       | 156 ++++++++++++++++++++++++++++++++++++++',\n  ' src/internal/serve/server.go       |  18 +++-',\n  ' src/internal/serve/stream.go       | 197 +++++++++++++++++++++++++++++++++++++++++++++',\n  ' 6 files changed, 668 insertions(+), 15 deletions(-)',\n].join('\\n')\n\nconst diffPatch = [\n  'diff --git a/src/internal/serve/create.go b/src/internal/serve/create.go',\n  'new file mode 100644',\n  'index 0000000..8c1f2ab',\n  '--- /dev/null',\n  '+++ b/src/internal/serve/create.go',\n  '@@ -0,0 +1,84 @@',\n  '+package serve',\n  '+',\n  '+import (',\n  '+\\t\"net/http\"',\n  '+)',\n  '+',\n  '+// handleCreateJob scaffolds a job via internal/job.CreateJob under the',\n  '+// project lock — the first mutating endpoint.',\n  '+func (s *Server) handleCreateJob(w http.ResponseWriter, r *http.Request) {',\n  '+\\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))',\n  '+\\tif !ok {',\n  '+\\t\\treturn',\n  '+\\t}',\n  '+\\ts.locks.Lock(root)',\n  '+\\tdefer s.locks.Unlock(root)',\n  '+\\tname, err := job.CreateJob(root, title, jobType)',\n  '+\\tif err != nil {',\n  '+\\t\\twriteError(w, http.StatusInternalServerError, err.Error())',\n  '+\\t\\treturn',\n  '+\\t}',\n  '+\\twriteJSON(w, http.StatusCreated, map[string]string{\"job\": name})',\n  '+}',\n  '',\n  'diff --git a/src/internal/serve/server.go b/src/internal/serve/server.go',\n  'index 2f9d1c1..a01b3ee 100644',\n  '--- a/src/internal/serve/server.go',\n  '+++ b/src/internal/serve/server.go',\n  '@@ -47,6 +47,12 @@ func (s *Server) routes(mux *http.ServeMux) {',\n  ' \\tmux.HandleFunc(\"GET /projects/{project}/agents\", s.handleProjectAgents)',\n  '+\\tmux.HandleFunc(\"POST /projects/{project}/jobs\", s.handleCreateJob)',\n  '+\\tmux.HandleFunc(\"PUT /projects/{project}/jobs/{job}/files/brief\", s.handleSaveBrief)',\n  '+\\tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/jdi/start\", s.handleStartJdi)',\n  ' }',\n].join('\\n')\n\n// ── fetch interception ──────────────────────────────────────────────────────\n\ntype Route = {\n  method: string\n  pattern: RegExp\n  handle: (m: RegExpMatchArray, req: { body?: unknown; url: string }) => Response | Promise<Response>\n}\n\nconst jsonRes = (v: unknown, status = 200) =>\n  new Response(JSON.stringify(v === undefined ? null : v), {\n    status,\n    headers: { 'Content-Type': 'application/json' },\n  })\nconst errRes = (status: number, error: string) => jsonRes({ error }, status)\nconst textRes = (t: string, type = 'text/markdown; charset=utf-8') =>\n  new Response(t, { status: 200, headers: { 'Content-Type': type } })\n\nlet ticker: ReturnType<typeof setInterval> | null = null\nconst tickerLines = [\n  '18:09:12 TASK-2 in progress: brief edit endpoint',\n  '18:10:47 wrote internal/serve/brief.go (h: 41)',\n  '18:10:52 tests green: TestSaveBriefReplaces',\n  '18:11:03 commit: [farmer] TASK-2: brief edit — raw markdown body write',\n  '18:11:20 TASK-3 in progress: detached agent launch',\n]\nlet tickerIdx = 0\n\nfunction ensureTicker() {\n  if (ticker) return\n  ticker = setInterval(() => {\n    const jobs = mockDaemon.state.jobs['manigot'] ?? []\n    const farmer = jobs.find((j) => j.id === 'farmer')\n    if (!farmer || farmer.jdi?.state !== 'running') return\n    const log = mockDaemon.state.logs['manigot/farmer_part-2-of-web-ui-tui-path']\n    if (!log) return\n    if (tickerIdx >= tickerLines.length) {\n      tickerIdx = 0\n      log.sessionLog += '\\n…'\n    }\n    log.sessionLog += '\\n' + tickerLines[tickerIdx++]\n    farmer.jdi.updated = now()\n  }, 4000)\n}\n\nfunction routes(): Route[] {\n  const S = mockDaemon.state\n  return [\n    {\n      method: 'GET',\n      pattern: /^\\/health$/,\n      handle: () => jsonRes(S.health),\n    },\n    {\n      method: 'GET',\n      pattern: /^\\/projects$/,\n      handle: () => jsonRes({ projects: S.projects }),\n    },\n    {\n      method: 'GET',\n      pattern: /^\\/projects\\/([^/]+)\\/jobs$/,\n      handle: (m) => {\n        const jobs = S.jobs[m[1]]\n        return jobs ? jsonRes({ jobs }) : errRes(404, 'project not found')\n      },\n    },\n    {\n      method: 'POST',\n      pattern: /^\\/projects\\/([^/]+)\\/jobs$/,\n      handle: (m, req) => {\n        const jobs = S.jobs[m[1]]\n        if (!jobs) return errRes(404, 'project not found')\n        const body = JSON.parse(typeof req.body === 'string' ? req.body : '{}') as {\n          title?: string\n          type?: string\n        }\n        const id = body.title?.toLowerCase().replace(/[^a-z]+/g, '').slice(0, 6) || 'newjob'\n        const name = `${id}_${(body.title ?? 'untitled').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40)}`\n        const job: JobRow = {\n          id,\n          name,\n          status: 'open',\n          stage: 'define',\n          type: body.type ?? 'feature',\n          date: new Date().toISOString().slice(0, 10),\n          title: body.title ?? 'untitled',\n          branch: `${body.type ?? 'feature'}/${name}`,\n          jdi: null,\n        }\n        jobs.unshift(job)\n        S.files[`${m[1]}/${name}/brief.md`] = briefScaffold(job.title, job.type, id)\n        return jsonRes({ job }, 201)\n      },\n    },\n    {\n      method: 'GET',\n      pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/files\\/(brief|tasks|implementation|verdict)\\.md$/,\n      handle: (m) => {\n        const content = S.files[`${m[1]}/${m[2]}/${m[3]}.md`]\n        return content !== undefined ? textRes(content) : errRes(404, 'file not found')\n      },\n    },\n    {\n      method: 'PUT',\n      pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/files\\/brief$/,\n      handle: async (m, req) => {\n        S.files[`${m[1]}/${m[2]}/brief.md`] = String(typeof req.body === 'string' ? req.body : '')\n        return jsonRes({ ok: true })\n      },\n    },\n    {\n      method: 'GET',\n      pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/jdi$/,\n      handle: (m) => {\n        const jobs = S.jobs[m[1]] ?? []\n        const job = jobs.find((j) => j.id === m[2] || j.name === m[2])\n        if (!job) return errRes(404, 'job not found')\n        const log = S.logs[`${m[1]}/${job.name}`]\n        return jsonRes({\n          status: job.jdi ?? null,\n          runLog: log?.runLog ?? null,\n          sessionLog: log?.sessionLog ?? null,\n        })\n      },\n    },\n    {\n      method: 'POST',\n      pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/jdi\\/start$/,\n      handle: (m) => {\n        const jobs = S.jobs[m[1]] ?? []\n        const job = jobs.find((j) => j.id === m[2] || j.name === m[2])\n        if (!job) return errRes(404, 'job not found')\n        job.jdi = { state: 'running', agent: 'analyst', updated: now() }\n        S.logs[`${m[1]}/${job.name}`] ??= { runLog: `=== ${now()} mg jdi started ===`, sessionLog: '' }\n        ensureTicker()\n        return jsonRes({ started: true, message: `mg jdi detached for ${job.name}` })\n      },\n    },\n    {\n      method: 'POST',\n      pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/agents\\/([^/]+)\\/launch$/,\n      handle: (m) => {\n        const jobs = S.jobs[m[1]] ?? []\n        const job = jobs.find((j) => j.id === m[2] || j.name === m[2])\n        if (!job) return errRes(404, 'job not found')\n        const log = S.logs[`${m[1]}/${job.name}`] ??= { runLog: '', sessionLog: '' }\n        log.runLog += `\\n=== ${now()} ${m[3]} invoked (detached, one-shot) ===`\n        job.jdi = { state: 'running', agent: m[3], updated: now() }\n        return jsonRes({ started: true, message: `${m[3]} launched detached on ${job.name}` })\n      },\n    },\n    {\n      method: 'GET',\n      pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/diff$/,\n      handle: (m, req) => {\n        const query = req.url.split('?')[1] ?? ''\n        if (new URLSearchParams(query).get('full') === '1') return jsonRes({ patch: diffPatch })\n        return jsonRes({ log: diffLog, stat: diffStat })\n      },\n    },\n    {\n      method: 'GET',\n      pattern: /^\\/projects\\/([^/]+)\\/agents$/,\n      handle: (m) => (S.jobs[m[1]] ? jsonRes({ agents }) : errRes(404, 'project not found')),\n    },\n    {\n      method: 'POST',\n      pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/done$/,\n      handle: (m) => {\n        const jobs = S.jobs[m[1]] ?? []\n        const idx = jobs.findIndex((j) => j.id === m[2] || j.name === m[2])\n        if (idx < 0) return errRes(404, 'job not found')\n        const [job] = jobs.splice(idx, 1)\n        return jsonRes({ message: `archived ${job.name} — squash-merged into main` })\n      },\n    },\n    {\n      method: 'POST',\n      pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/delete$/,\n      handle: (m) => {\n        const jobs = S.jobs[m[1]] ?? []\n        const idx = jobs.findIndex((j) => j.id === m[2] || j.name === m[2])\n        if (idx < 0) return errRes(404, 'job not found')\n        const [job] = jobs.splice(idx, 1)\n        return jsonRes({ message: `deleted ${job.name} — worktree and branch removed` })\n      },\n    },\n    {\n      method: 'POST',\n      pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/push$/,\n      handle: (m) => jsonRes({ message: `pushed ${m[2]} to origin` }),\n    },\n    {\n      method: 'GET',\n      pattern: /^\\/projects\\/([^/]+)\\/orphans$/,\n      handle: (m) => jsonRes({ orphans: S.orphans[m[1]] ?? [] }),\n    },\n    {\n      method: 'POST',\n      pattern: /^\\/projects\\/([^/]+)\\/orphans\\/remove$/,\n      handle: (m) => {\n        const count = S.orphans[m[1]]?.length ?? 0\n        S.orphans[m[1]] = []\n        return jsonRes({ message: `removed ${count} orphaned worktree${count === 1 ? '' : 's'}` })\n      },\n    },\n    {\n      method: 'POST',\n      pattern: /^\\/prune$/,\n      handle: () => jsonRes({ removed: 2, running: 1 }),\n    },\n    // SSE stream — sends the current tail, then keeps sending as the ticker\n    // grows it. Falls through to 404 semantics if the job has no log yet.\n    {\n      method: 'GET',\n      pattern: /^\\/projects\\/([^/]+)\\/jobs\\/([^/]+)\\/session-log\\/stream$/,\n      handle: (m) => {\n        const jobs = S.jobs[m[1]] ?? []\n        const job = jobs.find((j) => j.id === m[2] || j.name === m[2])\n        const log = job && S.logs[`${m[1]}/${job.name}`]\n        if (!log) return errRes(404, 'no session log for this job')\n        const stream = new ReadableStream({\n          start(controller) {\n            const enc = new TextEncoder()\n            let lastLen = -1\n            const send = () => {\n              if (log.sessionLog.length !== lastLen) {\n                lastLen = log.sessionLog.length\n                controller.enqueue(enc.encode(`data: ${JSON.stringify(log.sessionLog).slice(1, -1)}\\n\\n`))\n              }\n            }\n            send()\n            const iv = setInterval(send, 1500)\n            // @ts-expect-error — signal cleanup when the client disconnects\n            this._iv = iv\n          },\n          cancel(reason) {\n            // @ts-expect-error — mirror of start's handle\n            clearInterval(this._iv)\n            void reason\n          },\n        })\n        return new Response(stream, { headers: { 'Content-Type': 'text/event-stream' } })\n      },\n    },\n  ]\n}\n\nlet installed = false\n\nexport function installMock() {\n  if (installed) return\n  installed = true\n  const realFetch = globalThis.fetch\n  mockFetch.realFetch = realFetch\n  globalThis.fetch = mockFetch as typeof fetch\n  ensureTicker()\n}\n\nexport const mockFetch = async (input: RequestInfo | URL, init?: RequestInit): Promise<Response> => {\n  const url = typeof input === 'string' ? input : input instanceof URL ? input.href : input.url\n  const method = (\n    init?.method ?? (typeof input !== 'string' && !(input instanceof URL) ? input.method : 'GET')\n  ).toUpperCase()\n  const path = url.replace(/^https?:\\/\\/[^/]+/, '')\n  for (const r of routes()) {\n    if (r.method !== method) continue\n    const m = path.split('?')[0].match(r.pattern)\n    if (m) return await r.handle(m, { body: init?.body, url })\n  }\n  return errRes(404, `mock daemon: no route for ${method} ${path}`)\n}\nmockFetch.realFetch = undefined as unknown as typeof fetch\n\n/** Wire the mock into the module loader when enabled (mock mode or ?mock=1). */\nexport function maybeInstallMockFromEnv() {\n  const forced = typeof __MG_MOCK__ !== 'undefined' && __MG_MOCK__\n  const qs = typeof location !== 'undefined' && new URLSearchParams(location.search).has('mock')\n  if (forced || qs) installMock()\n}","lineStart":1,"lineEnd":624,"totalLines":624,"truncated":false}},"title":"web-ui/src/lib/api/mock.ts","time":{"start":1787994907307,"end":1787994907313}},"id":"prt_04ccd219e001Eb0K7Dmn8dNntk","sessionID":"ses_fb3369276ffeikF3KayngIgfbM","messageID":"msg_04ccd0fac001LZbuhcL7WhGXxH"}}
