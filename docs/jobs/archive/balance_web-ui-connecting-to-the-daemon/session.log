{"type":"tool_use","timestamp":1787995880685,"sessionID":"ses_fb3250779ffe153rxsL511kCsf","part":{"type":"tool","tool":"read","callID":"call_50395921d23c4a0d9b979128","state":{"status":"completed","input":{"filePath":"/workspace/web-ui/src/lib/views/AgentsView.svelte"},"output":"<path>/workspace/web-ui/src/lib/views/AgentsView.svelte</path>\n<type>file</type>\n<content>\n1: <script lang=\"ts\">\n2:   import { onMount } from 'svelte'\n3:   import EmptyState from '$lib/components/EmptyState.svelte'\n4:   import { getAgents } from '$lib/api/client'\n5:   import { href } from '$lib/router'\n6:   import type { AgentRow } from '$lib/api/types'\n7: \n8:   let { project }: { project: string } = $props()\n9: \n10:   let agents = $state<AgentRow[]>([])\n11:   let loading = $state(true)\n12:   let error = $state('')\n13:   let q = $state('')\n14: \n15:   onMount(async () => {\n16:     try {\n17:       const res = await getAgents(project)\n18:       agents = res.agents ?? []\n19:     } catch (e) {\n20:       error = e instanceof Error ? e.message : String(e)\n21:     } finally {\n22:       loading = false\n23:     }\n24:   })\n25: \n26:   const filtered = $derived.by(() => {\n27:     const needle = q.trim().toLowerCase()\n28:     if (!needle) return agents\n29:     return agents.filter(\n30:       (a) => a.name.toLowerCase().includes(needle) || a.description.toLowerCase().includes(needle),\n31:     )\n32:   })\n33: \n34:   const JDI_CREW = ['analyst', 'developer', 'reviewer']\n35: \n36:   function crewOf(name: string): 'jdi' | 'launchable' {\n37:     return JDI_CREW.includes(name) ? 'jdi' : 'launchable'\n38:   }\n39: </script>\n40: \n41: <div class=\"page\">\n42:   <header class=\"head\">\n43:     <div>\n44:       <p class=\"eyebrow\">crew</p>\n45:       <h1>Agents on {project}</h1>\n46:     </div>\n47:     <input class=\"input search\" placeholder=\"Filter the crew…\" bind:value={q} spellcheck=\"false\" aria-label=\"Filter agents\" />\n48:   </header>\n49: \n50:   <p class=\"lead\">\n51:     The autonomous sequence is fixed — <code>@analyst → @developer → @reviewer</code> — that is what\n52:     <code>mg jdi</code> runs. Every agent can also be fired once, detached, from a job's\n53:     <a href={href({ name: 'jobs', project })}>detail view</a>.\n54:   </p>\n55: \n56:   {#if error}\n57:     <p class=\"error\" role=\"alert\">{error}</p>\n58:   {:else if loading}\n59:     <p class=\"loading\">Listing the crew…</p>\n60:   {:else if filtered.length === 0}\n61:     <EmptyState title=\"No agents match\" hint=\"Clear the filter to see the whole crew.\" />\n62:   {:else}\n63:     <ul class=\"grid\">\n64:       {#each filtered as a (a.name)}\n65:         <li class=\"agent\" data-crew={crewOf(a.name)}>\n66:           <div class=\"agent-head\">\n67:             <span class=\"agent-name\">{\"@\" + a.name}</span>\n68:             {#if crewOf(a.name) === 'jdi'}\n69:               <span class=\"chip chip-running\"><span class=\"dot\"></span> jdi crew</span>\n70:             {:else}\n71:               <span class=\"chip chip-neutral\">manual</span>\n72:             {/if}\n73:           </div>\n74:           <p class=\"agent-desc\">{a.description}</p>\n75:         </li>\n76:       {/each}\n77:     </ul>\n78:   {/if}\n79: </div>\n80: \n81: <style>\n82:   .page {\n83:     max-width: 900px;\n84:     margin: 0 auto;\n85:     padding: var(--r-6) var(--r-6) var(--r-7);\n86:     width: 100%;\n87:   }\n88:   .head {\n89:     display: flex;\n90:     justify-content: space-between;\n91:     align-items: flex-end;\n92:     gap: var(--r-4);\n93:     flex-wrap: wrap;\n94:     margin-bottom: var(--r-3);\n95:   }\n96:   h1 {\n97:     font-size: 24px;\n98:     letter-spacing: -0.02em;\n99:   }\n100:   .search {\n101:     width: min(260px, 60vw);\n102:   }\n103:   .lead {\n104:     color: var(--ink-2);\n105:     font-size: 13.5px;\n106:     margin-bottom: var(--r-5);\n107:     max-width: 70ch;\n108:   }\n109:   .lead code {\n110:     color: var(--accent-bright);\n111:     font-size: 0.9em;\n112:   }\n113: \n114:   .grid {\n115:     list-style: none;\n116:     margin: 0;\n117:     padding: 0;\n118:     display: grid;\n119:     grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n120:     gap: var(--r-3);\n121:   }\n122:   .agent {\n123:     background: var(--bg-1);\n124:     border: 1px solid var(--line);\n125:     border-radius: var(--radius-m);\n126:     padding: var(--r-4);\n127:     transition: border-color var(--t-fast);\n128:   }\n129:   .agent:hover {\n130:     border-color: var(--line-strong);\n131:   }\n132:   .agent[data-crew='jdi'] {\n133:     border-left: 2px solid var(--accent);\n134:   }\n135:   .agent-head {\n136:     display: flex;\n137:     justify-content: space-between;\n138:     align-items: center;\n139:     gap: var(--r-2);\n140:     margin-bottom: 8px;\n141:   }\n142:   .agent-name {\n143:     font-family: var(--font-mono);\n144:     font-size: 13.5px;\n145:     color: var(--ink-0);\n146:     font-weight: 500;\n147:   }\n148:   .agent[data-crew='jdi'] .agent-name {\n149:     color: var(--accent-bright);\n150:   }\n151:   .agent-desc {\n152:     font-size: 13px;\n153:     color: var(--ink-2);\n154:     line-height: 1.55;\n155:   }\n156:   .error {\n157:     color: #ffb3b6;\n158:   }\n159:   .loading {\n160:     color: var(--ink-2);\n161:   }\n162: \n163:   @media (max-width: 760px) {\n164:     .page {\n165:       padding: var(--r-4) var(--r-4) var(--r-6);\n166:     }\n167:     .search {\n168:       width: 100%;\n169:     }\n170:   }\n171: </style>\n\n(End of file - total 171 lines)\n</content>","metadata":{"preview":"<script lang=\"ts\">\n  import { onMount } from 'svelte'\n  import EmptyState from '$lib/components/EmptyState.svelte'\n  import { getAgents } from '$lib/api/client'\n  import { href } from '$lib/router'\n  import type { AgentRow } from '$lib/api/types'\n\n  let { project }: { project: string } = $props()\n\n  let agents = $state<AgentRow[]>([])\n  let loading = $state(true)\n  let error = $state('')\n  let q = $state('')\n\n  onMount(async () => {\n    try {\n      const res = await getAgents(project)\n      agents = res.agents ?? []\n    } catch (e) {\n      error = e instanceof Error ? e.message : String(e)","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/web-ui/src/lib/views/AgentsView.svelte","text":"<script lang=\"ts\">\n  import { onMount } from 'svelte'\n  import EmptyState from '$lib/components/EmptyState.svelte'\n  import { getAgents } from '$lib/api/client'\n  import { href } from '$lib/router'\n  import type { AgentRow } from '$lib/api/types'\n\n  let { project }: { project: string } = $props()\n\n  let agents = $state<AgentRow[]>([])\n  let loading = $state(true)\n  let error = $state('')\n  let q = $state('')\n\n  onMount(async () => {\n    try {\n      const res = await getAgents(project)\n      agents = res.agents ?? []\n    } catch (e) {\n      error = e instanceof Error ? e.message : String(e)\n    } finally {\n      loading = false\n    }\n  })\n\n  const filtered = $derived.by(() => {\n    const needle = q.trim().toLowerCase()\n    if (!needle) return agents\n    return agents.filter(\n      (a) => a.name.toLowerCase().includes(needle) || a.description.toLowerCase().includes(needle),\n    )\n  })\n\n  const JDI_CREW = ['analyst', 'developer', 'reviewer']\n\n  function crewOf(name: string): 'jdi' | 'launchable' {\n    return JDI_CREW.includes(name) ? 'jdi' : 'launchable'\n  }\n</script>\n\n<div class=\"page\">\n  <header class=\"head\">\n    <div>\n      <p class=\"eyebrow\">crew</p>\n      <h1>Agents on {project}</h1>\n    </div>\n    <input class=\"input search\" placeholder=\"Filter the crew…\" bind:value={q} spellcheck=\"false\" aria-label=\"Filter agents\" />\n  </header>\n\n  <p class=\"lead\">\n    The autonomous sequence is fixed — <code>@analyst → @developer → @reviewer</code> — that is what\n    <code>mg jdi</code> runs. Every agent can also be fired once, detached, from a job's\n    <a href={href({ name: 'jobs', project })}>detail view</a>.\n  </p>\n\n  {#if error}\n    <p class=\"error\" role=\"alert\">{error}</p>\n  {:else if loading}\n    <p class=\"loading\">Listing the crew…</p>\n  {:else if filtered.length === 0}\n    <EmptyState title=\"No agents match\" hint=\"Clear the filter to see the whole crew.\" />\n  {:else}\n    <ul class=\"grid\">\n      {#each filtered as a (a.name)}\n        <li class=\"agent\" data-crew={crewOf(a.name)}>\n          <div class=\"agent-head\">\n            <span class=\"agent-name\">{\"@\" + a.name}</span>\n            {#if crewOf(a.name) === 'jdi'}\n              <span class=\"chip chip-running\"><span class=\"dot\"></span> jdi crew</span>\n            {:else}\n              <span class=\"chip chip-neutral\">manual</span>\n            {/if}\n          </div>\n          <p class=\"agent-desc\">{a.description}</p>\n        </li>\n      {/each}\n    </ul>\n  {/if}\n</div>\n\n<style>\n  .page {\n    max-width: 900px;\n    margin: 0 auto;\n    padding: var(--r-6) var(--r-6) var(--r-7);\n    width: 100%;\n  }\n  .head {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n    gap: var(--r-4);\n    flex-wrap: wrap;\n    margin-bottom: var(--r-3);\n  }\n  h1 {\n    font-size: 24px;\n    letter-spacing: -0.02em;\n  }\n  .search {\n    width: min(260px, 60vw);\n  }\n  .lead {\n    color: var(--ink-2);\n    font-size: 13.5px;\n    margin-bottom: var(--r-5);\n    max-width: 70ch;\n  }\n  .lead code {\n    color: var(--accent-bright);\n    font-size: 0.9em;\n  }\n\n  .grid {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n    gap: var(--r-3);\n  }\n  .agent {\n    background: var(--bg-1);\n    border: 1px solid var(--line);\n    border-radius: var(--radius-m);\n    padding: var(--r-4);\n    transition: border-color var(--t-fast);\n  }\n  .agent:hover {\n    border-color: var(--line-strong);\n  }\n  .agent[data-crew='jdi'] {\n    border-left: 2px solid var(--accent);\n  }\n  .agent-head {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: var(--r-2);\n    margin-bottom: 8px;\n  }\n  .agent-name {\n    font-family: var(--font-mono);\n    font-size: 13.5px;\n    color: var(--ink-0);\n    font-weight: 500;\n  }\n  .agent[data-crew='jdi'] .agent-name {\n    color: var(--accent-bright);\n  }\n  .agent-desc {\n    font-size: 13px;\n    color: var(--ink-2);\n    line-height: 1.55;\n  }\n  .error {\n    color: #ffb3b6;\n  }\n  .loading {\n    color: var(--ink-2);\n  }\n\n  @media (max-width: 760px) {\n    .page {\n      padding: var(--r-4) var(--r-4) var(--r-6);\n    }\n    .search {\n      width: 100%;\n    }\n  }\n</style>","lineStart":1,"lineEnd":171,"totalLines":171,"truncated":false}},"title":"web-ui/src/lib/views/AgentsView.svelte","time":{"start":1787995880669,"end":1787995880675}},"id":"prt_04cdbf716001HfWwK61sUxbRkB","sessionID":"ses_fb3250779ffe153rxsL511kCsf","messageID":"msg_04cdbf225001d8nX8VtKaaavef"}}
{"type":"tool_use","timestamp":1787995880780,"sessionID":"ses_fb3250779ffe153rxsL511kCsf","part":{"type":"tool","tool":"read","callID":"call_d352c75e561b405090d7c750","state":{"status":"completed","input":{"filePath":"/workspace/web-ui/package.json"},"output":"<path>/workspace/web-ui/package.json</path>\n<type>file</type>\n<content>\n1: {\n2:   \"name\": \"manigot-web-ui\",\n3:   \"private\": true,\n4:   \"version\": \"0.1.0\",\n5:   \"type\": \"module\",\n6:   \"description\": \"manigot control plane — web client for the mg serve daemon\",\n7:   \"scripts\": {\n8:     \"dev\": \"vite\",\n9:     \"dev:mock\": \"vite --mode mock\",\n10:     \"build\": \"vite build\",\n11:     \"preview\": \"vite preview\",\n12:     \"test\": \"vitest run\",\n13:     \"test:watch\": \"vitest\"\n14:   },\n15:   \"dependencies\": {\n16:     \"@fontsource-variable/familjen-grotesk\": \"^5.2.5\",\n17:     \"@fontsource/ibm-plex-mono\": \"^5.2.5\",\n18:     \"dompurify\": \"^3.2.6\",\n19:     \"marked\": \"^15.0.7\"\n20:   },\n21:   \"devDependencies\": {\n22:     \"@sveltejs/vite-plugin-svelte\": \"^5.0.3\",\n23:     \"@testing-library/jest-dom\": \"^6.6.3\",\n24:     \"@testing-library/svelte\": \"^5.2.1\",\n25:     \"jsdom\": \"^26.0.0\",\n26:     \"svelte\": \"^5.20.0\",\n27:     \"typescript\": \"^5.7.3\",\n28:     \"vite\": \"^6.1.0\",\n29:     \"vitest\": \"^3.0.6\"\n30:   }\n31: }\n\n(End of file - total 31 lines)\n</content>","metadata":{"preview":"{\n  \"name\": \"manigot-web-ui\",\n  \"private\": true,\n  \"version\": \"0.1.0\",\n  \"type\": \"module\",\n  \"description\": \"manigot control plane — web client for the mg serve daemon\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"dev:mock\": \"vite --mode mock\",\n    \"build\": \"vite build\",\n    \"preview\": \"vite preview\",\n    \"test\": \"vitest run\",\n    \"test:watch\": \"vitest\"\n  },\n  \"dependencies\": {\n    \"@fontsource-variable/familjen-grotesk\": \"^5.2.5\",\n    \"@fontsource/ibm-plex-mono\": \"^5.2.5\",\n    \"dompurify\": \"^3.2.6\",\n    \"marked\": \"^15.0.7\"\n  },","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/web-ui/package.json","text":"{\n  \"name\": \"manigot-web-ui\",\n  \"private\": true,\n  \"version\": \"0.1.0\",\n  \"type\": \"module\",\n  \"description\": \"manigot control plane — web client for the mg serve daemon\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"dev:mock\": \"vite --mode mock\",\n    \"build\": \"vite build\",\n    \"preview\": \"vite preview\",\n    \"test\": \"vitest run\",\n    \"test:watch\": \"vitest\"\n  },\n  \"dependencies\": {\n    \"@fontsource-variable/familjen-grotesk\": \"^5.2.5\",\n    \"@fontsource/ibm-plex-mono\": \"^5.2.5\",\n    \"dompurify\": \"^3.2.6\",\n    \"marked\": \"^15.0.7\"\n  },\n  \"devDependencies\": {\n    \"@sveltejs/vite-plugin-svelte\": \"^5.0.3\",\n    \"@testing-library/jest-dom\": \"^6.6.3\",\n    \"@testing-library/svelte\": \"^5.2.1\",\n    \"jsdom\": \"^26.0.0\",\n    \"svelte\": \"^5.20.0\",\n    \"typescript\": \"^5.7.3\",\n    \"vite\": \"^6.1.0\",\n    \"vitest\": \"^3.0.6\"\n  }\n}","lineStart":1,"lineEnd":31,"totalLines":31,"truncated":false}},"title":"web-ui/package.json","time":{"start":1787995880775,"end":1787995880779}},"id":"prt_04cdbfcdf001UOsczDG4qyeVG1","sessionID":"ses_fb3250779ffe153rxsL511kCsf","messageID":"msg_04cdbf225001d8nX8VtKaaavef"}}
{"type":"tool_use","timestamp":1787995880924,"sessionID":"ses_fb3250779ffe153rxsL511kCsf","part":{"type":"tool","tool":"read","callID":"call_fb14db5d4c034e5a8cf179d1","state":{"status":"completed","input":{"filePath":"/workspace/web-ui/README.md"},"output":"<path>/workspace/web-ui/README.md</path>\n<type>file</type>\n<content>\n1: # manigot web UI\n2: \n3: The control-plane client for `mg serve` — a Svelte 5 single-page app that\n4: renders the daemon's read-only API today and the mutating surface as it lands.\n5: It is a port of the TUI's information design: same data, same job pipeline,\n6: same attention ordering — built for a browser, so the \"review from a phone,\n7: get a ping when a job needs you, act on it\" story has a surface.\n8: \n9: ## Running\n10: \n11: ```sh\n12: npm install\n13: npm run dev        # vite dev server on :5173\n14: npm run dev:mock   # same, with the in-browser mock daemon (no mg serve needed)\n15: npm run build      # production build to dist/\n16: npm run test       # vitest suite\n17: ```\n18: \n19: The app talks to the daemon through the connection setting (Settings modal /\n20: `?api=` URL param). The daemon is a same-origin JSON API — it sends no CORS\n21: headers, so the browser blocks any direct cross-origin URL (the error will\n22: say \"cross-origin URL blocked\"). In dev, use the vite proxy path instead:\n23: \n24: ```sh\n25: npm run dev\n26: # open http://localhost:5173/?api=/api\n27: ```\n28: \n29: `/api` is same-origin (vite proxies it to `127.0.0.1:8080`, forwarding the\n30: bearer token). Served by the daemon itself (production, same origin) there\n31: is nothing to configure; against a remote daemon behind a reverse proxy the\n32: proxy serves both the UI and `/api`. For a non-loopback daemon bind, set the\n33: bearer token in the settings modal (`mg serve-token` writes one to the\n34: daemon's `.env` — tokens never ride in URLs).\n35: \n36: Development conveniences:\n37: \n38: - `?api=<url>` — point the session at a daemon without touching settings\n39:   (deep-link/testing only; tokens stay in the settings modal).\n40: - `?mock=1` (or `--mode mock`) — swap the API layer for the in-browser\n41:   fixture backend (`src/lib/api/mock.ts`), so the UI is fully explorable with\n42:   no daemon running. The mock mirrors the real API shapes exactly — its\n43:   routes are pinned by `mock.test.ts` so the dev environment cannot silently\n44:   drift from the shipped daemon.\n45: \n46: ## Layout\n47: \n48: ```\n49: src/\n50:   App.svelte            shell: rail, router, connection bar, palette\n51:   main.ts               bootstrap\n52:   lib/\n53:     api/                client, endpoint paths, types, mock backend, SSE stream\n54:     components/         Pipeline, MarkdownView, DiffView, RunConsole, modals, …\n55:     state/              connection, data (polling), toasts stores\n56:     views/              JobsView, JobDetailView, AgentsView, HealthView\n57:     diff.ts             parse git log/stat/patch into renderable structures\n58:     runlog.ts           parse run.log event timeline (incl. NEEDS-HUMAN-INPUT)\n59:     markdown.ts         sanitized markdown render + verdict/status extraction\n60:     stage.ts            pipeline stage ordering + attention sorting\n61:     router.ts           hash router (#/p/<project>[/j/<job>[/<tab>]])\n62:     time.ts             relative time formatting\n63: ```\n64: \n65: ## Design notes\n66: \n67: - **Part 1 / Part 2 capability probing** — the client treats a 404/405 from a\n68:   mutating endpoint as a *capability miss* (`ApiError.capabilityMiss`), so\n69:   the same frontend runs against a read-only daemon (actions greyed out with\n70:   an explanation) and against the full control plane once job two's endpoints\n71:   land.\n72: - **Attention-first job list** — `stopped:needs-human` outranks `running`\n73:   outranks quiet; the segmented filter and the sort share one `stage.ts`.\n74: - **Live run console** — the Run tab polls `/jdi` for the event timeline and\n75:   attaches the `session.log` stream over SSE when the daemon offers it,\n76:   degrading to polling otherwise; the mode is shown, never hidden.\n77: - **Job files** — the daemon serves job files by their on-disk name\n78:   (`brief.md`, not `brief`); the client maps tab ids to filenames.\n79: - **Accessibility** — WCAG AA contrast on all informative text, keyboard\n80:   navigation throughout, ARIA roles on interactive affordances, verified per\n81:   render with the `shot` tool at 375/768/1280.\n\n(End of file - total 81 lines)\n</content>","metadata":{"preview":"# manigot web UI\n\nThe control-plane client for `mg serve` — a Svelte 5 single-page app that\nrenders the daemon's read-only API today and the mutating surface as it lands.\nIt is a port of the TUI's information design: same data, same job pipeline,\nsame attention ordering — built for a browser, so the \"review from a phone,\nget a ping when a job needs you, act on it\" story has a surface.\n\n## Running\n\n```sh\nnpm install\nnpm run dev        # vite dev server on :5173\nnpm run dev:mock   # same, with the in-browser mock daemon (no mg serve needed)\nnpm run build      # production build to dist/\nnpm run test       # vitest suite\n```\n\nThe app talks to the daemon through the connection setting (Settings modal /\n`?api=` URL param). The daemon is a same-origin JSON API — it sends no CORS","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/web-ui/README.md","text":"# manigot web UI\n\nThe control-plane client for `mg serve` — a Svelte 5 single-page app that\nrenders the daemon's read-only API today and the mutating surface as it lands.\nIt is a port of the TUI's information design: same data, same job pipeline,\nsame attention ordering — built for a browser, so the \"review from a phone,\nget a ping when a job needs you, act on it\" story has a surface.\n\n## Running\n\n```sh\nnpm install\nnpm run dev        # vite dev server on :5173\nnpm run dev:mock   # same, with the in-browser mock daemon (no mg serve needed)\nnpm run build      # production build to dist/\nnpm run test       # vitest suite\n```\n\nThe app talks to the daemon through the connection setting (Settings modal /\n`?api=` URL param). The daemon is a same-origin JSON API — it sends no CORS\nheaders, so the browser blocks any direct cross-origin URL (the error will\nsay \"cross-origin URL blocked\"). In dev, use the vite proxy path instead:\n\n```sh\nnpm run dev\n# open http://localhost:5173/?api=/api\n```\n\n`/api` is same-origin (vite proxies it to `127.0.0.1:8080`, forwarding the\nbearer token). Served by the daemon itself (production, same origin) there\nis nothing to configure; against a remote daemon behind a reverse proxy the\nproxy serves both the UI and `/api`. For a non-loopback daemon bind, set the\nbearer token in the settings modal (`mg serve-token` writes one to the\ndaemon's `.env` — tokens never ride in URLs).\n\nDevelopment conveniences:\n\n- `?api=<url>` — point the session at a daemon without touching settings\n  (deep-link/testing only; tokens stay in the settings modal).\n- `?mock=1` (or `--mode mock`) — swap the API layer for the in-browser\n  fixture backend (`src/lib/api/mock.ts`), so the UI is fully explorable with\n  no daemon running. The mock mirrors the real API shapes exactly — its\n  routes are pinned by `mock.test.ts` so the dev environment cannot silently\n  drift from the shipped daemon.\n\n## Layout\n\n```\nsrc/\n  App.svelte            shell: rail, router, connection bar, palette\n  main.ts               bootstrap\n  lib/\n    api/                client, endpoint paths, types, mock backend, SSE stream\n    components/         Pipeline, MarkdownView, DiffView, RunConsole, modals, …\n    state/              connection, data (polling), toasts stores\n    views/              JobsView, JobDetailView, AgentsView, HealthView\n    diff.ts             parse git log/stat/patch into renderable structures\n    runlog.ts           parse run.log event timeline (incl. NEEDS-HUMAN-INPUT)\n    markdown.ts         sanitized markdown render + verdict/status extraction\n    stage.ts            pipeline stage ordering + attention sorting\n    router.ts           hash router (#/p/<project>[/j/<job>[/<tab>]])\n    time.ts             relative time formatting\n```\n\n## Design notes\n\n- **Part 1 / Part 2 capability probing** — the client treats a 404/405 from a\n  mutating endpoint as a *capability miss* (`ApiError.capabilityMiss`), so\n  the same frontend runs against a read-only daemon (actions greyed out with\n  an explanation) and against the full control plane once job two's endpoints\n  land.\n- **Attention-first job list** — `stopped:needs-human` outranks `running`\n  outranks quiet; the segmented filter and the sort share one `stage.ts`.\n- **Live run console** — the Run tab polls `/jdi` for the event timeline and\n  attaches the `session.log` stream over SSE when the daemon offers it,\n  degrading to polling otherwise; the mode is shown, never hidden.\n- **Job files** — the daemon serves job files by their on-disk name\n  (`brief.md`, not `brief`); the client maps tab ids to filenames.\n- **Accessibility** — WCAG AA contrast on all informative text, keyboard\n  navigation throughout, ARIA roles on interactive affordances, verified per\n  render with the `shot` tool at 375/768/1280.","lineStart":1,"lineEnd":81,"totalLines":81,"truncated":false}},"title":"web-ui/README.md","time":{"start":1787995880918,"end":1787995880923}},"id":"prt_04cdbfd71001w0GnQwZpXzisyS","sessionID":"ses_fb3250779ffe153rxsL511kCsf","messageID":"msg_04cdbf225001d8nX8VtKaaavef"}}
