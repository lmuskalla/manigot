{"type":"tool_use","timestamp":1787995427634,"sessionID":"ses_fb3369276ffeikF3KayngIgfbM","part":{"type":"tool","tool":"write","callID":"call_8a621621838d4217bc40d3d6","state":{"status":"completed","input":{"filePath":"/tmp/mg-test/verify.mjs","content":"import { chromium } from 'playwright'\n\nconst BASE = 'http://localhost:5173'\nlet failures = 0\n\nfunction check(name, cond, extra = '') {\n  console.log(`${cond ? 'PASS' : 'FAIL'}  ${name}${extra ? ' — ' + extra : ''}`)\n  if (!cond) failures++\n}\n\nconst browser = await chromium.launch()\n\n// ── Test 1: fresh boot with NO persisted connection → daemon check fails → landing truth\n{\n  const ctx = await browser.newContext()\n  const page = await ctx.newPage()\n  await page.goto(BASE + '/', { waitUntil: 'domcontentloaded' })\n  await page.waitForTimeout(1200)\n  const landing = await page.locator('.landing').textContent().catch(() => null)\n  check('T1 fresh boot: landing shows unreachable (not \"Connecting to the daemon\")',\n    !!landing && landing.includes('unreachable'),\n    JSON.stringify(landing?.slice(0, 80)))\n  check('T1 fresh boot: dropdown empty', (await page.locator('#project-select option').count()) === 0)\n  await ctx.close()\n}\n\n// ── Test 2: persisted working connection → dropdown populates WITHOUT reload\n{\n  const ctx = await browser.newContext()\n  const page = await ctx.newPage()\n  await page.addInitScript(() => {\n    localStorage.setItem('mg-control.connection', JSON.stringify({ baseUrl: '/api', token: '' }))\n  })\n  await page.goto(BASE + '/?api=/api', { waitUntil: 'domcontentloaded' })\n  await page.waitForTimeout(1500)\n  const options = await page.locator('#project-select option').allTextContents()\n  check('T2 persisted conn: dropdown populated without reload', options.length === 2 && options[0] === 'manigot', JSON.stringify(options))\n  const url = page.url()\n  check('T2 persisted conn: redirected off home to jobs', url.includes('#/p/manigot'), url)\n  const jobsHeader = await page.locator('h1').first().textContent().catch(() => null)\n  check('T2 jobs page renders', jobsHeader === 'manigot', jobsHeader ?? 'none')\n  await ctx.close()\n}\n\n// ── Test 3: health page renders the real /health response\n{\n  const ctx = await browser.newContext()\n  const page = await ctx.newPage()\n  await page.addInitScript(() => {\n    localStorage.setItem('mg-control.connection', JSON.stringify({ baseUrl: '/api', token: '' }))\n  })\n  await page.goto(BASE + '/?api=/api#/health', { waitUntil: 'domcontentloaded' })\n  await page.waitForTimeout(1500)\n  const body = await page.locator('.page').textContent().catch(() => '')\n  check('T3 health: version rendered', body.includes('d3b0240'), body.slice(0, 60).replace(/\\s+/g, ' '))\n  check('T3 health: not stuck on connecting', !body.includes('Checking the daemon'), body.slice(0, 40))\n  const profiles = await page.locator('.profile').count()\n  check('T3 health: profiles listed', profiles >= 2, `profiles=${profiles}`)\n  await ctx.close()\n}\n\n// ── Test 4: settings-change flow (connection.set) — dropdown populates after saving\n// Simulated by starting unconfigured, then re-pointing via ?api is not a settings\n// change; instead drive the real store through the settings modal.\n{\n  const ctx = await browser.newContext()\n  const page = await ctx.newPage()\n  await page.goto(BASE + '/', { waitUntil: 'domcontentloaded' })\n  await page.waitForTimeout(800)\n  // open the connection settings from the landing's Connection button\n  await page.getByRole('button', { name: 'Connection' }).first().click()\n  await page.waitForTimeout(200)\n  await page.getByLabel('daemon URL').fill('/api')\n  await page.getByRole('button', { name: 'Save and connect' }).click()\n  await page.waitForTimeout(1800)\n  const options = await page.locator('#project-select option').allTextContents()\n  check('T4 settings save: dropdown populated without reload', options.length === 2 && options[0] === 'manigot', JSON.stringify(options))\n  const url = page.url()\n  check('T4 settings save: redirected to jobs', url.includes('#/p/manigot'), url)\n  await ctx.close()\n}\n\nawait browser.close()\nconsole.log(failures === 0 ? '\\nALL PASS' : `\\n${failures} FAILURES`)\nprocess.exit(failures === 0 ? 0 : 1)"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/tmp/mg-test/verify.mjs","exists":false,"truncated":false},"title":"../tmp/mg-test/verify.mjs","time":{"start":1787995427619,"end":1787995427632}},"id":"prt_04cd4f527001QbkBdOhhYDoDVt","sessionID":"ses_fb3369276ffeikF3KayngIgfbM","messageID":"msg_04cd4df1a001GNtbb71o7YO3wI"}}
