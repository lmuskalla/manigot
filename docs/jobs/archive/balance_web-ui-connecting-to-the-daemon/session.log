{"type":"tool_use","timestamp":1787995877707,"sessionID":"ses_fb3250779ffe153rxsL511kCsf","part":{"type":"tool","tool":"read","callID":"call_7d1e37febfcd42e7ad2b4f18","state":{"status":"completed","input":{"filePath":"/workspace/web-ui/src/lib/state/connection.test.ts"},"output":"<path>/workspace/web-ui/src/lib/state/connection.test.ts</path>\n<type>file</type>\n<content>\n1: // Connection store — the status machine behind every \"connecting\" surface.\n2: // The bug report's symptoms pin three behaviors: concurrent checks must not\n3: // race (the settings modal, a mounting view, and the 30s re-check all call\n4: // check()), a live connection must not flash 'connecting' on every\n5: // re-validation, and a reconfiguration must never be answered by an older\n6: // connection's in-flight response.\n7: \n8: import { afterEach, describe, expect, it, vi } from 'vitest'\n9: \n10: const HEALTH = JSON.stringify({ version: '1.2.3', imagePresent: true, profiles: [] })\n11: const OTHER_HEALTH = JSON.stringify({ version: '9.9.9', imagePresent: false, profiles: [] })\n12: \n13: function ok(body = HEALTH) {\n14:   return new Response(body, { status: 200, headers: { 'Content-Type': 'application/json' } })\n15: }\n16: \n17: function deferredFetch() {\n18:   const pending = new Map<string, { resolve: (r: Response) => void; reject: (e: unknown) => void }>()\n19:   const fetches: string[] = []\n20:   const flush = (url: string, r: Response) => pending.get(url)?.resolve(r)\n21:   const fail = (url: string, e: unknown) => pending.get(url)?.reject(e)\n22:   const stub = vi.fn(\n23:     (input: RequestInfo | URL) =>\n24:       new Promise<Response>((resolve, reject) => {\n25:         const url = String(input)\n26:         fetches.push(url)\n27:         pending.set(url, { resolve, reject })\n28:       }),\n29:   )\n30:   vi.stubGlobal('fetch', stub)\n31:   return { stub, fetches, flush, fail }\n32: }\n33: \n34: /** Fresh singletons — the store builds itself from localStorage on import. */\n35: async function fresh(persisted?: { baseUrl?: string; token?: string }) {\n36:   localStorage.clear()\n37:   if (persisted) localStorage.setItem('mg-control.connection', JSON.stringify(persisted))\n38:   vi.resetModules()\n39:   return await import('$lib/state/connection.svelte')\n40: }\n41: \n42: afterEach(() => {\n43:   vi.unstubAllGlobals()\n44: })\n45: \n46: describe('connection store', () => {\n47:   it('goes connecting → up and captures health', async () => {\n48:     const { connection } = await fresh()\n49:     const { flush } = deferredFetch()\n50:     const p = connection.check()\n51:     expect(connection.status).toBe('connecting')\n52:     flush('/health', ok())\n53:     expect(await p).toBe(true)\n54:     expect(connection.status).toBe('up')\n55:     expect(connection.health?.version).toBe('1.2.3')\n56:     expect(connection.lastError).toBe('')\n57:   })\n58: \n59:   it('marks down with the error when the daemon cannot be reached', async () => {\n60:     const { connection } = await fresh()\n61:     const { fail } = deferredFetch()\n62:     const p = connection.check()\n63:     fail('/health', new TypeError('Failed to fetch'))\n64:     expect(await p).toBe(false)\n65:     expect(connection.status).toBe('down')\n66:     expect(connection.lastError).toMatch(/cannot reach the daemon/)\n67:   })\n68: \n69:   it('keeps a live connection \"up\" while re-validating — no connecting flash', async () => {\n70:     const { connection } = await fresh()\n71:     const { flush } = deferredFetch()\n72:     const first = connection.check()\n73:     flush('/health', ok())\n74:     await first\n75:     expect(connection.status).toBe('up')\n76: \n77:     // the 30s re-check starts; while it is in flight the UI must stay 'up'\n78:     const p = connection.check()\n79:     expect(connection.status).toBe('up')\n80:     flush('/health', ok())\n81:     expect(await p).toBe(true)\n82:     expect(connection.status).toBe('up')\n83:   })\n84: \n85:   it('shares one in-flight check between concurrent callers', async () => {\n86:     const { connection } = await fresh()\n87:     const { stub, flush } = deferredFetch()\n88:     const a = connection.check()\n89:     const b = connection.check()\n90:     expect(stub).toHaveBeenCalledTimes(1)\n91:     flush('/health', ok())\n92:     expect(await a).toBe(true)\n93:     expect(await b).toBe(true)\n94:   })\n95: \n96:   it('never applies a stale response after set() re-points the connection', async () => {\n97:     const { connection } = await fresh({ baseUrl: '/old' })\n98:     const { flush } = deferredFetch()\n99: \n100:     const old = connection.check() // against /old/health — pending\n101:     connection.set('/api', '') // re-point while the old check is in flight\n102: \n103:     // the old daemon answers late — it must not establish anything\n104:     flush('/old/health', ok(OTHER_HEALTH))\n105:     expect(await old).toBe(false)\n106:     expect(connection.status).not.toBe('up')\n107:     expect(connection.health).toBe(null)\n108: \n109:     // the new daemon answers — that one counts\n110:     flush('/api/health', ok())\n111:     await waitForUp(connection)\n112:     expect(connection.health?.version).toBe('1.2.3')\n113:   })\n114: \n115:   it('re-establishes visibly after set(): status resets to connecting', async () => {\n116:     const { connection } = await fresh()\n117:     const { flush } = deferredFetch()\n118:     const first = connection.check()\n119:     flush('/health', ok())\n120:     await first\n121:     expect(connection.status).toBe('up')\n122: \n123:     connection.set('/api', '')\n124:     expect(connection.status).toBe('connecting')\n125:     expect(connection.health).toBe(null)\n126:     flush('/api/health', ok())\n127:     await waitForUp(connection)\n128:     expect(connection.status).toBe('up')\n129:   })\n130: \n131:   it('bumps established once per transition into up — not on re-validations', async () => {\n132:     const { connection } = await fresh()\n133:     const { stub, flush } = deferredFetch()\n134: \n135:     const first = connection.check()\n136:     flush('/health', ok())\n137:     await first\n138:     expect(connection.established).toBe(1)\n139: \n140:     // the 30s re-check succeeds — still up, no new establishment\n141:     const revalidate = connection.check()\n142:     flush('/health', ok())\n143:     await revalidate\n144:     expect(connection.established).toBe(1)\n145: \n146:     // the daemon dies and comes back — a real transition, a new bump\n147:     const died = connection.check()\n148:     flush('/health', new Response(null, { status: 503 }))\n149:     await died\n150:     expect(connection.status).toBe('down')\n151:     expect(connection.established).toBe(1)\n152: \n153:     const back = connection.check()\n154:     flush('/health', ok())\n155:     await back\n156:     expect(connection.status).toBe('up')\n157:     expect(connection.established).toBe(2)\n158:     expect(stub).toHaveBeenCalledTimes(4)\n159:   })\n160: })\n161: \n162: async function waitForUp(connection: { status: string }) {\n163:   for (let i = 0; i < 50 && connection.status !== 'up'; i++) {\n164:     await new Promise((r) => setTimeout(r, 10))\n165:   }\n166:   expect(connection.status).toBe('up')\n167: }\n\n(End of file - total 167 lines)\n</content>","metadata":{"preview":"// Connection store — the status machine behind every \"connecting\" surface.\n// The bug report's symptoms pin three behaviors: concurrent checks must not\n// race (the settings modal, a mounting view, and the 30s re-check all call\n// check()), a live connection must not flash 'connecting' on every\n// re-validation, and a reconfiguration must never be answered by an older\n// connection's in-flight response.\n\nimport { afterEach, describe, expect, it, vi } from 'vitest'\n\nconst HEALTH = JSON.stringify({ version: '1.2.3', imagePresent: true, profiles: [] })\nconst OTHER_HEALTH = JSON.stringify({ version: '9.9.9', imagePresent: false, profiles: [] })\n\nfunction ok(body = HEALTH) {\n  return new Response(body, { status: 200, headers: { 'Content-Type': 'application/json' } })\n}\n\nfunction deferredFetch() {\n  const pending = new Map<string, { resolve: (r: Response) => void; reject: (e: unknown) => void }>()\n  const fetches: string[] = []\n  const flush = (url: string, r: Response) => pending.get(url)?.resolve(r)","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/web-ui/src/lib/state/connection.test.ts","text":"// Connection store — the status machine behind every \"connecting\" surface.\n// The bug report's symptoms pin three behaviors: concurrent checks must not\n// race (the settings modal, a mounting view, and the 30s re-check all call\n// check()), a live connection must not flash 'connecting' on every\n// re-validation, and a reconfiguration must never be answered by an older\n// connection's in-flight response.\n\nimport { afterEach, describe, expect, it, vi } from 'vitest'\n\nconst HEALTH = JSON.stringify({ version: '1.2.3', imagePresent: true, profiles: [] })\nconst OTHER_HEALTH = JSON.stringify({ version: '9.9.9', imagePresent: false, profiles: [] })\n\nfunction ok(body = HEALTH) {\n  return new Response(body, { status: 200, headers: { 'Content-Type': 'application/json' } })\n}\n\nfunction deferredFetch() {\n  const pending = new Map<string, { resolve: (r: Response) => void; reject: (e: unknown) => void }>()\n  const fetches: string[] = []\n  const flush = (url: string, r: Response) => pending.get(url)?.resolve(r)\n  const fail = (url: string, e: unknown) => pending.get(url)?.reject(e)\n  const stub = vi.fn(\n    (input: RequestInfo | URL) =>\n      new Promise<Response>((resolve, reject) => {\n        const url = String(input)\n        fetches.push(url)\n        pending.set(url, { resolve, reject })\n      }),\n  )\n  vi.stubGlobal('fetch', stub)\n  return { stub, fetches, flush, fail }\n}\n\n/** Fresh singletons — the store builds itself from localStorage on import. */\nasync function fresh(persisted?: { baseUrl?: string; token?: string }) {\n  localStorage.clear()\n  if (persisted) localStorage.setItem('mg-control.connection', JSON.stringify(persisted))\n  vi.resetModules()\n  return await import('$lib/state/connection.svelte')\n}\n\nafterEach(() => {\n  vi.unstubAllGlobals()\n})\n\ndescribe('connection store', () => {\n  it('goes connecting → up and captures health', async () => {\n    const { connection } = await fresh()\n    const { flush } = deferredFetch()\n    const p = connection.check()\n    expect(connection.status).toBe('connecting')\n    flush('/health', ok())\n    expect(await p).toBe(true)\n    expect(connection.status).toBe('up')\n    expect(connection.health?.version).toBe('1.2.3')\n    expect(connection.lastError).toBe('')\n  })\n\n  it('marks down with the error when the daemon cannot be reached', async () => {\n    const { connection } = await fresh()\n    const { fail } = deferredFetch()\n    const p = connection.check()\n    fail('/health', new TypeError('Failed to fetch'))\n    expect(await p).toBe(false)\n    expect(connection.status).toBe('down')\n    expect(connection.lastError).toMatch(/cannot reach the daemon/)\n  })\n\n  it('keeps a live connection \"up\" while re-validating — no connecting flash', async () => {\n    const { connection } = await fresh()\n    const { flush } = deferredFetch()\n    const first = connection.check()\n    flush('/health', ok())\n    await first\n    expect(connection.status).toBe('up')\n\n    // the 30s re-check starts; while it is in flight the UI must stay 'up'\n    const p = connection.check()\n    expect(connection.status).toBe('up')\n    flush('/health', ok())\n    expect(await p).toBe(true)\n    expect(connection.status).toBe('up')\n  })\n\n  it('shares one in-flight check between concurrent callers', async () => {\n    const { connection } = await fresh()\n    const { stub, flush } = deferredFetch()\n    const a = connection.check()\n    const b = connection.check()\n    expect(stub).toHaveBeenCalledTimes(1)\n    flush('/health', ok())\n    expect(await a).toBe(true)\n    expect(await b).toBe(true)\n  })\n\n  it('never applies a stale response after set() re-points the connection', async () => {\n    const { connection } = await fresh({ baseUrl: '/old' })\n    const { flush } = deferredFetch()\n\n    const old = connection.check() // against /old/health — pending\n    connection.set('/api', '') // re-point while the old check is in flight\n\n    // the old daemon answers late — it must not establish anything\n    flush('/old/health', ok(OTHER_HEALTH))\n    expect(await old).toBe(false)\n    expect(connection.status).not.toBe('up')\n    expect(connection.health).toBe(null)\n\n    // the new daemon answers — that one counts\n    flush('/api/health', ok())\n    await waitForUp(connection)\n    expect(connection.health?.version).toBe('1.2.3')\n  })\n\n  it('re-establishes visibly after set(): status resets to connecting', async () => {\n    const { connection } = await fresh()\n    const { flush } = deferredFetch()\n    const first = connection.check()\n    flush('/health', ok())\n    await first\n    expect(connection.status).toBe('up')\n\n    connection.set('/api', '')\n    expect(connection.status).toBe('connecting')\n    expect(connection.health).toBe(null)\n    flush('/api/health', ok())\n    await waitForUp(connection)\n    expect(connection.status).toBe('up')\n  })\n\n  it('bumps established once per transition into up — not on re-validations', async () => {\n    const { connection } = await fresh()\n    const { stub, flush } = deferredFetch()\n\n    const first = connection.check()\n    flush('/health', ok())\n    await first\n    expect(connection.established).toBe(1)\n\n    // the 30s re-check succeeds — still up, no new establishment\n    const revalidate = connection.check()\n    flush('/health', ok())\n    await revalidate\n    expect(connection.established).toBe(1)\n\n    // the daemon dies and comes back — a real transition, a new bump\n    const died = connection.check()\n    flush('/health', new Response(null, { status: 503 }))\n    await died\n    expect(connection.status).toBe('down')\n    expect(connection.established).toBe(1)\n\n    const back = connection.check()\n    flush('/health', ok())\n    await back\n    expect(connection.status).toBe('up')\n    expect(connection.established).toBe(2)\n    expect(stub).toHaveBeenCalledTimes(4)\n  })\n})\n\nasync function waitForUp(connection: { status: string }) {\n  for (let i = 0; i < 50 && connection.status !== 'up'; i++) {\n    await new Promise((r) => setTimeout(r, 10))\n  }\n  expect(connection.status).toBe('up')\n}","lineStart":1,"lineEnd":167,"totalLines":167,"truncated":false}},"title":"web-ui/src/lib/state/connection.test.ts","time":{"start":1787995877694,"end":1787995877705}},"id":"prt_04cdbf0bc001eBlhdkBmEwLNfT","sessionID":"ses_fb3250779ffe153rxsL511kCsf","messageID":"msg_04cdb3a0d001X00TC27fH3nJ2h"}}
