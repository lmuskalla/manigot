projects once an empty registry has loaded — no reload loop  368ms\n\n Test Files  12 passed (12)\n      Tests  87 passed (87)\n   Start at  09:31:22\n   Duration  2.53s (transform 1.39s, setup 6.59s, collect 1.05s, tests 2.77s, environment 4.60s, prepare 1.15s)\n\n","exit":0,"truncated":false},"title":"npm test 2>&1 | tail -60","time":{"start":1787995885472,"end":1787995885476}},"id":"prt_04cdc0318001EM5QcQmyzM40U9","sessionID":"ses_fb3250779ffe153rxsL511kCsf","messageID":"msg_04cdbfe91001DT1FehACCd5ESW"}}
