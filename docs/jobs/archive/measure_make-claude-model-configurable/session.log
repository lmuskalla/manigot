{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NxC2BP1M12QPbNaaXUyXL2","type":"tool_result","content":"1\tpackage main\n2\t\n3\timport (\n4\t\t\"bufio\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"flag\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"path/filepath\"\n12\t\t\"strings\"\n13\t\n14\t\t\"github.com/lmuskalla/manigot/internal/cli\"\n15\t\t\"github.com/lmuskalla/manigot/internal/config\"\n16\t)\n17\t\n18\t// sepLine is the 68-char box-drawing separator setup.sh printed above each\n19\t// profile's wizard block.\n20\tconst sepLine = \"────────────────────────────────────────────────────────────────────\"\n21\t\n22\tconst setupHelp = `mg setup [profile] [--check]\n23\t\n24\tConfigures credentials for manigot's subscription profiles into manigot/.env:\n25\t  claude-pro        Claude Code, billed to your Claude Pro/Max subscription\n26\t  zai               OpenCode, billed to your Z.AI Coding Plan\n27\t  opencode-go       OpenCode, billed to the OpenCode Go subscription\n28\t  opencode-zen      OpenCode, billed to OpenCode Zen (DeepSeek V4 Flash)\n29\t  opencode-zen-free OpenCode, billed to OpenCode Zen (DeepSeek V4 Flash Free)\n30\t\n31\tWith no profile, the wizard walks through every profile — the built-ins above\n32\tplus any user-defined ones you've added (see 'mg profiles add') — and the\n33\toptional ntfy push-notification settings (NTFY_URL/NTFY_TOPIC/NTFY_TOKEN) for\n34\tmg jdi. --check reports which profiles are ready without prompting. Values are\n35\twritten to the same .env mg reads; nothing is sent anywhere.\n36\t`\n37\t\n38\t// runSetup implements `mg setup` — the port of scripts/setup.sh with identical\n39\t// output wording. r is the interactive input (used only when tty).\n40\tfunc runSetup(args []string, r io.Reader, stdout, stderr io.Writer, tty bool) int {\n41\t\t// --check is a real flag; a profile name (or \"help\") is a positional.\n42\t\t// The flags are extracted first (splitFlags) because the tests pin\n43\t\t// \"zai --check\" — the profile before the flag — which Go's flag package\n44\t\t// would otherwise stop at.\n45\t\tflagArgs, rest := splitFlags(args, nil, map[string]bool{\"--check\": true, \"-h\": true, \"--help\": true})\n46\t\n47\t\tfs := flag.NewFlagSet(\"mg setup\", flag.ContinueOnError)\n48\t\tfs.SetOutput(io.Discard)\n49\t\tfs.Usage = func() { fmt.Fprint(stdout, setupHelp) }\n50\t\tcheck := fs.Bool(\"check\", false, \"\")\n51\t\tif err := fs.Parse(flagArgs); err != nil {\n52\t\t\tif errors.Is(err, flag.ErrHelp) {\n53\t\t\t\treturn 0 // usage already printed to stdout\n54\t\t\t}\n55\t\t\t// An unknown flag (e.g. \"--bogus\"): the script's loop reported it the\n56\t\t\t// same way as any other unknown argument.\n57\t\t\tfmt.Fprintln(stderr, flagParseError(err))\n58\t\t\tfmt.Fprintln(stderr, \"Usage: mg setup [<profile>] [--check]\")\n59\t\t\treturn 1\n60\t\t}\n61\t\n62\t\t// The positionals: profile names, or the bare-word \"help\" alias for -h.\n63\t\ttarget := \"\"\n64\t\tprofileArgs := rest\n65\t\tif len(profileArgs) == 1 && profileArgs[0] == \"help\" {\n66\t\t\tfmt.Fprint(stdout, setupHelp)\n67\t\t\treturn 0\n68\t\t}\n69\t\tfor _, arg := range profileArgs {\n70\t\t\tif _, ok := config.ProfileByID(arg); ok {\n71\t\t\t\tif target != \"\" {\n72\t\t\t\t\tfmt.Fprintln(stderr, \"Error: give a single profile, not several.\")\n73\t\t\t\t\treturn 1\n74\t\t\t\t}\n75\t\t\t\ttarget = arg\n76\t\t\t} else {\n77\t\t\t\tfmt.Fprintf(stderr, \"Error: unknown argument '%s'.\\n\", arg)\n78\t\t\t\tfmt.Fprintln(stderr, \"Usage: mg setup [<profile>] [--check]\")\n79\t\t\t\treturn 1\n80\t\t\t}\n81\t\t}\n82\t\n83\t\tif *check {\n84\t\t\tif target != \"\" {\n85\t\t\t\tcheckProfile(target, stdout)\n86\t\t\t} else {\n87\t\t\t\t// Data-driven: check every profile (built-in + user-defined) in\n88\t\t\t\t// canonical order.\n89\t\t\t\tfor _, p := range config.Profiles() {\n90\t\t\t\t\tcheckProfile(p.ID, stdout)\n91\t\t\t\t}\n92\t\t\t}\n93\t\t\treturn 0\n94\t\t}\n95\t\n96\t\tif !tty {\n97\t\t\tfmt.Fprintln(stderr, \"mg setup: interactive setup needs a terminal.\")\n98\t\t\tfmt.Fprintln(stderr, \"Use 'mg setup --check' for a non-interactive status report.\")\n99\t\t\treturn 1\n100\t\t}\n101\t\n102\t\t// One buffered reader for the whole wizard: each prompt reads a line, and a\n103\t\t// fresh bufio.Reader per prompt would lose whatever the previous one\n104\t\t// buffered past its newline.\n105\t\tbr := bufio.NewReader(r)\n106\t\n107\t\tif target != \"\" {\n108\t\t\tif p, ok := config.ProfileByID(target); ok {\n109\t\t\t\tsetupProfile(p, br, stdout)\n110\t\t\t}\n111\t\t} else {\n112\t\t\t// Data-driven: walk every profile (built-in + user-defined), then the\n113\t\t\t// optional ntfy block.\n114\t\t\tfor _, p := range config.Profiles() {\n115\t\t\t\tsetupProfile(p, br, stdout)\n116\t\t\t}\n117\t\t\tsetupNtfy(br, stdout)\n118\t\t}\n119\t\n120\t\tfmt.Fprintln(stdout, \"\")\n121\t\tfmt.Fprintln(stdout, \"  Done. Switch the default with: mg profiles <name>\")\n122\t\tfmt.Fprintln(stdout, \"  or start a one-off session with:  mg --profile <name>\")\n123\t\treturn 0\n124\t}\n125\t\n126\t// checkProfile prints the `--check` status line for one profile: \"✓ ready\" or\n127\t// \"✗ missing <keys>\" with the same formatting setup.sh used.\n128\tfunc checkProfile(p string, w io.Writer) {\n129\t\tprof, ok := config.ProfileByID(p)\n130\t\tif !ok {\n131\t\t\tfmt.Fprintf(w, \"  \\u2717 %-12s unknown profile\\n\", p)\n132\t\t\treturn\n133\t\t}\n134\t\tvar missing []string\n135\t\tfor _, k := range prof.AuthKeys {\n136\t\t\tif config.EnvValue(k) == \"\" {\n137\t\t\t\tmissing = append(missing, k)\n138\t\t\t}\n139\t\t}\n140\t\tif len(missing) == 0 {\n141\t\t\tfmt.Fprintf(w, \"  \\u2713 %-12s ready\\n\", p)\n142\t\t} else {\n143\t\t\tfmt.Fprintf(w, \"  \\u2717 %-12s missing: %s   (fix with: mg setup %s)\\n\", p, strings.Join(missing, \" \"), p)\n144\t\t}\n145\t}\n146\t\n147\t// promptSecret asks for a secret and upserts it into .env when the user types\n148\t// a value; Enter keeps the current value, and a bare prompt's empty answer\n149\t// prints the same \"(skipped — NAME not set)\" note setup.sh did.\n150\tfunc promptSecret(label, name string, r io.Reader, w io.Writer) {\n151\t\tcurrent := config.EnvValue(name)\n152\t\tif current != \"\" {\n153\t\t\tval, err := cli.PromptSecret(label, current, r, w)\n154\t\t\tif err != nil {\n155\t\t\t\treturn\n156\t\t\t}\n157\t\t\tif val != \"\" {\n158\t\t\t\t_ = config.UpsertEnv(name, val)\n159\t\t\t}\n160\t\t\treturn\n161\t\t}\n162\t\tval, err := cli.PromptSecret(label, \"\", r, w)\n163\t\tif err != nil {\n164\t\t\treturn\n165\t\t}\n166\t\tif val != \"\" {\n167\t\t\t_ = config.UpsertEnv(name, val)\n168\t\t} else {\n169\t\t\tfmt.Fprintf(w, \"  (skipped — %s not set)\\n\", name)\n170\t\t}\n171\t}\n172\t\n173\t// promptValue asks for a non-secret value and upserts the effective result\n174\t// (typed > current > default) into .env — matching setup.sh's prompt_value.\n175\tfunc promptValue(label, name, def string, r io.Reader, w io.Writer) {\n176\t\tval, err := cli.PromptValue(label, config.EnvValue(name), def, r, w)\n177\t\tif err != nil {\n178\t\t\treturn\n179\t\t}\n180\t\tif val != \"\" {\n181\t\t\t_ = config.UpsertEnv(name, val)\n182\t\t}\n183\t}\n184\t\n185\t// claudeAccountFromJSON reads accountUuid/emailAddress/organizationUuid from\n186\t// ~/.claude.json (the host's Claude Code config), the Go replacement for\n187\t// setup.sh's python3 heredoc. ok is false when the file is missing, unreadable,\n188\t// or lacks a complete oauthAccount block.\n189\tfunc claudeAccountFromJSON() (uuid, email, org string, ok bool) {\n190\t\tcfg := filepath.Join(os.Getenv(\"HOME\"), \".claude.json\")\n191\t\tdata, err := os.ReadFile(cfg)\n192\t\tif err != nil {\n193\t\t\treturn \"\", \"\", \"\", false\n194\t\t}\n195\t\tvar doc struct {\n196\t\t\tOAuthAccount *struct {\n197\t\t\t\tAccountUUID      string `json:\"accountUuid\"`\n198\t\t\t\tEmailAddress     string `json:\"emailAddress\"`\n199\t\t\t\tOrganizationUUID string `json:\"organizationUuid\"`\n200\t\t\t} `json:\"oauthAccount\"`\n201\t\t}\n202\t\tif err := json.Unmarshal(data, &doc); err != nil || doc.OAuthAccount == nil {\n203\t\t\treturn \"\", \"\", \"\", false\n204\t\t}\n205\t\ta := doc.OAuthAccount\n206\t\treturn a.AccountUUID, a.EmailAddress, a.OrganizationUUID,\n207\t\t\ta.AccountUUID != \"\" && a.EmailAddress != \"\" && a.OrganizationUUID != \"\"\n208\t}\n209\t\n210\tfunc setupClaudePro(r io.Reader, w io.Writer) {\n211\t\tfmt.Fprintln(w, sepLine)\n212\t\tfmt.Fprintln(w, \"  claude-pro — Claude Code, billed to your Claude Pro/Max subscription\")\n213\t\tfmt.Fprintln(w, sepLine)\n214\t\tif have(\"CLAUDE_CODE_OAUTH_TOKEN\") && have(\"CLAUDE_ACCOUNT_UUID\") && have(\"CLAUDE_EMAIL\") && have(\"CLAUDE_ORG_UUID\") {\n215\t\t\tfmt.Fprintf(w, \"  ✓ Already configured (token %s, %s).\\n\", cli.Mask(config.EnvValue(\"CLAUDE_CODE_OAUTH_TOKEN\")), config.EnvValue(\"CLAUDE_EMAIL\"))\n216\t\t\treturn\n217\t\t}\n218\t\tfmt.Fprintln(w, \"  Claude Code runs with your subscription's OAuth credentials. You need\")\n219\t\tfmt.Fprintln(w, \"  a token plus three account details.\")\n220\t\n221\t\tif !have(\"CLAUDE_CODE_OAUTH_TOKEN\") {\n222\t\t\tfmt.Fprintln(w, \"\")\n223\t\t\tfmt.Fprintln(w, \"  Step 1 — the OAuth token. On your HOST, with Claude Code installed\")\n224\t\t\tfmt.Fprintln(w, \"  locally, run:\")\n225\t\t\tfmt.Fprintln(w, \"      claude setup-token\")\n226\t\t\tfmt.Fprintln(w, \"  Paste the 'sk-ant-oat01-…' token it prints below.\")\n227\t\t\tpromptSecret(\"  CLAUDE_CODE_OAUTH_TOKEN\", \"CLAUDE_CODE_OAUTH_TOKEN\", r, w)\n228\t\t} else {\n229\t\t\tfmt.Fprintf(w, \"  ✓ CLAUDE_CODE_OAUTH_TOKEN already set (%s).\\n\", cli.Mask(config.EnvValue(\"CLAUDE_CODE_OAUTH_TOKEN\")))\n230\t\t}\n231\t\n232\t\tif !(have(\"CLAUDE_ACCOUNT_UUID\") && have(\"CLAUDE_EMAIL\") && have(\"CLAUDE_ORG_UUID\")) {\n233\t\t\tfmt.Fprintln(w, \"\")\n234\t\t\tfmt.Fprintln(w, \"  Step 2 — account details (CLAUDE_ACCOUNT_UUID, CLAUDE_EMAIL,\")\n235\t\t\tfmt.Fprintln(w, \"  CLAUDE_ORG_UUID).\")\n236\t\t\tif uuid, email, org, ok := claudeAccountFromJSON(); ok {\n237\t\t\t\tfmt.Fprintln(w, \"  Found them in ~/.claude.json on this host — applying automatically.\")\n238\t\t\t\t_ = config.UpsertEnv(\"CLAUDE_ACCOUNT_UUID\", uuid)\n239\t\t\t\t_ = config.UpsertEnv(\"CLAUDE_EMAIL\", email)\n240\t\t\t\t_ = config.UpsertEnv(\"CLAUDE_ORG_UUID\", org)\n241\t\t\t\treturn\n242\t\t\t}\n243\t\t\tfmt.Fprintln(w, \"  Could not read them from ~/.claude.json here. On the host where\")\n244\t\t\tfmt.Fprintln(w, \"  Claude Code is logged in, extract them with:\")\n245\t\t\tfmt.Fprintln(w, `      cat ~/.claude.json | python3 -c \"import json,sys; d=json.load(sys.stdin); print(json.dumps(d.get('oauthAccount'), indent=2))\"`)\n246\t\t\tfmt.Fprintln(w, \"\")\n247\t\t\tpromptValue(\"  CLAUDE_ACCOUNT_UUID\", \"CLAUDE_ACCOUNT_UUID\", \"\", r, w)\n248\t\t\tpromptValue(\"  CLAUDE_EMAIL\", \"CLAUDE_EMAIL\", \"\", r, w)\n249\t\t\tpromptValue(\"  CLAUDE_ORG_UUID\", \"CLAUDE_ORG_UUID\", \"\", r, w)\n250\t\t}\n251\t}\n252\t\n253\t// setupProfile runs the setup wizard block for one profile, dispatching on its\n254\t// tool: the claude-code flow (the bespoke OAuth account wizard) and the\n255\t// data-driven opencode flow (setupOpenCodeProfile + setupSpecs). Called for\n256\t// every profile in config.Profiles(), so a user-defined profile gets a wizard\n257\t// too — a generic spec when its id has no bespoke entry in setupSpecs.\n258\tfunc setupProfile(p config.Profile, br *bufio.Reader, w io.Writer) {\n259\t\tif p.Tool == config.ToolClaudeCode {\n260\t\t\tsetupClaudePro(br, w)\n261\t\t\treturn\n262\t\t}\n263\t\tspec, ok := setupSpecs[p.ID]\n264\t\tif !ok {\n265\t\t\tspec = genericOpenCodeSpec(p)\n266\t\t}\n267\t\tsetupOpenCodeProfile(p, spec, br, w)\n268\t}\n269\t\n270\t// profileSetupSpec carries the prose a profile's opencode wizard block prints.\n271\t// The built-in opencode profiles each have bespoke billing instructions; a\n272\t// user-defined profile (no entry in setupSpecs) falls back to the generic\n273\t// spec built by genericOpenCodeSpec.\n274\ttype profileSetupSpec struct {\n275\t\ttitle     string   // the line under sepLine\n276\t\tintro     []string // paragraphs printed before the credential prompt\n277\t\tmodelHint []string // extra lines printed before the model prompt\n278\t}\n279\t\n280\t// setupSpecs holds the per-profile wizard prose for the built-in opencode\n281\t// profiles, so the data-driven setupOpenCodeProfile reproduces their exact\n282\t// wording. claude-pro is handled by setupClaudePro (the claude-tool flow).\n283\tvar setupSpecs = map[string]profileSetupSpec{\n284\t\tconfig.ProfileZAI: {\n285\t\t\ttitle: \"  zai — OpenCode, billed to your Z.AI Coding Plan\",\n286\t\t\tintro: []string{\n287\t\t\t\t\"  OpenCode authenticates to Z.AI with an API key from your Z.AI\",\n288\t\t\t\t\"  Coding Plan. Get one from the Z.AI / BigModel console\",\n289\t\t\t\t\"  (https://www.bigmodel.cn), then paste it below.\",\n290\t\t\t},\n291\t\t},\n292\t\tconfig.ProfileOpenCodeGo: {\n293\t\t\ttitle: \"  opencode-go — OpenCode, billed to the OpenCode Go subscription\",\n294\t\t\tintro: []string{\n295\t\t\t\t\"  OpenCode Go uses your OpenCode API key — the same key you get at\",\n296\t\t\t\t\"  https://opencode.ai/auth, billed against your Go subscription.\",\n297\t\t\t\t\"\",\n298\t\t\t\t\"  1. Open https://opencode.ai/auth and sign in\",\n299\t\t\t\t\"  2. Subscribe to OpenCode Go (if you haven't already)\",\n300\t\t\t\t\"  3. Copy your API key and paste it below\",\n301\t\t\t},\n302\t\t\tmodelHint: []string{\n303\t\t\t\t\"  Go model ids use the opencode-go/ prefix (e.g. opencode-go/deepseek-v4-flash).\",\n304\t\t\t},\n305\t\t},\n306\t\tconfig.ProfileOpenCodeZen: {\n307\t\t\ttitle: \"  opencode-zen — OpenCode, billed to OpenCode Zen (DeepSeek V4 Flash)\",\n308\t\t\tintro: []string{\n309\t\t\t\t\"  OpenCode Zen uses your OpenCode API key — the same key you get at\",\n310\t\t\t\t\"  https://opencode.ai/auth. This DeepSeek V4 Flash model is billed\",\n311\t\t\t\t\"  pay-as-you-go against your Zen account credits — add billing at\",\n312\t\t\t\t\"  https://opencode.ai/auth if you haven't. For the no-cost variant, use\",\n313\t\t\t\t\"  the opencode-zen-free profile instead.\",\n314\t\t\t\t\"\",\n315\t\t\t\t\"  1. Open https://opencode.ai/auth and sign in\",\n316\t\t\t\t\"  2. Copy your API key and paste it below\",\n317\t\t\t},\n318\t\t\tmodelHint: []string{\n319\t\t\t\t\"  Zen's (billed) DeepSeek V4 Flash model is opencode/deepseek-v4-flash.\",\n320\t\t\t},\n321\t\t},\n322\t\tconfig.ProfileOpenCodeZenFree: {\n323\t\t\ttitle: \"  opencode-zen-free — OpenCode, billed to OpenCode Zen (DeepSeek V4 Flash Free)\",\n324\t\t\tintro: []string{\n325\t\t\t\t\"  OpenCode Zen uses your OpenCode API key — the same key you get at\",\n326\t\t\t\t\"  https://opencode.ai/auth. The free DeepSeek V4 Flash model costs\",\n327\t\t\t\t\"  no credits, so this profile works with a key alone.\",\n328\t\t\t\t\"\",\n329\t\t\t\t\"  1. Open https://opencode.ai/auth and sign in\",\n330\t\t\t\t\"  2. Copy your API key and paste it below\",\n331\t\t\t},\n332\t\t\tmodelHint: []string{\n333\t\t\t\t\"  Zen's free DeepSeek V4 Flash model is opencode/deepseek-v4-flash-free.\",\n334\t\t\t},\n335\t\t},\n336\t}\n337\t\n338\t// genericOpenCodeSpec builds a wizard spec for a user-defined opencode profile\n339\t// that has no bespoke entry in setupSpecs.\n340\tfunc genericOpenCodeSpec(p config.Profile) profileSetupSpec {\n341\t\tkey := \"the profile's API key\"\n342\t\tif len(p.AuthKeys) > 0 {\n343\t\t\tkey = p.AuthKeys[0]\n344\t\t}\n345\t\treturn profileSetupSpec{\n346\t\t\ttitle: fmt.Sprintf(\"  %s — OpenCode profile billed via %s\", p.ID, key),\n347\t\t\tintro: []string{\n348\t\t\t\tfmt.Sprintf(\"  This user-defined profile bills against the %s credential.\", key),\n349\t\t\t\t\"  Add it to manigot/.env (or inherit it from your environment) to\",\n350\t\t\t\t\"  make the profile ready.\",\n351\t\t\t},\n352\t\t}\n353\t}\n354\t\n355\t// setupOpenCodeProfile is the data-driven opencode wizard block: the key, model\n356\t// env key, and model default all come from the profile; the surrounding prose\n357\t// from its spec. It reproduces the built-in opencode wizards byte-for-byte via\n358\t// setupSpecs.\n359\tfunc setupOpenCodeProfile(p config.Profile, spec profileSetupSpec, br *bufio.Reader, w io.Writer) {\n360\t\tfmt.Fprintln(w, sepLine)\n361\t\tfmt.Fprintln(w, spec.title)\n362\t\tfmt.Fprintln(w, sepLine)\n363\t\tkey := \"\"\n364\t\tif len(p.AuthKeys) > 0 {\n365\t\t\tkey = p.AuthKeys[0]\n366\t\t}\n367\t\tif key != \"\" && have(key) {\n368\t\t\tfmt.Fprintf(w, \"  ✓ Already configured (%s %s).\\n\", key, cli.Mask(config.EnvValue(key)))\n369\t\t} else {\n370\t\t\tfor _, line := range spec.intro {\n371\t\t\t\tfmt.Fprintln(w, line)\n372\t\t\t}\n373\t\t\tif key != \"\" {\n374\t\t\t\tpromptSecret(\"  \"+key, key, br, w)\n375\t\t\t}\n376\t\t}\n377\t\tfmt.Fprintln(w, \"\")\n378\t\tfmt.Fprintln(w, \"  Optional — the model this profile defaults to, as provider/model.\")\n379\t\tfor _, line := range spec.modelHint {\n380\t\t\tfmt.Fprintln(w, line)\n381\t\t}\n382\t\tpromptValue(\"  \"+p.ModelEnv, p.ModelEnv, p.ModelDefault, br, w)\n383\t}\n384\t\n385\t// setupNtfy is the optional ntfy block of the mg setup wizard: it prompts\n386\t// the three NTFY_* keys into manigot/.env so push notifications for mg jdi\n387\t// are discoverable without hand-editing the file. Unlike the profile blocks\n388\t// it is not a subscription profile, so --check does not cover it (its check\n389\t// shape is profile-shaped). Opt-in: leaving NTFY_TOPIC empty keeps\n390\t// notifications off, which is the default.\n391\tfunc setupNtfy(r io.Reader, w io.Writer) {\n392\t\tfmt.Fprintln(w, sepLine)\n393\t\tfmt.Fprintln(w, \"  ntfy — push notifications for mg jdi (optional)\")\n394\t\tfmt.Fprintln(w, sepLine)\n395\t\tif have(\"NTFY_TOPIC\") {\n396\t\t\tfmt.Fprintf(w, \"  ✓ Already configured (NTFY_TOPIC %s).\\n\", cli.Mask(config.EnvValue(\"NTFY_TOPIC\")))\n397\t\t\treturn\n398\t\t}\n399\t\tfmt.Fprintln(w, \"  mg jdi can push a notification to your phone when a run stops\")\n400\t\tfmt.Fprintln(w, \"  or when it finds a previous run crashed. Leave NTFY_TOPIC empty\")\n401\t\tfmt.Fprintln(w, \"  to keep notifications off.\")\n402\t\tpromptValue(\"  NTFY_URL\", \"NTFY_URL\", \"https://ntfy.sh\", r, w)\n403\t\tpromptValue(\"  NTFY_TOPIC\", \"NTFY_TOPIC\", \"\", r, w)\n404\t\tpromptSecret(\"  NTFY_TOKEN\", \"NTFY_TOKEN\", r, w)\n405\t}\n406\t\n407\t// have reports whether the effective value of key (process env + .env) is\n408\t// non-empty — the Go form of setup.sh's have() helper.\n409\tfunc have(key string) bool {\n410\t\treturn config.EnvValue(key) != \"\"\n411\t}\n412\t"}]},"parent_tool_use_id":null,"session_id":"0ad41780-e2e7-4ebf-861d-9c61d66ababf","uuid":"6c964eef-1480-4a8e-8018-e84c0e17aa01","timestamp":"2026-08-29T08:59:48.272Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/cmd/mg/setup.go","content":"package main\n\nimport (\n\t\"bufio\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/cli\"\n\t\"github.com/lmuskalla/manigot/internal/config\"\n)\n\n// sepLine is the 68-char box-drawing separator setup.sh printed above each\n// profile's wizard block.\nconst sepLine = \"────────────────────────────────────────────────────────────────────\"\n\nconst setupHelp = `mg setup [profile] [--check]\n\nConfigures credentials for manigot's subscription profiles into manigot/.env:\n  claude-pro        Claude Code, billed to your Claude Pro/Max subscription\n  zai               OpenCode, billed to your Z.AI Coding Plan\n  opencode-go       OpenCode, billed to the OpenCode Go subscription\n  opencode-zen      OpenCode, billed to OpenCode Zen (DeepSeek V4 Flash)\n  opencode-zen-free OpenCode, billed to OpenCode Zen (DeepSeek V4 Flash Free)\n\nWith no profile, the wizard walks through every profile — the built-ins above\nplus any user-defined ones you've added (see 'mg profiles add') — and the\noptional ntfy push-notification settings (NTFY_URL/NTFY_TOPIC/NTFY_TOKEN) for\nmg jdi. --check reports which profiles are ready without prompting. Values are\nwritten to the same .env mg reads; nothing is sent anywhere.\n`\n\n// runSetup implements `mg setup` — the port of scripts/setup.sh with identical\n// output wording. r is the interactive input (used only when tty).\nfunc runSetup(args []string, r io.Reader, stdout, stderr io.Writer, tty bool) int {\n\t// --check is a real flag; a profile name (or \"help\") is a positional.\n\t// The flags are extracted first (splitFlags) because the tests pin\n\t// \"zai --check\" — the profile before the flag — which Go's flag package\n\t// would otherwise stop at.\n\tflagArgs, rest := splitFlags(args, nil, map[string]bool{\"--check\": true, \"-h\": true, \"--help\": true})\n\n\tfs := flag.NewFlagSet(\"mg setup\", flag.ContinueOnError)\n\tfs.SetOutput(io.Discard)\n\tfs.Usage = func() { fmt.Fprint(stdout, setupHelp) }\n\tcheck := fs.Bool(\"check\", false, \"\")\n\tif err := fs.Parse(flagArgs); err != nil {\n\t\tif errors.Is(err, flag.ErrHelp) {\n\t\t\treturn 0 // usage already printed to stdout\n\t\t}\n\t\t// An unknown flag (e.g. \"--bogus\"): the script's loop reported it the\n\t\t// same way as any other unknown argument.\n\t\tfmt.Fprintln(stderr, flagParseError(err))\n\t\tfmt.Fprintln(stderr, \"Usage: mg setup [<profile>] [--check]\")\n\t\treturn 1\n\t}\n\n\t// The positionals: profile names, or the bare-word \"help\" alias for -h.\n\ttarget := \"\"\n\tprofileArgs := rest\n\tif len(profileArgs) == 1 && profileArgs[0] == \"help\" {\n\t\tfmt.Fprint(stdout, setupHelp)\n\t\treturn 0\n\t}\n\tfor _, arg := range profileArgs {\n\t\tif _, ok := config.ProfileByID(arg); ok {\n\t\t\tif target != \"\" {\n\t\t\t\tfmt.Fprintln(stderr, \"Error: give a single profile, not several.\")\n\t\t\t\treturn 1\n\t\t\t}\n\t\t\ttarget = arg\n\t\t} else {\n\t\t\tfmt.Fprintf(stderr, \"Error: unknown argument '%s'.\\n\", arg)\n\t\t\tfmt.Fprintln(stderr, \"Usage: mg setup [<profile>] [--check]\")\n\t\t\treturn 1\n\t\t}\n\t}\n\n\tif *check {\n\t\tif target != \"\" {\n\t\t\tcheckProfile(target, stdout)\n\t\t} else {\n\t\t\t// Data-driven: check every profile (built-in + user-defined) in\n\t\t\t// canonical order.\n\t\t\tfor _, p := range config.Profiles() {\n\t\t\t\tcheckProfile(p.ID, stdout)\n\t\t\t}\n\t\t}\n\t\treturn 0\n\t}\n\n\tif !tty {\n\t\tfmt.Fprintln(stderr, \"mg setup: interactive setup needs a terminal.\")\n\t\tfmt.Fprintln(stderr, \"Use 'mg setup --check' for a non-interactive status report.\")\n\t\treturn 1\n\t}\n\n\t// One buffered reader for the whole wizard: each prompt reads a line, and a\n\t// fresh bufio.Reader per prompt would lose whatever the previous one\n\t// buffered past its newline.\n\tbr := bufio.NewReader(r)\n\n\tif target != \"\" {\n\t\tif p, ok := config.ProfileByID(target); ok {\n\t\t\tsetupProfile(p, br, stdout)\n\t\t}\n\t} else {\n\t\t// Data-driven: walk every profile (built-in + user-defined), then the\n\t\t// optional ntfy block.\n\t\tfor _, p := range config.Profiles() {\n\t\t\tsetupProfile(p, br, stdout)\n\t\t}\n\t\tsetupNtfy(br, stdout)\n\t}\n\n\tfmt.Fprintln(stdout, \"\")\n\tfmt.Fprintln(stdout, \"  Done. Switch the default with: mg profiles <name>\")\n\tfmt.Fprintln(stdout, \"  or start a one-off session with:  mg --profile <name>\")\n\treturn 0\n}\n\n// checkProfile prints the `--check` status line for one profile: \"✓ ready\" or\n// \"✗ missing <keys>\" with the same formatting setup.sh used.\nfunc checkProfile(p string, w io.Writer) {\n\tprof, ok := config.ProfileByID(p)\n\tif !ok {\n\t\tfmt.Fprintf(w, \"  \\u2717 %-12s unknown profile\\n\", p)\n\t\treturn\n\t}\n\tvar missing []string\n\tfor _, k := range prof.AuthKeys {\n\t\tif config.EnvValue(k) == \"\" {\n\t\t\tmissing = append(missing, k)\n\t\t}\n\t}\n\tif len(missing) == 0 {\n\t\tfmt.Fprintf(w, \"  \\u2713 %-12s ready\\n\", p)\n\t} else {\n\t\tfmt.Fprintf(w, \"  \\u2717 %-12s missing: %s   (fix with: mg setup %s)\\n\", p, strings.Join(missing, \" \"), p)\n\t}\n}\n\n// promptSecret asks for a secret and upserts it into .env when the user types\n// a value; Enter keeps the current value, and a bare prompt's empty answer\n// prints the same \"(skipped — NAME not set)\" note setup.sh did.\nfunc promptSecret(label, name string, r io.Reader, w io.Writer) {\n\tcurrent := config.EnvValue(name)\n\tif current != \"\" {\n\t\tval, err := cli.PromptSecret(label, current, r, w)\n\t\tif err != nil {\n\t\t\treturn\n\t\t}\n\t\tif val != \"\" {\n\t\t\t_ = config.UpsertEnv(name, val)\n\t\t}\n\t\treturn\n\t}\n\tval, err := cli.PromptSecret(label, \"\", r, w)\n\tif err != nil {\n\t\treturn\n\t}\n\tif val != \"\" {\n\t\t_ = config.UpsertEnv(name, val)\n\t} else {\n\t\tfmt.Fprintf(w, \"  (skipped — %s not set)\\n\", name)\n\t}\n}\n\n// promptValue asks for a non-secret value and upserts the effective result\n// (typed > current > default) into .env — matching setup.sh's prompt_value.\nfunc promptValue(label, name, def string, r io.Reader, w io.Writer) {\n\tval, err := cli.PromptValue(label, config.EnvValue(name), def, r, w)\n\tif err != nil {\n\t\treturn\n\t}\n\tif val != \"\" {\n\t\t_ = config.UpsertEnv(name, val)\n\t}\n}\n\n// claudeAccountFromJSON reads accountUuid/emailAddress/organizationUuid from\n// ~/.claude.json (the host's Claude Code config), the Go replacement for\n// setup.sh's python3 heredoc. ok is false when the file is missing, unreadable,\n// or lacks a complete oauthAccount block.\nfunc claudeAccountFromJSON() (uuid, email, org string, ok bool) {\n\tcfg := filepath.Join(os.Getenv(\"HOME\"), \".claude.json\")\n\tdata, err := os.ReadFile(cfg)\n\tif err != nil {\n\t\treturn \"\", \"\", \"\", false\n\t}\n\tvar doc struct {\n\t\tOAuthAccount *struct {\n\t\t\tAccountUUID      string `json:\"accountUuid\"`\n\t\t\tEmailAddress     string `json:\"emailAddress\"`\n\t\t\tOrganizationUUID string `json:\"organizationUuid\"`\n\t\t} `json:\"oauthAccount\"`\n\t}\n\tif err := json.Unmarshal(data, &doc); err != nil || doc.OAuthAccount == nil {\n\t\treturn \"\", \"\", \"\", false\n\t}\n\ta := doc.OAuthAccount\n\treturn a.AccountUUID, a.EmailAddress, a.OrganizationUUID,\n\t\ta.AccountUUID != \"\" && a.EmailAddress != \"\" && a.OrganizationUUID != \"\"\n}\n\nfunc setupClaudePro(r io.Reader, w io.Writer) {\n\tfmt.Fprintln(w, sepLine)\n\tfmt.Fprintln(w, \"  claude-pro — Claude Code, billed to your Claude Pro/Max subscription\")\n\tfmt.Fprintln(w, sepLine)\n\tif have(\"CLAUDE_CODE_OAUTH_TOKEN\") && have(\"CLAUDE_ACCOUNT_UUID\") && have(\"CLAUDE_EMAIL\") && have(\"CLAUDE_ORG_UUID\") {\n\t\tfmt.Fprintf(w, \"  ✓ Already configured (token %s, %s).\\n\", cli.Mask(config.EnvValue(\"CLAUDE_CODE_OAUTH_TOKEN\")), config.EnvValue(\"CLAUDE_EMAIL\"))\n\t\treturn\n\t}\n\tfmt.Fprintln(w, \"  Claude Code runs with your subscription's OAuth credentials. You need\")\n\tfmt.Fprintln(w, \"  a token plus three account details.\")\n\n\tif !have(\"CLAUDE_CODE_OAUTH_TOKEN\") {\n\t\tfmt.Fprintln(w, \"\")\n\t\tfmt.Fprintln(w, \"  Step 1 — the OAuth token. On your HOST, with Claude Code installed\")\n\t\tfmt.Fprintln(w, \"  locally, run:\")\n\t\tfmt.Fprintln(w, \"      claude setup-token\")\n\t\tfmt.Fprintln(w, \"  Paste the 'sk-ant-oat01-…' token it prints below.\")\n\t\tpromptSecret(\"  CLAUDE_CODE_OAUTH_TOKEN\", \"CLAUDE_CODE_OAUTH_TOKEN\", r, w)\n\t} else {\n\t\tfmt.Fprintf(w, \"  ✓ CLAUDE_CODE_OAUTH_TOKEN already set (%s).\\n\", cli.Mask(config.EnvValue(\"CLAUDE_CODE_OAUTH_TOKEN\")))\n\t}\n\n\tif !(have(\"CLAUDE_ACCOUNT_UUID\") && have(\"CLAUDE_EMAIL\") && have(\"CLAUDE_ORG_UUID\")) {\n\t\tfmt.Fprintln(w, \"\")\n\t\tfmt.Fprintln(w, \"  Step 2 — account details (CLAUDE_ACCOUNT_UUID, CLAUDE_EMAIL,\")\n\t\tfmt.Fprintln(w, \"  CLAUDE_ORG_UUID).\")\n\t\tif uuid, email, org, ok := claudeAccountFromJSON(); ok {\n\t\t\tfmt.Fprintln(w, \"  Found them in ~/.claude.json on this host — applying automatically.\")\n\t\t\t_ = config.UpsertEnv(\"CLAUDE_ACCOUNT_UUID\", uuid)\n\t\t\t_ = config.UpsertEnv(\"CLAUDE_EMAIL\", email)\n\t\t\t_ = config.UpsertEnv(\"CLAUDE_ORG_UUID\", org)\n\t\t\treturn\n\t\t}\n\t\tfmt.Fprintln(w, \"  Could not read them from ~/.claude.json here. On the host where\")\n\t\tfmt.Fprintln(w, \"  Claude Code is logged in, extract them with:\")\n\t\tfmt.Fprintln(w, `      cat ~/.claude.json | python3 -c \"import json,sys; d=json.load(sys.stdin); print(json.dumps(d.get('oauthAccount'), indent=2))\"`)\n\t\tfmt.Fprintln(w, \"\")\n\t\tpromptValue(\"  CLAUDE_ACCOUNT_UUID\", \"CLAUDE_ACCOUNT_UUID\", \"\", r, w)\n\t\tpromptValue(\"  CLAUDE_EMAIL\", \"CLAUDE_EMAIL\", \"\", r, w)\n\t\tpromptValue(\"  CLAUDE_ORG_UUID\", \"CLAUDE_ORG_UUID\", \"\", r, w)\n\t}\n}\n\n// setupProfile runs the setup wizard block for one profile, dispatching on its\n// tool: the claude-code flow (the bespoke OAuth account wizard) and the\n// data-driven opencode flow (setupOpenCodeProfile + setupSpecs). Called for\n// every profile in config.Profiles(), so a user-defined profile gets a wizard\n// too — a generic spec when its id has no bespoke entry in setupSpecs.\nfunc setupProfile(p config.Profile, br *bufio.Reader, w io.Writer) {\n\tif p.Tool == config.ToolClaudeCode {\n\t\tsetupClaudePro(br, w)\n\t\treturn\n\t}\n\tspec, ok := setupSpecs[p.ID]\n\tif !ok {\n\t\tspec = genericOpenCodeSpec(p)\n\t}\n\tsetupOpenCodeProfile(p, spec, br, w)\n}\n\n// profileSetupSpec carries the prose a profile's opencode wizard block prints.\n// The built-in opencode profiles each have bespoke billing instructions; a\n// user-defined profile (no entry in setupSpecs) falls back to the generic\n// spec built by genericOpenCodeSpec.\ntype profileSetupSpec struct {\n\ttitle     string   // the line under sepLine\n\tintro     []string // paragraphs printed before the credential prompt\n\tmodelHint []string // extra lines printed before the model prompt\n}\n\n// setupSpecs holds the per-profile wizard prose for the built-in opencode\n// profiles, so the data-driven setupOpenCodeProfile reproduces their exact\n// wording. claude-pro is handled by setupClaudePro (the claude-tool flow).\nvar setupSpecs = map[string]profileSetupSpec{\n\tconfig.ProfileZAI: {\n\t\ttitle: \"  zai — OpenCode, billed to your Z.AI Coding Plan\",\n\t\tintro: []string{\n\t\t\t\"  OpenCode authenticates to Z.AI with an API key from your Z.AI\",\n\t\t\t\"  Coding Plan. Get one from the Z.AI / BigModel console\",\n\t\t\t\"  (https://www.bigmodel.cn), then paste it below.\",\n\t\t},\n\t},\n\tconfig.ProfileOpenCodeGo: {\n\t\ttitle: \"  opencode-go — OpenCode, billed to the OpenCode Go subscription\",\n\t\tintro: []string{\n\t\t\t\"  OpenCode Go uses your OpenCode API key — the same key you get at\",\n\t\t\t\"  https://opencode.ai/auth, billed against your Go subscription.\",\n\t\t\t\"\",\n\t\t\t\"  1. Open https://opencode.ai/auth and sign in\",\n\t\t\t\"  2. Subscribe to OpenCode Go (if you haven't already)\",\n\t\t\t\"  3. Copy your API key and paste it below\",\n\t\t},\n\t\tmodelHint: []string{\n\t\t\t\"  Go model ids use the opencode-go/ prefix (e.g. opencode-go/deepseek-v4-flash).\",\n\t\t},\n\t},\n\tconfig.ProfileOpenCodeZen: {\n\t\ttitle: \"  opencode-zen — OpenCode, billed to OpenCode Zen (DeepSeek V4 Flash)\",\n\t\tintro: []string{\n\t\t\t\"  OpenCode Zen uses your OpenCode API key — the same key you get at\",\n\t\t\t\"  https://opencode.ai/auth. This DeepSeek V4 Flash model is billed\",\n\t\t\t\"  pay-as-you-go against your Zen account credits — add billing at\",\n\t\t\t\"  https://opencode.ai/auth if you haven't. For the no-cost variant, use\",\n\t\t\t\"  the opencode-zen-free profile instead.\",\n\t\t\t\"\",\n\t\t\t\"  1. Open https://opencode.ai/auth and sign in\",\n\t\t\t\"  2. Copy your API key and paste it below\",\n\t\t},\n\t\tmodelHint: []string{\n\t\t\t\"  Zen's (billed) DeepSeek V4 Flash model is opencode/deepseek-v4-flash.\",\n\t\t},\n\t},\n\tconfig.ProfileOpenCodeZenFree: {\n\t\ttitle: \"  opencode-zen-free — OpenCode, billed to OpenCode Zen (DeepSeek V4 Flash Free)\",\n\t\tintro: []string{\n\t\t\t\"  OpenCode Zen uses your OpenCode API key — the same key you get at\",\n\t\t\t\"  https://opencode.ai/auth. The free DeepSeek V4 Flash model costs\",\n\t\t\t\"  no credits, so this profile works with a key alone.\",\n\t\t\t\"\",\n\t\t\t\"  1. Open https://opencode.ai/auth and sign in\",\n\t\t\t\"  2. Copy your API key and paste it below\",\n\t\t},\n\t\tmodelHint: []string{\n\t\t\t\"  Zen's free DeepSeek V4 Flash model is opencode/deepseek-v4-flash-free.\",\n\t\t},\n\t},\n}\n\n// genericOpenCodeSpec builds a wizard spec for a user-defined opencode profile\n// that has no bespoke entry in setupSpecs.\nfunc genericOpenCodeSpec(p config.Profile) profileSetupSpec {\n\tkey := \"the profile's API key\"\n\tif len(p.AuthKeys) > 0 {\n\t\tkey = p.AuthKeys[0]\n\t}\n\treturn profileSetupSpec{\n\t\ttitle: fmt.Sprintf(\"  %s — OpenCode profile billed via %s\", p.ID, key),\n\t\tintro: []string{\n\t\t\tfmt.Sprintf(\"  This user-defined profile bills against the %s credential.\", key),\n\t\t\t\"  Add it to manigot/.env (or inherit it from your environment) to\",\n\t\t\t\"  make the profile ready.\",\n\t\t},\n\t}\n}\n\n// setupOpenCodeProfile is the data-driven opencode wizard block: the key, model\n// env key, and model default all come from the profile; the surrounding prose\n// from its spec. It reproduces the built-in opencode wizards byte-for-byte via\n// setupSpecs.\nfunc setupOpenCodeProfile(p config.Profile, spec profileSetupSpec, br *bufio.Reader, w io.Writer) {\n\tfmt.Fprintln(w, sepLine)\n\tfmt.Fprintln(w, spec.title)\n\tfmt.Fprintln(w, sepLine)\n\tkey := \"\"\n\tif len(p.AuthKeys) > 0 {\n\t\tkey = p.AuthKeys[0]\n\t}\n\tif key != \"\" && have(key) {\n\t\tfmt.Fprintf(w, \"  ✓ Already configured (%s %s).\\n\", key, cli.Mask(config.EnvValue(key)))\n\t} else {\n\t\tfor _, line := range spec.intro {\n\t\t\tfmt.Fprintln(w, line)\n\t\t}\n\t\tif key != \"\" {\n\t\t\tpromptSecret(\"  \"+key, key, br, w)\n\t\t}\n\t}\n\tfmt.Fprintln(w, \"\")\n\tfmt.Fprintln(w, \"  Optional — the model this profile defaults to, as provider/model.\")\n\tfor _, line := range spec.modelHint {\n\t\tfmt.Fprintln(w, line)\n\t}\n\tpromptValue(\"  \"+p.ModelEnv, p.ModelEnv, p.ModelDefault, br, w)\n}\n\n// setupNtfy is the optional ntfy block of the mg setup wizard: it prompts\n// the three NTFY_* keys into manigot/.env so push notifications for mg jdi\n// are discoverable without hand-editing the file. Unlike the profile blocks\n// it is not a subscription profile, so --check does not cover it (its check\n// shape is profile-shaped). Opt-in: leaving NTFY_TOPIC empty keeps\n// notifications off, which is the default.\nfunc setupNtfy(r io.Reader, w io.Writer) {\n\tfmt.Fprintln(w, sepLine)\n\tfmt.Fprintln(w, \"  ntfy — push notifications for mg jdi (optional)\")\n\tfmt.Fprintln(w, sepLine)\n\tif have(\"NTFY_TOPIC\") {\n\t\tfmt.Fprintf(w, \"  ✓ Already configured (NTFY_TOPIC %s).\\n\", cli.Mask(config.EnvValue(\"NTFY_TOPIC\")))\n\t\treturn\n\t}\n\tfmt.Fprintln(w, \"  mg jdi can push a notification to your phone when a run stops\")\n\tfmt.Fprintln(w, \"  or when it finds a previous run crashed. Leave NTFY_TOPIC empty\")\n\tfmt.Fprintln(w, \"  to keep notifications off.\")\n\tpromptValue(\"  NTFY_URL\", \"NTFY_URL\", \"https://ntfy.sh\", r, w)\n\tpromptValue(\"  NTFY_TOPIC\", \"NTFY_TOPIC\", \"\", r, w)\n\tpromptSecret(\"  NTFY_TOKEN\", \"NTFY_TOKEN\", r, w)\n}\n\n// have reports whether the effective value of key (process env + .env) is\n// non-empty — the Go form of setup.sh's have() helper.\nfunc have(key string) bool {\n\treturn config.EnvValue(key) != \"\"\n}\n","numLines":412,"startLine":1,"totalLines":412}}}
