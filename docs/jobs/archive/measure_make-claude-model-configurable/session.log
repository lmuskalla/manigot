{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TXp3SrC7rhzXBr8F9745K3","type":"tool_result","content":"1\t// Package session ports scripts/run.sh — the docker session launcher — into Go.\n2\t// It is the single host-side seam between the orchestrator and the agent\n3\t// environment: profile/tool resolution, project-root + --job worktree\n4\t// resolution, docker argv/mount/env construction, and the actual run.\n5\t//\n6\t// Behavior is a 1:1 port of run.sh, including its exact diagnostic wording.\n7\t// One deliberate divergence per the consolidation brief (note 1): all\n8\t// diagnostics go to stderr. The script's fd-3 juggling existed only to keep\n9\t// the agent's stdout clean in --print mode; Go separates stdout/stderr\n10\t// natively, so there is nothing to juggle.\n11\tpackage session\n12\t\n13\timport (\n14\t\t\"errors\"\n15\t\t\"flag\"\n16\t\t\"fmt\"\n17\t\t\"io\"\n18\t\t\"strings\"\n19\t\n20\t\t\"github.com/lmuskalla/manigot/internal/config\"\n21\t)\n22\t\n23\t// Options carries the parsed session flag set.\n24\ttype Options struct {\n25\t\tAgent   string // --agent (or -a)\n26\t\tJob     string // --job (or -j)\n27\t\tPrompt  string // --prompt\n28\t\tTool    string // --tool (legacy alias)\n29\t\tProfile string // --profile\n30\t\tPrint   bool   // --print\n31\t\tPass    []string\n32\t}\n33\t\n34\t// ParseArgs parses the session flags: known --flags (and the -a/-j short\n35\t// forms of --agent/--job) consume their value, --print is a bare flag,\n36\t// anything else — an unknown flag or a bare word — is passthrough, handed\n37\t// verbatim to the container CLI (run.sh's semantics).\n38\t//\n39\t// The passthrough rule is why the known flags are extracted first (splitFlags)\n40\t// and parsed with a flag.FlagSet, rather than feeding flag the raw args:\n41\t// flag stops at the first non-flag argument and treats unknown flags as\n42\t// errors, neither of which matches \"everything unknown goes through\".\n43\tfunc ParseArgs(args []string) Options {\n44\t\tvar o Options\n45\t\tfs := flag.NewFlagSet(\"mg\", flag.ContinueOnError)\n46\t\tfs.SetOutput(io.Discard)\n47\t\tfs.StringVar(&o.Agent, \"agent\", \"\", \"\")\n48\t\tfs.StringVar(&o.Job, \"job\", \"\", \"\")\n49\t\tfs.StringVar(&o.Agent, \"a\", \"\", \"\") // short form of --agent\n50\t\tfs.StringVar(&o.Job, \"j\", \"\", \"\")   // short form of --job\n51\t\tfs.StringVar(&o.Prompt, \"prompt\", \"\", \"\")\n52\t\tfs.StringVar(&o.Tool, \"tool\", \"\", \"\")\n53\t\tfs.StringVar(&o.Profile, \"profile\", \"\", \"\")\n54\t\tfs.BoolVar(&o.Print, \"print\", false, \"\")\n55\t\n56\t\tvar flagArgs []string\n57\t\tflagArgs, o.Pass = splitFlags(args, sessionValueFlags, sessionBareFlags)\n58\t\t// The only parse error possible is a known flag left without its value at\n59\t\t// the end (e.g. a bare \"--agent\"); flag leaves the field unset, which is\n60\t\t// the loop's old silent-ignore behavior. There is no error path to the\n61\t\t// caller.\n62\t\t_ = fs.Parse(flagArgs)\n63\t\treturn o\n64\t}\n65\t\n66\t// sessionValueFlags / sessionBareFlags name the session's own flags for\n67\t// ParseArgs's splitFlags extraction. The short forms -a/-j are aliases of\n68\t// --agent/--job and are registered in the flag.FlagSet the same way.\n69\tvar (\n70\t\tsessionValueFlags = map[string]bool{\"--agent\": true, \"--job\": true, \"--prompt\": true, \"--tool\": true, \"--profile\": true, \"-a\": true, \"-j\": true}\n71\t\tsessionBareFlags  = map[string]bool{\"--print\": true}\n72\t)\n73\t\n74\t// splitFlags separates args into the known flag tokens (with their values)\n75\t// and everything else, preserving order within each group: the pieces the\n76\t// flag.FlagSet parses, and the passthrough remainder. valueFlags take one\n77\t// value each; bareFlags take none. Any other token — an unknown flag or a\n78\t// bare word — lands in rest.\n79\tfunc splitFlags(args []string, valueFlags, bareFlags map[string]bool) (flagArgs, rest []string) {\n80\t\tfor i := 0; i < len(args); i++ {\n81\t\t\tswitch {\n82\t\t\tcase bareFlags[args[i]]:\n83\t\t\t\tflagArgs = append(flagArgs, args[i])\n84\t\t\tcase valueFlags[args[i]]:\n85\t\t\t\tflagArgs = append(flagArgs, args[i])\n86\t\t\t\tif i+1 < len(args) {\n87\t\t\t\t\ti++\n88\t\t\t\t\tflagArgs = append(flagArgs, args[i])\n89\t\t\t\t}\n90\t\t\tdefault:\n91\t\t\t\trest = append(rest, args[i])\n92\t\t\t}\n93\t\t}\n94\t\treturn flagArgs, rest\n95\t}\n96\t\n97\t// legacyOpenCodeKeys is the nine-key list the legacy profile-less `--tool\n98\t// opencode` path forwards. Kept in sync with scripts/entrypoint.sh (the\n99\t// container-side safety net); Go pre-validates these keys before launch, so\n100\t// drift between the two is harmless.\n101\tvar legacyOpenCodeKeys = []string{\n102\t\t\"ANTHROPIC_API_KEY\",\n103\t\t\"OPENAI_API_KEY\",\n104\t\t\"OPENROUTER_API_KEY\",\n105\t\t\"GOOGLE_GENERATIVE_AI_API_KEY\",\n106\t\t\"GROQ_API_KEY\",\n107\t\t\"XAI_API_KEY\",\n108\t\t\"DEEPSEEK_API_KEY\",\n109\t\t\"OPENCODE_API_KEY\",\n110\t\t\"ZHIPU_API_KEY\",\n111\t}\n112\t\n113\t// ProfileInfo is the outcome of profile/tool resolution. Credential\n114\t// validation is a separate step (CheckAuth) so the session flow can match\n115\t// run.sh's ordering, where the auth checks run after --job resolution.\n116\ttype ProfileInfo struct {\n117\t\t// Profile is the resolved profile id: claude-pro, zai, opencode-go,\n118\t\t// opencode-zen, opencode-zen-free — or \"\" for the legacy profile-less\n119\t\t// --tool opencode path.\n120\t\tProfile string\n121\t\n122\t\t// Tool is the agent CLI to launch: config.ToolClaudeCode or\n123\t\t// config.ToolOpenCode.\n124\t\tTool string\n125\t\n126\t\t// AuthKeys are the profile's credential env keys, resolved from\n127\t\t// config.ProfileByID (the profile's AuthKeys). The claude branch of\n128\t\t// CheckAuth validates and forwards exactly these; for opencode profiles\n129\t\t// it is the same set as OpenCodeKeys.\n130\t\tAuthKeys []string\n131\t\n132\t\t// OpenCodeKeys lists the provider keys this opencode run forwards.\n133\t\tOpenCodeKeys []string\n134\t\n135\t\t// OpenCodeModel is the effective OPENCODE_MODEL value for opencode runs\n136\t\t// (\"\" when none — only the legacy path can leave it unset).\n137\t\tOpenCodeModel string\n138\t\n139\t\t// OpenCodeTheme is the effective OPENCODE_THEME value for opencode runs\n140\t\t// (\"\" when unset — the global theme setting, config.Settings.Theme, is\n141\t\t// shared across every opencode profile, unlike OpenCodeModel).\n142\t\tOpenCodeTheme string\n143\t\n144\t\t// KeyEnv holds the docker -e arguments for the forwarded credential keys\n145\t\t// (and the opencode model/theme), e.g. [\"-e\", \"CLAUDE_CODE_OAUTH_TOKEN=...\",\n146\t\t// \"-e\", \"ZHIPU_API_KEY=...\", \"-e\", \"OPENCODE_MODEL=...\", \"-e\",\n147\t\t// \"OPENCODE_THEME=...\"]. Filled by CheckAuth.\n148\t\tKeyEnv []string\n149\t}\n150\t\n151\t// ResolveProfile implements run.sh's profile resolution block verbatim in\n152\t// behavior: precedence is --profile > --tool (legacy map:\n153\t// claude-code→claude-pro, opencode→legacy empty-profile mode) >\n154\t// $MANIGOT_PROFILE (validated) > claude-pro; then the profile→tool/key/model\n155\t// mapping and the --print + legacy-opencode rejection. Values are read via\n156\t// config.EnvValue, which mirrors the script's `set -a; source .env` (the .env\n157\t// file wins, then the process environment). Every error's wording matches the\n158\t// script's output.\n159\t//\n160\t// The credential auth checks are NOT part of this step — call CheckAuth after\n161\t// the root/--job resolution, mirroring run.sh's own ordering (the script\n162\t// resolves the job before it checks keys, so a job error takes precedence\n163\t// over a missing-key error when both apply).\n164\tfunc ResolveProfile(opts Options) (ProfileInfo, error) {\n165\t\tprofile := opts.Profile\n166\t\tswitch {\n167\t\tcase profile != \"\":\n168\t\t\tif _, ok := config.ProfileByID(profile); !ok {\n169\t\t\t\treturn ProfileInfo{}, fmt.Errorf(\"--profile must be one of: %s (got '%s').\", profileValidList(), profile)\n170\t\t\t}\n171\t\tcase opts.Tool != \"\":\n172\t\t\tswitch opts.Tool {\n173\t\t\tcase config.ToolClaudeCode:\n174\t\t\t\tprofile = config.ProfileClaudePro\n175\t\t\tcase config.ToolOpenCode:\n176\t\t\t\tprofile = \"\" // legacy opencode mode, handled below\n177\t\t\tdefault:\n178\t\t\t\treturn ProfileInfo{}, fmt.Errorf(\"--tool must be 'claude-code' or 'opencode' (got '%s').\", opts.Tool)\n179\t\t\t}\n180\t\tdefault:\n181\t\t\tprofile = config.EnvValue(\"MANIGOT_PROFILE\")\n182\t\t\tif profile == \"\" {\n183\t\t\t\tprofile = config.ProfileClaudePro\n184\t\t\t}\n185\t\t\tif _, ok := config.ProfileByID(profile); !ok {\n186\t\t\t\treturn ProfileInfo{}, fmt.Errorf(\"MANIGOT_PROFILE in %s is not a valid profile (got '%s').\\nValid profiles: %s\", config.EnvFile(), profile, profileValidList())\n187\t\t\t}\n188\t\t}\n189\t\n190\t\tinfo := ProfileInfo{Profile: profile}\n191\t\tif profile != \"\" {\n192\t\t\t// Data-driven: the tool, auth keys, and model env/default all come\n193\t\t\t// from the profile's definition in config, so a user-defined profile\n194\t\t\t// resolves exactly like the built-in ones.\n195\t\t\tif p, ok := config.ProfileByID(profile); ok {\n196\t\t\t\tinfo.Tool = p.Tool\n197\t\t\t\tinfo.AuthKeys = append([]string(nil), p.AuthKeys...)\n198\t\t\t\tif p.Tool == config.ToolOpenCode {\n199\t\t\t\t\tinfo.OpenCodeKeys = append([]string(nil), p.AuthKeys...)\n200\t\t\t\t\tinfo.OpenCodeModel = envDefault(p.ModelEnv, p.ModelDefault)\n201\t\t\t\t}\n202\t\t\t}\n203\t\t} else {\n204\t\t\tinfo.Tool = config.ToolOpenCode\n205\t\t\tinfo.OpenCodeKeys = legacyOpenCodeKeys\n206\t\t\tinfo.AuthKeys = legacyOpenCodeKeys\n207\t\t\tinfo.OpenCodeModel = config.EnvValue(\"OPENCODE_MODEL\") // forwarded as-is\n208\t\t}\n209\t\n210\t\t// The theme setting is global — one value shared across every opencode\n211\t\t// profile (config.Settings.Theme/OPENCODE_THEME), unlike the per-profile\n212\t\t// model — so it's read once here rather than per-profile above.\n213\t\tif info.Tool == config.ToolOpenCode {\n214\t\t\tinfo.OpenCodeTheme = config.EnvValue(\"OPENCODE_THEME\")\n215\t\t}\n216\t\n217\t\t// --print is a non-interactive, one-shot invocation built for automated\n218\t\t// callers like mg-jdi. The legacy, profile-less --tool opencode path is\n219\t\t// intentionally left rejected here — it predates the profile system.\n220\t\tif opts.Print && info.Tool == config.ToolOpenCode && info.Profile == \"\" {\n221\t\t\treturn ProfileInfo{}, fmt.Errorf(\"--print is not supported with the legacy --tool opencode (no --profile).\\nUse --profile zai, --profile opencode-go, --profile opencode-zen or --profile opencode-zen-free instead.\")\n222\t\t}\n223\t\n224\t\treturn info, nil\n225\t}\n226\t\n227\t// CheckAuth validates the resolved profile's credentials (run.sh's auth\n228\t// block, which ran after --job resolution) and fills in KeyEnv — the docker\n229\t// -e arguments for the forwarded opencode keys and model.\n230\tfunc (info *ProfileInfo) CheckAuth() error {\n231\t\tif info.Tool == config.ToolClaudeCode {\n232\t\t\t// The first auth key is the OAuth token every claude profile requires\n233\t\t\t// (the built-in's is CLAUDE_CODE_OAUTH_TOKEN); the rest are optional\n234\t\t\t// account details. The message keeps the built-in's exact wording.\n235\t\t\ttokenKey := \"CLAUDE_CODE_OAUTH_TOKEN\"\n236\t\t\tif len(info.AuthKeys) > 0 {\n237\t\t\t\ttokenKey = info.AuthKeys[0]\n238\t\t\t}\n239\t\t\tif config.EnvValue(tokenKey) == \"\" {\n240\t\t\t\treturn fmt.Errorf(\"%s is not set.\\nAdd it to %s, or run 'mg setup %s' for help:\\n  %s=sk-ant-oat01-...\", tokenKey, config.EnvFile(), info.Profile, tokenKey)\n241\t\t\t}\n242\t\t\t// Subscription protection: an API key would override the mounted\n243\t\t\t// OAuth credentials and bill per token.\n244\t\t\tif v := config.EnvValue(\"ANTHROPIC_API_KEY\"); v != \"\" {\n245\t\t\t\treturn fmt.Errorf(\"ANTHROPIC_API_KEY is set — this overrides your subscription and bills per token.\\nRemove it from your environment before running mg with the claude-pro profile.\")\n246\t\t\t}\n247\t\t\t// Forward the subscription credentials into the container. The\n248\t\t\t// empty-value filter matches the opencode handling below, so a\n249\t\t\t// non-claude profile's docker argv never carries -e CLAUDE_*==\"\"\n250\t\t\t// noise (the token was just validated; the other three are optional).\n251\t\t\tfor _, key := range info.AuthKeys {\n252\t\t\t\tif v := config.EnvValue(key); v != \"\" {\n253\t\t\t\t\tinfo.KeyEnv = append(info.KeyEnv, \"-e\", key+\"=\"+v)\n254\t\t\t\t}\n255\t\t\t}\n256\t\t\treturn nil\n257\t\t}\n258\t\n259\t\t// OpenCode is multi-provider: forward exactly the key(s) the profile is\n260\t\t// billed against; any one of them is enough to start.\n261\t\tfor _, key := range info.OpenCodeKeys {\n262\t\t\tif v := config.EnvValue(key); v != \"\" {\n263\t\t\t\tinfo.KeyEnv = append(info.KeyEnv, \"-e\", key+\"=\"+v)\n264\t\t\t}\n265\t\t}\n266\t\tif len(info.KeyEnv) == 0 {\n267\t\t\tvar msg string\n268\t\t\tif info.Profile != \"\" {\n269\t\t\t\tmsg = fmt.Sprintf(\"profile '%s' is missing its API key.\\nAdd it to %s, or run 'mg setup %s' for help:\", info.Profile, config.EnvFile(), info.Profile)\n270\t\t\t} else {\n271\t\t\t\tmsg = fmt.Sprintf(\"--tool opencode needs at least one provider API key.\\nAdd one of these to %s:\", config.EnvFile())\n272\t\t\t}\n273\t\t\tfor _, k := range info.OpenCodeKeys {\n274\t\t\t\tmsg += \"\\n  \" + k\n275\t\t\t}\n276\t\t\treturn errors.New(msg)\n277\t\t}\n278\t\n279\t\t// The model each profile defaults to, consumed by scripts/entrypoint.sh\n280\t\t// via the {env:OPENCODE_MODEL} config substitution.\n281\t\tif info.OpenCodeModel != \"\" {\n282\t\t\tinfo.KeyEnv = append(info.KeyEnv, \"-e\", \"OPENCODE_MODEL=\"+info.OpenCodeModel)\n283\t\t}\n284\t\t// The global theme setting, forwarded independent of which profile/API\n285\t\t// key is in use, consumed by scripts/entrypoint.sh via the\n286\t\t// {env:OPENCODE_THEME} config substitution.\n287\t\tif info.OpenCodeTheme != \"\" {\n288\t\t\tinfo.KeyEnv = append(info.KeyEnv, \"-e\", \"OPENCODE_THEME=\"+info.OpenCodeTheme)\n289\t\t}\n290\t\treturn nil\n291\t}\n292\t\n293\t// profileValidList is the pipe-joined list of known profile ids used in error\n294\t// messages, derived from config.Profiles() so a user-defined profile is\n295\t// reported as valid too. For the default (built-ins only) store it is exactly\n296\t// \"claude-pro|zai|opencode-go|opencode-zen|opencode-zen-free\".\n297\tfunc profileValidList() string {\n298\t\tps := config.Profiles()\n299\t\tids := make([]string, len(ps))\n300\t\tfor i, p := range ps {\n301\t\t\tids[i] = p.ID\n302\t\t}\n303\t\treturn strings.Join(ids, \"|\")\n304\t}\n305\t\n306\t// envDefault returns the effective value of key, or def when it is unset —\n307\t// the Go form of bash's ${VAR:-default}.\n308\tfunc envDefault(key, def string) string {\n309\t\tif v := config.EnvValue(key); v != \"\" {\n310\t\t\treturn v\n311\t\t}\n312\t\treturn def\n313\t}\n314\t"}]},"parent_tool_use_id":null,"session_id":"0ad41780-e2e7-4ebf-861d-9c61d66ababf","uuid":"c9d55eea-cfdf-49ad-b055-79eea099c135","timestamp":"2026-08-29T08:59:37.178Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/session/session.go","content":"// Package session ports scripts/run.sh — the docker session launcher — into Go.\n// It is the single host-side seam between the orchestrator and the agent\n// environment: profile/tool resolution, project-root + --job worktree\n// resolution, docker argv/mount/env construction, and the actual run.\n//\n// Behavior is a 1:1 port of run.sh, including its exact diagnostic wording.\n// One deliberate divergence per the consolidation brief (note 1): all\n// diagnostics go to stderr. The script's fd-3 juggling existed only to keep\n// the agent's stdout clean in --print mode; Go separates stdout/stderr\n// natively, so there is nothing to juggle.\npackage session\n\nimport (\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n)\n\n// Options carries the parsed session flag set.\ntype Options struct {\n\tAgent   string // --agent (or -a)\n\tJob     string // --job (or -j)\n\tPrompt  string // --prompt\n\tTool    string // --tool (legacy alias)\n\tProfile string // --profile\n\tPrint   bool   // --print\n\tPass    []string\n}\n\n// ParseArgs parses the session flags: known --flags (and the -a/-j short\n// forms of --agent/--job) consume their value, --print is a bare flag,\n// anything else — an unknown flag or a bare word — is passthrough, handed\n// verbatim to the container CLI (run.sh's semantics).\n//\n// The passthrough rule is why the known flags are extracted first (splitFlags)\n// and parsed with a flag.FlagSet, rather than feeding flag the raw args:\n// flag stops at the first non-flag argument and treats unknown flags as\n// errors, neither of which matches \"everything unknown goes through\".\nfunc ParseArgs(args []string) Options {\n\tvar o Options\n\tfs := flag.NewFlagSet(\"mg\", flag.ContinueOnError)\n\tfs.SetOutput(io.Discard)\n\tfs.StringVar(&o.Agent, \"agent\", \"\", \"\")\n\tfs.StringVar(&o.Job, \"job\", \"\", \"\")\n\tfs.StringVar(&o.Agent, \"a\", \"\", \"\") // short form of --agent\n\tfs.StringVar(&o.Job, \"j\", \"\", \"\")   // short form of --job\n\tfs.StringVar(&o.Prompt, \"prompt\", \"\", \"\")\n\tfs.StringVar(&o.Tool, \"tool\", \"\", \"\")\n\tfs.StringVar(&o.Profile, \"profile\", \"\", \"\")\n\tfs.BoolVar(&o.Print, \"print\", false, \"\")\n\n\tvar flagArgs []string\n\tflagArgs, o.Pass = splitFlags(args, sessionValueFlags, sessionBareFlags)\n\t// The only parse error possible is a known flag left without its value at\n\t// the end (e.g. a bare \"--agent\"); flag leaves the field unset, which is\n\t// the loop's old silent-ignore behavior. There is no error path to the\n\t// caller.\n\t_ = fs.Parse(flagArgs)\n\treturn o\n}\n\n// sessionValueFlags / sessionBareFlags name the session's own flags for\n// ParseArgs's splitFlags extraction. The short forms -a/-j are aliases of\n// --agent/--job and are registered in the flag.FlagSet the same way.\nvar (\n\tsessionValueFlags = map[string]bool{\"--agent\": true, \"--job\": true, \"--prompt\": true, \"--tool\": true, \"--profile\": true, \"-a\": true, \"-j\": true}\n\tsessionBareFlags  = map[string]bool{\"--print\": true}\n)\n\n// splitFlags separates args into the known flag tokens (with their values)\n// and everything else, preserving order within each group: the pieces the\n// flag.FlagSet parses, and the passthrough remainder. valueFlags take one\n// value each; bareFlags take none. Any other token — an unknown flag or a\n// bare word — lands in rest.\nfunc splitFlags(args []string, valueFlags, bareFlags map[string]bool) (flagArgs, rest []string) {\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch {\n\t\tcase bareFlags[args[i]]:\n\t\t\tflagArgs = append(flagArgs, args[i])\n\t\tcase valueFlags[args[i]]:\n\t\t\tflagArgs = append(flagArgs, args[i])\n\t\t\tif i+1 < len(args) {\n\t\t\t\ti++\n\t\t\t\tflagArgs = append(flagArgs, args[i])\n\t\t\t}\n\t\tdefault:\n\t\t\trest = append(rest, args[i])\n\t\t}\n\t}\n\treturn flagArgs, rest\n}\n\n// legacyOpenCodeKeys is the nine-key list the legacy profile-less `--tool\n// opencode` path forwards. Kept in sync with scripts/entrypoint.sh (the\n// container-side safety net); Go pre-validates these keys before launch, so\n// drift between the two is harmless.\nvar legacyOpenCodeKeys = []string{\n\t\"ANTHROPIC_API_KEY\",\n\t\"OPENAI_API_KEY\",\n\t\"OPENROUTER_API_KEY\",\n\t\"GOOGLE_GENERATIVE_AI_API_KEY\",\n\t\"GROQ_API_KEY\",\n\t\"XAI_API_KEY\",\n\t\"DEEPSEEK_API_KEY\",\n\t\"OPENCODE_API_KEY\",\n\t\"ZHIPU_API_KEY\",\n}\n\n// ProfileInfo is the outcome of profile/tool resolution. Credential\n// validation is a separate step (CheckAuth) so the session flow can match\n// run.sh's ordering, where the auth checks run after --job resolution.\ntype ProfileInfo struct {\n\t// Profile is the resolved profile id: claude-pro, zai, opencode-go,\n\t// opencode-zen, opencode-zen-free — or \"\" for the legacy profile-less\n\t// --tool opencode path.\n\tProfile string\n\n\t// Tool is the agent CLI to launch: config.ToolClaudeCode or\n\t// config.ToolOpenCode.\n\tTool string\n\n\t// AuthKeys are the profile's credential env keys, resolved from\n\t// config.ProfileByID (the profile's AuthKeys). The claude branch of\n\t// CheckAuth validates and forwards exactly these; for opencode profiles\n\t// it is the same set as OpenCodeKeys.\n\tAuthKeys []string\n\n\t// OpenCodeKeys lists the provider keys this opencode run forwards.\n\tOpenCodeKeys []string\n\n\t// OpenCodeModel is the effective OPENCODE_MODEL value for opencode runs\n\t// (\"\" when none — only the legacy path can leave it unset).\n\tOpenCodeModel string\n\n\t// OpenCodeTheme is the effective OPENCODE_THEME value for opencode runs\n\t// (\"\" when unset — the global theme setting, config.Settings.Theme, is\n\t// shared across every opencode profile, unlike OpenCodeModel).\n\tOpenCodeTheme string\n\n\t// KeyEnv holds the docker -e arguments for the forwarded credential keys\n\t// (and the opencode model/theme), e.g. [\"-e\", \"CLAUDE_CODE_OAUTH_TOKEN=...\",\n\t// \"-e\", \"ZHIPU_API_KEY=...\", \"-e\", \"OPENCODE_MODEL=...\", \"-e\",\n\t// \"OPENCODE_THEME=...\"]. Filled by CheckAuth.\n\tKeyEnv []string\n}\n\n// ResolveProfile implements run.sh's profile resolution block verbatim in\n// behavior: precedence is --profile > --tool (legacy map:\n// claude-code→claude-pro, opencode→legacy empty-profile mode) >\n// $MANIGOT_PROFILE (validated) > claude-pro; then the profile→tool/key/model\n// mapping and the --print + legacy-opencode rejection. Values are read via\n// config.EnvValue, which mirrors the script's `set -a; source .env` (the .env\n// file wins, then the process environment). Every error's wording matches the\n// script's output.\n//\n// The credential auth checks are NOT part of this step — call CheckAuth after\n// the root/--job resolution, mirroring run.sh's own ordering (the script\n// resolves the job before it checks keys, so a job error takes precedence\n// over a missing-key error when both apply).\nfunc ResolveProfile(opts Options) (ProfileInfo, error) {\n\tprofile := opts.Profile\n\tswitch {\n\tcase profile != \"\":\n\t\tif _, ok := config.ProfileByID(profile); !ok {\n\t\t\treturn ProfileInfo{}, fmt.Errorf(\"--profile must be one of: %s (got '%s').\", profileValidList(), profile)\n\t\t}\n\tcase opts.Tool != \"\":\n\t\tswitch opts.Tool {\n\t\tcase config.ToolClaudeCode:\n\t\t\tprofile = config.ProfileClaudePro\n\t\tcase config.ToolOpenCode:\n\t\t\tprofile = \"\" // legacy opencode mode, handled below\n\t\tdefault:\n\t\t\treturn ProfileInfo{}, fmt.Errorf(\"--tool must be 'claude-code' or 'opencode' (got '%s').\", opts.Tool)\n\t\t}\n\tdefault:\n\t\tprofile = config.EnvValue(\"MANIGOT_PROFILE\")\n\t\tif profile == \"\" {\n\t\t\tprofile = config.ProfileClaudePro\n\t\t}\n\t\tif _, ok := config.ProfileByID(profile); !ok {\n\t\t\treturn ProfileInfo{}, fmt.Errorf(\"MANIGOT_PROFILE in %s is not a valid profile (got '%s').\\nValid profiles: %s\", config.EnvFile(), profile, profileValidList())\n\t\t}\n\t}\n\n\tinfo := ProfileInfo{Profile: profile}\n\tif profile != \"\" {\n\t\t// Data-driven: the tool, auth keys, and model env/default all come\n\t\t// from the profile's definition in config, so a user-defined profile\n\t\t// resolves exactly like the built-in ones.\n\t\tif p, ok := config.ProfileByID(profile); ok {\n\t\t\tinfo.Tool = p.Tool\n\t\t\tinfo.AuthKeys = append([]string(nil), p.AuthKeys...)\n\t\t\tif p.Tool == config.ToolOpenCode {\n\t\t\t\tinfo.OpenCodeKeys = append([]string(nil), p.AuthKeys...)\n\t\t\t\tinfo.OpenCodeModel = envDefault(p.ModelEnv, p.ModelDefault)\n\t\t\t}\n\t\t}\n\t} else {\n\t\tinfo.Tool = config.ToolOpenCode\n\t\tinfo.OpenCodeKeys = legacyOpenCodeKeys\n\t\tinfo.AuthKeys = legacyOpenCodeKeys\n\t\tinfo.OpenCodeModel = config.EnvValue(\"OPENCODE_MODEL\") // forwarded as-is\n\t}\n\n\t// The theme setting is global — one value shared across every opencode\n\t// profile (config.Settings.Theme/OPENCODE_THEME), unlike the per-profile\n\t// model — so it's read once here rather than per-profile above.\n\tif info.Tool == config.ToolOpenCode {\n\t\tinfo.OpenCodeTheme = config.EnvValue(\"OPENCODE_THEME\")\n\t}\n\n\t// --print is a non-interactive, one-shot invocation built for automated\n\t// callers like mg-jdi. The legacy, profile-less --tool opencode path is\n\t// intentionally left rejected here — it predates the profile system.\n\tif opts.Print && info.Tool == config.ToolOpenCode && info.Profile == \"\" {\n\t\treturn ProfileInfo{}, fmt.Errorf(\"--print is not supported with the legacy --tool opencode (no --profile).\\nUse --profile zai, --profile opencode-go, --profile opencode-zen or --profile opencode-zen-free instead.\")\n\t}\n\n\treturn info, nil\n}\n\n// CheckAuth validates the resolved profile's credentials (run.sh's auth\n// block, which ran after --job resolution) and fills in KeyEnv — the docker\n// -e arguments for the forwarded opencode keys and model.\nfunc (info *ProfileInfo) CheckAuth() error {\n\tif info.Tool == config.ToolClaudeCode {\n\t\t// The first auth key is the OAuth token every claude profile requires\n\t\t// (the built-in's is CLAUDE_CODE_OAUTH_TOKEN); the rest are optional\n\t\t// account details. The message keeps the built-in's exact wording.\n\t\ttokenKey := \"CLAUDE_CODE_OAUTH_TOKEN\"\n\t\tif len(info.AuthKeys) > 0 {\n\t\t\ttokenKey = info.AuthKeys[0]\n\t\t}\n\t\tif config.EnvValue(tokenKey) == \"\" {\n\t\t\treturn fmt.Errorf(\"%s is not set.\\nAdd it to %s, or run 'mg setup %s' for help:\\n  %s=sk-ant-oat01-...\", tokenKey, config.EnvFile(), info.Profile, tokenKey)\n\t\t}\n\t\t// Subscription protection: an API key would override the mounted\n\t\t// OAuth credentials and bill per token.\n\t\tif v := config.EnvValue(\"ANTHROPIC_API_KEY\"); v != \"\" {\n\t\t\treturn fmt.Errorf(\"ANTHROPIC_API_KEY is set — this overrides your subscription and bills per token.\\nRemove it from your environment before running mg with the claude-pro profile.\")\n\t\t}\n\t\t// Forward the subscription credentials into the container. The\n\t\t// empty-value filter matches the opencode handling below, so a\n\t\t// non-claude profile's docker argv never carries -e CLAUDE_*==\"\"\n\t\t// noise (the token was just validated; the other three are optional).\n\t\tfor _, key := range info.AuthKeys {\n\t\t\tif v := config.EnvValue(key); v != \"\" {\n\t\t\t\tinfo.KeyEnv = append(info.KeyEnv, \"-e\", key+\"=\"+v)\n\t\t\t}\n\t\t}\n\t\treturn nil\n\t}\n\n\t// OpenCode is multi-provider: forward exactly the key(s) the profile is\n\t// billed against; any one of them is enough to start.\n\tfor _, key := range info.OpenCodeKeys {\n\t\tif v := config.EnvValue(key); v != \"\" {\n\t\t\tinfo.KeyEnv = append(info.KeyEnv, \"-e\", key+\"=\"+v)\n\t\t}\n\t}\n\tif len(info.KeyEnv) == 0 {\n\t\tvar msg string\n\t\tif info.Profile != \"\" {\n\t\t\tmsg = fmt.Sprintf(\"profile '%s' is missing its API key.\\nAdd it to %s, or run 'mg setup %s' for help:\", info.Profile, config.EnvFile(), info.Profile)\n\t\t} else {\n\t\t\tmsg = fmt.Sprintf(\"--tool opencode needs at least one provider API key.\\nAdd one of these to %s:\", config.EnvFile())\n\t\t}\n\t\tfor _, k := range info.OpenCodeKeys {\n\t\t\tmsg += \"\\n  \" + k\n\t\t}\n\t\treturn errors.New(msg)\n\t}\n\n\t// The model each profile defaults to, consumed by scripts/entrypoint.sh\n\t// via the {env:OPENCODE_MODEL} config substitution.\n\tif info.OpenCodeModel != \"\" {\n\t\tinfo.KeyEnv = append(info.KeyEnv, \"-e\", \"OPENCODE_MODEL=\"+info.OpenCodeModel)\n\t}\n\t// The global theme setting, forwarded independent of which profile/API\n\t// key is in use, consumed by scripts/entrypoint.sh via the\n\t// {env:OPENCODE_THEME} config substitution.\n\tif info.OpenCodeTheme != \"\" {\n\t\tinfo.KeyEnv = append(info.KeyEnv, \"-e\", \"OPENCODE_THEME=\"+info.OpenCodeTheme)\n\t}\n\treturn nil\n}\n\n// profileValidList is the pipe-joined list of known profile ids used in error\n// messages, derived from config.Profiles() so a user-defined profile is\n// reported as valid too. For the default (built-ins only) store it is exactly\n// \"claude-pro|zai|opencode-go|opencode-zen|opencode-zen-free\".\nfunc profileValidList() string {\n\tps := config.Profiles()\n\tids := make([]string, len(ps))\n\tfor i, p := range ps {\n\t\tids[i] = p.ID\n\t}\n\treturn strings.Join(ids, \"|\")\n}\n\n// envDefault returns the effective value of key, or def when it is unset —\n// the Go form of bash's ${VAR:-default}.\nfunc envDefault(key, def string) string {\n\tif v := config.EnvValue(key); v != \"\" {\n\t\treturn v\n\t}\n\treturn def\n}\n","numLines":314,"startLine":1,"totalLines":314}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017stqWq8CZ4ViLpHaWBCA2Q","type":"tool_result","content":"1\t// Package config persists local TUI preferences across sessions: which\n2\t// editor to open brief.md in, how many entries the dashboard's recent-activity\n3\t// strip may show, and which subscription profile (a bundle of agent CLI +\n4\t// credentials + model) launch.Agent starts a session under.\n5\t//\n6\t// The editor lives in config/tui-settings.json in the manigot checkout. The\n7\t// profile lives in manigot/.env as MANIGOT_PROFILE — the value bare `mg` runs\n8\t// and `mg profiles` write, so CLI and TUI share one profile default. The settings screen (see ui/settings.go)\n9\t// is the only writer; every other reader treats a missing or unreadable file\n10\t// as \"use the defaults\" rather than an error.\n11\tpackage config\n12\t\n13\timport (\n14\t\t\"encoding/json\"\n15\t\t\"fmt\"\n16\t\t\"os\"\n17\t\t\"path/filepath\"\n18\t\t\"strings\"\n19\t\n20\t\t\"github.com/lmuskalla/manigot/internal/home\"\n21\t)\n22\t\n23\t// ToolClaudeCode and ToolOpenCode are the legacy tool values once held by\n24\t// Settings.Tool (and still accepted by the session launcher's --tool alias).\n25\t// New code should use Profiles instead.\n26\tconst (\n27\t\tToolClaudeCode = \"claude-code\"\n28\t\tToolOpenCode   = \"opencode\"\n29\t)\n30\t\n31\t// ProfileClaudePro, ProfileZAI, ProfileOpenCodeGo, ProfileOpenCodeZen and\n32\t// ProfileOpenCodeZenFree are the five supported subscription profiles:\n33\t// Settings.Profile holds one of them, and the session launcher accepts them\n34\t// as --profile values.\n35\tconst (\n36\t\tProfileClaudePro       = \"claude-pro\"\n37\t\tProfileZAI             = \"zai\"\n38\t\tProfileOpenCodeGo      = \"opencode-go\"\n39\t\tProfileOpenCodeZen     = \"opencode-zen\"\n40\t\tProfileOpenCodeZenFree = \"opencode-zen-free\"\n41\t)\n42\t\n43\t// DefaultRecentActivityCount is the maximum number of entries the dashboard's\n44\t// recent-activity strip may show when Settings.RecentActivityCount is unset\n45\t// (zero) — the pre-existing fixed ceiling of 5.\n46\tconst DefaultRecentActivityCount = 5\n47\t\n48\t// Profile describes one of the subscription profiles manigot can run a session\n49\t// under. Each profile bundles the agent CLI to launch, the credentials it is\n50\t// billed against, and the model the CLI should default to — the whole point is\n51\t// that switching profile, not tool, is what changes which subscription is used.\n52\t//\n53\t// The field set is the complete definition of a profile: the five built-in\n54\t// subscription profiles populate every field, and a user-defined profile (see\n55\t// AddProfile) carries the same full definition so the session launcher, the\n56\t// mg profiles listing, and the mg setup wizard all treat it identically to a\n57\t// built-in. The json tags drive the config/profiles.json store; the built-in\n58\t// table is compiled in, never serialized.\n59\ttype Profile struct {\n60\t\t// ID is the value Settings.Profile (and the session launcher's\n61\t\t// --profile flag) holds: ProfileClaudePro, ProfileZAI, ProfileOpenCodeGo,\n62\t\t// ProfileOpenCodeZen, ProfileOpenCodeZenFree, or a user-defined id.\n63\t\tID string `json:\"id\"`\n64\t\n65\t\t// Label is a short human name for the settings screen and help text.\n66\t\tLabel string `json:\"label\"`\n67\t\n68\t\t// Tool is the agent CLI this profile launches: ToolClaudeCode or\n69\t\t// ToolOpenCode.\n70\t\tTool string `json:\"tool\"`\n71\t\n72\t\t// Auth names the credential the profile is billed against, for display in\n73\t\t// the settings screen and setup help.\n74\t\tAuth string `json:\"auth\"`\n75\t\n76\t\t// AuthKeys lists the .env keys the profile needs to be ready, in the\n77\t\t// order the old scripts checked them: claude-pro needs all four\n78\t\t// subscription keys, the opencode profiles their single auth key. The\n79\t\t// session launcher validates and forwards exactly these keys.\n80\t\tAuthKeys []string `json:\"authKeys,omitempty\"`\n81\t\n82\t\t// ModelEnv is the .env key that overrides the profile's default model\n83\t\t// (e.g. OPENCODE_ZAI_MODEL). claude-pro has none — the CLI's own default.\n84\t\t// Only meaningful for opencode profiles.\n85\t\tModelEnv string `json:\"modelEnv,omitempty\"`\n86\t\n87\t\t// ModelDefault is the model string used when no ModelEnv override is set.\n88\t\t// For claude-pro it is only a display value (\"(Claude Code default)\");\n89\t\t// for opencode profiles it is the compiled-in model the session forwards.\n90\t\tModelDefault string `json:\"modelDefault,omitempty\"`\n91\t}\n92\t\n93\t// builtInProfiles is the ordered list of the built-in subscription profiles,\n94\t// in the order the TUI settings screen cycles them. It is the single source\n95\t// of the per-profile auth/model metadata that used to live scattered across\n96\t// cmd/mg/profiles.go (profileAuthKeys/profileModelEnv/profileModelDefaults) and\n97\t// the hardcoded switch in internal/session. The opencode profiles' effective\n98\t// model comes from the OPENCODE_ZAI_MODEL/OPENCODE_GO_MODEL/OPENCODE_ZEN_MODEL/\n99\t// OPENCODE_ZEN_FREE_MODEL values in manigot's .env, falling back to these\n100\t// ModelDefault strings.\n101\tvar builtInProfiles = []Profile{\n102\t\t{\n103\t\t\tID:           ProfileClaudePro,\n104\t\t\tLabel:        \"Claude Code · Claude Pro\",\n105\t\t\tTool:         ToolClaudeCode,\n106\t\t\tAuth:         \"Claude Pro OAuth\",\n107\t\t\tAuthKeys:     []string{\"CLAUDE_CODE_OAUTH_TOKEN\", \"CLAUDE_ACCOUNT_UUID\", \"CLAUDE_EMAIL\", \"CLAUDE_ORG_UUID\"},\n108\t\t\tModelDefault: \"(Claude Code default)\",\n109\t\t},\n110\t\t{\n111\t\t\tID:           ProfileZAI,\n112\t\t\tLabel:        \"OpenCode · Z.AI Coding Plan\",\n113\t\t\tTool:         ToolOpenCode,\n114\t\t\tAuth:         \"ZHIPU_API_KEY\",\n115\t\t\tAuthKeys:     []string{\"ZHIPU_API_KEY\"},\n116\t\t\tModelEnv:     \"OPENCODE_ZAI_MODEL\",\n117\t\t\tModelDefault: \"zai-coding-plan/glm-5.2\",\n118\t\t},\n119\t\t{\n120\t\t\tID:           ProfileOpenCodeGo,\n121\t\t\tLabel:        \"OpenCode · Go\",\n122\t\t\tTool:         ToolOpenCode,\n123\t\t\tAuth:         \"OPENCODE_API_KEY\",\n124\t\t\tAuthKeys:     []string{\"OPENCODE_API_KEY\"},\n125\t\t\tModelEnv:     \"OPENCODE_GO_MODEL\",\n126\t\t\tModelDefault: \"opencode-go/glm-5.2\",\n127\t\t},\n128\t\t{\n129\t\t\tID:           ProfileOpenCodeZen,\n130\t\t\tLabel:        \"OpenCode · Zen\",\n131\t\t\tTool:         ToolOpenCode,\n132\t\t\tAuth:         \"OPENCODE_API_KEY\",\n133\t\t\tAuthKeys:     []string{\"OPENCODE_API_KEY\"},\n134\t\t\tModelEnv:     \"OPENCODE_ZEN_MODEL\",\n135\t\t\tModelDefault: \"opencode/deepseek-v4-flash\",\n136\t\t},\n137\t\t{\n138\t\t\tID:           ProfileOpenCodeZenFree,\n139\t\t\tLabel:        \"OpenCode · Zen Free\",\n140\t\t\tTool:         ToolOpenCode,\n141\t\t\tAuth:         \"OPENCODE_API_KEY\",\n142\t\t\tAuthKeys:     []string{\"OPENCODE_API_KEY\"},\n143\t\t\tModelEnv:     \"OPENCODE_ZEN_FREE_MODEL\",\n144\t\t\tModelDefault: \"opencode/deepseek-v4-flash-free\",\n145\t\t},\n146\t}\n147\t\n148\t// Profiles returns the supported subscription profiles: the built-in table in\n149\t// its canonical order (which drives the TUI cycle and the mg profiles listing),\n150\t// then any user-defined profiles in file order. A missing or corrupt user store\n151\t// degrades to the built-ins only. The slice is built fresh so a caller cannot\n152\t// mutate the shared table.\n153\tfunc Profiles() []Profile {\n154\t\tps := append([]Profile(nil), builtInProfiles...)\n155\t\tfor _, p := range loadUserProfiles() {\n156\t\t\tps = append(ps, p)\n157\t\t}\n158\t\treturn ps\n159\t}\n160\t\n161\t// ProfileByID returns the profile with the given ID, searching the built-in\n162\t// table first then any user-defined profiles. A missing or corrupt user store\n163\t// degrades to the built-ins only (no error — a bad profiles.json must never\n164\t// break a lookup that the read-only CLI listing, TUI, or session launcher\n165\t// depends on).\n166\tfunc ProfileByID(id string) (Profile, bool) {\n167\t\tfor _, p := range builtInProfiles {\n168\t\t\tif p.ID == id {\n169\t\t\t\treturn p, true\n170\t\t\t}\n171\t\t}\n172\t\tfor _, p := range loadUserProfiles() {\n173\t\t\tif p.ID == id {\n174\t\t\t\treturn p, true\n175\t\t\t}\n176\t\t}\n177\t\treturn Profile{}, false\n178\t}\n179\t\n180\t// profilesPath returns the user-profile store's path (config/profiles.json in\n181\t// the manigot checkout), or \"\" if the checkout cannot be located. The file is\n182\t// machine-specific user state, alongside config/tui-settings.json — both are\n183\t// covered by the /config/ ignore rule and never committed.\n184\tfunc profilesPath() string {\n185\t\tdir := Dir()\n186\t\tif dir == \"\" {\n187\t\t\treturn \"\"\n188\t\t}\n189\t\treturn filepath.Join(dir, \"profiles.json\")\n190\t}\n191\t\n192\t// loadUserProfiles returns the user-defined profiles persisted in\n193\t// config/profiles.json, in file order. A missing or corrupt file is not an\n194\t// error — it degrades to an empty set (\"built-ins only\"), so the read-only\n195\t// paths (Profiles/ProfileByID/TUI) can never be broken by a bad store. It is\n196\t// the error-tolerating wrapper around loadUserProfilesErr for those paths.\n197\tfunc loadUserProfiles() []Profile {\n198\t\tps, _ := loadUserProfilesErr()\n199\t\treturn ps\n200\t}\n201\t\n202\t// loadUserProfilesErr is loadUserProfiles' strict form, used by the write\n203\t// paths (AddProfile/RemoveProfile): it reports a corrupt or unreadable file as\n204\t// an error so the caller does not silently overwrite user state.\n205\tfunc loadUserProfilesErr() ([]Profile, error) {\n206\t\tpath := profilesPath()\n207\t\tif path == \"\" {\n208\t\t\treturn nil, nil\n209\t\t}\n210\t\tdata, err := os.ReadFile(path)\n211\t\tif err != nil {\n212\t\t\tif os.IsNotExist(err) {\n213\t\t\t\treturn nil, nil\n214\t\t\t}\n215\t\t\treturn nil, err\n216\t\t}\n217\t\tvar ps []Profile\n218\t\tif err := json.Unmarshal(data, &ps); err != nil {\n219\t\t\treturn nil, fmt.Errorf(\"%s: %w\", path, err)\n220\t\t}\n221\t\treturn ps, nil\n222\t}\n223\t\n224\t// saveUserProfiles writes the user-defined profiles to config/profiles.json,\n225\t// creating config/ (and the file) as needed.\n226\tfunc saveUserProfiles(ps []Profile) error {\n227\t\tdir := Dir()\n228\t\tif dir == \"\" {\n229\t\t\treturn fmt.Errorf(\"cannot determine the manigot checkout to save profiles into (set $%s)\", home.EnvHome)\n230\t\t}\n231\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n232\t\t\treturn err\n233\t\t}\n234\t\tdata, err := json.MarshalIndent(ps, \"\", \"  \")\n235\t\tif err != nil {\n236\t\t\treturn err\n237\t\t}\n238\t\treturn os.WriteFile(filepath.Join(dir, \"profiles.json\"), data, 0o644)\n239\t}\n240\t\n241\t// AddProfile persists a user-defined profile, appending it after the built-ins\n242\t// and any existing user profiles (file order). The profile id must be unique\n243\t// across the whole set — a collision with a built-in or an existing user\n244\t// profile is rejected. Built-ins are never modified; AddProfile only ever\n245\t// writes the user store.\n246\tfunc AddProfile(p Profile) error {\n247\t\tif strings.TrimSpace(p.ID) == \"\" {\n248\t\t\treturn fmt.Errorf(\"a profile id is required\")\n249\t\t}\n250\t\tfor _, b := range builtInProfiles {\n251\t\t\tif b.ID == p.ID {\n252\t\t\t\treturn fmt.Errorf(\"a built-in profile with id %q already exists\", p.ID)\n253\t\t\t}\n254\t\t}\n255\t\tps, err := loadUserProfilesErr()\n256\t\tif err != nil {\n257\t\t\treturn err\n258\t\t}\n259\t\tfor _, existing := range ps {\n260\t\t\tif existing.ID == p.ID {\n261\t\t\t\treturn fmt.Errorf(\"a profile with id %q already exists\", p.ID)\n262\t\t\t}\n263\t\t}\n264\t\tps = append(ps, p)\n265\t\treturn saveUserProfiles(ps)\n266\t}\n267\t\n268\t// RemoveProfile deletes a user-defined profile by id. Built-in profiles are\n269\t// not deletable — they are the defaults every user starts from; only\n270\t// user-defined ids can be removed. Removing an id that is not in the user\n271\t// store is an error.\n272\tfunc RemoveProfile(id string) error {\n273\t\tps, err := loadUserProfilesErr()\n274\t\tif err != nil {\n275\t\t\treturn err\n276\t\t}\n277\t\tkept := ps[:0]\n278\t\tfound := false\n279\t\tfor _, p := range ps {\n280\t\t\tif p.ID == id {\n281\t\t\t\tfound = true\n282\t\t\t\tcontinue\n283\t\t\t}\n284\t\t\tkept = append(kept, p)\n285\t\t}\n286\t\tif !found {\n287\t\t\treturn fmt.Errorf(\"no user-defined profile with id %q\", id)\n288\t\t}\n289\t\treturn saveUserProfiles(kept)\n290\t}\n291\t\n292\t// ProfileTool returns the agent CLI a profile runs, defaulting to\n293\t// ToolClaudeCode for an unrecognized ID.\n294\tfunc ProfileTool(id string) string {\n295\t\tif p, ok := ProfileByID(id); ok {\n296\t\t\treturn p.Tool\n297\t\t}\n298\t\treturn ToolClaudeCode\n299\t}\n300\t\n301\t// Settings holds the TUI's persisted preferences.\n302\ttype Settings struct {\n303\t\t// Editor is the command run to open brief.md (the detail view's \"e\"\n304\t\t// shortcut), e.g. \"vim\" or \"nano\". Empty means fall back to\n305\t\t// $VISUAL/$EDITOR/nano/vi — see editor.Resolve.\n306\t\tEditor string `json:\"editor\"`\n307\t\n308\t\t// Profile selects the subscription profile launch.Agent/Quick use:\n309\t\t// ProfileClaudePro, ProfileZAI, ProfileOpenCodeGo, ProfileOpenCodeZen or\n310\t\t// ProfileOpenCodeZenFree. It is the shared\n311\t\t// default — loaded from MANIGOT_PROFILE in manigot/.env (with the legacy\n312\t\t// profile/tool fields of tui-settings.json as migration fallbacks) and\n313\t\t// persisted to .env by Save, never to tui-settings.json. Empty is treated\n314\t\t// as ProfileClaudePro — see ProfileValue.\n315\t\tProfile string `json:\"profile,omitempty\"`\n316\t\n317\t\t// RecentActivityCount is the maximum number of entries the dashboard's\n318\t\t// recent-activity strip may show (git.RecentCommits' fetch count and the\n319\t\t// clamp upper bound in recentActivityShown). 0 (unset — the JSON zero\n320\t\t// value) means DefaultRecentActivityCount — see RecentActivityCountValue.\n321\t\t// Valid user-set range is 1–100, enforced by the settings form.\n322\t\tRecentActivityCount int `json:\"recentActivityCount\"`\n323\t\n324\t\t// Tool is the legacy pre-profile selector (ToolClaudeCode/ToolOpenCode),\n325\t\t// kept only so old tui-settings.json files load. It is migrated into\n326\t\t// Profile by Load and never written back.\n327\t\tTool string `json:\"tool,omitempty\"`\n328\t\n329\t\t// Terminal is the command used to spawn an agent session's terminal\n330\t\t// (launch.Agent/Quick/AgentQuick), e.g. \"kitty\" or \"alacritty -e\". Empty\n331\t\t// means fall back to auto-detect (macOS Terminal.app, then a Linux\n332\t\t// emulator list). When set, it applies only when the TUI is not inside\n333\t\t// tmux: inside tmux the launch is always a tmux split pane, regardless of\n334\t\t// this setting — see internal/launch's buildCmd.\n335\t\tTerminal string `json:\"terminal,omitempty\"`\n336\t\n337\t\t// Theme is the global OpenCode theme name (e.g. \"nord\", \"tokyonight\") —\n338\t\t// one value shared across every OpenCode profile, unlike the per-profile\n339\t\t// OPENCODE_*_MODEL keys. It is the shared default: loaded from\n340\t\t// OPENCODE_THEME in manigot/.env and persisted there by Save, never to\n341\t\t// tui-settings.json — mirroring Profile's storage exactly. Empty means\n342\t\t// \"let OpenCode use its own default/config\" — see ThemeValue. Unlike\n343\t\t// Profile, an unrecognized value is still accepted: OpenCode's theme list\n344\t\t// is not validated here (see `mg theme`).\n345\t\tTheme string `json:\"-\"`\n346\t}\n347\t\n348\t// ProfileValue returns s.Profile, defaulting to ProfileClaudePro when unset.\n349\tfunc (s Settings) ProfileValue() string {\n350\t\tif s.Profile == \"\" {\n351\t\t\treturn ProfileClaudePro\n352\t\t}\n353\t\treturn s.Profile\n354\t}\n355\t\n356\t// ThemeValue returns s.Theme, defaulting to \"\" (meaning \"let OpenCode use its\n357\t// own default/config\") when unset. Unlike ProfileValue, there is no non-empty\n358\t// fallback — an empty theme is a legitimate, common choice, not an invalid\n359\t// one.\n360\tfunc (s Settings) ThemeValue() string {\n361\t\treturn s.Theme\n362\t}\n363\t\n364\t// RecentActivityCountValue returns s.RecentActivityCount, defaulting to\n365\t// DefaultRecentActivityCount when unset (≤ 0, the JSON zero value).\n366\tfunc (s Settings) RecentActivityCountValue() int {\n367\t\tif s.RecentActivityCount <= 0 {\n368\t\t\treturn DefaultRecentActivityCount\n369\t\t}\n370\t\treturn s.RecentActivityCount\n371\t}\n372\t\n373\t// EnvFile returns the manigot checkout's .env file path, or \"\" if Dir does.\n374\t// .env is the shared store for the default profile: MANIGOT_PROFILE there is\n375\t// read by bare `mg` runs, written by `mg profiles`, and read/written here so\n376\t// the TUI and CLI share one profile default.\n377\tfunc EnvFile() string {\n378\t\thome := home.Root()\n379\t\tif home == \"\" {\n380\t\t\treturn \"\"\n381\t\t}\n382\t\treturn filepath.Join(home, \".env\")\n383\t}\n384\t\n385\t// GetEnv returns the value of key in the manigot checkout's .env (\"\" when\n386\t// absent or unreadable). Lines may carry an `export ` prefix or surrounding\n387\t// quotes — both are tolerated, mirroring the leniency of sourcing a shell\n388\t// env file. It is the generic form of the profile lookup that\n389\t// readEnvProfile wraps; the ported CLI commands (mg profiles, mg setup) use it\n390\t// to read any credential key.\n391\tfunc GetEnv(key string) string {\n392\t\tv, _ := envValue(key)\n393\t\treturn v\n394\t}\n395\t\n396\t// envValue returns the value of key in the manigot checkout's .env, reporting\n397\t// whether the key was present at all (an explicit \"KEY=\" counts as\n398\t// present-but-empty, which matters once the file is sourced: sourcing\n399\t// overwrites an inherited value with the empty one).\n400\tfunc envValue(key string) (string, bool) {\n401\t\tdata, err := os.ReadFile(EnvFile())\n402\t\tif err != nil {\n403\t\t\treturn \"\", false\n404\t\t}\n405\t\tfor _, line := range strings.Split(string(data), \"\\n\") {\n406\t\t\tline = strings.TrimSpace(line)\n407\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\n408\t\t\t\tcontinue\n409\t\t\t}\n410\t\t\tline = strings.TrimPrefix(line, \"export \")\n411\t\t\tk, value, ok := strings.Cut(line, \"=\")\n412\t\t\tif !ok || strings.TrimSpace(k) != key {\n413\t\t\t\tcontinue\n414\t\t\t}\n415\t\t\treturn unquoteEnvValue(strings.TrimSpace(value)), true\n416\t\t}\n417\t\treturn \"\", false\n418\t}\n419\t\n420\t// EnvValue returns the effective value of key the way the old scripts saw it:\n421\t// the .env value when the key is present there (sourcing exports it into the\n422\t// process environment, overwriting anything inherited), else the process\n423\t// environment. The ported CLI commands use it for readiness checks so an\n424\t// inherited export counts as configured, exactly like the scripts' `${!KEY:-}`\n425\t// reads did.\n426\tfunc EnvValue(key string) string {\n427\t\tif v, ok := envValue(key); ok {\n428\t\t\treturn v\n429\t\t}\n430\t\treturn os.Getenv(key)\n431\t}\n432\t\n433\t// unquoteEnvValue strips one pair of surrounding double or single quotes from\n434\t// an .env value, mirroring how the shell would source it.\n435\tfunc unquoteEnvValue(value string) string {\n436\t\tif len(value) >= 2 {\n437\t\t\tif (value[0] == '\"' && value[len(value)-1] == '\"') ||\n438\t\t\t\t(value[0] == '\\'' && value[len(value)-1] == '\\'') {\n439\t\t\t\treturn value[1 : len(value)-1]\n440\t\t\t}\n441\t\t}\n442\t\treturn value\n443\t}\n444\t\n445\t// UpsertEnv upserts key=value into the manigot checkout's .env, preserving\n446\t// every other line (credentials, comments, model overrides). The file is\n447\t// created with the standard header when it does not exist yet. value is\n448\t// written unquoted, matching the format config's own reader tolerates.\n449\t// It is the generic form of writeEnvProfile; the ported CLI commands use it to\n450\t// write any credential or model key.\n451\tfunc UpsertEnv(key, value string) error {\n452\t\tpath := EnvFile()\n453\t\tif path == \"\" {\n454\t\t\treturn fmt.Errorf(\"cannot determine the manigot checkout to write %s into (set $%s)\", key, home.EnvHome)\n455\t\t}\n456\t\n457\t\tcontent, err := os.ReadFile(path)\n458\t\tvar lines []string\n459\t\tswitch {\n460\t\tcase err == nil:\n461\t\t\tlines = strings.Split(string(content), \"\\n\")\n462\t\tcase os.IsNotExist(err):\n463\t\t\t// Seed a fresh file with the same header scripts/profiles.sh and\n464\t\t\t// scripts/setup.sh write.\n465\t\t\tlines = []string{\"# manigot configuration — credentials and defaults (never commit this file)\"}\n466\t\tdefault:\n467\t\t\treturn err\n468\t\t}\n469\t\n470\t\treplaced := false\n471\t\tfor i, line := range lines {\n472\t\t\ttrimmed := strings.TrimSpace(line)\n473\t\t\tif trimmed == \"\" || strings.HasPrefix(trimmed, \"#\") {\n474\t\t\t\tcontinue\n475\t\t\t}\n476\t\t\tif k, _, ok := strings.Cut(strings.TrimPrefix(trimmed, \"export \"), \"=\"); ok && strings.TrimSpace(k) == key {\n477\t\t\t\tlines[i] = key + \"=\" + value\n478\t\t\t\treplaced = true\n479\t\t\t\tbreak\n480\t\t\t}\n481\t\t}\n482\t\tif !replaced {\n483\t\t\tif last := lines[len(lines)-1]; last == \"\" {\n484\t\t\t\t// The file ended with a newline — reuse the trailing empty\n485\t\t\t\t// element rather than leaving a blank line above the append.\n486\t\t\t\tlines[len(lines)-1] = key + \"=\" + value\n487\t\t\t} else {\n488\t\t\t\t// No trailing newline — add one so the new line starts fresh.\n489\t\t\t\tlines = append(lines, \"\", key+\"=\"+value)\n490\t\t\t}\n491\t\t}\n492\t\n493\t\treturn os.WriteFile(path, []byte(strings.Join(lines, \"\\n\")), 0o644)\n494\t}\n495\t\n496\t// readEnvProfile returns the MANIGOT_PROFILE value from manigot/.env (\"\" when\n497\t// absent or unreadable). It is a best-effort scan tolerant of shell-isms in\n498\t// the file: a missing .env is the normal pre-first\n499\t// save state and the caller falls back to the legacy tui-settings.json fields\n500\t// and finally to ProfileClaudePro. Lines may carry an `export ` prefix or\n501\t// surrounding quotes — both are tolerated.\n502\tfunc readEnvProfile() string {\n503\t\treturn GetEnv(\"MANIGOT_PROFILE\")\n504\t}\n505\t\n506\t// writeEnvProfile upserts MANIGOT_PROFILE=<profile> into manigot/.env,\n507\t// preserving every other line (credentials, comments, model overrides). The\n508\t// file is created with the standard header when it does not exist yet.\n509\t// profile must already be validated by the caller (see Save); it is written\n510\t// unquoted, matching the format config's own reader tolerates.\n511\tfunc writeEnvProfile(profile string) error {\n512\t\treturn UpsertEnv(\"MANIGOT_PROFILE\", profile)\n513\t}\n514\t\n515\t// Dir returns the directory the settings file lives in: config/ inside the\n516\t// manigot checkout the running binary belongs to (see home.Root). It is\n517\t// \"\" if that checkout could not be located.\n518\tfunc Dir() string {\n519\t\thome := home.Root()\n520\t\tif home == \"\" {\n521\t\t\treturn \"\"\n522\t\t}\n523\t\treturn filepath.Join(home, \"config\")\n524\t}\n525\t\n526\t// Path returns the settings file's path, or \"\" if Dir does.\n527\tfunc Path() string {\n528\t\tdir := Dir()\n529\t\tif dir == \"\" {\n530\t\t\treturn \"\"\n531\t\t}\n532\t\treturn filepath.Join(dir, \"tui-settings.json\")\n533\t}\n534\t\n535\t// Load reads the settings. A file that does not exist yet (nothing has been\n536\t// saved, or the checkout could not be located) is not an error — it yields the\n537\t// zero-value Settings, which every caller treats as \"defaults\".\n538\t//\n539\t// Profile resolution order: MANIGOT_PROFILE in manigot/.env — the shared,\n540\t// central store, written by both `mg profiles` and the TUI's settings screen —\n541\t// wins when present and valid. Failing that, the legacy `profile` field of\n542\t// tui-settings.json (and the even older `tool` field, migrated:\n543\t// \"claude-code\" maps to ProfileClaudePro, \"opencode\" maps to ProfileZAI) is\n544\t// honored as a migration fallback so an existing user's choice survives the\n545\t// upgrade. Neither legacy field is written back — Save persists the profile to\n546\t// .env only.\n547\tfunc Load() (Settings, error) {\n548\t\tpath := Path()\n549\t\tvar s Settings\n550\t\tif path != \"\" {\n551\t\t\tdata, err := os.ReadFile(path)\n552\t\t\tswitch {\n553\t\t\tcase err == nil:\n554\t\t\t\tif err := json.Unmarshal(data, &s); err != nil {\n555\t\t\t\t\treturn Settings{}, fmt.Errorf(\"%s: %w\", path, err)\n556\t\t\t\t}\n557\t\t\tcase os.IsNotExist(err):\n558\t\t\t\t// nothing saved yet — zero value, defaults apply\n559\t\t\tdefault:\n560\t\t\t\treturn Settings{}, err\n561\t\t\t}\n562\t\t}\n563\t\n564\t\tif envProfile := readEnvProfile(); envProfile != \"\" {\n565\t\t\tif _, ok := ProfileByID(envProfile); ok {\n566\t\t\t\ts.Profile = envProfile\n567\t\t\t}\n568\t\t}\n569\t\tif s.Profile == \"\" && s.Tool != \"\" {\n570\t\t\tswitch s.Tool {\n571\t\t\tcase ToolOpenCode:\n572\t\t\t\ts.Profile = ProfileZAI\n573\t\t\tdefault:\n574\t\t\t\ts.Profile = ProfileClaudePro\n575\t\t\t}\n576\t\t}\n577\t\ts.Tool = \"\" // legacy field — not written back\n578\t\ts.Theme = GetEnv(\"OPENCODE_THEME\")\n579\t\treturn s, nil\n580\t}\n581\t\n582\t// Save writes s to disk: the editor to config/tui-settings.json (creating\n583\t// config/ if needed) and the profile to manigot/.env as MANIGOT_PROFILE —\n584\t// the shared default bare `mg` and the TUI both use. The profile is no longer\n585\t// written to tui-settings.json: that field (like the older `tool` field) is\n586\t// legacy, read for migration by Load only.\n587\tfunc Save(s Settings) error {\n588\t\tdir := Dir()\n589\t\tif dir == \"\" {\n590\t\t\treturn fmt.Errorf(\"cannot determine the manigot checkout to save settings into (set $%s)\", home.EnvHome)\n591\t\t}\n592\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n593\t\t\treturn err\n594\t\t}\n595\t\tlegacy := s\n596\t\tlegacy.Profile = \"\" // not persisted here anymore — `omitempty` drops it\n597\t\tdata, err := json.MarshalIndent(legacy, \"\", \"  \")\n598\t\tif err != nil {\n599\t\t\treturn err\n600\t\t}\n601\t\tif err := os.WriteFile(filepath.Join(dir, \"tui-settings.json\"), data, 0o644); err != nil {\n602\t\t\treturn err\n603\t\t}\n604\t\n605\t\tprofile := s.ProfileValue()\n606\t\tif _, ok := ProfileByID(profile); !ok {\n607\t\t\treturn fmt.Errorf(\"cannot save: %q is not a valid profile id\", profile)\n608\t\t}\n609\t\tif err := writeEnvProfile(profile); err != nil {\n610\t\t\treturn err\n611\t\t}\n612\t\treturn UpsertEnv(\"OPENCODE_THEME\", s.Theme)\n613\t}\n614\t"}]},"parent_tool_use_id":null,"session_id":"0ad41780-e2e7-4ebf-861d-9c61d66ababf","uuid":"dc4cb447-a137-425a-831a-947ecd1980d2","timestamp":"2026-08-29T08:59:37.180Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/config/config.go","content":"// Package config persists local TUI preferences across sessions: which\n// editor to open brief.md in, how many entries the dashboard's recent-activity\n// strip may show, and which subscription profile (a bundle of agent CLI +\n// credentials + model) launch.Agent starts a session under.\n//\n// The editor lives in config/tui-settings.json in the manigot checkout. The\n// profile lives in manigot/.env as MANIGOT_PROFILE — the value bare `mg` runs\n// and `mg profiles` write, so CLI and TUI share one profile default. The settings screen (see ui/settings.go)\n// is the only writer; every other reader treats a missing or unreadable file\n// as \"use the defaults\" rather than an error.\npackage config\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/home\"\n)\n\n// ToolClaudeCode and ToolOpenCode are the legacy tool values once held by\n// Settings.Tool (and still accepted by the session launcher's --tool alias).\n// New code should use Profiles instead.\nconst (\n\tToolClaudeCode = \"claude-code\"\n\tToolOpenCode   = \"opencode\"\n)\n\n// ProfileClaudePro, ProfileZAI, ProfileOpenCodeGo, ProfileOpenCodeZen and\n// ProfileOpenCodeZenFree are the five supported subscription profiles:\n// Settings.Profile holds one of them, and the session launcher accepts them\n// as --profile values.\nconst (\n\tProfileClaudePro       = \"claude-pro\"\n\tProfileZAI             = \"zai\"\n\tProfileOpenCodeGo      = \"opencode-go\"\n\tProfileOpenCodeZen     = \"opencode-zen\"\n\tProfileOpenCodeZenFree = \"opencode-zen-free\"\n)\n\n// DefaultRecentActivityCount is the maximum number of entries the dashboard's\n// recent-activity strip may show when Settings.RecentActivityCount is unset\n// (zero) — the pre-existing fixed ceiling of 5.\nconst DefaultRecentActivityCount = 5\n\n// Profile describes one of the subscription profiles manigot can run a session\n// under. Each profile bundles the agent CLI to launch, the credentials it is\n// billed against, and the model the CLI should default to — the whole point is\n// that switching profile, not tool, is what changes which subscription is used.\n//\n// The field set is the complete definition of a profile: the five built-in\n// subscription profiles populate every field, and a user-defined profile (see\n// AddProfile) carries the same full definition so the session launcher, the\n// mg profiles listing, and the mg setup wizard all treat it identically to a\n// built-in. The json tags drive the config/profiles.json store; the built-in\n// table is compiled in, never serialized.\ntype Profile struct {\n\t// ID is the value Settings.Profile (and the session launcher's\n\t// --profile flag) holds: ProfileClaudePro, ProfileZAI, ProfileOpenCodeGo,\n\t// ProfileOpenCodeZen, ProfileOpenCodeZenFree, or a user-defined id.\n\tID string `json:\"id\"`\n\n\t// Label is a short human name for the settings screen and help text.\n\tLabel string `json:\"label\"`\n\n\t// Tool is the agent CLI this profile launches: ToolClaudeCode or\n\t// ToolOpenCode.\n\tTool string `json:\"tool\"`\n\n\t// Auth names the credential the profile is billed against, for display in\n\t// the settings screen and setup help.\n\tAuth string `json:\"auth\"`\n\n\t// AuthKeys lists the .env keys the profile needs to be ready, in the\n\t// order the old scripts checked them: claude-pro needs all four\n\t// subscription keys, the opencode profiles their single auth key. The\n\t// session launcher validates and forwards exactly these keys.\n\tAuthKeys []string `json:\"authKeys,omitempty\"`\n\n\t// ModelEnv is the .env key that overrides the profile's default model\n\t// (e.g. OPENCODE_ZAI_MODEL). claude-pro has none — the CLI's own default.\n\t// Only meaningful for opencode profiles.\n\tModelEnv string `json:\"modelEnv,omitempty\"`\n\n\t// ModelDefault is the model string used when no ModelEnv override is set.\n\t// For claude-pro it is only a display value (\"(Claude Code default)\");\n\t// for opencode profiles it is the compiled-in model the session forwards.\n\tModelDefault string `json:\"modelDefault,omitempty\"`\n}\n\n// builtInProfiles is the ordered list of the built-in subscription profiles,\n// in the order the TUI settings screen cycles them. It is the single source\n// of the per-profile auth/model metadata that used to live scattered across\n// cmd/mg/profiles.go (profileAuthKeys/profileModelEnv/profileModelDefaults) and\n// the hardcoded switch in internal/session. The opencode profiles' effective\n// model comes from the OPENCODE_ZAI_MODEL/OPENCODE_GO_MODEL/OPENCODE_ZEN_MODEL/\n// OPENCODE_ZEN_FREE_MODEL values in manigot's .env, falling back to these\n// ModelDefault strings.\nvar builtInProfiles = []Profile{\n\t{\n\t\tID:           ProfileClaudePro,\n\t\tLabel:        \"Claude Code · Claude Pro\",\n\t\tTool:         ToolClaudeCode,\n\t\tAuth:         \"Claude Pro OAuth\",\n\t\tAuthKeys:     []string{\"CLAUDE_CODE_OAUTH_TOKEN\", \"CLAUDE_ACCOUNT_UUID\", \"CLAUDE_EMAIL\", \"CLAUDE_ORG_UUID\"},\n\t\tModelDefault: \"(Claude Code default)\",\n\t},\n\t{\n\t\tID:           ProfileZAI,\n\t\tLabel:        \"OpenCode · Z.AI Coding Plan\",\n\t\tTool:         ToolOpenCode,\n\t\tAuth:         \"ZHIPU_API_KEY\",\n\t\tAuthKeys:     []string{\"ZHIPU_API_KEY\"},\n\t\tModelEnv:     \"OPENCODE_ZAI_MODEL\",\n\t\tModelDefault: \"zai-coding-plan/glm-5.2\",\n\t},\n\t{\n\t\tID:           ProfileOpenCodeGo,\n\t\tLabel:        \"OpenCode · Go\",\n\t\tTool:         ToolOpenCode,\n\t\tAuth:         \"OPENCODE_API_KEY\",\n\t\tAuthKeys:     []string{\"OPENCODE_API_KEY\"},\n\t\tModelEnv:     \"OPENCODE_GO_MODEL\",\n\t\tModelDefault: \"opencode-go/glm-5.2\",\n\t},\n\t{\n\t\tID:           ProfileOpenCodeZen,\n\t\tLabel:        \"OpenCode · Zen\",\n\t\tTool:         ToolOpenCode,\n\t\tAuth:         \"OPENCODE_API_KEY\",\n\t\tAuthKeys:     []string{\"OPENCODE_API_KEY\"},\n\t\tModelEnv:     \"OPENCODE_ZEN_MODEL\",\n\t\tModelDefault: \"opencode/deepseek-v4-flash\",\n\t},\n\t{\n\t\tID:           ProfileOpenCodeZenFree,\n\t\tLabel:        \"OpenCode · Zen Free\",\n\t\tTool:         ToolOpenCode,\n\t\tAuth:         \"OPENCODE_API_KEY\",\n\t\tAuthKeys:     []string{\"OPENCODE_API_KEY\"},\n\t\tModelEnv:     \"OPENCODE_ZEN_FREE_MODEL\",\n\t\tModelDefault: \"opencode/deepseek-v4-flash-free\",\n\t},\n}\n\n// Profiles returns the supported subscription profiles: the built-in table in\n// its canonical order (which drives the TUI cycle and the mg profiles listing),\n// then any user-defined profiles in file order. A missing or corrupt user store\n// degrades to the built-ins only. The slice is built fresh so a caller cannot\n// mutate the shared table.\nfunc Profiles() []Profile {\n\tps := append([]Profile(nil), builtInProfiles...)\n\tfor _, p := range loadUserProfiles() {\n\t\tps = append(ps, p)\n\t}\n\treturn ps\n}\n\n// ProfileByID returns the profile with the given ID, searching the built-in\n// table first then any user-defined profiles. A missing or corrupt user store\n// degrades to the built-ins only (no error — a bad profiles.json must never\n// break a lookup that the read-only CLI listing, TUI, or session launcher\n// depends on).\nfunc ProfileByID(id string) (Profile, bool) {\n\tfor _, p := range builtInProfiles {\n\t\tif p.ID == id {\n\t\t\treturn p, true\n\t\t}\n\t}\n\tfor _, p := range loadUserProfiles() {\n\t\tif p.ID == id {\n\t\t\treturn p, true\n\t\t}\n\t}\n\treturn Profile{}, false\n}\n\n// profilesPath returns the user-profile store's path (config/profiles.json in\n// the manigot checkout), or \"\" if the checkout cannot be located. The file is\n// machine-specific user state, alongside config/tui-settings.json — both are\n// covered by the /config/ ignore rule and never committed.\nfunc profilesPath() string {\n\tdir := Dir()\n\tif dir == \"\" {\n\t\treturn \"\"\n\t}\n\treturn filepath.Join(dir, \"profiles.json\")\n}\n\n// loadUserProfiles returns the user-defined profiles persisted in\n// config/profiles.json, in file order. A missing or corrupt file is not an\n// error — it degrades to an empty set (\"built-ins only\"), so the read-only\n// paths (Profiles/ProfileByID/TUI) can never be broken by a bad store. It is\n// the error-tolerating wrapper around loadUserProfilesErr for those paths.\nfunc loadUserProfiles() []Profile {\n\tps, _ := loadUserProfilesErr()\n\treturn ps\n}\n\n// loadUserProfilesErr is loadUserProfiles' strict form, used by the write\n// paths (AddProfile/RemoveProfile): it reports a corrupt or unreadable file as\n// an error so the caller does not silently overwrite user state.\nfunc loadUserProfilesErr() ([]Profile, error) {\n\tpath := profilesPath()\n\tif path == \"\" {\n\t\treturn nil, nil\n\t}\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn nil, nil\n\t\t}\n\t\treturn nil, err\n\t}\n\tvar ps []Profile\n\tif err := json.Unmarshal(data, &ps); err != nil {\n\t\treturn nil, fmt.Errorf(\"%s: %w\", path, err)\n\t}\n\treturn ps, nil\n}\n\n// saveUserProfiles writes the user-defined profiles to config/profiles.json,\n// creating config/ (and the file) as needed.\nfunc saveUserProfiles(ps []Profile) error {\n\tdir := Dir()\n\tif dir == \"\" {\n\t\treturn fmt.Errorf(\"cannot determine the manigot checkout to save profiles into (set $%s)\", home.EnvHome)\n\t}\n\tif err := os.MkdirAll(dir, 0o755); err != nil {\n\t\treturn err\n\t}\n\tdata, err := json.MarshalIndent(ps, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.WriteFile(filepath.Join(dir, \"profiles.json\"), data, 0o644)\n}\n\n// AddProfile persists a user-defined profile, appending it after the built-ins\n// and any existing user profiles (file order). The profile id must be unique\n// across the whole set — a collision with a built-in or an existing user\n// profile is rejected. Built-ins are never modified; AddProfile only ever\n// writes the user store.\nfunc AddProfile(p Profile) error {\n\tif strings.TrimSpace(p.ID) == \"\" {\n\t\treturn fmt.Errorf(\"a profile id is required\")\n\t}\n\tfor _, b := range builtInProfiles {\n\t\tif b.ID == p.ID {\n\t\t\treturn fmt.Errorf(\"a built-in profile with id %q already exists\", p.ID)\n\t\t}\n\t}\n\tps, err := loadUserProfilesErr()\n\tif err != nil {\n\t\treturn err\n\t}\n\tfor _, existing := range ps {\n\t\tif existing.ID == p.ID {\n\t\t\treturn fmt.Errorf(\"a profile with id %q already exists\", p.ID)\n\t\t}\n\t}\n\tps = append(ps, p)\n\treturn saveUserProfiles(ps)\n}\n\n// RemoveProfile deletes a user-defined profile by id. Built-in profiles are\n// not deletable — they are the defaults every user starts from; only\n// user-defined ids can be removed. Removing an id that is not in the user\n// store is an error.\nfunc RemoveProfile(id string) error {\n\tps, err := loadUserProfilesErr()\n\tif err != nil {\n\t\treturn err\n\t}\n\tkept := ps[:0]\n\tfound := false\n\tfor _, p := range ps {\n\t\tif p.ID == id {\n\t\t\tfound = true\n\t\t\tcontinue\n\t\t}\n\t\tkept = append(kept, p)\n\t}\n\tif !found {\n\t\treturn fmt.Errorf(\"no user-defined profile with id %q\", id)\n\t}\n\treturn saveUserProfiles(kept)\n}\n\n// ProfileTool returns the agent CLI a profile runs, defaulting to\n// ToolClaudeCode for an unrecognized ID.\nfunc ProfileTool(id string) string {\n\tif p, ok := ProfileByID(id); ok {\n\t\treturn p.Tool\n\t}\n\treturn ToolClaudeCode\n}\n\n// Settings holds the TUI's persisted preferences.\ntype Settings struct {\n\t// Editor is the command run to open brief.md (the detail view's \"e\"\n\t// shortcut), e.g. \"vim\" or \"nano\". Empty means fall back to\n\t// $VISUAL/$EDITOR/nano/vi — see editor.Resolve.\n\tEditor string `json:\"editor\"`\n\n\t// Profile selects the subscription profile launch.Agent/Quick use:\n\t// ProfileClaudePro, ProfileZAI, ProfileOpenCodeGo, ProfileOpenCodeZen or\n\t// ProfileOpenCodeZenFree. It is the shared\n\t// default — loaded from MANIGOT_PROFILE in manigot/.env (with the legacy\n\t// profile/tool fields of tui-settings.json as migration fallbacks) and\n\t// persisted to .env by Save, never to tui-settings.json. Empty is treated\n\t// as ProfileClaudePro — see ProfileValue.\n\tProfile string `json:\"profile,omitempty\"`\n\n\t// RecentActivityCount is the maximum number of entries the dashboard's\n\t// recent-activity strip may show (git.RecentCommits' fetch count and the\n\t// clamp upper bound in recentActivityShown). 0 (unset — the JSON zero\n\t// value) means DefaultRecentActivityCount — see RecentActivityCountValue.\n\t// Valid user-set range is 1–100, enforced by the settings form.\n\tRecentActivityCount int `json:\"recentActivityCount\"`\n\n\t// Tool is the legacy pre-profile selector (ToolClaudeCode/ToolOpenCode),\n\t// kept only so old tui-settings.json files load. It is migrated into\n\t// Profile by Load and never written back.\n\tTool string `json:\"tool,omitempty\"`\n\n\t// Terminal is the command used to spawn an agent session's terminal\n\t// (launch.Agent/Quick/AgentQuick), e.g. \"kitty\" or \"alacritty -e\". Empty\n\t// means fall back to auto-detect (macOS Terminal.app, then a Linux\n\t// emulator list). When set, it applies only when the TUI is not inside\n\t// tmux: inside tmux the launch is always a tmux split pane, regardless of\n\t// this setting — see internal/launch's buildCmd.\n\tTerminal string `json:\"terminal,omitempty\"`\n\n\t// Theme is the global OpenCode theme name (e.g. \"nord\", \"tokyonight\") —\n\t// one value shared across every OpenCode profile, unlike the per-profile\n\t// OPENCODE_*_MODEL keys. It is the shared default: loaded from\n\t// OPENCODE_THEME in manigot/.env and persisted there by Save, never to\n\t// tui-settings.json — mirroring Profile's storage exactly. Empty means\n\t// \"let OpenCode use its own default/config\" — see ThemeValue. Unlike\n\t// Profile, an unrecognized value is still accepted: OpenCode's theme list\n\t// is not validated here (see `mg theme`).\n\tTheme string `json:\"-\"`\n}\n\n// ProfileValue returns s.Profile, defaulting to ProfileClaudePro when unset.\nfunc (s Settings) ProfileValue() string {\n\tif s.Profile == \"\" {\n\t\treturn ProfileClaudePro\n\t}\n\treturn s.Profile\n}\n\n// ThemeValue returns s.Theme, defaulting to \"\" (meaning \"let OpenCode use its\n// own default/config\") when unset. Unlike ProfileValue, there is no non-empty\n// fallback — an empty theme is a legitimate, common choice, not an invalid\n// one.\nfunc (s Settings) ThemeValue() string {\n\treturn s.Theme\n}\n\n// RecentActivityCountValue returns s.RecentActivityCount, defaulting to\n// DefaultRecentActivityCount when unset (≤ 0, the JSON zero value).\nfunc (s Settings) RecentActivityCountValue() int {\n\tif s.RecentActivityCount <= 0 {\n\t\treturn DefaultRecentActivityCount\n\t}\n\treturn s.RecentActivityCount\n}\n\n// EnvFile returns the manigot checkout's .env file path, or \"\" if Dir does.\n// .env is the shared store for the default profile: MANIGOT_PROFILE there is\n// read by bare `mg` runs, written by `mg profiles`, and read/written here so\n// the TUI and CLI share one profile default.\nfunc EnvFile() string {\n\thome := home.Root()\n\tif home == \"\" {\n\t\treturn \"\"\n\t}\n\treturn filepath.Join(home, \".env\")\n}\n\n// GetEnv returns the value of key in the manigot checkout's .env (\"\" when\n// absent or unreadable). Lines may carry an `export ` prefix or surrounding\n// quotes — both are tolerated, mirroring the leniency of sourcing a shell\n// env file. It is the generic form of the profile lookup that\n// readEnvProfile wraps; the ported CLI commands (mg profiles, mg setup) use it\n// to read any credential key.\nfunc GetEnv(key string) string {\n\tv, _ := envValue(key)\n\treturn v\n}\n\n// envValue returns the value of key in the manigot checkout's .env, reporting\n// whether the key was present at all (an explicit \"KEY=\" counts as\n// present-but-empty, which matters once the file is sourced: sourcing\n// overwrites an inherited value with the empty one).\nfunc envValue(key string) (string, bool) {\n\tdata, err := os.ReadFile(EnvFile())\n\tif err != nil {\n\t\treturn \"\", false\n\t}\n\tfor _, line := range strings.Split(string(data), \"\\n\") {\n\t\tline = strings.TrimSpace(line)\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\n\t\t\tcontinue\n\t\t}\n\t\tline = strings.TrimPrefix(line, \"export \")\n\t\tk, value, ok := strings.Cut(line, \"=\")\n\t\tif !ok || strings.TrimSpace(k) != key {\n\t\t\tcontinue\n\t\t}\n\t\treturn unquoteEnvValue(strings.TrimSpace(value)), true\n\t}\n\treturn \"\", false\n}\n\n// EnvValue returns the effective value of key the way the old scripts saw it:\n// the .env value when the key is present there (sourcing exports it into the\n// process environment, overwriting anything inherited), else the process\n// environment. The ported CLI commands use it for readiness checks so an\n// inherited export counts as configured, exactly like the scripts' `${!KEY:-}`\n// reads did.\nfunc EnvValue(key string) string {\n\tif v, ok := envValue(key); ok {\n\t\treturn v\n\t}\n\treturn os.Getenv(key)\n}\n\n// unquoteEnvValue strips one pair of surrounding double or single quotes from\n// an .env value, mirroring how the shell would source it.\nfunc unquoteEnvValue(value string) string {\n\tif len(value) >= 2 {\n\t\tif (value[0] == '\"' && value[len(value)-1] == '\"') ||\n\t\t\t(value[0] == '\\'' && value[len(value)-1] == '\\'') {\n\t\t\treturn value[1 : len(value)-1]\n\t\t}\n\t}\n\treturn value\n}\n\n// UpsertEnv upserts key=value into the manigot checkout's .env, preserving\n// every other line (credentials, comments, model overrides). The file is\n// created with the standard header when it does not exist yet. value is\n// written unquoted, matching the format config's own reader tolerates.\n// It is the generic form of writeEnvProfile; the ported CLI commands use it to\n// write any credential or model key.\nfunc UpsertEnv(key, value string) error {\n\tpath := EnvFile()\n\tif path == \"\" {\n\t\treturn fmt.Errorf(\"cannot determine the manigot checkout to write %s into (set $%s)\", key, home.EnvHome)\n\t}\n\n\tcontent, err := os.ReadFile(path)\n\tvar lines []string\n\tswitch {\n\tcase err == nil:\n\t\tlines = strings.Split(string(content), \"\\n\")\n\tcase os.IsNotExist(err):\n\t\t// Seed a fresh file with the same header scripts/profiles.sh and\n\t\t// scripts/setup.sh write.\n\t\tlines = []string{\"# manigot configuration — credentials and defaults (never commit this file)\"}\n\tdefault:\n\t\treturn err\n\t}\n\n\treplaced := false\n\tfor i, line := range lines {\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tif trimmed == \"\" || strings.HasPrefix(trimmed, \"#\") {\n\t\t\tcontinue\n\t\t}\n\t\tif k, _, ok := strings.Cut(strings.TrimPrefix(trimmed, \"export \"), \"=\"); ok && strings.TrimSpace(k) == key {\n\t\t\tlines[i] = key + \"=\" + value\n\t\t\treplaced = true\n\t\t\tbreak\n\t\t}\n\t}\n\tif !replaced {\n\t\tif last := lines[len(lines)-1]; last == \"\" {\n\t\t\t// The file ended with a newline — reuse the trailing empty\n\t\t\t// element rather than leaving a blank line above the append.\n\t\t\tlines[len(lines)-1] = key + \"=\" + value\n\t\t} else {\n\t\t\t// No trailing newline — add one so the new line starts fresh.\n\t\t\tlines = append(lines, \"\", key+\"=\"+value)\n\t\t}\n\t}\n\n\treturn os.WriteFile(path, []byte(strings.Join(lines, \"\\n\")), 0o644)\n}\n\n// readEnvProfile returns the MANIGOT_PROFILE value from manigot/.env (\"\" when\n// absent or unreadable). It is a best-effort scan tolerant of shell-isms in\n// the file: a missing .env is the normal pre-first\n// save state and the caller falls back to the legacy tui-settings.json fields\n// and finally to ProfileClaudePro. Lines may carry an `export ` prefix or\n// surrounding quotes — both are tolerated.\nfunc readEnvProfile() string {\n\treturn GetEnv(\"MANIGOT_PROFILE\")\n}\n\n// writeEnvProfile upserts MANIGOT_PROFILE=<profile> into manigot/.env,\n// preserving every other line (credentials, comments, model overrides). The\n// file is created with the standard header when it does not exist yet.\n// profile must already be validated by the caller (see Save); it is written\n// unquoted, matching the format config's own reader tolerates.\nfunc writeEnvProfile(profile string) error {\n\treturn UpsertEnv(\"MANIGOT_PROFILE\", profile)\n}\n\n// Dir returns the directory the settings file lives in: config/ inside the\n// manigot checkout the running binary belongs to (see home.Root). It is\n// \"\" if that checkout could not be located.\nfunc Dir() string {\n\thome := home.Root()\n\tif home == \"\" {\n\t\treturn \"\"\n\t}\n\treturn filepath.Join(home, \"config\")\n}\n\n// Path returns the settings file's path, or \"\" if Dir does.\nfunc Path() string {\n\tdir := Dir()\n\tif dir == \"\" {\n\t\treturn \"\"\n\t}\n\treturn filepath.Join(dir, \"tui-settings.json\")\n}\n\n// Load reads the settings. A file that does not exist yet (nothing has been\n// saved, or the checkout could not be located) is not an error — it yields the\n// zero-value Settings, which every caller treats as \"defaults\".\n//\n// Profile resolution order: MANIGOT_PROFILE in manigot/.env — the shared,\n// central store, written by both `mg profiles` and the TUI's settings screen —\n// wins when present and valid. Failing that, the legacy `profile` field of\n// tui-settings.json (and the even older `tool` field, migrated:\n// \"claude-code\" maps to ProfileClaudePro, \"opencode\" maps to ProfileZAI) is\n// honored as a migration fallback so an existing user's choice survives the\n// upgrade. Neither legacy field is written back — Save persists the profile to\n// .env only.\nfunc Load() (Settings, error) {\n\tpath := Path()\n\tvar s Settings\n\tif path != \"\" {\n\t\tdata, err := os.ReadFile(path)\n\t\tswitch {\n\t\tcase err == nil:\n\t\t\tif err := json.Unmarshal(data, &s); err != nil {\n\t\t\t\treturn Settings{}, fmt.Errorf(\"%s: %w\", path, err)\n\t\t\t}\n\t\tcase os.IsNotExist(err):\n\t\t\t// nothing saved yet — zero value, defaults apply\n\t\tdefault:\n\t\t\treturn Settings{}, err\n\t\t}\n\t}\n\n\tif envProfile := readEnvProfile(); envProfile != \"\" {\n\t\tif _, ok := ProfileByID(envProfile); ok {\n\t\t\ts.Profile = envProfile\n\t\t}\n\t}\n\tif s.Profile == \"\" && s.Tool != \"\" {\n\t\tswitch s.Tool {\n\t\tcase ToolOpenCode:\n\t\t\ts.Profile = ProfileZAI\n\t\tdefault:\n\t\t\ts.Profile = ProfileClaudePro\n\t\t}\n\t}\n\ts.Tool = \"\" // legacy field — not written back\n\ts.Theme = GetEnv(\"OPENCODE_THEME\")\n\treturn s, nil\n}\n\n// Save writes s to disk: the editor to config/tui-settings.json (creating\n// config/ if needed) and the profile to manigot/.env as MANIGOT_PROFILE —\n// the shared default bare `mg` and the TUI both use. The profile is no longer\n// written to tui-settings.json: that field (like the older `tool` field) is\n// legacy, read for migration by Load only.\nfunc Save(s Settings) error {\n\tdir := Dir()\n\tif dir == \"\" {\n\t\treturn fmt.Errorf(\"cannot determine the manigot checkout to save settings into (set $%s)\", home.EnvHome)\n\t}\n\tif err := os.MkdirAll(dir, 0o755); err != nil {\n\t\treturn err\n\t}\n\tlegacy := s\n\tlegacy.Profile = \"\" // not persisted here anymore — `omitempty` drops it\n\tdata, err := json.MarshalIndent(legacy, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := os.WriteFile(filepath.Join(dir, \"tui-settings.json\"), data, 0o644); err != nil {\n\t\treturn err\n\t}\n\n\tprofile := s.ProfileValue()\n\tif _, ok := ProfileByID(profile); !ok {\n\t\treturn fmt.Errorf(\"cannot save: %q is not a valid profile id\", profile)\n\t}\n\tif err := writeEnvProfile(profile); err != nil {\n\t\treturn err\n\t}\n\treturn UpsertEnv(\"OPENCODE_THEME\", s.Theme)\n}\n","numLines":614,"startLine":1,"totalLines":614}}}
