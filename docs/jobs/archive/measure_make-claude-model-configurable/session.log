tt.Errorf(\"--model value = %v, want sonnet\", inv.Argv)\n\t}\n}\n\n// TestBuildClaudeProNoModelFlag pins the no-model case: claude-pro's ClaudeModel\n// resolves to \"\", so no --model flag is added — unchanged argv shape.\nfunc TestBuildClaudeProNoModelFlag(t *testing.T) {\n\tdocProject(t)\n\tinfo, err := ResolveProfile(Options{})\n\tif err != nil {\n\t\tt.Fatalf(\"ResolveProfile: %v\", err)\n\t}\n\tr, err := ResolveRoot(Options{})\n\tif err != nil {\n\t\tt.Fatalf(\"ResolveRoot: %v\", err)\n\t}\n\tinv, err := BuildDockerInvocation(Options{}, info, r, false, &strings.Builder{})\n\tif err != nil {\n\t\tt.Fatalf(\"BuildDockerInvocation: %v\", err)\n\t}\n\tif indexOf(inv.Argv, \"--model\") != -1 {\n\t\tt.Errorf(\"claude-pro session should not carry --model: %v\", inv.Argv)\n\t}\n}\n\n// indexOf returns the index of the first occurrence of s in argv, or -1.\nfunc indexOf(argv []string, s string) int {\n\tfor i, v := range argv {\n\t\tif v == s {\n\t\t\treturn i\n\t\t}\n\t}\n\treturn -1\n}\n\nfunc TestEnvShadowMounts(t *testing.T) {"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":887,"cache_read_input_tokens":124516,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":887},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0ad41780-e2e7-4ebf-861d-9c61d66ababf","uuid":"b136b5e5-c56e-4fcd-8713-d5d0db5c9827","timestamp":"2026-08-29T09:02:40.985Z","request_id":"req_011CeWmZ8H5Mtmszjt6xCv7z"}
