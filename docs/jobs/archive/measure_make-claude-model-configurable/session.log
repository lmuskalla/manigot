{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GCPSBP3BMytHrYmVWDFFXT","type":"tool_result","content":"1\t// Host mode (mg host) is the counterpart of the docker session path in\n2\t// docker.go: instead of assembling a `docker run` argv, it assembles a direct\n3\t// invocation of the profile's agent CLI (claude / opencode) running on the\n4\t// host itself — no container, no mounts, no isolation. Everything before the\n5\t// launch (ParseArgs, ResolveProfile, ResolveRoot, CheckAuth) is shared; only\n6\t// the last step differs.\n7\t//\n8\t// Host mode is for work that must happen on the host — outside the container.\n9\t// The CLIs are launched exactly as installed on the host: no auto-approval\n10\t// flags (--dangerously-skip-permissions / --auto are only safe inside the\n11\t// isolated, ephemeral container), so the user supervises every tool call.\n12\tpackage session\n13\t\n14\timport (\n15\t\t\"fmt\"\n16\t\t\"io\"\n17\t\t\"os\"\n18\t\t\"os/exec\"\n19\t\t\"path/filepath\"\n20\t\t\"strings\"\n21\t\n22\t\t\"github.com/lmuskalla/manigot/internal/config\"\n23\t\t\"github.com/lmuskalla/manigot/internal/fs\"\n24\t\t\"github.com/lmuskalla/manigot/internal/home\"\n25\t)\n26\t\n27\t// HostInvocation is a fully assembled direct CLI invocation for host mode.\n28\ttype HostInvocation struct {\n29\t\t// Argv is the complete argument vector: [\"claude\", ...] or\n30\t\t// [\"opencode\", ...].\n31\t\tArgv []string\n32\t\n33\t\t// Dir is the working directory the CLI runs from: the resolved project\n34\t\t// root, or the job's worktree once --job has resolved one.\n35\t\tDir string\n36\t\n37\t\t// Env is the child process environment: the host environment plus the\n38\t\t// profile's credential keys (see hostEnv).\n39\t\tEnv []string\n40\t}\n41\t\n42\t// hostBinaryName maps the profile's tool id (config.ToolClaudeCode /\n43\t// config.ToolOpenCode) to the binary installed on the host. The tool ids are\n44\t// manigot's own names (\"claude-code\"); the binaries are \"claude\"/\"opencode\".\n45\tfunc hostBinaryName(tool string) string {\n46\t\tif tool == config.ToolOpenCode {\n47\t\t\treturn \"opencode\"\n48\t\t}\n49\t\treturn \"claude\"\n50\t}\n51\t\n52\t// hostLookPath is exec.LookPath, split out so tests can point it at stub\n53\t// binaries (or a failure) instead of requiring claude/opencode on the test\n54\t// machine's PATH. Mirrors internal/launch's ExeOverride pattern.\n55\tvar hostLookPath = exec.LookPath\n56\t\n57\t// BuildHostInvocation assembles the direct CLI argv for mg host, mirroring\n58\t// BuildDockerInvocation's structure minus everything docker-specific: no\n59\t// mounts, no .env shadowing, no git-identity forwarding, no quote, no\n60\t// auto-approval flags. Diagnostics (banner, warnings) go to diag — always\n61\t// stderr, per the same convention as the docker builder.\n62\tfunc BuildHostInvocation(opts Options, info ProfileInfo, root Root, diag io.Writer) (HostInvocation, error) {\n63\t\t// --print is the non-interactive container path (bare `mg --print` and\n64\t\t// mg jdi, whose orchestration parses the container output contract). Host\n65\t\t// mode is for manual, interactive work — reject it outright rather than\n66\t\t// silently starting an interactive CLI under an unattended caller.\n67\t\tif opts.Print {\n68\t\t\treturn HostInvocation{}, fmt.Errorf(\"--print is not supported with mg host — host sessions run the CLI directly for interactive work.\\nUse the docker session (bare `mg --print`) or 'mg jdi' for non-interactive runs.\")\n69\t\t}\n70\t\n71\t\t// The .env warning run.sh printed when the file was missing — host mode\n72\t\t// reads the same credentials (config.EnvValue prefers the checkout's .env).\n73\t\tif envFile := config.EnvFile(); envFile != \"\" {\n74\t\t\tif _, err := os.Stat(envFile); err != nil {\n75\t\t\t\tfmt.Fprintf(diag, \"Warning: no .env found at %s\\n\", envFile)\n76\t\t\t}\n77\t\t}\n78\t\n79\t\t// mg host is just a launcher — the CLI must exist on the host. The docker\n80\t\t// path needs no such check: both CLIs are baked into the image.\n81\t\tbinary := hostBinaryName(info.Tool)\n82\t\tif _, err := hostLookPath(binary); err != nil {\n83\t\t\treturn HostInvocation{}, fmt.Errorf(\"%s is not installed on the host — mg host runs the CLI directly, without a container.\\nInstall it, or use the docker session (bare mg) instead.\", binary)\n84\t\t}\n85\t\n86\t\t// ── Global agents ─────────────────────────────────────────────────────\n87\t\t// mg host runs the CLI directly with no image/mounts, so the host CLI\n88\t\t// cannot see the manigot checkout's global agents (<home>/agents/) the way\n89\t\t// the container path mounts them. Surface them into the CLI's own global\n90\t\t// agents dir (~/.claude/agents/ for Claude Code,\n91\t\t// ~/.config/opencode/agents/ for OpenCode) — symlinked raw for Claude Code\n92\t\t// (the list form is its native schema), converted copies for OpenCode\n93\t\t// (which hard-errors on the list-form tools: key — see convertAgentFile).\n94\t\t// Non-destructive: a name already present in the target dir is left\n95\t\t// untouched (the user's own host agent wins), and nothing happens when the\n96\t\t// checkout has no agents/ dir — so a best-effort failure only warns and\n97\t\t// never blocks the session.\n98\t\tif n, err := installHostGlobalAgents(info.Tool); err != nil {\n99\t\t\tfmt.Fprintf(diag, \"Warning: could not make global agents available to %s on the host: %v\\n\", binary, err)\n100\t\t} else if n > 0 {\n101\t\t\tfmt.Fprintf(diag, \"  Installed : %d global agent(s) into %s's host config\\n\", n, binary)\n102\t\t}\n103\t\n104\t\t// ── Global skills ─────────────────────────────────────────────────────\n105\t\t// The same delivery problem applies to skills: the host CLI cannot see the\n106\t\t// checkout's global skills (<home>/skills/) without the image/mounts, so\n107\t\t// they are surfaced into the CLI's own global skills dir — symlinked dirs\n108\t\t// for Claude Code, copied dirs for OpenCode (see installHostGlobalSkills).\n109\t\t// Non-destructive and warn-only, exactly like the agents install above.\n110\t\tif n, err := installHostGlobalSkills(info.Tool); err != nil {\n111\t\t\tfmt.Fprintf(diag, \"Warning: could not make global skills available to %s on the host: %v\\n\", binary, err)\n112\t\t} else if n > 0 {\n113\t\t\tfmt.Fprintf(diag, \"  Installed : %d global skill(s) into %s's host config\\n\", n, binary)\n114\t\t}\n115\t\n116\t\t// ── Global meta prompt ──────────────────────────────────────────────────\n117\t\t// The same delivery problem applies to the system-wide meta prompt\n118\t\t// (<home>/prompts/meta.md): the host CLI cannot see it without the image/mounts,\n119\t\t// so it is surfaced into the CLI's own global instruction file. Unlike\n120\t\t// agents/skills it is a single file copied, never symlinked, so Claude's\n121\t\t// /memory writes and agent edits can never reach the checkout. Non-\n122\t\t// clobbering and warn-only, exactly like the agents/skills installs above.\n123\t\tif n, err := installHostGlobalMeta(info.Tool); err != nil {\n124\t\t\tfmt.Fprintf(diag, \"Warning: could not install the global meta prompt for %s on the host: %v\\n\", binary, err)\n125\t\t} else if n > 0 {\n126\t\t\tfmt.Fprintf(diag, \"  Installed : global meta prompt into %s's host config\\n\", binary)\n127\t\t}\n128\t\n129\t\t// ── Job prompt ──────────────────────────────────────────────────────────\n130\t\t// Host-pathed variant of docker.go's container job prompt: the CLI runs on\n131\t\t// the host, so the job path it is told to work on must be a host path.\n132\t\tinitialPrompt := \"\"\n133\t\tif root.Job != \"\" {\n134\t\t\thostJobDir := filepath.Join(root.ProjectRoot, \"docs\", \"jobs\", root.Job)\n135\t\t\tinitialPrompt = \"Please work on the job at \" + hostJobDir + \" — start by reading brief.md\"\n136\t\t} else if opts.Prompt != \"\" {\n137\t\t\tinitialPrompt = opts.Prompt\n138\t\t}\n139\t\n140\t\tvar agentFlag []string\n141\t\tif opts.Agent != \"\" {\n142\t\t\tagentFlag = []string{\"--agent\", opts.Agent}\n143\t\t}\n144\t\n145\t\t// Claude takes the prompt positionally; OpenCode as --prompt — the same\n146\t\t// per-tool routing the docker path uses.\n147\t\tvar promptArgs []string\n148\t\tif initialPrompt != \"\" {\n149\t\t\tif info.Tool == config.ToolOpenCode {\n150\t\t\t\tpromptArgs = []string{\"--prompt\", initialPrompt}\n151\t\t\t} else {\n152\t\t\t\tpromptArgs = []string{initialPrompt}\n153\t\t\t}\n154\t\t}\n155\t\n156\t\t// ── OpenCode model ──────────────────────────────────────────────────────\n157\t\t// The docker path forwards OPENCODE_MODEL and scripts/entrypoint.sh writes\n158\t\t// it into an opencode config inside the container. On the host mg must not\n159\t\t// write the user's real ~/.config/opencode/opencode.json, so the effective\n160\t\t// model is forwarded via opencode's own --model flag instead (verified\n161\t\t// supported: `opencode --help` shows -m/--model). OPENCODE_MODEL itself is\n162\t\t// deliberately not put into the child env — opencode does not read it.\n163\t\tvar modelArgs []string\n164\t\tif info.Tool == config.ToolOpenCode && info.OpenCodeModel != \"\" {\n165\t\t\tmodelArgs = []string{\"--model\", info.OpenCodeModel}\n166\t\t}\n167\t\n168\t\t// ── Info banner ─────────────────────────────────────────────────────────\n169\t\tfmt.Fprintln(diag, \"╔══════════════════════════════════════╗\")\n170\t\tfmt.Fprintln(diag, \"║           manigot                   ║\")\n171\t\tfmt.Fprintln(diag, \"╠══════════════════════════════════════╣\")\n172\t\tfmt.Fprintln(diag, \"║  Entering host mode (no docker container)...\")\n173\t\tfmt.Fprintf(diag, \"║  Project : %s\\n\", filepath.Base(root.InvocationRoot))\n174\t\tfmt.Fprintf(diag, \"║  Root    : %s\\n\", root.ProjectRoot)\n175\t\tif root.DocsInitialized {\n176\t\t\tfmt.Fprintf(diag, \"║  Docs    : %s\\n\", root.DocsDir)\n177\t\t} else {\n178\t\t\tfmt.Fprintln(diag, \"║  Docs    : (none — job workflow unavailable, running off the books)\")\n179\t\t}\n180\t\tif info.Profile != \"\" {\n181\t\t\tfmt.Fprintf(diag, \"║  Profile : %s\\n\", info.Profile)\n182\t\t}\n183\t\tif info.Tool != \"\" {\n184\t\t\tfmt.Fprintf(diag, \"║  Tool    : %s\\n\", info.Tool)\n185\t\t}\n186\t\tif opts.Agent != \"\" {\n187\t\t\tfmt.Fprintf(diag, \"║  Agent   : %s\\n\", opts.Agent)\n188\t\t}\n189\t\tif root.Job != \"\" {\n190\t\t\tfmt.Fprintf(diag, \"║  Job     : %s\\n\", root.Job)\n191\t\t}\n192\t\tfmt.Fprintln(diag, \"╚══════════════════════════════════════╝\")\n193\t\tfmt.Fprintln(diag, \"\")\n194\t\n195\t\t// ── Assemble the argv ───────────────────────────────────────────────────\n196\t\t// Deliberately no --dangerously-skip-permissions (Claude) / --auto\n197\t\t// (OpenCode): safe only inside the isolated, ephemeral container. On the\n198\t\t// host the CLI keeps its normal per-tool confirmation prompts.\n199\t\targv := []string{binary}\n200\t\targv = append(argv, agentFlag...)\n201\t\targv = append(argv, modelArgs...)\n202\t\targv = append(argv, promptArgs...)\n203\t\targv = append(argv, opts.Pass...)\n204\t\n205\t\treturn HostInvocation{\n206\t\t\tArgv: argv,\n207\t\t\tDir:  root.ProjectRoot,\n208\t\t\tEnv:  hostEnv(info),\n209\t\t}, nil\n210\t}\n211\t\n212\t// hostEnv builds the child process environment for a host invocation: the\n213\t// host's own environment plus the profile's credential keys (the KEY=VALUE\n214\t// strings behind ProfileInfo.KeyEnv's docker -e pairs). Appended last, so\n215\t// exec's duplicate-key handling (the last value wins) resolves every key to\n216\t// the .env-effective value the session flow already validated — the same\n217\t// credentials the container path forwards. OPENCODE_MODEL is excluded: it is\n218\t// forwarded as --model instead (see BuildHostInvocation), and opencode does\n219\t// not read it from the environment. OPENCODE_THEME is excluded too: it is a\n220\t// container-only knob — the docker path applies it by writing a generated\n221\t// ~/.config/opencode/tui.json inside the ephemeral container (see\n222\t// scripts/entrypoint.sh) — and mg host runs the CLI against the user's own\n223\t// real ~/.config/opencode, which already reflects whatever theme the user\n224\t// configured there (the same reason mg host needs no other theme handling;\n225\t// see tasks.md's scope note for this job). Forwarding it would be a silent,\n226\t// untested, unused env leak.\n227\t//\n228\t// For OpenCode sessions, TMUX/TMUX_PANE are filtered out of the child env —\n229\t// the same exception the docker path applies (see the terminalEnvVars comment\n230\t// in docker.go): when OpenCode sees TMUX set it wraps its OSC 52 clipboard\n231\t// write in tmux's DCS-passthrough escape, which default tmux configuration\n232\t// discards entirely, so the host clipboard is never touched. Stripping TMUX\n233\t// makes OpenCode emit plain OSC 52, which tmux's set-clipboard on handles.\n234\t// Claude Code's host env stays the full host environment.\n235\tfunc hostEnv(info ProfileInfo) []string {\n236\t\tenv := os.Environ()\n237\t\tfor i := 0; i+1 < len(info.KeyEnv); i += 2 {\n238\t\t\tif info.KeyEnv[i] != \"-e\" {\n239\t\t\t\tcontinue\n240\t\t\t}\n241\t\t\tpair := info.KeyEnv[i+1]\n242\t\t\tif strings.HasPrefix(pair, \"OPENCODE_MODEL=\") || strings.HasPrefix(pair, \"OPENCODE_THEME=\") {\n243\t\t\t\tcontinue\n244\t\t\t}\n245\t\t\tenv = append(env, pair)\n246\t\t}\n247\t\tif info.Tool == config.ToolOpenCode {\n248\t\t\tvar filtered []string\n249\t\t\tfor _, kv := range env {\n250\t\t\t\tif strings.HasPrefix(kv, \"TMUX=\") || strings.HasPrefix(kv, \"TMUX_PANE=\") {\n251\t\t\t\t\tcontinue\n252\t\t\t\t}\n253\t\t\t\tfiltered = append(filtered, kv)\n254\t\t\t}\n255\t\t\tenv = filtered\n256\t\t}\n257\t\treturn env\n258\t}\n259\t\n260\t// hostGlobalAgentsDir resolves the host CLI's global agents directory for a\n261\t// tool: ~/.claude/agents/ for Claude Code, ~/.config/opencode/agents/ for\n262\t// OpenCode (the same locations the container path mounts the global agents\n263\t// into). The dir is derived from $HOME (os.UserHomeDir), so tests can point it\n264\t// at a temp dir.\n265\tfunc hostGlobalAgentsDir(tool string) string {\n266\t\thomeDir, err := os.UserHomeDir()\n267\t\tif err != nil {\n268\t\t\thomeDir = os.Getenv(\"HOME\")\n269\t\t}\n270\t\tif tool == config.ToolOpenCode {\n271\t\t\treturn filepath.Join(homeDir, \".config\", \"opencode\", \"agents\")\n272\t\t}\n273\t\treturn filepath.Join(homeDir, \".claude\", \"agents\")\n274\t}\n275\t\n276\t// installHostGlobalAgents surfaces the manigot checkout's global agents\n277\t// (<home>/agents/) to the host CLI — the host equivalent of the container\n278\t// path's read-only mount (mg host runs the CLI directly, with no mounts).\n279\t//\n280\t// Delivery is per-tool, mirroring the container path's conversion split:\n281\t//\n282\t//   - Claude Code: each agent file is symlinked into ~/.claude/agents/ raw —\n283\t//     the list-form frontmatter (name:/description:/tools: Read, Grep, ...)\n284\t//     is Claude's native subagent schema. The symlinks point at the live\n285\t//     checkout files, so edits to agents/ are reflected without re-installing.\n286\t//   - OpenCode: OpenCode hard-errors on the list-form tools: key, so the raw\n287\t//     file cannot be symlinked — each agent is converted first (name:/tools:\n288\t//     stripped, permission: passed through — see convertAgentFile) and the\n289\t//     converted copy is written into ~/.config/opencode/agents/.\n290\t//\n291\t// It never clobbers existing host agent config: a name already present in the\n292\t// target dir is left untouched (the user's own host agent wins, mirroring the\n293\t// project-overrides-global precedence). One exception: a symlink pointing at\n294\t// the checkout's own agents/<name> is this installer's stale raw OpenCode link\n295\t// from before the conversion fix, and is replaced with a converted copy so it\n296\t// stops hard-erroring OpenCode. Nothing is created when the checkout has no\n297\t// agents/ dir or no home can be located. Returns the number of agents\n298\t// installed.\n299\tfunc installHostGlobalAgents(tool string) (int, error) {\n300\t\thomeDir := home.Root()\n301\t\tif homeDir == \"\" {\n302\t\t\treturn 0, nil\n303\t\t}\n304\t\tsrcDir := filepath.Join(homeDir, \"agents\")\n305\t\tentries, err := os.ReadDir(srcDir)\n306\t\tif err != nil {\n307\t\t\tif os.IsNotExist(err) {\n308\t\t\t\treturn 0, nil\n309\t\t\t}\n310\t\t\treturn 0, err\n311\t\t}\n312\t\tvar names []string\n313\t\tfor _, e := range entries {\n314\t\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".md\") {\n315\t\t\t\tcontinue\n316\t\t\t}\n317\t\t\tnames = append(names, e.Name())\n318\t\t}\n319\t\tif len(names) == 0 {\n320\t\t\treturn 0, nil\n321\t\t}\n322\t\n323\t\ttargetDir := hostGlobalAgentsDir(tool)\n324\t\tif err := os.MkdirAll(targetDir, 0o755); err != nil {\n325\t\t\treturn 0, err\n326\t\t}\n327\t\tinstalled := 0\n328\t\tfor _, name := range names {\n329\t\t\ttarget := filepath.Join(targetDir, name)\n330\t\t\tif tool == config.ToolOpenCode {\n331\t\t\t\t// OpenCode hard-errors on the list-form tools: key (see\n332\t\t\t\t// convertAgents), so the raw checkout file cannot be symlinked:\n333\t\t\t\t// the host target gets a converted copy instead. Never clobber an\n334\t\t\t\t// existing host agent — except this installer's own stale raw\n335\t\t\t\t// symlink (one pointing at the checkout's agents/<name>), which is\n336\t\t\t\t// replaced with the converted copy.\n337\t\t\t\tif fi, err := os.Lstat(target); err == nil {\n338\t\t\t\t\tif fi.Mode()&os.ModeSymlink != 0 {\n339\t\t\t\t\t\tif dest, rerr := os.Readlink(target); rerr == nil && dest == filepath.Join(srcDir, name) {\n340\t\t\t\t\t\t\tos.Remove(target) // our stale raw link — replaced below\n341\t\t\t\t\t\t} else {\n342\t\t\t\t\t\t\tcontinue // a foreign symlink — the user's setup wins\n343\t\t\t\t\t\t}\n344\t\t\t\t\t} else {\n345\t\t\t\t\t\tcontinue // a regular file — the user's own agent wins\n346\t\t\t\t\t}\n347\t\t\t\t}\n348\t\t\t\tdata, rerr := os.ReadFile(filepath.Join(srcDir, name))\n349\t\t\t\tif rerr != nil {\n350\t\t\t\t\tcontinue\n351\t\t\t\t}\n352\t\t\t\tif werr := os.WriteFile(target, convertAgentFile(data), 0o644); werr != nil {\n353\t\t\t\t\tcontinue\n354\t\t\t\t}\n355\t\t\t\tinstalled++\n356\t\t\t\tcontinue\n357\t\t\t}\n358\t\t\t// Claude Code — raw symlink (list form is Claude's native schema).\n359\t\t\t// Never clobber an existing host agent config — the user's own file\n360\t\t\t// (or an existing symlink, dangling or not) wins.\n361\t\t\tif _, err := os.Lstat(target); err == nil {\n362\t\t\t\tcontinue\n363\t\t\t}\n364\t\t\tif err := os.Symlink(filepath.Join(srcDir, name), target); err != nil {\n365\t\t\t\t// Skip names we couldn't link but keep going for the rest.\n366\t\t\t\tcontinue\n367\t\t\t}\n368\t\t\tinstalled++\n369\t\t}\n370\t\treturn installed, nil\n371\t}\n372\t\n373\t// hostGlobalSkillsDir resolves the host CLI's global skills directory for a\n374\t// tool: ~/.claude/skills/ for Claude Code, ~/.config/opencode/skills/ for\n375\t// OpenCode (the same locations the container path mounts the global skills\n376\t// into). The dir is derived from $HOME (os.UserHomeDir), so tests can point it\n377\t// at a temp dir.\n378\tfunc hostGlobalSkillsDir(tool string) string {\n379\t\thomeDir, err := os.UserHomeDir()\n380\t\tif err != nil {\n381\t\t\thomeDir = os.Getenv(\"HOME\")\n382\t\t}\n383\t\tif tool == config.ToolOpenCode {\n384\t\t\treturn filepath.Join(homeDir, \".config\", \"opencode\", \"skills\")\n385\t\t}\n386\t\treturn filepath.Join(homeDir, \".claude\", \"skills\")\n387\t}\n388\t\n389\t// installHostGlobalSkills surfaces the manigot checkout's global skills\n390\t// (<home>/skills/) to the host CLI — the host equivalent of the container\n391\t// path's read-only mount (mg host runs the CLI directly, with no mounts).\n392\t//\n393\t// A skill is a directory (SKILL.md plus optional support files), so delivery\n394\t// is per-directory, mirroring installHostGlobalAgents' per-tool split:\n395\t//\n396\t//   - Claude Code: each skill dir is symlinked into ~/.claude/skills/ — the\n397\t//     symlinks point at the live checkout dirs, so edits to skills/ are\n398\t//     reflected without re-installing.\n399\t//   - OpenCode: each skill dir is copied into ~/.config/opencode/skills/ — a\n400\t//     self-contained snapshot rather than a symlink, so the CLI's skills dir\n401\t//     never points into (or writes into) the manigot checkout.\n402\t//\n403\t// It never clobbers existing host skill config: a name already present in the\n404\t// target dir is left untouched (the user's own host skill wins, mirroring the\n405\t// project-overrides-global precedence). Nothing is created when the checkout\n406\t// has no skills/ dir or no home can be located. Returns the number of skills\n407\t// installed.\n408\tfunc installHostGlobalSkills(tool string) (int, error) {\n409\t\thomeDir := home.Root()\n410\t\tif homeDir == \"\" {\n411\t\t\treturn 0, nil\n412\t\t}\n413\t\tsrcDir := filepath.Join(homeDir, \"skills\")\n414\t\tskills, err := listSkills(srcDir)\n415\t\tif err != nil {\n416\t\t\treturn 0, err\n417\t\t}\n418\t\tif len(skills) == 0 {\n419\t\t\treturn 0, nil\n420\t\t}\n421\t\n422\t\ttargetDir := hostGlobalSkillsDir(tool)\n423\t\tif err := os.MkdirAll(targetDir, 0o755); err != nil {\n424\t\t\treturn 0, err\n425\t\t}\n426\t\tinstalled := 0\n427\t\tfor _, s := range skills {\n428\t\t\ttarget := filepath.Join(targetDir, s.Name)\n429\t\t\t// Never clobber an existing host skill — the user's own dir (or an\n430\t\t\t// existing symlink, dangling or not) wins.\n431\t\t\tif _, err := os.Lstat(target); err == nil {\n432\t\t\t\tcontinue\n433\t\t\t}\n434\t\t\tif tool == config.ToolOpenCode {\n435\t\t\t\t// OpenCode gets a copied snapshot (see the doc comment above).\n436\t\t\t\tif err := copyDir(target, s.Dir); err != nil {\n437\t\t\t\t\tcontinue // skip names we couldn't copy, keep going for the rest\n438\t\t\t\t}\n439\t\t\t} else {\n440\t\t\t\t// Claude Code — raw symlink to the live checkout dir.\n441\t\t\t\tif err := os.Symlink(s.Dir, target); err != nil {\n442\t\t\t\t\tcontinue\n443\t\t\t\t}\n444\t\t\t}\n445\t\t\tinstalled++\n446\t\t}\n447\t\treturn installed, nil\n448\t}\n449\t\n450\t// hostGlobalMetaFile resolves the host CLI's global instruction file for a\n451\t// tool — the single file the CLI loads in every session at its *global\n452\t// instruction* location: ~/.claude/CLAUDE.md for Claude Code (the user-global\n453\t// memory file) and ~/.config/opencode/AGENTS.md for OpenCode (the global\n454\t// rules file) — the same locations the container path mounts <home>/prompts/meta.md\n455\t// into. The path is derived from $HOME (os.UserHomeDir), so tests can point it\n456\t// at a temp dir.\n457\tfunc hostGlobalMetaFile(tool string) string {\n458\t\thomeDir, err := os.UserHomeDir()\n459\t\tif err != nil {\n460\t\t\thomeDir = os.Getenv(\"HOME\")\n461\t\t}\n462\t\tif tool == config.ToolOpenCode {\n463\t\t\treturn filepath.Join(homeDir, \".config\", \"opencode\", \"AGENTS.md\")\n464\t\t}\n465\t\treturn filepath.Join(homeDir, \".claude\", \"CLAUDE.md\")\n466\t}\n467\t\n468\t// installHostGlobalMeta surfaces the manigot checkout's system-wide meta\n469\t// prompt (<home>/prompts/meta.md) to the host CLI — the host equivalent of the\n470\t// container path's read-only mount (mg host runs the CLI directly, with no\n471\t// mounts).\n472\t//\n473\t// It delivers a single file by COPY, never a symlink: ~/.claude/CLAUDE.md is\n474\t// Claude Code's user-writable memory file, so a symlink would let Claude's\n475\t// /memory writes and agent edits land back in the manigot checkout. A copied\n476\t// file keeps the host CLI's own global instruction file fully self-contained.\n477\t//\n478\t// It never clobbers an existing host file: a target that already exists (the\n479\t// user's own CLAUDE.md / AGENTS.md) wins and nothing is written. Nothing is\n480\t// created when the checkout has no prompts/meta.md or no home can be located. Returns\n481\t// 1 when the file was installed, 0 otherwise.\n482\tfunc installHostGlobalMeta(tool string) (int, error) {\n483\t\thomeDir := home.Root()\n484\t\tif homeDir == \"\" {\n485\t\t\treturn 0, nil\n486\t\t}\n487\t\tsrc := filepath.Join(homeDir, \"prompts\", \"meta.md\")\n488\t\tif !fs.IsFile(src) {\n489\t\t\treturn 0, nil\n490\t\t}\n491\t\n492\t\ttarget := hostGlobalMetaFile(tool)\n493\t\t// Never clobber an existing host instruction file — the user's own file\n494\t\t// wins.\n495\t\tif _, err := os.Lstat(target); err == nil {\n496\t\t\treturn 0, nil\n497\t\t}\n498\t\tif err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {\n499\t\t\treturn 0, err\n500\t\t}\n501\t\tdata, err := os.ReadFile(src)\n502\t\tif err != nil {\n503\t\t\treturn 0, err\n504\t\t}\n505\t\tif err := os.WriteFile(target, data, 0o644); err != nil {\n506\t\t\treturn 0, err\n507\t\t}\n508\t\treturn 1, nil\n509\t}\n510\t\n511\t// Run executes the assembled CLI invocation, wiring stdin/stdout/stderr\n512\t// through so Ctrl+C reaches the CLI directly (there is no container in\n513\t// between), and returns the CLI's exit code.\n514\tfunc (h HostInvocation) Run(stdin *os.File, stdout, stderr io.Writer) int {\n515\t\tcmd := exec.Command(h.Argv[0], h.Argv[1:]...)\n516\t\tcmd.Dir = h.Dir\n517\t\tcmd.Env = h.Env\n518\t\tcmd.Stdin = stdin\n519\t\tcmd.Stdout = stdout\n520\t\tcmd.Stderr = stderr\n521\t\tif err := cmd.Run(); err != nil {\n522\t\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n523\t\t\t\treturn exitErr.ExitCode()\n524\t\t\t}\n525\t\t\tfmt.Fprintf(stderr, \"mg: %v\\n\", err)\n526\t\t\treturn 1\n527\t\t}\n528\t\treturn 0\n529\t}\n530\t"}]},"parent_tool_use_id":null,"session_id":"0ad41780-e2e7-4ebf-861d-9c61d66ababf","uuid":"dcdbd819-08c1-481f-96aa-2cbb018581ed","timestamp":"2026-08-29T08:59:40.974Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/session/host.go","content":"// Host mode (mg host) is the counterpart of the docker session path in\n// docker.go: instead of assembling a `docker run` argv, it assembles a direct\n// invocation of the profile's agent CLI (claude / opencode) running on the\n// host itself — no container, no mounts, no isolation. Everything before the\n// launch (ParseArgs, ResolveProfile, ResolveRoot, CheckAuth) is shared; only\n// the last step differs.\n//\n// Host mode is for work that must happen on the host — outside the container.\n// The CLIs are launched exactly as installed on the host: no auto-approval\n// flags (--dangerously-skip-permissions / --auto are only safe inside the\n// isolated, ephemeral container), so the user supervises every tool call.\npackage session\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/fs\"\n\t\"github.com/lmuskalla/manigot/internal/home\"\n)\n\n// HostInvocation is a fully assembled direct CLI invocation for host mode.\ntype HostInvocation struct {\n\t// Argv is the complete argument vector: [\"claude\", ...] or\n\t// [\"opencode\", ...].\n\tArgv []string\n\n\t// Dir is the working directory the CLI runs from: the resolved project\n\t// root, or the job's worktree once --job has resolved one.\n\tDir string\n\n\t// Env is the child process environment: the host environment plus the\n\t// profile's credential keys (see hostEnv).\n\tEnv []string\n}\n\n// hostBinaryName maps the profile's tool id (config.ToolClaudeCode /\n// config.ToolOpenCode) to the binary installed on the host. The tool ids are\n// manigot's own names (\"claude-code\"); the binaries are \"claude\"/\"opencode\".\nfunc hostBinaryName(tool string) string {\n\tif tool == config.ToolOpenCode {\n\t\treturn \"opencode\"\n\t}\n\treturn \"claude\"\n}\n\n// hostLookPath is exec.LookPath, split out so tests can point it at stub\n// binaries (or a failure) instead of requiring claude/opencode on the test\n// machine's PATH. Mirrors internal/launch's ExeOverride pattern.\nvar hostLookPath = exec.LookPath\n\n// BuildHostInvocation assembles the direct CLI argv for mg host, mirroring\n// BuildDockerInvocation's structure minus everything docker-specific: no\n// mounts, no .env shadowing, no git-identity forwarding, no quote, no\n// auto-approval flags. Diagnostics (banner, warnings) go to diag — always\n// stderr, per the same convention as the docker builder.\nfunc BuildHostInvocation(opts Options, info ProfileInfo, root Root, diag io.Writer) (HostInvocation, error) {\n\t// --print is the non-interactive container path (bare `mg --print` and\n\t// mg jdi, whose orchestration parses the container output contract). Host\n\t// mode is for manual, interactive work — reject it outright rather than\n\t// silently starting an interactive CLI under an unattended caller.\n\tif opts.Print {\n\t\treturn HostInvocation{}, fmt.Errorf(\"--print is not supported with mg host — host sessions run the CLI directly for interactive work.\\nUse the docker session (bare `mg --print`) or 'mg jdi' for non-interactive runs.\")\n\t}\n\n\t// The .env warning run.sh printed when the file was missing — host mode\n\t// reads the same credentials (config.EnvValue prefers the checkout's .env).\n\tif envFile := config.EnvFile(); envFile != \"\" {\n\t\tif _, err := os.Stat(envFile); err != nil {\n\t\t\tfmt.Fprintf(diag, \"Warning: no .env found at %s\\n\", envFile)\n\t\t}\n\t}\n\n\t// mg host is just a launcher — the CLI must exist on the host. The docker\n\t// path needs no such check: both CLIs are baked into the image.\n\tbinary := hostBinaryName(info.Tool)\n\tif _, err := hostLookPath(binary); err != nil {\n\t\treturn HostInvocation{}, fmt.Errorf(\"%s is not installed on the host — mg host runs the CLI directly, without a container.\\nInstall it, or use the docker session (bare mg) instead.\", binary)\n\t}\n\n\t// ── Global agents ─────────────────────────────────────────────────────\n\t// mg host runs the CLI directly with no image/mounts, so the host CLI\n\t// cannot see the manigot checkout's global agents (<home>/agents/) the way\n\t// the container path mounts them. Surface them into the CLI's own global\n\t// agents dir (~/.claude/agents/ for Claude Code,\n\t// ~/.config/opencode/agents/ for OpenCode) — symlinked raw for Claude Code\n\t// (the list form is its native schema), converted copies for OpenCode\n\t// (which hard-errors on the list-form tools: key — see convertAgentFile).\n\t// Non-destructive: a name already present in the target dir is left\n\t// untouched (the user's own host agent wins), and nothing happens when the\n\t// checkout has no agents/ dir — so a best-effort failure only warns and\n\t// never blocks the session.\n\tif n, err := installHostGlobalAgents(info.Tool); err != nil {\n\t\tfmt.Fprintf(diag, \"Warning: could not make global agents available to %s on the host: %v\\n\", binary, err)\n\t} else if n > 0 {\n\t\tfmt.Fprintf(diag, \"  Installed : %d global agent(s) into %s's host config\\n\", n, binary)\n\t}\n\n\t// ── Global skills ─────────────────────────────────────────────────────\n\t// The same delivery problem applies to skills: the host CLI cannot see the\n\t// checkout's global skills (<home>/skills/) without the image/mounts, so\n\t// they are surfaced into the CLI's own global skills dir — symlinked dirs\n\t// for Claude Code, copied dirs for OpenCode (see installHostGlobalSkills).\n\t// Non-destructive and warn-only, exactly like the agents install above.\n\tif n, err := installHostGlobalSkills(info.Tool); err != nil {\n\t\tfmt.Fprintf(diag, \"Warning: could not make global skills available to %s on the host: %v\\n\", binary, err)\n\t} else if n > 0 {\n\t\tfmt.Fprintf(diag, \"  Installed : %d global skill(s) into %s's host config\\n\", n, binary)\n\t}\n\n\t// ── Global meta prompt ──────────────────────────────────────────────────\n\t// The same delivery problem applies to the system-wide meta prompt\n\t// (<home>/prompts/meta.md): the host CLI cannot see it without the image/mounts,\n\t// so it is surfaced into the CLI's own global instruction file. Unlike\n\t// agents/skills it is a single file copied, never symlinked, so Claude's\n\t// /memory writes and agent edits can never reach the checkout. Non-\n\t// clobbering and warn-only, exactly like the agents/skills installs above.\n\tif n, err := installHostGlobalMeta(info.Tool); err != nil {\n\t\tfmt.Fprintf(diag, \"Warning: could not install the global meta prompt for %s on the host: %v\\n\", binary, err)\n\t} else if n > 0 {\n\t\tfmt.Fprintf(diag, \"  Installed : global meta prompt into %s's host config\\n\", binary)\n\t}\n\n\t// ── Job prompt ──────────────────────────────────────────────────────────\n\t// Host-pathed variant of docker.go's container job prompt: the CLI runs on\n\t// the host, so the job path it is told to work on must be a host path.\n\tinitialPrompt := \"\"\n\tif root.Job != \"\" {\n\t\thostJobDir := filepath.Join(root.ProjectRoot, \"docs\", \"jobs\", root.Job)\n\t\tinitialPrompt = \"Please work on the job at \" + hostJobDir + \" — start by reading brief.md\"\n\t} else if opts.Prompt != \"\" {\n\t\tinitialPrompt = opts.Prompt\n\t}\n\n\tvar agentFlag []string\n\tif opts.Agent != \"\" {\n\t\tagentFlag = []string{\"--agent\", opts.Agent}\n\t}\n\n\t// Claude takes the prompt positionally; OpenCode as --prompt — the same\n\t// per-tool routing the docker path uses.\n\tvar promptArgs []string\n\tif initialPrompt != \"\" {\n\t\tif info.Tool == config.ToolOpenCode {\n\t\t\tpromptArgs = []string{\"--prompt\", initialPrompt}\n\t\t} else {\n\t\t\tpromptArgs = []string{initialPrompt}\n\t\t}\n\t}\n\n\t// ── OpenCode model ──────────────────────────────────────────────────────\n\t// The docker path forwards OPENCODE_MODEL and scripts/entrypoint.sh writes\n\t// it into an opencode config inside the container. On the host mg must not\n\t// write the user's real ~/.config/opencode/opencode.json, so the effective\n\t// model is forwarded via opencode's own --model flag instead (verified\n\t// supported: `opencode --help` shows -m/--model). OPENCODE_MODEL itself is\n\t// deliberately not put into the child env — opencode does not read it.\n\tvar modelArgs []string\n\tif info.Tool == config.ToolOpenCode && info.OpenCodeModel != \"\" {\n\t\tmodelArgs = []string{\"--model\", info.OpenCodeModel}\n\t}\n\n\t// ── Info banner ─────────────────────────────────────────────────────────\n\tfmt.Fprintln(diag, \"╔══════════════════════════════════════╗\")\n\tfmt.Fprintln(diag, \"║           manigot                   ║\")\n\tfmt.Fprintln(diag, \"╠══════════════════════════════════════╣\")\n\tfmt.Fprintln(diag, \"║  Entering host mode (no docker container)...\")\n\tfmt.Fprintf(diag, \"║  Project : %s\\n\", filepath.Base(root.InvocationRoot))\n\tfmt.Fprintf(diag, \"║  Root    : %s\\n\", root.ProjectRoot)\n\tif root.DocsInitialized {\n\t\tfmt.Fprintf(diag, \"║  Docs    : %s\\n\", root.DocsDir)\n\t} else {\n\t\tfmt.Fprintln(diag, \"║  Docs    : (none — job workflow unavailable, running off the books)\")\n\t}\n\tif info.Profile != \"\" {\n\t\tfmt.Fprintf(diag, \"║  Profile : %s\\n\", info.Profile)\n\t}\n\tif info.Tool != \"\" {\n\t\tfmt.Fprintf(diag, \"║  Tool    : %s\\n\", info.Tool)\n\t}\n\tif opts.Agent != \"\" {\n\t\tfmt.Fprintf(diag, \"║  Agent   : %s\\n\", opts.Agent)\n\t}\n\tif root.Job != \"\" {\n\t\tfmt.Fprintf(diag, \"║  Job     : %s\\n\", root.Job)\n\t}\n\tfmt.Fprintln(diag, \"╚══════════════════════════════════════╝\")\n\tfmt.Fprintln(diag, \"\")\n\n\t// ── Assemble the argv ───────────────────────────────────────────────────\n\t// Deliberately no --dangerously-skip-permissions (Claude) / --auto\n\t// (OpenCode): safe only inside the isolated, ephemeral container. On the\n\t// host the CLI keeps its normal per-tool confirmation prompts.\n\targv := []string{binary}\n\targv = append(argv, agentFlag...)\n\targv = append(argv, modelArgs...)\n\targv = append(argv, promptArgs...)\n\targv = append(argv, opts.Pass...)\n\n\treturn HostInvocation{\n\t\tArgv: argv,\n\t\tDir:  root.ProjectRoot,\n\t\tEnv:  hostEnv(info),\n\t}, nil\n}\n\n// hostEnv builds the child process environment for a host invocation: the\n// host's own environment plus the profile's credential keys (the KEY=VALUE\n// strings behind ProfileInfo.KeyEnv's docker -e pairs). Appended last, so\n// exec's duplicate-key handling (the last value wins) resolves every key to\n// the .env-effective value the session flow already validated — the same\n// credentials the container path forwards. OPENCODE_MODEL is excluded: it is\n// forwarded as --model instead (see BuildHostInvocation), and opencode does\n// not read it from the environment. OPENCODE_THEME is excluded too: it is a\n// container-only knob — the docker path applies it by writing a generated\n// ~/.config/opencode/tui.json inside the ephemeral container (see\n// scripts/entrypoint.sh) — and mg host runs the CLI against the user's own\n// real ~/.config/opencode, which already reflects whatever theme the user\n// configured there (the same reason mg host needs no other theme handling;\n// see tasks.md's scope note for this job). Forwarding it would be a silent,\n// untested, unused env leak.\n//\n// For OpenCode sessions, TMUX/TMUX_PANE are filtered out of the child env —\n// the same exception the docker path applies (see the terminalEnvVars comment\n// in docker.go): when OpenCode sees TMUX set it wraps its OSC 52 clipboard\n// write in tmux's DCS-passthrough escape, which default tmux configuration\n// discards entirely, so the host clipboard is never touched. Stripping TMUX\n// makes OpenCode emit plain OSC 52, which tmux's set-clipboard on handles.\n// Claude Code's host env stays the full host environment.\nfunc hostEnv(info ProfileInfo) []string {\n\tenv := os.Environ()\n\tfor i := 0; i+1 < len(info.KeyEnv); i += 2 {\n\t\tif info.KeyEnv[i] != \"-e\" {\n\t\t\tcontinue\n\t\t}\n\t\tpair := info.KeyEnv[i+1]\n\t\tif strings.HasPrefix(pair, \"OPENCODE_MODEL=\") || strings.HasPrefix(pair, \"OPENCODE_THEME=\") {\n\t\t\tcontinue\n\t\t}\n\t\tenv = append(env, pair)\n\t}\n\tif info.Tool == config.ToolOpenCode {\n\t\tvar filtered []string\n\t\tfor _, kv := range env {\n\t\t\tif strings.HasPrefix(kv, \"TMUX=\") || strings.HasPrefix(kv, \"TMUX_PANE=\") {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tfiltered = append(filtered, kv)\n\t\t}\n\t\tenv = filtered\n\t}\n\treturn env\n}\n\n// hostGlobalAgentsDir resolves the host CLI's global agents directory for a\n// tool: ~/.claude/agents/ for Claude Code, ~/.config/opencode/agents/ for\n// OpenCode (the same locations the container path mounts the global agents\n// into). The dir is derived from $HOME (os.UserHomeDir), so tests can point it\n// at a temp dir.\nfunc hostGlobalAgentsDir(tool string) string {\n\thomeDir, err := os.UserHomeDir()\n\tif err != nil {\n\t\thomeDir = os.Getenv(\"HOME\")\n\t}\n\tif tool == config.ToolOpenCode {\n\t\treturn filepath.Join(homeDir, \".config\", \"opencode\", \"agents\")\n\t}\n\treturn filepath.Join(homeDir, \".claude\", \"agents\")\n}\n\n// installHostGlobalAgents surfaces the manigot checkout's global agents\n// (<home>/agents/) to the host CLI — the host equivalent of the container\n// path's read-only mount (mg host runs the CLI directly, with no mounts).\n//\n// Delivery is per-tool, mirroring the container path's conversion split:\n//\n//   - Claude Code: each agent file is symlinked into ~/.claude/agents/ raw —\n//     the list-form frontmatter (name:/description:/tools: Read, Grep, ...)\n//     is Claude's native subagent schema. The symlinks point at the live\n//     checkout files, so edits to agents/ are reflected without re-installing.\n//   - OpenCode: OpenCode hard-errors on the list-form tools: key, so the raw\n//     file cannot be symlinked — each agent is converted first (name:/tools:\n//     stripped, permission: passed through — see convertAgentFile) and the\n//     converted copy is written into ~/.config/opencode/agents/.\n//\n// It never clobbers existing host agent config: a name already present in the\n// target dir is left untouched (the user's own host agent wins, mirroring the\n// project-overrides-global precedence). One exception: a symlink pointing at\n// the checkout's own agents/<name> is this installer's stale raw OpenCode link\n// from before the conversion fix, and is replaced with a converted copy so it\n// stops hard-erroring OpenCode. Nothing is created when the checkout has no\n// agents/ dir or no home can be located. Returns the number of agents\n// installed.\nfunc installHostGlobalAgents(tool string) (int, error) {\n\thomeDir := home.Root()\n\tif homeDir == \"\" {\n\t\treturn 0, nil\n\t}\n\tsrcDir := filepath.Join(homeDir, \"agents\")\n\tentries, err := os.ReadDir(srcDir)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn 0, nil\n\t\t}\n\t\treturn 0, err\n\t}\n\tvar names []string\n\tfor _, e := range entries {\n\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".md\") {\n\t\t\tcontinue\n\t\t}\n\t\tnames = append(names, e.Name())\n\t}\n\tif len(names) == 0 {\n\t\treturn 0, nil\n\t}\n\n\ttargetDir := hostGlobalAgentsDir(tool)\n\tif err := os.MkdirAll(targetDir, 0o755); err != nil {\n\t\treturn 0, err\n\t}\n\tinstalled := 0\n\tfor _, name := range names {\n\t\ttarget := filepath.Join(targetDir, name)\n\t\tif tool == config.ToolOpenCode {\n\t\t\t// OpenCode hard-errors on the list-form tools: key (see\n\t\t\t// convertAgents), so the raw checkout file cannot be symlinked:\n\t\t\t// the host target gets a converted copy instead. Never clobber an\n\t\t\t// existing host agent — except this installer's own stale raw\n\t\t\t// symlink (one pointing at the checkout's agents/<name>), which is\n\t\t\t// replaced with the converted copy.\n\t\t\tif fi, err := os.Lstat(target); err == nil {\n\t\t\t\tif fi.Mode()&os.ModeSymlink != 0 {\n\t\t\t\t\tif dest, rerr := os.Readlink(target); rerr == nil && dest == filepath.Join(srcDir, name) {\n\t\t\t\t\t\tos.Remove(target) // our stale raw link — replaced below\n\t\t\t\t\t} else {\n\t\t\t\t\t\tcontinue // a foreign symlink — the user's setup wins\n\t\t\t\t\t}\n\t\t\t\t} else {\n\t\t\t\t\tcontinue // a regular file — the user's own agent wins\n\t\t\t\t}\n\t\t\t}\n\t\t\tdata, rerr := os.ReadFile(filepath.Join(srcDir, name))\n\t\t\tif rerr != nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif werr := os.WriteFile(target, convertAgentFile(data), 0o644); werr != nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tinstalled++\n\t\t\tcontinue\n\t\t}\n\t\t// Claude Code — raw symlink (list form is Claude's native schema).\n\t\t// Never clobber an existing host agent config — the user's own file\n\t\t// (or an existing symlink, dangling or not) wins.\n\t\tif _, err := os.Lstat(target); err == nil {\n\t\t\tcontinue\n\t\t}\n\t\tif err := os.Symlink(filepath.Join(srcDir, name), target); err != nil {\n\t\t\t// Skip names we couldn't link but keep going for the rest.\n\t\t\tcontinue\n\t\t}\n\t\tinstalled++\n\t}\n\treturn installed, nil\n}\n\n// hostGlobalSkillsDir resolves the host CLI's global skills directory for a\n// tool: ~/.claude/skills/ for Claude Code, ~/.config/opencode/skills/ for\n// OpenCode (the same locations the container path mounts the global skills\n// into). The dir is derived from $HOME (os.UserHomeDir), so tests can point it\n// at a temp dir.\nfunc hostGlobalSkillsDir(tool string) string {\n\thomeDir, err := os.UserHomeDir()\n\tif err != nil {\n\t\thomeDir = os.Getenv(\"HOME\")\n\t}\n\tif tool == config.ToolOpenCode {\n\t\treturn filepath.Join(homeDir, \".config\", \"opencode\", \"skills\")\n\t}\n\treturn filepath.Join(homeDir, \".claude\", \"skills\")\n}\n\n// installHostGlobalSkills surfaces the manigot checkout's global skills\n// (<home>/skills/) to the host CLI — the host equivalent of the container\n// path's read-only mount (mg host runs the CLI directly, with no mounts).\n//\n// A skill is a directory (SKILL.md plus optional support files), so delivery\n// is per-directory, mirroring installHostGlobalAgents' per-tool split:\n//\n//   - Claude Code: each skill dir is symlinked into ~/.claude/skills/ — the\n//     symlinks point at the live checkout dirs, so edits to skills/ are\n//     reflected without re-installing.\n//   - OpenCode: each skill dir is copied into ~/.config/opencode/skills/ — a\n//     self-contained snapshot rather than a symlink, so the CLI's skills dir\n//     never points into (or writes into) the manigot checkout.\n//\n// It never clobbers existing host skill config: a name already present in the\n// target dir is left untouched (the user's own host skill wins, mirroring the\n// project-overrides-global precedence). Nothing is created when the checkout\n// has no skills/ dir or no home can be located. Returns the number of skills\n// installed.\nfunc installHostGlobalSkills(tool string) (int, error) {\n\thomeDir := home.Root()\n\tif homeDir == \"\" {\n\t\treturn 0, nil\n\t}\n\tsrcDir := filepath.Join(homeDir, \"skills\")\n\tskills, err := listSkills(srcDir)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\tif len(skills) == 0 {\n\t\treturn 0, nil\n\t}\n\n\ttargetDir := hostGlobalSkillsDir(tool)\n\tif err := os.MkdirAll(targetDir, 0o755); err != nil {\n\t\treturn 0, err\n\t}\n\tinstalled := 0\n\tfor _, s := range skills {\n\t\ttarget := filepath.Join(targetDir, s.Name)\n\t\t// Never clobber an existing host skill — the user's own dir (or an\n\t\t// existing symlink, dangling or not) wins.\n\t\tif _, err := os.Lstat(target); err == nil {\n\t\t\tcontinue\n\t\t}\n\t\tif tool == config.ToolOpenCode {\n\t\t\t// OpenCode gets a copied snapshot (see the doc comment above).\n\t\t\tif err := copyDir(target, s.Dir); err != nil {\n\t\t\t\tcontinue // skip names we couldn't copy, keep going for the rest\n\t\t\t}\n\t\t} else {\n\t\t\t// Claude Code — raw symlink to the live checkout dir.\n\t\t\tif err := os.Symlink(s.Dir, target); err != nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tinstalled++\n\t}\n\treturn installed, nil\n}\n\n// hostGlobalMetaFile resolves the host CLI's global instruction file for a\n// tool — the single file the CLI loads in every session at its *global\n// instruction* location: ~/.claude/CLAUDE.md for Claude Code (the user-global\n// memory file) and ~/.config/opencode/AGENTS.md for OpenCode (the global\n// rules file) — the same locations the container path mounts <home>/prompts/meta.md\n// into. The path is derived from $HOME (os.UserHomeDir), so tests can point it\n// at a temp dir.\nfunc hostGlobalMetaFile(tool string) string {\n\thomeDir, err := os.UserHomeDir()\n\tif err != nil {\n\t\thomeDir = os.Getenv(\"HOME\")\n\t}\n\tif tool == config.ToolOpenCode {\n\t\treturn filepath.Join(homeDir, \".config\", \"opencode\", \"AGENTS.md\")\n\t}\n\treturn filepath.Join(homeDir, \".claude\", \"CLAUDE.md\")\n}\n\n// installHostGlobalMeta surfaces the manigot checkout's system-wide meta\n// prompt (<home>/prompts/meta.md) to the host CLI — the host equivalent of the\n// container path's read-only mount (mg host runs the CLI directly, with no\n// mounts).\n//\n// It delivers a single file by COPY, never a symlink: ~/.claude/CLAUDE.md is\n// Claude Code's user-writable memory file, so a symlink would let Claude's\n// /memory writes and agent edits land back in the manigot checkout. A copied\n// file keeps the host CLI's own global instruction file fully self-contained.\n//\n// It never clobbers an existing host file: a target that already exists (the\n// user's own CLAUDE.md / AGENTS.md) wins and nothing is written. Nothing is\n// created when the checkout has no prompts/meta.md or no home can be located. Returns\n// 1 when the file was installed, 0 otherwise.\nfunc installHostGlobalMeta(tool string) (int, error) {\n\thomeDir := home.Root()\n\tif homeDir == \"\" {\n\t\treturn 0, nil\n\t}\n\tsrc := filepath.Join(homeDir, \"prompts\", \"meta.md\")\n\tif !fs.IsFile(src) {\n\t\treturn 0, nil\n\t}\n\n\ttarget := hostGlobalMetaFile(tool)\n\t// Never clobber an existing host instruction file — the user's own file\n\t// wins.\n\tif _, err := os.Lstat(target); err == nil {\n\t\treturn 0, nil\n\t}\n\tif err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {\n\t\treturn 0, err\n\t}\n\tdata, err := os.ReadFile(src)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\tif err := os.WriteFile(target, data, 0o644); err != nil {\n\t\treturn 0, err\n\t}\n\treturn 1, nil\n}\n\n// Run executes the assembled CLI invocation, wiring stdin/stdout/stderr\n// through so Ctrl+C reaches the CLI directly (there is no container in\n// between), and returns the CLI's exit code.\nfunc (h HostInvocation) Run(stdin *os.File, stdout, stderr io.Writer) int {\n\tcmd := exec.Command(h.Argv[0], h.Argv[1:]...)\n\tcmd.Dir = h.Dir\n\tcmd.Env = h.Env\n\tcmd.Stdin = stdin\n\tcmd.Stdout = stdout\n\tcmd.Stderr = stderr\n\tif err := cmd.Run(); err != nil {\n\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n\t\t\treturn exitErr.ExitCode()\n\t\t}\n\t\tfmt.Fprintf(stderr, \"mg: %v\\n\", err)\n\t\treturn 1\n\t}\n\treturn 0\n}\n","numLines":530,"startLine":1,"totalLines":530}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TTWyMnrnqGAeAzEf2NZrX2","type":"tool_result","content":"1\tpackage session\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"fmt\"\n6\t\t\"io\"\n7\t\t\"math/rand/v2\"\n8\t\t\"os\"\n9\t\t\"os/exec\"\n10\t\t\"path/filepath\"\n11\t\t\"strconv\"\n12\t\t\"strings\"\n13\t\n14\t\t\"github.com/lmuskalla/manigot/internal/config\"\n15\t\t\"github.com/lmuskalla/manigot/internal/fs\"\n16\t\t\"github.com/lmuskalla/manigot/internal/git\"\n17\t\t\"github.com/lmuskalla/manigot/internal/home\"\n18\t)\n19\t\n20\t// DockerInvocation is a fully assembled `docker run` command.\n21\ttype DockerInvocation struct {\n22\t\t// Argv is the complete argument vector: [\"docker\", \"run\", ...].\n23\t\tArgv []string\n24\t\n25\t\t// Cleanup removes any host-side resources the invocation created (e.g.\n26\t\t// the converted-project-agents temp dir shadow-mounted over the docs\n27\t\t// mount's agents/ subpath — see BuildDockerInvocation's agentMount\n28\t\t// block). Run defers it so every caller — the interactive `mg` session\n29\t\t// path and `mg jdi`'s --print runs alike — gets the cleanup for free\n30\t\t// without having to know about it. nil when there is nothing to clean\n31\t\t// up.\n32\t\tCleanup func()\n33\t}\n34\t\n35\t// dockerImageName is the container image run.sh launched.\n36\tconst dockerImageName = \"manigot\"\n37\t\n38\t// terminalEnvVars lists the host terminal-identity variables forwarded into\n39\t// the container so the in-container agent TUIs see the real terminal. TUIs\n40\t// gate their copy/clipboard behavior on these: OSC 52 emission is decided\n41\t// from terminal identity/capability vars (TERM, COLORTERM, TERM_PROGRAM,\n42\t// TERM_PROGRAM_VERSION, VTE_VERSION, KITTY_WINDOW_ID, TMUX, TMUX_PANE,\n43\t// WT_SESSION — plus the WEZTERM_* family, which WezTerm sets several of).\n44\t// None of these were forwarded before, so the in-container TUIs saw an\n45\t// unrecognized terminal and copying from agent output silently failed (see\n46\t// the \"Clipboard / copying from agent sessions\" docs section).\n47\t//\n48\t// TMUX/TMUX_PANE are deliberately NOT forwarded for OpenCode sessions\n49\t// (terminalEnvArgs skips them when the tool is OpenCode): when OpenCode sees\n50\t// TMUX set it wraps its OSC 52 clipboard write in tmux's DCS-passthrough\n51\t// escape, which default tmux configuration discards entirely\n52\t// (allow-passthrough defaults to off), so the host clipboard is never\n53\t// touched. Stripping TMUX makes OpenCode emit plain OSC 52, which tmux's\n54\t// set-clipboard on handles correctly. Claude Code's container env stays\n55\t// byte-identical — TMUX/TMUX_PANE are still forwarded for it.\n56\t//\n57\t// Each var is forwarded only when set and non-empty on the host — never an\n58\t// empty value — so a session launched outside a terminal (CI, a script)\n59\t// keeps a byte-identical argv to a build without this feature.\n60\tvar terminalEnvVars = []string{\n61\t\t\"TERM\",\n62\t\t\"COLORTERM\",\n63\t\t\"TERM_PROGRAM\",\n64\t\t\"TERM_PROGRAM_VERSION\",\n65\t\t\"VTE_VERSION\",\n66\t\t\"KITTY_WINDOW_ID\",\n67\t\t\"TMUX\",\n68\t\t\"TMUX_PANE\",\n69\t\t\"WT_SESSION\",\n70\t}\n71\t\n72\t// tmuxEnvVars are the terminal-identity vars whose forwarding is gated on\n73\t// the resolved tool: they are sent only to Claude Code, never to OpenCode\n74\t// (see the comment on terminalEnvVars for why).\n75\tvar tmuxEnvVars = map[string]bool{\n76\t\t\"TMUX\":      true,\n77\t\t\"TMUX_PANE\": true,\n78\t}\n79\t\n80\t// terminalEnvArgs returns the docker -e entries forwarding the host's\n81\t// terminal identity into the container: every terminalEnvVars entry that is\n82\t// set and non-empty on the host, plus every WEZTERM_* variable (also only\n83\t// when set to a non-empty value). TMUX/TMUX_PANE are skipped when tool is\n84\t// OpenCode (see terminalEnvVars). No var set → an empty slice, keeping the\n85\t// docker argv byte-identical to a session built without terminal forwarding.\n86\tfunc terminalEnvArgs(tool string) []string {\n87\t\tvar args []string\n88\t\tfor _, key := range terminalEnvVars {\n89\t\t\tif tmuxEnvVars[key] && tool == config.ToolOpenCode {\n90\t\t\t\tcontinue\n91\t\t\t}\n92\t\t\tif v := os.Getenv(key); v != \"\" {\n93\t\t\t\targs = append(args, \"-e\", key+\"=\"+v)\n94\t\t\t}\n95\t\t}\n96\t\tfor _, kv := range os.Environ() {\n97\t\t\tname, value, ok := strings.Cut(kv, \"=\")\n98\t\t\tif ok && strings.HasPrefix(name, \"WEZTERM_\") && value != \"\" {\n99\t\t\t\targs = append(args, \"-e\", kv)\n100\t\t\t}\n101\t\t}\n102\t\treturn args\n103\t}\n104\t\n105\t// warnTmuxClipboard detects the tmux clipboard-interception failure mode at\n106\t// session start and warns on diag (stderr — the diagnostics stream): when the\n107\t// session is interactive (a TUI to copy from — --print/mg-jdi runs capture\n108\t// JSON output instead, so the check is skipped), the host is inside tmux\n109\t// ($TMUX set) and tmux is on PATH, `tmux show-options -g set-clipboard` is\n110\t// run; if it reports off, tmux will strip the OSC 52 clipboard writes the\n111\t// in-container TUIs emit, so copying from the agent shows \"copied\" but never\n112\t// reaches the host clipboard. Strictly read-only: no tmux state is mutated,\n113\t// and any tmux failure (not installed, no server, an option query error)\n114\t// silently skips the check — no launch path can break because of it.\n115\tfunc warnTmuxClipboard(diag io.Writer, interactive, print bool) {\n116\t\tif !interactive || print {\n117\t\t\treturn\n118\t\t}\n119\t\tif os.Getenv(\"TMUX\") == \"\" {\n120\t\t\treturn\n121\t\t}\n122\t\tif _, err := exec.LookPath(\"tmux\"); err != nil {\n123\t\t\treturn\n124\t\t}\n125\t\tout, err := exec.Command(\"tmux\", \"show-options\", \"-g\", \"set-clipboard\").Output()\n126\t\tif err != nil {\n127\t\t\treturn\n128\t\t}\n129\t\tif strings.TrimSpace(string(out)) == \"set-clipboard off\" {\n130\t\t\tfmt.Fprintln(diag, \"Warning: your tmux has set-clipboard off — it will swallow OSC 52 clipboard writes from the agent, so copying inside the session won't reach your host clipboard.\")\n131\t\t\tfmt.Fprintln(diag, \"         Run 'tmux set -g set-clipboard on' to fix it (see the 'Clipboard / copying from agent sessions' docs section).\")\n132\t\t}\n133\t}\n134\t\n135\t// BuildDockerInvocation assembles the docker run argv, mirroring run.sh's\n136\t// launch construction — every flag, mount, and env\n137\t// var is load-bearing, so the argument order and exact strings are pinned by\n138\t// the tests. Diagnostics (banner, warnings, shadowing lines) are written to\n139\t// diag — always stderr, per the brief's note 1 (the script's fd-3 juggling\n140\t// existed only to keep --print stdout clean; Go separates the streams\n141\t// natively). interactive controls the -it flag (stdin is a terminal).\n142\tfunc BuildDockerInvocation(opts Options, info ProfileInfo, root Root, interactive bool, diag io.Writer) (DockerInvocation, error) {\n143\t\t// The .env warning run.sh printed when the file was missing.\n144\t\tif envFile := config.EnvFile(); envFile != \"\" {\n145\t\t\tif _, err := os.Stat(envFile); err != nil {\n146\t\t\t\tfmt.Fprintf(diag, \"Warning: no .env found at %s\\n\", envFile)\n147\t\t\t}\n148\t\t}\n149\t\n150\t\t// The tmux OSC 52 clipboard-interception warning (TASK-2 of the clipboard\n151\t\t// job): strictly read-only, failures silently skipped.\n152\t\twarnTmuxClipboard(diag, interactive, opts.Print)\n153\t\n154\t\t// ── Git identity ─────────────────────────────────────────────────────────\n155\t\t// Host GIT_AUTHOR_NAME/EMAIL env vars win; otherwise fall back to the\n156\t\t// project's git config (local overrides global, matching git behavior).\n157\t\tgitName := os.Getenv(\"GIT_AUTHOR_NAME\")\n158\t\tif gitName == \"\" {\n159\t\t\tgitName = git.ConfigUserName(root.ProjectRoot)\n160\t\t}\n161\t\tgitEmail := os.Getenv(\"GIT_AUTHOR_EMAIL\")\n162\t\tif gitEmail == \"\" {\n163\t\t\tgitEmail = git.ConfigEmail(root.ProjectRoot)\n164\t\t}\n165\t\tif gitName == \"\" || gitEmail == \"\" {\n166\t\t\tfmt.Fprintln(diag, \"Warning: no git user.name/user.email configured for this project — container commits will fall back to a generic 'manigot' identity.\")\n167\t\t}\n168\t\n169\t\t// ── Docs mount target + context file ────────────────────────────────────\n170\t\tdocsMountTarget := \"/workspace/.claude\"\n171\t\tif info.Tool == config.ToolOpenCode {\n172\t\t\tdocsMountTarget = \"/workspace/.opencode\"\n173\t\t}\n174\t\n175\t\tcontextFile := \"\"\n176\t\tif fs.IsFile(filepath.Join(root.DocsDir, \"AGENTS.md\")) {\n177\t\t\tcontextFile = filepath.Join(root.DocsDir, \"AGENTS.md\")\n178\t\t} else if fs.IsFile(filepath.Join(root.DocsDir, \"CLAUDE.md\")) {\n179\t\t\tcontextFile = filepath.Join(root.DocsDir, \"CLAUDE.md\")\n180\t\t}\n181\t\n182\t\tvar contextMount []string\n183\t\tcontextTarget := \"\"\n184\t\tif contextFile != \"\" {\n185\t\t\tif info.Tool == config.ToolOpenCode {\n186\t\t\t\tcontextTarget = \"/workspace/AGENTS.md\"\n187\t\t\t} else {\n188\t\t\t\tcontextTarget = \"/workspace/.claude/CLAUDE.md\"\n189\t\t\t}\n190\t\t\tcontextMount = []string{\"-v\", contextFile + \":\" + contextTarget + \":ro\"}\n191\t\t} else if root.DocsInitialized {\n192\t\t\tfmt.Fprintf(diag, \"Warning: no docs/AGENTS.md found — the agent will start without project context.\\n\")\n193\t\t} else {\n194\t\t\tfmt.Fprintln(diag, \"Note: no docs/ directory — starting a plain session with no project context or job workflow.\")\n195\t\t\tfmt.Fprintln(diag, \"      See 'Per-project setup' in the manigot README to enable them.\")\n196\t\t}\n197\t\n198\t\tvar docsMount []string\n199\t\tif fs.IsDir(root.DocsDir) {\n200\t\t\tdocsMount = []string{\"-v\", root.DocsDir + \":\" + docsMountTarget + \":z\"}\n201\t\t}\n202\t\n203\t\t// ── Project agents ─────────────────────────────────────────────────────\n204\t\t// docs/agents/ rides along inside the docs mount above — fine for Claude\n205\t\t// Code, whose subagent schema the list-form frontmatter already is, but\n206\t\t// OpenCode hard-errors on the list-form tools: key (see convertAgents),\n207\t\t// so custom project agents must be converted before the container sees\n208\t\t// them. The converted copies land in a temp dir shadow-mounted over the\n209\t\t// docs mount's agents/ subpath; the host's docs/agents/ source tree is\n210\t\t// never modified. The temp dir is removed via the invocation's Cleanup\n211\t\t// hook (see DockerInvocation.Run).\n212\t\tvar agentMount []string\n213\t\tvar agentCleanup func()\n214\t\tif tmp, hasAgents, err := convertAgents(filepath.Join(root.DocsDir, \"agents\"), info.Tool); err != nil {\n215\t\t\treturn DockerInvocation{}, fmt.Errorf(\"convert project agents: %w\", err)\n216\t\t} else if hasAgents {\n217\t\t\tagentMount = []string{\"-v\", tmp + \":/workspace/.opencode/agents:z\"}\n218\t\t\tagentCleanup = func() { os.RemoveAll(tmp) }\n219\t\t}\n220\t\n221\t\t// ── Global agents ─────────────────────────────────────────────────────\n222\t\t// The global agents dir (<home>/agents/) is no longer baked into the\n223\t\t// image — it lives on the host in the manigot checkout and is mounted\n224\t\t// read-only into the container at the CLI's global agent location, so the\n225\t\t// container can use the host's agents but cannot modify them. This keeps\n226\t\t// the image purely isolation for workspaces and makes the same agents\n227\t\t// available to `mg host` (see host.go). Project agents (docs/agents/,\n228\t\t// above) still ride the docs mount and override global agents of the same\n229\t\t// name, exactly as before.\n230\t\t//\n231\t\t// Claude Code reads global subagents from ~/.claude/agents/ and takes the\n232\t\t// list-form frontmatter natively, so the host's files mount verbatim.\n233\t\t// OpenCode reads global agents from ~/.config/opencode/agents/ and\n234\t\t// hard-errors on the list-form tools: key, so the mounted files are\n235\t\t// converted first (name:/tools: stripped, permission: passed through —\n236\t\t// see convertAgents) into a temp dir shadow-mounted over the CLI's global\n237\t\t// agents path, cleaned up via the invocation's Cleanup hook.\n238\t\tvar globalAgentMount []string\n239\t\tvar globalAgentCleanup func()\n240\t\tif homeDir := home.Root(); homeDir != \"\" {\n241\t\t\tglobalAgentsDir := filepath.Join(homeDir, \"agents\")\n242\t\t\tif fs.IsDir(globalAgentsDir) {\n243\t\t\t\tif info.Tool == config.ToolOpenCode {\n244\t\t\t\t\tif tmp, hasAgents, err := convertAgents(globalAgentsDir, info.Tool); err != nil {\n245\t\t\t\t\t\treturn DockerInvocation{}, fmt.Errorf(\"convert global agents: %w\", err)\n246\t\t\t\t\t} else if hasAgents {\n247\t\t\t\t\t\tglobalAgentMount = []string{\"-v\", tmp + \":/home/claude/.config/opencode/agents:ro\"}\n248\t\t\t\t\t\tglobalAgentCleanup = func() { os.RemoveAll(tmp) }\n249\t\t\t\t\t}\n250\t\t\t\t} else {\n251\t\t\t\t\tglobalAgentMount = []string{\"-v\", globalAgentsDir + \":/home/claude/.claude/agents:ro\"}\n252\t\t\t\t}\n253\t\t\t}\n254\t\t}\n255\t\n256\t\t// ── Global skills ─────────────────────────────────────────────────────\n257\t\t// Skills follow the same global + project model as agents, applied to a\n258\t\t// different unit: a skill is a directory (SKILL.md plus support files),\n259\t\t// not a single file. Global skills live in the manigot checkout\n260\t\t// (<home>/skills/) and are mounted read-only into the container at the\n261\t\t// CLI's global skills location — ~/.claude/skills for Claude Code,\n262\t\t// ~/.config/opencode/skills for OpenCode — where both CLIs load skills at\n263\t\t// startup, independent of the active agent. That single global location is\n264\t\t// exactly what makes a skill available to every agent and to invocations\n265\t\t// that name no agent; project skills (docs/skills/, below) ride the docs\n266\t\t// mount and override global skills of the same name.\n267\t\t//\n268\t\t// Unlike agents, skills need no frontmatter conversion — both CLIs read\n269\t\t// SKILL.md and its frontmatter natively — so Claude Code gets the host's\n270\t\t// skills dir verbatim (a read-only bind, like its agents mount). OpenCode\n271\t\t// gets a staged copy instead (see stageGlobalSkills), mounted read-only\n272\t\t// and cleaned up via the invocation's Cleanup hook, so the CLI's skills\n273\t\t// dir is a fresh, disposable snapshot and the host's skills/ source tree\n274\t\t// is never touched. Skipped cleanly when the checkout has no skills dir.\n275\t\tvar globalSkillMount []string\n276\t\tvar globalSkillCleanup func()\n277\t\tif homeDir := home.Root(); homeDir != \"\" {\n278\t\t\tglobalSkillsDir := filepath.Join(homeDir, \"skills\")\n279\t\t\tif fs.IsDir(globalSkillsDir) {\n280\t\t\t\tif info.Tool == config.ToolOpenCode {\n281\t\t\t\t\tif tmp, hasSkills, err := stageGlobalSkills(globalSkillsDir); err != nil {\n282\t\t\t\t\t\treturn DockerInvocation{}, fmt.Errorf(\"stage global skills: %w\", err)\n283\t\t\t\t\t} else if hasSkills {\n284\t\t\t\t\t\tglobalSkillMount = []string{\"-v\", tmp + \":/home/claude/.config/opencode/skills:ro\"}\n285\t\t\t\t\t\tglobalSkillCleanup = func() { os.RemoveAll(tmp) }\n286\t\t\t\t\t}\n287\t\t\t\t} else {\n288\t\t\t\t\tglobalSkillMount = []string{\"-v\", globalSkillsDir + \":/home/claude/.claude/skills:ro\"}\n289\t\t\t\t}\n290\t\t\t}\n291\t\t}\n292\t\n293\t\t// ── Global meta prompt ─────────────────────────────────────────────────\n294\t\t// The meta prompt (<home>/prompts/meta.md) is a system-wide instruction file that\n295\t\t// sits *above* agents and skills in the instruction hierarchy: it is\n296\t\t// injected into every session, regardless of agent, project, or\n297\t\t// interactive/--print mode. Each CLI loads it from its *global\n298\t\t// instruction* location — ~/.claude/CLAUDE.md for Claude Code (the\n299\t\t// user-global memory file, loaded before the project context at\n300\t\t// /workspace/.claude/CLAUDE.md) and ~/.config/opencode/AGENTS.md for\n301\t\t// OpenCode (the global rules file, loaded alongside the project context\n302\t\t// mount) — so the project context still wins on conflict.\n303\t\t//\n304\t\t// Like skills, the file is plain markdown native to both CLIs, so no\n305\t\t// conversion and no temp dir are needed (and thus no Cleanup hook): the\n306\t\t// checkout file is mounted read-only at the per-tool target. A checkout\n307\t\t// without prompts/meta.md yields no mount (it is optional, like skills).\n308\t\tvar globalMetaMount []string\n309\t\tif homeDir := home.Root(); homeDir != \"\" {\n310\t\t\tmetaFile := filepath.Join(homeDir, \"prompts\", \"meta.md\")\n311\t\t\tif fs.IsFile(metaFile) {\n312\t\t\t\tif info.Tool == config.ToolOpenCode {\n313\t\t\t\t\tglobalMetaMount = []string{\"-v\", metaFile + \":/home/claude/.config/opencode/AGENTS.md:ro\"}\n314\t\t\t\t} else {\n315\t\t\t\t\tglobalMetaMount = []string{\"-v\", metaFile + \":/home/claude/.claude/CLAUDE.md:ro\"}\n316\t\t\t\t}\n317\t\t\t}\n318\t\t}\n319\t\n320\t\t// ── Project skills ────────────────────────────────────────────────────\n321\t\t// Project skills (docs/skills/<name>/SKILL.md) need no staging or shadow\n322\t\t// mount: the docs bind mount above maps the whole docs/ dir, so\n323\t\t// docs/skills/ already lands at the project skills location inside the\n324\t\t// container (/workspace/.claude/skills for Claude Code,\n325\t\t// /workspace/.opencode/skills for OpenCode), and both CLIs natively prefer\n326\t\t// a project skill over a global skill of the same name. Skills differ from\n327\t\t// project agents here — agents needed a converted shadow mount over the\n328\t\t// docs mount's agents/ subpath for OpenCode (it hard-errors on the\n329\t\t// list-form tools: key), while skills need no conversion, so the plain\n330\t\t// docs mount is sufficient.\n331\t\n332\t\t// ── Job prompt ──────────────────────────────────────────────────────────\n333\t\tinitialPrompt := \"\"\n334\t\tif root.Job != \"\" {\n335\t\t\tcontainerJobDir := \"/workspace/docs/jobs/\" + root.Job\n336\t\t\tinitialPrompt = \"Please work on the job at \" + containerJobDir + \" — start by reading brief.md\"\n337\t\t\tif opts.Print {\n338\t\t\t\t// --print sessions are non-interactive and unattended, so they get\n339\t\t\t\t// the NEEDS-HUMAN-INPUT marker definition (interactive sessions\n340\t\t\t\t// never see this — a human is there to answer questions).\n341\t\t\t\tinitialPrompt += \"\\n\\nYou are running non-interactively and unattended — no human is watching this session or able to answer questions. If you cannot proceed without a human decision, stop immediately and print a line starting with exactly `NEEDS-HUMAN-INPUT:` followed by a one-sentence reason, and make no further changes.\"\n342\t\t\t}\n343\t\t} else if opts.Prompt != \"\" {\n344\t\t\tinitialPrompt = opts.Prompt\n345\t\t}\n346\t\n347\t\tvar agentFlag []string\n348\t\tif opts.Agent != \"\" {\n349\t\t\tagentFlag = []string{\"--agent\", opts.Agent}\n350\t\t}\n351\t\n352\t\t// Claude takes the prompt positionally; OpenCode as --prompt.\n353\t\tvar promptArgs []string\n354\t\tif initialPrompt != \"\" {\n355\t\t\tif info.Tool == config.ToolOpenCode {\n356\t\t\t\tpromptArgs = []string{\"--prompt\", initialPrompt}\n357\t\t\t} else {\n358\t\t\t\tpromptArgs = []string{initialPrompt}\n359\t\t\t}\n360\t\t}\n361\t\n362\t\t// ── .env shadow mounts ──────────────────────────────────────────────────\n363\t\tvar envMounts []string\n364\t\tfor _, envFile := range findEnvFiles(root.ProjectRoot) {\n365\t\t\trel := strings.TrimPrefix(envFile, root.ProjectRoot)\n366\t\t\tcontainerPath := \"/workspace\" + rel\n367\t\t\tfmt.Fprintf(diag, \"  Shadowing: %s → /dev/null inside container\\n\", envFile)\n368\t\t\tenvMounts = append(envMounts, \"--mount\", \"type=bind,source=/dev/null,target=\"+containerPath+\",readonly\")\n369\t\t}\n370\t\tif len(envMounts) == 0 {\n371\t\t\tfmt.Fprintln(diag, \"  Shadowed : none (no .env files found)\")\n372\t\t}\n373\t\n374\t\t// ── Flavor quote ────────────────────────────────────────────────────────\n375\t\t// Picked once per session from assets/quotes.json; skipped in --print mode\n376\t\t// (the entrypoint wouldn't print it anyway). Missing/empty is not an error.\n377\t\tquote := \"\"\n378\t\tif !opts.Print {\n379\t\t\tquote = pickQuote()\n380\t\t}\n381\t\n382\t\t// ── Info banner ─────────────────────────────────────────────────────────\n383\t\tfmt.Fprintln(diag, \"╔══════════════════════════════════════╗\")\n384\t\tfmt.Fprintln(diag, \"║           manigot                   ║\")\n385\t\tfmt.Fprintln(diag, \"╠══════════════════════════════════════╣\")\n386\t\tfmt.Fprintln(diag, \"║  Entering safehouse (isolated session)...\")\n387\t\tfmt.Fprintf(diag, \"║  Project : %s\\n\", filepath.Base(root.InvocationRoot))\n388\t\tfmt.Fprintf(diag, \"║  Root    : %s\\n\", root.ProjectRoot)\n389\t\tif root.DocsInitialized {\n390\t\t\tfmt.Fprintf(diag, \"║  Docs    : %s\\n\", root.DocsDir)\n391\t\t} else {\n392\t\t\tfmt.Fprintln(diag, \"║  Docs    : (none — job workflow unavailable, running off the books)\")\n393\t\t}\n394\t\tif contextFile != \"\" {\n395\t\t\tfmt.Fprintf(diag, \"║  Context : %s → %s\\n\", contextFile, contextTarget)\n396\t\t}\n397\t\tif info.Profile != \"\" {\n398\t\t\tfmt.Fprintf(diag, \"║  Profile : %s\\n\", info.Profile)\n399\t\t}\n400\t\tif info.Tool != \"\" {\n401\t\t\tfmt.Fprintf(diag, \"║  Tool    : %s\\n\", info.Tool)\n402\t\t}\n403\t\tif opts.Agent != \"\" {\n404\t\t\tfmt.Fprintf(diag, \"║  Agent   : %s\\n\", opts.Agent)\n405\t\t}\n406\t\tif root.Job != \"\" {\n407\t\t\tfmt.Fprintf(diag, \"║  Job     : %s\\n\", root.Job)\n408\t\t}\n409\t\tif opts.Print {\n410\t\t\tfmt.Fprintln(diag, \"║  Print   : yes (non-interactive)\")\n411\t\t}\n412\t\tfmt.Fprintln(diag, \"╚══════════════════════════════════════╝\")\n413\t\tfmt.Fprintln(diag, \"\")\n414\t\n415\t\t// ── Assemble the argv ───────────────────────────────────────────────────\n416\t\tvar ttyFlags []string\n417\t\tif interactive && !opts.Print {\n418\t\t\tttyFlags = []string{\"-it\"}\n419\t\t}\n420\t\n421\t\t// ── Git common-dir mount ────────────────────────────────────────────────\n422\t\t// Committing agents need the gitdir writable (they commit their work);\n423\t\t// non-committing agents get it read-only so they physically cannot touch\n424\t\t// git metadata — the hard filesystem boundary behind the soft git shim —\n425\t\t// with GIT_OPTIONAL_LOCKS=0 so read commands that would refresh the index\n426\t\t// (git status, git diff) don't fail on the ro mount.\n427\t\tvar gitDirMount []string\n428\t\tvar gitDirEnv []string\n429\t\tcommits := agentCommits(opts, root)\n430\t\tif root.GitCommonDir != \"\" {\n431\t\t\tmode := \"z\"\n432\t\t\tif !commits {\n433\t\t\t\tmode = \"ro\"\n434\t\t\t\tgitDirEnv = []string{\"-e\", \"GIT_OPTIONAL_LOCKS=0\"}\n435\t\t\t}\n436\t\t\tgitDirMount = []string{\"-v\", root.GitCommonDir + \":\" + root.GitCommonDir + \":\" + mode}\n437\t\t}\n438\t\n439\t\t// ── Gitdir overlay mounts (job-worktree sessions) ───────────────────────\n440\t\t// The gitdir mount exposes the whole repository's git metadata; read-only\n441\t\t// overlay mounts shadow the sensitive subpaths so an agent cannot corrupt\n442\t\t// them. Each overlay skips a missing source — docker would otherwise\n443\t\t// create an empty, root-owned directory at the target path.\n444\t\tvar gitOverlayMounts []string\n445\t\tif root.GitCommonDir != \"\" {\n446\t\t\t// hooks/: an agent must not plant a hook that would later execute on\n447\t\t\t// host-side git operations (mg done, mg delete) with host privileges.\n448\t\t\tif hooksDir := filepath.Join(root.GitCommonDir, \"hooks\"); fs.IsDir(hooksDir) {\n449\t\t\t\tgitOverlayMounts = append(gitOverlayMounts, \"-v\", hooksDir+\":\"+hooksDir+\":ro\")\n450\t\t\t}\n451\t\t\t// worktrees/: every OTHER job's worktree gitdir, so a misbehaving\n452\t\t\t// agent cannot delete or corrupt another job's worktree registration.\n453\t\t\t// The current job's own worktree gitdir is excluded by the helper —\n454\t\t\t// it must stay writable for commits.\n455\t\t\tif wtDirs, err := git.WorktreeGitDirs(root.ProjectRoot, root.ProjectRoot); err == nil {\n456\t\t\t\tfor _, wtDir := range wtDirs {\n457\t\t\t\t\tif !fs.IsDir(wtDir) {\n458\t\t\t\t\t\tcontinue\n459\t\t\t\t\t}\n460\t\t\t\t\tgitOverlayMounts = append(gitOverlayMounts, \"-v\", wtDir+\":\"+wtDir+\":ro\")\n461\t\t\t\t}\n462\t\t\t}\n463\t\t}\n464\t\n465\t\targv := []string{\"run\"}\n466\t\targv = append(argv, ttyFlags...)\n467\t\targv = append(argv, \"--rm\")\n468\t\targv = append(argv, \"--name\", fmt.Sprintf(\"manigot-%s-%d\", filepath.Base(root.ProjectRoot), os.Getpid()))\n469\t\targv = append(argv, \"--user\", fmt.Sprintf(\"%d:%d\", os.Getuid(), os.Getgid()))\n470\t\targv = append(argv, \"-v\", root.ProjectRoot+\":/workspace:z\")\n471\t\targv = append(argv, gitDirMount...)\n472\t\targv = append(argv, gitOverlayMounts...)\n473\t\targv = append(argv, docsMount...)\n474\t\targv = append(argv, agentMount...)\n475\t\targv = append(argv, globalAgentMount...)\n476\t\targv = append(argv, globalSkillMount...)\n477\t\targv = append(argv, globalMetaMount...)\n478\t\targv = append(argv, contextMount...)\n479\t\targv = append(argv, envMounts...)\n480\t\targv = append(argv, gitDirEnv...)\n481\t\targv = append(argv, terminalEnvArgs(info.Tool)...)\n482\t\targv = append(argv, info.KeyEnv...)\n483\t\targv = append(argv, \"-e\", \"GIT_AUTHOR_NAME_CFG=\"+gitName)\n484\t\targv = append(argv, \"-e\", \"GIT_AUTHOR_EMAIL_CFG=\"+gitEmail)\n485\t\targv = append(argv, \"-e\", \"MANIGOT_TOOL=\"+info.Tool)\n486\t\targv = append(argv, \"-e\", \"MANIGOT_PRINT=\"+strconv.FormatBool(opts.Print))\n487\t\targv = append(argv, \"-e\", \"MANIGOT_QUOTE=\"+quote)\n488\t\t// MANIGOT_AGENT_COMMITS tells container-side tooling which agent is\n489\t\t// running: the `shot` render tool's wrapper guard refuses to run for\n490\t\t// non-committing agents (the Claude Code gating layer — OpenCode enforces\n491\t\t// the same via permission: blocks), mirroring the git shim's soft layer.\n492\t\t// Defaults to true when unset, matching agentCommits' own default so a\n493\t\t// missing marker never breaks a committing agent.\n494\t\targv = append(argv, \"-e\", \"MANIGOT_AGENT_COMMITS=\"+strconv.FormatBool(commits))\n495\t\targv = append(argv, \"--network=bridge\")\n496\t\targv = append(argv, \"--memory=2g\")\n497\t\targv = append(argv, \"--security-opt=no-new-privileges\")\n498\t\targv = append(argv, dockerImageName)\n499\t\targv = append(argv, agentFlag...)\n500\t\targv = append(argv, promptArgs...)\n501\t\targv = append(argv, opts.Pass...)\n502\t\n503\t\t// Combine the project-agent, global-agent and global-skill temp-dir\n504\t\t// cleanups (whichever are non-nil) into a single hook run after the\n505\t\t// container exits.\n506\t\tvar cleanup func()\n507\t\tif agentCleanup != nil || globalAgentCleanup != nil || globalSkillCleanup != nil {\n508\t\t\tcleanup = func() {\n509\t\t\t\tif agentCleanup != nil {\n510\t\t\t\t\tagentCleanup()\n511\t\t\t\t}\n512\t\t\t\tif globalAgentCleanup != nil {\n513\t\t\t\t\tglobalAgentCleanup()\n514\t\t\t\t}\n515\t\t\t\tif globalSkillCleanup != nil {\n516\t\t\t\t\tglobalSkillCleanup()\n517\t\t\t\t}\n518\t\t\t}\n519\t\t}\n520\t\n521\t\treturn DockerInvocation{Argv: append([]string{\"docker\"}, argv...), Cleanup: cleanup}, nil\n522\t}\n523\t\n524\t// Run executes the assembled docker invocation, wiring stdin/stdout/stderr\n525\t// through so Ctrl+C reaches the container, and returns docker's exit code.\n526\t// The second return value reports whether docker was actually exec'd — false\n527\t// only when the launch itself failed before docker ran (docker missing on\n528\t// PATH, permission denied, ...). It is the \"did the container session\n529\t// happen\" signal the job-worktree sweep keys off (see SweepJobWorktree): an\n530\t// agent that never ran must not trigger a sweep commit. An ExitError — docker\n531\t// ran and exited non-zero — still counts as ran=true: the session happened,\n532\t// even when the agent's exit code was non-zero.\n533\t// The invocation's Cleanup hook (if any) runs after the container exits.\n534\tfunc (d DockerInvocation) Run(stdin *os.File, stdout, stderr io.Writer) (int, bool) {\n535\t\tif d.Cleanup != nil {\n536\t\t\tdefer d.Cleanup()\n537\t\t}\n538\t\tcmd := exec.Command(d.Argv[0], d.Argv[1:]...)\n539\t\tcmd.Stdin = stdin\n540\t\tcmd.Stdout = stdout\n541\t\tcmd.Stderr = stderr\n542\t\tif err := cmd.Run(); err != nil {\n543\t\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n544\t\t\t\treturn exitErr.ExitCode(), true\n545\t\t\t}\n546\t\t\tfmt.Fprintf(stderr, \"mg: %v\\n\", err)\n547\t\t\treturn 1, false\n548\t\t}\n549\t\treturn 0, true\n550\t}\n551\t\n552\t// findEnvFiles lists every .env / .env.* file under root (recursively),\n553\t// excluding *.example and *.sample — the shadow-mount targets of run.sh.\n554\tfunc findEnvFiles(root string) []string {\n555\t\tvar files []string\n556\t\tfilepath.WalkDir(root, func(path string, d os.DirEntry, err error) error {\n557\t\t\tif err != nil {\n558\t\t\t\treturn nil\n559\t\t\t}\n560\t\t\tif d.IsDir() {\n561\t\t\t\treturn nil\n562\t\t\t}\n563\t\t\tname := d.Name()\n564\t\t\tif name != \".env\" && !strings.HasPrefix(name, \".env.\") {\n565\t\t\t\treturn nil\n566\t\t\t}\n567\t\t\tif strings.HasSuffix(name, \".example\") || strings.HasSuffix(name, \".sample\") {\n568\t\t\t\treturn nil\n569\t\t\t}\n570\t\t\tfiles = append(files, path)\n571\t\t\treturn nil\n572\t\t})\n573\t\treturn files\n574\t}\n575\t\n576\t// pickQuote parses assets/quotes.json (a JSON array of strings) and returns a\n577\t// random entry, or \"\" when the file is missing or unparseable — missing/empty\n578\t// just means no quote this session, not an error.\n579\tfunc pickQuote() string {\n580\t\thome := home.Root()\n581\t\tif home == \"\" {\n582\t\t\treturn \"\"\n583\t\t}\n584\t\tdata, err := os.ReadFile(filepath.Join(home, \"assets\", \"quotes.json\"))\n585\t\tif err != nil {\n586\t\t\treturn \"\"\n587\t\t}\n588\t\tvar quotes []string\n589\t\tif err := json.Unmarshal(data, &quotes); err != nil {\n590\t\t\treturn \"\"\n591\t\t}\n592\t\tif len(quotes) == 0 {\n593\t\t\treturn \"\"\n594\t\t}\n595\t\treturn quotes[rand.IntN(len(quotes))]\n596\t}\n597\t"}]},"parent_tool_use_id":null,"session_id":"0ad41780-e2e7-4ebf-861d-9c61d66ababf","uuid":"f96f745a-f6cd-44f0-9514-f284363b2b99","timestamp":"2026-08-29T08:59:41.187Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/session/docker.go","content":"package session\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"math/rand/v2\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/fs\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/home\"\n)\n\n// DockerInvocation is a fully assembled `docker run` command.\ntype DockerInvocation struct {\n\t// Argv is the complete argument vector: [\"docker\", \"run\", ...].\n\tArgv []string\n\n\t// Cleanup removes any host-side resources the invocation created (e.g.\n\t// the converted-project-agents temp dir shadow-mounted over the docs\n\t// mount's agents/ subpath — see BuildDockerInvocation's agentMount\n\t// block). Run defers it so every caller — the interactive `mg` session\n\t// path and `mg jdi`'s --print runs alike — gets the cleanup for free\n\t// without having to know about it. nil when there is nothing to clean\n\t// up.\n\tCleanup func()\n}\n\n// dockerImageName is the container image run.sh launched.\nconst dockerImageName = \"manigot\"\n\n// terminalEnvVars lists the host terminal-identity variables forwarded into\n// the container so the in-container agent TUIs see the real terminal. TUIs\n// gate their copy/clipboard behavior on these: OSC 52 emission is decided\n// from terminal identity/capability vars (TERM, COLORTERM, TERM_PROGRAM,\n// TERM_PROGRAM_VERSION, VTE_VERSION, KITTY_WINDOW_ID, TMUX, TMUX_PANE,\n// WT_SESSION — plus the WEZTERM_* family, which WezTerm sets several of).\n// None of these were forwarded before, so the in-container TUIs saw an\n// unrecognized terminal and copying from agent output silently failed (see\n// the \"Clipboard / copying from agent sessions\" docs section).\n//\n// TMUX/TMUX_PANE are deliberately NOT forwarded for OpenCode sessions\n// (terminalEnvArgs skips them when the tool is OpenCode): when OpenCode sees\n// TMUX set it wraps its OSC 52 clipboard write in tmux's DCS-passthrough\n// escape, which default tmux configuration discards entirely\n// (allow-passthrough defaults to off), so the host clipboard is never\n// touched. Stripping TMUX makes OpenCode emit plain OSC 52, which tmux's\n// set-clipboard on handles correctly. Claude Code's container env stays\n// byte-identical — TMUX/TMUX_PANE are still forwarded for it.\n//\n// Each var is forwarded only when set and non-empty on the host — never an\n// empty value — so a session launched outside a terminal (CI, a script)\n// keeps a byte-identical argv to a build without this feature.\nvar terminalEnvVars = []string{\n\t\"TERM\",\n\t\"COLORTERM\",\n\t\"TERM_PROGRAM\",\n\t\"TERM_PROGRAM_VERSION\",\n\t\"VTE_VERSION\",\n\t\"KITTY_WINDOW_ID\",\n\t\"TMUX\",\n\t\"TMUX_PANE\",\n\t\"WT_SESSION\",\n}\n\n// tmuxEnvVars are the terminal-identity vars whose forwarding is gated on\n// the resolved tool: they are sent only to Claude Code, never to OpenCode\n// (see the comment on terminalEnvVars for why).\nvar tmuxEnvVars = map[string]bool{\n\t\"TMUX\":      true,\n\t\"TMUX_PANE\": true,\n}\n\n// terminalEnvArgs returns the docker -e entries forwarding the host's\n// terminal identity into the container: every terminalEnvVars entry that is\n// set and non-empty on the host, plus every WEZTERM_* variable (also only\n// when set to a non-empty value). TMUX/TMUX_PANE are skipped when tool is\n// OpenCode (see terminalEnvVars). No var set → an empty slice, keeping the\n// docker argv byte-identical to a session built without terminal forwarding.\nfunc terminalEnvArgs(tool string) []string {\n\tvar args []string\n\tfor _, key := range terminalEnvVars {\n\t\tif tmuxEnvVars[key] && tool == config.ToolOpenCode {\n\t\t\tcontinue\n\t\t}\n\t\tif v := os.Getenv(key); v != \"\" {\n\t\t\targs = append(args, \"-e\", key+\"=\"+v)\n\t\t}\n\t}\n\tfor _, kv := range os.Environ() {\n\t\tname, value, ok := strings.Cut(kv, \"=\")\n\t\tif ok && strings.HasPrefix(name, \"WEZTERM_\") && value != \"\" {\n\t\t\targs = append(args, \"-e\", kv)\n\t\t}\n\t}\n\treturn args\n}\n\n// warnTmuxClipboard detects the tmux clipboard-interception failure mode at\n// session start and warns on diag (stderr — the diagnostics stream): when the\n// session is interactive (a TUI to copy from — --print/mg-jdi runs capture\n// JSON output instead, so the check is skipped), the host is inside tmux\n// ($TMUX set) and tmux is on PATH, `tmux show-options -g set-clipboard` is\n// run; if it reports off, tmux will strip the OSC 52 clipboard writes the\n// in-container TUIs emit, so copying from the agent shows \"copied\" but never\n// reaches the host clipboard. Strictly read-only: no tmux state is mutated,\n// and any tmux failure (not installed, no server, an option query error)\n// silently skips the check — no launch path can break because of it.\nfunc warnTmuxClipboard(diag io.Writer, interactive, print bool) {\n\tif !interactive || print {\n\t\treturn\n\t}\n\tif os.Getenv(\"TMUX\") == \"\" {\n\t\treturn\n\t}\n\tif _, err := exec.LookPath(\"tmux\"); err != nil {\n\t\treturn\n\t}\n\tout, err := exec.Command(\"tmux\", \"show-options\", \"-g\", \"set-clipboard\").Output()\n\tif err != nil {\n\t\treturn\n\t}\n\tif strings.TrimSpace(string(out)) == \"set-clipboard off\" {\n\t\tfmt.Fprintln(diag, \"Warning: your tmux has set-clipboard off — it will swallow OSC 52 clipboard writes from the agent, so copying inside the session won't reach your host clipboard.\")\n\t\tfmt.Fprintln(diag, \"         Run 'tmux set -g set-clipboard on' to fix it (see the 'Clipboard / copying from agent sessions' docs section).\")\n\t}\n}\n\n// BuildDockerInvocation assembles the docker run argv, mirroring run.sh's\n// launch construction — every flag, mount, and env\n// var is load-bearing, so the argument order and exact strings are pinned by\n// the tests. Diagnostics (banner, warnings, shadowing lines) are written to\n// diag — always stderr, per the brief's note 1 (the script's fd-3 juggling\n// existed only to keep --print stdout clean; Go separates the streams\n// natively). interactive controls the -it flag (stdin is a terminal).\nfunc BuildDockerInvocation(opts Options, info ProfileInfo, root Root, interactive bool, diag io.Writer) (DockerInvocation, error) {\n\t// The .env warning run.sh printed when the file was missing.\n\tif envFile := config.EnvFile(); envFile != \"\" {\n\t\tif _, err := os.Stat(envFile); err != nil {\n\t\t\tfmt.Fprintf(diag, \"Warning: no .env found at %s\\n\", envFile)\n\t\t}\n\t}\n\n\t// The tmux OSC 52 clipboard-interception warning (TASK-2 of the clipboard\n\t// job): strictly read-only, failures silently skipped.\n\twarnTmuxClipboard(diag, interactive, opts.Print)\n\n\t// ── Git identity ─────────────────────────────────────────────────────────\n\t// Host GIT_AUTHOR_NAME/EMAIL env vars win; otherwise fall back to the\n\t// project's git config (local overrides global, matching git behavior).\n\tgitName := os.Getenv(\"GIT_AUTHOR_NAME\")\n\tif gitName == \"\" {\n\t\tgitName = git.ConfigUserName(root.ProjectRoot)\n\t}\n\tgitEmail := os.Getenv(\"GIT_AUTHOR_EMAIL\")\n\tif gitEmail == \"\" {\n\t\tgitEmail = git.ConfigEmail(root.ProjectRoot)\n\t}\n\tif gitName == \"\" || gitEmail == \"\" {\n\t\tfmt.Fprintln(diag, \"Warning: no git user.name/user.email configured for this project — container commits will fall back to a generic 'manigot' identity.\")\n\t}\n\n\t// ── Docs mount target + context file ────────────────────────────────────\n\tdocsMountTarget := \"/workspace/.claude\"\n\tif info.Tool == config.ToolOpenCode {\n\t\tdocsMountTarget = \"/workspace/.opencode\"\n\t}\n\n\tcontextFile := \"\"\n\tif fs.IsFile(filepath.Join(root.DocsDir, \"AGENTS.md\")) {\n\t\tcontextFile = filepath.Join(root.DocsDir, \"AGENTS.md\")\n\t} else if fs.IsFile(filepath.Join(root.DocsDir, \"CLAUDE.md\")) {\n\t\tcontextFile = filepath.Join(root.DocsDir, \"CLAUDE.md\")\n\t}\n\n\tvar contextMount []string\n\tcontextTarget := \"\"\n\tif contextFile != \"\" {\n\t\tif info.Tool == config.ToolOpenCode {\n\t\t\tcontextTarget = \"/workspace/AGENTS.md\"\n\t\t} else {\n\t\t\tcontextTarget = \"/workspace/.claude/CLAUDE.md\"\n\t\t}\n\t\tcontextMount = []string{\"-v\", contextFile + \":\" + contextTarget + \":ro\"}\n\t} else if root.DocsInitialized {\n\t\tfmt.Fprintf(diag, \"Warning: no docs/AGENTS.md found — the agent will start without project context.\\n\")\n\t} else {\n\t\tfmt.Fprintln(diag, \"Note: no docs/ directory — starting a plain session with no project context or job workflow.\")\n\t\tfmt.Fprintln(diag, \"      See 'Per-project setup' in the manigot README to enable them.\")\n\t}\n\n\tvar docsMount []string\n\tif fs.IsDir(root.DocsDir) {\n\t\tdocsMount = []string{\"-v\", root.DocsDir + \":\" + docsMountTarget + \":z\"}\n\t}\n\n\t// ── Project agents ─────────────────────────────────────────────────────\n\t// docs/agents/ rides along inside the docs mount above — fine for Claude\n\t// Code, whose subagent schema the list-form frontmatter already is, but\n\t// OpenCode hard-errors on the list-form tools: key (see convertAgents),\n\t// so custom project agents must be converted before the container sees\n\t// them. The converted copies land in a temp dir shadow-mounted over the\n\t// docs mount's agents/ subpath; the host's docs/agents/ source tree is\n\t// never modified. The temp dir is removed via the invocation's Cleanup\n\t// hook (see DockerInvocation.Run).\n\tvar agentMount []string\n\tvar agentCleanup func()\n\tif tmp, hasAgents, err := convertAgents(filepath.Join(root.DocsDir, \"agents\"), info.Tool); err != nil {\n\t\treturn DockerInvocation{}, fmt.Errorf(\"convert project agents: %w\", err)\n\t} else if hasAgents {\n\t\tagentMount = []string{\"-v\", tmp + \":/workspace/.opencode/agents:z\"}\n\t\tagentCleanup = func() { os.RemoveAll(tmp) }\n\t}\n\n\t// ── Global agents ─────────────────────────────────────────────────────\n\t// The global agents dir (<home>/agents/) is no longer baked into the\n\t// image — it lives on the host in the manigot checkout and is mounted\n\t// read-only into the container at the CLI's global agent location, so the\n\t// container can use the host's agents but cannot modify them. This keeps\n\t// the image purely isolation for workspaces and makes the same agents\n\t// available to `mg host` (see host.go). Project agents (docs/agents/,\n\t// above) still ride the docs mount and override global agents of the same\n\t// name, exactly as before.\n\t//\n\t// Claude Code reads global subagents from ~/.claude/agents/ and takes the\n\t// list-form frontmatter natively, so the host's files mount verbatim.\n\t// OpenCode reads global agents from ~/.config/opencode/agents/ and\n\t// hard-errors on the list-form tools: key, so the mounted files are\n\t// converted first (name:/tools: stripped, permission: passed through —\n\t// see convertAgents) into a temp dir shadow-mounted over the CLI's global\n\t// agents path, cleaned up via the invocation's Cleanup hook.\n\tvar globalAgentMount []string\n\tvar globalAgentCleanup func()\n\tif homeDir := home.Root(); homeDir != \"\" {\n\t\tglobalAgentsDir := filepath.Join(homeDir, \"agents\")\n\t\tif fs.IsDir(globalAgentsDir) {\n\t\t\tif info.Tool == config.ToolOpenCode {\n\t\t\t\tif tmp, hasAgents, err := convertAgents(globalAgentsDir, info.Tool); err != nil {\n\t\t\t\t\treturn DockerInvocation{}, fmt.Errorf(\"convert global agents: %w\", err)\n\t\t\t\t} else if hasAgents {\n\t\t\t\t\tglobalAgentMount = []string{\"-v\", tmp + \":/home/claude/.config/opencode/agents:ro\"}\n\t\t\t\t\tglobalAgentCleanup = func() { os.RemoveAll(tmp) }\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tglobalAgentMount = []string{\"-v\", globalAgentsDir + \":/home/claude/.claude/agents:ro\"}\n\t\t\t}\n\t\t}\n\t}\n\n\t// ── Global skills ─────────────────────────────────────────────────────\n\t// Skills follow the same global + project model as agents, applied to a\n\t// different unit: a skill is a directory (SKILL.md plus support files),\n\t// not a single file. Global skills live in the manigot checkout\n\t// (<home>/skills/) and are mounted read-only into the container at the\n\t// CLI's global skills location — ~/.claude/skills for Claude Code,\n\t// ~/.config/opencode/skills for OpenCode — where both CLIs load skills at\n\t// startup, independent of the active agent. That single global location is\n\t// exactly what makes a skill available to every agent and to invocations\n\t// that name no agent; project skills (docs/skills/, below) ride the docs\n\t// mount and override global skills of the same name.\n\t//\n\t// Unlike agents, skills need no frontmatter conversion — both CLIs read\n\t// SKILL.md and its frontmatter natively — so Claude Code gets the host's\n\t// skills dir verbatim (a read-only bind, like its agents mount). OpenCode\n\t// gets a staged copy instead (see stageGlobalSkills), mounted read-only\n\t// and cleaned up via the invocation's Cleanup hook, so the CLI's skills\n\t// dir is a fresh, disposable snapshot and the host's skills/ source tree\n\t// is never touched. Skipped cleanly when the checkout has no skills dir.\n\tvar globalSkillMount []string\n\tvar globalSkillCleanup func()\n\tif homeDir := home.Root(); homeDir != \"\" {\n\t\tglobalSkillsDir := filepath.Join(homeDir, \"skills\")\n\t\tif fs.IsDir(globalSkillsDir) {\n\t\t\tif info.Tool == config.ToolOpenCode {\n\t\t\t\tif tmp, hasSkills, err := stageGlobalSkills(globalSkillsDir); err != nil {\n\t\t\t\t\treturn DockerInvocation{}, fmt.Errorf(\"stage global skills: %w\", err)\n\t\t\t\t} else if hasSkills {\n\t\t\t\t\tglobalSkillMount = []string{\"-v\", tmp + \":/home/claude/.config/opencode/skills:ro\"}\n\t\t\t\t\tglobalSkillCleanup = func() { os.RemoveAll(tmp) }\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tglobalSkillMount = []string{\"-v\", globalSkillsDir + \":/home/claude/.claude/skills:ro\"}\n\t\t\t}\n\t\t}\n\t}\n\n\t// ── Global meta prompt ─────────────────────────────────────────────────\n\t// The meta prompt (<home>/prompts/meta.md) is a system-wide instruction file that\n\t// sits *above* agents and skills in the instruction hierarchy: it is\n\t// injected into every session, regardless of agent, project, or\n\t// interactive/--print mode. Each CLI loads it from its *global\n\t// instruction* location — ~/.claude/CLAUDE.md for Claude Code (the\n\t// user-global memory file, loaded before the project context at\n\t// /workspace/.claude/CLAUDE.md) and ~/.config/opencode/AGENTS.md for\n\t// OpenCode (the global rules file, loaded alongside the project context\n\t// mount) — so the project context still wins on conflict.\n\t//\n\t// Like skills, the file is plain markdown native to both CLIs, so no\n\t// conversion and no temp dir are needed (and thus no Cleanup hook): the\n\t// checkout file is mounted read-only at the per-tool target. A checkout\n\t// without prompts/meta.md yields no mount (it is optional, like skills).\n\tvar globalMetaMount []string\n\tif homeDir := home.Root(); homeDir != \"\" {\n\t\tmetaFile := filepath.Join(homeDir, \"prompts\", \"meta.md\")\n\t\tif fs.IsFile(metaFile) {\n\t\t\tif info.Tool == config.ToolOpenCode {\n\t\t\t\tglobalMetaMount = []string{\"-v\", metaFile + \":/home/claude/.config/opencode/AGENTS.md:ro\"}\n\t\t\t} else {\n\t\t\t\tglobalMetaMount = []string{\"-v\", metaFile + \":/home/claude/.claude/CLAUDE.md:ro\"}\n\t\t\t}\n\t\t}\n\t}\n\n\t// ── Project skills ────────────────────────────────────────────────────\n\t// Project skills (docs/skills/<name>/SKILL.md) need no staging or shadow\n\t// mount: the docs bind mount above maps the whole docs/ dir, so\n\t// docs/skills/ already lands at the project skills location inside the\n\t// container (/workspace/.claude/skills for Claude Code,\n\t// /workspace/.opencode/skills for OpenCode), and both CLIs natively prefer\n\t// a project skill over a global skill of the same name. Skills differ from\n\t// project agents here — agents needed a converted shadow mount over the\n\t// docs mount's agents/ subpath for OpenCode (it hard-errors on the\n\t// list-form tools: key), while skills need no conversion, so the plain\n\t// docs mount is sufficient.\n\n\t// ── Job prompt ──────────────────────────────────────────────────────────\n\tinitialPrompt := \"\"\n\tif root.Job != \"\" {\n\t\tcontainerJobDir := \"/workspace/docs/jobs/\" + root.Job\n\t\tinitialPrompt = \"Please work on the job at \" + containerJobDir + \" — start by reading brief.md\"\n\t\tif opts.Print {\n\t\t\t// --print sessions are non-interactive and unattended, so they get\n\t\t\t// the NEEDS-HUMAN-INPUT marker definition (interactive sessions\n\t\t\t// never see this — a human is there to answer questions).\n\t\t\tinitialPrompt += \"\\n\\nYou are running non-interactively and unattended — no human is watching this session or able to answer questions. If you cannot proceed without a human decision, stop immediately and print a line starting with exactly `NEEDS-HUMAN-INPUT:` followed by a one-sentence reason, and make no further changes.\"\n\t\t}\n\t} else if opts.Prompt != \"\" {\n\t\tinitialPrompt = opts.Prompt\n\t}\n\n\tvar agentFlag []string\n\tif opts.Agent != \"\" {\n\t\tagentFlag = []string{\"--agent\", opts.Agent}\n\t}\n\n\t// Claude takes the prompt positionally; OpenCode as --prompt.\n\tvar promptArgs []string\n\tif initialPrompt != \"\" {\n\t\tif info.Tool == config.ToolOpenCode {\n\t\t\tpromptArgs = []string{\"--prompt\", initialPrompt}\n\t\t} else {\n\t\t\tpromptArgs = []string{initialPrompt}\n\t\t}\n\t}\n\n\t// ── .env shadow mounts ──────────────────────────────────────────────────\n\tvar envMounts []string\n\tfor _, envFile := range findEnvFiles(root.ProjectRoot) {\n\t\trel := strings.TrimPrefix(envFile, root.ProjectRoot)\n\t\tcontainerPath := \"/workspace\" + rel\n\t\tfmt.Fprintf(diag, \"  Shadowing: %s → /dev/null inside container\\n\", envFile)\n\t\tenvMounts = append(envMounts, \"--mount\", \"type=bind,source=/dev/null,target=\"+containerPath+\",readonly\")\n\t}\n\tif len(envMounts) == 0 {\n\t\tfmt.Fprintln(diag, \"  Shadowed : none (no .env files found)\")\n\t}\n\n\t// ── Flavor quote ────────────────────────────────────────────────────────\n\t// Picked once per session from assets/quotes.json; skipped in --print mode\n\t// (the entrypoint wouldn't print it anyway). Missing/empty is not an error.\n\tquote := \"\"\n\tif !opts.Print {\n\t\tquote = pickQuote()\n\t}\n\n\t// ── Info banner ─────────────────────────────────────────────────────────\n\tfmt.Fprintln(diag, \"╔══════════════════════════════════════╗\")\n\tfmt.Fprintln(diag, \"║           manigot                   ║\")\n\tfmt.Fprintln(diag, \"╠══════════════════════════════════════╣\")\n\tfmt.Fprintln(diag, \"║  Entering safehouse (isolated session)...\")\n\tfmt.Fprintf(diag, \"║  Project : %s\\n\", filepath.Base(root.InvocationRoot))\n\tfmt.Fprintf(diag, \"║  Root    : %s\\n\", root.ProjectRoot)\n\tif root.DocsInitialized {\n\t\tfmt.Fprintf(diag, \"║  Docs    : %s\\n\", root.DocsDir)\n\t} else {\n\t\tfmt.Fprintln(diag, \"║  Docs    : (none — job workflow unavailable, running off the books)\")\n\t}\n\tif contextFile != \"\" {\n\t\tfmt.Fprintf(diag, \"║  Context : %s → %s\\n\", contextFile, contextTarget)\n\t}\n\tif info.Profile != \"\" {\n\t\tfmt.Fprintf(diag, \"║  Profile : %s\\n\", info.Profile)\n\t}\n\tif info.Tool != \"\" {\n\t\tfmt.Fprintf(diag, \"║  Tool    : %s\\n\", info.Tool)\n\t}\n\tif opts.Agent != \"\" {\n\t\tfmt.Fprintf(diag, \"║  Agent   : %s\\n\", opts.Agent)\n\t}\n\tif root.Job != \"\" {\n\t\tfmt.Fprintf(diag, \"║  Job     : %s\\n\", root.Job)\n\t}\n\tif opts.Print {\n\t\tfmt.Fprintln(diag, \"║  Print   : yes (non-interactive)\")\n\t}\n\tfmt.Fprintln(diag, \"╚══════════════════════════════════════╝\")\n\tfmt.Fprintln(diag, \"\")\n\n\t// ── Assemble the argv ───────────────────────────────────────────────────\n\tvar ttyFlags []string\n\tif interactive && !opts.Print {\n\t\tttyFlags = []string{\"-it\"}\n\t}\n\n\t// ── Git common-dir mount ────────────────────────────────────────────────\n\t// Committing agents need the gitdir writable (they commit their work);\n\t// non-committing agents get it read-only so they physically cannot touch\n\t// git metadata — the hard filesystem boundary behind the soft git shim —\n\t// with GIT_OPTIONAL_LOCKS=0 so read commands that would refresh the index\n\t// (git status, git diff) don't fail on the ro mount.\n\tvar gitDirMount []string\n\tvar gitDirEnv []string\n\tcommits := agentCommits(opts, root)\n\tif root.GitCommonDir != \"\" {\n\t\tmode := \"z\"\n\t\tif !commits {\n\t\t\tmode = \"ro\"\n\t\t\tgitDirEnv = []string{\"-e\", \"GIT_OPTIONAL_LOCKS=0\"}\n\t\t}\n\t\tgitDirMount = []string{\"-v\", root.GitCommonDir + \":\" + root.GitCommonDir + \":\" + mode}\n\t}\n\n\t// ── Gitdir overlay mounts (job-worktree sessions) ───────────────────────\n\t// The gitdir mount exposes the whole repository's git metadata; read-only\n\t// overlay mounts shadow the sensitive subpaths so an agent cannot corrupt\n\t// them. Each overlay skips a missing source — docker would otherwise\n\t// create an empty, root-owned directory at the target path.\n\tvar gitOverlayMounts []string\n\tif root.GitCommonDir != \"\" {\n\t\t// hooks/: an agent must not plant a hook that would later execute on\n\t\t// host-side git operations (mg done, mg delete) with host privileges.\n\t\tif hooksDir := filepath.Join(root.GitCommonDir, \"hooks\"); fs.IsDir(hooksDir) {\n\t\t\tgitOverlayMounts = append(gitOverlayMounts, \"-v\", hooksDir+\":\"+hooksDir+\":ro\")\n\t\t}\n\t\t// worktrees/: every OTHER job's worktree gitdir, so a misbehaving\n\t\t// agent cannot delete or corrupt another job's worktree registration.\n\t\t// The current job's own worktree gitdir is excluded by the helper —\n\t\t// it must stay writable for commits.\n\t\tif wtDirs, err := git.WorktreeGitDirs(root.ProjectRoot, root.ProjectRoot); err == nil {\n\t\t\tfor _, wtDir := range wtDirs {\n\t\t\t\tif !fs.IsDir(wtDir) {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tgitOverlayMounts = append(gitOverlayMounts, \"-v\", wtDir+\":\"+wtDir+\":ro\")\n\t\t\t}\n\t\t}\n\t}\n\n\targv := []string{\"run\"}\n\targv = append(argv, ttyFlags...)\n\targv = append(argv, \"--rm\")\n\targv = append(argv, \"--name\", fmt.Sprintf(\"manigot-%s-%d\", filepath.Base(root.ProjectRoot), os.Getpid()))\n\targv = append(argv, \"--user\", fmt.Sprintf(\"%d:%d\", os.Getuid(), os.Getgid()))\n\targv = append(argv, \"-v\", root.ProjectRoot+\":/workspace:z\")\n\targv = append(argv, gitDirMount...)\n\targv = append(argv, gitOverlayMounts...)\n\targv = append(argv, docsMount...)\n\targv = append(argv, agentMount...)\n\targv = append(argv, globalAgentMount...)\n\targv = append(argv, globalSkillMount...)\n\targv = append(argv, globalMetaMount...)\n\targv = append(argv, contextMount...)\n\targv = append(argv, envMounts...)\n\targv = append(argv, gitDirEnv...)\n\targv = append(argv, terminalEnvArgs(info.Tool)...)\n\targv = append(argv, info.KeyEnv...)\n\targv = append(argv, \"-e\", \"GIT_AUTHOR_NAME_CFG=\"+gitName)\n\targv = append(argv, \"-e\", \"GIT_AUTHOR_EMAIL_CFG=\"+gitEmail)\n\targv = append(argv, \"-e\", \"MANIGOT_TOOL=\"+info.Tool)\n\targv = append(argv, \"-e\", \"MANIGOT_PRINT=\"+strconv.FormatBool(opts.Print))\n\targv = append(argv, \"-e\", \"MANIGOT_QUOTE=\"+quote)\n\t// MANIGOT_AGENT_COMMITS tells container-side tooling which agent is\n\t// running: the `shot` render tool's wrapper guard refuses to run for\n\t// non-committing agents (the Claude Code gating layer — OpenCode enforces\n\t// the same via permission: blocks), mirroring the git shim's soft layer.\n\t// Defaults to true when unset, matching agentCommits' own default so a\n\t// missing marker never breaks a committing agent.\n\targv = append(argv, \"-e\", \"MANIGOT_AGENT_COMMITS=\"+strconv.FormatBool(commits))\n\targv = append(argv, \"--network=bridge\")\n\targv = append(argv, \"--memory=2g\")\n\targv = append(argv, \"--security-opt=no-new-privileges\")\n\targv = append(argv, dockerImageName)\n\targv = append(argv, agentFlag...)\n\targv = append(argv, promptArgs...)\n\targv = append(argv, opts.Pass...)\n\n\t// Combine the project-agent, global-agent and global-skill temp-dir\n\t// cleanups (whichever are non-nil) into a single hook run after the\n\t// container exits.\n\tvar cleanup func()\n\tif agentCleanup != nil || globalAgentCleanup != nil || globalSkillCleanup != nil {\n\t\tcleanup = func() {\n\t\t\tif agentCleanup != nil {\n\t\t\t\tagentCleanup()\n\t\t\t}\n\t\t\tif globalAgentCleanup != nil {\n\t\t\t\tglobalAgentCleanup()\n\t\t\t}\n\t\t\tif globalSkillCleanup != nil {\n\t\t\t\tglobalSkillCleanup()\n\t\t\t}\n\t\t}\n\t}\n\n\treturn DockerInvocation{Argv: append([]string{\"docker\"}, argv...), Cleanup: cleanup}, nil\n}\n\n// Run executes the assembled docker invocation, wiring stdin/stdout/stderr\n// through so Ctrl+C reaches the container, and returns docker's exit code.\n// The second return value reports whether docker was actually exec'd — false\n// only when the launch itself failed before docker ran (docker missing on\n// PATH, permission denied, ...). It is the \"did the container session\n// happen\" signal the job-worktree sweep keys off (see SweepJobWorktree): an\n// agent that never ran must not trigger a sweep commit. An ExitError — docker\n// ran and exited non-zero — still counts as ran=true: the session happened,\n// even when the agent's exit code was non-zero.\n// The invocation's Cleanup hook (if any) runs after the container exits.\nfunc (d DockerInvocation) Run(stdin *os.File, stdout, stderr io.Writer) (int, bool) {\n\tif d.Cleanup != nil {\n\t\tdefer d.Cleanup()\n\t}\n\tcmd := exec.Command(d.Argv[0], d.Argv[1:]...)\n\tcmd.Stdin = stdin\n\tcmd.Stdout = stdout\n\tcmd.Stderr = stderr\n\tif err := cmd.Run(); err != nil {\n\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n\t\t\treturn exitErr.ExitCode(), true\n\t\t}\n\t\tfmt.Fprintf(stderr, \"mg: %v\\n\", err)\n\t\treturn 1, false\n\t}\n\treturn 0, true\n}\n\n// findEnvFiles lists every .env / .env.* file under root (recursively),\n// excluding *.example and *.sample — the shadow-mount targets of run.sh.\nfunc findEnvFiles(root string) []string {\n\tvar files []string\n\tfilepath.WalkDir(root, func(path string, d os.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treturn nil\n\t\t}\n\t\tif d.IsDir() {\n\t\t\treturn nil\n\t\t}\n\t\tname := d.Name()\n\t\tif name != \".env\" && !strings.HasPrefix(name, \".env.\") {\n\t\t\treturn nil\n\t\t}\n\t\tif strings.HasSuffix(name, \".example\") || strings.HasSuffix(name, \".sample\") {\n\t\t\treturn nil\n\t\t}\n\t\tfiles = append(files, path)\n\t\treturn nil\n\t})\n\treturn files\n}\n\n// pickQuote parses assets/quotes.json (a JSON array of strings) and returns a\n// random entry, or \"\" when the file is missing or unparseable — missing/empty\n// just means no quote this session, not an error.\nfunc pickQuote() string {\n\thome := home.Root()\n\tif home == \"\" {\n\t\treturn \"\"\n\t}\n\tdata, err := os.ReadFile(filepath.Join(home, \"assets\", \"quotes.json\"))\n\tif err != nil {\n\t\treturn \"\"\n\t}\n\tvar quotes []string\n\tif err := json.Unmarshal(data, &quotes); err != nil {\n\t\treturn \"\"\n\t}\n\tif len(quotes) == 0 {\n\t\treturn \"\"\n\t}\n\treturn quotes[rand.IntN(len(quotes))]\n}\n","numLines":597,"startLine":1,"totalLines":597}}}
