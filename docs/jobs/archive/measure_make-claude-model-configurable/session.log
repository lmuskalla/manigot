{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018rmKvvxnFm33JnHBF4cAuf","type":"tool_result","content":"1\tpackage main\n2\t\n3\timport (\n4\t\t\"bufio\"\n5\t\t\"errors\"\n6\t\t\"flag\"\n7\t\t\"fmt\"\n8\t\t\"io\"\n9\t\t\"strings\"\n10\t\n11\t\t\"github.com/lmuskalla/manigot/internal/cli\"\n12\t\t\"github.com/lmuskalla/manigot/internal/config\"\n13\t\t\"github.com/lmuskalla/manigot/internal/ui\"\n14\t)\n15\t\n16\tconst profilesHelp = `mg profiles [name|add|rm]\n17\t\n18\tLists manigot's subscription profiles — the built-ins claude-pro, zai,\n19\topencode-go, opencode-zen, opencode-zen-free plus any you've added — showing\n20\twhich are configured and which is the default used by bare ` + \"`mg`\" + `. With a name,\n21\tsets that profile as the default (written as MANIGOT_PROFILE in manigot/.env);\n22\twith no name and an interactive terminal, picks the default via an interactive\n23\tpicker on a TTY (type to filter, enter to choose, esc/q cancel).\n24\tsets that profile as the default (written as MANIGOT_PROFILE in manigot/.env);\n25\twith no name and an interactive terminal, picks the default via an interactive\n26\tpicker on a TTY (type to filter, enter to choose, esc/q cancel).\n27\t\n28\t  mg profiles add [<id>]   interactively create a user-defined profile\n29\t                           (e.g. OpenCode Zen with a different model),\n30\t                           stored in config/profiles.json\n31\t  mg profiles rm <id>      remove a user-defined profile; removing the current\n32\t                           default falls back to claude-pro (built-ins cannot\n33\t                           be removed)\n34\t\n35\tThe default is shared: the TUI's settings screen reads and writes the same\n36\tMANIGOT_PROFILE, so TUI-launched sessions use whatever this command sets, and\n37\tvice versa.\n38\t`\n39\t\n40\t// runProfiles implements `mg profiles` — the port of scripts/profiles.sh with\n41\t// identical output wording. r is the interactive input (kept for signature\n42\t// uniformity with runAgents/runJobs even though the picker reads the terminal\n43\t// itself), stdout carries the listing/confirmations, stderr the errors. On a\n44\t// TTY the default-profile selection is the injected picker seam (pick) — the\n45\t// same one runJobs/runAgents use — so tests never start a real Bubble Tea\n46\t// program.\n47\tfunc runProfiles(args []string, r io.Reader, stdout, stderr io.Writer, tty bool, pick pickerRunFunc) int {\n48\t\tfs := flag.NewFlagSet(\"mg profiles\", flag.ContinueOnError)\n49\t\tfs.SetOutput(io.Discard)\n50\t\tfs.Usage = func() { fmt.Fprint(stdout, profilesHelp) }\n51\t\tif err := fs.Parse(args); err != nil {\n52\t\t\tif errors.Is(err, flag.ErrHelp) {\n53\t\t\t\treturn 0 // usage already printed to stdout\n54\t\t\t}\n55\t\t\t// An unknown flag — the script's parser had no flags at all, so any\n56\t\t\t// single argument was a candidate profile name.\n57\t\t\tfmt.Fprintln(stderr, flagParseError(err))\n58\t\t\tfmt.Fprintln(stderr, \"Usage: mg profiles [name]\")\n59\t\t\treturn 1\n60\t\t}\n61\t\n62\t\trest := fs.Args()\n63\t\tif len(rest) == 1 && rest[0] == \"help\" {\n64\t\t\t// The script's bare-word help alias.\n65\t\t\tfmt.Fprint(stdout, profilesHelp)\n66\t\t\treturn 0\n67\t\t}\n68\t\tif len(rest) == 0 {\n69\t\t\treturn profilesList(r, stdout, tty, pick)\n70\t\t}\n71\t\tswitch rest[0] {\n72\t\tcase \"add\":\n73\t\t\treturn profilesAdd(rest[1:], r, stdout, stderr, tty)\n74\t\tcase \"rm\", \"remove\":\n75\t\t\treturn profilesRm(rest[1:], stdout, stderr)\n76\t\t}\n77\t\tif len(rest) > 1 {\n78\t\t\tfmt.Fprintln(stderr, \"Error: too many arguments.\")\n79\t\t\tfmt.Fprintln(stderr, \"Usage: mg profiles [name|add|rm]\")\n80\t\t\treturn 1\n81\t\t}\n82\t\treturn profilesSet(rest[0], stdout, stderr)\n83\t}\n84\t\n85\t// profilesAdd implements `mg profiles add [<id>]` — the interactive\n86\t// user-defined-profile creation wizard. On a TTY it walks the fields of a\n87\t// profile (tool, credential key(s), model env/default for opencode) with the\n88\t// built-ins' values offered as defaults, then persists the profile to\n89\t// config/profiles.json via config.AddProfile. Off a TTY it refuses — profile\n90\t// creation is inherently interactive, matching `mg setup`'s stance.\n91\tfunc profilesAdd(args []string, r io.Reader, stdout, stderr io.Writer, tty bool) int {\n92\t\tif !tty {\n93\t\t\tfmt.Fprintln(stderr, \"mg profiles add: interactive profile creation needs a terminal.\")\n94\t\t\tfmt.Fprintln(stderr, \"Define the profile in config/profiles.json instead, or run inside a terminal.\")\n95\t\t\treturn 1\n96\t\t}\n97\t\tif len(args) > 1 {\n98\t\t\tfmt.Fprintln(stderr, \"Error: mg profiles add takes at most a single profile id.\")\n99\t\t\treturn 1\n100\t\t}\n101\t\n102\t\t// One buffered reader for the whole wizard — a fresh bufio.Reader per\n103\t\t// prompt would lose whatever the previous one buffered past its newline.\n104\t\tbr := bufio.NewReader(r)\n105\t\n106\t\tid := \"\"\n107\t\tif len(args) == 1 {\n108\t\t\tid = args[0]\n109\t\t}\n110\t\tif strings.TrimSpace(id) == \"\" {\n111\t\t\tv, err := promptLine(\"  Profile id: \", br, stdout)\n112\t\t\tif err != nil {\n113\t\t\t\tfmt.Fprintf(stderr, \"mg profiles add: %v\\n\", err)\n114\t\t\t\treturn 1\n115\t\t\t}\n116\t\t\tid = v\n117\t\t}\n118\t\tif strings.TrimSpace(id) == \"\" {\n119\t\t\tfmt.Fprintln(stderr, \"Error: a profile id is required.\")\n120\t\t\treturn 1\n121\t\t}\n122\t\tif _, ok := config.ProfileByID(id); ok {\n123\t\t\tfmt.Fprintf(stderr, \"Error: a profile with id %q already exists.\\n\", id)\n124\t\t\treturn 1\n125\t\t}\n126\t\n127\t\ttool, _ := cli.PromptValue(\"Tool (claude-code|opencode)\", \"\", config.ToolOpenCode, br, stdout)\n128\t\tif tool != config.ToolClaudeCode && tool != config.ToolOpenCode {\n129\t\t\tfmt.Fprintf(stderr, \"Error: tool must be 'claude-code' or 'opencode' (got '%s').\\n\", tool)\n130\t\t\treturn 1\n131\t\t}\n132\t\tlabel, _ := cli.PromptValue(\"Label\", \"\", id, br, stdout)\n133\t\tif label == \"\" {\n134\t\t\tlabel = id\n135\t\t}\n136\t\n137\t\tdefKey := \"OPENCODE_API_KEY\"\n138\t\tif tool == config.ToolClaudeCode {\n139\t\t\tdefKey = \"CLAUDE_CODE_OAUTH_TOKEN\"\n140\t\t}\n141\t\tauthKeysRaw, _ := cli.PromptValue(\"Credential key(s), comma-separated\", \"\", defKey, br, stdout)\n142\t\tvar authKeys []string\n143\t\tfor _, k := range strings.Split(authKeysRaw, \",\") {\n144\t\t\tif k = strings.TrimSpace(k); k != \"\" {\n145\t\t\t\tauthKeys = append(authKeys, k)\n146\t\t\t}\n147\t\t}\n148\t\tif len(authKeys) == 0 {\n149\t\t\tfmt.Fprintln(stderr, \"Error: at least one credential key is required.\")\n150\t\t\treturn 1\n151\t\t}\n152\t\tbilled, _ := cli.PromptValue(\"Billed via (description)\", \"\", authKeys[0], br, stdout)\n153\t\tif billed == \"\" {\n154\t\t\tbilled = authKeys[0]\n155\t\t}\n156\t\n157\t\tp := config.Profile{\n158\t\t\tID:       id,\n159\t\t\tLabel:    label,\n160\t\t\tTool:     tool,\n161\t\t\tAuth:     billed,\n162\t\t\tAuthKeys: authKeys,\n163\t\t}\n164\t\tif tool == config.ToolOpenCode {\n165\t\t\tmodelEnv, _ := cli.PromptValue(\"Model .env key\", \"\", \"OPENCODE_MODEL\", br, stdout)\n166\t\t\tmodelDefault, _ := cli.PromptValue(\"Default model\", \"\", \"\", br, stdout)\n167\t\t\tif strings.TrimSpace(modelDefault) == \"\" {\n168\t\t\t\tfmt.Fprintln(stderr, \"Error: an opencode profile needs a default model.\")\n169\t\t\t\treturn 1\n170\t\t\t}\n171\t\t\tp.ModelEnv = modelEnv\n172\t\t\tp.ModelDefault = modelDefault\n173\t\t}\n174\t\n175\t\tif err := config.AddProfile(p); err != nil {\n176\t\t\tfmt.Fprintf(stderr, \"mg profiles add: %v\\n\", err)\n177\t\t\treturn 1\n178\t\t}\n179\t\tfmt.Fprintf(stdout, \"Added profile '%s' (%s).\\n\", p.ID, p.Label)\n180\t\tfmt.Fprintf(stdout, \"Configure its credentials with: mg setup %s\\n\", p.ID)\n181\t\tfmt.Fprintf(stdout, \"Make it the default with: mg profiles %s\\n\", p.ID)\n182\t\treturn 0\n183\t}\n184\t\n185\t// profilesRm implements `mg profiles rm <id>` — removes a user-defined\n186\t// profile from config/profiles.json. Built-in profiles are not deletable\n187\t// (they are the defaults every user starts from), so rm only ever touches the\n188\t// user store. Removing the currently-set MANIGOT_PROFILE default falls back\n189\t// to claude-pro so bare `mg` keeps a valid default.\n190\tfunc profilesRm(args []string, stdout, stderr io.Writer) int {\n191\t\tif len(args) != 1 {\n192\t\t\tfmt.Fprintln(stderr, \"Usage: mg profiles rm <id>\")\n193\t\t\treturn 1\n194\t\t}\n195\t\tid := args[0]\n196\t\tif _, ok := config.ProfileByID(id); !ok {\n197\t\t\tfmt.Fprintf(stderr, \"Error: unknown profile '%s'.\\n\", id)\n198\t\t\treturn 1\n199\t\t}\n200\t\tif err := config.RemoveProfile(id); err != nil {\n201\t\t\t// Covers the built-in profiles (not present in the user store) and\n202\t\t\t// any corrupt-store/unresolvable-home write failure.\n203\t\t\tfmt.Fprintf(stderr, \"mg profiles rm: %v\\n\", err)\n204\t\t\treturn 1\n205\t\t}\n206\t\tif config.EnvValue(\"MANIGOT_PROFILE\") == id {\n207\t\t\tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", config.ProfileClaudePro); err != nil {\n208\t\t\t\tfmt.Fprintf(stderr, \"mg profiles rm: %v\\n\", err)\n209\t\t\t\treturn 1\n210\t\t\t}\n211\t\t\tfmt.Fprintf(stdout, \"Removed profile '%s'. The default fell back to %s.\\n\", id, config.ProfileClaudePro)\n212\t\t\treturn 0\n213\t\t}\n214\t\tfmt.Fprintf(stdout, \"Removed profile '%s'.\\n\", id)\n215\t\treturn 0\n216\t}\n217\t\n218\t// promptLine prints label and reads one trimmed line from br (no default\n219\t// shown) — for the add wizard's required, default-less fields like the profile\n220\t// id. On EOF it returns whatever was read, like cli's readLine.\n221\tfunc promptLine(label string, br *bufio.Reader, w io.Writer) (string, error) {\n222\t\tfmt.Fprint(w, label)\n223\t\tline, err := br.ReadString('\\n')\n224\t\tif err != nil && !errors.Is(err, io.EOF) {\n225\t\t\treturn \"\", err\n226\t\t}\n227\t\treturn strings.TrimSpace(line), nil\n228\t}\n229\t\n230\t// profilesSet writes MANIGOT_PROFILE=<name> into .env and prints the same\n231\t// confirmation + missing-credentials warning profiles.sh's confirm_set did.\n232\tfunc profilesSet(name string, stdout, stderr io.Writer) int {\n233\t\tif _, ok := config.ProfileByID(name); !ok {\n234\t\t\tfmt.Fprintf(stderr, \"Error: unknown profile '%s'.\\n\", name)\n235\t\t\tfmt.Fprintf(stderr, \"Valid profiles: %s\\n\", strings.Join(profileIDs(), \" \"))\n236\t\t\treturn 1\n237\t\t}\n238\t\tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", name); err != nil {\n239\t\t\tfmt.Fprintf(stderr, \"mg profiles: %v\\n\", err)\n240\t\t\treturn 1\n241\t\t}\n242\t\tconfirmSet(name, stdout)\n243\t\treturn 0\n244\t}\n245\t\n246\t// confirmSet prints the shared set confirmation, warning when the profile's\n247\t// auth key is not in .env yet.\n248\tfunc confirmSet(name string, w io.Writer) {\n249\t\tenvFile := config.EnvFile()\n250\t\tfmt.Fprintf(w, \"Default profile set to %s (MANIGOT_PROFILE in %s).\\n\", name, envFile)\n251\t\tfmt.Fprintln(w, \"Bare `mg` sessions and TUI-launched sessions share this default.\")\n252\t\n253\t\tif p, ok := config.ProfileByID(name); ok && len(p.AuthKeys) > 0 {\n254\t\t\tif key := p.AuthKeys[0]; config.EnvValue(key) == \"\" {\n255\t\t\t\tfmt.Fprintf(w, \"Warning: %s is not set in %s — run 'mg setup %s' first, or sessions will fail at launch.\\n\", key, envFile, name)\n256\t\t\t}\n257\t\t}\n258\t}\n259\t\n260\t// profilesList prints the profile table, then offers the interactive picker\n261\t// on a TTY — same listing, and the picker rows carry the same padded columns\n262\t// (byte-padded by padBytes, matching bash printf's byte-based padding: the\n263\t// label column contains a multi-byte ·, so rune-based fmt padding would\n264\t// misalign every row by one). The picker replaces the old numbered\n265\t// `[1-N, Enter keeps X, q quits]` loop; the cursor opens on the active\n266\t// default so a bare enter keeps it. Off a TTY the listing alone is the whole\n267\t// command (exit 0 — listing is `mg profiles`' documented purpose, unlike\n268\t// jobs/agents which refuse because selection is their only purpose).\n269\tfunc profilesList(r io.Reader, w io.Writer, tty bool, pick pickerRunFunc) int {\n270\t\tactive := config.EnvValue(\"MANIGOT_PROFILE\")\n271\t\tif active == \"\" {\n272\t\t\tactive = config.ProfileClaudePro\n273\t\t}\n274\t\tfmt.Fprintf(w, \"Active default: %s   (shared with the TUI; switch with: mg profiles <name>, or pick one below)\\n\", active)\n275\t\tfmt.Fprintln(w, \"\")\n276\t\tfmt.Fprintf(w, \"  %-13s %-28s %-10s %-26s %s\\n\", \"profile\", \"label\", \"tool\", \"model\", \"creds\")\n277\t\tfmt.Fprintf(w, \"  %-13s %-28s %-10s %-26s %s\\n\", \"---------\", \"----------------------------\", \"----------\", \"--------------------------\", \"-----\")\n278\t\tfor _, p := range config.Profiles() {\n279\t\t\tmark := \" \"\n280\t\t\tif p.ID == active {\n281\t\t\t\tmark = \"*\"\n282\t\t\t}\n283\t\t\trow := \"  \" + mark + padBytes(p.ID, 12) + \" \" + padBytes(p.Label, 28) + \" \" +\n284\t\t\t\tpadBytes(p.Tool, 10) + \" \" + padBytes(profileModel(p.ID), 26) + \" \" + creds(p.ID)\n285\t\t\tfmt.Fprintln(w, row)\n286\t\t}\n287\t\tfmt.Fprintln(w, \"\")\n288\t\tfmt.Fprintln(w, \"  * = default. Configure credentials with: mg setup [name]\")\n289\t\n290\t\tif !tty {\n291\t\t\treturn 0\n292\t\t}\n293\t\n294\t\tprofiles := config.Profiles()\n295\t\trows := make([]ui.PickerRow, 0, len(profiles))\n296\t\tstart := 0\n297\t\tfor i, p := range profiles {\n298\t\t\tif p.ID == active {\n299\t\t\t\tstart = i\n300\t\t\t}\n301\t\t\tmodel := profileModel(p.ID)\n302\t\t\tcred := creds(p.ID)\n303\t\t\tmark := \" \"\n304\t\t\tif p.ID == active {\n305\t\t\t\tmark = \"*\"\n306\t\t\t}\n307\t\t\trows = append(rows, ui.PickerRow{\n308\t\t\t\tID:        p.ID,\n309\t\t\t\tSearchKey: p.ID + \" \" + p.Label + \" \" + p.Tool + \" \" + model + \" \" + cred,\n310\t\t\t\t// The same padded columns as the plain listing (minus the leading\n311\t\t\t\t// indent, which the picker's own cursor/blank prefix provides),\n312\t\t\t\t// keeping the * active mark.\n313\t\t\t\tLabel: mark + padBytes(p.ID, 12) + \" \" + padBytes(p.Label, 28) + \" \" +\n314\t\t\t\t\tpadBytes(p.Tool, 10) + \" \" + padBytes(model, 26) + \" \" + cred,\n315\t\t\t})\n316\t\t}\n317\t\n318\t\tchosen, ok, err := pick(\"Select the default profile\", rows, start)\n319\t\tif err != nil {\n320\t\t\tfmt.Fprintf(w, \"mg profiles: %v\\n\", err)\n321\t\t\treturn 1\n322\t\t}\n323\t\tif !ok {\n324\t\t\t// Cancelled (esc/q) — a quiet exit 0, not the old \"quit\" error.\n325\t\t\treturn 0\n326\t\t}\n327\t\tif chosen == active {\n328\t\t\tfmt.Fprintf(w, \"Keeping %s.\\n\", active)\n329\t\t\treturn 0\n330\t\t}\n331\t\tfmt.Fprintln(w, \"\")\n332\t\tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", chosen); err != nil {\n333\t\t\tfmt.Fprintf(w, \"mg profiles: %v\\n\", err)\n334\t\t\treturn 1\n335\t\t}\n336\t\tconfirmSet(chosen, w)\n337\t\treturn 0\n338\t}\n339\t\n340\t// profileModel returns the model column for a profile: the effective .env /\n341\t// environment override when set, else the compiled-in default. Both come from\n342\t// the profile's definition (config.ProfileByID), so a user-defined profile\n343\t// renders its own model env/default.\n344\tfunc profileModel(id string) string {\n345\t\tp, ok := config.ProfileByID(id)\n346\t\tif !ok {\n347\t\t\treturn \"\"\n348\t\t}\n349\t\tif p.ModelEnv != \"\" {\n350\t\t\tif v := config.EnvValue(p.ModelEnv); v != \"\" {\n351\t\t\t\treturn v\n352\t\t\t}\n353\t\t}\n354\t\treturn p.ModelDefault\n355\t}\n356\t\n357\t// creds returns the creds column for a profile: \"✓ ready\" when every required\n358\t// key is set, else \"✗ missing <first missing key>\". The required keys are the\n359\t// profile's AuthKeys. Checks the effective value (process env + .env),\n360\t// matching the scripts' sourced-env ${!KEY:-} reads.\n361\tfunc creds(id string) string {\n362\t\tp, ok := config.ProfileByID(id)\n363\t\tif !ok {\n364\t\t\t// An unknown id has no keys, so the old loop ran zero times and\n365\t\t\t// reported \"ready\" — preserved for identical output.\n366\t\t\treturn \"✓ ready\"\n367\t\t}\n368\t\tfor _, k := range p.AuthKeys {\n369\t\t\tif config.EnvValue(k) == \"\" {\n370\t\t\t\treturn \"✗ missing \" + k\n371\t\t\t}\n372\t\t}\n373\t\treturn \"✓ ready\"\n374\t}\n375\t\n376\t// profileIDs returns the ordered profile ids for error messages.\n377\tfunc profileIDs() []string {\n378\t\tps := config.Profiles()\n379\t\tids := make([]string, len(ps))\n380\t\tfor i, p := range ps {\n381\t\t\tids[i] = p.ID\n382\t\t}\n383\t\treturn ids\n384\t}\n385\t\n386\t// padBytes returns s padded with trailing spaces to the given byte width —\n387\t// bash printf pads %s by byte length, and the profile table's label column\n388\t// contains a multi-byte ·, so fmt's rune-based width would misalign.\n389\tfunc padBytes(s string, width int) string {\n390\t\tif n := len(s); n >= width {\n391\t\t\treturn s\n392\t\t}\n393\t\treturn s + strings.Repeat(\" \", width-len(s))\n394\t}\n395\t"}]},"parent_tool_use_id":null,"session_id":"0ad41780-e2e7-4ebf-861d-9c61d66ababf","uuid":"5625f2a3-f3e4-4a80-888c-b38c33c9fdd7","timestamp":"2026-08-29T08:59:45.125Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/cmd/mg/profiles.go","content":"package main\n\nimport (\n\t\"bufio\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/cli\"\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/ui\"\n)\n\nconst profilesHelp = `mg profiles [name|add|rm]\n\nLists manigot's subscription profiles — the built-ins claude-pro, zai,\nopencode-go, opencode-zen, opencode-zen-free plus any you've added — showing\nwhich are configured and which is the default used by bare ` + \"`mg`\" + `. With a name,\nsets that profile as the default (written as MANIGOT_PROFILE in manigot/.env);\nwith no name and an interactive terminal, picks the default via an interactive\npicker on a TTY (type to filter, enter to choose, esc/q cancel).\nsets that profile as the default (written as MANIGOT_PROFILE in manigot/.env);\nwith no name and an interactive terminal, picks the default via an interactive\npicker on a TTY (type to filter, enter to choose, esc/q cancel).\n\n  mg profiles add [<id>]   interactively create a user-defined profile\n                           (e.g. OpenCode Zen with a different model),\n                           stored in config/profiles.json\n  mg profiles rm <id>      remove a user-defined profile; removing the current\n                           default falls back to claude-pro (built-ins cannot\n                           be removed)\n\nThe default is shared: the TUI's settings screen reads and writes the same\nMANIGOT_PROFILE, so TUI-launched sessions use whatever this command sets, and\nvice versa.\n`\n\n// runProfiles implements `mg profiles` — the port of scripts/profiles.sh with\n// identical output wording. r is the interactive input (kept for signature\n// uniformity with runAgents/runJobs even though the picker reads the terminal\n// itself), stdout carries the listing/confirmations, stderr the errors. On a\n// TTY the default-profile selection is the injected picker seam (pick) — the\n// same one runJobs/runAgents use — so tests never start a real Bubble Tea\n// program.\nfunc runProfiles(args []string, r io.Reader, stdout, stderr io.Writer, tty bool, pick pickerRunFunc) int {\n\tfs := flag.NewFlagSet(\"mg profiles\", flag.ContinueOnError)\n\tfs.SetOutput(io.Discard)\n\tfs.Usage = func() { fmt.Fprint(stdout, profilesHelp) }\n\tif err := fs.Parse(args); err != nil {\n\t\tif errors.Is(err, flag.ErrHelp) {\n\t\t\treturn 0 // usage already printed to stdout\n\t\t}\n\t\t// An unknown flag — the script's parser had no flags at all, so any\n\t\t// single argument was a candidate profile name.\n\t\tfmt.Fprintln(stderr, flagParseError(err))\n\t\tfmt.Fprintln(stderr, \"Usage: mg profiles [name]\")\n\t\treturn 1\n\t}\n\n\trest := fs.Args()\n\tif len(rest) == 1 && rest[0] == \"help\" {\n\t\t// The script's bare-word help alias.\n\t\tfmt.Fprint(stdout, profilesHelp)\n\t\treturn 0\n\t}\n\tif len(rest) == 0 {\n\t\treturn profilesList(r, stdout, tty, pick)\n\t}\n\tswitch rest[0] {\n\tcase \"add\":\n\t\treturn profilesAdd(rest[1:], r, stdout, stderr, tty)\n\tcase \"rm\", \"remove\":\n\t\treturn profilesRm(rest[1:], stdout, stderr)\n\t}\n\tif len(rest) > 1 {\n\t\tfmt.Fprintln(stderr, \"Error: too many arguments.\")\n\t\tfmt.Fprintln(stderr, \"Usage: mg profiles [name|add|rm]\")\n\t\treturn 1\n\t}\n\treturn profilesSet(rest[0], stdout, stderr)\n}\n\n// profilesAdd implements `mg profiles add [<id>]` — the interactive\n// user-defined-profile creation wizard. On a TTY it walks the fields of a\n// profile (tool, credential key(s), model env/default for opencode) with the\n// built-ins' values offered as defaults, then persists the profile to\n// config/profiles.json via config.AddProfile. Off a TTY it refuses — profile\n// creation is inherently interactive, matching `mg setup`'s stance.\nfunc profilesAdd(args []string, r io.Reader, stdout, stderr io.Writer, tty bool) int {\n\tif !tty {\n\t\tfmt.Fprintln(stderr, \"mg profiles add: interactive profile creation needs a terminal.\")\n\t\tfmt.Fprintln(stderr, \"Define the profile in config/profiles.json instead, or run inside a terminal.\")\n\t\treturn 1\n\t}\n\tif len(args) > 1 {\n\t\tfmt.Fprintln(stderr, \"Error: mg profiles add takes at most a single profile id.\")\n\t\treturn 1\n\t}\n\n\t// One buffered reader for the whole wizard — a fresh bufio.Reader per\n\t// prompt would lose whatever the previous one buffered past its newline.\n\tbr := bufio.NewReader(r)\n\n\tid := \"\"\n\tif len(args) == 1 {\n\t\tid = args[0]\n\t}\n\tif strings.TrimSpace(id) == \"\" {\n\t\tv, err := promptLine(\"  Profile id: \", br, stdout)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"mg profiles add: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tid = v\n\t}\n\tif strings.TrimSpace(id) == \"\" {\n\t\tfmt.Fprintln(stderr, \"Error: a profile id is required.\")\n\t\treturn 1\n\t}\n\tif _, ok := config.ProfileByID(id); ok {\n\t\tfmt.Fprintf(stderr, \"Error: a profile with id %q already exists.\\n\", id)\n\t\treturn 1\n\t}\n\n\ttool, _ := cli.PromptValue(\"Tool (claude-code|opencode)\", \"\", config.ToolOpenCode, br, stdout)\n\tif tool != config.ToolClaudeCode && tool != config.ToolOpenCode {\n\t\tfmt.Fprintf(stderr, \"Error: tool must be 'claude-code' or 'opencode' (got '%s').\\n\", tool)\n\t\treturn 1\n\t}\n\tlabel, _ := cli.PromptValue(\"Label\", \"\", id, br, stdout)\n\tif label == \"\" {\n\t\tlabel = id\n\t}\n\n\tdefKey := \"OPENCODE_API_KEY\"\n\tif tool == config.ToolClaudeCode {\n\t\tdefKey = \"CLAUDE_CODE_OAUTH_TOKEN\"\n\t}\n\tauthKeysRaw, _ := cli.PromptValue(\"Credential key(s), comma-separated\", \"\", defKey, br, stdout)\n\tvar authKeys []string\n\tfor _, k := range strings.Split(authKeysRaw, \",\") {\n\t\tif k = strings.TrimSpace(k); k != \"\" {\n\t\t\tauthKeys = append(authKeys, k)\n\t\t}\n\t}\n\tif len(authKeys) == 0 {\n\t\tfmt.Fprintln(stderr, \"Error: at least one credential key is required.\")\n\t\treturn 1\n\t}\n\tbilled, _ := cli.PromptValue(\"Billed via (description)\", \"\", authKeys[0], br, stdout)\n\tif billed == \"\" {\n\t\tbilled = authKeys[0]\n\t}\n\n\tp := config.Profile{\n\t\tID:       id,\n\t\tLabel:    label,\n\t\tTool:     tool,\n\t\tAuth:     billed,\n\t\tAuthKeys: authKeys,\n\t}\n\tif tool == config.ToolOpenCode {\n\t\tmodelEnv, _ := cli.PromptValue(\"Model .env key\", \"\", \"OPENCODE_MODEL\", br, stdout)\n\t\tmodelDefault, _ := cli.PromptValue(\"Default model\", \"\", \"\", br, stdout)\n\t\tif strings.TrimSpace(modelDefault) == \"\" {\n\t\t\tfmt.Fprintln(stderr, \"Error: an opencode profile needs a default model.\")\n\t\t\treturn 1\n\t\t}\n\t\tp.ModelEnv = modelEnv\n\t\tp.ModelDefault = modelDefault\n\t}\n\n\tif err := config.AddProfile(p); err != nil {\n\t\tfmt.Fprintf(stderr, \"mg profiles add: %v\\n\", err)\n\t\treturn 1\n\t}\n\tfmt.Fprintf(stdout, \"Added profile '%s' (%s).\\n\", p.ID, p.Label)\n\tfmt.Fprintf(stdout, \"Configure its credentials with: mg setup %s\\n\", p.ID)\n\tfmt.Fprintf(stdout, \"Make it the default with: mg profiles %s\\n\", p.ID)\n\treturn 0\n}\n\n// profilesRm implements `mg profiles rm <id>` — removes a user-defined\n// profile from config/profiles.json. Built-in profiles are not deletable\n// (they are the defaults every user starts from), so rm only ever touches the\n// user store. Removing the currently-set MANIGOT_PROFILE default falls back\n// to claude-pro so bare `mg` keeps a valid default.\nfunc profilesRm(args []string, stdout, stderr io.Writer) int {\n\tif len(args) != 1 {\n\t\tfmt.Fprintln(stderr, \"Usage: mg profiles rm <id>\")\n\t\treturn 1\n\t}\n\tid := args[0]\n\tif _, ok := config.ProfileByID(id); !ok {\n\t\tfmt.Fprintf(stderr, \"Error: unknown profile '%s'.\\n\", id)\n\t\treturn 1\n\t}\n\tif err := config.RemoveProfile(id); err != nil {\n\t\t// Covers the built-in profiles (not present in the user store) and\n\t\t// any corrupt-store/unresolvable-home write failure.\n\t\tfmt.Fprintf(stderr, \"mg profiles rm: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif config.EnvValue(\"MANIGOT_PROFILE\") == id {\n\t\tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", config.ProfileClaudePro); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"mg profiles rm: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintf(stdout, \"Removed profile '%s'. The default fell back to %s.\\n\", id, config.ProfileClaudePro)\n\t\treturn 0\n\t}\n\tfmt.Fprintf(stdout, \"Removed profile '%s'.\\n\", id)\n\treturn 0\n}\n\n// promptLine prints label and reads one trimmed line from br (no default\n// shown) — for the add wizard's required, default-less fields like the profile\n// id. On EOF it returns whatever was read, like cli's readLine.\nfunc promptLine(label string, br *bufio.Reader, w io.Writer) (string, error) {\n\tfmt.Fprint(w, label)\n\tline, err := br.ReadString('\\n')\n\tif err != nil && !errors.Is(err, io.EOF) {\n\t\treturn \"\", err\n\t}\n\treturn strings.TrimSpace(line), nil\n}\n\n// profilesSet writes MANIGOT_PROFILE=<name> into .env and prints the same\n// confirmation + missing-credentials warning profiles.sh's confirm_set did.\nfunc profilesSet(name string, stdout, stderr io.Writer) int {\n\tif _, ok := config.ProfileByID(name); !ok {\n\t\tfmt.Fprintf(stderr, \"Error: unknown profile '%s'.\\n\", name)\n\t\tfmt.Fprintf(stderr, \"Valid profiles: %s\\n\", strings.Join(profileIDs(), \" \"))\n\t\treturn 1\n\t}\n\tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", name); err != nil {\n\t\tfmt.Fprintf(stderr, \"mg profiles: %v\\n\", err)\n\t\treturn 1\n\t}\n\tconfirmSet(name, stdout)\n\treturn 0\n}\n\n// confirmSet prints the shared set confirmation, warning when the profile's\n// auth key is not in .env yet.\nfunc confirmSet(name string, w io.Writer) {\n\tenvFile := config.EnvFile()\n\tfmt.Fprintf(w, \"Default profile set to %s (MANIGOT_PROFILE in %s).\\n\", name, envFile)\n\tfmt.Fprintln(w, \"Bare `mg` sessions and TUI-launched sessions share this default.\")\n\n\tif p, ok := config.ProfileByID(name); ok && len(p.AuthKeys) > 0 {\n\t\tif key := p.AuthKeys[0]; config.EnvValue(key) == \"\" {\n\t\t\tfmt.Fprintf(w, \"Warning: %s is not set in %s — run 'mg setup %s' first, or sessions will fail at launch.\\n\", key, envFile, name)\n\t\t}\n\t}\n}\n\n// profilesList prints the profile table, then offers the interactive picker\n// on a TTY — same listing, and the picker rows carry the same padded columns\n// (byte-padded by padBytes, matching bash printf's byte-based padding: the\n// label column contains a multi-byte ·, so rune-based fmt padding would\n// misalign every row by one). The picker replaces the old numbered\n// `[1-N, Enter keeps X, q quits]` loop; the cursor opens on the active\n// default so a bare enter keeps it. Off a TTY the listing alone is the whole\n// command (exit 0 — listing is `mg profiles`' documented purpose, unlike\n// jobs/agents which refuse because selection is their only purpose).\nfunc profilesList(r io.Reader, w io.Writer, tty bool, pick pickerRunFunc) int {\n\tactive := config.EnvValue(\"MANIGOT_PROFILE\")\n\tif active == \"\" {\n\t\tactive = config.ProfileClaudePro\n\t}\n\tfmt.Fprintf(w, \"Active default: %s   (shared with the TUI; switch with: mg profiles <name>, or pick one below)\\n\", active)\n\tfmt.Fprintln(w, \"\")\n\tfmt.Fprintf(w, \"  %-13s %-28s %-10s %-26s %s\\n\", \"profile\", \"label\", \"tool\", \"model\", \"creds\")\n\tfmt.Fprintf(w, \"  %-13s %-28s %-10s %-26s %s\\n\", \"---------\", \"----------------------------\", \"----------\", \"--------------------------\", \"-----\")\n\tfor _, p := range config.Profiles() {\n\t\tmark := \" \"\n\t\tif p.ID == active {\n\t\t\tmark = \"*\"\n\t\t}\n\t\trow := \"  \" + mark + padBytes(p.ID, 12) + \" \" + padBytes(p.Label, 28) + \" \" +\n\t\t\tpadBytes(p.Tool, 10) + \" \" + padBytes(profileModel(p.ID), 26) + \" \" + creds(p.ID)\n\t\tfmt.Fprintln(w, row)\n\t}\n\tfmt.Fprintln(w, \"\")\n\tfmt.Fprintln(w, \"  * = default. Configure credentials with: mg setup [name]\")\n\n\tif !tty {\n\t\treturn 0\n\t}\n\n\tprofiles := config.Profiles()\n\trows := make([]ui.PickerRow, 0, len(profiles))\n\tstart := 0\n\tfor i, p := range profiles {\n\t\tif p.ID == active {\n\t\t\tstart = i\n\t\t}\n\t\tmodel := profileModel(p.ID)\n\t\tcred := creds(p.ID)\n\t\tmark := \" \"\n\t\tif p.ID == active {\n\t\t\tmark = \"*\"\n\t\t}\n\t\trows = append(rows, ui.PickerRow{\n\t\t\tID:        p.ID,\n\t\t\tSearchKey: p.ID + \" \" + p.Label + \" \" + p.Tool + \" \" + model + \" \" + cred,\n\t\t\t// The same padded columns as the plain listing (minus the leading\n\t\t\t// indent, which the picker's own cursor/blank prefix provides),\n\t\t\t// keeping the * active mark.\n\t\t\tLabel: mark + padBytes(p.ID, 12) + \" \" + padBytes(p.Label, 28) + \" \" +\n\t\t\t\tpadBytes(p.Tool, 10) + \" \" + padBytes(model, 26) + \" \" + cred,\n\t\t})\n\t}\n\n\tchosen, ok, err := pick(\"Select the default profile\", rows, start)\n\tif err != nil {\n\t\tfmt.Fprintf(w, \"mg profiles: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif !ok {\n\t\t// Cancelled (esc/q) — a quiet exit 0, not the old \"quit\" error.\n\t\treturn 0\n\t}\n\tif chosen == active {\n\t\tfmt.Fprintf(w, \"Keeping %s.\\n\", active)\n\t\treturn 0\n\t}\n\tfmt.Fprintln(w, \"\")\n\tif err := config.UpsertEnv(\"MANIGOT_PROFILE\", chosen); err != nil {\n\t\tfmt.Fprintf(w, \"mg profiles: %v\\n\", err)\n\t\treturn 1\n\t}\n\tconfirmSet(chosen, w)\n\treturn 0\n}\n\n// profileModel returns the model column for a profile: the effective .env /\n// environment override when set, else the compiled-in default. Both come from\n// the profile's definition (config.ProfileByID), so a user-defined profile\n// renders its own model env/default.\nfunc profileModel(id string) string {\n\tp, ok := config.ProfileByID(id)\n\tif !ok {\n\t\treturn \"\"\n\t}\n\tif p.ModelEnv != \"\" {\n\t\tif v := config.EnvValue(p.ModelEnv); v != \"\" {\n\t\t\treturn v\n\t\t}\n\t}\n\treturn p.ModelDefault\n}\n\n// creds returns the creds column for a profile: \"✓ ready\" when every required\n// key is set, else \"✗ missing <first missing key>\". The required keys are the\n// profile's AuthKeys. Checks the effective value (process env + .env),\n// matching the scripts' sourced-env ${!KEY:-} reads.\nfunc creds(id string) string {\n\tp, ok := config.ProfileByID(id)\n\tif !ok {\n\t\t// An unknown id has no keys, so the old loop ran zero times and\n\t\t// reported \"ready\" — preserved for identical output.\n\t\treturn \"✓ ready\"\n\t}\n\tfor _, k := range p.AuthKeys {\n\t\tif config.EnvValue(k) == \"\" {\n\t\t\treturn \"✗ missing \" + k\n\t\t}\n\t}\n\treturn \"✓ ready\"\n}\n\n// profileIDs returns the ordered profile ids for error messages.\nfunc profileIDs() []string {\n\tps := config.Profiles()\n\tids := make([]string, len(ps))\n\tfor i, p := range ps {\n\t\tids[i] = p.ID\n\t}\n\treturn ids\n}\n\n// padBytes returns s padded with trailing spaces to the given byte width —\n// bash printf pads %s by byte length, and the profile table's label column\n// contains a multi-byte ·, so fmt's rune-based width would misalign.\nfunc padBytes(s string, width int) string {\n\tif n := len(s); n >= width {\n\t\treturn s\n\t}\n\treturn s + strings.Repeat(\" \", width-len(s))\n}\n","numLines":395,"startLine":1,"totalLines":395}}}
