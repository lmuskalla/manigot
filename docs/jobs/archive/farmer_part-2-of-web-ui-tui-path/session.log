(the\n40: // health endpoint reports it; internal/serve cannot import package main).\n41: // token is the bearer token (\"\" = tokenless localhost mode). audit is the\n42: // request-log destination (mg serve passes stderr).\n43: func New(reg *Registry, version, token string, audit io.Writer) *Server {\n44: \tshutdownCtx, shutdownCancel := context.WithCancel(context.Background())\n45: \ts := &Server{\n46: \t\treg:            reg,\n47: \t\tversion:        version,\n48: \t\ttoken:          token,\n49: \t\taudit:          audit,\n50: \t\tlocks:          NewProjectLocks(),\n51: \t\tshutdownCtx:    shutdownCtx,\n52: \t\tshutdownCancel: shutdownCancel,\n53: \t}\n54: \tmux := http.NewServeMux()\n55: \ts.routes(mux)\n56: \tvar h http.Handler = mux\n57: \th = s.tokenMiddleware(h)\n58: \th = s.auditMiddleware(h)\n59: \ts.http = &http.Server{\n60: \t\tHandler:           h,\n61: \t\tReadHeaderTimeout: 10 * time.Second,\n62: \t}\n63: \treturn s\n64: }\n65: \n66: // routes registers every v1+v2 endpoint. The resolution helpers (see api.go)\n67: // are the only way any handler obtains a root, job or file path — the\n68: // zero-path-inputs choke point. Mutating routes and their ProjectLocks\n69: // boundary are documented at each handler; see locks.go for the summary.\n70: func (s *Server) routes(mux *http.ServeMux) {\n71: \t// Read-only (job one).\n72: \tmux.HandleFunc(\"GET /health\", s.handleHealth)\n73: \tmux.HandleFunc(\"GET /projects\", s.handleProjects)\n74: \tmux.HandleFunc(\"GET /projects/{project}/jobs\", s.handleProjectJobs)\n75: \tmux.HandleFunc(\"GET /projects/{project}/jobs/{job}/files/{file}\", s.handleJobFile)\n76: \tmux.HandleFunc(\"GET /projects/{project}/jobs/{job}/jdi\", s.handleJobJDI)\n77: \tmux.HandleFunc(\"GET /projects/{project}/jobs/{job}/diff\", s.handleJobDiff)\n78: \tmux.HandleFunc(\"GET /projects/{project}/agents\", s.handleProjectAgents)\n79: \n80: \t// Mutating (job two).\n81: \tmux.HandleFunc(\"POST /projects/{project}/jobs\", s.handleCreateJob)\n82: \tmux.HandleFunc(\"PUT /projects/{project}/jobs/{job}/files/brief\", s.handleEditBrief)\n83: \tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/agents/{agent}\", s.handleLaunchAgent)\n84: \tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/jdi\", s.handleLaunchJDI)\n85: \tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/done\", s.handleDoneJob)\n86: \tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/delete\", s.handleDeleteJob)\n87: \tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/push\", s.handlePushJob)\n88: \tmux.HandleFunc(\"POST /prune\", s.handlePrune)\n89: \tmux.HandleFunc(\"GET /projects/{project}/orphans\", s.handleProjectOrphans)\n90: \tmux.HandleFunc(\"POST /projects/{project}/orphans/{name}/delete\", s.handleDeleteOrphan)\n91: \n92: \t// Live run supervision (job two).\n93: \tmux.HandleFunc(\"GET /projects/{project}/jobs/{job}/session-log/stream\", s.handleSessionLogStream)\n94: }\n95: \n96: // Handler returns the fully-wrapped http.Handler — the httptest-able seam for\n97: // endpoint tests (httptest.NewServer(srv.Handler())).\n98: func (s *Server) Handler() http.Handler { return s.http.Handler }\n99: \n100: // Serve serves on ln until Shutdown or a fatal error — the httptest-able\n101: // seam for the serve loop (mg serve calls this on its bound listener; tests\n102: // hand over a bound 127.0.0.1:0 listener).\n103: func (s *Server) Serve(ln net.Listener) error { return s.http.Serve(ln) }\n104: \n105: // Shutdown gracefully drains in-flight requests and closes the listener. The\n106: // caller bounds the wait with the context (mg serve uses a bounded drain so a\n107: // hung request cannot wedge the exit). shutdownCtx is cancelled first, so any\n108: // long-lived streaming handler (see stream.go) unblocks its own poll loop and\n109: // returns immediately rather than forcing the drain to wait out its full\n110: // timeout.\n111: func (s *Server) Shutdown(ctx context.Context) error {\n112: \ts.shutdownCancel()\n113: \treturn s.http.Shutdown(ctx)\n114: }\n\n(End of file - total 114 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"context\"\n\t\"io\"\n\t\"net\"\n\t\"net/http\"\n\t\"time\"\n)\n\n// Server is the manigot listener daemon: a long-running HTTP server exposing\n// the control API (projects, jobs, job files, jdi status + logs, diff,\n// agents, health — read-only; plus job two's mutating endpoints and the\n// session-log SSE stream) over the registered projects. Mutating handlers\n// serialize per project via locks (see locks.go's own doc for which\n// operations take it and why).\ntype Server struct {\n\treg     *Registry\n\tversion string\n\ttoken   string","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/server.go","text":"package serve\n\nimport (\n\t\"context\"\n\t\"io\"\n\t\"net\"\n\t\"net/http\"\n\t\"time\"\n)\n\n// Server is the manigot listener daemon: a long-running HTTP server exposing\n// the control API (projects, jobs, job files, jdi status + logs, diff,\n// agents, health — read-only; plus job two's mutating endpoints and the\n// session-log SSE stream) over the registered projects. Mutating handlers\n// serialize per project via locks (see locks.go's own doc for which\n// operations take it and why).\ntype Server struct {\n\treg     *Registry\n\tversion string\n\ttoken   string\n\taudit   io.Writer\n\thttp    *http.Server\n\tlocks   *ProjectLocks\n\n\t// shutdownCtx/shutdownCancel let a long-lived handler (the session-log SSE\n\t// stream, see stream.go) notice a graceful Shutdown even though\n\t// http.Server.Shutdown itself only stops accepting new connections and\n\t// waits for in-flight handlers to return — it does not interrupt a\n\t// handler stuck in its own poll loop. Shutdown cancels shutdownCtx before\n\t// calling s.http.Shutdown, so every streaming handler selecting on it\n\t// unblocks and returns promptly instead of forcing the drain to wait out\n\t// its full timeout.\n\tshutdownCtx    context.Context\n\tshutdownCancel context.CancelFunc\n}\n\n// New builds the server: the route table, the middleware chain (auth, then\n// audit — audit outermost so it sees every request including 401s), and the\n// http.Server wrapper. version is the mg version passed in from main (the\n// health endpoint reports it; internal/serve cannot import package main).\n// token is the bearer token (\"\" = tokenless localhost mode). audit is the\n// request-log destination (mg serve passes stderr).\nfunc New(reg *Registry, version, token string, audit io.Writer) *Server {\n\tshutdownCtx, shutdownCancel := context.WithCancel(context.Background())\n\ts := &Server{\n\t\treg:            reg,\n\t\tversion:        version,\n\t\ttoken:          token,\n\t\taudit:          audit,\n\t\tlocks:          NewProjectLocks(),\n\t\tshutdownCtx:    shutdownCtx,\n\t\tshutdownCancel: shutdownCancel,\n\t}\n\tmux := http.NewServeMux()\n\ts.routes(mux)\n\tvar h http.Handler = mux\n\th = s.tokenMiddleware(h)\n\th = s.auditMiddleware(h)\n\ts.http = &http.Server{\n\t\tHandler:           h,\n\t\tReadHeaderTimeout: 10 * time.Second,\n\t}\n\treturn s\n}\n\n// routes registers every v1+v2 endpoint. The resolution helpers (see api.go)\n// are the only way any handler obtains a root, job or file path — the\n// zero-path-inputs choke point. Mutating routes and their ProjectLocks\n// boundary are documented at each handler; see locks.go for the summary.\nfunc (s *Server) routes(mux *http.ServeMux) {\n\t// Read-only (job one).\n\tmux.HandleFunc(\"GET /health\", s.handleHealth)\n\tmux.HandleFunc(\"GET /projects\", s.handleProjects)\n\tmux.HandleFunc(\"GET /projects/{project}/jobs\", s.handleProjectJobs)\n\tmux.HandleFunc(\"GET /projects/{project}/jobs/{job}/files/{file}\", s.handleJobFile)\n\tmux.HandleFunc(\"GET /projects/{project}/jobs/{job}/jdi\", s.handleJobJDI)\n\tmux.HandleFunc(\"GET /projects/{project}/jobs/{job}/diff\", s.handleJobDiff)\n\tmux.HandleFunc(\"GET /projects/{project}/agents\", s.handleProjectAgents)\n\n\t// Mutating (job two).\n\tmux.HandleFunc(\"POST /projects/{project}/jobs\", s.handleCreateJob)\n\tmux.HandleFunc(\"PUT /projects/{project}/jobs/{job}/files/brief\", s.handleEditBrief)\n\tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/agents/{agent}\", s.handleLaunchAgent)\n\tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/jdi\", s.handleLaunchJDI)\n\tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/done\", s.handleDoneJob)\n\tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/delete\", s.handleDeleteJob)\n\tmux.HandleFunc(\"POST /projects/{project}/jobs/{job}/push\", s.handlePushJob)\n\tmux.HandleFunc(\"POST /prune\", s.handlePrune)\n\tmux.HandleFunc(\"GET /projects/{project}/orphans\", s.handleProjectOrphans)\n\tmux.HandleFunc(\"POST /projects/{project}/orphans/{name}/delete\", s.handleDeleteOrphan)\n\n\t// Live run supervision (job two).\n\tmux.HandleFunc(\"GET /projects/{project}/jobs/{job}/session-log/stream\", s.handleSessionLogStream)\n}\n\n// Handler returns the fully-wrapped http.Handler — the httptest-able seam for\n// endpoint tests (httptest.NewServer(srv.Handler())).\nfunc (s *Server) Handler() http.Handler { return s.http.Handler }\n\n// Serve serves on ln until Shutdown or a fatal error — the httptest-able\n// seam for the serve loop (mg serve calls this on its bound listener; tests\n// hand over a bound 127.0.0.1:0 listener).\nfunc (s *Server) Serve(ln net.Listener) error { return s.http.Serve(ln) }\n\n// Shutdown gracefully drains in-flight requests and closes the listener. The\n// caller bounds the wait with the context (mg serve uses a bounded drain so a\n// hung request cannot wedge the exit). shutdownCtx is cancelled first, so any\n// long-lived streaming handler (see stream.go) unblocks its own poll loop and\n// returns immediately rather than forcing the drain to wait out its full\n// timeout.\nfunc (s *Server) Shutdown(ctx context.Context) error {\n\ts.shutdownCancel()\n\treturn s.http.Shutdown(ctx)\n}",