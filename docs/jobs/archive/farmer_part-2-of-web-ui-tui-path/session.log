{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TuUjiJziRQToJNXaQ7x8sz","type":"tool_result","content":"1\tpackage serve\n2\t\n3\timport (\n4\t\t\"sync\"\n5\t\t\"testing\"\n6\t\t\"time\"\n7\t)\n8\t\n9\t// TestProjectLocksMutualExclusionWithinKey: two Lock calls on the same\n10\t// project key serialize — the second blocks until the first releases — the\n11\t// property job two's mutating handlers depend on.\n12\tfunc TestProjectLocksMutualExclusionWithinKey(t *testing.T) {\n13\t\tlocks := NewProjectLocks()\n14\t\tconst key = \"/some/project\"\n15\t\n16\t\tentered := make(chan struct{})\n17\t\trelease := make(chan struct{})\n18\t\tdone := make(chan struct{})\n19\t\tgo func() {\n20\t\t\tlocks.Lock(key)\n21\t\t\tdefer locks.Unlock(key)\n22\t\t\tclose(entered) // inside the critical section\n23\t\t\t<-release      // hold the lock until the test tries the second Lock\n24\t\t\tclose(done)\n25\t\t}()\n26\t\t<-entered\n27\t\n28\t\tlocked := make(chan struct{})\n29\t\tgo func() {\n30\t\t\tlocks.Lock(key)\n31\t\t\tdefer locks.Unlock(key)\n32\t\t\tclose(locked)\n33\t\t}()\n34\t\n35\t\t// The second acquisition must block while the first holds the lock.\n36\t\tselect {\n37\t\tcase <-locked:\n38\t\t\tt.Fatal(\"second Lock on the same key returned while the first held it\")\n39\t\tcase <-time.After(50 * time.Millisecond):\n40\t\t\t// blocked as expected\n41\t\t}\n42\t\n43\t\tclose(release)\n44\t\t<-done\n45\t\n46\t\t// After the first releases, the second proceeds.\n47\t\tselect {\n48\t\tcase <-locked:\n49\t\tcase <-time.After(2 * time.Second):\n50\t\t\tt.Fatal(\"second Lock did not proceed after the first released\")\n51\t\t}\n52\t}\n53\t\n54\t// TestProjectLocksIndependenceAcrossKeys: locks on different project keys are\n55\t// independent — one project's critical section never blocks another's, the\n56\t// property that keeps a multi-project daemon from serializing everything.\n57\tfunc TestProjectLocksIndependenceAcrossKeys(t *testing.T) {\n58\t\tlocks := NewProjectLocks()\n59\t\n60\t\tenteredA := make(chan struct{})\n61\t\treleaseA := make(chan struct{})\n62\t\tdoneA := make(chan struct{})\n63\t\tgo func() {\n64\t\t\tlocks.Lock(\"projectA\")\n65\t\t\tdefer locks.Unlock(\"projectA\")\n66\t\t\tclose(enteredA)\n67\t\t\t<-releaseA\n68\t\t\tclose(doneA)\n69\t\t}()\n70\t\t<-enteredA\n71\t\n72\t\t// Locking a different key while projectA is held must succeed immediately.\n73\t\tgotB := make(chan struct{})\n74\t\tgo func() {\n75\t\t\tlocks.Lock(\"projectB\")\n76\t\t\tdefer locks.Unlock(\"projectB\")\n77\t\t\tclose(gotB)\n78\t\t}()\n79\t\tselect {\n80\t\tcase <-gotB:\n81\t\t\t// independent — B proceeded while A was held\n82\t\tcase <-time.After(2 * time.Second):\n83\t\t\tt.Fatal(\"Lock on a different key blocked behind projectA — locks must be per-project\")\n84\t\t}\n85\t\n86\t\tclose(releaseA)\n87\t\t<-doneA\n88\t}\n89\t\n90\t// TestProjectLocksAPIReentrantShape pins the API shape job two's handlers\n91\t// will call: New → Lock(root) → Unlock(root), repeatedly and across many\n92\t// keys, without panics or cross-talk — the \"Lock/Unlock serialize one key,\n93\t// ignore others\" contract in its simplest form.\n94\tfunc TestProjectLocksAPIReentrantShape(t *testing.T) {\n95\t\tlocks := NewProjectLocks()\n96\t\tkeys := []string{\"/a\", \"/b\", \"/a\", \"/c\", \"/b\", \"/a\"}\n97\t\tfor i := 0; i < 3; i++ {\n98\t\t\tfor _, k := range keys {\n99\t\t\t\tlocks.Lock(k)\n100\t\t\t\t// The lock is held for the critical section, then released.\n101\t\t\t\tlocks.Unlock(k)\n102\t\t\t}\n103\t\t}\n104\t\t// An Unlock without a Lock is a no-op, not a panic (a caller bug must not\n105\t\t// crash the daemon).\n106\t\tlocks.Unlock(\"/never-locked\")\n107\t}\n108\t\n109\t// TestProjectLocksContentionStress: many goroutines hammering the same key\n110\t// never overlap their critical sections (a statistical smoke test of the\n111\t// mutual exclusion under real concurrency).\n112\tfunc TestProjectLocksContentionStress(t *testing.T) {\n113\t\tlocks := NewProjectLocks()\n114\t\tconst key = \"/contended\"\n115\t\n116\t\tvar mu sync.Mutex\n117\t\tinCritical := 0\n118\t\tmaxConcurrent := 0\n119\t\n120\t\tvar wg sync.WaitGroup\n121\t\tfor i := 0; i < 20; i++ {\n122\t\t\twg.Add(1)\n123\t\t\tgo func() {\n124\t\t\t\tdefer wg.Done()\n125\t\t\t\tlocks.Lock(key)\n126\t\t\t\tdefer locks.Unlock(key)\n127\t\t\t\tmu.Lock()\n128\t\t\t\tinCritical++\n129\t\t\t\tif inCritical > maxConcurrent {\n130\t\t\t\t\tmaxConcurrent = inCritical\n131\t\t\t\t}\n132\t\t\t\tmu.Unlock()\n133\t\t\t\ttime.Sleep(time.Millisecond)\n134\t\t\t\tmu.Lock()\n135\t\t\t\tinCritical--\n136\t\t\t\tmu.Unlock()\n137\t\t\t}()\n138\t\t}\n139\t\twg.Wait()\n140\t\n141\t\tif maxConcurrent != 1 {\n142\t\t\tt.Errorf(\"max concurrent critical sections on one key = %d, want 1\", maxConcurrent)\n143\t\t}\n144\t\tif inCritical != 0 {\n145\t\t\tt.Errorf(\"inCritical after all goroutines = %d, want 0 (balanced Lock/Unlock)\", inCritical)\n146\t\t}\n147\t}\n148\t"}]},"parent_tool_use_id":null,"session_id":"ba948ea7-a157-4c42-8eb1-077540d9946d","uuid":"8bb9e358-53dd-4160-97ba-56aa34437b7f","timestamp":"2026-08-28T20:28:03.884Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/serve/locks_test.go","content":"package serve\n\nimport (\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\n// TestProjectLocksMutualExclusionWithinKey: two Lock calls on the same\n// project key serialize — the second blocks until the first releases — the\n// property job two's mutating handlers depend on.\nfunc TestProjectLocksMutualExclusionWithinKey(t *testing.T) {\n\tlocks := NewProjectLocks()\n\tconst key = \"/some/project\"\n\n\tentered := make(chan struct{})\n\trelease := make(chan struct{})\n\tdone := make(chan struct{})\n\tgo func() {\n\t\tlocks.Lock(key)\n\t\tdefer locks.Unlock(key)\n\t\tclose(entered) // inside the critical section\n\t\t<-release      // hold the lock until the test tries the second Lock\n\t\tclose(done)\n\t}()\n\t<-entered\n\n\tlocked := make(chan struct{})\n\tgo func() {\n\t\tlocks.Lock(key)\n\t\tdefer locks.Unlock(key)\n\t\tclose(locked)\n\t}()\n\n\t// The second acquisition must block while the first holds the lock.\n\tselect {\n\tcase <-locked:\n\t\tt.Fatal(\"second Lock on the same key returned while the first held it\")\n\tcase <-time.After(50 * time.Millisecond):\n\t\t// blocked as expected\n\t}\n\n\tclose(release)\n\t<-done\n\n\t// After the first releases, the second proceeds.\n\tselect {\n\tcase <-locked:\n\tcase <-time.After(2 * time.Second):\n\t\tt.Fatal(\"second Lock did not proceed after the first released\")\n\t}\n}\n\n// TestProjectLocksIndependenceAcrossKeys: locks on different project keys are\n// independent — one project's critical section never blocks another's, the\n// property that keeps a multi-project daemon from serializing everything.\nfunc TestProjectLocksIndependenceAcrossKeys(t *testing.T) {\n\tlocks := NewProjectLocks()\n\n\tenteredA := make(chan struct{})\n\treleaseA := make(chan struct{})\n\tdoneA := make(chan struct{})\n\tgo func() {\n\t\tlocks.Lock(\"projectA\")\n\t\tdefer locks.Unlock(\"projectA\")\n\t\tclose(enteredA)\n\t\t<-releaseA\n\t\tclose(doneA)\n\t}()\n\t<-enteredA\n\n\t// Locking a different key while projectA is held must succeed immediately.\n\tgotB := make(chan struct{})\n\tgo func() {\n\t\tlocks.Lock(\"projectB\")\n\t\tdefer locks.Unlock(\"projectB\")\n\t\tclose(gotB)\n\t}()\n\tselect {\n\tcase <-gotB:\n\t\t// independent — B proceeded while A was held\n\tcase <-time.After(2 * time.Second):\n\t\tt.Fatal(\"Lock on a different key blocked behind projectA — locks must be per-project\")\n\t}\n\n\tclose(releaseA)\n\t<-doneA\n}\n\n// TestProjectLocksAPIReentrantShape pins the API shape job two's handlers\n// will call: New → Lock(root) → Unlock(root), repeatedly and across many\n// keys, without panics or cross-talk — the \"Lock/Unlock serialize one key,\n// ignore others\" contract in its simplest form.\nfunc TestProjectLocksAPIReentrantShape(t *testing.T) {\n\tlocks := NewProjectLocks()\n\tkeys := []string{\"/a\", \"/b\", \"/a\", \"/c\", \"/b\", \"/a\"}\n\tfor i := 0; i < 3; i++ {\n\t\tfor _, k := range keys {\n\t\t\tlocks.Lock(k)\n\t\t\t// The lock is held for the critical section, then released.\n\t\t\tlocks.Unlock(k)\n\t\t}\n\t}\n\t// An Unlock without a Lock is a no-op, not a panic (a caller bug must not\n\t// crash the daemon).\n\tlocks.Unlock(\"/never-locked\")\n}\n\n// TestProjectLocksContentionStress: many goroutines hammering the same key\n// never overlap their critical sections (a statistical smoke test of the\n// mutual exclusion under real concurrency).\nfunc TestProjectLocksContentionStress(t *testing.T) {\n\tlocks := NewProjectLocks()\n\tconst key = \"/contended\"\n\n\tvar mu sync.Mutex\n\tinCritical := 0\n\tmaxConcurrent := 0\n\n\tvar wg sync.WaitGroup\n\tfor i := 0; i < 20; i++ {\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tlocks.Lock(key)\n\t\t\tdefer locks.Unlock(key)\n\t\t\tmu.Lock()\n\t\t\tinCritical++\n\t\t\tif inCritical > maxConcurrent {\n\t\t\t\tmaxConcurrent = inCritical\n\t\t\t}\n\t\t\tmu.Unlock()\n\t\t\ttime.Sleep(time.Millisecond)\n\t\t\tmu.Lock()\n\t\t\tinCritical--\n\t\t\tmu.Unlock()\n\t\t}()\n\t}\n\twg.Wait()\n\n\tif maxConcurrent != 1 {\n\t\tt.Errorf(\"max concurrent critical sections on one key = %d, want 1\", maxConcurrent)\n\t}\n\tif inCritical != 0 {\n\t\tt.Errorf(\"inCritical after all goroutines = %d, want 0 (balanced Lock/Unlock)\", inCritical)\n\t}\n}\n","numLines":148,"startLine":1,"totalLines":148}}}
