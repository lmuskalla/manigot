{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C7bo3Aa3StuHmP1XYLaGCF","type":"tool_result","content":"1\tpackage serve\n2\t\n3\timport (\n4\t\t\"net\"\n5\t\t\"net/http\"\n6\t\t\"os\"\n7\t\t\"os/exec\"\n8\t\t\"path/filepath\"\n9\t\t\"strings\"\n10\t\t\"testing\"\n11\t\n12\t\t\"github.com/lmuskalla/manigot/internal/job\"\n13\t)\n14\t\n15\t// entryFor turns a project root into a registry Entry named after the\n16\t// root's base name — the shared shape most tests use, since URL construction\n17\t// throughout this package already spells out filepath.Base(root) (a holdover\n18\t// from when Project matched by base name). Resolution is strictly by\n19\t// configured Name now — see TestRegistryProjectNameOnlyResolution in\n20\t// registry_test.go for the pin that a differently-named entry does NOT\n21\t// resolve by its directory's base name.\n22\tfunc entryFor(root string) Entry {\n23\t\treturn Entry{Name: filepath.Base(root), Path: filepath.Clean(root)}\n24\t}\n25\t\n26\t// netListen is net.Listen's tcp form, split out so tests read cleanly.\n27\tfunc netListen(addr string) (net.Listener, error) {\n28\t\treturn net.Listen(\"tcp\", addr)\n29\t}\n30\t\n31\t// httpGet is http.Get, split out for the same reason.\n32\tfunc httpGet(url string) (*http.Response, error) {\n33\t\treturn http.Get(url)\n34\t}\n35\t\n36\t// writeJDIStatusForTest writes a stopped:finished reviewer sidecar for the\n37\t// named job under root, so job-reader tests have a live status to read.\n38\tfunc writeJDIStatusForTest(t *testing.T, root, jobName string) error {\n39\t\tt.Helper()\n40\t\treturn job.WriteJDIStatus(root, jobName, job.JDIStoppedFinished, \"reviewer\")\n41\t}\n42\t\n43\t// pathWithRealGitOnly returns a PATH value containing the real git binary and\n44\t// nothing else, so tests that need `git init` (to build throwaway repos) are\n45\t// not blocked by the manigot session git shim, which may sit on PATH and\n46\t// refuses git init. Mirrors cmd/mg/session_test.go's same-named helper.\n47\tfunc pathWithRealGitOnly(t *testing.T) string {\n48\t\tt.Helper()\n49\t\tbinDir := t.TempDir()\n50\t\trealGit := \"/usr/bin/git\"\n51\t\tif _, err := os.Stat(realGit); err != nil {\n52\t\t\tvar lerr error\n53\t\t\trealGit, lerr = exec.LookPath(\"git\")\n54\t\t\tif lerr != nil {\n55\t\t\t\tt.Fatalf(\"could not locate a real git: %v\", lerr)\n56\t\t\t}\n57\t\t}\n58\t\tif err := os.Symlink(realGit, filepath.Join(binDir, \"git\")); err != nil {\n59\t\t\tt.Fatal(err)\n60\t\t}\n61\t\treturn binDir\n62\t}\n63\t\n64\t// runGitT runs git -C dir args, failing the test on any error — the throwaway\n65\t// repo builder for tests that exercise real git (the diff endpoint).\n66\tfunc runGitT(t *testing.T, dir string, args ...string) {\n67\t\tt.Helper()\n68\t\tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n69\t\tif out, err := cmd.CombinedOutput(); err != nil {\n70\t\t\tt.Fatalf(\"git %s in %s: %v\\n%s\", strings.Join(args, \" \"), dir, err, out)\n71\t\t}\n72\t}\n73\t\n74\t// initGitRepo creates a fresh git repo at a temp dir (default branch main, a\n75\t// deterministic identity, gpg signing off) with one initial commit, returning\n76\t// the dir. The caller must set PATH to pathWithRealGitOnly first.\n77\tfunc initGitRepo(t *testing.T) string {\n78\t\tt.Helper()\n79\t\tdir := t.TempDir()\n80\t\trunGitT(t, dir, \"init\", \"-q\", \"-b\", \"main\")\n81\t\trunGitT(t, dir, \"config\", \"user.email\", \"t@example.com\")\n82\t\trunGitT(t, dir, \"config\", \"user.name\", \"Test\")\n83\t\trunGitT(t, dir, \"config\", \"commit.gpgsign\", \"false\")\n84\t\tif err := os.WriteFile(filepath.Join(dir, \"README\"), []byte(\"init\\n\"), 0o644); err != nil {\n85\t\t\tt.Fatal(err)\n86\t\t}\n87\t\trunGitT(t, dir, \"add\", \"README\")\n88\t\trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"init\")\n89\t\treturn dir\n90\t}\n91\t\n92\t// fakeCheckout creates a minimal manigot checkout (scripts/entrypoint.sh, the\n93\t// file home.looksLikeCheckout keys off, plus agents/ with the named agent\n94\t// files) and points $MANIGOT_HOME at it. Returns the checkout dir.\n95\tfunc fakeCheckout(t *testing.T, agents map[string]string) string {\n96\t\tt.Helper()\n97\t\tdir := t.TempDir()\n98\t\tif err := os.MkdirAll(filepath.Join(dir, \"scripts\"), 0o755); err != nil {\n99\t\t\tt.Fatal(err)\n100\t\t}\n101\t\tif err := os.WriteFile(filepath.Join(dir, \"scripts\", \"entrypoint.sh\"), []byte(\"#!/bin/sh\\n\"), 0o755); err != nil {\n102\t\t\tt.Fatal(err)\n103\t\t}\n104\t\tif len(agents) > 0 {\n105\t\t\tif err := os.MkdirAll(filepath.Join(dir, \"agents\"), 0o755); err != nil {\n106\t\t\t\tt.Fatal(err)\n107\t\t\t}\n108\t\t\tfor name, body := range agents {\n109\t\t\t\tif err := os.WriteFile(filepath.Join(dir, \"agents\", name+\".md\"), []byte(body), 0o644); err != nil {\n110\t\t\t\t\tt.Fatal(err)\n111\t\t\t\t}\n112\t\t\t}\n113\t\t}\n114\t\tt.Setenv(\"MANIGOT_HOME\", dir)\n115\t\treturn dir\n116\t}\n117\t"}]},"parent_tool_use_id":null,"session_id":"5af88135-9c7b-453b-b119-c245e62a60fb","uuid":"a9c934d7-2352-48b1-bd32-0dcd8480e36e","timestamp":"2026-08-28T20:17:35.079Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/serve/testutil_test.go","content":"package serve\n\nimport (\n\t\"net\"\n\t\"net/http\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// entryFor turns a project root into a registry Entry named after the\n// root's base name — the shared shape most tests use, since URL construction\n// throughout this package already spells out filepath.Base(root) (a holdover\n// from when Project matched by base name). Resolution is strictly by\n// configured Name now — see TestRegistryProjectNameOnlyResolution in\n// registry_test.go for the pin that a differently-named entry does NOT\n// resolve by its directory's base name.\nfunc entryFor(root string) Entry {\n\treturn Entry{Name: filepath.Base(root), Path: filepath.Clean(root)}\n}\n\n// netListen is net.Listen's tcp form, split out so tests read cleanly.\nfunc netListen(addr string) (net.Listener, error) {\n\treturn net.Listen(\"tcp\", addr)\n}\n\n// httpGet is http.Get, split out for the same reason.\nfunc httpGet(url string) (*http.Response, error) {\n\treturn http.Get(url)\n}\n\n// writeJDIStatusForTest writes a stopped:finished reviewer sidecar for the\n// named job under root, so job-reader tests have a live status to read.\nfunc writeJDIStatusForTest(t *testing.T, root, jobName string) error {\n\tt.Helper()\n\treturn job.WriteJDIStatus(root, jobName, job.JDIStoppedFinished, \"reviewer\")\n}\n\n// pathWithRealGitOnly returns a PATH value containing the real git binary and\n// nothing else, so tests that need `git init` (to build throwaway repos) are\n// not blocked by the manigot session git shim, which may sit on PATH and\n// refuses git init. Mirrors cmd/mg/session_test.go's same-named helper.\nfunc pathWithRealGitOnly(t *testing.T) string {\n\tt.Helper()\n\tbinDir := t.TempDir()\n\trealGit := \"/usr/bin/git\"\n\tif _, err := os.Stat(realGit); err != nil {\n\t\tvar lerr error\n\t\trealGit, lerr = exec.LookPath(\"git\")\n\t\tif lerr != nil {\n\t\t\tt.Fatalf(\"could not locate a real git: %v\", lerr)\n\t\t}\n\t}\n\tif err := os.Symlink(realGit, filepath.Join(binDir, \"git\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn binDir\n}\n\n// runGitT runs git -C dir args, failing the test on any error — the throwaway\n// repo builder for tests that exercise real git (the diff endpoint).\nfunc runGitT(t *testing.T, dir string, args ...string) {\n\tt.Helper()\n\tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"git %s in %s: %v\\n%s\", strings.Join(args, \" \"), dir, err, out)\n\t}\n}\n\n// initGitRepo creates a fresh git repo at a temp dir (default branch main, a\n// deterministic identity, gpg signing off) with one initial commit, returning\n// the dir. The caller must set PATH to pathWithRealGitOnly first.\nfunc initGitRepo(t *testing.T) string {\n\tt.Helper()\n\tdir := t.TempDir()\n\trunGitT(t, dir, \"init\", \"-q\", \"-b\", \"main\")\n\trunGitT(t, dir, \"config\", \"user.email\", \"t@example.com\")\n\trunGitT(t, dir, \"config\", \"user.name\", \"Test\")\n\trunGitT(t, dir, \"config\", \"commit.gpgsign\", \"false\")\n\tif err := os.WriteFile(filepath.Join(dir, \"README\"), []byte(\"init\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGitT(t, dir, \"add\", \"README\")\n\trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"init\")\n\treturn dir\n}\n\n// fakeCheckout creates a minimal manigot checkout (scripts/entrypoint.sh, the\n// file home.looksLikeCheckout keys off, plus agents/ with the named agent\n// files) and points $MANIGOT_HOME at it. Returns the checkout dir.\nfunc fakeCheckout(t *testing.T, agents map[string]string) string {\n\tt.Helper()\n\tdir := t.TempDir()\n\tif err := os.MkdirAll(filepath.Join(dir, \"scripts\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(dir, \"scripts\", \"entrypoint.sh\"), []byte(\"#!/bin/sh\\n\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(agents) > 0 {\n\t\tif err := os.MkdirAll(filepath.Join(dir, \"agents\"), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tfor name, body := range agents {\n\t\t\tif err := os.WriteFile(filepath.Join(dir, \"agents\", name+\".md\"), []byte(body), 0o644); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t}\n\t}\n\tt.Setenv(\"MANIGOT_HOME\", dir)\n\treturn dir\n}\n","numLines":117,"startLine":1,"totalLines":117}}}
