gent, global-agent and global-skill temp-dir\n504: \t// cleanups (whichever are non-nil) into a single hook run after the\n505: \t// container exits.\n506: \tvar cleanup func()\n507: \tif agentCleanup != nil || globalAgentCleanup != nil || globalSkillCleanup != nil {\n508: \t\tcleanup = func() {\n509: \t\t\tif agentCleanup != nil {\n510: \t\t\t\tagentCleanup()\n511: \t\t\t}\n512: \t\t\tif globalAgentCleanup != nil {\n513: \t\t\t\tglobalAgentCleanup()\n514: \t\t\t}\n515: \t\t\tif globalSkillCleanup != nil {\n516: \t\t\t\tglobalSkillCleanup()\n517: \t\t\t}\n518: \t\t}\n519: \t}\n520: \n521: \treturn DockerInvocation{Argv: append([]string{\"docker\"}, argv...), Cleanup: cleanup}, nil\n522: }\n523: \n524: // Run executes the assembled docker invocation, wiring stdin/stdout/stderr\n525: // through so Ctrl+C reaches the container, and returns docker's exit code.\n526: // The second return value reports whether docker was actually exec'd — false\n527: // only when the launch itself failed before docker ran (docker missing on\n528: // PATH, permission denied, ...). It is the \"did the container session\n529: // happen\" signal the job-worktree sweep keys off (see SweepJobWorktree): an\n530: // agent that never ran must not trigger a sweep commit. An ExitError — docker\n531: // ran and exited non-zero — still counts as ran=true: the session happened,\n532: // even when the agent's exit code was non-zero.\n533: // The invocation's Cleanup hook (if any) runs after the container exits.\n534: func (d DockerInvocation) Run(stdin *os.File, stdout, stderr io.Writer) (int, bool) {\n535: \tif d.Cleanup != nil {\n536: \t\tdefer d.Cleanup()\n537: \t}\n538: \tcmd := exec.Command(d.Argv[0], d.Argv[1:]...)\n539: \tcmd.Stdin = stdin\n540: \tcmd.Stdout = stdout\n541: \tcmd.Stderr = stderr\n542: \tif err := cmd.Run(); err != nil {\n543: \t\tif exitErr, ok := err.(*exec.ExitError); ok {\n544: \t\t\treturn exitErr.ExitCode(), true\n545: \t\t}\n546: \t\tfmt.Fprintf(stderr, \"mg: %v\\n\", err)\n547: \t\treturn 1, false\n548: \t}\n549: \treturn 0, true\n550: }\n551: \n552: // findEnvFiles lists every .env / .env.* file under root (recursively),\n553: // excluding *.example and *.sample — the shadow-mount targets of run.sh.\n554: func findEnvFiles(root string) []string {\n555: \tvar files []string\n556: \tfilepath.WalkDir(root, func(path string, d os.DirEntry, err error) error {\n557: \t\tif err != nil {\n558: \t\t\treturn nil\n559: \t\t}\n\n(Showing lines 440-559 of 596. Use offset=560 to continue.)\n</content>","metadata":{"preview":"\t// The gitdir mount exposes the whole repository's git metadata; read-only\n\t// overlay mounts shadow the sensitive subpaths so an agent cannot corrupt\n\t// them. Each overlay skips a missing source — docker would otherwise\n\t// create an empty, root-owned directory at the target path.\n\tvar gitOverlayMounts []string\n\tif root.GitCommonDir != \"\" {\n\t\t// hooks/: an agent must not plant a hook that would later execute on\n\t\t// host-side git operations (mg done, mg delete) with host privileges.\n\t\tif hooksDir := filepath.Join(root.GitCommonDir, \"hooks\"); fs.IsDir(hooksDir) {\n\t\t\tgitOverlayMounts = append(gitOverlayMounts, \"-v\", hooksDir+\":\"+hooksDir+\":ro\")\n\t\t}\n\t\t// worktrees/: every OTHER job's worktree gitdir, so a misbehaving\n\t\t// agent cannot delete or corrupt another job's worktree registration.\n\t\t// The current job's own worktree gitdir is excluded by the helper —\n\t\t// it must stay writable for commits.\n\t\tif wtDirs, err := git.WorktreeGitDirs(root.ProjectRoot, root.ProjectRoot); err == nil {\n\t\t\tfor _, wtDir := range wtDirs {\n\t\t\t\tif !fs.IsDir(wtDir) {\n\t\t\t\t\tcontinue\n\t\t\t\t}","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/session/docker.go","text":"\t// The gitdir mount exposes the whole repository's git metadata; read-only\n\t// overlay mounts shadow the sensitive subpaths so an agent cannot corrupt\n\t// them. Each overlay ski