{"type":"tool_use","timestamp":1787952953560,"sessionID":"ses_fb5b402d5ffesBMXb1jVe3Cozl","part":{"type":"tool","tool":"read","callID":"call_6537185736bd4351b53be992","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/session/oneshot_test.go"},"output":"<path>/workspace/src/internal/session/oneshot_test.go</path>\n<type>file</type>\n<content>\n1: package session\n2: \n3: import (\n4: \t\"errors\"\n5: \t\"io\"\n6: \t\"os\"\n7: \t\"path/filepath\"\n8: \t\"strings\"\n9: \t\"testing\"\n10: \n11: \t\"github.com/lmuskalla/manigot/internal/job\"\n12: )\n13: \n14: // fakeOneShotRunner implements AgentRunner without spawning any real\n15: // process — mirroring cmd/mg/jdi_test.go's own fakeRunner — so RunOneShot's\n16: // session-log wiring can be tested independent of docker/session-launcher\n17: // plumbing (covered separately by CommandAgentRunner's own tests below).\n18: type fakeOneShotRunner struct {\n19: \tout []byte\n20: \terr error\n21: \t// calls records every (agent, j.Name) pair Run was invoked with.\n22: \tcalls []string\n23: }\n24: \n25: func (f *fakeOneShotRunner) Run(agent string, j job.Job, live io.Writer) ([]byte, error) {\n26: \tf.calls = append(f.calls, agent+\"/\"+j.Name)\n27: \tif len(f.out) > 0 && live != nil {\n28: \t\tlive.Write(f.out)\n29: \t}\n30: \treturn f.out, f.err\n31: }\n32: \n33: // testJob builds a minimal job.Job whose Dir is a fresh temp directory —\n34: // enough for RunOneShot's session.log path (filepath.Join(j.Dir,\n35: // \"session.log\")).\n36: func testJob(t *testing.T) job.Job {\n37: \tt.Helper()\n38: \tdir := t.TempDir()\n39: \treturn job.Job{Name: \"aaaa01_test-job\", Dir: dir}\n40: }\n41: \n42: func TestRunOneShotOpensAttemptOneSectionAndStreamsOutput(t *testing.T) {\n43: \tj := testJob(t)\n44: \trunner := &fakeOneShotRunner{out: []byte(\"did the thing\\n\")}\n45: \n46: \tif err := RunOneShot(runner, \"developer\", j); err != nil {\n47: \t\tt.Fatalf(\"RunOneShot: %v\", err)\n48: \t}\n49: \n50: \tdata, err := os.ReadFile(filepath.Join(j.Dir, \"session.log\"))\n51: \tif err != nil {\n52: \t\tt.Fatalf(\"reading session.log: %v\", err)\n53: \t}\n54: \tgot := string(data)\n55: \tif !strings.Contains(got, \"developer (attempt 1)\") {\n56: \t\tt.Errorf(\"session.log = %q, want a developer (attempt 1) header\", got)\n57: \t}\n58: \tif !strings.Contains(got, \"did the thing\") {\n59: \t\tt.Errorf(\"session.log = %q, want the runner's live output\", got)\n60: \t}\n61: \tif len(runner.calls) != 1 || runner.calls[0] != \"developer/\"+j.Name {\n62: \t\tt.Errorf(\"runner.calls = %v, want one call for developer/%s\", runner.calls, j.Name)\n63: \t}\n64: }\n65: \n66: func TestRunOneShotClosesSectionWithTrailingNewline(t *testing.T) {\n67: \tj := testJob(t)\n68: \trunner := &fakeOneShotRunner{out: []byte(\"no trailing newline\")}\n69: \n70: \tif err := RunOneShot(runner, \"analyst\", j); err != nil {\n71: \t\tt.Fatalf(\"RunOneShot: %v\", err)\n72: \t}\n73: \n74: \tdata, err := os.ReadFile(filepath.Join(j.Dir, \"session.log\"))\n75: \tif err != nil {\n76: \t\tt.Fatal(err)\n77: \t}\n78: \tif !strings.HasSuffix(string(data), \"no trailing newline\\n\") {\n79: \t\tt.Errorf(\"session.log = %q, want a trailing newline guaranteed by Close\", string(data))\n80: \t}\n81: }\n82: \n83: func TestRunOneShotWritesRunnerErrorIntoSessionLogAndReturnsIt(t *testing.T) {\n84: \tj := testJob(t)\n85: \twantErr := errors.New(\"mg --print --agent developer --job aaaa01_test-job: exit code 1: boom\")\n86: \trunner := &fakeOneShotRunner{err: wantErr}\n87: \n88: \terr := RunOneShot(runner, \"developer\", j)\n89: \tif !errors.Is(err, wantErr) && err.Error() != wantErr.Error() {\n90: \t\tt.Errorf(\"RunOneShot error = %v, want %v\", err, wantErr)\n91: \t}\n92: \n93: \tdata, rerr := os.ReadFile(filepath.Join(j.Dir, \"session.log\"))\n94: \tif rerr != nil {\n95: \t\tt.Fatalf(\"reading session.log: %v\", rerr)\n96: \t}\n97: \t// The goroutine that would normally start RunOneShot has nowhere else to\n98: \t// report a failure once its triggering HTTP request has already\n99: \t// returned — session.log is where it must land.\n100: \tif !strings.Contains(string(data), \"agent invocation failed\") || !strings.Contains(string(data), \"boom\") {\n101: \t\tt.Errorf(\"session.log = %q, want the runner error recorded in the section\", string(data))\n102: \t}\n103: }\n104: \n105: func TestRunOneShotMultipleInvocationsAppendSeparateSections(t *testing.T) {\n106: \tj := testJob(t)\n107: \trunner := &fakeOneShotRunner{out: []byte(\"first\\n\")}\n108: \tif err := RunOneShot(runner, \"analyst\", j); err != nil {\n109: \t\tt.Fatal(err)\n110: \t}\n111: \trunner2 := &fakeOneShotRunner{out: []byte(\"second\\n\")}\n112: \tif err := RunOneShot(runner2, \"developer\", j); err != nil {\n113: \t\tt.Fatal(err)\n114: \t}\n115: \n116: \tdata, err := os.ReadFile(filepath.Join(j.Dir, \"session.log\"))\n117: \tif err != nil {\n118: \t\tt.Fatal(err)\n119: \t}\n120: \tgot := string(data)\n121: \t// Both invocations are attempt 1 — a one-shot has no per-agent attempt\n122: \t// counter of its own, unlike mg-jdi's loop.\n123: \tif !strings.Contains(got, \"analyst (attempt 1)\") || !strings.Contains(got, \"developer (attempt 1)\") {\n124: \t\tt.Errorf(\"session.log = %q, want both sections at attempt 1\", got)\n125: \t}\n126: \tif i, j2 := strings.Index(got, \"first\"), strings.Index(got, \"second\"); i == -1 || j2 == -1 || i > j2 {\n127: \t\tt.Errorf(\"session.log sections out of order: %q\", got)\n128: \t}\n129: }\n130: \n131: // TestCommandAgentRunnerBuildsPrintInvocationForGivenProfile mirrors\n132: // cmd/mg/jdi_test.go's TestCommandAgentRunnerUsesGivenProfile: the exported\n133: // CommandAgentRunner is a thin, testable wrapper — its invocation options are\n134: // asserted directly rather than exercising a real docker/session-launcher run\n135: // (which needs docker on the test machine).\n136: func TestCommandAgentRunnerBuildsPrintInvocationForGivenProfile(t *testing.T) {\n137: \tr := &CommandAgentRunner{ProjectRoot: t.TempDir(), Profile: \"zai\"}\n138: \tif r.Profile != \"zai\" || r.ProjectRoot == \"\" {\n139: \t\tt.Errorf(\"CommandAgentRunner = %+v, want the given profile/root\", r)\n140: \t}\n141: }\n\n(End of file - total 141 lines)\n</content>","metadata":{"preview":"package session\n\nimport (\n\t\"errors\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// fakeOneShotRunner implements AgentRunner without spawning any real\n// process — mirroring cmd/mg/jdi_test.go's own fakeRunner — so RunOneShot's\n// session-log wiring can be tested independent of docker/session-launcher\n// plumbing (covered separately by CommandAgentRunner's own tests below).\ntype fakeOneShotRunner struct {\n\tout []byte\n\terr error","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/session/oneshot_test.go","text":"package session\n\nimport (\n\t\"errors\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// fakeOneShotRunner implements AgentRunner without spawning any real\n// process — mirroring cmd/mg/jdi_test.go's own fakeRunner — so RunOneShot's\n// session-log wiring can be tested independent of docker/session-launcher\n// plumbing (covered separately by CommandAgentRunner's own tests below).\ntype fakeOneShotRunner struct {\n\tout []byte\n\terr error\n\t// calls records every (agent, j.Name) pair Run was invoked with.\n\tcalls []string\n}\n\nfunc (f *fakeOneShotRunner) Run(agent string, j job.Job, live io.Writer) ([]byte, error) {\n\tf.calls = append(f.calls, agent+\"/\"+j.Name)\n\tif len(f.out) > 0 && live != nil {\n\t\tlive.Write(f.out)\n\t}\n\treturn f.out, f.err\n}\n\n// testJob builds a minimal job.Job whose Dir is a fresh temp directory —\n// enough for RunOneShot's session.log path (filepath.Join(j.Dir,\n// \"session.log\")).\nfunc testJob(t *testing.T) job.Job {\n\tt.Helper()\n\tdir := t.TempDir()\n\treturn job.Job{Name: \"aaaa01_test-job\", Dir: dir}\n}\n\nfunc TestRunOneShotOpensAttemptOneSectionAndStreamsOutput(t *testing.T) {\n\tj := testJob(t)\n\trunner := &fakeOneShotRunner{out: []byte(\"did the thing\\n\")}\n\n\tif err := RunOneShot(runner, \"developer\", j); err != nil {\n\t\tt.Fatalf(\"RunOneShot: %v\", err)\n\t}\n\n\tdata, err := os.ReadFile(filepath.Join(j.Dir, \"session.log\"))\n\tif err != nil {\n\t\tt.Fatalf(\"reading session.log: %v\", err)\n\t}\n\tgot := string(data)\n\tif !strings.Contains(got, \"developer (attempt 1)\") {\n\t\tt.Errorf(\"session.log = %q, want a developer (attempt 1) header\", got)\n\t}\n\tif !strings.Contains(got, \"did the thing\") {\n\t\tt.Errorf(\"session.log = %q, want the runner's live output\", got)\n\t}\n\tif len(runner.calls) != 1 || runner.calls[0] != \"developer/\"+j.Name {\n\t\tt.Errorf(\"runner.calls = %v, want one call for developer/%s\", runner.calls, j.Name)\n\t}\n}\n\nfunc TestRunOneShotClosesSectionWithTrailingNewline(t *testing.T) {\n\tj := testJob(t)\n\trunner := &fakeOneShotRunner{out: []byte(\"no trailing newline\")}\n\n\tif err := RunOneShot(runner, \"analyst\", j); err != nil {\n\t\tt.Fatalf(\"RunOneShot: %v\", err)\n\t}\n\n\tdata, err := os.ReadFile(filepath.Join(j.Dir, \"session.log\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !strings.HasSuffix(string(data), \"no trailing newline\\n\") {\n\t\tt.Errorf(\"session.log = %q, want a trailing newline guaranteed by Close\", string(data))\n\t}\n}\n\nfunc TestRunOneShotWritesRunnerErrorIntoSessionLogAndReturnsIt(t *testing.T) {\n\tj := testJob(t)\n\twantErr := errors.New(\"mg --print --agent developer --job aaaa01_test-job: exit code 1: boom\")\n\trunner := &fakeOneShotRunner{err: wantErr}\n\n\terr := RunOneShot(runner, \"developer\", j)\n\tif !errors.Is(err, wantErr) && err.Error() != wantErr.Error() {\n\t\tt.Errorf(\"RunOneShot error = %v, want %v\", err, wantErr)\n\t}\n\n\tdata, rerr := os.ReadFile(filepath.Join(j.Dir, \"session.log\"))\n\tif rerr != nil {\n\t\tt.Fatalf(\"reading session.log: %v\", rerr)\n\t}\n\t// The goroutine that would normally start RunOneShot has nowhere else to\n\t// report a failure once its triggering HTTP request has already\n\t// returned — session.log is where it must land.\n\tif !strings.Contains(string(data), \"agent invocation failed\") || !strings.Contains(string(data), \"boom\") {\n\t\tt.Errorf(\"session.log = %q, want the runner error recorded in the section\", string(data))\n\t}\n}\n\nfunc TestRunOneShotMultipleInvocationsAppendSeparateSections(t *testing.T) {\n\tj := testJob(t)\n\trunner := &fakeOneShotRunner{out: []byte(\"first\\n\")}\n\tif err := RunOneShot(runner, \"analyst\", j); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunner2 := &fakeOneShotRunner{out: []byte(\"second\\n\")}\n\tif err := RunOneShot(runner2, \"developer\", j); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tdata, err := os.ReadFile(filepath.Join(j.Dir, \"session.log\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgot := string(data)\n\t// Both invocations are attempt 1 — a one-shot has no per-agent attempt\n\t// counter of its own, unlike mg-jdi's loop.\n\tif !strings.Contains(got, \"analyst (attempt 1)\") || !strings.Contains(got, \"developer (attempt 1)\") {\n\t\tt.Errorf(\"session.log = %q, want both sections at attempt 1\", got)\n\t}\n\tif i, j2 := strings.Index(got, \"first\"), strings.Index(got, \"second\"); i == -1 || j2 == -1 || i > j2 {\n\t\tt.Errorf(\"session.log sections out of order: %q\", got)\n\t}\n}\n\n// TestCommandAgentRunnerBuildsPrintInvocationForGivenProfile mirrors\n// cmd/mg/jdi_test.go's TestCommandAgentRunnerUsesGivenProfile: the exported\n// CommandAgentRunner is a thin, testable wrapper — its invocation options are\n// asserted directly rather than exercising a real docker/session-launcher run\n// (which needs docker on the test machine).\nfunc TestCommandAgentRunnerBuildsPrintInvocationForGivenProfile(t *testing.T) {\n\tr := &CommandAgentRunner{ProjectRoot: t.TempDir(), Profile: \"zai\"}\n\tif r.Profile != \"zai\" || r.ProjectRoot == \"\" {\n\t\tt.Errorf(\"CommandAgentRunner = %+v, want the given profile/root\", r)\n\t}\n}","lineStart":1,"lineEnd":141,"totalLines":141,"truncated":false}},"title":"src/internal/session/oneshot_test.go","time":{"start":1787952953556,"end":1787952953559}},"id":"prt_04a4cf872001yCvIQvL0fjxtrJ","sessionID":"ses_fb5b402d5ffesBMXb1jVe3Cozl","messageID":"msg_04a4cf3bb0019U6fop9UBJuQZU"}}
