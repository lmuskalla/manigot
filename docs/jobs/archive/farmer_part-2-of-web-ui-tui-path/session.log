{"type":"tool_use","timestamp":1787952621644,"sessionID":"ses_fb5ba93f2ffe9RBBAgSFG35dIN","part":{"type":"tool","tool":"read","callID":"call_0c8047aa91954883acc6130c","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/api_test.go","limit":180},"output":"<path>/workspace/src/internal/serve/api_test.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"encoding/json\"\n5: \t\"net/http\"\n6: \t\"os\"\n7: \t\"path/filepath\"\n8: \t\"strings\"\n9: \t\"testing\"\n10: \n11: \t\"github.com/lmuskalla/manigot/internal/job\"\n12: )\n13: \n14: // fakeJobProject creates a project root at a temp dir with a job dir\n15: // docs/jobs/<name>/ carrying a brief.md with the given content, plus the\n16: // named extra files (each written with a one-line body). Returns the root.\n17: func fakeJobProject(t *testing.T, name, brief string, extraFiles ...string) string {\n18: \tt.Helper()\n19: \troot := t.TempDir()\n20: \tjobDir := filepath.Join(root, \"docs\", \"jobs\", name)\n21: \tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n22: \t\tt.Fatal(err)\n23: \t}\n24: \tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n25: \t\tt.Fatal(err)\n26: \t}\n27: \tfor _, f := range extraFiles {\n28: \t\tif err := os.WriteFile(filepath.Join(jobDir, f), []byte(\"content of \"+f+\"\\n\"), 0o644); err != nil {\n29: \t\t\tt.Fatal(err)\n30: \t\t}\n31: \t}\n32: \treturn root\n33: }\n34: \n35: // minimalBrief returns a brief.md body with the given frontmatter fields.\n36: func minimalBrief(title, id, status, typ, date string) string {\n37: \treturn \"# Brief: \" + title + \"\\n\\n\" +\n38: \t\t\"status: \" + status + \"\\n\" +\n39: \t\t\"type: \" + typ + \"\\n\" +\n40: \t\t\"id: \" + id + \"\\n\" +\n41: \t\t\"date: \" + date + \"\\n\" +\n42: \t\t\"author: Test\\n\\n## What\\n\\nA test job.\\n\"\n43: }\n44: \n45: // TestHandleProjectsListsRegisteredRoots: /projects returns the registry data\n46: // — each root's absolute path and base name — and nothing else.\n47: func TestHandleProjectsListsRegisteredRoots(t *testing.T) {\n48: \troot := t.TempDir()\n49: \treg := &Registry{entries: []Entry{entryFor(root)}}\n50: \tsrv := New(reg, \"test-version\", \"\", nil)\n51: \n52: \trec := get(t, srv, \"/projects\", \"\")\n53: \tif rec.Code != http.StatusOK {\n54: \t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n55: \t}\n56: \tvar body struct {\n57: \t\tProjects []projectRow `json:\"projects\"`\n58: \t}\n59: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n60: \t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n61: \t}\n62: \tif len(body.Projects) != 1 {\n63: \t\tt.Fatalf(\"projects = %v, want 1\", body.Projects)\n64: \t}\n65: \tif body.Projects[0].Path != filepath.Clean(root) || body.Projects[0].Name != filepath.Base(root) {\n66: \t\tt.Errorf(\"project row = %+v, want path=%s name=%s\", body.Projects[0], filepath.Clean(root), filepath.Base(root))\n67: \t}\n68: }\n69: \n70: // TestHandleProjectsEmptyRegistry: an empty registry lists no projects — a\n71: // valid, normal response.\n72: func TestHandleProjectsEmptyRegistry(t *testing.T) {\n73: \tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n74: \trec := get(t, srv, \"/projects\", \"\")\n75: \tif rec.Code != http.StatusOK {\n76: \t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n77: \t}\n78: \tif !strings.Contains(rec.Body.String(), `\"projects\":[]`) {\n79: \t\tt.Errorf(\"body = %s, want an empty projects list\", rec.Body.String())\n80: \t}\n81: }\n82: \n83: // TestHandleProjectJobsInfoDesign: one row per job in Discover's sort order\n84: // (date descending), carrying the TUI's info-design fields: id / status /\n85: // stage / type / date / title.\n86: func TestHandleProjectJobsInfoDesign(t *testing.T) {\n87: \troot := fakeJobProject(t, \"older_job\", minimalBrief(\"Older\", \"old\", \"open\", \"feature\", \"2026-08-01\"), \"tasks.md\")\n88: \t_ = fakeJobProjectInto(t, root, \"newer_job\", minimalBrief(\"Newer\", \"new\", \"open\", \"fix\", \"2026-08-10\"), \"tasks.md\", \"implementation.md\")\n89: \n90: \treg := &Registry{entries: []Entry{entryFor(root)}}\n91: \tsrv := New(reg, \"test-version\", \"\", nil)\n92: \n93: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs\", \"\")\n94: \tif rec.Code != http.StatusOK {\n95: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n96: \t}\n97: \tvar body struct {\n98: \t\tJobs []jobRow `json:\"jobs\"`\n99: \t}\n100: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n101: \t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n102: \t}\n103: \tif len(body.Jobs) != 2 {\n104: \t\tt.Fatalf(\"jobs = %d, want 2:\\n%s\", len(body.Jobs), rec.Body.String())\n105: \t}\n106: \n107: \t// Newest first: \"newer_job\" (2026-08-10) before \"older_job\" (2026-08-01).\n108: \tfirst := body.Jobs[0]\n109: \tif first.Name != \"newer_job\" {\n110: \t\tt.Errorf(\"first job = %q, want newer_job (date-sorted)\", first.Name)\n111: \t}\n112: \tif first.ID != \"new\" || first.Status != \"open\" || first.Type != \"fix\" || first.Date != \"2026-08-10\" || first.Title != \"Newer\" {\n113: \t\tt.Errorf(\"newer_job row = %+v, want the brief's frontmatter fields\", first)\n114: \t}\n115: \t// newer_job has implementation.md but no verdict → stage review.\n116: \tif first.Stage != \"review\" {\n117: \t\tt.Errorf(\"newer_job stage = %q, want review\", first.Stage)\n118: \t}\n119: \t// older_job has tasks.md but no implementation.md → stage implement.\n120: \tsecond := body.Jobs[1]\n121: \tif second.Name != \"older_job\" || second.Stage != \"implement\" {\n122: \t\tt.Errorf(\"older_job row = %+v, want name=older_job stage=implement\", second)\n123: \t}\n124: }\n125: \n126: // fakeJobProjectInto adds another job dir into an existing project root —\n127: // the second half of a two-job project (fakeJobProject creates its own root).\n128: func fakeJobProjectInto(t *testing.T, root, name, brief string, extraFiles ...string) string {\n129: \tt.Helper()\n130: \tjobDir := filepath.Join(root, \"docs\", \"jobs\", name)\n131: \tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n132: \t\tt.Fatal(err)\n133: \t}\n134: \tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n135: \t\tt.Fatal(err)\n136: \t}\n137: \tfor _, f := range extraFiles {\n138: \t\tif err := os.WriteFile(filepath.Join(jobDir, f), []byte(\"content of \"+f+\"\\n\"), 0o644); err != nil {\n139: \t\t\tt.Fatal(err)\n140: \t\t}\n141: \t}\n142: \treturn root\n143: }\n144: \n145: // TestHandleProjectJobsJDIState: a job with a mg-jdi status sidecar carries\n146: // its state/agent/updated in the row; one without carries no jdi field.\n147: func TestHandleProjectJobsJDIState(t *testing.T) {\n148: \troot := fakeJobProject(t, \"driven_job\", minimalBrief(\"Driven\", \"drv\", \"open\", \"feature\", \"2026-08-01\"))\n149: \n150: \t// Write a jdi status sidecar for the job (job.WriteJDIStatus).\n151: \tif err := writeJDIStatusForTest(t, root, \"driven_job\"); err != nil {\n152: \t\tt.Fatal(err)\n153: \t}\n154: \n155: \treg := &Registry{entries: []Entry{entryFor(root)}}\n156: \tsrv := New(reg, \"test-version\", \"\", nil)\n157: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs\", \"\")\n158: \tif rec.Code != http.StatusOK {\n159: \t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n160: \t}\n161: \tvar body struct {\n162: \t\tJobs []jobRow `json:\"jobs\"`\n163: \t}\n164: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n165: \t\tt.Fatalf(\"body not JSON: %v\", err)\n166: \t}\n167: \tif len(body.Jobs) != 1 || body.Jobs[0].JDI == nil {\n168: \t\tt.Fatalf(\"jdi state missing: %s\", rec.Body.String())\n169: \t}\n170: \tif body.Jobs[0].JDI.State != \"stopped:finished\" || body.Jobs[0].JDI.Agent != \"reviewer\" {\n171: \t\tt.Errorf(\"jdi row = %+v, want the written sidecar state\", body.Jobs[0].JDI)\n172: \t}\n173: \tif body.Jobs[0]