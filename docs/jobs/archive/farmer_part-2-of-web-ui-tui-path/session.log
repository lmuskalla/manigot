{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N6HRzkfjZkddYUtH8ahqZ5","type":"tool_result","content":"1\tpackage main\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"fmt\"\n6\t\t\"io\"\n7\t\t\"os\"\n8\t\t\"path/filepath\"\n9\t\t\"strings\"\n10\t\t\"time\"\n11\t\n12\t\t\"github.com/lmuskalla/manigot/internal/job\"\n13\t\t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n14\t)\n15\t\n16\t// sidecarExcludePattern is the .gitignore-syntax line ensureSidecarIgnored\n17\t// adds to a project's .git/info/exclude — every job's status sidecar, not\n18\t// just one, since the pattern is directory-shaped\n19\t// (\".manigot/jdi-status/\"). Rebuilt from the same constants\n20\t// (job.ManigotRelDir + job.JDISidecarDirName) the Go path construction\n21\t// uses, so the exclude pattern can never drift from where the sidecar is\n22\t// actually written.\n23\tvar sidecarExcludePattern = filepath.ToSlash(filepath.Join(job.ManigotRelDir, job.JDISidecarDirName)) + \"/\"\n24\t\n25\t// ensureSidecarIgnored appends sidecarExcludePattern to root's\n26\t// .git/info/exclude if not already present.\n27\t//\n28\t// This matters because the status/run.log sidecar lives inside\n29\t// the *target project's* .manigot/ — not manigot's own checkout — and the\n30\t// whole point of keeping it outside every job's own directory is so it can\n31\t// never be swept into an agent's own `git add -A`. That only actually holds\n32\t// if *this project's* git configuration excludes it: manigot's own\n33\t// .gitignore has no bearing on a project mg-jdi is driving. Rather than\n34\t// assume (or silently mutate) the project's own tracked .gitignore,\n35\t// .git/info/exclude is the right mechanism — local-only, per-checkout, never\n36\t// itself committed — so mg-jdi can guarantee this without touching anything\n37\t// the project's own history would ever see. Idempotent: safe to call on\n38\t// every mg-jdi run.\n39\t//\n40\t// Best-effort: a failure here (root isn't a git repo, .git/info isn't\n41\t// writable, etc.) is surfaced to the caller to log, but must not abort the\n42\t// run — worst case the sidecar risks being swept into a commit, exactly the\n43\t// pre-existing behavior before this safeguard existed.\n44\tfunc ensureSidecarIgnored(root string) error {\n45\t\texcludePath := filepath.Join(root, \".git\", \"info\", \"exclude\")\n46\t\n47\t\texisting, err := os.ReadFile(excludePath)\n48\t\tswitch {\n49\t\tcase err == nil:\n50\t\t\tif containsLine(string(existing), sidecarExcludePattern) {\n51\t\t\t\treturn nil\n52\t\t\t}\n53\t\tcase os.IsNotExist(err):\n54\t\t\texisting = nil\n55\t\tdefault:\n56\t\t\treturn err\n57\t\t}\n58\t\n59\t\tif err := os.MkdirAll(filepath.Dir(excludePath), 0o755); err != nil {\n60\t\t\treturn err\n61\t\t}\n62\t\tf, err := os.OpenFile(excludePath, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n63\t\tif err != nil {\n64\t\t\treturn err\n65\t\t}\n66\t\tdefer f.Close()\n67\t\n68\t\tprefix := \"\"\n69\t\tif len(existing) > 0 && existing[len(existing)-1] != '\\n' {\n70\t\t\tprefix = \"\\n\"\n71\t\t}\n72\t\t_, err = f.WriteString(prefix + sidecarExcludePattern + \"\\n\")\n73\t\treturn err\n74\t}\n75\t\n76\t// containsLine reports whether body has pattern as one of its lines\n77\t// (trimmed), so an existing exclude file with the pattern already present —\n78\t// however it got there — isn't duplicated on a second mg-jdi run.\n79\tfunc containsLine(body, pattern string) bool {\n80\t\tfor _, line := range strings.Split(body, \"\\n\") {\n81\t\t\tif strings.TrimSpace(line) == pattern {\n82\t\t\t\treturn true\n83\t\t\t}\n84\t\t}\n85\t\treturn false\n86\t}\n87\t\n88\t// openRunLog ensures the sidecar directory (job.JDIStatusDir — shared with\n89\t// the status file WriteJDIStatus writes) exists and opens\n90\t// (creating if necessary) run.log for appending — a fresh mg-jdi run\n91\t// continues the same job's transcript rather than truncating it, so a human\n92\t// can see the full history of every run against this job, not just the most\n93\t// recent one. It also reports whether the log already had content when it\n94\t// was opened (hadContent), which main() feeds to sectionWriter so the very\n95\t// first run ever written to a log starts it cleanly without a leading blank\n96\t// line (see sectionWriter's own doc).\n97\tfunc openRunLog(root, jobName string) (*os.File, bool, error) {\n98\t\tdir := job.JDIStatusDir(root, jobName)\n99\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n100\t\t\treturn nil, false, fmt.Errorf(\"create sidecar dir %s: %w\", dir, err)\n101\t\t}\n102\t\tf, err := os.OpenFile(job.JDIRunLogPath(root, jobName), os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n103\t\tif err != nil {\n104\t\t\treturn nil, false, fmt.Errorf(\"open run log: %w\", err)\n105\t\t}\n106\t\tst, err := f.Stat()\n107\t\tif err != nil {\n108\t\t\tf.Close()\n109\t\t\treturn nil, false, fmt.Errorf(\"stat run log: %w\", err)\n110\t\t}\n111\t\treturn f, st.Size() > 0, nil\n112\t}\n113\t\n114\t// sectionPrefix is the literal every \"=== ... ===\" state-log header in this\n115\t// file starts with — the five log* functions (logStarted, logAgentInvoked,\n116\t// logInvocation, logJobFinished, logImmediateStop) all emit their event\n117\t// headers as a line beginning with it. sectionWriter keys off it so it only\n118\t// inserts blank lines between actual sections, never inside one (the agent\n119\t// text and stop-reason bodies that follow their headers are separate writes\n120\t// that don't match).\n121\tvar sectionPrefix = []byte(\"===\")\n122\t\n123\t// sectionWriter is the writer mg-jdi's log destinations (stdout and the\n124\t// sidecar run.log) are wrapped in before anything is logged: it inserts a\n125\t// blank line before every \"=== ... ===\" section header written through it,\n126\t// so the log's events don't get crumbled together — either between the\n127\t// state events of a single run, or between consecutive mg-jdi runs of the\n128\t// same job appending to the same run.log.\n129\t//\n130\t// wroteSection seeds the writer with the pre-existing state of the\n131\t// underlying destination — whether run.log already had content when it was\n132\t// opened (see openRunLog). true means the first header written through this\n133\t// writer still needs its separating blank line (it's joining prior runs'\n134\t// output); false means this is the very first run ever written to the log,\n135\t// and the first header starts it at the top of the file with no leading\n136\t// blank line. Either way, every subsequent header gets the blank line.\n137\t//\n138\t// A non-header write (a header's following reason line, or an invocation's\n139\t// agent text, each of which arrives as its own write that does not start\n140\t// with sectionPrefix) passes through untouched — it belongs to the section\n141\t// that just began. sectionWriter itself never inserts blank lines inside a\n142\t// section; any body/header separation beyond the header's own trailing\n143\t// newline is the caller's own writes (logInvocation, for one, emits two\n144\t// blank lines of its own between the \"finished\" header and the agent text —\n145\t// see its doc).\n146\ttype sectionWriter struct {\n147\t\tw            io.Writer\n148\t\twroteSection bool\n149\t}\n150\t\n151\tfunc (s *sectionWriter) Write(p []byte) (int, error) {\n152\t\tif bytes.HasPrefix(p, sectionPrefix) {\n153\t\t\tif s.wroteSection {\n154\t\t\t\tif _, err := io.WriteString(s.w, \"\\n\\n\"); err != nil {\n155\t\t\t\t\treturn 0, err\n156\t\t\t\t}\n157\t\t\t}\n158\t\t\ts.wroteSection = true\n159\t\t}\n160\t\treturn s.w.Write(p)\n161\t}\n162\t\n163\t// logStarted writes a \"mg jdi started\" event to w, once, at the very top of\n164\t// a run — main()'s first write to logDest, before Run is even\n165\t// invoked, so a human watching run.log sees confirmation the run began\n166\t// immediately, rather than the log staying empty until the first agent\n167\t// invocation finishes. Mirrors\n168\t// logImmediateStop's \"=== ... ===\" header shape so every event in the log\n169\t// looks consistent.\n170\tfunc logStarted(w io.Writer, jobName, profile string) {\n171\t\tfmt.Fprintf(w, \"=== %s mg jdi started: job %s, profile %s ===\\n\", time.Now().Format(time.RFC3339), jobName, profile)\n172\t}\n173\t\n174\t// logAgentInvoked writes an \"agent invoked\" event to w immediately before\n175\t// Run launches an agent — distinct from logInvocation's own\n176\t// post-run header below, so a human watching run.log sees an invoked\n177\t// header right away rather than waiting for the (possibly long-running)\n178\t// invocation to finish before anything at all appears for it. attempt is\n179\t// that agent's invocation count within the run — per agent, not per run —\n180\t// so the first call of every agent is attempt 1, and a bounced-back\n181\t// agent's second call is attempt 2.\n182\tfunc logAgentInvoked(w io.Writer, agent string, attempt int) {\n183\t\tfmt.Fprintf(w, \"=== %s %s invoked (attempt %d) ===\\n\", time.Now().Format(time.RFC3339), agent, attempt)\n184\t}\n185\t\n186\t// logJobFinished writes a \"job finished\" event to w at Run's loop exit\n187\t// — both terminal outcomes, StopFinished and StopNeedsHuman.\n188\t//\n189\t// includeReason is false only for the stop-before-any-agent-ran case: that\n190\t// path has already printed reason via logImmediateStop immediately above,\n191\t// so repeating it here would print the exact same line twice in a row.\n192\t// Every other call site has never logged reason before this point, so it's\n193\t// included.\n194\tfunc logJobFinished(w io.Writer, kind orchestrate.Kind, reason string, includeReason bool) {\n195\t\tfmt.Fprintf(w, \"=== %s mg jdi finished: %s ===\\n\", time.Now().Format(time.RFC3339), kind)\n196\t\tif includeReason && reason != \"\" {\n197\t\t\tfmt.Fprintln(w, reason)\n198\t\t}\n199\t}\n200\t\n201\t// isDuplicateOutput reports whether fileContent — the just-run agent's\n202\t// target file, read fresh after this invocation — appears, once both sides\n203\t// are trimmed and internal whitespace is collapsed, as a substring of text —\n204\t// the agent's own response (the \"already the same ... skip it\" rule).\n205\t// Substring rather than exact equality, since a real\n206\t// response typically echoes the file's content plus its own surrounding\n207\t// commentary (a leading summary, a trailing \"done!\", etc.).\n208\t//\n209\t// An empty fileContent (the target file doesn't exist yet, or is itself\n210\t// empty) never counts as a duplicate — trivially \"contained\" in anything,\n211\t// but not a meaningful match.\n212\tfunc isDuplicateOutput(text, fileContent string) bool {\n213\t\tnormFile := normalizeWhitespace(fileContent)\n214\t\tif normFile == \"\" {\n215\t\t\treturn false\n216\t\t}\n217\t\treturn strings.Contains(normalizeWhitespace(text), normFile)\n218\t}\n219\t\n220\t// normalizeWhitespace collapses s to single-space-separated fields, so\n221\t// isDuplicateOutput's comparison isn't tripped up by incidental reformatting\n222\t// (extra blank lines, trailing spaces, etc.) between what's on disk and what\n223\t// an agent echoed back.\n224\tfunc normalizeWhitespace(s string) string {\n225\t\treturn strings.Join(strings.Fields(s), \" \")\n226\t}\n227\t\n228\t// logInvocation writes one agent invocation's captured output to w — Run's\n229\t// fan-out target, which main() builds as an io.MultiWriter of\n230\t// mg-jdi's own stdout and the sidecar's run.log, so both destinations get\n231\t// the exact same section: a \"=== <timestamp> <agent> finished (attempt N)\n232\t// ===\" header — paired with logAgentInvoked's own header just before this\n233\t// invocation started so a reader sees an invoked/finished\n234\t// pair per agent call rather than one ambiguous header. N is that agent's\n235\t// invocation count within the run — per agent, not per run — so the first\n236\t// call of every agent is attempt 1, and a bounced-back agent's second call\n237\t// is attempt 2. Then the agent's extracted final-response text\n238\t// (orchestrate.ResultText) — not the raw --output-format stream-json blob,\n239\t// so a human reading either destination sees prose, not JSON.\n240\t//\n241\t// Two blank lines separate the \"finished\" header from the agent's output\n242\t// (brief: jdi logs new line): without them the output reads as glued to the\n243\t// finished statement — on a wrapped terminal, and in the TUI's log tab,\n244\t// which renders run.log's raw content — as if it began on the same line.\n245\t// The blank lines are written unconditionally, before whichever body variant\n246\t// follows (real text, \"(no output)\", or the dedup \"(output matches ...,\n247\t// omitted)\" note below), so the separation is the same in every case.\n248\t//\n249\t// Honesty note (carried into scripts/entrypoint.sh's own comment): this is\n250\t// exactly the agent's *final response text* per invocation — the prose\n251\t// ResultText extracts from whatever --print shape produced it — not a\n252\t// blow-by-blow of every tool call/file edit. The blow-by-blow itself is not\n253\t// lost anymore: the raw captured output (the full step-level event stream\n254\t// since --output-format stream-json) is streamed verbatim into the job's\n255\t// session.log live during the invocation (see openSessionLog and Run) —\n256\t// run.log is the summary, session.log is the truth.\n257\t//\n258\t// targetFile/targetContent are the just-run agent's expected job\n259\t// file and its content read fresh after the invocation (see\n260\t// orchestrate.AgentTargetFile) — the caller's responsibility, since it\n261\t// already has j.Dir\n262\t// on hand. When the response text turns out to be a duplicate of that file\n263\t// (isDuplicateOutput), the body is replaced with a short note instead of the\n264\t// full (possibly large) text — the header is unaffected, so a reader still\n265\t// sees an invoked/finished pair either way. targetFile == \"\" (e.g. an\n266\t// unrecognized agent, or the file couldn't be read) simply skips the check.\n267\tfunc logInvocation(w io.Writer, agent string, attempt int, raw []byte, targetFile, targetContent string) {\n268\t\t// \"\\n\\n\\n\" = the header's own trailing newline plus two blank lines, so\n269\t\t// the agent's output starts two lines below the \"finished\" statement\n270\t\t// (brief: jdi logs new line).\n271\t\tfmt.Fprintf(w, \"=== %s %s finished (attempt %d) ===\\n\\n\\n\", time.Now().Format(time.RFC3339), agent, attempt)\n272\t\ttext := orchestrate.ResultText(raw)\n273\t\tswitch {\n274\t\tcase text == \"\":\n275\t\t\ttext = \"(no output)\"\n276\t\tcase targetFile != \"\" && isDuplicateOutput(text, targetContent):\n277\t\t\ttext = fmt.Sprintf(\"(output matches %s, omitted)\", targetFile)\n278\t\t}\n279\t\tif text[len(text)-1] != '\\n' {\n280\t\t\ttext += \"\\n\"\n281\t\t}\n282\t\tfmt.Fprint(w, text)\n283\t}\n284\t\n285\t// openSessionLog opens the job's session.log for live appending and writes\n286\t// the section header for the invocation about to start — a blank-line\n287\t// separator (skipped for the very first section ever written to a fresh\n288\t// file) plus the \"=== <RFC3339 timestamp> <agent> (attempt N) ===\" header,\n289\t// the same sectioned shape appendSessionLog used to write post-hoc. The\n290\t// returned *sessionLog is the writer the invocation's raw bytes are tee'd\n291\t// into as they arrive (see commandAgentRunner.Run's io.MultiWriter), so the\n292\t// verbose log grows live during the run instead of only after it finishes —\n293\t// the whole point of the tailing fix. Callers Close it after the invocation\n294\t// so the trailing-newline guarantee holds.\n295\tfunc openSessionLog(path, agent string, attempt int) (*sessionLog, error) {\n296\t\tf, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n297\t\tif err != nil {\n298\t\t\treturn nil, err\n299\t\t}\n300\t\n301\t\t// Blank-line separator between sections — the very first section ever\n302\t\t// written to a fresh file starts at the top instead.\n303\t\tif st, err := f.Stat(); err != nil {\n304\t\t\tf.Close()\n305\t\t\treturn nil, err\n306\t\t} else if st.Size() > 0 {\n307\t\t\tif _, err := io.WriteString(f, \"\\n\"); err != nil {\n308\t\t\t\tf.Close()\n309\t\t\t\treturn nil, err\n310\t\t\t}\n311\t\t}\n312\t\n313\t\tif _, err := fmt.Fprintf(f, \"=== %s %s (attempt %d) ===\\n\", time.Now().Format(time.RFC3339), agent, attempt); err != nil {\n314\t\t\tf.Close()\n315\t\t\treturn nil, err\n316\t\t}\n317\t\treturn &sessionLog{f: f}, nil\n318\t}\n319\t\n320\t// sessionLog is the live, per-invocation writer behind the job's session.log\n321\t// (docs/jobs/<id>_<slug>/session.log): it owns the open file handle and\n322\t// tracks the last byte written through it, so Close can guarantee the\n323\t// section ends with a newline — the same trailing-newline guarantee\n324\t// appendSessionLog used to make post-hoc, without needing to read the file\n325\t// back. The file is opened in append mode, so concurrent appends (a second\n326\t// mg-jdi run against the same job, or the next invocation's own section)\n327\t// can never overwrite this section.\n328\ttype sessionLog struct {\n329\t\tf        *os.File\n330\t\tlastByte byte // last byte written through this writer; 0 when nothing was written\n331\t}\n332\t\n333\t// Write appends p to the underlying file and records the last byte, so Close\n334\t// knows whether a trailing newline is still needed.\n335\tfunc (s *sessionLog) Write(p []byte) (int, error) {\n336\t\tif len(p) > 0 {\n337\t\t\ts.lastByte = p[len(p)-1]\n338\t\t}\n339\t\treturn s.f.Write(p)\n340\t}\n341\t\n342\t// Close finishes the section and closes the file: a trailing newline is\n343\t// written when the last write didn't already end with one, so the next\n344\t// section's header never glues to this section's raw output. Nothing written\n345\t// at all (an invocation that produced no output) leaves the header's own\n346\t// trailing newline as the section end.\n347\tfunc (s *sessionLog) Close() error {\n348\t\tif s.lastByte != 0 && s.lastByte != '\\n' {\n349\t\t\tif _, err := s.f.Write([]byte(\"\\n\")); err != nil {\n350\t\t\t\ts.f.Close()\n351\t\t\t\treturn err\n352\t\t\t}\n353\t\t}\n354\t\treturn s.f.Close()\n355\t}\n356\t\n357\t// ensureSessionLogFile creates the job's session.log if it doesn't exist yet\n358\t// (an empty file is fine — the per-invocation openSessionLog appends the\n359\t// first section header on demand), so the TUI's \"l\" tail gate — the file's\n360\t// existence — is stable from the moment an mg-jdi run begins, mirroring\n361\t// run.log's own up-front creation in openRunLog. Best-effort: a failure only\n362\t// warns; the loop still creates the file per invocation.\n363\tfunc ensureSessionLogFile(path string) error {\n364\t\tf, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n365\t\tif err != nil {\n366\t\t\treturn err\n367\t\t}\n368\t\treturn f.Close()\n369\t}\n370\t\n371\t// logImmediateStop writes an \"immediate stop\" note to w — orchestrate.Next\n372\t// returning a Stop* decision before any agent has ever been invoked (e.g.\n373\t// job.StageDefine with an unwritten brief.md), the one case logInvocation\n374\t// never runs for. Without this, run.log would be left at 0 bytes for that\n375\t// stop, itself confusing\n376\t// independent of whether the stop was the correct call. Mirrors\n377\t// logInvocation's \"=== ... ===\" header shape so both look consistent in the\n378\t// same log, but names the stop instead of an agent/attempt.\n379\tfunc logImmediateStop(w io.Writer, reason string) {\n380\t\tfmt.Fprintf(w, \"=== %s mg jdi stopped before running any agent ===\\n\", time.Now().Format(time.RFC3339))\n381\t\tfmt.Fprintln(w, reason)\n382\t}\n383\t"}]},"parent_tool_use_id":null,"session_id":"5af88135-9c7b-453b-b119-c245e62a60fb","uuid":"55b2558e-de20-4e2b-a706-a152308e2668","timestamp":"2026-08-28T20:16:58.928Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/cmd/mg/jdioutput.go","content":"package main\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n)\n\n// sidecarExcludePattern is the .gitignore-syntax line ensureSidecarIgnored\n// adds to a project's .git/info/exclude — every job's status sidecar, not\n// just one, since the pattern is directory-shaped\n// (\".manigot/jdi-status/\"). Rebuilt from the same constants\n// (job.ManigotRelDir + job.JDISidecarDirName) the Go path construction\n// uses, so the exclude pattern can never drift from where the sidecar is\n// actually written.\nvar sidecarExcludePattern = filepath.ToSlash(filepath.Join(job.ManigotRelDir, job.JDISidecarDirName)) + \"/\"\n\n// ensureSidecarIgnored appends sidecarExcludePattern to root's\n// .git/info/exclude if not already present.\n//\n// This matters because the status/run.log sidecar lives inside\n// the *target project's* .manigot/ — not manigot's own checkout — and the\n// whole point of keeping it outside every job's own directory is so it can\n// never be swept into an agent's own `git add -A`. That only actually holds\n// if *this project's* git configuration excludes it: manigot's own\n// .gitignore has no bearing on a project mg-jdi is driving. Rather than\n// assume (or silently mutate) the project's own tracked .gitignore,\n// .git/info/exclude is the right mechanism — local-only, per-checkout, never\n// itself committed — so mg-jdi can guarantee this without touching anything\n// the project's own history would ever see. Idempotent: safe to call on\n// every mg-jdi run.\n//\n// Best-effort: a failure here (root isn't a git repo, .git/info isn't\n// writable, etc.) is surfaced to the caller to log, but must not abort the\n// run — worst case the sidecar risks being swept into a commit, exactly the\n// pre-existing behavior before this safeguard existed.\nfunc ensureSidecarIgnored(root string) error {\n\texcludePath := filepath.Join(root, \".git\", \"info\", \"exclude\")\n\n\texisting, err := os.ReadFile(excludePath)\n\tswitch {\n\tcase err == nil:\n\t\tif containsLine(string(existing), sidecarExcludePattern) {\n\t\t\treturn nil\n\t\t}\n\tcase os.IsNotExist(err):\n\t\texisting = nil\n\tdefault:\n\t\treturn err\n\t}\n\n\tif err := os.MkdirAll(filepath.Dir(excludePath), 0o755); err != nil {\n\t\treturn err\n\t}\n\tf, err := os.OpenFile(excludePath, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer f.Close()\n\n\tprefix := \"\"\n\tif len(existing) > 0 && existing[len(existing)-1] != '\\n' {\n\t\tprefix = \"\\n\"\n\t}\n\t_, err = f.WriteString(prefix + sidecarExcludePattern + \"\\n\")\n\treturn err\n}\n\n// containsLine reports whether body has pattern as one of its lines\n// (trimmed), so an existing exclude file with the pattern already present —\n// however it got there — isn't duplicated on a second mg-jdi run.\nfunc containsLine(body, pattern string) bool {\n\tfor _, line := range strings.Split(body, \"\\n\") {\n\t\tif strings.TrimSpace(line) == pattern {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// openRunLog ensures the sidecar directory (job.JDIStatusDir — shared with\n// the status file WriteJDIStatus writes) exists and opens\n// (creating if necessary) run.log for appending — a fresh mg-jdi run\n// continues the same job's transcript rather than truncating it, so a human\n// can see the full history of every run against this job, not just the most\n// recent one. It also reports whether the log already had content when it\n// was opened (hadContent), which main() feeds to sectionWriter so the very\n// first run ever written to a log starts it cleanly without a leading blank\n// line (see sectionWriter's own doc).\nfunc openRunLog(root, jobName string) (*os.File, bool, error) {\n\tdir := job.JDIStatusDir(root, jobName)\n\tif err := os.MkdirAll(dir, 0o755); err != nil {\n\t\treturn nil, false, fmt.Errorf(\"create sidecar dir %s: %w\", dir, err)\n\t}\n\tf, err := os.OpenFile(job.JDIRunLogPath(root, jobName), os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n\tif err != nil {\n\t\treturn nil, false, fmt.Errorf(\"open run log: %w\", err)\n\t}\n\tst, err := f.Stat()\n\tif err != nil {\n\t\tf.Close()\n\t\treturn nil, false, fmt.Errorf(\"stat run log: %w\", err)\n\t}\n\treturn f, st.Size() > 0, nil\n}\n\n// sectionPrefix is the literal every \"=== ... ===\" state-log header in this\n// file starts with — the five log* functions (logStarted, logAgentInvoked,\n// logInvocation, logJobFinished, logImmediateStop) all emit their event\n// headers as a line beginning with it. sectionWriter keys off it so it only\n// inserts blank lines between actual sections, never inside one (the agent\n// text and stop-reason bodies that follow their headers are separate writes\n// that don't match).\nvar sectionPrefix = []byte(\"===\")\n\n// sectionWriter is the writer mg-jdi's log destinations (stdout and the\n// sidecar run.log) are wrapped in before anything is logged: it inserts a\n// blank line before every \"=== ... ===\" section header written through it,\n// so the log's events don't get crumbled together — either between the\n// state events of a single run, or between consecutive mg-jdi runs of the\n// same job appending to the same run.log.\n//\n// wroteSection seeds the writer with the pre-existing state of the\n// underlying destination — whether run.log already had content when it was\n// opened (see openRunLog). true means the first header written through this\n// writer still needs its separating blank line (it's joining prior runs'\n// output); false means this is the very first run ever written to the log,\n// and the first header starts it at the top of the file with no leading\n// blank line. Either way, every subsequent header gets the blank line.\n//\n// A non-header write (a header's following reason line, or an invocation's\n// agent text, each of which arrives as its own write that does not start\n// with sectionPrefix) passes through untouched — it belongs to the section\n// that just began. sectionWriter itself never inserts blank lines inside a\n// section; any body/header separation beyond the header's own trailing\n// newline is the caller's own writes (logInvocation, for one, emits two\n// blank lines of its own between the \"finished\" header and the agent text —\n// see its doc).\ntype sectionWriter struct {\n\tw            io.Writer\n\twroteSection bool\n}\n\nfunc (s *sectionWriter) Write(p []byte) (int, error) {\n\tif bytes.HasPrefix(p, sectionPrefix) {\n\t\tif s.wroteSection {\n\t\t\tif _, err := io.WriteString(s.w, \"\\n\\n\"); err != nil {\n\t\t\t\treturn 0, err\n\t\t\t}\n\t\t}\n\t\ts.wroteSection = true\n\t}\n\treturn s.w.Write(p)\n}\n\n// logStarted writes a \"mg jdi started\" event to w, once, at the very top of\n// a run — main()'s first write to logDest, before Run is even\n// invoked, so a human watching run.log sees confirmation the run began\n// immediately, rather than the log staying empty until the first agent\n// invocation finishes. Mirrors\n// logImmediateStop's \"=== ... ===\" header shape so every event in the log\n// looks consistent.\nfunc logStarted(w io.Writer, jobName, profile string) {\n\tfmt.Fprintf(w, \"=== %s mg jdi started: job %s, profile %s ===\\n\", time.Now().Format(time.RFC3339), jobName, profile)\n}\n\n// logAgentInvoked writes an \"agent invoked\" event to w immediately before\n// Run launches an agent — distinct from logInvocation's own\n// post-run header below, so a human watching run.log sees an invoked\n// header right away rather than waiting for the (possibly long-running)\n// invocation to finish before anything at all appears for it. attempt is\n// that agent's invocation count within the run — per agent, not per run —\n// so the first call of every agent is attempt 1, and a bounced-back\n// agent's second call is attempt 2.\nfunc logAgentInvoked(w io.Writer, agent string, attempt int) {\n\tfmt.Fprintf(w, \"=== %s %s invoked (attempt %d) ===\\n\", time.Now().Format(time.RFC3339), agent, attempt)\n}\n\n// logJobFinished writes a \"job finished\" event to w at Run's loop exit\n// — both terminal outcomes, StopFinished and StopNeedsHuman.\n//\n// includeReason is false only for the stop-before-any-agent-ran case: that\n// path has already printed reason via logImmediateStop immediately above,\n// so repeating it here would print the exact same line twice in a row.\n// Every other call site has never logged reason before this point, so it's\n// included.\nfunc logJobFinished(w io.Writer, kind orchestrate.Kind, reason string, includeReason bool) {\n\tfmt.Fprintf(w, \"=== %s mg jdi finished: %s ===\\n\", time.Now().Format(time.RFC3339), kind)\n\tif includeReason && reason != \"\" {\n\t\tfmt.Fprintln(w, reason)\n\t}\n}\n\n// isDuplicateOutput reports whether fileContent — the just-run agent's\n// target file, read fresh after this invocation — appears, once both sides\n// are trimmed and internal whitespace is collapsed, as a substring of text —\n// the agent's own response (the \"already the same ... skip it\" rule).\n// Substring rather than exact equality, since a real\n// response typically echoes the file's content plus its own surrounding\n// commentary (a leading summary, a trailing \"done!\", etc.).\n//\n// An empty fileContent (the target file doesn't exist yet, or is itself\n// empty) never counts as a duplicate — trivially \"contained\" in anything,\n// but not a meaningful match.\nfunc isDuplicateOutput(text, fileContent string) bool {\n\tnormFile := normalizeWhitespace(fileContent)\n\tif normFile == \"\" {\n\t\treturn false\n\t}\n\treturn strings.Contains(normalizeWhitespace(text), normFile)\n}\n\n// normalizeWhitespace collapses s to single-space-separated fields, so\n// isDuplicateOutput's comparison isn't tripped up by incidental reformatting\n// (extra blank lines, trailing spaces, etc.) between what's on disk and what\n// an agent echoed back.\nfunc normalizeWhitespace(s string) string {\n\treturn strings.Join(strings.Fields(s), \" \")\n}\n\n// logInvocation writes one agent invocation's captured output to w — Run's\n// fan-out target, which main() builds as an io.MultiWriter of\n// mg-jdi's own stdout and the sidecar's run.log, so both destinations get\n// the exact same section: a \"=== <timestamp> <agent> finished (attempt N)\n// ===\" header — paired with logAgentInvoked's own header just before this\n// invocation started so a reader sees an invoked/finished\n// pair per agent call rather than one ambiguous header. N is that agent's\n// invocation count within the run — per agent, not per run — so the first\n// call of every agent is attempt 1, and a bounced-back agent's second call\n// is attempt 2. Then the agent's extracted final-response text\n// (orchestrate.ResultText) — not the raw --output-format stream-json blob,\n// so a human reading either destination sees prose, not JSON.\n//\n// Two blank lines separate the \"finished\" header from the agent's output\n// (brief: jdi logs new line): without them the output reads as glued to the\n// finished statement — on a wrapped terminal, and in the TUI's log tab,\n// which renders run.log's raw content — as if it began on the same line.\n// The blank lines are written unconditionally, before whichever body variant\n// follows (real text, \"(no output)\", or the dedup \"(output matches ...,\n// omitted)\" note below), so the separation is the same in every case.\n//\n// Honesty note (carried into scripts/entrypoint.sh's own comment): this is\n// exactly the agent's *final response text* per invocation — the prose\n// ResultText extracts from whatever --print shape produced it — not a\n// blow-by-blow of every tool call/file edit. The blow-by-blow itself is not\n// lost anymore: the raw captured output (the full step-level event stream\n// since --output-format stream-json) is streamed verbatim into the job's\n// session.log live during the invocation (see openSessionLog and Run) —\n// run.log is the summary, session.log is the truth.\n//\n// targetFile/targetContent are the just-run agent's expected job\n// file and its content read fresh after the invocation (see\n// orchestrate.AgentTargetFile) — the caller's responsibility, since it\n// already has j.Dir\n// on hand. When the response text turns out to be a duplicate of that file\n// (isDuplicateOutput), the body is replaced with a short note instead of the\n// full (possibly large) text — the header is unaffected, so a reader still\n// sees an invoked/finished pair either way. targetFile == \"\" (e.g. an\n// unrecognized agent, or the file couldn't be read) simply skips the check.\nfunc logInvocation(w io.Writer, agent string, attempt int, raw []byte, targetFile, targetContent string) {\n\t// \"\\n\\n\\n\" = the header's own trailing newline plus two blank lines, so\n\t// the agent's output starts two lines below the \"finished\" statement\n\t// (brief: jdi logs new line).\n\tfmt.Fprintf(w, \"=== %s %s finished (attempt %d) ===\\n\\n\\n\", time.Now().Format(time.RFC3339), agent, attempt)\n\ttext := orchestrate.ResultText(raw)\n\tswitch {\n\tcase text == \"\":\n\t\ttext = \"(no output)\"\n\tcase targetFile != \"\" && isDuplicateOutput(text, targetContent):\n\t\ttext = fmt.Sprintf(\"(output matches %s, omitted)\", targetFile)\n\t}\n\tif text[len(text)-1] != '\\n' {\n\t\ttext += \"\\n\"\n\t}\n\tfmt.Fprint(w, text)\n}\n\n// openSessionLog opens the job's session.log for live appending and writes\n// the section header for the invocation about to start — a blank-line\n// separator (skipped for the very first section ever written to a fresh\n// file) plus the \"=== <RFC3339 timestamp> <agent> (attempt N) ===\" header,\n// the same sectioned shape appendSessionLog used to write post-hoc. The\n// returned *sessionLog is the writer the invocation's raw bytes are tee'd\n// into as they arrive (see commandAgentRunner.Run's io.MultiWriter), so the\n// verbose log grows live during the run instead of only after it finishes —\n// the whole point of the tailing fix. Callers Close it after the invocation\n// so the trailing-newline guarantee holds.\nfunc openSessionLog(path, agent string, attempt int) (*sessionLog, error) {\n\tf, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\t// Blank-line separator between sections — the very first section ever\n\t// written to a fresh file starts at the top instead.\n\tif st, err := f.Stat(); err != nil {\n\t\tf.Close()\n\t\treturn nil, err\n\t} else if st.Size() > 0 {\n\t\tif _, err := io.WriteString(f, \"\\n\"); err != nil {\n\t\t\tf.Close()\n\t\t\treturn nil, err\n\t\t}\n\t}\n\n\tif _, err := fmt.Fprintf(f, \"=== %s %s (attempt %d) ===\\n\", time.Now().Format(time.RFC3339), agent, attempt); err != nil {\n\t\tf.Close()\n\t\treturn nil, err\n\t}\n\treturn &sessionLog{f: f}, nil\n}\n\n// sessionLog is the live, per-invocation writer behind the job's session.log\n// (docs/jobs/<id>_<slug>/session.log): it owns the open file handle and\n// tracks the last byte written through it, so Close can guarantee the\n// section ends with a newline — the same trailing-newline guarantee\n// appendSessionLog used to make post-hoc, without needing to read the file\n// back. The file is opened in append mode, so concurrent appends (a second\n// mg-jdi run against the same job, or the next invocation's own section)\n// can never overwrite this section.\ntype sessionLog struct {\n\tf        *os.File\n\tlastByte byte // last byte written through this writer; 0 when nothing was written\n}\n\n// Write appends p to the underlying file and records the last byte, so Close\n// knows whether a trailing newline is still needed.\nfunc (s *sessionLog) Write(p []byte) (int, error) {\n\tif len(p) > 0 {\n\t\ts.lastByte = p[len(p)-1]\n\t}\n\treturn s.f.Write(p)\n}\n\n// Close finishes the section and closes the file: a trailing newline is\n// written when the last write didn't already end with one, so the next\n// section's header never glues to this section's raw output. Nothing written\n// at all (an invocation that produced no output) leaves the header's own\n// trailing newline as the section end.\nfunc (s *sessionLog) Close() error {\n\tif s.lastByte != 0 && s.lastByte != '\\n' {\n\t\tif _, err := s.f.Write([]byte(\"\\n\")); err != nil {\n\t\t\ts.f.Close()\n\t\t\treturn err\n\t\t}\n\t}\n\treturn s.f.Close()\n}\n\n// ensureSessionLogFile creates the job's session.log if it doesn't exist yet\n// (an empty file is fine — the per-invocation openSessionLog appends the\n// first section header on demand), so the TUI's \"l\" tail gate — the file's\n// existence — is stable from the moment an mg-jdi run begins, mirroring\n// run.log's own up-front creation in openRunLog. Best-effort: a failure only\n// warns; the loop still creates the file per invocation.\nfunc ensureSessionLogFile(path string) error {\n\tf, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn f.Close()\n}\n\n// logImmediateStop writes an \"immediate stop\" note to w — orchestrate.Next\n// returning a Stop* decision before any agent has ever been invoked (e.g.\n// job.StageDefine with an unwritten brief.md), the one case logInvocation\n// never runs for. Without this, run.log would be left at 0 bytes for that\n// stop, itself confusing\n// independent of whether the stop was the correct call. Mirrors\n// logInvocation's \"=== ... ===\" header shape so both look consistent in the\n// same log, but names the stop instead of an agent/attempt.\nfunc logImmediateStop(w io.Writer, reason string) {\n\tfmt.Fprintf(w, \"=== %s mg jdi stopped before running any agent ===\\n\", time.Now().Format(time.RFC3339))\n\tfmt.Fprintln(w, reason)\n}\n","numLines":383,"startLine":1,"totalLines":383}}}
