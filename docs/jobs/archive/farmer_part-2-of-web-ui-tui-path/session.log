{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T2F7haGAfimCoguMm7eDP9","type":"tool_result","content":"1\tpackage serve\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"net/http\"\n6\t\t\"os\"\n7\t\t\"path/filepath\"\n8\t\t\"strings\"\n9\t\t\"testing\"\n10\t\n11\t\t\"github.com/lmuskalla/manigot/internal/job\"\n12\t)\n13\t\n14\t// fakeJobProject creates a project root at a temp dir with a job dir\n15\t// docs/jobs/<name>/ carrying a brief.md with the given content, plus the\n16\t// named extra files (each written with a one-line body). Returns the root.\n17\tfunc fakeJobProject(t *testing.T, name, brief string, extraFiles ...string) string {\n18\t\tt.Helper()\n19\t\troot := t.TempDir()\n20\t\tjobDir := filepath.Join(root, \"docs\", \"jobs\", name)\n21\t\tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n22\t\t\tt.Fatal(err)\n23\t\t}\n24\t\tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n25\t\t\tt.Fatal(err)\n26\t\t}\n27\t\tfor _, f := range extraFiles {\n28\t\t\tif err := os.WriteFile(filepath.Join(jobDir, f), []byte(\"content of \"+f+\"\\n\"), 0o644); err != nil {\n29\t\t\t\tt.Fatal(err)\n30\t\t\t}\n31\t\t}\n32\t\treturn root\n33\t}\n34\t\n35\t// minimalBrief returns a brief.md body with the given frontmatter fields.\n36\tfunc minimalBrief(title, id, status, typ, date string) string {\n37\t\treturn \"# Brief: \" + title + \"\\n\\n\" +\n38\t\t\t\"status: \" + status + \"\\n\" +\n39\t\t\t\"type: \" + typ + \"\\n\" +\n40\t\t\t\"id: \" + id + \"\\n\" +\n41\t\t\t\"date: \" + date + \"\\n\" +\n42\t\t\t\"author: Test\\n\\n## What\\n\\nA test job.\\n\"\n43\t}\n44\t\n45\t// TestHandleProjectsListsRegisteredRoots: /projects returns the registry data\n46\t// — each root's absolute path and base name — and nothing else.\n47\tfunc TestHandleProjectsListsRegisteredRoots(t *testing.T) {\n48\t\troot := t.TempDir()\n49\t\treg := &Registry{entries: []Entry{entryFor(root)}}\n50\t\tsrv := New(reg, \"test-version\", \"\", nil)\n51\t\n52\t\trec := get(t, srv, \"/projects\", \"\")\n53\t\tif rec.Code != http.StatusOK {\n54\t\t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n55\t\t}\n56\t\tvar body struct {\n57\t\t\tProjects []projectRow `json:\"projects\"`\n58\t\t}\n59\t\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n60\t\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n61\t\t}\n62\t\tif len(body.Projects) != 1 {\n63\t\t\tt.Fatalf(\"projects = %v, want 1\", body.Projects)\n64\t\t}\n65\t\tif body.Projects[0].Path != filepath.Clean(root) || body.Projects[0].Name != filepath.Base(root) {\n66\t\t\tt.Errorf(\"project row = %+v, want path=%s name=%s\", body.Projects[0], filepath.Clean(root), filepath.Base(root))\n67\t\t}\n68\t}\n69\t\n70\t// TestHandleProjectsEmptyRegistry: an empty registry lists no projects — a\n71\t// valid, normal response.\n72\tfunc TestHandleProjectsEmptyRegistry(t *testing.T) {\n73\t\tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n74\t\trec := get(t, srv, \"/projects\", \"\")\n75\t\tif rec.Code != http.StatusOK {\n76\t\t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n77\t\t}\n78\t\tif !strings.Contains(rec.Body.String(), `\"projects\":[]`) {\n79\t\t\tt.Errorf(\"body = %s, want an empty projects list\", rec.Body.String())\n80\t\t}\n81\t}\n82\t\n83\t// TestHandleProjectJobsInfoDesign: one row per job in Discover's sort order\n84\t// (date descending), carrying the TUI's info-design fields: id / status /\n85\t// stage / type / date / title.\n86\tfunc TestHandleProjectJobsInfoDesign(t *testing.T) {\n87\t\troot := fakeJobProject(t, \"older_job\", minimalBrief(\"Older\", \"old\", \"open\", \"feature\", \"2026-08-01\"), \"tasks.md\")\n88\t\t_ = fakeJobProjectInto(t, root, \"newer_job\", minimalBrief(\"Newer\", \"new\", \"open\", \"fix\", \"2026-08-10\"), \"tasks.md\", \"implementation.md\")\n89\t\n90\t\treg := &Registry{entries: []Entry{entryFor(root)}}\n91\t\tsrv := New(reg, \"test-version\", \"\", nil)\n92\t\n93\t\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs\", \"\")\n94\t\tif rec.Code != http.StatusOK {\n95\t\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n96\t\t}\n97\t\tvar body struct {\n98\t\t\tJobs []jobRow `json:\"jobs\"`\n99\t\t}\n100\t\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n101\t\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n102\t\t}\n103\t\tif len(body.Jobs) != 2 {\n104\t\t\tt.Fatalf(\"jobs = %d, want 2:\\n%s\", len(body.Jobs), rec.Body.String())\n105\t\t}\n106\t\n107\t\t// Newest first: \"newer_job\" (2026-08-10) before \"older_job\" (2026-08-01).\n108\t\tfirst := body.Jobs[0]\n109\t\tif first.Name != \"newer_job\" {\n110\t\t\tt.Errorf(\"first job = %q, want newer_job (date-sorted)\", first.Name)\n111\t\t}\n112\t\tif first.ID != \"new\" || first.Status != \"open\" || first.Type != \"fix\" || first.Date != \"2026-08-10\" || first.Title != \"Newer\" {\n113\t\t\tt.Errorf(\"newer_job row = %+v, want the brief's frontmatter fields\", first)\n114\t\t}\n115\t\t// newer_job has implementation.md but no verdict → stage review.\n116\t\tif first.Stage != \"review\" {\n117\t\t\tt.Errorf(\"newer_job stage = %q, want review\", first.Stage)\n118\t\t}\n119\t\t// older_job has tasks.md but no implementation.md → stage implement.\n120\t\tsecond := body.Jobs[1]\n121\t\tif second.Name != \"older_job\" || second.Stage != \"implement\" {\n122\t\t\tt.Errorf(\"older_job row = %+v, want name=older_job stage=implement\", second)\n123\t\t}\n124\t}\n125\t\n126\t// fakeJobProjectInto adds another job dir into an existing project root —\n127\t// the second half of a two-job project (fakeJobProject creates its own root).\n128\tfunc fakeJobProjectInto(t *testing.T, root, name, brief string, extraFiles ...string) string {\n129\t\tt.Helper()\n130\t\tjobDir := filepath.Join(root, \"docs\", \"jobs\", name)\n131\t\tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n132\t\t\tt.Fatal(err)\n133\t\t}\n134\t\tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n135\t\t\tt.Fatal(err)\n136\t\t}\n137\t\tfor _, f := range extraFiles {\n138\t\t\tif err := os.WriteFile(filepath.Join(jobDir, f), []byte(\"content of \"+f+\"\\n\"), 0o644); err != nil {\n139\t\t\t\tt.Fatal(err)\n140\t\t\t}\n141\t\t}\n142\t\treturn root\n143\t}\n144\t\n145\t// TestHandleProjectJobsJDIState: a job with a mg-jdi status sidecar carries\n146\t// its state/agent/updated in the row; one without carries no jdi field.\n147\tfunc TestHandleProjectJobsJDIState(t *testing.T) {\n148\t\troot := fakeJobProject(t, \"driven_job\", minimalBrief(\"Driven\", \"drv\", \"open\", \"feature\", \"2026-08-01\"))\n149\t\n150\t\t// Write a jdi status sidecar for the job (job.WriteJDIStatus).\n151\t\tif err := writeJDIStatusForTest(t, root, \"driven_job\"); err != nil {\n152\t\t\tt.Fatal(err)\n153\t\t}\n154\t\n155\t\treg := &Registry{entries: []Entry{entryFor(root)}}\n156\t\tsrv := New(reg, \"test-version\", \"\", nil)\n157\t\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs\", \"\")\n158\t\tif rec.Code != http.StatusOK {\n159\t\t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n160\t\t}\n161\t\tvar body struct {\n162\t\t\tJobs []jobRow `json:\"jobs\"`\n163\t\t}\n164\t\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n165\t\t\tt.Fatalf(\"body not JSON: %v\", err)\n166\t\t}\n167\t\tif len(body.Jobs) != 1 || body.Jobs[0].JDI == nil {\n168\t\t\tt.Fatalf(\"jdi state missing: %s\", rec.Body.String())\n169\t\t}\n170\t\tif body.Jobs[0].JDI.State != \"stopped:finished\" || body.Jobs[0].JDI.Agent != \"reviewer\" {\n171\t\t\tt.Errorf(\"jdi row = %+v, want the written sidecar state\", body.Jobs[0].JDI)\n172\t\t}\n173\t\tif body.Jobs[0].JDI.Updated == \"\" {\n174\t\t\tt.Errorf(\"jdi row updated = empty, want RFC3339\")\n175\t\t}\n176\t}\n177\t\n178\t// TestHandleProjectJobsNoJDIState: a job mg-jdi never drove has no jdi field\n179\t// in its row.\n180\tfunc TestHandleProjectJobsNoJDIState(t *testing.T) {\n181\t\troot := fakeJobProject(t, \"plain_job\", minimalBrief(\"Plain\", \"pln\", \"open\", \"feature\", \"2026-08-01\"))\n182\t\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n183\t\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs\", \"\")\n184\t\tvar body struct {\n185\t\t\tJobs []jobRow `json:\"jobs\"`\n186\t\t}\n187\t\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n188\t\t\tt.Fatalf(\"body not JSON: %v\", err)\n189\t\t}\n190\t\tif len(body.Jobs) != 1 || body.Jobs[0].JDI != nil {\n191\t\t\tt.Errorf(\"job row = %+v, want nil jdi for an undriven job\", body.Jobs[0])\n192\t\t}\n193\t}\n194\t\n195\t// TestHandleJobFileServesRawMarkdown: a whitelisted file comes back as raw\n196\t// markdown text with the markdown content type.\n197\tfunc TestHandleJobFileServesRawMarkdown(t *testing.T) {\n198\t\troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"), \"tasks.md\")\n199\t\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n200\t\n201\t\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/some_job/files/brief.md\", \"\")\n202\t\tif rec.Code != http.StatusOK {\n203\t\t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n204\t\t}\n205\t\tif ct := rec.Header().Get(\"Content-Type\"); !strings.HasPrefix(ct, \"text/markdown\") {\n206\t\t\tt.Errorf(\"Content-Type = %q, want text/markdown\", ct)\n207\t\t}\n208\t\tif !strings.Contains(rec.Body.String(), \"# Brief: Some\") {\n209\t\t\tt.Errorf(\"body = %q, want the raw brief content\", rec.Body.String())\n210\t\t}\n211\t}\n212\t\n213\t// TestHandleJobFileMissingIs404: a whitelisted file that has not been written\n214\t// yet (e.g. verdict.md before review) is a normal 404, not an error.\n215\tfunc TestHandleJobFileMissingIs404(t *testing.T) {\n216\t\troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"))\n217\t\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n218\t\tif rec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/some_job/files/verdict.md\", \"\"); rec.Code != http.StatusNotFound {\n219\t\t\tt.Errorf(\"missing verdict.md: status = %d, want 404\", rec.Code)\n220\t\t}\n221\t}\n222\t\n223\t// TestHandleJobFileNonWhitelistedIs404: the file whitelist (brief|tasks|\n224\t// implementation|verdict) is airtight — a session.log, an encoded traversal,\n225\t// or any other file under the job dir is never served. (Raw `..` segments in\n226\t// the URL path never even reach the handler — ServeMux's own path\n227\t// sanitization redirects them — so the encoded forms are the ones that must\n228\t// be rejected here.)\n229\tfunc TestHandleJobFileNonWhitelistedIs404(t *testing.T) {\n230\t\troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"), \"session.log\")\n231\t\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n232\t\n233\t\tfor _, file := range []string{\"session.log\", \"run.log\", \"brief\", \"README.md\", \"..%2fbrief.md\", \"..%2f..%2fetc%2fpasswd\", \"%2e%2e%2fbrief.md\", \"brief.md%00\"} {\n234\t\t\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/some_job/files/\"+file, \"\")\n235\t\t\tif rec.Code != http.StatusNotFound {\n236\t\t\t\tt.Errorf(\"file %q: status = %d, want 404\", file, rec.Code)\n237\t\t\t}\n238\t\t}\n239\t\n240\t\t// Raw `..` in the path is redirected by ServeMux's sanitization — still\n241\t\t// never served, never read.\n242\t\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/some_job/files/../brief.md\", \"\")\n243\t\tif rec.Code < 300 || rec.Code >= 400 {\n244\t\t\tt.Errorf(\"raw .. file segment: status = %d, want a 3xx sanitization redirect\", rec.Code)\n245\t\t}\n246\t}\n247\t\n248\t// TestHandleProjectJobsUnknownProjectIs404: an unregistered project segment\n249\t// (and an invalid one) is a 404 — nothing is ever resolved outside the\n250\t// registry. Encoded traversal reaches the handler and is rejected there; raw\n251\t// `..` is redirected by ServeMux's own sanitization first.\n252\tfunc TestHandleProjectJobsUnknownProjectIs404(t *testing.T) {\n253\t\troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"))\n254\t\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n255\t\n256\t\tfor _, seg := range []string{\"no-such-project\", \"%2e%2e\", \"%2e\", \"%2fetc\", \"a%2fb\", \"a%5cb\", \"a%00b\", \"..%2f..%2fetc%2fpasswd\"} {\n257\t\t\trec := get(t, srv, \"/projects/\"+seg+\"/jobs\", \"\")\n258\t\t\tif rec.Code != http.StatusNotFound {\n259\t\t\t\tt.Errorf(\"project segment %q: status = %d, want 404\", seg, rec.Code)\n260\t\t\t}\n261\t\t}\n262\t\n263\t\t// Raw `..` and `.` segments are cleaned to a redirect by ServeMux before\n264\t\t// routing — still never resolved against anything.\n265\t\tfor _, seg := range []string{\"..\", \".\"} {\n266\t\t\trec := get(t, srv, \"/projects/\"+seg+\"/jobs\", \"\")\n267\t\t\tif rec.Code < 300 || rec.Code >= 400 {\n268\t\t\t\tt.Errorf(\"raw project segment %q: status = %d, want a 3xx sanitization redirect\", seg, rec.Code)\n269\t\t\t}\n270\t\t}\n271\t}\n272\t\n273\t// TestHandleJobFileUnknownJobIs404: an unknown job segment (no ID, name or\n274\t// unique prefix match) is a 404.\n275\tfunc TestHandleJobFileUnknownJobIs404(t *testing.T) {\n276\t\troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"))\n277\t\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n278\t\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/no-such-job/files/brief.md\", \"\")\n279\t\tif rec.Code != http.StatusNotFound {\n280\t\t\tt.Errorf(\"status = %d, want 404\", rec.Code)\n281\t\t}\n282\t}\n283\t\n284\t// TestHandleJobResolvesByIDNameAndPrefix: the job segment resolves by ID,\n285\t// then by name, then by unique name prefix.\n286\tfunc TestHandleJobResolvesByIDNameAndPrefix(t *testing.T) {\n287\t\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n288\t\t_ = fakeJobProjectInto(t, root, \"iron_steel\", minimalBrief(\"Steel\", \"irn\", \"open\", \"fix\", \"2026-08-02\"))\n289\t\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n290\t\n291\t\tbase := \"/projects/\" + filepath.Base(root) + \"/jobs/\"\n292\t\tfor _, seg := range []string{\"wod\", \"wood_oak\", \"wood\", \"iron\", \"irn\"} {\n293\t\t\trec := get(t, srv, base+seg+\"/files/brief.md\", \"\")\n294\t\t\tif rec.Code != http.StatusOK {\n295\t\t\t\tt.Errorf(\"job segment %q: status = %d, want 200 (body %s)\", seg, rec.Code, rec.Body.String())\n296\t\t\t}\n297\t\t}\n298\t}\n299\t\n300\t// TestHandleJobAmbiguousPrefixIs409: a job segment matching several job names\n301\t// by prefix is a 409 with the CLI's ambiguity wording.\n302\tfunc TestHandleJobAmbiguousPrefixIs409(t *testing.T) {\n303\t\troot := fakeJobProject(t, \"wood_a\", minimalBrief(\"A\", \"aaa\", \"open\", \"feature\", \"2026-08-01\"))\n304\t\t_ = fakeJobProjectInto(t, root, \"wood_b\", minimalBrief(\"B\", \"bbb\", \"open\", \"feature\", \"2026-08-02\"))\n305\t\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n306\t\n307\t\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/wood/files/brief.md\", \"\")\n308\t\tif rec.Code != http.StatusConflict {\n309\t\t\tt.Errorf(\"status = %d, want 409 (body %s)\", rec.Code, rec.Body.String())\n310\t\t}\n311\t\tif !strings.Contains(rec.Body.String(), \"ambiguous\") {\n312\t\t\tt.Errorf(\"body = %s, want the ambiguity wording\", rec.Body.String())\n313\t\t}\n314\t}\n315\t\n316\t// TestServeShutdownSeam pins the httptest-able serve loop: Serve on a bound\n317\t// listener answers requests until Shutdown drains and returns.\n318\tfunc TestServeShutdownSeam(t *testing.T) {\n319\t\tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n320\t\tln, err := netListen(\"127.0.0.1:0\")\n321\t\tif err != nil {\n322\t\t\tt.Fatal(err)\n323\t\t}\n324\t\tdone := make(chan error, 1)\n325\t\tgo func() { done <- srv.Serve(ln) }()\n326\t\n327\t\t// The server answers on the bound listener.\n328\t\tbase := \"http://\" + ln.Addr().String()\n329\t\tresp, err := httpGet(base + \"/projects\")\n330\t\tif err != nil {\n331\t\t\tt.Fatalf(\"GET before shutdown: %v\", err)\n332\t\t}\n333\t\tresp.Body.Close()\n334\t\tif resp.StatusCode != http.StatusOK {\n335\t\t\tt.Errorf(\"status = %d, want 200\", resp.StatusCode)\n336\t\t}\n337\t\n338\t\t// Shutdown drains and the serve loop returns http.ErrServerClosed.\n339\t\tif err := srv.Shutdown(t.Context()); err != nil {\n340\t\t\tt.Fatalf(\"Shutdown: %v\", err)\n341\t\t}\n342\t\tif err := <-done; err != nil && err != http.ErrServerClosed {\n343\t\t\tt.Errorf(\"Serve returned %v, want ErrServerClosed\", err)\n344\t\t}\n345\t}\n346\t\n347\t// --- TASK-4: jdi / diff / agents endpoints ----------------------------------\n348\t\n349\t// TestHandleJobJDIStatusAndLogs: the jdi endpoint serves the mg-jdi status\n350\t// sidecar, the run.log tail, and the job's session.log tail.\n351\tfunc TestHandleJobJDIStatusAndLogs(t *testing.T) {\n352\t\troot := fakeJobProject(t, \"driven_job\", minimalBrief(\"Driven\", \"drv\", \"open\", \"feature\", \"2026-08-01\"))\n353\t\tif err := writeJDIStatusForTest(t, root, \"driven_job\"); err != nil {\n354\t\t\tt.Fatal(err)\n355\t\t}\n356\t\t// run.log under .manigot/jdi-status/<name>/.\n357\t\tlogDir := job.JDIStatusDir(root, \"driven_job\")\n358\t\tif err := os.MkdirAll(logDir, 0o755); err != nil {\n359\t\t\tt.Fatal(err)\n360\t\t}\n361\t\tif err := os.WriteFile(job.JDIRunLogPath(root, \"driven_job\"), []byte(\"run log line\\n\"), 0o644); err != nil {\n362\t\t\tt.Fatal(err)\n363\t\t}\n364\t\t// session.log in the job's own dir.\n365\t\tif err := os.WriteFile(filepath.Join(root, \"docs\", \"jobs\", \"driven_job\", \"session.log\"), []byte(\"session log line\\n\"), 0o644); err != nil {\n366\t\t\tt.Fatal(err)\n367\t\t}\n368\t\n369\t\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n370\t\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/driven_job/jdi\", \"\")\n371\t\tif rec.Code != http.StatusOK {\n372\t\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n373\t\t}\n374\t\tvar body jobJDIResponse\n375\t\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n376\t\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n377\t\t}\n378\t\tif body.Status == nil || body.Status.State != \"stopped:finished\" || body.Status.Agent != \"reviewer\" {\n379\t\t\tt.Errorf(\"status = %+v, want the written sidecar\", body.Status)\n380\t\t}\n381\t\tif body.RunLog == nil || !strings.Contains(*body.RunLog, \"run log line\") {\n382\t\t\tt.Errorf(\"runLog = %v, want the run.log tail\", body.RunLog)\n383\t\t}\n384\t\tif body.SessionLog == nil || !strings.Contains(*body.SessionLog, \"session log line\") {\n385\t\t\tt.Errorf(\"sessionLog = %v, want the session.log tail\", body.SessionLog)\n386\t\t}\n387\t}\n388\t\n389\t// TestHandleJobJDIUndrivenJobIsNulls: a job mg-jdi never drove returns nulls\n390\t// (no status, no run.log, no session.log) — a normal \"no run yet\", not an\n391\t// error.\n392\tfunc TestHandleJobJDIUndrivenJobIsNulls(t *testing.T) {\n393\t\troot := fakeJobProject(t, \"plain_job\", minimalBrief(\"Plain\", \"pln\", \"open\", \"feature\", \"2026-08-01\"))\n394\t\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n395\t\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/plain_job/jdi\", \"\")\n396\t\tif rec.Code != http.StatusOK {\n397\t\t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n398\t\t}\n399\t\tvar body jobJDIResponse\n400\t\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n401\t\t\tt.Fatalf(\"body not JSON: %v\", err)\n402\t\t}\n403\t\tif body.Status != nil || body.RunLog != nil || body.SessionLog != nil {\n404\t\t\tt.Errorf(\"undriven job = %+v, want all-null fields\", body)\n405\t\t}\n406\t}\n407\t\n408\t// TestHandleJobJDIEmptyLogsPresent: an existing-but-empty run.log is \"there is\n409\t// a run happening, nothing logged yet\" — an empty string, not null.\n410\tfunc TestHandleJobJDIEmptyLogsPresent(t *testing.T) {\n411\t\troot := fakeJobProject(t, \"driven_job\", minimalBrief(\"Driven\", \"drv\", \"open\", \"feature\", \"2026-08-01\"))\n412\t\tif err := writeJDIStatusForTest(t, root, \"driven_job\"); err != nil {\n413\t\t\tt.Fatal(err)\n414\t\t}\n415\t\tlogDir := job.JDIStatusDir(root, \"driven_job\")\n416\t\tif err := os.MkdirAll(logDir, 0o755); err != nil {\n417\t\t\tt.Fatal(err)\n418\t\t}\n419\t\tif err := os.WriteFile(job.JDIRunLogPath(root, \"driven_job\"), nil, 0o644); err != nil {\n420\t\t\tt.Fatal(err)\n421\t\t}\n422\t\n423\t\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n424\t\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/driven_job/jdi\", \"\")\n425\t\tvar body jobJDIResponse\n426\t\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n427\t\t\tt.Fatalf(\"body not JSON: %v\", err)\n428\t\t}\n429\t\tif body.RunLog == nil || *body.RunLog != \"\" {\n430\t\t\tt.Errorf(\"runLog = %v, want an empty present string\", body.RunLog)\n431\t\t}\n432\t}\n433\t\n434\t// TestHandleJobJDIAllMissingStatusNoJDI — the jdi endpoint's job resolution is\n435\t// the same choke point: an unknown job is a 404.\n436\tfunc TestHandleJobJDIUnknownJobIs404(t *testing.T) {\n437\t\troot := fakeJobProject(t, \"plain_job\", minimalBrief(\"Plain\", \"pln\", \"open\", \"feature\", \"2026-08-01\"))\n438\t\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n439\t\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/nope/jdi\", \"\")\n440\t\tif rec.Code != http.StatusNotFound {\n441\t\t\tt.Errorf(\"status = %d, want 404\", rec.Code)\n442\t\t}\n443\t}\n444\t\n445\t// TestHandleJobDiffQuickEyeball: the diff endpoint returns the quick eyeball\n446\t// (log + stat) for the resolved job branch against the base branch — the same\n447\t// two calls mg diff makes. Needs a real git repo (PATH restricted to real\n448\t// git, since the session shim refuses git init).\n449\tfunc TestHandleJobDiffQuickEyeball(t *testing.T) {\n450\t\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n451\t\tdir := initGitRepo(t)\n452\t\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n453\t\tif err := os.WriteFile(filepath.Join(dir, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n454\t\t\tt.Fatal(err)\n455\t\t}\n456\t\trunGitT(t, dir, \"add\", \"feature.txt\")\n457\t\trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"add the feature\")\n458\t\trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n459\t\n460\t\tsrv := New(&Registry{entries: []Entry{entryFor(dir)}}, \"test-version\", \"\", nil)\n461\t\trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/wood_test/diff\", \"\")\n462\t\tif rec.Code != http.StatusOK {\n463\t\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n464\t\t}\n465\t\tvar body jobDiffResponse\n466\t\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n467\t\t\tt.Fatalf(\"body not JSON: %v\", err)\n468\t\t}\n469\t\tif body.Log == nil || !strings.Contains(*body.Log, \"add the feature\") {\n470\t\t\tt.Errorf(\"log = %v, want the branch's commit\", body.Log)\n471\t\t}\n472\t\tif body.Stat == nil || !strings.Contains(*body.Stat, \"feature.txt\") {\n473\t\t\tt.Errorf(\"stat = %v, want the changed file\", body.Stat)\n474\t\t}\n475\t\tif body.Patch != nil {\n476\t\t\tt.Errorf(\"patch = %v, want nil for the quick eyeball\", body.Patch)\n477\t\t}\n478\t}\n479\t\n480\t// TestHandleJobDiffFullPatch: ?full=1 returns the complete patch.\n481\tfunc TestHandleJobDiffFullPatch(t *testing.T) {\n482\t\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n483\t\tdir := initGitRepo(t)\n484\t\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n485\t\tif err := os.WriteFile(filepath.Join(dir, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n486\t\t\tt.Fatal(err)\n487\t\t}\n488\t\trunGitT(t, dir, \"add\", \"feature.txt\")\n489\t\trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"add the feature\")\n490\t\trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n491\t\n492\t\tsrv := New(&Registry{entries: []Entry{entryFor(dir)}}, \"test-version\", \"\", nil)\n493\t\trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/wood_test/diff?full=1\", \"\")\n494\t\tif rec.Code != http.StatusOK {\n495\t\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n496\t\t}\n497\t\tvar body jobDiffResponse\n498\t\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n499\t\t\tt.Fatalf(\"body not JSON: %v\", err)\n500\t\t}\n501\t\tif body.Patch == nil || !strings.Contains(*body.Patch, \"+feature\") {\n502\t\t\tt.Errorf(\"patch = %v, want the full patch\", body.Patch)\n503\t\t}\n504\t\tif body.Log != nil || body.Stat != nil {\n505\t\t\tt.Errorf(\"log/stat = %v/%v, want nil for ?full=1\", body.Log, body.Stat)\n506\t\t}\n507\t}\n508\t\n509\t// TestHandleJobDiffResolvesBaseBranchFromConfig: the base branch comes from\n510\t// the project's configured baseBranch (project.Load), exactly as mg diff\n511\t// resolves it — proven by a repo where main and the configured base differ,\n512\t// so the wrong base would show an extra commit.\n513\tfunc TestHandleJobDiffResolvesBaseBranchFromConfig(t *testing.T) {\n514\t\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n515\t\tdir := initGitRepo(t)\n516\t\t// trunk = main + one extra commit; baseBranch is configured to trunk.\n517\t\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"trunk\")\n518\t\tif err := os.WriteFile(filepath.Join(dir, \"trunk.txt\"), []byte(\"trunk\\n\"), 0o644); err != nil {\n519\t\t\tt.Fatal(err)\n520\t\t}\n521\t\trunGitT(t, dir, \"add\", \"trunk.txt\")\n522\t\trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"trunk work\")\n523\t\t// The job branch is cut from trunk and adds one commit of its own.\n524\t\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n525\t\tif err := os.WriteFile(filepath.Join(dir, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n526\t\t\tt.Fatal(err)\n527\t\t}\n528\t\trunGitT(t, dir, \"add\", \"feature.txt\")\n529\t\trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"job work\")\n530\t\trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n531\t\t// Configure baseBranch=trunk.\n532\t\tif err := os.MkdirAll(filepath.Join(dir, \".manigot\"), 0o755); err != nil {\n533\t\t\tt.Fatal(err)\n534\t\t}\n535\t\tif err := os.WriteFile(filepath.Join(dir, \".manigot\", \"manigot.json\"), []byte(`{\"baseBranch\": \"trunk\"}`), 0o644); err != nil {\n536\t\t\tt.Fatal(err)\n537\t\t}\n538\t\n539\t\tsrv := New(&Registry{entries: []Entry{entryFor(dir)}}, \"test-version\", \"\", nil)\n540\t\trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/wood_test/diff\", \"\")\n541\t\tif rec.Code != http.StatusOK {\n542\t\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n543\t\t}\n544\t\tvar body jobDiffResponse\n545\t\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n546\t\t\tt.Fatalf(\"body not JSON: %v\", err)\n547\t\t}\n548\t\t// Only the job's own commit — had the base fallen back to main, the\n549\t\t// trunk commit would appear too.\n550\t\tif body.Log == nil || strings.Contains(*body.Log, \"trunk work\") || !strings.Contains(*body.Log, \"job work\") {\n551\t\t\tt.Errorf(\"log = %v, want only the job's commit against base trunk\", body.Log)\n552\t\t}\n553\t}\n554\t\n555\t// TestHandleJobDiffUnknownJobIs404: an unresolvable job segment is a 404 with\n556\t// the CLI's not-found wording.\n557\tfunc TestHandleJobDiffUnknownJobIs404(t *testing.T) {\n558\t\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n559\t\tdir := initGitRepo(t)\n560\t\tsrv := New(&Registry{entries: []Entry{entryFor(dir)}}, \"test-version\", \"\", nil)\n561\t\trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/nope/diff\", \"\")\n562\t\tif rec.Code != http.StatusNotFound {\n563\t\t\tt.Errorf(\"status = %d, want 404 (body %s)\", rec.Code, rec.Body.String())\n564\t\t}\n565\t\tif !strings.Contains(rec.Body.String(), \"not found among local branches\") {\n566\t\t\tt.Errorf(\"body = %s, want the CLI's not-found wording\", rec.Body.String())\n567\t\t}\n568\t}\n569\t\n570\t// TestHandleJobDiffAmbiguousIs409: a job segment matching several branches by\n571\t// prefix is a 409 with the CLI's ambiguity wording.\n572\tfunc TestHandleJobDiffAmbiguousIs409(t *testing.T) {\n573\t\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n574\t\tdir := initGitRepo(t)\n575\t\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_a\")\n576\t\trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n577\t\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_b\")\n578\t\trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n579\t\n580\t\tsrv := New(&Registry{entries: []Entry{entryFor(dir)}}, \"test-version\", \"\", nil)\n581\t\trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/wood/diff\", \"\")\n582\t\tif rec.Code != http.StatusConflict {\n583\t\t\tt.Errorf(\"status = %d, want 409 (body %s)\", rec.Code, rec.Body.String())\n584\t\t}\n585\t\tif !strings.Contains(rec.Body.String(), \"ambiguous\") {\n586\t\t\tt.Errorf(\"body = %s, want the CLI's ambiguity wording\", rec.Body.String())\n587\t\t}\n588\t}\n589\t\n590\t// TestHandleProjectAgentsNameAndDescription: the agents endpoint lists name +\n591\t// description only, from the same agentlist.Discover the mg agents picker\n592\t// uses.\n593\tfunc TestHandleProjectAgentsNameAndDescription(t *testing.T) {\n594\t\tfakeCheckout(t, map[string]string{\n595\t\t\t\"analyst\":  \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n596\t\t\t\"reviewer\": \"name: reviewer\\ndescription: Reviews changes.\\n\",\n597\t\t})\n598\t\troot := t.TempDir() // no docs/ needed — agents are global\n599\t\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n600\t\n601\t\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/agents\", \"\")\n602\t\tif rec.Code != http.StatusOK {\n603\t\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n604\t\t}\n605\t\tvar body agentsResponse\n606\t\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n607\t\t\tt.Fatalf(\"body not JSON: %v\", err)\n608\t\t}\n609\t\tif len(body.Agents) != 2 {\n610\t\t\tt.Fatalf(\"agents = %d, want 2:\\n%s\", len(body.Agents), rec.Body.String())\n611\t\t}\n612\t\t// Sorted by name: analyst first.\n613\t\tif body.Agents[0].Name != \"analyst\" || !strings.Contains(body.Agents[0].Description, \"tasks\") {\n614\t\t\tt.Errorf(\"agent[0] = %+v, want analyst with its description\", body.Agents[0])\n615\t\t}\n616\t\tif body.Agents[1].Name != \"reviewer\" {\n617\t\t\tt.Errorf(\"agent[1] = %+v, want reviewer\", body.Agents[1])\n618\t\t}\n619\t\t// No full agent-file contents leak into the response.\n620\t\tif strings.Contains(rec.Body.String(), \"name: analyst\") {\n621\t\t\tt.Errorf(\"response leaks the raw agent file: %s\", rec.Body.String())\n622\t\t}\n623\t}\n624\t\n625\t// --- TASK-5: /health ---------------------------------------------------------\n626\t\n627\t// TestHandleHealthReportsVersionImageAndProfiles: /health reports the version,\n628\t// docker image presence, and per-profile readiness — identifiers and booleans\n629\t// only, never credential values. The docker presence and readiness booleans\n630\t// depend on the machine the test runs on (session.ImagePresent degrades to\n631\t// false when docker is missing; profile readiness is an env read), so the\n632\t// shape — every profile present, every field present — is what is pinned.\n633\tfunc TestHandleHealthReportsVersionImageAndProfiles(t *testing.T) {\n634\t\tsrv := New(&Registry{}, \"1.2.3-test\", \"\", nil)\n635\t\trec := get(t, srv, \"/health\", \"\")\n636\t\tif rec.Code != http.StatusOK {\n637\t\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n638\t\t}\n639\t\tvar body healthResponse\n640\t\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n641\t\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n642\t\t}\n643\t\tif body.Version != \"1.2.3-test\" {\n644\t\t\tt.Errorf(\"version = %q, want the version passed into New\", body.Version)\n645\t\t}\n646\t\t// imagePresent must be a real boolean (present in the JSON), whatever its\n647\t\t// value on this machine.\n648\t\tvar raw map[string]json.RawMessage\n649\t\tif err := json.Unmarshal(rec.Body.Bytes(), &raw); err != nil {\n650\t\t\tt.Fatal(err)\n651\t\t}\n652\t\tif _, ok := raw[\"imagePresent\"]; !ok {\n653\t\t\tt.Errorf(\"imagePresent missing from /health: %s\", rec.Body.String())\n654\t\t}\n655\t\n656\t\tif len(body.Profiles) != 5 {\n657\t\t\tt.Fatalf(\"profiles = %d, want 5 (claude-pro, zai, opencode-go, opencode-zen, opencode-zen-free):\\n%s\",\n658\t\t\t\tlen(body.Profiles), rec.Body.String())\n659\t\t}\n660\t\tseen := map[string]bool{}\n661\t\tfor _, p := range body.Profiles {\n662\t\t\tif p.ID == \"\" {\n663\t\t\t\tt.Errorf(\"profile row with empty id: %+v\", p)\n664\t\t\t}\n665\t\t\tseen[p.ID] = true\n666\t\t}\n667\t\tfor _, id := range []string{\"claude-pro\", \"zai\", \"opencode-go\", \"opencode-zen\", \"opencode-zen-free\"} {\n668\t\t\tif !seen[id] {\n669\t\t\t\tt.Errorf(\"profile %q missing from /health\", id)\n670\t\t\t}\n671\t\t}\n672\t}\n673\t\n674\t// TestHandleHealthRequiresAuth: /health is inside the same auth boundary as\n675\t// every other endpoint — with a token configured, it is a 401 without one.\n676\tfunc TestHandleHealthRequiresAuth(t *testing.T) {\n677\t\tsrv := New(&Registry{}, \"1.2.3-test\", \"sekrit-token\", nil)\n678\t\tif rec := get(t, srv, \"/health\", \"\"); rec.Code != http.StatusUnauthorized {\n679\t\t\tt.Errorf(\"no token: status = %d, want 401\", rec.Code)\n680\t\t}\n681\t\tif rec := get(t, srv, \"/health\", \"Bearer sekrit-token\"); rec.Code != http.StatusOK {\n682\t\t\tt.Errorf(\"with token: status = %d, want 200\", rec.Code)\n683\t\t}\n684\t}\n685\t"}]},"parent_tool_use_id":null,"session_id":"ba948ea7-a157-4c42-8eb1-077540d9946d","uuid":"229561ef-66eb-4e18-a1b6-332cff9cb1c1","timestamp":"2026-08-28T20:27:54.034Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/serve/api_test.go","content":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// fakeJobProject creates a project root at a temp dir with a job dir\n// docs/jobs/<name>/ carrying a brief.md with the given content, plus the\n// named extra files (each written with a one-line body). Returns the root.\nfunc fakeJobProject(t *testing.T, name, brief string, extraFiles ...string) string {\n\tt.Helper()\n\troot := t.TempDir()\n\tjobDir := filepath.Join(root, \"docs\", \"jobs\", name)\n\tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, f := range extraFiles {\n\t\tif err := os.WriteFile(filepath.Join(jobDir, f), []byte(\"content of \"+f+\"\\n\"), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\treturn root\n}\n\n// minimalBrief returns a brief.md body with the given frontmatter fields.\nfunc minimalBrief(title, id, status, typ, date string) string {\n\treturn \"# Brief: \" + title + \"\\n\\n\" +\n\t\t\"status: \" + status + \"\\n\" +\n\t\t\"type: \" + typ + \"\\n\" +\n\t\t\"id: \" + id + \"\\n\" +\n\t\t\"date: \" + date + \"\\n\" +\n\t\t\"author: Test\\n\\n## What\\n\\nA test job.\\n\"\n}\n\n// TestHandleProjectsListsRegisteredRoots: /projects returns the registry data\n// — each root's absolute path and base name — and nothing else.\nfunc TestHandleProjectsListsRegisteredRoots(t *testing.T) {\n\troot := t.TempDir()\n\treg := &Registry{entries: []Entry{entryFor(root)}}\n\tsrv := New(reg, \"test-version\", \"\", nil)\n\n\trec := get(t, srv, \"/projects\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n\t}\n\tvar body struct {\n\t\tProjects []projectRow `json:\"projects\"`\n\t}\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif len(body.Projects) != 1 {\n\t\tt.Fatalf(\"projects = %v, want 1\", body.Projects)\n\t}\n\tif body.Projects[0].Path != filepath.Clean(root) || body.Projects[0].Name != filepath.Base(root) {\n\t\tt.Errorf(\"project row = %+v, want path=%s name=%s\", body.Projects[0], filepath.Clean(root), filepath.Base(root))\n\t}\n}\n\n// TestHandleProjectsEmptyRegistry: an empty registry lists no projects — a\n// valid, normal response.\nfunc TestHandleProjectsEmptyRegistry(t *testing.T) {\n\tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n\t}\n\tif !strings.Contains(rec.Body.String(), `\"projects\":[]`) {\n\t\tt.Errorf(\"body = %s, want an empty projects list\", rec.Body.String())\n\t}\n}\n\n// TestHandleProjectJobsInfoDesign: one row per job in Discover's sort order\n// (date descending), carrying the TUI's info-design fields: id / status /\n// stage / type / date / title.\nfunc TestHandleProjectJobsInfoDesign(t *testing.T) {\n\troot := fakeJobProject(t, \"older_job\", minimalBrief(\"Older\", \"old\", \"open\", \"feature\", \"2026-08-01\"), \"tasks.md\")\n\t_ = fakeJobProjectInto(t, root, \"newer_job\", minimalBrief(\"Newer\", \"new\", \"open\", \"fix\", \"2026-08-10\"), \"tasks.md\", \"implementation.md\")\n\n\treg := &Registry{entries: []Entry{entryFor(root)}}\n\tsrv := New(reg, \"test-version\", \"\", nil)\n\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body struct {\n\t\tJobs []jobRow `json:\"jobs\"`\n\t}\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif len(body.Jobs) != 2 {\n\t\tt.Fatalf(\"jobs = %d, want 2:\\n%s\", len(body.Jobs), rec.Body.String())\n\t}\n\n\t// Newest first: \"newer_job\" (2026-08-10) before \"older_job\" (2026-08-01).\n\tfirst := body.Jobs[0]\n\tif first.Name != \"newer_job\" {\n\t\tt.Errorf(\"first job = %q, want newer_job (date-sorted)\", first.Name)\n\t}\n\tif first.ID != \"new\" || first.Status != \"open\" || first.Type != \"fix\" || first.Date != \"2026-08-10\" || first.Title != \"Newer\" {\n\t\tt.Errorf(\"newer_job row = %+v, want the brief's frontmatter fields\", first)\n\t}\n\t// newer_job has implementation.md but no verdict → stage review.\n\tif first.Stage != \"review\" {\n\t\tt.Errorf(\"newer_job stage = %q, want review\", first.Stage)\n\t}\n\t// older_job has tasks.md but no implementation.md → stage implement.\n\tsecond := body.Jobs[1]\n\tif second.Name != \"older_job\" || second.Stage != \"implement\" {\n\t\tt.Errorf(\"older_job row = %+v, want name=older_job stage=implement\", second)\n\t}\n}\n\n// fakeJobProjectInto adds another job dir into an existing project root —\n// the second half of a two-job project (fakeJobProject creates its own root).\nfunc fakeJobProjectInto(t *testing.T, root, name, brief string, extraFiles ...string) string {\n\tt.Helper()\n\tjobDir := filepath.Join(root, \"docs\", \"jobs\", name)\n\tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(jobDir, \"brief.md\"), []byte(brief), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, f := range extraFiles {\n\t\tif err := os.WriteFile(filepath.Join(jobDir, f), []byte(\"content of \"+f+\"\\n\"), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\treturn root\n}\n\n// TestHandleProjectJobsJDIState: a job with a mg-jdi status sidecar carries\n// its state/agent/updated in the row; one without carries no jdi field.\nfunc TestHandleProjectJobsJDIState(t *testing.T) {\n\troot := fakeJobProject(t, \"driven_job\", minimalBrief(\"Driven\", \"drv\", \"open\", \"feature\", \"2026-08-01\"))\n\n\t// Write a jdi status sidecar for the job (job.WriteJDIStatus).\n\tif err := writeJDIStatusForTest(t, root, \"driven_job\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\treg := &Registry{entries: []Entry{entryFor(root)}}\n\tsrv := New(reg, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n\t}\n\tvar body struct {\n\t\tJobs []jobRow `json:\"jobs\"`\n\t}\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif len(body.Jobs) != 1 || body.Jobs[0].JDI == nil {\n\t\tt.Fatalf(\"jdi state missing: %s\", rec.Body.String())\n\t}\n\tif body.Jobs[0].JDI.State != \"stopped:finished\" || body.Jobs[0].JDI.Agent != \"reviewer\" {\n\t\tt.Errorf(\"jdi row = %+v, want the written sidecar state\", body.Jobs[0].JDI)\n\t}\n\tif body.Jobs[0].JDI.Updated == \"\" {\n\t\tt.Errorf(\"jdi row updated = empty, want RFC3339\")\n\t}\n}\n\n// TestHandleProjectJobsNoJDIState: a job mg-jdi never drove has no jdi field\n// in its row.\nfunc TestHandleProjectJobsNoJDIState(t *testing.T) {\n\troot := fakeJobProject(t, \"plain_job\", minimalBrief(\"Plain\", \"pln\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs\", \"\")\n\tvar body struct {\n\t\tJobs []jobRow `json:\"jobs\"`\n\t}\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif len(body.Jobs) != 1 || body.Jobs[0].JDI != nil {\n\t\tt.Errorf(\"job row = %+v, want nil jdi for an undriven job\", body.Jobs[0])\n\t}\n}\n\n// TestHandleJobFileServesRawMarkdown: a whitelisted file comes back as raw\n// markdown text with the markdown content type.\nfunc TestHandleJobFileServesRawMarkdown(t *testing.T) {\n\troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"), \"tasks.md\")\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/some_job/files/brief.md\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n\t}\n\tif ct := rec.Header().Get(\"Content-Type\"); !strings.HasPrefix(ct, \"text/markdown\") {\n\t\tt.Errorf(\"Content-Type = %q, want text/markdown\", ct)\n\t}\n\tif !strings.Contains(rec.Body.String(), \"# Brief: Some\") {\n\t\tt.Errorf(\"body = %q, want the raw brief content\", rec.Body.String())\n\t}\n}\n\n// TestHandleJobFileMissingIs404: a whitelisted file that has not been written\n// yet (e.g. verdict.md before review) is a normal 404, not an error.\nfunc TestHandleJobFileMissingIs404(t *testing.T) {\n\troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tif rec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/some_job/files/verdict.md\", \"\"); rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"missing verdict.md: status = %d, want 404\", rec.Code)\n\t}\n}\n\n// TestHandleJobFileNonWhitelistedIs404: the file whitelist (brief|tasks|\n// implementation|verdict) is airtight — a session.log, an encoded traversal,\n// or any other file under the job dir is never served. (Raw `..` segments in\n// the URL path never even reach the handler — ServeMux's own path\n// sanitization redirects them — so the encoded forms are the ones that must\n// be rejected here.)\nfunc TestHandleJobFileNonWhitelistedIs404(t *testing.T) {\n\troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"), \"session.log\")\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\n\tfor _, file := range []string{\"session.log\", \"run.log\", \"brief\", \"README.md\", \"..%2fbrief.md\", \"..%2f..%2fetc%2fpasswd\", \"%2e%2e%2fbrief.md\", \"brief.md%00\"} {\n\t\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/some_job/files/\"+file, \"\")\n\t\tif rec.Code != http.StatusNotFound {\n\t\t\tt.Errorf(\"file %q: status = %d, want 404\", file, rec.Code)\n\t\t}\n\t}\n\n\t// Raw `..` in the path is redirected by ServeMux's sanitization — still\n\t// never served, never read.\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/some_job/files/../brief.md\", \"\")\n\tif rec.Code < 300 || rec.Code >= 400 {\n\t\tt.Errorf(\"raw .. file segment: status = %d, want a 3xx sanitization redirect\", rec.Code)\n\t}\n}\n\n// TestHandleProjectJobsUnknownProjectIs404: an unregistered project segment\n// (and an invalid one) is a 404 — nothing is ever resolved outside the\n// registry. Encoded traversal reaches the handler and is rejected there; raw\n// `..` is redirected by ServeMux's own sanitization first.\nfunc TestHandleProjectJobsUnknownProjectIs404(t *testing.T) {\n\troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\n\tfor _, seg := range []string{\"no-such-project\", \"%2e%2e\", \"%2e\", \"%2fetc\", \"a%2fb\", \"a%5cb\", \"a%00b\", \"..%2f..%2fetc%2fpasswd\"} {\n\t\trec := get(t, srv, \"/projects/\"+seg+\"/jobs\", \"\")\n\t\tif rec.Code != http.StatusNotFound {\n\t\t\tt.Errorf(\"project segment %q: status = %d, want 404\", seg, rec.Code)\n\t\t}\n\t}\n\n\t// Raw `..` and `.` segments are cleaned to a redirect by ServeMux before\n\t// routing — still never resolved against anything.\n\tfor _, seg := range []string{\"..\", \".\"} {\n\t\trec := get(t, srv, \"/projects/\"+seg+\"/jobs\", \"\")\n\t\tif rec.Code < 300 || rec.Code >= 400 {\n\t\t\tt.Errorf(\"raw project segment %q: status = %d, want a 3xx sanitization redirect\", seg, rec.Code)\n\t\t}\n\t}\n}\n\n// TestHandleJobFileUnknownJobIs404: an unknown job segment (no ID, name or\n// unique prefix match) is a 404.\nfunc TestHandleJobFileUnknownJobIs404(t *testing.T) {\n\troot := fakeJobProject(t, \"some_job\", minimalBrief(\"Some\", \"som\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/no-such-job/files/brief.md\", \"\")\n\tif rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"status = %d, want 404\", rec.Code)\n\t}\n}\n\n// TestHandleJobResolvesByIDNameAndPrefix: the job segment resolves by ID,\n// then by name, then by unique name prefix.\nfunc TestHandleJobResolvesByIDNameAndPrefix(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\t_ = fakeJobProjectInto(t, root, \"iron_steel\", minimalBrief(\"Steel\", \"irn\", \"open\", \"fix\", \"2026-08-02\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\n\tbase := \"/projects/\" + filepath.Base(root) + \"/jobs/\"\n\tfor _, seg := range []string{\"wod\", \"wood_oak\", \"wood\", \"iron\", \"irn\"} {\n\t\trec := get(t, srv, base+seg+\"/files/brief.md\", \"\")\n\t\tif rec.Code != http.StatusOK {\n\t\t\tt.Errorf(\"job segment %q: status = %d, want 200 (body %s)\", seg, rec.Code, rec.Body.String())\n\t\t}\n\t}\n}\n\n// TestHandleJobAmbiguousPrefixIs409: a job segment matching several job names\n// by prefix is a 409 with the CLI's ambiguity wording.\nfunc TestHandleJobAmbiguousPrefixIs409(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_a\", minimalBrief(\"A\", \"aaa\", \"open\", \"feature\", \"2026-08-01\"))\n\t_ = fakeJobProjectInto(t, root, \"wood_b\", minimalBrief(\"B\", \"bbb\", \"open\", \"feature\", \"2026-08-02\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/wood/files/brief.md\", \"\")\n\tif rec.Code != http.StatusConflict {\n\t\tt.Errorf(\"status = %d, want 409 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif !strings.Contains(rec.Body.String(), \"ambiguous\") {\n\t\tt.Errorf(\"body = %s, want the ambiguity wording\", rec.Body.String())\n\t}\n}\n\n// TestServeShutdownSeam pins the httptest-able serve loop: Serve on a bound\n// listener answers requests until Shutdown drains and returns.\nfunc TestServeShutdownSeam(t *testing.T) {\n\tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n\tln, err := netListen(\"127.0.0.1:0\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdone := make(chan error, 1)\n\tgo func() { done <- srv.Serve(ln) }()\n\n\t// The server answers on the bound listener.\n\tbase := \"http://\" + ln.Addr().String()\n\tresp, err := httpGet(base + \"/projects\")\n\tif err != nil {\n\t\tt.Fatalf(\"GET before shutdown: %v\", err)\n\t}\n\tresp.Body.Close()\n\tif resp.StatusCode != http.StatusOK {\n\t\tt.Errorf(\"status = %d, want 200\", resp.StatusCode)\n\t}\n\n\t// Shutdown drains and the serve loop returns http.ErrServerClosed.\n\tif err := srv.Shutdown(t.Context()); err != nil {\n\t\tt.Fatalf(\"Shutdown: %v\", err)\n\t}\n\tif err := <-done; err != nil && err != http.ErrServerClosed {\n\t\tt.Errorf(\"Serve returned %v, want ErrServerClosed\", err)\n\t}\n}\n\n// --- TASK-4: jdi / diff / agents endpoints ----------------------------------\n\n// TestHandleJobJDIStatusAndLogs: the jdi endpoint serves the mg-jdi status\n// sidecar, the run.log tail, and the job's session.log tail.\nfunc TestHandleJobJDIStatusAndLogs(t *testing.T) {\n\troot := fakeJobProject(t, \"driven_job\", minimalBrief(\"Driven\", \"drv\", \"open\", \"feature\", \"2026-08-01\"))\n\tif err := writeJDIStatusForTest(t, root, \"driven_job\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// run.log under .manigot/jdi-status/<name>/.\n\tlogDir := job.JDIStatusDir(root, \"driven_job\")\n\tif err := os.MkdirAll(logDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(job.JDIRunLogPath(root, \"driven_job\"), []byte(\"run log line\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// session.log in the job's own dir.\n\tif err := os.WriteFile(filepath.Join(root, \"docs\", \"jobs\", \"driven_job\", \"session.log\"), []byte(\"session log line\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/driven_job/jdi\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body jobJDIResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif body.Status == nil || body.Status.State != \"stopped:finished\" || body.Status.Agent != \"reviewer\" {\n\t\tt.Errorf(\"status = %+v, want the written sidecar\", body.Status)\n\t}\n\tif body.RunLog == nil || !strings.Contains(*body.RunLog, \"run log line\") {\n\t\tt.Errorf(\"runLog = %v, want the run.log tail\", body.RunLog)\n\t}\n\tif body.SessionLog == nil || !strings.Contains(*body.SessionLog, \"session log line\") {\n\t\tt.Errorf(\"sessionLog = %v, want the session.log tail\", body.SessionLog)\n\t}\n}\n\n// TestHandleJobJDIUndrivenJobIsNulls: a job mg-jdi never drove returns nulls\n// (no status, no run.log, no session.log) — a normal \"no run yet\", not an\n// error.\nfunc TestHandleJobJDIUndrivenJobIsNulls(t *testing.T) {\n\troot := fakeJobProject(t, \"plain_job\", minimalBrief(\"Plain\", \"pln\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/plain_job/jdi\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200\", rec.Code)\n\t}\n\tvar body jobJDIResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif body.Status != nil || body.RunLog != nil || body.SessionLog != nil {\n\t\tt.Errorf(\"undriven job = %+v, want all-null fields\", body)\n\t}\n}\n\n// TestHandleJobJDIEmptyLogsPresent: an existing-but-empty run.log is \"there is\n// a run happening, nothing logged yet\" — an empty string, not null.\nfunc TestHandleJobJDIEmptyLogsPresent(t *testing.T) {\n\troot := fakeJobProject(t, \"driven_job\", minimalBrief(\"Driven\", \"drv\", \"open\", \"feature\", \"2026-08-01\"))\n\tif err := writeJDIStatusForTest(t, root, \"driven_job\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tlogDir := job.JDIStatusDir(root, \"driven_job\")\n\tif err := os.MkdirAll(logDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(job.JDIRunLogPath(root, \"driven_job\"), nil, 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/driven_job/jdi\", \"\")\n\tvar body jobJDIResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif body.RunLog == nil || *body.RunLog != \"\" {\n\t\tt.Errorf(\"runLog = %v, want an empty present string\", body.RunLog)\n\t}\n}\n\n// TestHandleJobJDIAllMissingStatusNoJDI — the jdi endpoint's job resolution is\n// the same choke point: an unknown job is a 404.\nfunc TestHandleJobJDIUnknownJobIs404(t *testing.T) {\n\troot := fakeJobProject(t, \"plain_job\", minimalBrief(\"Plain\", \"pln\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/nope/jdi\", \"\")\n\tif rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"status = %d, want 404\", rec.Code)\n\t}\n}\n\n// TestHandleJobDiffQuickEyeball: the diff endpoint returns the quick eyeball\n// (log + stat) for the resolved job branch against the base branch — the same\n// two calls mg diff makes. Needs a real git repo (PATH restricted to real\n// git, since the session shim refuses git init).\nfunc TestHandleJobDiffQuickEyeball(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\tdir := initGitRepo(t)\n\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n\tif err := os.WriteFile(filepath.Join(dir, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGitT(t, dir, \"add\", \"feature.txt\")\n\trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"add the feature\")\n\trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n\n\tsrv := New(&Registry{entries: []Entry{entryFor(dir)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/wood_test/diff\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body jobDiffResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif body.Log == nil || !strings.Contains(*body.Log, \"add the feature\") {\n\t\tt.Errorf(\"log = %v, want the branch's commit\", body.Log)\n\t}\n\tif body.Stat == nil || !strings.Contains(*body.Stat, \"feature.txt\") {\n\t\tt.Errorf(\"stat = %v, want the changed file\", body.Stat)\n\t}\n\tif body.Patch != nil {\n\t\tt.Errorf(\"patch = %v, want nil for the quick eyeball\", body.Patch)\n\t}\n}\n\n// TestHandleJobDiffFullPatch: ?full=1 returns the complete patch.\nfunc TestHandleJobDiffFullPatch(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\tdir := initGitRepo(t)\n\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n\tif err := os.WriteFile(filepath.Join(dir, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGitT(t, dir, \"add\", \"feature.txt\")\n\trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"add the feature\")\n\trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n\n\tsrv := New(&Registry{entries: []Entry{entryFor(dir)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/wood_test/diff?full=1\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body jobDiffResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif body.Patch == nil || !strings.Contains(*body.Patch, \"+feature\") {\n\t\tt.Errorf(\"patch = %v, want the full patch\", body.Patch)\n\t}\n\tif body.Log != nil || body.Stat != nil {\n\t\tt.Errorf(\"log/stat = %v/%v, want nil for ?full=1\", body.Log, body.Stat)\n\t}\n}\n\n// TestHandleJobDiffResolvesBaseBranchFromConfig: the base branch comes from\n// the project's configured baseBranch (project.Load), exactly as mg diff\n// resolves it — proven by a repo where main and the configured base differ,\n// so the wrong base would show an extra commit.\nfunc TestHandleJobDiffResolvesBaseBranchFromConfig(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\tdir := initGitRepo(t)\n\t// trunk = main + one extra commit; baseBranch is configured to trunk.\n\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"trunk\")\n\tif err := os.WriteFile(filepath.Join(dir, \"trunk.txt\"), []byte(\"trunk\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGitT(t, dir, \"add\", \"trunk.txt\")\n\trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"trunk work\")\n\t// The job branch is cut from trunk and adds one commit of its own.\n\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n\tif err := os.WriteFile(filepath.Join(dir, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGitT(t, dir, \"add\", \"feature.txt\")\n\trunGitT(t, dir, \"commit\", \"-q\", \"-m\", \"job work\")\n\trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n\t// Configure baseBranch=trunk.\n\tif err := os.MkdirAll(filepath.Join(dir, \".manigot\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(dir, \".manigot\", \"manigot.json\"), []byte(`{\"baseBranch\": \"trunk\"}`), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tsrv := New(&Registry{entries: []Entry{entryFor(dir)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/wood_test/diff\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body jobDiffResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\t// Only the job's own commit — had the base fallen back to main, the\n\t// trunk commit would appear too.\n\tif body.Log == nil || strings.Contains(*body.Log, \"trunk work\") || !strings.Contains(*body.Log, \"job work\") {\n\t\tt.Errorf(\"log = %v, want only the job's commit against base trunk\", body.Log)\n\t}\n}\n\n// TestHandleJobDiffUnknownJobIs404: an unresolvable job segment is a 404 with\n// the CLI's not-found wording.\nfunc TestHandleJobDiffUnknownJobIs404(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\tdir := initGitRepo(t)\n\tsrv := New(&Registry{entries: []Entry{entryFor(dir)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/nope/diff\", \"\")\n\tif rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"status = %d, want 404 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif !strings.Contains(rec.Body.String(), \"not found among local branches\") {\n\t\tt.Errorf(\"body = %s, want the CLI's not-found wording\", rec.Body.String())\n\t}\n}\n\n// TestHandleJobDiffAmbiguousIs409: a job segment matching several branches by\n// prefix is a 409 with the CLI's ambiguity wording.\nfunc TestHandleJobDiffAmbiguousIs409(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\tdir := initGitRepo(t)\n\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_a\")\n\trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n\trunGitT(t, dir, \"checkout\", \"-q\", \"-b\", \"feature/wood_b\")\n\trunGitT(t, dir, \"checkout\", \"-q\", \"main\")\n\n\tsrv := New(&Registry{entries: []Entry{entryFor(dir)}}, \"test-version\", \"\", nil)\n\trec := get(t, srv, \"/projects/\"+filepath.Base(dir)+\"/jobs/wood/diff\", \"\")\n\tif rec.Code != http.StatusConflict {\n\t\tt.Errorf(\"status = %d, want 409 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif !strings.Contains(rec.Body.String(), \"ambiguous\") {\n\t\tt.Errorf(\"body = %s, want the CLI's ambiguity wording\", rec.Body.String())\n\t}\n}\n\n// TestHandleProjectAgentsNameAndDescription: the agents endpoint lists name +\n// description only, from the same agentlist.Discover the mg agents picker\n// uses.\nfunc TestHandleProjectAgentsNameAndDescription(t *testing.T) {\n\tfakeCheckout(t, map[string]string{\n\t\t\"analyst\":  \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n\t\t\"reviewer\": \"name: reviewer\\ndescription: Reviews changes.\\n\",\n\t})\n\troot := t.TempDir() // no docs/ needed — agents are global\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/agents\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body agentsResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif len(body.Agents) != 2 {\n\t\tt.Fatalf(\"agents = %d, want 2:\\n%s\", len(body.Agents), rec.Body.String())\n\t}\n\t// Sorted by name: analyst first.\n\tif body.Agents[0].Name != \"analyst\" || !strings.Contains(body.Agents[0].Description, \"tasks\") {\n\t\tt.Errorf(\"agent[0] = %+v, want analyst with its description\", body.Agents[0])\n\t}\n\tif body.Agents[1].Name != \"reviewer\" {\n\t\tt.Errorf(\"agent[1] = %+v, want reviewer\", body.Agents[1])\n\t}\n\t// No full agent-file contents leak into the response.\n\tif strings.Contains(rec.Body.String(), \"name: analyst\") {\n\t\tt.Errorf(\"response leaks the raw agent file: %s\", rec.Body.String())\n\t}\n}\n\n// --- TASK-5: /health ---------------------------------------------------------\n\n// TestHandleHealthReportsVersionImageAndProfiles: /health reports the version,\n// docker image presence, and per-profile readiness — identifiers and booleans\n// only, never credential values. The docker presence and readiness booleans\n// depend on the machine the test runs on (session.ImagePresent degrades to\n// false when docker is missing; profile readiness is an env read), so the\n// shape — every profile present, every field present — is what is pinned.\nfunc TestHandleHealthReportsVersionImageAndProfiles(t *testing.T) {\n\tsrv := New(&Registry{}, \"1.2.3-test\", \"\", nil)\n\trec := get(t, srv, \"/health\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body healthResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif body.Version != \"1.2.3-test\" {\n\t\tt.Errorf(\"version = %q, want the version passed into New\", body.Version)\n\t}\n\t// imagePresent must be a real boolean (present in the JSON), whatever its\n\t// value on this machine.\n\tvar raw map[string]json.RawMessage\n\tif err := json.Unmarshal(rec.Body.Bytes(), &raw); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, ok := raw[\"imagePresent\"]; !ok {\n\t\tt.Errorf(\"imagePresent missing from /health: %s\", rec.Body.String())\n\t}\n\n\tif len(body.Profiles) != 5 {\n\t\tt.Fatalf(\"profiles = %d, want 5 (claude-pro, zai, opencode-go, opencode-zen, opencode-zen-free):\\n%s\",\n\t\t\tlen(body.Profiles), rec.Body.String())\n\t}\n\tseen := map[string]bool{}\n\tfor _, p := range body.Profiles {\n\t\tif p.ID == \"\" {\n\t\t\tt.Errorf(\"profile row with empty id: %+v\", p)\n\t\t}\n\t\tseen[p.ID] = true\n\t}\n\tfor _, id := range []string{\"claude-pro\", \"zai\", \"opencode-go\", \"opencode-zen\", \"opencode-zen-free\"} {\n\t\tif !seen[id] {\n\t\t\tt.Errorf(\"profile %q missing from /health\", id)\n\t\t}\n\t}\n}\n\n// TestHandleHealthRequiresAuth: /health is inside the same auth boundary as\n// every other endpoint — with a token configured, it is a 401 without one.\nfunc TestHandleHealthRequiresAuth(t *testing.T) {\n\tsrv := New(&Registry{}, \"1.2.3-test\", \"sekrit-token\", nil)\n\tif rec := get(t, srv, \"/health\", \"\"); rec.Code != http.StatusUnauthorized {\n\t\tt.Errorf(\"no token: status = %d, want 401\", rec.Code)\n\t}\n\tif rec := get(t, srv, \"/health\", \"Bearer sekrit-token\"); rec.Code != http.StatusOK {\n\t\tt.Errorf(\"with token: status = %d, want 200\", rec.Code)\n\t}\n}\n","numLines":685,"startLine":1,"totalLines":685}}}
