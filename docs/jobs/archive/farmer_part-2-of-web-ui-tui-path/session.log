wn\")\n1219-\t\tcase \"developer\":\n1220-\t\t\twriteJobFile(t, j, \"implementation.md\", \"# Implementation\\n\\nTASK-1: did the thing\\n\")\n1221-\t\t\tcommit(t, root, \"[aaaa01] TASK-1: do the thing\")\n1222-\t\tcase \"reviewer\":\n1223-\t\t\twriteJobFile(t, j, \"verdict.md\", \"# Verdict\\n\\nTASK-1: PASS\\n\\n## Overall\\n\\nAPPROVED\\n\")\n1224-\t\t\tcommit(t, root, \"[aaaa01] verdict: approved\")\n1225-\t\t}\n1226-\t\treturn []byte(\"ok\")\n1227-\t}}\n1228-\n1229-\tvar log bytes.Buffer\n1230-\tgot := Run(root, j, r, &log, nil)\n1231-\tif got.Kind != orchestrate.StopFinished {\n1232-\t\tt.Fatalf(\"Run.Kind = %v, want StopFinished (reason: %s)\", got.Kind, got.Reason)\n1233-\t}\n1234-}\n1235-\n1236:// TestRunDoesNotSweepMainWorktree pins the loop-exit sweep's main-worktree\n1237-// gate: for a pre-worktree job (the job branch checked out in the MAIN\n1238-// worktree itself — initTestRepo's shape, an explicitly supported state) the\n1239-// sweep must be skipped entirely. Without the gate, git.CommitAll on the\n1240-// main worktree would stage and commit the user's own uncommitted work — an\n1241-// unexcluded .env included — as [<id>] chore: commit all on the job branch:\n1242-// precisely the hazard session.SweepJobWorktree's\n1243-// ProjectRoot == InvocationRoot gate exists for. The test plants an\n1244-// untracked .env in the main worktree and runs a marker-stop loop (a single","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
