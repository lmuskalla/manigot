{"type":"tool_use","timestamp":1787952949970,"sessionID":"ses_fb5b402d5ffesBMXb1jVe3Cozl","part":{"type":"tool","tool":"read","callID":"call_7c89aefa4f1d4e65ad59b761","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/concurrency_test.go"},"output":"<path>/workspace/src/internal/serve/concurrency_test.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"encoding/json\"\n5: \t\"net/http\"\n6: \t\"net/http/httptest\"\n7: \t\"os\"\n8: \t\"path/filepath\"\n9: \t\"testing\"\n10: \t\"time\"\n11: )\n12: \n13: // This file pins the ProjectLocks boundary across the handler surface: which\n14: // operations take s.locks.Lock(root) and which deliberately do not. The\n15: // boundary is a real correctness property — over-serializing (a launch that\n16: // waits behind an unrelated done) defeats the point of a responsive control\n17: // plane, under-serializing (two git-mutating ops racing on the same project)\n18: // corrupts git metadata. Each test holds the project lock itself (simulating\n19: // an in-flight mutating operation on that project) and asserts the request\n20: // under test either blocks behind it (a lock-taking handler) or completes\n21: // immediately (a non-locking handler).\n22: \n23: // lockBlockTimeout is how long a request that SHOULD block behind the held\n24: // project lock is given before the test concludes it blocked. A handler that\n25: // wrongly skipped the lock would complete in microseconds, so 200ms is an\n26: // enormous margin.\n27: const lockBlockTimeout = 200 * time.Millisecond\n28: \n29: // lockReleaseTimeout is how long a blocked request is given to complete after\n30: // the lock is released.\n31: const lockReleaseTimeout = 3 * time.Second\n32: \n33: // assertBlocksWhileLockHeld starts fn in a goroutine, holds the project lock\n34: // for root, and asserts fn does NOT complete until the lock is released (a\n35: // lock-taking handler). fn is the request's completion signal — it must close\n36: // done when the request finishes. On return the lock has been released and the\n37: // goroutine has completed (the test waits for it, so a fixture-dir cleanup\n38: // never races the still-running handler).\n39: func assertBlocksWhileLockHeld(t *testing.T, srv *Server, root string, fn func(done chan struct{})) {\n40: \tt.Helper()\n41: \tsrv.locks.Lock(root)\n42: \n43: \tdone := make(chan struct{})\n44: \tgo fn(done)\n45: \n46: \tselect {\n47: \tcase <-done:\n48: \t\tsrv.locks.Unlock(root)\n49: \t\tt.Fatal(\"request completed while the project lock was held — a mutating handler must serialize behind s.locks.Lock(root)\")\n50: \tcase <-time.After(lockBlockTimeout):\n51: \t\t// blocked as expected\n52: \t}\n53: \n54: \tsrv.locks.Unlock(root)\n55: \tselect {\n56: \tcase <-done:\n57: \tcase <-time.After(lockReleaseTimeout):\n58: \t\tt.Fatal(\"request did not proceed after the project lock was released\")\n59: \t}\n60: }\n61: \n62: // releaseAndExpectDone releases the lock and asserts the blocked request now\n63: // completes.\n64: func releaseAndExpectDone(t *testing.T, srv *Server, root string, done chan struct{}) {\n65: \tt.Helper()\n66: \tsrv.locks.Unlock(root)\n67: \tselect {\n68: \tcase <-done:\n69: \tcase <-time.After(lockReleaseTimeout):\n70: \t\tt.Fatal(\"request did not proceed after the project lock was released\")\n71: \t}\n72: }\n73: \n74: // assertCompletesWhileLockHeld holds the project lock and asserts fn completes\n75: // promptly — a handler that must NOT take the lock (launch-agent, launch-jdi,\n76: // prune, reads).\n77: func assertCompletesWhileLockHeld(t *testing.T, srv *Server, root string, fn func(done chan struct{})) {\n78: \tt.Helper()\n79: \tsrv.locks.Lock(root)\n80: \tdefer srv.locks.Unlock(root)\n81: \n82: \tdone := make(chan struct{})\n83: \tgo fn(done)\n84: \n85: \tselect {\n86: \tcase <-done:\n87: \t\t// completed without waiting — the boundary holds\n88: \tcase <-time.After(lockBlockTimeout):\n89: \t\tt.Fatal(\"request did not complete while the project lock was held — a non-mutating handler must not block behind s.locks.Lock(root)\")\n90: \t}\n91: }\n92: \n93: // --- lock-taking handlers ----------------------------------------------------\n94: \n95: // TestCreateBlocksBehindProjectLock: create-job takes the lock (git-mutating:\n96: // creates a branch + worktree) — a create issued while another mutating\n97: // operation holds the same project's lock must wait.\n98: func TestCreateBlocksBehindProjectLock(t *testing.T) {\n99: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n100: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n101: \tbase := filepath.Base(root)\n102: \n103: \tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n104: \t\tpost(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Blocked Create\"}`)\n105: \t\tclose(done)\n106: \t})\n107: }\n108: \n109: // TestEditBriefBlocksBehindProjectLock: edit-brief takes the lock (the\n110: // post-write commit touches git) — a write issued behind another mutating\n111: // operation on the same project must wait, so the commit can never race a\n112: // concurrent done/delete on the same worktree.\n113: func TestEditBriefBlocksBehindProjectLock(t *testing.T) {\n114: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n115: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n116: \tbase := filepath.Base(root)\n117: \n118: \tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n119: \t\tput(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/files/brief\", \"\", \"# Brief: X\\n\")\n120: \t\tclose(done)\n121: \t})\n122: }\n123: \n124: // TestDoneBlocksBehindProjectLock: done takes the lock (git-mutating: archive\n125: // + squash merge + branch delete). force:true is required so the request\n126: // reaches the lock rather than returning early on the verdict warning.\n127: func TestDoneBlocksBehindProjectLock(t *testing.T) {\n128: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n129: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n130: \tbase := filepath.Base(root)\n131: \n132: \tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n133: \t\tpost(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/done\", \"\", `{\"force\":true}`)\n134: \t\tclose(done)\n135: \t})\n136: }\n137: \n138: // TestDeleteBlocksBehindProjectLock: delete takes the lock (git-mutating:\n139: // worktree force-remove + branch -D).\n140: func TestDeleteBlocksBehindProjectLock(t *testing.T) {\n141: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n142: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n143: \tbase := filepath.Base(root)\n144: \n145: \tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n146: \t\tpost(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/delete\", \"\", \"\")\n147: \t\tclose(done)\n148: \t})\n149: }\n150: \n151: // TestPushBlocksBehindProjectLock: push takes the lock (git-mutating: pushes\n152: // the branch).\n153: func TestPushBlocksBehindProjectLock(t *testing.T) {\n154: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n155: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n156: \tbase := filepath.Base(root)\n157: \n158: \tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n159: \t\tpost(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/push\", \"\", \"\")\n160: \t\tclose(done)\n161: \t})\n162: }\n163: \n164: // TestOrphanDeleteBlocksBehindProjectLock: orphan-delete takes the lock\n165: // (RemoveOrphansConfirmed calls git.WorktreePrune, which touches git worktree\n166: // metadata) — this task's own reasoned addition to the boundary, since the\n167: // brief's Notes don't name orphan cleanup in the git-mutating set.\n168: func TestOrphanDeleteBlocksBehindProjectLock(t *testing.T) {\n169: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n170: \tfakeOrphan(t, root, \"abandoned_1\")\n171: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n172: \tbase := filepath.Base(root)\n173: \n174: \tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n175: \t\tpost(t, srv, \"/projects/\"+base+\"/orphans/abandoned_1/delete\", \"\", \"\")\n176: \t\tclose(done)\n177: \t})\n178: }\n179: \n180: // --- non-locking handlers ----------------------------------------------------\n181: \n182: // TestLaunchAgentDoesNotBlockBehindProjectLock: launch-agent takes no lock\n183: // (per the brief's Notes — launching an agent doesn't touch git state and\n184: // must not wait behind an unrelated done/delete). A launch issued while\n185: // another mutating operation holds the same project's lock completes\n186: // immediately.\n187: func TestLaunchAgentDoesNotBlockBehindProjectLock(t *testing.T) {\n188: \tfakeCheckout(t, map[string]string{\n189: \t\t\"analyst\": \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n190: \t})\n191: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n192: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n193: \tbase := filepath.Base(root)\n194: \n195: \tassertCompletesWhileLockHeld(t, srv, root, func(done chan struct{}) {\n196: \t\trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/agents/analyst\", \"\", \"\")\n197: \t\tif rec.Code != http.StatusAccepted {\n198: \t\t\tt.Errorf(\"launch-agent status = %d, want 202\", rec.Code)\n199: \t\t}\n200: \t\tclose(done)\n201: \t})\n202: }\n203: \n204: // TestLaunchJDIDoesNotBlockBehindProjectLock: launch-jdi takes no lock (same\n205: // reasoning as launch-agent).\n206: func TestLaunchJDIDoesNotBlockBehindProjectLock(t *testing.T) {\n207: \tstubJdiExe(t, \"/bin/true\")\n208: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n209: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n210: \tbase := filepath.Base(root)\n211: \n212: \tassertCompletesWhileLockHeld(t, srv, root, func(done chan struct{}) {\n213: \t\trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/jdi\", \"\", \"\")\n214: \t\tif rec.Code != http.StatusAccepted {\n215: \t\t\tt.Errorf(\"launch-jdi status = %d, want 202\", rec.Code)\n216: \t\t}\n217: \t\tclose(done)\n218: \t})\n219: }\n220: \n221: // TestPruneDoesNotBlockBehindProjectLock: prune takes no lock (no git or\n222: // project-scoped state at all — orphaned containers are not partitioned by\n223: // project). It completes even while a project lock is held.\n224: func TestPruneDoesNotBlockBehindProjectLock(t *testing.T) {\n225: \tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n226: \n227: \tassertCompletesWhileLockHeld(t, srv, \"\", func(done chan struct{}) {\n228: \t\tpost(t, srv, \"/prune\", \"\", \"\")\n229: \t\tclose(done)\n230: \t})\n231: }\n232: \n233: // TestReadsDoNotBlockBehindProjectLock: read endpoints take no locks — a\n234: // listing issued while a mutating operation holds the project lock completes\n235: // immediately (v1's deliberate no-lock reads).\n236: func TestReadsDoNotBlockBehindProjectLock(t *testing.T) {\n237: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n238: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n239: \tbase := filepath.Base(root)\n240: \n241: \tassertCompletesWhileLockHeld(t, srv, root, func(done chan struct{}) {\n242: \t\tget(t, srv, \"/projects/\"+base+\"/jobs\", \"\")\n243: \t\tclose(done)\n244: \t})\n245: }\n246: \n247: // --- per-project independence ------------------------------------------------\n248: \n249: // TestDifferentProjectsProceedIndependently: the lock is keyed by project\n250: // root — a mutating call on project B proceeds while project A's lock is held\n251: // (the property that keeps a multi-project daemon responsive).\n252: func TestDifferentProjectsProceedIndependently(t *testing.T) {\n253: \trootA := fakeJobProject(t, \"project_a\", minimalBrief(\"A\", \"a\", \"open\", \"feature\", \"2026-08-01\"))\n254: \trootB := fakeJobProject(t, \"project_b\", minimalBrief(\"B\", \"b\", \"open\", \"feature\", \"2026-08-01\"))\n255: \treg := &Registry{entries: []Entry{entryFor(rootA), entryFor(rootB)}}\n256: \tsrv := New(reg, \"test-version\", \"\", nil)\n257: \tbaseB := filepath.Base(rootB)\n258: \n259: \t// Hold A's lock, then create a job in B — B must proceed immediately.\n260: \tassertCompletesWhileLockHeld(t, srv, rootA, func(done chan struct{}) {\n261: \t\trec := post(t, srv, \"/projects/\"+baseB+\"/jobs\", \"\", `{\"title\":\"Independent B\"}`)\n262: \t\tif rec.Code != http.StatusCreated {\n263: \t\t\tt.Errorf(\"create in project B status = %d, want 201\", rec.Code)\n264: \t\t}\n265: \t\tclose(done)\n266: \t})\n267: }\n268: \n269: // TestConcurrentMutatingCallsSerializeSameProject: two mutating calls against\n270: // the SAME project serialize end to end — a blocked create behind a held lock\n271: // proceeds (and succeeds) once the lock is released, proving the handler\n272: // acquires the lock for its whole critical section, not just part of it.\n273: func TestConcurrentMutatingCallsSerializeSameProject(t *testing.T) {\n274: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n275: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n276: \tbase := filepath.Base(root)\n277: \n278: \tsrv.locks.Lock(root)\n279: \tdone := make(chan struct{})\n280: \tvar rec *httptest.ResponseRecorder\n281: \tgo func() {\n282: \t\trec = post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Serialized Create\"}`)\n283: \t\tclose(done)\n284: \t}()\n285: \n286: \tselect {\n287: \tcase <-done:\n288: \t\tt.Fatal(\"create completed while the project lock was held\")\n289: \tcase <-time.After(lockBlockTimeout):\n290: \t}\n291: \n292: \tsrv.locks.Unlock(root)\n293: \tselect {\n294: \tcase <-done:\n295: \tcase <-time.After(lockReleaseTimeout):\n296: \t\tt.Fatal(\"create did not proceed after the project lock was released\")\n297: \t}\n298: \tif rec.Code != http.StatusCreated {\n299: \t\tt.Errorf(\"create status = %d, want 201 after the lock was released\", rec.Code)\n300: \t}\n301: \t// The created job's directory actually exists — the critical section ran\n302: \t// to completion, not just past the lock acquisition.\n303: \tvar body createJobResponse\n304: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n305: \t\tt.Fatalf(\"create body not JSON: %v\", err)\n306: \t}\n307: \tif _, err := os.Stat(filepath.Join(root, \"docs\", \"jobs\", body.Job.Name)); err != nil {\n308: \t\tt.Errorf(\"created job dir missing after serialized create: %v\", err)\n309: \t}\n310: }\n\n(End of file - total 310 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n\t\"time\"\n)\n\n// This file pins the ProjectLocks boundary across the handler surface: which\n// operations take s.locks.Lock(root) and which deliberately do not. The\n// boundary is a real correctness property — over-serializing (a launch that\n// waits behind an unrelated done) defeats the point of a responsive control\n// plane, under-serializing (two git-mutating ops racing on the same project)\n// corrupts git metadata. Each test holds the project lock itself (simulating\n// an in-flight mutating operation on that project) and asserts the request\n// under test either blocks behind it (a lock-taking handler) or completes","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/concurrency_test.go","text":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n\t\"time\"\n)\n\n// This file pins the ProjectLocks boundary across the handler surface: which\n// operations take s.locks.Lock(root) and which deliberately do not. The\n// boundary is a real correctness property — over-serializing (a launch that\n// waits behind an unrelated done) defeats the point of a responsive control\n// plane, under-serializing (two git-mutating ops racing on the same project)\n// corrupts git metadata. Each test holds the project lock itself (simulating\n// an in-flight mutating operation on that project) and asserts the request\n// under test either blocks behind it (a lock-taking handler) or completes\n// immediately (a non-locking handler).\n\n// lockBlockTimeout is how long a request that SHOULD block behind the held\n// project lock is given before the test concludes it blocked. A handler that\n// wrongly skipped the lock would complete in microseconds, so 200ms is an\n// enormous margin.\nconst lockBlockTimeout = 200 * time.Millisecond\n\n// lockReleaseTimeout is how long a blocked request is given to complete after\n// the lock is released.\nconst lockReleaseTimeout = 3 * time.Second\n\n// assertBlocksWhileLockHeld starts fn in a goroutine, holds the project lock\n// for root, and asserts fn does NOT complete until the lock is released (a\n// lock-taking handler). fn is the request's completion signal — it must close\n// done when the request finishes. On return the lock has been released and the\n// goroutine has completed (the test waits for it, so a fixture-dir cleanup\n// never races the still-running handler).\nfunc assertBlocksWhileLockHeld(t *testing.T, srv *Server, root string, fn func(done chan struct{})) {\n\tt.Helper()\n\tsrv.locks.Lock(root)\n\n\tdone := make(chan struct{})\n\tgo fn(done)\n\n\tselect {\n\tcase <-done:\n\t\tsrv.locks.Unlock(root)\n\t\tt.Fatal(\"request completed while the project lock was held — a mutating handler must serialize behind s.locks.Lock(root)\")\n\tcase <-time.After(lockBlockTimeout):\n\t\t// blocked as expected\n\t}\n\n\tsrv.locks.Unlock(root)\n\tselect {\n\tcase <-done:\n\tcase <-time.After(lockReleaseTimeout):\n\t\tt.Fatal(\"request did not proceed after the project lock was released\")\n\t}\n}\n\n// releaseAndExpectDone releases the lock and asserts the blocked request now\n// completes.\nfunc releaseAndExpectDone(t *testing.T, srv *Server, root string, done chan struct{}) {\n\tt.Helper()\n\tsrv.locks.Unlock(root)\n\tselect {\n\tcase <-done:\n\tcase <-time.After(lockReleaseTimeout):\n\t\tt.Fatal(\"request did not proceed after the project lock was released\")\n\t}\n}\n\n// assertCompletesWhileLockHeld holds the project lock and asserts fn completes\n// promptly — a handler that must NOT take the lock (launch-agent, launch-jdi,\n// prune, reads).\nfunc assertCompletesWhileLockHeld(t *testing.T, srv *Server, root string, fn func(done chan struct{})) {\n\tt.Helper()\n\tsrv.locks.Lock(root)\n\tdefer srv.locks.Unlock(root)\n\n\tdone := make(chan struct{})\n\tgo fn(done)\n\n\tselect {\n\tcase <-done:\n\t\t// completed without waiting — the boundary holds\n\tcase <-time.After(lockBlockTimeout):\n\t\tt.Fatal(\"request did not complete while the project lock was held — a non-mutating handler must not block behind s.locks.Lock(root)\")\n\t}\n}\n\n// --- lock-taking handlers ----------------------------------------------------\n\n// TestCreateBlocksBehindProjectLock: create-job takes the lock (git-mutating:\n// creates a branch + worktree) — a create issued while another mutating\n// operation holds the same project's lock must wait.\nfunc TestCreateBlocksBehindProjectLock(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\tpost(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Blocked Create\"}`)\n\t\tclose(done)\n\t})\n}\n\n// TestEditBriefBlocksBehindProjectLock: edit-brief takes the lock (the\n// post-write commit touches git) — a write issued behind another mutating\n// operation on the same project must wait, so the commit can never race a\n// concurrent done/delete on the same worktree.\nfunc TestEditBriefBlocksBehindProjectLock(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\tput(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/files/brief\", \"\", \"# Brief: X\\n\")\n\t\tclose(done)\n\t})\n}\n\n// TestDoneBlocksBehindProjectLock: done takes the lock (git-mutating: archive\n// + squash merge + branch delete). force:true is required so the request\n// reaches the lock rather than returning early on the verdict warning.\nfunc TestDoneBlocksBehindProjectLock(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\tpost(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/done\", \"\", `{\"force\":true}`)\n\t\tclose(done)\n\t})\n}\n\n// TestDeleteBlocksBehindProjectLock: delete takes the lock (git-mutating:\n// worktree force-remove + branch -D).\nfunc TestDeleteBlocksBehindProjectLock(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\tpost(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/delete\", \"\", \"\")\n\t\tclose(done)\n\t})\n}\n\n// TestPushBlocksBehindProjectLock: push takes the lock (git-mutating: pushes\n// the branch).\nfunc TestPushBlocksBehindProjectLock(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\tpost(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/push\", \"\", \"\")\n\t\tclose(done)\n\t})\n}\n\n// TestOrphanDeleteBlocksBehindProjectLock: orphan-delete takes the lock\n// (RemoveOrphansConfirmed calls git.WorktreePrune, which touches git worktree\n// metadata) — this task's own reasoned addition to the boundary, since the\n// brief's Notes don't name orphan cleanup in the git-mutating set.\nfunc TestOrphanDeleteBlocksBehindProjectLock(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tfakeOrphan(t, root, \"abandoned_1\")\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\tpost(t, srv, \"/projects/\"+base+\"/orphans/abandoned_1/delete\", \"\", \"\")\n\t\tclose(done)\n\t})\n}\n\n// --- non-locking handlers ----------------------------------------------------\n\n// TestLaunchAgentDoesNotBlockBehindProjectLock: launch-agent takes no lock\n// (per the brief's Notes — launching an agent doesn't touch git state and\n// must not wait behind an unrelated done/delete). A launch issued while\n// another mutating operation holds the same project's lock completes\n// immediately.\nfunc TestLaunchAgentDoesNotBlockBehindProjectLock(t *testing.T) {\n\tfakeCheckout(t, map[string]string{\n\t\t\"analyst\": \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n\t})\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertCompletesWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/agents/analyst\", \"\", \"\")\n\t\tif rec.Code != http.StatusAccepted {\n\t\t\tt.Errorf(\"launch-agent status = %d, want 202\", rec.Code)\n\t\t}\n\t\tclose(done)\n\t})\n}\n\n// TestLaunchJDIDoesNotBlockBehindProjectLock: launch-jdi takes no lock (same\n// reasoning as launch-agent).\nfunc TestLaunchJDIDoesNotBlockBehindProjectLock(t *testing.T) {\n\tstubJdiExe(t, \"/bin/true\")\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertCompletesWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/jdi\", \"\", \"\")\n\t\tif rec.Code != http.StatusAccepted {\n\t\t\tt.Errorf(\"launch-jdi status = %d, want 202\", rec.Code)\n\t\t}\n\t\tclose(done)\n\t})\n}\n\n// TestPruneDoesNotBlockBehindProjectLock: prune takes no lock (no git or\n// project-scoped state at all — orphaned containers are not partitioned by\n// project). It completes even while a project lock is held.\nfunc TestPruneDoesNotBlockBehindProjectLock(t *testing.T) {\n\tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n\n\tassertCompletesWhileLockHeld(t, srv, \"\", func(done chan struct{}) {\n\t\tpost(t, srv, \"/prune\", \"\", \"\")\n\t\tclose(done)\n\t})\n}\n\n// TestReadsDoNotBlockBehindProjectLock: read endpoints take no locks — a\n// listing issued while a mutating operation holds the project lock completes\n// immediately (v1's deliberate no-lock reads).\nfunc TestReadsDoNotBlockBehindProjectLock(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertCompletesWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\tget(t, srv, \"/projects/\"+base+\"/jobs\", \"\")\n\t\tclose(done)\n\t})\n}\n\n// --- per-project independence ------------------------------------------------\n\n// TestDifferentProjectsProceedIndependently: the lock is keyed by project\n// root — a mutating call on project B proceeds while project A's lock is held\n// (the property that keeps a multi-project daemon responsive).\nfunc TestDifferentProjectsProceedIndependently(t *testing.T) {\n\trootA := fakeJobProject(t, \"project_a\", minimalBrief(\"A\", \"a\", \"open\", \"feature\", \"2026-08-01\"))\n\trootB := fakeJobProject(t, \"project_b\", minimalBrief(\"B\", \"b\", \"open\", \"feature\", \"2026-08-01\"))\n\treg := &Registry{entries: []Entry{entryFor(rootA), entryFor(rootB)}}\n\tsrv := New(reg, \"test-version\", \"\", nil)\n\tbaseB := filepath.Base(rootB)\n\n\t// Hold A's lock, then create a job in B — B must proceed immediately.\n\tassertCompletesWhileLockHeld(t, srv, rootA, func(done chan struct{}) {\n\t\trec := post(t, srv, \"/projects/\"+baseB+\"/jobs\", \"\", `{\"title\":\"Independent B\"}`)\n\t\tif rec.Code != http.StatusCreated {\n\t\t\tt.Errorf(\"create in project B status = %d, want 201\", rec.Code)\n\t\t}\n\t\tclose(done)\n\t})\n}\n\n// TestConcurrentMutatingCallsSerializeSameProject: two mutating calls against\n// the SAME project serialize end to end — a blocked create behind a held lock\n// proceeds (and succeeds) once the lock is released, proving the handler\n// acquires the lock for its whole critical section, not just part of it.\nfunc TestConcurrentMutatingCallsSerializeSameProject(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tsrv.locks.Lock(root)\n\tdone := make(chan struct{})\n\tvar rec *httptest.ResponseRecorder\n\tgo func() {\n\t\trec = post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Serialized Create\"}`)\n\t\tclose(done)\n\t}()\n\n\tselect {\n\tcase <-done:\n\t\tt.Fatal(\"create completed while the project lock was held\")\n\tcase <-time.After(lockBlockTimeout):\n\t}\n\n\tsrv.locks.Unlock(root)\n\tselect {\n\tcase <-done:\n\tcase <-time.After(lockReleaseTimeout):\n\t\tt.Fatal(\"create did not proceed after the project lock was released\")\n\t}\n\tif rec.Code != http.StatusCreated {\n\t\tt.Errorf(\"create status = %d, want 201 after the lock was released\", rec.Code)\n\t}\n\t// The created job's directory actually exists — the critical section ran\n\t// to completion, not just past the lock acquisition.\n\tvar body createJobResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"create body not JSON: %v\", err)\n\t}\n\tif _, err := os.Stat(filepath.Join(root, \"docs\", \"jobs\", body.Job.Name)); err != nil {\n\t\tt.Errorf(\"created job dir missing after serialized create: %v\", err)\n\t}\n}","lineStart":1,"lineEnd":310,"totalLines":310,"truncated":false}},"title":"src/internal/serve/concurrency_test.go","time":{"start":1787952949965,"end":1787952949968}},"id":"prt_04a4cea6c001S0BPg4o50K7UZy","sessionID":"ses_fb5b402d5ffesBMXb1jVe3Cozl","messageID":"msg_04a4ce5d0001X99v6unufxOOL9"}}
