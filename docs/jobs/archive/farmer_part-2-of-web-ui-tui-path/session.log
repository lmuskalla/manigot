{"type":"tool_use","timestamp":1787952596127,"sessionID":"ses_fb5ba93f2ffe9RBBAgSFG35dIN","part":{"type":"tool","tool":"read","callID":"call_885e36ad168c4f0486318ab3","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/job/sessionlog_test.go"},"output":"<path>/workspace/src/internal/job/sessionlog_test.go</path>\n<type>file</type>\n<content>\n1: package job\n2: \n3: import (\n4: \t\"os\"\n5: \t\"path/filepath\"\n6: \t\"strings\"\n7: \t\"testing\"\n8: \t\"time\"\n9: )\n10: \n11: // --- session.log live-stream helper (OpenSessionLog + SessionLog) ----------\n12: \n13: // writeAndClose streams raw into a freshly opened session.log section and\n14: // closes it, failing the test on either error.\n15: func writeAndClose(t *testing.T, path, agent string, attempt int, raw []byte) {\n16: \tt.Helper()\n17: \ts, err := OpenSessionLog(path, agent, attempt)\n18: \tif err != nil {\n19: \t\tt.Fatalf(\"OpenSessionLog: %v\", err)\n20: \t}\n21: \tif _, err := s.Write(raw); err != nil {\n22: \t\tt.Fatalf(\"SessionLog.Write: %v\", err)\n23: \t}\n24: \tif err := s.Close(); err != nil {\n25: \t\tt.Fatalf(\"SessionLog.Close: %v\", err)\n26: \t}\n27: }\n28: \n29: func TestOpenSessionLogCreatesOnFirstUse(t *testing.T) {\n30: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n31: \twriteAndClose(t, path, \"analyst\", 1, []byte(\"Wrote tasks.md.\\n\"))\n32: \tdata, err := os.ReadFile(path)\n33: \tif err != nil {\n34: \t\tt.Fatalf(\"reading session.log: %v\", err)\n35: \t}\n36: \tgot := string(data)\n37: \tif !strings.Contains(got, \"analyst (attempt 1)\") {\n38: \t\tt.Errorf(\"session.log = %q, want an analyst (attempt 1) header\", got)\n39: \t}\n40: \tif !strings.Contains(got, \"Wrote tasks.md.\") {\n41: \t\tt.Errorf(\"session.log = %q, want the raw output preserved\", got)\n42: \t}\n43: }\n44: \n45: func TestOpenSessionLogAppendsAcrossSections(t *testing.T) {\n46: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n47: \twriteAndClose(t, path, \"analyst\", 1, []byte(\"first output\\n\"))\n48: \twriteAndClose(t, path, \"developer\", 2, []byte(\"second output\\n\"))\n49: \tdata, err := os.ReadFile(path)\n50: \tif err != nil {\n51: \t\tt.Fatal(err)\n52: \t}\n53: \tgot := string(data)\n54: \tif i, j := strings.Index(got, \"analyst (attempt 1)\"), strings.Index(got, \"developer (attempt 2)\"); i == -1 || j == -1 || i > j {\n55: \t\tt.Errorf(\"session.log sections out of order or missing, got:\\n%s\", got)\n56: \t}\n57: \tif i, j := strings.Index(got, \"first output\"), strings.Index(got, \"second output\"); i == -1 || j == -1 || i > j {\n58: \t\tt.Errorf(\"session.log raw outputs out of order or missing, got:\\n%s\", got)\n59: \t}\n60: }\n61: \n62: func TestOpenSessionLogHeaderCarriesAgentAttemptTimestamp(t *testing.T) {\n63: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n64: \twriteAndClose(t, path, \"reviewer\", 3, []byte(\"ok\\n\"))\n65: \tdata, err := os.ReadFile(path)\n66: \tif err != nil {\n67: \t\tt.Fatal(err)\n68: \t}\n69: \t// The header is the first line: \"=== <RFC3339 timestamp> <agent>\n70: \t// (attempt N) ===\".\n71: \tline, _, _ := strings.Cut(string(data), \"\\n\")\n72: \tif !strings.HasPrefix(line, \"=== \") || !strings.HasSuffix(line, \" reviewer (attempt 3) ===\") {\n73: \t\tt.Fatalf(\"header line = %q, want %q shape\", line, \"=== <timestamp> reviewer (attempt 3) ===\")\n74: \t}\n75: \tts := strings.TrimSuffix(strings.TrimPrefix(line, \"=== \"), \" reviewer (attempt 3) ===\")\n76: \tif _, err := time.Parse(time.RFC3339, ts); err != nil {\n77: \t\tt.Errorf(\"header timestamp %q is not RFC3339: %v\", ts, err)\n78: \t}\n79: }\n80: \n81: func TestOpenSessionLogPreservesRawVerbatim(t *testing.T) {\n82: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n83: \traw := []byte(\"line one\\nline two\\nline three\\n\")\n84: \twriteAndClose(t, path, \"analyst\", 1, raw)\n85: \tdata, err := os.ReadFile(path)\n86: \tif err != nil {\n87: \t\tt.Fatal(err)\n88: \t}\n89: \tif !strings.Contains(string(data), \"line one\\nline two\\nline three\\n\") {\n90: \t\tt.Errorf(\"session.log = %q, want the raw bytes preserved verbatim\", string(data))\n91: \t}\n92: }\n93: \n94: func TestOpenSessionLogSectionsSeparated(t *testing.T) {\n95: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n96: \t// Two sections where the first's raw output deliberately lacks a\n97: \t// trailing newline: the blank-line separator plus the trailing-newline\n98: \t// guarantee must keep the second section's header from gluing to it.\n99: \twriteAndClose(t, path, \"analyst\", 1, []byte(\"no trailing newline\"))\n100: \twriteAndClose(t, path, \"developer\", 1, []byte(\"second\\n\"))\n101: \tdata, err := os.ReadFile(path)\n102: \tif err != nil {\n103: \t\tt.Fatal(err)\n104: \t}\n105: \tgot := string(data)\n106: \tif !strings.Contains(got, \"no trailing newline\\n\\n=== \") {\n107: \t\tt.Errorf(\"sections not separated by a blank line, got:\\n%q\", got)\n108: \t}\n109: }\n110: \n111: func TestOpenSessionLogTrailingNewlineGuarantee(t *testing.T) {\n112: \t// Raw output without a trailing newline gets one appended on Close...\n113: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n114: \twriteAndClose(t, path, \"analyst\", 1, []byte(\"no newline\"))\n115: \tdata, err := os.ReadFile(path)\n116: \tif err != nil {\n117: \t\tt.Fatal(err)\n118: \t}\n119: \tif !strings.HasSuffix(string(data), \"no newline\\n\") {\n120: \t\tt.Errorf(\"session.log = %q, want the raw output to end with a newline\", string(data))\n121: \t}\n122: \t// ...and output that already ends with one is not double-newlined.\n123: \tpath2 := filepath.Join(t.TempDir(), \"session.log\")\n124: \twriteAndClose(t, path2, \"analyst\", 1, []byte(\"has newline\\n\"))\n125: \tdata2, err := os.ReadFile(path2)\n126: \tif err != nil {\n127: \t\tt.Fatal(err)\n128: \t}\n129: \tif strings.HasSuffix(string(data2), \"has newline\\n\\n\") {\n130: \t\tt.Errorf(\"session.log = %q, want exactly one trailing newline\", string(data2))\n131: \t}\n132: }\n133: \n