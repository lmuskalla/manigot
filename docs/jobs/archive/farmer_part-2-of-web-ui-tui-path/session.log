{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011uAzh8CDyumfkNnUQcppj4","type":"tool_result","content":"1\tpackage job\n2\t\n3\timport (\n4\t\t\"crypto/rand\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"os\"\n9\t\t\"path/filepath\"\n10\t\t\"regexp\"\n11\t\t\"strings\"\n12\t\t\"syscall\"\n13\t\t\"time\"\n14\t\n15\t\t\"github.com/lmuskalla/manigot/internal/git\"\n16\t\t\"github.com/lmuskalla/manigot/internal/project\"\n17\t)\n18\t\n19\t// CreateOptions carries the optional knobs of CreateJob — the flags\n20\t// new-job.sh accepted after the title.\n21\ttype CreateOptions struct {\n22\t\t// Type is the job type: feature (the default), fix, or chore.\n23\t\tType string\n24\t\n25\t\t// BaseBranchOverride replaces the project's configured base branch for\n26\t\t// this one invocation (new-job.sh's --base-branch).\n27\t\tBaseBranchOverride string\n28\t\n29\t\t// DeviceCheck reports whether a worktree sibling of root would land on a\n30\t\t// different filesystem (root itself is a mount point), which forces the\n31\t\t// nested layout. nil uses the real stat-dev comparison. Injectable so\n32\t\t// tests can force the nested layout without an actual second mount.\n33\t\tDeviceCheck func(parent, root string) bool\n34\t\n35\t\t// RandomID generates the job id. nil uses the default word-based\n36\t\t// generator — a uniform random pick from jobWords, wrapped in CreateJob's\n37\t\t// uniqueness retry loop (uniqueJobID). Injectable so tests get a\n38\t\t// deterministic id.\n39\t\tRandomID func() (string, error)\n40\t\n41\t\t// ExistingIDs returns the set of job ids already in use in the project,\n42\t\t// which the default uniqueness retry loop consults so a word id is never\n43\t\t// re-used — including against archived jobs. nil uses the real scan\n44\t\t// (existingJobIDs), covering open and archived jobs. Injectable so tests\n45\t\t// can simulate collisions without a git repo.\n46\t\tExistingIDs func() (map[string]bool, error)\n47\t}\n48\t\n49\t// CreateResult is the outcome of a successful CreateJob.\n50\ttype CreateResult struct {\n51\t\t// Job is the created job, read back from disk (Dir is the absolute job\n52\t\t// directory).\n53\t\tJob Job\n54\t\n55\t\t// Branch is the resolved branch name, or \"(no git)\" for a non-git project\n56\t\t// (mirroring the brief.md branch field new-job.sh wrote).\n57\t\tBranch string\n58\t\n59\t\t// WorktreePath is the job's own worktree (\"\" for a non-git project).\n60\t\tWorktreePath string\n61\t}\n62\t\n63\t// CreateJob ports scripts/new-job.sh — the job-creation lifecycle: resolve the\n64\t// settings, generate the id/slug/branch, create the job's own git worktree (or\n65\t// fall back to a plain directory for a non-git project), write the four\n66\t// scaffold files byte-identically to the script's templates, and make the\n67\t// \"Scaffold job <id>_<slug>\" commit inside the worktree. The script's stdout\n68\t// summary goes to out; all errors are returned with the script's exact\n69\t// \"Error: ...\" wording (the caller decides where to print them).\n70\t//\n71\t// root is the project root (the docs/-walk-up the CLI resolves before calling\n72\t// in; the TUI passes its own a.root). It is explicit rather than\n73\t// cwd-derived so the TUI's in-process calls target the project the TUI was\n74\t// opened on, not the TUI process's working directory.\n75\tfunc CreateJob(root, title string, opts CreateOptions, out io.Writer) (CreateResult, error) {\n76\t\tif root == \"\" {\n77\t\t\treturn CreateResult{}, fmt.Errorf(\"could not find project root (no docs/ directory found).\")\n78\t\t}\n79\t\n80\t\t// ── Resolve type + base branch + prefix ─────────────────────────────────\n81\t\tjobType := opts.Type\n82\t\tif jobType == \"\" {\n83\t\t\tjobType = \"feature\"\n84\t\t}\n85\t\tswitch jobType {\n86\t\tcase \"feature\", \"fix\", \"chore\":\n87\t\tdefault:\n88\t\t\treturn CreateResult{}, fmt.Errorf(\"Invalid type '%s'. Use: feature, fix, or chore.\", jobType)\n89\t\t}\n90\t\n91\t\tsettings, err := project.Load(root)\n92\t\tif err != nil {\n93\t\t\treturn CreateResult{}, err\n94\t\t}\n95\t\tbaseBranch := settings.BaseBranchValue()\n96\t\tif opts.BaseBranchOverride != \"\" {\n97\t\t\tbaseBranch = opts.BaseBranchOverride\n98\t\t}\n99\t\n100\t\t// ── Generate id, slug, date, author ─────────────────────────────────────\n101\t\t// The default path wraps the word picker in a uniqueness retry loop so a\n102\t\t// word id is never re-used (existingJobIDs covers open + archived jobs);\n103\t\t// an injected RandomID bypasses the check, matching its test-only role.\n104\t\tvar jobID string\n105\t\tif opts.RandomID != nil {\n106\t\t\tjobID, err = opts.RandomID()\n107\t\t} else {\n108\t\t\texisting := opts.ExistingIDs\n109\t\t\tif existing == nil {\n110\t\t\t\texisting = func() (map[string]bool, error) { return existingJobIDs(root) }\n111\t\t\t}\n112\t\t\tjobID, err = uniqueJobID(wordID, existing)\n113\t\t}\n114\t\tif err != nil {\n115\t\t\treturn CreateResult{}, fmt.Errorf(\"generating job id: %w\", err)\n116\t\t}\n117\t\tslug := slugify(title)\n118\t\tdate := time.Now().Format(\"2006-01-02\")\n119\t\tauthor := git.ConfigUserName(root)\n120\t\tif author == \"\" {\n121\t\t\tauthor = \"unknown\"\n122\t\t}\n123\t\n124\t\tbranch := settings.JobBranchPrefix\n125\t\tif branch != \"\" {\n126\t\t\tbranch += \"/\"\n127\t\t}\n128\t\tbranch += jobType + \"/\" + jobID + \"_\" + slug\n129\t\n130\t\t// Git vs non-git is decided on the no-branches signal, exactly like\n131\t\t// new-job.sh: the script ran `git rev-parse --abbrev-ref HEAD`, which\n132\t\t// FAILS on an unborn HEAD (a fresh repo before its first commit), so such\n133\t\t// a repo took the non-git fallback. `git symbolic-ref --quiet --short HEAD`\n134\t\t// instead SUCCEEDS on an unborn HEAD (it prints the unborn branch name),\n135\t\t// which is why CurrentBranch is the wrong probe here. A repo with zero\n136\t\t// local branches (fresh `git init`) takes the plain-directory fallback;\n137\t\t// a non-repo (ErrNotARepo) takes it too. Any other git failure is real\n138\t\t// and returned.\n139\t\tbranches, err := git.LocalBranches(root)\n140\t\tif err != nil && !errors.Is(err, git.ErrNotARepo) {\n141\t\t\treturn CreateResult{}, err\n142\t\t}\n143\t\n144\t\tif len(branches) > 0 {\n145\t\t\t// ── Git path: branch + worktree ────────────────────────────────────\n146\t\t\tif ok, err := git.RefExists(root, baseBranch); err != nil {\n147\t\t\t\treturn CreateResult{}, err\n148\t\t\t} else if !ok {\n149\t\t\t\treturn CreateResult{}, fmt.Errorf(\"base branch '%s' does not exist; cannot create job branch from it.\", baseBranch)\n150\t\t\t}\n151\t\n152\t\t\tif err := checkBranchNamespace(root, branch); err != nil {\n153\t\t\t\treturn CreateResult{}, err\n154\t\t\t}\n155\t\n156\t\t\t// Worktree layout: sibling of the project root by default; nested\n157\t\t\t// inside it (with a .git/info/exclude entry) when the root is itself\n158\t\t\t// a mount point and a sibling would land on another filesystem.\n159\t\t\tparent := filepath.Join(filepath.Dir(root), \".manigot-worktrees\", filepath.Base(root))\n160\t\t\tdc := opts.DeviceCheck\n161\t\t\tif dc == nil {\n162\t\t\t\tdc = func(parent, root string) bool { return !sameDevice(parent, root) }\n163\t\t\t}\n164\t\t\tif dc(filepath.Dir(root), root) {\n165\t\t\t\tparent = filepath.Join(root, \".manigot-worktrees\")\n166\t\t\t\tif err := git.ExcludePath(root, \".manigot-worktrees/\"); err != nil && !errors.Is(err, git.ErrNotARepo) {\n167\t\t\t\t\treturn CreateResult{}, err\n168\t\t\t\t}\n169\t\t\t}\n170\t\n171\t\t\twtPath := filepath.Join(parent, jobID+\"_\"+slug)\n172\t\t\tif err := os.MkdirAll(parent, 0o755); err != nil {\n173\t\t\t\treturn CreateResult{}, err\n174\t\t\t}\n175\t\t\tif err := git.WorktreeAdd(root, wtPath, branch, baseBranch); err != nil {\n176\t\t\t\treturn CreateResult{}, err\n177\t\t\t}\n178\t\t\t// Keep git from ever tracking the container's docs mount target path\n179\t\t\t// (.opencode for OpenCode, .claude for Claude Code) in this worktree:\n180\t\t\t// an agent staging job files through the mount would otherwise commit\n181\t\t\t// a stale duplicate of the job under the colliding path, which later\n182\t\t\t// trips FinishJob's clean-tree check. info/exclude is the repository's\n183\t\t\t// common git dir, so this covers every worktree of the repo.\n184\t\t\tif err := git.ExcludeMountTargets(wtPath); err != nil {\n185\t\t\t\treturn CreateResult{}, err\n186\t\t\t}\n187\t\t\tfmt.Fprintf(out, \"  Branch   : %s (based on %s)\\n\", branch, baseBranch)\n188\t\t\tfmt.Fprintf(out, \"  Worktree : %s\\n\", wtPath)\n189\t\n190\t\t\tjobDir := filepath.Join(wtPath, JobsRelDir, jobID+\"_\"+slug)\n191\t\t\tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n192\t\t\t\treturn CreateResult{}, err\n193\t\t\t}\n194\t\t\tif err := writeScaffold(jobDir, title, jobType, jobID, branch, date, author); err != nil {\n195\t\t\t\treturn CreateResult{}, err\n196\t\t\t}\n197\t\n198\t\t\t// The commit runs inside the job's own worktree (git -C <job-dir>),\n199\t\t\t// staging exactly the four new files.\n200\t\t\tif err := git.Stage(jobDir, \".\"); err != nil {\n201\t\t\t\treturn CreateResult{}, err\n202\t\t\t}\n203\t\t\tif err := git.CommitStaged(jobDir, \"Scaffold job \"+jobID+\"_\"+slug); err != nil {\n204\t\t\t\treturn CreateResult{}, err\n205\t\t\t}\n206\t\n207\t\t\tj, _ := ReadJob(jobDir)\n208\t\t\tres := CreateResult{Job: j, Branch: branch, WorktreePath: wtPath}\n209\t\t\tprintCreateSummary(out, res)\n210\t\t\treturn res, nil\n211\t\t}\n212\t\n213\t\t// ── Non-git path: plain directory scaffold ─────────────────────────────\n214\t\tfmt.Fprintln(out, \"  Warning  : not a git repository — skipping branch/worktree creation\")\n215\t\tjobDir := filepath.Join(root, JobsRelDir, jobID+\"_\"+slug)\n216\t\tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n217\t\t\treturn CreateResult{}, err\n218\t\t}\n219\t\tif err := writeScaffold(jobDir, title, jobType, jobID, \"(no git)\", date, author); err != nil {\n220\t\t\treturn CreateResult{}, err\n221\t\t}\n222\t\tj, _ := ReadJob(jobDir)\n223\t\tres := CreateResult{Job: j, Branch: \"(no git)\"}\n224\t\tprintCreateSummary(out, res)\n225\t\treturn res, nil\n226\t}\n227\t\n228\t// printCreateSummary writes the script's closing \"✓ Job created\" block to out.\n229\tfunc printCreateSummary(out io.Writer, r CreateResult) {\n230\t\tfmt.Fprintln(out, \"\")\n231\t\tfmt.Fprintf(out, \"✓ Job created: %s\\n\", r.Job.Name)\n232\t\tfmt.Fprintf(out, \"  Dir    : %s\\n\", r.Job.Dir)\n233\t\tfmt.Fprintf(out, \"  Branch : %s\\n\", r.Branch)\n234\t\tfmt.Fprintln(out, \"\")\n235\t\tfmt.Fprintln(out, \"  Next steps:\")\n236\t\tfmt.Fprintln(out, \"  1. Edit brief.md:\")\n237\t\tfmt.Fprintf(out, \"     %s/brief.md\\n\", r.Job.Dir)\n238\t\tfmt.Fprintln(out, \"  2. Run @owner or @analyst inside manigot\")\n239\t\tfmt.Fprintln(out, \"  3. Implement on this branch\")\n240\t\tfmt.Fprintln(out, \"  4. Merge when verdict is APPROVED\")\n241\t}\n242\t\n243\t// checkBranchNamespace ports new-job.sh's pre-flight namespace-collision\n244\t// check: git stores refs as filesystem paths, so a plain branch \"feature\"\n245\t// blocks the whole \"feature/...\" namespace. Every ancestor path segment of the\n246\t// branch name except the leaf <id>_<slug> is checked; a collision returns the\n247\t// script's exact error + fix hint.\n248\tfunc checkBranchNamespace(root, branch string) error {\n249\t\tseg := branch\n250\t\tif i := strings.LastIndex(seg, \"/\"); i >= 0 {\n251\t\t\tseg = seg[:i]\n252\t\t} else {\n253\t\t\treturn nil // no ancestor segments\n254\t\t}\n255\t\tfor seg != \"\" {\n256\t\t\tok, err := git.RefExists(root, seg)\n257\t\t\tif err != nil {\n258\t\t\t\treturn err\n259\t\t\t}\n260\t\t\tif ok {\n261\t\t\t\treturn fmt.Errorf(\"cannot create job branch '%s': a branch named '%s' already exists, which blocks the '%s/...' namespace.\\n  Set jobBranchPrefix in .manigot/manigot.json (or rename the conflicting branch) and retry.\", branch, seg, seg)\n262\t\t\t}\n263\t\t\tif !strings.Contains(seg, \"/\") {\n264\t\t\t\tbreak // a bare segment (e.g. \"jobs\") is the last ancestor\n265\t\t\t}\n266\t\t\tseg = seg[:strings.LastIndex(seg, \"/\")]\n267\t\t}\n268\t\treturn nil\n269\t}\n270\t\n271\t// slugify is the script's slug pipeline: lowercase, non-alphanumeric → \"-\",\n272\t// collapse runs, trim leading/trailing \"-\".\n273\tfunc slugify(title string) string {\n274\t\ts := strings.ToLower(title)\n275\t\ts = regexpNonAlnum.ReplaceAllString(s, \"-\")\n276\t\ts = regexpCollapseDash.ReplaceAllString(s, \"-\")\n277\t\treturn strings.Trim(s, \"-\")\n278\t}\n279\t\n280\tvar (\n281\t\tregexpNonAlnum     = regexp.MustCompile(`[^a-z0-9]`)\n282\t\tregexpCollapseDash = regexp.MustCompile(`-+`)\n283\t)\n284\t\n285\t// maxIDAttempts caps the uniqueness retry loop in uniqueJobID. With a\n286\t// ~2,300-word list the expected number of attempts stays near 1 until a\n287\t// project has hundreds of jobs, so the cap is a sanity guard against an\n288\t// exhausted word list, not a realistic limit.\n289\tconst maxIDAttempts = 100\n290\t\n291\t// uniqueJobID returns a job id that is guaranteed not to collide with any\n292\t// existing id in the project — the never-reuse policy (including against\n293\t// archived jobs). It re-draws from jobWords (via pick) until the candidate\n294\t// is acceptable: not an exact existing id, not a prefix of one, and not\n295\t// prefixed by one. The prefix rules matter because --job / mg done /\n296\t// mg delete resolve jobs by prefix-matching on branch tails: two\n297\t// prefix-related ids (e.g. \"flower\" and \"flowerbed\") would make\n298\t// `mg --job flower` ambiguous, so they must never coexist in the same\n299\t// project. A failed scan of existing ids fails the create rather than\n300\t// proceeding blind and risking a duplicate word.\n301\tfunc uniqueJobID(pick func() (string, error), existing func() (map[string]bool, error)) (string, error) {\n302\t\tids, err := existing()\n303\t\tif err != nil {\n304\t\t\treturn \"\", fmt.Errorf(\"scanning existing job ids: %w\", err)\n305\t\t}\n306\t\tfor range maxIDAttempts {\n307\t\t\tcandidate, err := pick()\n308\t\t\tif err != nil {\n309\t\t\t\treturn \"\", err\n310\t\t\t}\n311\t\t\tif idAvailable(candidate, ids) {\n312\t\t\t\treturn candidate, nil\n313\t\t\t}\n314\t\t}\n315\t\treturn \"\", fmt.Errorf(\"could not generate a unique job id after %d attempts — the word list is exhausted. Add words to internal/job/words.go.\", maxIDAttempts)\n316\t}\n317\t\n318\t// idAvailable reports whether candidate is free to use given the set of\n319\t// existing ids: it must not equal one, must not be a prefix of one, and must\n320\t// not have one as a prefix (see uniqueJobID for why the prefix rules exist).\n321\tfunc idAvailable(candidate string, existing map[string]bool) bool {\n322\t\tif existing[candidate] {\n323\t\t\treturn false\n324\t\t}\n325\t\tfor id := range existing {\n326\t\t\tif strings.HasPrefix(candidate, id) || strings.HasPrefix(id, candidate) {\n327\t\t\t\treturn false\n328\t\t\t}\n329\t\t}\n330\t\treturn true\n331\t}\n332\t\n333\t// wordID picks a uniformly random word from jobWords via crypto/rand. The\n334\t// 6-char a-z0-9 id it replaces had ~2.2e9 combinations; a single word from\n335\t// the ~2,300-word list is a far smaller space, so CreateJob couples this\n336\t// with the uniqueness retry loop in uniqueJobID — collisions are absorbed\n337\t// by re-drawing, never by failing.\n338\tfunc wordID() (string, error) {\n339\t\t// Rejection sampling on a uint16: 65536 is not a multiple of\n340\t\t// len(jobWords), so a naive `v % len` would overweight the first few\n341\t\t// words. Draw two random bytes, treat them as a 16-bit integer, and\n342\t\t// accept only values below the largest multiple of len(jobWords) below\n343\t\t// 65536, so every word is exactly as likely as every other.\n344\t\tconst max = 1 << 16\n345\t\tlimit := max - max%len(jobWords)\n346\t\tb := make([]byte, 2)\n347\t\tfor {\n348\t\t\tif _, err := rand.Read(b); err != nil {\n349\t\t\t\treturn \"\", err\n350\t\t\t}\n351\t\t\tv := int(b[0])<<8 | int(b[1])\n352\t\t\tif v < limit {\n353\t\t\t\treturn jobWords[v%len(jobWords)], nil\n354\t\t\t}\n355\t\t}\n356\t}\n357\t\n358\t// writeScaffold writes the four job files with content byte-identical to\n359\t// new-job.sh's heredocs. A slice of {name, content} pairs, not a map: the\n360\t// write order is deterministic (the files are independent, so a map's random\n361\t// order was harmless — fixed iteration is simply tidier).\n362\tfunc writeScaffold(dir, title, jobType, jobID, branch, date, author string) error {\n363\t\tfiles := []struct {\n364\t\t\tname    string\n365\t\t\tcontent string\n366\t\t}{\n367\t\t\t{\"brief.md\", fmt.Sprintf(`# Brief: %s\n368\t\n369\tstatus: open\n370\ttype: %s\n371\tid: %s\n372\tbranch: %s\n373\tdate: %s\n374\tauthor: %s\n375\t\n376\t## What\n377\t\n378\t<!-- What needs to be done? Be specific. -->\n379\t\n380\t## Why\n381\t\n382\t<!-- Why does this need to exist? What problem does it solve for the user? -->\n383\t\n384\t## Out of scope\n385\t\n386\t<!-- What are we explicitly NOT doing in this job? -->\n387\t\n388\t## Notes\n389\t\n390\t<!-- Anything the analyst or developer should know before starting. -->\n391\t`, title, jobType, jobID, branch, date, author)},\n392\t\t\t{\"tasks.md\", fmt.Sprintf(`# Tasks: %s\n393\t\n394\tid: %s\n395\tstatus: open\n396\tanalyst:\n397\tdate:\n398\t\n399\t<!-- Produced by @analyst from brief.md. -->\n400\t\n401\t## Task breakdown\n402\t\n403\t<!-- TASK-1: description\n404\t     files: list of files likely affected\n405\t     depends: none\n406\t     risk: low / medium / high — reason\n407\t\n408\tTASK-2: ...\n409\t-->\n410\t`, title, jobID)},\n411\t\t\t{\"implementation.md\", fmt.Sprintf(`# Implementation: %s\n412\t\n413\tid: %s\n414\tstatus: open\n415\tdeveloper:\n416\tdate:\n417\t\n418\t<!-- Produced by @developer after implementation. -->\n419\t\n420\t## Summary\n421\t\n422\t<!-- What was implemented, task by task. Reference task IDs. -->\n423\t\n424\t## Changes\n425\t\n426\t<!-- List of files changed and what changed in each. -->\n427\t\n428\t## Known issues / follow-ups\n429\t\n430\t<!-- Anything that came up during implementation that wasn't in scope but should be tracked. -->\n431\t`, title, jobID)},\n432\t\t\t{\"verdict.md\", fmt.Sprintf(`# Verdict: %s\n433\t\n434\tid: %s\n435\tstatus: open\n436\treviewer:\n437\tdate:\n438\t\n439\t<!-- Produced by @reviewer and/or @security after implementation. -->\n440\t\n441\t## Review\n442\t\n443\t<!-- TASK-1: PASS / FAIL / PARTIAL\n444\t     notes: ...\n445\t\n446\tTASK-2: ...\n447\t-->\n448\t\n449\t## Security\n450\t\n451\t<!-- Any security findings from @security, or \"none\" if not run. -->\n452\t\n453\t## Overall\n454\t\n455\t<!-- APPROVED / REJECTED / NEEDS WORK -->\n456\t<!-- Summary of what needs to change before this can be approved, if anything. -->\n457\t`, title, jobID)},\n458\t\t}\n459\t\tfor _, f := range files {\n460\t\t\tif err := os.WriteFile(filepath.Join(dir, f.name), []byte(f.content), 0o644); err != nil {\n461\t\t\t\treturn err\n462\t\t\t}\n463\t\t}\n464\t\treturn nil\n465\t}\n466\t\n467\t// sameDevice reports whether parent and root are on the same filesystem — the\n468\t// mount-point test of new-job.sh (`stat -c %d \"$(dirname …)\"` vs\n469\t// `stat -c %d …`). A difference means root crosses a mount boundary, so a\n470\t// sibling worktree would land outside the project's persistent storage.\n471\tfunc sameDevice(parent, root string) bool {\n472\t\tip, err := os.Stat(parent)\n473\t\tif err != nil {\n474\t\t\treturn true\n475\t\t}\n476\t\tir, err := os.Stat(root)\n477\t\tif err != nil {\n478\t\t\treturn true\n479\t\t}\n480\t\tsp, ok1 := ip.Sys().(*syscall.Stat_t)\n481\t\tsr, ok2 := ir.Sys().(*syscall.Stat_t)\n482\t\tif !ok1 || !ok2 {\n483\t\t\treturn true\n484\t\t}\n485\t\treturn sp.Dev == sr.Dev\n486\t}\n487\t"}]},"parent_tool_use_id":null,"session_id":"5af88135-9c7b-453b-b119-c245e62a60fb","uuid":"1f0e6ed6-b68a-4d2c-a7f8-379fbda6deae","timestamp":"2026-08-28T20:16:32.176Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/job/create.go","content":"package job\n\nimport (\n\t\"crypto/rand\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"strings\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// CreateOptions carries the optional knobs of CreateJob — the flags\n// new-job.sh accepted after the title.\ntype CreateOptions struct {\n\t// Type is the job type: feature (the default), fix, or chore.\n\tType string\n\n\t// BaseBranchOverride replaces the project's configured base branch for\n\t// this one invocation (new-job.sh's --base-branch).\n\tBaseBranchOverride string\n\n\t// DeviceCheck reports whether a worktree sibling of root would land on a\n\t// different filesystem (root itself is a mount point), which forces the\n\t// nested layout. nil uses the real stat-dev comparison. Injectable so\n\t// tests can force the nested layout without an actual second mount.\n\tDeviceCheck func(parent, root string) bool\n\n\t// RandomID generates the job id. nil uses the default word-based\n\t// generator — a uniform random pick from jobWords, wrapped in CreateJob's\n\t// uniqueness retry loop (uniqueJobID). Injectable so tests get a\n\t// deterministic id.\n\tRandomID func() (string, error)\n\n\t// ExistingIDs returns the set of job ids already in use in the project,\n\t// which the default uniqueness retry loop consults so a word id is never\n\t// re-used — including against archived jobs. nil uses the real scan\n\t// (existingJobIDs), covering open and archived jobs. Injectable so tests\n\t// can simulate collisions without a git repo.\n\tExistingIDs func() (map[string]bool, error)\n}\n\n// CreateResult is the outcome of a successful CreateJob.\ntype CreateResult struct {\n\t// Job is the created job, read back from disk (Dir is the absolute job\n\t// directory).\n\tJob Job\n\n\t// Branch is the resolved branch name, or \"(no git)\" for a non-git project\n\t// (mirroring the brief.md branch field new-job.sh wrote).\n\tBranch string\n\n\t// WorktreePath is the job's own worktree (\"\" for a non-git project).\n\tWorktreePath string\n}\n\n// CreateJob ports scripts/new-job.sh — the job-creation lifecycle: resolve the\n// settings, generate the id/slug/branch, create the job's own git worktree (or\n// fall back to a plain directory for a non-git project), write the four\n// scaffold files byte-identically to the script's templates, and make the\n// \"Scaffold job <id>_<slug>\" commit inside the worktree. The script's stdout\n// summary goes to out; all errors are returned with the script's exact\n// \"Error: ...\" wording (the caller decides where to print them).\n//\n// root is the project root (the docs/-walk-up the CLI resolves before calling\n// in; the TUI passes its own a.root). It is explicit rather than\n// cwd-derived so the TUI's in-process calls target the project the TUI was\n// opened on, not the TUI process's working directory.\nfunc CreateJob(root, title string, opts CreateOptions, out io.Writer) (CreateResult, error) {\n\tif root == \"\" {\n\t\treturn CreateResult{}, fmt.Errorf(\"could not find project root (no docs/ directory found).\")\n\t}\n\n\t// ── Resolve type + base branch + prefix ─────────────────────────────────\n\tjobType := opts.Type\n\tif jobType == \"\" {\n\t\tjobType = \"feature\"\n\t}\n\tswitch jobType {\n\tcase \"feature\", \"fix\", \"chore\":\n\tdefault:\n\t\treturn CreateResult{}, fmt.Errorf(\"Invalid type '%s'. Use: feature, fix, or chore.\", jobType)\n\t}\n\n\tsettings, err := project.Load(root)\n\tif err != nil {\n\t\treturn CreateResult{}, err\n\t}\n\tbaseBranch := settings.BaseBranchValue()\n\tif opts.BaseBranchOverride != \"\" {\n\t\tbaseBranch = opts.BaseBranchOverride\n\t}\n\n\t// ── Generate id, slug, date, author ─────────────────────────────────────\n\t// The default path wraps the word picker in a uniqueness retry loop so a\n\t// word id is never re-used (existingJobIDs covers open + archived jobs);\n\t// an injected RandomID bypasses the check, matching its test-only role.\n\tvar jobID string\n\tif opts.RandomID != nil {\n\t\tjobID, err = opts.RandomID()\n\t} else {\n\t\texisting := opts.ExistingIDs\n\t\tif existing == nil {\n\t\t\texisting = func() (map[string]bool, error) { return existingJobIDs(root) }\n\t\t}\n\t\tjobID, err = uniqueJobID(wordID, existing)\n\t}\n\tif err != nil {\n\t\treturn CreateResult{}, fmt.Errorf(\"generating job id: %w\", err)\n\t}\n\tslug := slugify(title)\n\tdate := time.Now().Format(\"2006-01-02\")\n\tauthor := git.ConfigUserName(root)\n\tif author == \"\" {\n\t\tauthor = \"unknown\"\n\t}\n\n\tbranch := settings.JobBranchPrefix\n\tif branch != \"\" {\n\t\tbranch += \"/\"\n\t}\n\tbranch += jobType + \"/\" + jobID + \"_\" + slug\n\n\t// Git vs non-git is decided on the no-branches signal, exactly like\n\t// new-job.sh: the script ran `git rev-parse --abbrev-ref HEAD`, which\n\t// FAILS on an unborn HEAD (a fresh repo before its first commit), so such\n\t// a repo took the non-git fallback. `git symbolic-ref --quiet --short HEAD`\n\t// instead SUCCEEDS on an unborn HEAD (it prints the unborn branch name),\n\t// which is why CurrentBranch is the wrong probe here. A repo with zero\n\t// local branches (fresh `git init`) takes the plain-directory fallback;\n\t// a non-repo (ErrNotARepo) takes it too. Any other git failure is real\n\t// and returned.\n\tbranches, err := git.LocalBranches(root)\n\tif err != nil && !errors.Is(err, git.ErrNotARepo) {\n\t\treturn CreateResult{}, err\n\t}\n\n\tif len(branches) > 0 {\n\t\t// ── Git path: branch + worktree ────────────────────────────────────\n\t\tif ok, err := git.RefExists(root, baseBranch); err != nil {\n\t\t\treturn CreateResult{}, err\n\t\t} else if !ok {\n\t\t\treturn CreateResult{}, fmt.Errorf(\"base branch '%s' does not exist; cannot create job branch from it.\", baseBranch)\n\t\t}\n\n\t\tif err := checkBranchNamespace(root, branch); err != nil {\n\t\t\treturn CreateResult{}, err\n\t\t}\n\n\t\t// Worktree layout: sibling of the project root by default; nested\n\t\t// inside it (with a .git/info/exclude entry) when the root is itself\n\t\t// a mount point and a sibling would land on another filesystem.\n\t\tparent := filepath.Join(filepath.Dir(root), \".manigot-worktrees\", filepath.Base(root))\n\t\tdc := opts.DeviceCheck\n\t\tif dc == nil {\n\t\t\tdc = func(parent, root string) bool { return !sameDevice(parent, root) }\n\t\t}\n\t\tif dc(filepath.Dir(root), root) {\n\t\t\tparent = filepath.Join(root, \".manigot-worktrees\")\n\t\t\tif err := git.ExcludePath(root, \".manigot-worktrees/\"); err != nil && !errors.Is(err, git.ErrNotARepo) {\n\t\t\t\treturn CreateResult{}, err\n\t\t\t}\n\t\t}\n\n\t\twtPath := filepath.Join(parent, jobID+\"_\"+slug)\n\t\tif err := os.MkdirAll(parent, 0o755); err != nil {\n\t\t\treturn CreateResult{}, err\n\t\t}\n\t\tif err := git.WorktreeAdd(root, wtPath, branch, baseBranch); err != nil {\n\t\t\treturn CreateResult{}, err\n\t\t}\n\t\t// Keep git from ever tracking the container's docs mount target path\n\t\t// (.opencode for OpenCode, .claude for Claude Code) in this worktree:\n\t\t// an agent staging job files through the mount would otherwise commit\n\t\t// a stale duplicate of the job under the colliding path, which later\n\t\t// trips FinishJob's clean-tree check. info/exclude is the repository's\n\t\t// common git dir, so this covers every worktree of the repo.\n\t\tif err := git.ExcludeMountTargets(wtPath); err != nil {\n\t\t\treturn CreateResult{}, err\n\t\t}\n\t\tfmt.Fprintf(out, \"  Branch   : %s (based on %s)\\n\", branch, baseBranch)\n\t\tfmt.Fprintf(out, \"  Worktree : %s\\n\", wtPath)\n\n\t\tjobDir := filepath.Join(wtPath, JobsRelDir, jobID+\"_\"+slug)\n\t\tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n\t\t\treturn CreateResult{}, err\n\t\t}\n\t\tif err := writeScaffold(jobDir, title, jobType, jobID, branch, date, author); err != nil {\n\t\t\treturn CreateResult{}, err\n\t\t}\n\n\t\t// The commit runs inside the job's own worktree (git -C <job-dir>),\n\t\t// staging exactly the four new files.\n\t\tif err := git.Stage(jobDir, \".\"); err != nil {\n\t\t\treturn CreateResult{}, err\n\t\t}\n\t\tif err := git.CommitStaged(jobDir, \"Scaffold job \"+jobID+\"_\"+slug); err != nil {\n\t\t\treturn CreateResult{}, err\n\t\t}\n\n\t\tj, _ := ReadJob(jobDir)\n\t\tres := CreateResult{Job: j, Branch: branch, WorktreePath: wtPath}\n\t\tprintCreateSummary(out, res)\n\t\treturn res, nil\n\t}\n\n\t// ── Non-git path: plain directory scaffold ─────────────────────────────\n\tfmt.Fprintln(out, \"  Warning  : not a git repository — skipping branch/worktree creation\")\n\tjobDir := filepath.Join(root, JobsRelDir, jobID+\"_\"+slug)\n\tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n\t\treturn CreateResult{}, err\n\t}\n\tif err := writeScaffold(jobDir, title, jobType, jobID, \"(no git)\", date, author); err != nil {\n\t\treturn CreateResult{}, err\n\t}\n\tj, _ := ReadJob(jobDir)\n\tres := CreateResult{Job: j, Branch: \"(no git)\"}\n\tprintCreateSummary(out, res)\n\treturn res, nil\n}\n\n// printCreateSummary writes the script's closing \"✓ Job created\" block to out.\nfunc printCreateSummary(out io.Writer, r CreateResult) {\n\tfmt.Fprintln(out, \"\")\n\tfmt.Fprintf(out, \"✓ Job created: %s\\n\", r.Job.Name)\n\tfmt.Fprintf(out, \"  Dir    : %s\\n\", r.Job.Dir)\n\tfmt.Fprintf(out, \"  Branch : %s\\n\", r.Branch)\n\tfmt.Fprintln(out, \"\")\n\tfmt.Fprintln(out, \"  Next steps:\")\n\tfmt.Fprintln(out, \"  1. Edit brief.md:\")\n\tfmt.Fprintf(out, \"     %s/brief.md\\n\", r.Job.Dir)\n\tfmt.Fprintln(out, \"  2. Run @owner or @analyst inside manigot\")\n\tfmt.Fprintln(out, \"  3. Implement on this branch\")\n\tfmt.Fprintln(out, \"  4. Merge when verdict is APPROVED\")\n}\n\n// checkBranchNamespace ports new-job.sh's pre-flight namespace-collision\n// check: git stores refs as filesystem paths, so a plain branch \"feature\"\n// blocks the whole \"feature/...\" namespace. Every ancestor path segment of the\n// branch name except the leaf <id>_<slug> is checked; a collision returns the\n// script's exact error + fix hint.\nfunc checkBranchNamespace(root, branch string) error {\n\tseg := branch\n\tif i := strings.LastIndex(seg, \"/\"); i >= 0 {\n\t\tseg = seg[:i]\n\t} else {\n\t\treturn nil // no ancestor segments\n\t}\n\tfor seg != \"\" {\n\t\tok, err := git.RefExists(root, seg)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif ok {\n\t\t\treturn fmt.Errorf(\"cannot create job branch '%s': a branch named '%s' already exists, which blocks the '%s/...' namespace.\\n  Set jobBranchPrefix in .manigot/manigot.json (or rename the conflicting branch) and retry.\", branch, seg, seg)\n\t\t}\n\t\tif !strings.Contains(seg, \"/\") {\n\t\t\tbreak // a bare segment (e.g. \"jobs\") is the last ancestor\n\t\t}\n\t\tseg = seg[:strings.LastIndex(seg, \"/\")]\n\t}\n\treturn nil\n}\n\n// slugify is the script's slug pipeline: lowercase, non-alphanumeric → \"-\",\n// collapse runs, trim leading/trailing \"-\".\nfunc slugify(title string) string {\n\ts := strings.ToLower(title)\n\ts = regexpNonAlnum.ReplaceAllString(s, \"-\")\n\ts = regexpCollapseDash.ReplaceAllString(s, \"-\")\n\treturn strings.Trim(s, \"-\")\n}\n\nvar (\n\tregexpNonAlnum     = regexp.MustCompile(`[^a-z0-9]`)\n\tregexpCollapseDash = regexp.MustCompile(`-+`)\n)\n\n// maxIDAttempts caps the uniqueness retry loop in uniqueJobID. With a\n// ~2,300-word list the expected number of attempts stays near 1 until a\n// project has hundreds of jobs, so the cap is a sanity guard against an\n// exhausted word list, not a realistic limit.\nconst maxIDAttempts = 100\n\n// uniqueJobID returns a job id that is guaranteed not to collide with any\n// existing id in the project — the never-reuse policy (including against\n// archived jobs). It re-draws from jobWords (via pick) until the candidate\n// is acceptable: not an exact existing id, not a prefix of one, and not\n// prefixed by one. The prefix rules matter because --job / mg done /\n// mg delete resolve jobs by prefix-matching on branch tails: two\n// prefix-related ids (e.g. \"flower\" and \"flowerbed\") would make\n// `mg --job flower` ambiguous, so they must never coexist in the same\n// project. A failed scan of existing ids fails the create rather than\n// proceeding blind and risking a duplicate word.\nfunc uniqueJobID(pick func() (string, error), existing func() (map[string]bool, error)) (string, error) {\n\tids, err := existing()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"scanning existing job ids: %w\", err)\n\t}\n\tfor range maxIDAttempts {\n\t\tcandidate, err := pick()\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tif idAvailable(candidate, ids) {\n\t\t\treturn candidate, nil\n\t\t}\n\t}\n\treturn \"\", fmt.Errorf(\"could not generate a unique job id after %d attempts — the word list is exhausted. Add words to internal/job/words.go.\", maxIDAttempts)\n}\n\n// idAvailable reports whether candidate is free to use given the set of\n// existing ids: it must not equal one, must not be a prefix of one, and must\n// not have one as a prefix (see uniqueJobID for why the prefix rules exist).\nfunc idAvailable(candidate string, existing map[string]bool) bool {\n\tif existing[candidate] {\n\t\treturn false\n\t}\n\tfor id := range existing {\n\t\tif strings.HasPrefix(candidate, id) || strings.HasPrefix(id, candidate) {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\n// wordID picks a uniformly random word from jobWords via crypto/rand. The\n// 6-char a-z0-9 id it replaces had ~2.2e9 combinations; a single word from\n// the ~2,300-word list is a far smaller space, so CreateJob couples this\n// with the uniqueness retry loop in uniqueJobID — collisions are absorbed\n// by re-drawing, never by failing.\nfunc wordID() (string, error) {\n\t// Rejection sampling on a uint16: 65536 is not a multiple of\n\t// len(jobWords), so a naive `v % len` would overweight the first few\n\t// words. Draw two random bytes, treat them as a 16-bit integer, and\n\t// accept only values below the largest multiple of len(jobWords) below\n\t// 65536, so every word is exactly as likely as every other.\n\tconst max = 1 << 16\n\tlimit := max - max%len(jobWords)\n\tb := make([]byte, 2)\n\tfor {\n\t\tif _, err := rand.Read(b); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tv := int(b[0])<<8 | int(b[1])\n\t\tif v < limit {\n\t\t\treturn jobWords[v%len(jobWords)], nil\n\t\t}\n\t}\n}\n\n// writeScaffold writes the four job files with content byte-identical to\n// new-job.sh's heredocs. A slice of {name, content} pairs, not a map: the\n// write order is deterministic (the files are independent, so a map's random\n// order was harmless — fixed iteration is simply tidier).\nfunc writeScaffold(dir, title, jobType, jobID, branch, date, author string) error {\n\tfiles := []struct {\n\t\tname    string\n\t\tcontent string\n\t}{\n\t\t{\"brief.md\", fmt.Sprintf(`# Brief: %s\n\nstatus: open\ntype: %s\nid: %s\nbranch: %s\ndate: %s\nauthor: %s\n\n## What\n\n<!-- What needs to be done? Be specific. -->\n\n## Why\n\n<!-- Why does this need to exist? What problem does it solve for the user? -->\n\n## Out of scope\n\n<!-- What are we explicitly NOT doing in this job? -->\n\n## Notes\n\n<!-- Anything the analyst or developer should know before starting. -->\n`, title, jobType, jobID, branch, date, author)},\n\t\t{\"tasks.md\", fmt.Sprintf(`# Tasks: %s\n\nid: %s\nstatus: open\nanalyst:\ndate:\n\n<!-- Produced by @analyst from brief.md. -->\n\n## Task breakdown\n\n<!-- TASK-1: description\n     files: list of files likely affected\n     depends: none\n     risk: low / medium / high — reason\n\nTASK-2: ...\n-->\n`, title, jobID)},\n\t\t{\"implementation.md\", fmt.Sprintf(`# Implementation: %s\n\nid: %s\nstatus: open\ndeveloper:\ndate:\n\n<!-- Produced by @developer after implementation. -->\n\n## Summary\n\n<!-- What was implemented, task by task. Reference task IDs. -->\n\n## Changes\n\n<!-- List of files changed and what changed in each. -->\n\n## Known issues / follow-ups\n\n<!-- Anything that came up during implementation that wasn't in scope but should be tracked. -->\n`, title, jobID)},\n\t\t{\"verdict.md\", fmt.Sprintf(`# Verdict: %s\n\nid: %s\nstatus: open\nreviewer:\ndate:\n\n<!-- Produced by @reviewer and/or @security after implementation. -->\n\n## Review\n\n<!-- TASK-1: PASS / FAIL / PARTIAL\n     notes: ...\n\nTASK-2: ...\n-->\n\n## Security\n\n<!-- Any security findings from @security, or \"none\" if not run. -->\n\n## Overall\n\n<!-- APPROVED / REJECTED / NEEDS WORK -->\n<!-- Summary of what needs to change before this can be approved, if anything. -->\n`, title, jobID)},\n\t}\n\tfor _, f := range files {\n\t\tif err := os.WriteFile(filepath.Join(dir, f.name), []byte(f.content), 0o644); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\n// sameDevice reports whether parent and root are on the same filesystem — the\n// mount-point test of new-job.sh (`stat -c %d \"$(dirname …)\"` vs\n// `stat -c %d …`). A difference means root crosses a mount boundary, so a\n// sibling worktree would land outside the project's persistent storage.\nfunc sameDevice(parent, root string) bool {\n\tip, err := os.Stat(parent)\n\tif err != nil {\n\t\treturn true\n\t}\n\tir, err := os.Stat(root)\n\tif err != nil {\n\t\treturn true\n\t}\n\tsp, ok1 := ip.Sys().(*syscall.Stat_t)\n\tsr, ok2 := ir.Sys().(*syscall.Stat_t)\n\tif !ok1 || !ok2 {\n\t\treturn true\n\t}\n\treturn sp.Dev == sr.Dev\n}\n","numLines":487,"startLine":1,"totalLines":487}}}
