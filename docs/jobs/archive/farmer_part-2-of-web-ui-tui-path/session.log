{"type":"tool_use","timestamp":1787950617258,"sessionID":"ses_fb5dcd7a6ffeSGBPKFVeVpziRm","part":{"type":"tool","tool":"read","callID":"call_fefea92a8aa74aa1bf4cdd58","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/job/discover.go"},"output":"<path>/workspace/src/internal/job/discover.go</path>\n<type>file</type>\n<content>\n1: package job\n2: \n3: import (\n4: \t\"os\"\n5: \t\"path/filepath\"\n6: \t\"sort\"\n7: \t\"strings\"\n8: \n9: \t\"github.com/lmuskalla/manigot/internal/git\"\n10: )\n11: \n12: // JobsRelDir is where live jobs live, relative to the project root.\n13: const JobsRelDir = \"docs/jobs\"\n14: \n15: // ArchiveDirName is the subdirectory under JobsRelDir that holds finished\n16: // jobs. mg done moves done jobs here, and discovery excludes it.\n17: const ArchiveDirName = \"archive\"\n18: \n19: // FindProjectRoot walks up from the current working directory until it finds a\n20: // directory containing a docs/ subdirectory — the shared project-root walk-up\n21: // the session launcher and the CLI commands all use.\n22: //\n23: // It returns (\"\", nil) when no such directory exists before the filesystem\n24: // root (or before the invoking directory's own git repo boundary, when it's\n25: // inside one — see FindProjectRootFrom) — the same convention the bash\n26: // scripts use (empty string means \"not found\"). An error is only returned if\n27: // the working directory itself cannot be determined.\n28: func FindProjectRoot() (string, error) {\n29: \tdir, err := os.Getwd()\n30: \tif err != nil {\n31: \t\treturn \"\", err\n32: \t}\n33: \treturn FindProjectRootFrom(dir)\n34: }\n35: \n36: // FindProjectRootFrom is FindProjectRoot's parameterized form: it walks up\n37: // from startDir instead of the process's working directory. The session\n38: // launcher uses it to resolve a project from an explicit root (mg-jdi runs\n39: // its --print invocations against the project it was started in, not the\n40: // process cwd).\n41: //\n42: // The walk-up never crosses the invoking directory's own git repo boundary:\n43: // a project's path must always be respected as-is, so a repo nested inside\n44: // another repo's working copy (each with its own .git — e.g. a sub-project\n45: // checked out inside a monorepo) must never have its root resolved to the\n46: // outer repo just because the outer one happens to have a docs/ dir and the\n47: // inner one doesn't yet. When startDir is inside a git repo, reaching that\n48: // repo's toplevel without finding docs/ stops the walk right there.\n49: func FindProjectRootFrom(startDir string) (string, error) {\n50: \ttoplevel, gitErr := git.RevParseToplevel(startDir)\n51: \tdir := startDir\n52: \tfor {\n53: \t\tif fi, statErr := os.Stat(filepath.Join(dir, \"docs\")); statErr == nil && fi.IsDir() {\n54: \t\t\treturn filepath.Clean(dir), nil\n55: \t\t}\n56: \t\tif gitErr == nil && filepath.Clean(dir) == filepath.Clean(toplevel) {\n57: \t\t\t// Reached this repo's boundary without finding docs/ — never\n58: \t\t\t// cross into a parent/unrelated git repo beyond it.\n59: \t\t\treturn \"\", nil\n60: \t\t}\n61: \t\tparent := filepath.Dir(dir)\n62: \t\tif parent == dir {\n63: \t\t\t// Reached the filesystem root without finding docs/.\n64: \t\t\treturn \"\", nil\n65: \t\t}\n66: \t\tdir = parent\n67: \t}\n68: }\n69: \n70: // Discover enumerates every open job: each\n71: // job lives in its own git worktree (created by mg job), so for\n72: // every local branch that has a registered worktree (via\n73: // git.WorktreeForBranch), Discover reads whatever job directories exist under\n74: // that worktree's own docs/jobs/ straight off disk.\n75: //\n76: // The main worktree (root itself) is scanned like any other worktree, not\n77: // skipped. In steady state it sits on the base branch and its docs/jobs/\n78: // holds nothing but archive/ (excluded below), so it contributes nothing; but\n79: // a pre-worktree job whose branch is still checked out in the main worktree —\n80: // the transitional case this change itself is in — IS listed, so the TUI and\n81: // mg-jdi keep working on it. Its Branch is the main worktree's checked-out\n82: // branch, which is authoritative for it.\n83: //\n84: // Every job's brief.md is read from its own worktree's working tree (no\n85: // branch check, no `git show`) — a job's own worktree is unconditionally the\n86: // live, correct checkout for it.\n87: //\n88: // A directory under docs/jobs/ only counts as a job if it has a brief.md —\n89: // the file mg job's scaffold always writes. This is what keeps the main\n90: // worktree's non-job content (a stray empty directory, or anything else\n91: // without a brief.md) from being mislisted as a job — mg-jdi's status/run.log\n92: // sidecar lives under .manigot/jdi-status/, outside docs/jobs/ entirely —\n93: // matching the pre-worktree enumeration, which only ever saw tracked job\n94: // directories via `git ls-tree`.\n95: //\n96: // Graceful fallback: a non-repo (git unavailable) or a repo with no branches\n97: // yet (an unborn HEAD, before worktrees are even possible) falls back to the\n98: // old working-tree-only enumeration (discoverWorkingTree), so a project that\n99: // isn't under git — or a fresh repo before its first commit — keeps behaving\n100: // exactly as before.\n101: func Discover(root string) ([]Job, error) {\n102: \tbranches, err := git.LocalBranches(root)\n103: \tif err != nil || len(branches) == 0 {\n104: \t\treturn discoverWorkingTree(root)\n105: \t}\n106: \n107: \tvar jobs []Job\n108: \tfor _, branch := range branches {\n109: \t\twtPath, ok, werr := git.WorktreeForBranch(root, branch)\n110: \t\tif werr != nil || !ok {\n111: \t\t\tcontinue\n112: \t\t}\n113: \n114: \t\tjobsDir := filepath.Join(wtPath, JobsRelDir)\n115: \t\tentries, derr := os.ReadDir(jobsDir)\n116: \t\tif derr != nil {\n117: \t\t\t// No docs/jobs under this worktree at all — not a job worktree\n118: \t\t\t// (or the read simply failed); either way, nothing to list here.\n119: \t\t\tcontinue\n120: \t\t}\n121: \t\tfor _, e := range entries {\n122: \t\t\tif !e.IsDir() || e.Name() == ArchiveDirName {\n123: \t\t\t\tcontinue\n124: \t\t\t}\n125: \t\t\tjobDir := filepath.Join(jobsDir, e.Name())\n126: \t\t\tif _, serr := os.Stat(filepath.Join(jobDir, \"brief.md\")); serr != nil {\n127: \t\t\t\t// No brief.md — not a job (a stray empty directory, or\n128: \t\t\t\t// anything else without a brief.md). ReadJob's\n129: \t\t\t\t// half-formed-job tolerance still applies once a job dir\n130: \t\t\t\t// is identified.\n131: \t\t\t\tcontinue\n132: \t\t\t}\n133: \t\t\tj, _ := ReadJob(jobDir) // ReadJob never hard-fails; see its doc.\n134: \t\t\tj.Root = root\n135: \t\t\tj.Branch = branch // the worktree's own branch is authoritative.\n136: \t\t\tjobs = append(jobs, j)\n137: \t\t}\n138: \t}\n139: \n140: \tsortJobs(jobs)\n141: \treturn jobs, nil\n142: }\n143: \n144: // discoverWorkingTree is the pre-worktree enumeration: list docs/jobs/* in\n145: // the working tree only, excluding archive/. Used as the not-a-repo /\n146: // no-branches fallback, so projects that aren't under git (or a fresh repo\n147: // before its first commit) keep working exactly as before.\n148: func discoverWorkingTree(root string) ([]Job, error) {\n149: \tjobsDir := filepath.Join(root, JobsRelDir)\n150: \tentries, err := os.ReadDir(jobsDir)\n151: \tif err != nil {\n152: \t\tif os.IsNotExist(err) {\n153: \t\t\treturn nil, nil\n154: \t\t}\n155: \t\treturn nil, err\n156: \t}\n157: \n158: \tjobs := make([]Job, 0, len(entries))\n159: \tfor _, e := range entries {\n160: \t\tif !e.IsDir() {\n161: \t\t\tcontinue\n162: \t\t}\n163: \t\tif e.Name() == ArchiveDirName {\n164: \t\t\tcontinue\n165: \t\t}\n166: \t\tdir := filepath.Join(jobsDir, e.Name())\n167: \t\tj, _ := ReadJob(dir) // ReadJob never hard-fails; see its docs.\n168: \t\tj.Root = root\n169: \t\tjobs = append(jobs, j)\n170: \t}\n171: \n172: \tsortJobs(jobs)\n173: \treturn jobs, nil\n174: }\n175: \n176: // PrefixJobDirName returns the first directory name (not the full path)\n177: // under root's docs/jobs/ whose name starts with prefix, excluding archive/ —\n178: // the deterministic stand-in for the scripts' `find docs/jobs -maxdepth 1\n179: // -type d -name '<prefix>*' -not -name archive | head -1`. Returns \"\" when\n180: // there is none; callers join the root themselves. The single docs/jobs scan\n181: // shared by the --job no-branches fallback (session) and the non-git delete\n182: // path (job).\n183: func PrefixJobDirName(root, prefix string) string {\n184: \tjobsDir := filepath.Join(root, JobsRelDir)\n185: \tentries, err := os.ReadDir(jobsDir)\n186: \tif err != nil {\n187: \t\treturn \"\"\n188: \t}\n189: \t// os.ReadDir already sorts by name.\n190: \tfor _, e := range entries {\n191: \t\tif !e.IsDir() || e.Name() == ArchiveDirName {\n192: \t\t\tcontinue\n193: \t\t}\n194: \t\tif strings.HasPrefix(e.Name(), prefix) {\n195: \t\t\treturn e.Name()\n196: \t\t}\n197: \t}\n198: \treturn \"\"\n199: }\n200: \n201: // existingJobIDs returns the set of every job id already in use in the\n202: // project rooted at root — open jobs (from Discover, which covers the\n203: // worktree-per-branch layout and falls back to the working tree for non-git\n204: // or branchless repos) plus archived jobs in docs/jobs/archive/. CreateJob\n205: // uses it to guarantee a word id is never re-used, including against jobs\n206: // that were archived long ago (the confirmed never-reuse policy). Old random\n207: // ids (e.g. \"irw320\") are ordinary set members; mixed old/new formats are\n208: // handled uniformly.\n209: func existingJobIDs(root string) (map[string]bool, error) {\n210: \tids := make(map[string]bool)\n211: \tjobs, err := Discover(root)\n212: \tif err != nil {\n213: \t\treturn nil, err\n214: \t}\n215: \tfor _, j := range jobs {\n216: \t\tids[j.ID] = true\n217: \t}\n218: \n219: \tarchiveDir := filepath.Join(root, JobsRelDir, ArchiveDirName)\n220: \tentries, err := os.ReadDir(archiveDir)\n221: \tif err != nil {\n222: \t\tif os.IsNotExist(err) {\n223: \t\t\treturn ids, nil\n224: \t\t}\n225: \t\treturn nil, err\n226: \t}\n227: \tfor _, e := range entries {\n228: \t\tif !e.IsDir() {\n229: \t\t\tcontinue\n230: \t\t}\n231: \t\tj, _ := ReadJob(filepath.Join(archiveDir, e.Name()))\n232: \t\tids[j.ID] = true\n233: \t}\n234: \treturn ids, nil\n235: }\n236: \n237: // sortJobs orders jobs by date descending (newest first) with Name as a stable\n238: // tiebreaker — the \"recent work first\" ordering the README's job workflow\n239: // implies. Shared by both the worktree-backed and working-tree paths.\n240: func sortJobs(jobs []Job) {\n241: \tsort.SliceStable(jobs, func(i, j int) bool {\n242: \t\tif jobs[i].Date != jobs[j].Date {\n243: \t\t\treturn jobs[i].Date > jobs[j].Date\n244: \t\t}\n245: \t\treturn jobs[i].Name < jobs[j].Name\n246: \t})\n247: }\n\n(End of file - total 247 lines)\n</content>","metadata":{"preview":"package job\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/git\"\n)\n\n// JobsRelDir is where live jobs live, relative to the project root.\nconst JobsRelDir = \"docs/jobs\"\n\n// ArchiveDirName is the subdirectory under JobsRelDir that holds finished\n// jobs. mg done moves done jobs here, and discovery excludes it.\nconst ArchiveDirName = \"archive\"\n\n// FindProjectRoot walks up from the current working directory until it finds a\n// directory containing a docs/ subdirectory — the shared project-root walk-up","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/job/discover.go","text":"package job\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/git\"\n)\n\n// JobsRelDir is where live jobs live, relative to the project root.\nconst JobsRelDir = \"docs/jobs\"\n\n// ArchiveDirName is the subdirectory under JobsRelDir that holds finished\n// jobs. mg done moves done jobs here, and discovery excludes it.\nconst ArchiveDirName = \"archive\"\n\n// FindProjectRoot walks up from the current working directory until it finds a\n// directory containing a docs/ subdirectory — the shared project-root walk-up\n// the session launcher and the CLI commands all use.\n//\n// It returns (\"\", nil) when no such directory exists before the filesystem\n// root (or before the invoking directory's own git repo boundary, when it's\n// inside one — see FindProjectRootFrom) — the same convention the bash\n// scripts use (empty string means \"not found\"). An error is only returned if\n// the working directory itself cannot be determined.\nfunc FindProjectRoot() (string, error) {\n\tdir, err := os.Getwd()\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn FindProjectRootFrom(dir)\n}\n\n// FindProjectRootFrom is FindProjectRoot's parameterized form: it walks up\n// from startDir instead of the process's working directory. The session\n// launcher uses it to resolve a project from an explicit root (mg-jdi runs\n// its --print invocations against the project it was started in, not the\n// process cwd).\n//\n// The walk-up never crosses the invoking directory's own git repo boundary:\n// a project's path must always be respected as-is, so a repo nested inside\n// another repo's working copy (each with its own .git — e.g. a sub-project\n// checked out inside a monorepo) must never have its root resolved to the\n// outer repo just because the outer one happens to have a docs/ dir and the\n// inner one doesn't yet. When startDir is inside a git repo, reaching that\n// repo's toplevel without finding docs/ stops the walk right there.\nfunc FindProjectRootFrom(startDir string) (string, error) {\n\ttoplevel, gitErr := git.RevParseToplevel(startDir)\n\tdir := startDir\n\tfor {\n\t\tif fi, statErr := os.Stat(filepath.Join(dir, \"docs\")); statErr == nil && fi.IsDir() {\n\t\t\treturn filepath.Clean(dir), nil\n\t\t}\n\t\tif gitErr == nil && filepath.Clean(dir) == filepath.Clean(toplevel) {\n\t\t\t// Reached this repo's boundary without finding docs/ — never\n\t\t\t// cross into a parent/unrelated git repo beyond it.\n\t\t\treturn \"\", nil\n\t\t}\n\t\tparent := filepath.Dir(dir)\n\t\tif parent == dir {\n\t\t\t// Reached the filesystem root without finding docs/.\n\t\t\treturn \"\", nil\n\t\t}\n\t\tdir = parent\n\t}\n}\n\n// Discover enumerates every open job: each\n// job lives in its own git worktree (created by mg job), so for\n// every local branch that has a registered worktree (via\n// git.WorktreeForBranch), Discover reads whatever job directories exist under\n// that worktree's own docs/jobs/ straight off disk.\n//\n// The main worktree (root itself) is scanned like any other worktree, not\n// skipped. In steady state it sits on the base branch and its docs/jobs/\n// holds nothing but archive/ (excluded below), so it contributes nothing; but\n// a pre-worktree job whose branch is still checked out in the main worktree —\n// the transitional case this change itself is in — IS listed, so the TUI and\n// mg-jdi keep working on it. Its Branch is the main worktree's checked-out\n// branch, which is authoritative for it.\n//\n// Every job's brief.md is read from its own worktree's working tree (no\n// branch check, no `git show`) — a job's own worktree is unconditionally the\n// live, correct checkout for it.\n//\n// A directory under docs/jobs/ only counts as a job if it has a brief.md —\n// the file mg job's scaffold always writes. This is what keeps the main\n// worktree's non-job content (a stray empty directory, or anything else\n// without a brief.md) from being mislisted as a job — mg-jdi's status/run.log\n// sidecar lives under .manigot/jdi-status/, outside docs/jobs/ entirely —\n// matching the pre-worktree enumeration, which only ever saw tracked job\n// directories via `git ls-tree`.\n//\n// Graceful fallback: a non-repo (git unavailable) or a repo with no branches\n// yet (an unborn HEAD, before worktrees are even possible) falls back to the\n// old working-tree-only enumeration (discoverWorkingTree), so a project that\n// isn't under git — or a fresh repo before its first commit — keeps behaving\n// exactly as before.\nfunc Discover(root string) ([]Job, error) {\n\tbranches, err := git.LocalBranches(root)\n\tif err != nil || len(branches) == 0 {\n\t\treturn discoverWorkingTree(root)\n\t}\n\n\tvar jobs []Job\n\tfor _, branch := range branches {\n\t\twtPath, ok, werr := git.WorktreeForBranch(root, branch)\n\t\tif werr != nil || !ok {\n\t\t\tcontinue\n\t\t}\n\n\t\tjobsDir := filepath.Join(wtPath, JobsRelDir)\n\t\tentries, derr := os.ReadDir(jobsDir)\n\t\tif derr != nil {\n\t\t\t// No docs/jobs under this worktree at all — not a job worktree\n\t\t\t// (or the read simply failed); either way, nothing to list here.\n\t\t\tcontinue\n\t\t}\n\t\tfor _, e := range entries {\n\t\t\tif !e.IsDir() || e.Name() == ArchiveDirName {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tjobDir := filepath.Join(jobsDir, e.Name())\n\t\t\tif _, serr := os.Stat(filepath.Join(jobDir, \"brief.md\")); serr != nil {\n\t\t\t\t// No brief.md — not a job (a stray empty directory, or\n\t\t\t\t// anything else without a brief.md). ReadJob's\n\t\t\t\t// half-formed-job tolerance still applies once a job dir\n\t\t\t\t// is identified.\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tj, _ := ReadJob(jobDir) // ReadJob never hard-fails; see its doc.\n\t\t\tj.Root = root\n\t\t\tj.Branch = branch // the worktree's own branch is authoritative.\n\t\t\tjobs = append(jobs, j)\n\t\t}\n\t}\n\n\tsortJobs(jobs)\n\treturn jobs, nil\n}\n\n// discoverWorkingTree is the pre-worktree enumeration: list docs/jobs/* in\n// the working tree only, excluding archive/. Used as the not-a-repo /\n// no-branches fallback, so projects that aren't under git (or a fresh repo\n// before its first commit) keep working exactly as before.\nfunc discoverWorkingTree(root string) ([]Job, error) {\n\tjobsDir := filepath.Join(root, JobsRelDir)\n\tentries, err := os.ReadDir(jobsDir)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn nil, nil\n\t\t}\n\t\treturn nil, err\n\t}\n\n\tjobs := make([]Job, 0, len(entries))\n\tfor _, e := range entries {\n\t\tif !e.IsDir() {\n\t\t\tcontinue\n\t\t}\n\t\tif e.Name() == ArchiveDirName {\n\t\t\tcontinue\n\t\t}\n\t\tdir := filepath.Join(jobsDir, e.Name())\n\t\tj, _ := ReadJob(dir) // ReadJob never hard-fails; see its docs.\n\t\tj.Root = root\n\t\tjobs = append(jobs, j)\n\t}\n\n\tsortJobs(jobs)\n\treturn jobs, nil\n}\n\n// PrefixJobDirName returns the first directory name (not the full path)\n// under root's docs/jobs/ whose name starts with prefix, excluding archive/ —\n// the deterministic stand-in for the scripts' `find docs/jobs -maxdepth 1\n// -type d -name '<prefix>*' -not -name archive | head -1`. Returns \"\" when\n// there is none; callers join the root themselves. The single docs/jobs scan\n// shared by the --job no-branches fallback (session) and the non-git delete\n// path (job).\nfunc PrefixJobDirName(root, prefix string) string {\n\tjobsDir := filepath.Join(root, JobsRelDir)\n\tentries, err := os.ReadDir(jobsDir)\n\tif err != nil {\n\t\treturn \"\"\n\t}\n\t// os.ReadDir already sorts by name.\n\tfor _, e := range entries {\n\t\tif !e.IsDir() || e.Name() == ArchiveDirName {\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(e.Name(), prefix) {\n\t\t\treturn e.Name()\n\t\t}\n\t}\n\treturn \"\"\n}\n\n// existingJobIDs returns the set of every job id already in use in the\n// project rooted at root — open jobs (from Discover, which covers the\n// worktree-per-branch layout and falls back to the working tree for non-git\n// or branchless repos) plus archived jobs in docs/jobs/archive/. CreateJob\n// uses it to guarantee a word id is never re-used, including against jobs\n// that were archived long ago (the confirmed never-reuse policy). Old random\n// ids (e.g. \"irw320\") are ordinary set members; mixed old/new formats are\n// handled uniformly.\nfunc existingJobIDs(root string) (map[string]bool, error) {\n\tids := make(map[string]bool)\n\tjobs, err := Discover(root)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tfor _, j := range jobs {\n\t\tids[j.ID] = true\n\t}\n\n\tarchiveDir := filepath.Join(root, JobsRelDir, ArchiveDirName)\n\tentries, err := os.ReadDir(archiveDir)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn ids, nil\n\t\t}\n\t\treturn nil, err\n\t}\n\tfor _, e := range entries {\n\t\tif !e.IsDir() {\n\t\t\tcontinue\n\t\t}\n\t\tj, _ := ReadJob(filepath.Join(archiveDir, e.Name()))\n\t\tids[j.ID] = true\n\t}\n\treturn ids, nil\n}\n\n// sortJobs orders jobs by date descending (newest first) with Name as a stable\n// tiebreaker — the \"recent work first\" ordering the README's job workflow\n// implies. Shared by both the worktree-backed and working-tree paths.\nfunc sortJobs(jobs []Job) {\n\tsort.SliceStable(jobs, func(i, j int) bool {\n\t\tif jobs[i].Date != jobs[j].Date {\n\t\t\treturn jobs[i].Date > jobs[j].Date\n\t\t}\n\t\treturn jobs[i].Name < jobs[j].Name\n\t})\n}","lineStart":1,"lineEnd":247,"totalLines":247,"truncated":false}},"title":"src/internal/job/discover.go","time":{"start":1787950617252,"end":1787950617256}},"id":"prt_04a29523e001Aek5Y69llLe6fC","sessionID":"ses_fb5dcd7a6ffeSGBPKFVeVpziRm","messageID":"msg_04a293b5a001P4F5uGX73uCoLK"}}
