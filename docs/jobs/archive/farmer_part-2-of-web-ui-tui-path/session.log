{"type":"tool_use","timestamp":1787952952171,"sessionID":"ses_fb5b402d5ffesBMXb1jVe3Cozl","part":{"type":"tool","tool":"read","callID":"call_453ce782baf849389302eee6","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/stream_test.go"},"output":"<path>/workspace/src/internal/serve/stream_test.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"bufio\"\n5: \t\"bytes\"\n6: \t\"context\"\n7: \t\"net/http\"\n8: \t\"net/http/httptest\"\n9: \t\"os\"\n10: \t\"path/filepath\"\n11: \t\"strings\"\n12: \t\"sync\"\n13: \t\"testing\"\n14: \t\"time\"\n15: )\n16: \n17: // shortenStreamPoll shortens the stream handler's poll interval for the\n18: // duration of a test (the handler's live-growth loop runs on it), restoring\n19: // the package default afterwards.\n20: func shortenStreamPoll(t *testing.T) {\n21: \tt.Helper()\n22: \told := streamPollInterval\n23: \tstreamPollInterval = 10 * time.Millisecond\n24: \tt.Cleanup(func() { streamPollInterval = old })\n25: }\n26: \n27: // appendToFile appends s to the file at path (creating it if needed).\n28: func appendToFile(path, s string) error {\n29: \tf, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n30: \tif err != nil {\n31: \t\treturn err\n32: \t}\n33: \tdefer f.Close()\n34: \t_, err = f.WriteString(s)\n35: \treturn err\n36: }\n37: \n38: // sseFrame is one parsed Server-Sent Events frame: the named event (\"\" = the\n39: // default message event) and its data payload.\n40: type sseFrame struct {\n41: \tevent string\n42: \tdata  string\n43: }\n44: \n45: // readSSEFrame reads one SSE frame (terminated by a blank line) from br. A\n46: // frame is a sequence of `event:` / `data:` lines followed by an empty line.\n47: func readSSEFrame(br *bufio.Reader) (sseFrame, error) {\n48: \tvar f sseFrame\n49: \tfor {\n50: \t\tline, err := br.ReadString('\\n')\n51: \t\tif err != nil {\n52: \t\t\treturn f, err\n53: \t\t}\n54: \t\tline = strings.TrimRight(line, \"\\n\")\n55: \t\tif line == \"\" {\n56: \t\t\treturn f, nil // end of frame\n57: \t\t}\n58: \t\tswitch {\n59: \t\tcase strings.HasPrefix(line, \"event: \"):\n60: \t\t\tf.event = strings.TrimPrefix(line, \"event: \")\n61: \t\tcase strings.HasPrefix(line, \"data: \"):\n62: \t\t\tif f.data != \"\" {\n63: \t\t\t\tf.data += \"\\n\"\n64: \t\t\t}\n65: \t\t\tf.data += strings.TrimPrefix(line, \"data: \")\n66: \t\t}\n67: \t}\n68: }\n69: \n70: // readSSEFrameTimeout reads one frame, failing the test if it does not arrive\n71: // within the timeout — the guard against a broken stream hanging the test.\n72: func readSSEFrameTimeout(t *testing.T, br *bufio.Reader, timeout time.Duration) sseFrame {\n73: \tt.Helper()\n74: \ttype res struct {\n75: \t\tf   sseFrame\n76: \t\terr error\n77: \t}\n78: \tch := make(chan res, 1)\n79: \tgo func() {\n80: \t\tf, err := readSSEFrame(br)\n81: \t\tch <- res{f, err}\n82: \t}()\n83: \tselect {\n84: \tcase r := <-ch:\n85: \t\tif r.err != nil {\n86: \t\t\tt.Fatalf(\"read SSE frame: %v\", r.err)\n87: \t\t}\n88: \t\treturn r.f\n89: \tcase <-time.After(timeout):\n90: \t\tt.Fatalf(\"timed out after %v waiting for an SSE frame\", timeout)\n91: \t\treturn sseFrame{}\n92: \t}\n93: }\n94: \n95: // streamURL builds the session-log stream URL for a job under the given\n96: // project base name.\n97: func streamURL(base, job string, from string) string {\n98: \tu := \"/projects/\" + base + \"/jobs/\" + job + \"/session-log/stream\"\n99: \tif from != \"\" {\n100: \t\tu += \"?from=\" + from\n101: \t}\n102: \treturn u\n103: }\n104: \n105: // --- live growth -------------------------------------------------------------\n106: \n107: // TestSessionLogStreamLiveGrowth: a stream opened on an existing session.log\n108: // starts at EOF (the `start` event reports the current byte size) and emits\n109: // each new line as it is appended — the network twin of the TUI's `l` tail.\n110: func TestSessionLogStreamLiveGrowth(t *testing.T) {\n111: \tshortenStreamPoll(t)\n112: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n113: \tlogPath := filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\", \"session.log\")\n114: \tif err := os.WriteFile(logPath, []byte(\"line one\\n\"), 0o644); err != nil {\n115: \t\tt.Fatal(err)\n116: \t}\n117: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n118: \tts := httptest.NewServer(srv.Handler())\n119: \tdefer ts.Close()\n120: \tbase := filepath.Base(root)\n121: \n122: \tresp, err := http.Get(ts.URL + streamURL(base, \"wood_oak\", \"\"))\n123: \tif err != nil {\n124: \t\tt.Fatal(err)\n125: \t}\n126: \tdefer resp.Body.Close()\n127: \tif resp.StatusCode != http.StatusOK {\n128: \t\tt.Fatalf(\"status = %d, want 200\", resp.StatusCode)\n129: \t}\n130: \tif ct := resp.Header.Get(\"Content-Type\"); ct != \"text/event-stream\" {\n131: \t\tt.Errorf(\"Content-Type = %q, want text/event-stream\", ct)\n132: \t}\n133: \n134: \tbr := bufio.NewReader(resp.Body)\n135: \n136: \t// The start event reports the current file size (tail -f: only new growth).\n137: \tstart := readSSEFrameTimeout(t, br, 5*time.Second)\n138: \tif start.event != \"start\" {\n139: \t\tt.Fatalf(\"first frame = %+v, want the start event\", start)\n140: \t}\n141: \tif off := startEventOffset(t, start.data); off != int64(len(\"line one\\n\")) {\n142: \t\tt.Errorf(\"start offset = %d, want %d (the file's current size)\", off, len(\"line one\\n\"))\n143: \t}\n144: \n145: \t// Append a line → it must arrive as a data frame.\n146: \tif err := appendToFile(logPath, \"line two\\n\"); err != nil {\n147: \t\tt.Fatal(err)\n148: \t}\n149: \tf := readSSEFrameTimeout(t, br, 5*time.Second)\n150: \tif f.event != \"\" || f.data != \"line two\" {\n151: \t\tt.Errorf(\"frame after append = %+v, want data: line two\", f)\n152: \t}\n153: }\n154: \n155: // TestSessionLogStreamFromOffset: ?from=<byte offset> resumes at that offset\n156: // (the reconnect contract — a client that dropped reconnects with the offset\n157: // it had consumed and loses nothing).\n158: func TestSessionLogStreamFromOffset(t *testing.T) {\n159: \tshortenStreamPoll(t)\n160: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n161: \tlogPath := filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\", \"session.log\")\n162: \tif err := os.WriteFile(logPath, []byte(\"line one\\nline two\\n\"), 0o644); err != nil {\n163: \t\tt.Fatal(err)\n164: \t}\n165: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n166: \tts := httptest.NewServer(srv.Handler())\n167: \tdefer ts.Close()\n168: \tbase := filepath.Base(root)\n169: \n170: \tresp, err := http.Get(ts.URL + streamURL(base, \"wood_oak\", \"9\"))\n171: \tif err != nil {\n172: \t\tt.Fatal(err)\n173: \t}\n174: \tdefer resp.Body.Close()\n175: \tbr := bufio.NewReader(resp.Body)\n176: \n177: \tstart := readSSEFrameTimeout(t, br, 5*time.Second)\n178: \tif start.event != \"start\" || startEventOffset(t, start.data) != 9 {\n179: \t\tt.Fatalf(\"start frame = %+v, want offset 9 (the ?from value)\", start)\n180: \t}\n181: \t// Bytes from offset 9 onward: \"line two\\n\" → one frame \"line two\".\n182: \tf := readSSEFrameTimeout(t, br, 5*time.Second)\n183: \tif f.data != \"line two\" {\n184: \t\tt.Errorf(\"first data frame = %+v, want line two\", f)\n185: \t}\n186: }\n187: \n188: // TestSessionLogStreamFileAppearsAfterStart: a stream opened before the\n189: // session.log exists (the launch-then-watch flow) starts at byte 0 and emits\n190: // everything from the top once the file appears.\n191: func TestSessionLogStreamFileAppearsAfterStart(t *testing.T) {\n192: \tshortenStreamPoll(t)\n193: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n194: \tlogPath := filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\", \"session.log\")\n195: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n196: \tts := httptest.NewServer(srv.Handler())\n197: \tdefer ts.Close()\n198: \tbase := filepath.Base(root)\n199: \n200: \tresp, err := http.Get(ts.URL + streamURL(base, \"wood_oak\", \"\"))\n201: \tif err != nil {\n202: \t\tt.Fatal(err)\n203: \t}\n204: \tdefer resp.Body.Close()\n205: \tbr := bufio.NewReader(resp.Body)\n206: \n207: \tstart := readSSEFrameTimeout(t, br, 5*time.Second)\n208: \tif start.event != \"start\" || startEventOffset(t, start.data) != 0 {\n209: \t\tt.Fatalf(\"start frame = %+v, want offset 0 (no file yet)\", start)\n210: \t}\n211: \t// The file appears (a launch started writing) → the stream captures it.\n212: \tif err := os.WriteFile(logPath, []byte(\"first line\\n\"), 0o644); err != nil {\n213: \t\tt.Fatal(err)\n214: \t}\n215: \tf := readSSEFrameTimeout(t, br, 5*time.Second)\n216: \tif f.data != \"first line\" {\n217: \t\tt.Errorf(\"frame after file creation = %+v, want first line\", f)\n218: \t}\n219: }\n220: \n221: // TestSessionLogStreamBadFrom: a negative or unparseable ?from= is a clean 400\n222: // JSON error before any SSE headers are written.\n223: func TestSessionLogStreamBadFrom(t *testing.T) {\n224: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n225: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n226: \tbase := filepath.Base(root)\n227: \n228: \tfor _, from := range []string{\"-1\", \"abc\", \"1.5\"} {\n229: \t\trec := get(t, srv, streamURL(base, \"wood_oak\", from), \"\")\n230: \t\tif rec.Code != http.StatusBadRequest {\n231: \t\t\tt.Errorf(\"?from=%s: status = %d, want 400 (body %s)\", from, rec.Code, rec.Body.String())\n232: \t\t}\n233: \t}\n234: }\n235: \n236: // --- disconnect + shutdown ---------------------------------------------------\n237: \n238: // signalWriter is a ResponseWriter that records writes and signals each write\n239: // on a channel — so a test can observe a streaming handler's progress without\n240: // polling (and without racing on a bytes.Buffer). It implements http.Flusher\n241: // (a no-op that still signals), the surface the SSE handler requires.\n242: type signalWriter struct {\n243: \theader http.Header\n244: \tmu     sync.Mutex\n245: \tbody   bytes.Buffer\n246: \twrites chan struct{}\n247: }\n248: \n249: func newSignalWriter() *signalWriter {\n250: \treturn &signalWriter{header: http.Header{}, writes: make(chan struct{}, 64)}\n251: }\n252: \n253: func (w *signalWriter) Header() http.Header { return w.header }\n254: \n255: func (w *signalWriter) Write(p []byte) (int, error) {\n256: \tw.mu.Lock()\n257: \tw.body.Write(p)\n258: \tw.mu.Unlock()\n259: \tw.signal()\n260: \treturn len(p), nil\n261: }\n262: \n263: func (w *signalWriter) WriteHeader(int) {}\n264: \n265: // Flush signals without actually flushing — the observation point a test\n266: // needs, with no real buffered writer behind it.\n267: func (w *signalWriter) Flush() { w.signal() }\n268: \n269: func (w *signalWriter) signal() {\n270: \tselect {\n271: \tcase w.writes <- struct{}{}:\n272: \tdefault:\n273: \t}\n274: }\n275: \n276: // bodyText returns the recorded body under the mutex.\n277: func (w *signalWriter) bodyText() string {\n278: \tw.mu.Lock()\n279: \tdefer w.mu.Unlock()\n280: \treturn w.body.String()\n281: }\n282: \n283: // waitForWrite waits until the handler has written (and flushed) at least one\n284: // frame, or fails the test after the timeout.\n285: func waitForWrite(t *testing.T, w *signalWriter, timeout time.Duration) {\n286: \tt.Helper()\n287: \tselect {\n288: \tcase <-w.writes:\n289: \tcase <-time.After(timeout):\n290: \t\tt.Fatalf(\"timed out waiting for the handler to write; body so far: %q\", w.bodyText())\n291: \t}\n292: }\n293: \n294: // serveStream starts the stream handler in a goroutine, returning the request\n295: // (whose context the test cancels to simulate a disconnect) and a done channel\n296: // closed when the handler returns.\n297: func serveStream(t *testing.T, srv *Server, path string) (cancel func(), done chan struct{}) {\n298: \tt.Helper()\n299: \tctx, cancelFn := context.WithCancel(context.Background())\n300: \treq := httptest.NewRequest(http.MethodGet, path, nil).WithContext(ctx)\n301: \tw := newSignalWriter()\n302: \tdone = make(chan struct{})\n303: \tgo func() {\n304: \t\tsrv.Handler().ServeHTTP(w, req)\n305: \t\tclose(done)\n306: \t}()\n307: \twaitForWrite(t, w, 5*time.Second) // the handler is inside its poll loop now\n308: \treturn cancelFn, done\n309: }\n310: \n311: // TestSessionLogStreamDisconnectStopsHandler: cancelling the client's request\n312: // context makes the handler return promptly — no goroutine leak per stream.\n313: func TestSessionLogStreamDisconnectStopsHandler(t *testing.T) {\n314: \tshortenStreamPoll(t)\n315: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n316: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n317: \tbase := filepath.Base(root)\n318: \n319: \tcancel, done := serveStream(t, srv, streamURL(base, \"wood_oak\", \"\"))\n320: \tcancel()\n321: \n322: \tselect {\n323: \tcase <-done:\n324: \t\t// handler returned promptly — no leak\n325: \tcase <-time.After(5 * time.Second):\n326: \t\tt.Fatal(\"stream handler did not return within 5s of the client disconnect\")\n327: \t}\n328: }\n329: \n330: // TestSessionLogStreamShutdownReturnsPromptly: a graceful Server.Shutdown\n331: // cancels the server's shutdown context before draining, so an open stream\n332: // unblocks and Shutdown returns promptly instead of waiting out the drain\n333: // timeout — the one correctness requirement the brief explicitly calls out.\n334: func TestSessionLogStreamShutdownReturnsPromptly(t *testing.T) {\n335: \tshortenStreamPoll(t)\n336: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n337: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n338: \tbase := filepath.Base(root)\n339: \n340: \t_, done := serveStream(t, srv, streamURL(base, \"wood_oak\", \"\"))\n341: \n342: \tstart := time.Now()\n343: \tshutdownDone := make(chan error, 1)\n344: \tgo func() {\n345: \t\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n346: \t\tdefer cancel()\n347: \t\tshutdownDone <- srv.Shutdown(ctx)\n348: \t}()\n349: \n350: \tselect {\n351: \tcase err := <-shutdownDone:\n352: \t\tif err != nil {\n353: \t\t\tt.Fatalf(\"Shutdown: %v\", err)\n354: \t\t}\n355: \t\tif elapsed := time.Since(start); elapsed > 3*time.Second {\n356: \t\t\tt.Errorf(\"Shutdown took %v, want prompt (an open stream must not hold the drain)\", elapsed)\n357: \t\t}\n358: \tcase <-time.After(5 * time.Second):\n359: \t\tt.Fatal(\"Shutdown did not return within 5s with an open stream attached\")\n360: \t}\n361: \n362: \t// The stream handler itself also returned (the server context was\n363: \t// cancelled before the drain).\n364: \tselect {\n365: \tcase <-done:\n366: \tcase <-time.After(5 * time.Second):\n367: \t\tt.Fatal(\"stream handler did not return after Shutdown\")\n368: \t}\n369: }\n370: \n371: // TestSessionLogStreamUnknownJobIs404: an unknown job is a 404 before any SSE\n372: // headers — the stream is scoped to resolved jobs only.\n373: func TestSessionLogStreamUnknownJobIs404(t *testing.T) {\n374: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n375: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n376: \tbase := filepath.Base(root)\n377: \n378: \trec := get(t, srv, streamURL(base, \"no-such-job\", \"\"), \"\")\n379: \tif rec.Code != http.StatusNotFound {\n380: \t\tt.Errorf(\"status = %d, want 404 (body %s)\", rec.Code, rec.Body.String())\n381: \t}\n382: }\n\n(End of file - total 382 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"bufio\"\n\t\"bytes\"\n\t\"context\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\n// shortenStreamPoll shortens the stream handler's poll interval for the\n// duration of a test (the handler's live-growth loop runs on it), restoring\n// the package default afterwards.\nfunc shortenStreamPoll(t *testing.T) {","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/stream_test.go","text":"package serve\n\nimport (\n\t\"bufio\"\n\t\"bytes\"\n\t\"context\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\n// shortenStreamPoll shortens the stream handler's poll interval for the\n// duration of a test (the handler's live-growth loop runs on it), restoring\n// the package default afterwards.\nfunc shortenStreamPoll(t *testing.T) {\n\tt.Helper()\n\told := streamPollInterval\n\tstreamPollInterval = 10 * time.Millisecond\n\tt.Cleanup(func() { streamPollInterval = old })\n}\n\n// appendToFile appends s to the file at path (creating it if needed).\nfunc appendToFile(path, s string) error {\n\tf, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer f.Close()\n\t_, err = f.WriteString(s)\n\treturn err\n}\n\n// sseFrame is one parsed Server-Sent Events frame: the named event (\"\" = the\n// default message event) and its data payload.\ntype sseFrame struct {\n\tevent string\n\tdata  string\n}\n\n// readSSEFrame reads one SSE frame (terminated by a blank line) from br. A\n// frame is a sequence of `event:` / `data:` lines followed by an empty line.\nfunc readSSEFrame(br *bufio.Reader) (sseFrame, error) {\n\tvar f sseFrame\n\tfor {\n\t\tline, err := br.ReadString('\\n')\n\t\tif err != nil {\n\t\t\treturn f, err\n\t\t}\n\t\tline = strings.TrimRight(line, \"\\n\")\n\t\tif line == \"\" {\n\t\t\treturn f, nil // end of frame\n\t\t}\n\t\tswitch {\n\t\tcase strings.HasPrefix(line, \"event: \"):\n\t\t\tf.event = strings.TrimPrefix(line, \"event: \")\n\t\tcase strings.HasPrefix(line, \"data: \"):\n\t\t\tif f.data != \"\" {\n\t\t\t\tf.data += \"\\n\"\n\t\t\t}\n\t\t\tf.data += strings.TrimPrefix(line, \"data: \")\n\t\t}\n\t}\n}\n\n// readSSEFrameTimeout reads one frame, failing the test if it does not arrive\n// within the timeout — the guard against a broken stream hanging the test.\nfunc readSSEFrameTimeout(t *testing.T, br *bufio.Reader, timeout time.Duration) sseFrame {\n\tt.Helper()\n\ttype res struct {\n\t\tf   sseFrame\n\t\terr error\n\t}\n\tch := make(chan res, 1)\n\tgo func() {\n\t\tf, err := readSSEFrame(br)\n\t\tch <- res{f, err}\n\t}()\n\tselect {\n\tcase r := <-ch:\n\t\tif r.err != nil {\n\t\t\tt.Fatalf(\"read SSE frame: %v\", r.err)\n\t\t}\n\t\treturn r.f\n\tcase <-time.After(timeout):\n\t\tt.Fatalf(\"timed out after %v waiting for an SSE frame\", timeout)\n\t\treturn sseFrame{}\n\t}\n}\n\n// streamURL builds the session-log stream URL for a job under the given\n// project base name.\nfunc streamURL(base, job string, from string) string {\n\tu := \"/projects/\" + base + \"/jobs/\" + job + \"/session-log/stream\"\n\tif from != \"\" {\n\t\tu += \"?from=\" + from\n\t}\n\treturn u\n}\n\n// --- live growth -------------------------------------------------------------\n\n// TestSessionLogStreamLiveGrowth: a stream opened on an existing session.log\n// starts at EOF (the `start` event reports the current byte size) and emits\n// each new line as it is appended — the network twin of the TUI's `l` tail.\nfunc TestSessionLogStreamLiveGrowth(t *testing.T) {\n\tshortenStreamPoll(t)\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tlogPath := filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\", \"session.log\")\n\tif err := os.WriteFile(logPath, []byte(\"line one\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tts := httptest.NewServer(srv.Handler())\n\tdefer ts.Close()\n\tbase := filepath.Base(root)\n\n\tresp, err := http.Get(ts.URL + streamURL(base, \"wood_oak\", \"\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer resp.Body.Close()\n\tif resp.StatusCode != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200\", resp.StatusCode)\n\t}\n\tif ct := resp.Header.Get(\"Content-Type\"); ct != \"text/event-stream\" {\n\t\tt.Errorf(\"Content-Type = %q, want text/event-stream\", ct)\n\t}\n\n\tbr := bufio.NewReader(resp.Body)\n\n\t// The start event reports the current file size (tail -f: only new growth).\n\tstart := readSSEFrameTimeout(t, br, 5*time.Second)\n\tif start.event != \"start\" {\n\t\tt.Fatalf(\"first frame = %+v, want the start event\", start)\n\t}\n\tif off := startEventOffset(t, start.data); off != int64(len(\"line one\\n\")) {\n\t\tt.Errorf(\"start offset = %d, want %d (the file's current size)\", off, len(\"line one\\n\"))\n\t}\n\n\t// Append a line → it must arrive as a data frame.\n\tif err := appendToFile(logPath, \"line two\\n\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf := readSSEFrameTimeout(t, br, 5*time.Second)\n\tif f.event != \"\" || f.data != \"line two\" {\n\t\tt.Errorf(\"frame after append = %+v, want data: line two\", f)\n\t}\n}\n\n// TestSessionLogStreamFromOffset: ?from=<byte offset> resumes at that offset\n// (the reconnect contract — a client that dropped reconnects with the offset\n// it had consumed and loses nothing).\nfunc TestSessionLogStreamFromOffset(t *testing.T) {\n\tshortenStreamPoll(t)\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tlogPath := filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\", \"session.log\")\n\tif err := os.WriteFile(logPath, []byte(\"line one\\nline two\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tts := httptest.NewServer(srv.Handler())\n\tdefer ts.Close()\n\tbase := filepath.Base(root)\n\n\tresp, err := http.Get(ts.URL + streamURL(base, \"wood_oak\", \"9\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer resp.Body.Close()\n\tbr := bufio.NewReader(resp.Body)\n\n\tstart := readSSEFrameTimeout(t, br, 5*time.Second)\n\tif start.event != \"start\" || startEventOffset(t, start.data) != 9 {\n\t\tt.Fatalf(\"start frame = %+v, want offset 9 (the ?from value)\", start)\n\t}\n\t// Bytes from offset 9 onward: \"line two\\n\" → one frame \"line two\".\n\tf := readSSEFrameTimeout(t, br, 5*time.Second)\n\tif f.data != \"line two\" {\n\t\tt.Errorf(\"first data frame = %+v, want line two\", f)\n\t}\n}\n\n// TestSessionLogStreamFileAppearsAfterStart: a stream opened before the\n// session.log exists (the launch-then-watch flow) starts at byte 0 and emits\n// everything from the top once the file appears.\nfunc TestSessionLogStreamFileAppearsAfterStart(t *testing.T) {\n\tshortenStreamPoll(t)\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tlogPath := filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\", \"session.log\")\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tts := httptest.NewServer(srv.Handler())\n\tdefer ts.Close()\n\tbase := filepath.Base(root)\n\n\tresp, err := http.Get(ts.URL + streamURL(base, \"wood_oak\", \"\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer resp.Body.Close()\n\tbr := bufio.NewReader(resp.Body)\n\n\tstart := readSSEFrameTimeout(t, br, 5*time.Second)\n\tif start.event != \"start\" || startEventOffset(t, start.data) != 0 {\n\t\tt.Fatalf(\"start frame = %+v, want offset 0 (no file yet)\", start)\n\t}\n\t// The file appears (a launch started writing) → the stream captures it.\n\tif err := os.WriteFile(logPath, []byte(\"first line\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf := readSSEFrameTimeout(t, br, 5*time.Second)\n\tif f.data != \"first line\" {\n\t\tt.Errorf(\"frame after file creation = %+v, want first line\", f)\n\t}\n}\n\n// TestSessionLogStreamBadFrom: a negative or unparseable ?from= is a clean 400\n// JSON error before any SSE headers are written.\nfunc TestSessionLogStreamBadFrom(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tfor _, from := range []string{\"-1\", \"abc\", \"1.5\"} {\n\t\trec := get(t, srv, streamURL(base, \"wood_oak\", from), \"\")\n\t\tif rec.Code != http.StatusBadRequest {\n\t\t\tt.Errorf(\"?from=%s: status = %d, want 400 (body %s)\", from, rec.Code, rec.Body.String())\n\t\t}\n\t}\n}\n\n// --- disconnect + shutdown ---------------------------------------------------\n\n// signalWriter is a ResponseWriter that records writes and signals each write\n// on a channel — so a test can observe a streaming handler's progress without\n// polling (and without racing on a bytes.Buffer). It implements http.Flusher\n// (a no-op that still signals), the surface the SSE handler requires.\ntype signalWriter struct {\n\theader http.Header\n\tmu     sync.Mutex\n\tbody   bytes.Buffer\n\twrites chan struct{}\n}\n\nfunc newSignalWriter() *signalWriter {\n\treturn &signalWriter{header: http.Header{}, writes: make(chan struct{}, 64)}\n}\n\nfunc (w *signalWriter) Header() http.Header { return w.header }\n\nfunc (w *signalWriter) Write(p []byte) (int, error) {\n\tw.mu.Lock()\n\tw.body.Write(p)\n\tw.mu.Unlock()\n\tw.signal()\n\treturn len(p), nil\n}\n\nfunc (w *signalWriter) WriteHeader(int) {}\n\n// Flush signals without actually flushing — the observation point a test\n// needs, with no real buffered writer behind it.\nfunc (w *signalWriter) Flush() { w.signal() }\n\nfunc (w *signalWriter) signal() {\n\tselect {\n\tcase w.writes <- struct{}{}:\n\tdefault:\n\t}\n}\n\n// bodyText returns the recorded body under the mutex.\nfunc (w *signalWriter) bodyText() string {\n\tw.mu.Lock()\n\tdefer w.mu.Unlock()\n\treturn w.body.String()\n}\n\n// waitForWrite waits until the handler has written (and flushed) at least one\n// frame, or fails the test after the timeout.\nfunc waitForWrite(t *testing.T, w *signalWriter, timeout time.Duration) {\n\tt.Helper()\n\tselect {\n\tcase <-w.writes:\n\tcase <-time.After(timeout):\n\t\tt.Fatalf(\"timed out waiting for the handler to write; body so far: %q\", w.bodyText())\n\t}\n}\n\n// serveStream starts the stream handler in a goroutine, returning the request\n// (whose context the test cancels to simulate a disconnect) and a done channel\n// closed when the handler returns.\nfunc serveStream(t *testing.T, srv *Server, path string) (cancel func(), done chan struct{}) {\n\tt.Helper()\n\tctx, cancelFn := context.WithCancel(context.Background())\n\treq := httptest.NewRequest(http.MethodGet, path, nil).WithContext(ctx)\n\tw := newSignalWriter()\n\tdone = make(chan struct{})\n\tgo func() {\n\t\tsrv.Handler().ServeHTTP(w, req)\n\t\tclose(done)\n\t}()\n\twaitForWrite(t, w, 5*time.Second) // the handler is inside its poll loop now\n\treturn cancelFn, done\n}\n\n// TestSessionLogStreamDisconnectStopsHandler: cancelling the client's request\n// context makes the handler return promptly — no goroutine leak per stream.\nfunc TestSessionLogStreamDisconnectStopsHandler(t *testing.T) {\n\tshortenStreamPoll(t)\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tcancel, done := serveStream(t, srv, streamURL(base, \"wood_oak\", \"\"))\n\tcancel()\n\n\tselect {\n\tcase <-done:\n\t\t// handler returned promptly — no leak\n\tcase <-time.After(5 * time.Second):\n\t\tt.Fatal(\"stream handler did not return within 5s of the client disconnect\")\n\t}\n}\n\n// TestSessionLogStreamShutdownReturnsPromptly: a graceful Server.Shutdown\n// cancels the server's shutdown context before draining, so an open stream\n// unblocks and Shutdown returns promptly instead of waiting out the drain\n// timeout — the one correctness requirement the brief explicitly calls out.\nfunc TestSessionLogStreamShutdownReturnsPromptly(t *testing.T) {\n\tshortenStreamPoll(t)\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\t_, done := serveStream(t, srv, streamURL(base, \"wood_oak\", \"\"))\n\n\tstart := time.Now()\n\tshutdownDone := make(chan error, 1)\n\tgo func() {\n\t\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n\t\tdefer cancel()\n\t\tshutdownDone <- srv.Shutdown(ctx)\n\t}()\n\n\tselect {\n\tcase err := <-shutdownDone:\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"Shutdown: %v\", err)\n\t\t}\n\t\tif elapsed := time.Since(start); elapsed > 3*time.Second {\n\t\t\tt.Errorf(\"Shutdown took %v, want prompt (an open stream must not hold the drain)\", elapsed)\n\t\t}\n\tcase <-time.After(5 * time.Second):\n\t\tt.Fatal(\"Shutdown did not return within 5s with an open stream attached\")\n\t}\n\n\t// The stream handler itself also returned (the server context was\n\t// cancelled before the drain).\n\tselect {\n\tcase <-done:\n\tcase <-time.After(5 * time.Second):\n\t\tt.Fatal(\"stream handler did not return after Shutdown\")\n\t}\n}\n\n// TestSessionLogStreamUnknownJobIs404: an unknown job is a 404 before any SSE\n// headers — the stream is scoped to resolved jobs only.\nfunc TestSessionLogStreamUnknownJobIs404(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\trec := get(t, srv, streamURL(base, \"no-such-job\", \"\"), \"\")\n\tif rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"status = %d, want 404 (body %s)\", rec.Code, rec.Body.String())\n\t}\n}","lineStart":1,"lineEnd":382,"totalLines":382,"truncated":false}},"title":"src/internal/serve/stream_test.go","time":{"start":1787952952167,"end":1787952952170}},"id":"prt_04a4cf311001VWdIQ8LMHDXtzK","sessionID":"ses_fb5b402d5ffesBMXb1jVe3Cozl","messageID":"msg_04a4ceb3c001shL51CEhYYqub0"}}
