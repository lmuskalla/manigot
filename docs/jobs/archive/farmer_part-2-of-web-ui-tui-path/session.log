{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D7RfjL6DWSJd7CAbcKpGmz","type":"tool_result","content":"1\tpackage job\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"io\"\n6\t\t\"os\"\n7\t\t\"path/filepath\"\n8\t\t\"strings\"\n9\t\t\"time\"\n10\t)\n11\t\n12\t// ManigotRelDir is manigot's own directory inside a target project, relative\n13\t// to the project root: the home for host-side tooling state that is not job\n14\t// content and does not belong in docs/. .manigot/manigot.json holds the\n15\t// committable project settings (see the project package); .manigot/jdi-status/\n16\t// holds mg-jdi's ephemeral run state (gitignored, see .gitignore).\n17\tconst ManigotRelDir = \".manigot\"\n18\t\n19\t// JDISidecarDirName is the sidecar directory mg-jdi writes its per-job\n20\t// status and run log into, under ManigotRelDir — deliberately outside any job's own directory\n21\t// (docs/jobs/<name>/) so it can never be swept into an agent's own\n22\t// `git add -A`, and gitignored entirely (see .gitignore).\n23\tconst JDISidecarDirName = \"jdi-status\"\n24\t\n25\t// jdiStatusFileName / jdiRunLogFileName are the two files living under each\n26\t// job's JDIStatusDir.\n27\tconst (\n28\t\tjdiStatusFileName = \"status\"\n29\t\tjdiRunLogFileName = \"run.log\"\n30\t)\n31\t\n32\t// JDIState is mg-jdi's reported run state for a job, read from its status\n33\t// sidecar file.\n34\ttype JDIState string\n35\t\n36\tconst (\n37\t\t// JDIRunning means mg-jdi is (or, absent a fresher update, very\n38\t\t// recently was) actively driving this job.\n39\t\tJDIRunning JDIState = \"running\"\n40\t\t// JDIStoppedFinished means mg-jdi's last run ended because the job's\n41\t\t// verdict was APPROVED.\n42\t\tJDIStoppedFinished JDIState = \"stopped:finished\"\n43\t\t// JDIStoppedNeedsHuman means mg-jdi's last run ended because it needed\n44\t\t// a human (retry budget exhausted, a NEEDS-HUMAN-INPUT marker, or the\n45\t\t// stall backstop — see mg-jdi).\n46\t\tJDIStoppedNeedsHuman JDIState = \"stopped:needs-human\"\n47\t)\n48\t\n49\t// jdiRunningStaleAfter bounds how long a JDIRunning status is trusted\n50\t// without an update before ReadJDIStatus degrades it to \"no run in\n51\t// progress\". mg-jdi only updates the status file at\n52\t// agent-invocation boundaries, not continuously while one is in flight, so\n53\t// this must be generous enough that a single long-running agent call isn't\n54\t// mistaken for a killed mg-jdi process.\n55\tconst jdiRunningStaleAfter = 30 * time.Minute\n56\t\n57\t// JDIStatus is mg-jdi's last-known status for a job.\n58\ttype JDIStatus struct {\n59\t\tState   JDIState\n60\t\tAgent   string\n61\t\tUpdated time.Time\n62\t}\n63\t\n64\t// jdiStatusFile is the on-disk JSON shape of the status sidecar file.\n65\ttype jdiStatusFile struct {\n66\t\tState   JDIState `json:\"state\"`\n67\t\tAgent   string   `json:\"agent\"`\n68\t\tUpdated string   `json:\"updated\"` // RFC3339\n69\t}\n70\t\n71\t// JDIStatusDir returns the sidecar directory for job jobName under root.\n72\tfunc JDIStatusDir(root, jobName string) string {\n73\t\treturn filepath.Join(root, ManigotRelDir, JDISidecarDirName, jobName)\n74\t}\n75\t\n76\t// JDIStatusPath returns the status file path within JDIStatusDir.\n77\tfunc JDIStatusPath(root, jobName string) string {\n78\t\treturn filepath.Join(JDIStatusDir(root, jobName), jdiStatusFileName)\n79\t}\n80\t\n81\t// JDIRunLogPath returns the run.log path within JDIStatusDir — the\n82\t// append-only transcript mg-jdi writes, and the TUI's log tab reads.\n83\tfunc JDIRunLogPath(root, jobName string) string {\n84\t\treturn filepath.Join(JDIStatusDir(root, jobName), jdiRunLogFileName)\n85\t}\n86\t\n87\t// ReadJDIStatus reads job jobName's mg-jdi status sidecar under root. ok is\n88\t// false when there is nothing live to report: no sidecar file exists, it\n89\t// can't be parsed, its state isn't one of the three known values, or it\n90\t// claims JDIRunning but hasn't been updated in over jdiRunningStaleAfter\n91\t// (mg-jdi was almost certainly killed mid-run). A stale or\n92\t// unreadable file must never be shown as if it were live — this is the\n93\t// normal path through which callers should read it, the one exception being\n94\t// StaleRunningJDI's raw read for mg-jdi's own next-start crash check.\n95\tfunc ReadJDIStatus(root, jobName string) (JDIStatus, bool) {\n96\t\tst, ok := readJDIStatusRaw(root, jobName)\n97\t\tif !ok {\n98\t\t\treturn JDIStatus{}, false\n99\t\t}\n100\t\tif st.State == JDIRunning && time.Since(st.Updated) > jdiRunningStaleAfter {\n101\t\t\treturn JDIStatus{}, false\n102\t\t}\n103\t\treturn st, true\n104\t}\n105\t\n106\t// readJDIStatusRaw is the shared parse of the status sidecar: it returns the\n107\t// parsed status with ok=false when the file is missing, unparseable, or\n108\t// holds an unknown state value. Unlike ReadJDIStatus it does NOT degrade a\n109\t// stale JDIRunning entry away — staleness is the caller's business.\n110\tfunc readJDIStatusRaw(root, jobName string) (JDIStatus, bool) {\n111\t\tdata, err := os.ReadFile(JDIStatusPath(root, jobName))\n112\t\tif err != nil {\n113\t\t\treturn JDIStatus{}, false\n114\t\t}\n115\t\n116\t\tvar raw jdiStatusFile\n117\t\tif err := json.Unmarshal(data, &raw); err != nil {\n118\t\t\treturn JDIStatus{}, false\n119\t\t}\n120\t\n121\t\tupdated, err := time.Parse(time.RFC3339, raw.Updated)\n122\t\tif err != nil {\n123\t\t\treturn JDIStatus{}, false\n124\t\t}\n125\t\n126\t\tswitch raw.State {\n127\t\tcase JDIRunning, JDIStoppedFinished, JDIStoppedNeedsHuman:\n128\t\tdefault:\n129\t\t\treturn JDIStatus{}, false\n130\t\t}\n131\t\n132\t\treturn JDIStatus{State: raw.State, Agent: raw.Agent, Updated: updated}, true\n133\t}\n134\t\n135\t// StaleRunningJDI reports whether job jobName's mg-jdi sidecar claims a run\n136\t// is in progress (JDIRunning) but has not been updated in over\n137\t// jdiRunningStaleAfter — the on-disk signature of an mg-jdi process that was\n138\t// killed (SIGKILL, OOM, host reboot) without ever reporting a stop. ok is\n139\t// true only for that stale-running case: a stopped:* state, a fresh running\n140\t// state, or a missing/unparseable sidecar all report ok=false. It is the raw\n141\t// counterpart to ReadJDIStatus's degradation (same staleness constant, same\n142\t// parse) and exists so mg-jdi's next-start crash check (see\n143\t// cmd/mg/jdi.go's notifyCrashedRun) can distinguish \"no run in progress\"\n144\t// from \"a run died mid-flight\".\n145\tfunc StaleRunningJDI(root, jobName string) (JDIStatus, bool) {\n146\t\tst, ok := readJDIStatusRaw(root, jobName)\n147\t\tif !ok || st.State != JDIRunning {\n148\t\t\treturn JDIStatus{}, false\n149\t\t}\n150\t\tif time.Since(st.Updated) <= jdiRunningStaleAfter {\n151\t\t\treturn JDIStatus{}, false\n152\t\t}\n153\t\treturn st, true\n154\t}\n155\t\n156\t// WriteJDIStatus writes/overwrites job jobName's status sidecar under root.\n157\t// Called by mg-jdi at each state transition: once before\n158\t// invoking an agent (JDIRunning, that agent's name) and once more at loop\n159\t// exit (JDIStoppedFinished or JDIStoppedNeedsHuman, the last agent that\n160\t// ran). Lives here so the write and read sides share\n161\t// one on-disk format definition rather than risking drift between two\n162\t// independent copies.\n163\tfunc WriteJDIStatus(root, jobName string, state JDIState, agent string) error {\n164\t\tdir := JDIStatusDir(root, jobName)\n165\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n166\t\t\treturn err\n167\t\t}\n168\t\traw := jdiStatusFile{\n169\t\t\tState:   state,\n170\t\t\tAgent:   agent,\n171\t\t\tUpdated: time.Now().UTC().Format(time.RFC3339),\n172\t\t}\n173\t\tdata, err := json.Marshal(raw)\n174\t\tif err != nil {\n175\t\t\treturn err\n176\t\t}\n177\t\treturn os.WriteFile(JDIStatusPath(root, jobName), data, 0o644)\n178\t}\n179\t\n180\t// RemoveJDIStatus removes job jobName's mg-jdi sidecar directory under root —\n181\t// the status file and run.log that mg-jdi leaves behind. The job-destruction\n182\t// lifecycle paths (DeleteJob, FinishJob, and the orphan removers) call it so\n183\t// the tool cleans up after itself instead of leaving .manigot/jdi-status/<job>/\n184\t// accumulating forever after the job itself is gone. removed reports whether a\n185\t// sidecar actually existed — a job mg-jdi never drove has no sidecar, and its\n186\t// absence is not an error.\n187\tfunc RemoveJDIStatus(root, jobName string) (removed bool, err error) {\n188\t\tdir := JDIStatusDir(root, jobName)\n189\t\tif _, err := os.Stat(dir); err != nil {\n190\t\t\tif os.IsNotExist(err) {\n191\t\t\t\treturn false, nil\n192\t\t\t}\n193\t\t\treturn false, err\n194\t\t}\n195\t\treturn true, os.RemoveAll(dir)\n196\t}\n197\t\n198\t// jdiRunLogTailBytes bounds how much of a job's run.log ReadJDIRunLogTail\n199\t// loads into memory — a tail, not \"load everything\" (a large/growing\n200\t// file), the same kind of bounded-viewport\n201\t// approach the markdown viewer already uses for job files. Generous enough\n202\t// to comfortably hold many invocations' worth of text while staying a small,\n203\t// fixed cost regardless of how long a job's full history grows.\n204\tconst jdiRunLogTailBytes = 256 * 1024 // 256 KiB\n205\t\n206\t// ReadJDIRunLogTail reads up to the last jdiRunLogTailBytes of job jobName's\n207\t// run.log sidecar (JDIRunLogPath) — the TUI's log tab, the primary way to\n208\t// see what mg-jdi is doing from inside the TUI.\n209\t//\n210\t// ok is false only when there is no run.log at all yet — the common case of\n211\t// a job mg-jdi has never driven — so callers can show a distinct \"no run\n212\t// yet\" placeholder instead of an empty tab. An existing-but-empty file (the\n213\t// sidecar directory exists but no invocation has completed yet) returns\n214\t// (\"\", true): still \"there is a run happening,\" just nothing logged yet.\n215\tfunc ReadJDIRunLogTail(root, jobName string) (content string, ok bool) {\n216\t\tf, err := os.Open(JDIRunLogPath(root, jobName))\n217\t\tif err != nil {\n218\t\t\treturn \"\", false\n219\t\t}\n220\t\tdefer f.Close()\n221\t\n222\t\tinfo, err := f.Stat()\n223\t\tif err != nil {\n224\t\t\treturn \"\", false\n225\t\t}\n226\t\tsize := info.Size()\n227\t\tif size == 0 {\n228\t\t\treturn \"\", true\n229\t\t}\n230\t\n231\t\tstart := int64(0)\n232\t\ttruncated := false\n233\t\tif size > jdiRunLogTailBytes {\n234\t\t\tstart = size - jdiRunLogTailBytes\n235\t\t\ttruncated = true\n236\t\t}\n237\t\tif _, err := f.Seek(start, io.SeekStart); err != nil {\n238\t\t\treturn \"\", false\n239\t\t}\n240\t\tdata, err := io.ReadAll(f)\n241\t\tif err != nil {\n242\t\t\treturn \"\", false\n243\t\t}\n244\t\n245\t\ttext := string(data)\n246\t\tif truncated {\n247\t\t\t// Drop a possibly-partial first line so the tail starts cleanly at\n248\t\t\t// an invocation boundary rather than mid-line.\n249\t\t\tif idx := strings.IndexByte(text, '\\n'); idx >= 0 {\n250\t\t\t\ttext = text[idx+1:]\n251\t\t\t}\n252\t\t\ttext = \"… (log truncated — showing the most recent portion)\\n\\n\" + text\n253\t\t}\n254\t\treturn text, true\n255\t}\n256\t"}]},"parent_tool_use_id":null,"session_id":"ba948ea7-a157-4c42-8eb1-077540d9946d","uuid":"1ca35d79-f771-4438-8510-0e04da8cd554","timestamp":"2026-08-28T20:24:51.269Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/job/jdistatus.go","content":"package job\n\nimport (\n\t\"encoding/json\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n)\n\n// ManigotRelDir is manigot's own directory inside a target project, relative\n// to the project root: the home for host-side tooling state that is not job\n// content and does not belong in docs/. .manigot/manigot.json holds the\n// committable project settings (see the project package); .manigot/jdi-status/\n// holds mg-jdi's ephemeral run state (gitignored, see .gitignore).\nconst ManigotRelDir = \".manigot\"\n\n// JDISidecarDirName is the sidecar directory mg-jdi writes its per-job\n// status and run log into, under ManigotRelDir — deliberately outside any job's own directory\n// (docs/jobs/<name>/) so it can never be swept into an agent's own\n// `git add -A`, and gitignored entirely (see .gitignore).\nconst JDISidecarDirName = \"jdi-status\"\n\n// jdiStatusFileName / jdiRunLogFileName are the two files living under each\n// job's JDIStatusDir.\nconst (\n\tjdiStatusFileName = \"status\"\n\tjdiRunLogFileName = \"run.log\"\n)\n\n// JDIState is mg-jdi's reported run state for a job, read from its status\n// sidecar file.\ntype JDIState string\n\nconst (\n\t// JDIRunning means mg-jdi is (or, absent a fresher update, very\n\t// recently was) actively driving this job.\n\tJDIRunning JDIState = \"running\"\n\t// JDIStoppedFinished means mg-jdi's last run ended because the job's\n\t// verdict was APPROVED.\n\tJDIStoppedFinished JDIState = \"stopped:finished\"\n\t// JDIStoppedNeedsHuman means mg-jdi's last run ended because it needed\n\t// a human (retry budget exhausted, a NEEDS-HUMAN-INPUT marker, or the\n\t// stall backstop — see mg-jdi).\n\tJDIStoppedNeedsHuman JDIState = \"stopped:needs-human\"\n)\n\n// jdiRunningStaleAfter bounds how long a JDIRunning status is trusted\n// without an update before ReadJDIStatus degrades it to \"no run in\n// progress\". mg-jdi only updates the status file at\n// agent-invocation boundaries, not continuously while one is in flight, so\n// this must be generous enough that a single long-running agent call isn't\n// mistaken for a killed mg-jdi process.\nconst jdiRunningStaleAfter = 30 * time.Minute\n\n// JDIStatus is mg-jdi's last-known status for a job.\ntype JDIStatus struct {\n\tState   JDIState\n\tAgent   string\n\tUpdated time.Time\n}\n\n// jdiStatusFile is the on-disk JSON shape of the status sidecar file.\ntype jdiStatusFile struct {\n\tState   JDIState `json:\"state\"`\n\tAgent   string   `json:\"agent\"`\n\tUpdated string   `json:\"updated\"` // RFC3339\n}\n\n// JDIStatusDir returns the sidecar directory for job jobName under root.\nfunc JDIStatusDir(root, jobName string) string {\n\treturn filepath.Join(root, ManigotRelDir, JDISidecarDirName, jobName)\n}\n\n// JDIStatusPath returns the status file path within JDIStatusDir.\nfunc JDIStatusPath(root, jobName string) string {\n\treturn filepath.Join(JDIStatusDir(root, jobName), jdiStatusFileName)\n}\n\n// JDIRunLogPath returns the run.log path within JDIStatusDir — the\n// append-only transcript mg-jdi writes, and the TUI's log tab reads.\nfunc JDIRunLogPath(root, jobName string) string {\n\treturn filepath.Join(JDIStatusDir(root, jobName), jdiRunLogFileName)\n}\n\n// ReadJDIStatus reads job jobName's mg-jdi status sidecar under root. ok is\n// false when there is nothing live to report: no sidecar file exists, it\n// can't be parsed, its state isn't one of the three known values, or it\n// claims JDIRunning but hasn't been updated in over jdiRunningStaleAfter\n// (mg-jdi was almost certainly killed mid-run). A stale or\n// unreadable file must never be shown as if it were live — this is the\n// normal path through which callers should read it, the one exception being\n// StaleRunningJDI's raw read for mg-jdi's own next-start crash check.\nfunc ReadJDIStatus(root, jobName string) (JDIStatus, bool) {\n\tst, ok := readJDIStatusRaw(root, jobName)\n\tif !ok {\n\t\treturn JDIStatus{}, false\n\t}\n\tif st.State == JDIRunning && time.Since(st.Updated) > jdiRunningStaleAfter {\n\t\treturn JDIStatus{}, false\n\t}\n\treturn st, true\n}\n\n// readJDIStatusRaw is the shared parse of the status sidecar: it returns the\n// parsed status with ok=false when the file is missing, unparseable, or\n// holds an unknown state value. Unlike ReadJDIStatus it does NOT degrade a\n// stale JDIRunning entry away — staleness is the caller's business.\nfunc readJDIStatusRaw(root, jobName string) (JDIStatus, bool) {\n\tdata, err := os.ReadFile(JDIStatusPath(root, jobName))\n\tif err != nil {\n\t\treturn JDIStatus{}, false\n\t}\n\n\tvar raw jdiStatusFile\n\tif err := json.Unmarshal(data, &raw); err != nil {\n\t\treturn JDIStatus{}, false\n\t}\n\n\tupdated, err := time.Parse(time.RFC3339, raw.Updated)\n\tif err != nil {\n\t\treturn JDIStatus{}, false\n\t}\n\n\tswitch raw.State {\n\tcase JDIRunning, JDIStoppedFinished, JDIStoppedNeedsHuman:\n\tdefault:\n\t\treturn JDIStatus{}, false\n\t}\n\n\treturn JDIStatus{State: raw.State, Agent: raw.Agent, Updated: updated}, true\n}\n\n// StaleRunningJDI reports whether job jobName's mg-jdi sidecar claims a run\n// is in progress (JDIRunning) but has not been updated in over\n// jdiRunningStaleAfter — the on-disk signature of an mg-jdi process that was\n// killed (SIGKILL, OOM, host reboot) without ever reporting a stop. ok is\n// true only for that stale-running case: a stopped:* state, a fresh running\n// state, or a missing/unparseable sidecar all report ok=false. It is the raw\n// counterpart to ReadJDIStatus's degradation (same staleness constant, same\n// parse) and exists so mg-jdi's next-start crash check (see\n// cmd/mg/jdi.go's notifyCrashedRun) can distinguish \"no run in progress\"\n// from \"a run died mid-flight\".\nfunc StaleRunningJDI(root, jobName string) (JDIStatus, bool) {\n\tst, ok := readJDIStatusRaw(root, jobName)\n\tif !ok || st.State != JDIRunning {\n\t\treturn JDIStatus{}, false\n\t}\n\tif time.Since(st.Updated) <= jdiRunningStaleAfter {\n\t\treturn JDIStatus{}, false\n\t}\n\treturn st, true\n}\n\n// WriteJDIStatus writes/overwrites job jobName's status sidecar under root.\n// Called by mg-jdi at each state transition: once before\n// invoking an agent (JDIRunning, that agent's name) and once more at loop\n// exit (JDIStoppedFinished or JDIStoppedNeedsHuman, the last agent that\n// ran). Lives here so the write and read sides share\n// one on-disk format definition rather than risking drift between two\n// independent copies.\nfunc WriteJDIStatus(root, jobName string, state JDIState, agent string) error {\n\tdir := JDIStatusDir(root, jobName)\n\tif err := os.MkdirAll(dir, 0o755); err != nil {\n\t\treturn err\n\t}\n\traw := jdiStatusFile{\n\t\tState:   state,\n\t\tAgent:   agent,\n\t\tUpdated: time.Now().UTC().Format(time.RFC3339),\n\t}\n\tdata, err := json.Marshal(raw)\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.WriteFile(JDIStatusPath(root, jobName), data, 0o644)\n}\n\n// RemoveJDIStatus removes job jobName's mg-jdi sidecar directory under root —\n// the status file and run.log that mg-jdi leaves behind. The job-destruction\n// lifecycle paths (DeleteJob, FinishJob, and the orphan removers) call it so\n// the tool cleans up after itself instead of leaving .manigot/jdi-status/<job>/\n// accumulating forever after the job itself is gone. removed reports whether a\n// sidecar actually existed — a job mg-jdi never drove has no sidecar, and its\n// absence is not an error.\nfunc RemoveJDIStatus(root, jobName string) (removed bool, err error) {\n\tdir := JDIStatusDir(root, jobName)\n\tif _, err := os.Stat(dir); err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn false, nil\n\t\t}\n\t\treturn false, err\n\t}\n\treturn true, os.RemoveAll(dir)\n}\n\n// jdiRunLogTailBytes bounds how much of a job's run.log ReadJDIRunLogTail\n// loads into memory — a tail, not \"load everything\" (a large/growing\n// file), the same kind of bounded-viewport\n// approach the markdown viewer already uses for job files. Generous enough\n// to comfortably hold many invocations' worth of text while staying a small,\n// fixed cost regardless of how long a job's full history grows.\nconst jdiRunLogTailBytes = 256 * 1024 // 256 KiB\n\n// ReadJDIRunLogTail reads up to the last jdiRunLogTailBytes of job jobName's\n// run.log sidecar (JDIRunLogPath) — the TUI's log tab, the primary way to\n// see what mg-jdi is doing from inside the TUI.\n//\n// ok is false only when there is no run.log at all yet — the common case of\n// a job mg-jdi has never driven — so callers can show a distinct \"no run\n// yet\" placeholder instead of an empty tab. An existing-but-empty file (the\n// sidecar directory exists but no invocation has completed yet) returns\n// (\"\", true): still \"there is a run happening,\" just nothing logged yet.\nfunc ReadJDIRunLogTail(root, jobName string) (content string, ok bool) {\n\tf, err := os.Open(JDIRunLogPath(root, jobName))\n\tif err != nil {\n\t\treturn \"\", false\n\t}\n\tdefer f.Close()\n\n\tinfo, err := f.Stat()\n\tif err != nil {\n\t\treturn \"\", false\n\t}\n\tsize := info.Size()\n\tif size == 0 {\n\t\treturn \"\", true\n\t}\n\n\tstart := int64(0)\n\ttruncated := false\n\tif size > jdiRunLogTailBytes {\n\t\tstart = size - jdiRunLogTailBytes\n\t\ttruncated = true\n\t}\n\tif _, err := f.Seek(start, io.SeekStart); err != nil {\n\t\treturn \"\", false\n\t}\n\tdata, err := io.ReadAll(f)\n\tif err != nil {\n\t\treturn \"\", false\n\t}\n\n\ttext := string(data)\n\tif truncated {\n\t\t// Drop a possibly-partial first line so the tail starts cleanly at\n\t\t// an invocation boundary rather than mid-line.\n\t\tif idx := strings.IndexByte(text, '\\n'); idx >= 0 {\n\t\t\ttext = text[idx+1:]\n\t\t}\n\t\ttext = \"… (log truncated — showing the most recent portion)\\n\\n\" + text\n\t}\n\treturn text, true\n}\n","numLines":256,"startLine":1,"totalLines":256}}}
