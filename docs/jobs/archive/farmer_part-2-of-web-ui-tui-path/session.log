{"type":"tool_use","timestamp":1787952481522,"sessionID":"ses_fb5ba93f2ffe9RBBAgSFG35dIN","part":{"type":"tool","tool":"read","callID":"call_b9a2ce9fc6b44668814354bc","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/stream.go"},"output":"<path>/workspace/src/internal/serve/stream.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"bytes\"\n5: \t\"encoding/json\"\n6: \t\"fmt\"\n7: \t\"io\"\n8: \t\"net/http\"\n9: \t\"os\"\n10: \t\"path/filepath\"\n11: \t\"strconv\"\n12: \t\"strings\"\n13: \t\"time\"\n14: )\n15: \n16: // --- GET /projects/{project}/jobs/{job}/session-log/stream (TASK-12) ---------\n17: \n18: // The session-log stream is Server-Sent Events over the plain net/http server:\n19: // no upgrade handshake, no framing protocol, no new dependency — the \"less\n20: // code against the existing server\" choice the brief's Notes steer toward\n21: // (Go's stdlib has no WebSocket support natively; SSE is just a long-lived\n22: // chunked response with `data:` frames and http.Flusher).\n23: //\n24: // It is the network twin of the TUI's `l` key: the same\n25: // docs/jobs/<id>_<slug>/session.log the TUI tails locally, tailed over HTTP\n26: // instead. The file is a local append-only log, so the \"watch for growth\"\n27: // mechanism is a plain stat+read-new-bytes poll — no fsnotify/inotify.\n28: //\n29: // Event protocol (consumed by job three's web UI; also human-readable under\n30: // curl):\n31: //\n32: //\tevent: start\n33: //\tdata: {\"offset\":123}\n34: //\n35: //\t<one default (message) event per log line, in order>\n36: //\t<an idle `: keepalive` comment every streamKeepalive, invisible to EventSource>\n37: //\n38: // Offsets: with no ?from=, the stream starts at the file's current size when\n39: // it already exists (tail -f semantics — only new growth) and at byte 0 when\n40: // it doesn't yet (the launch-then-watch flow: everything from the top once the\n41: // run starts writing). ?from=<byte offset> overrides both — the reconnect\n42: // contract: remember the offset (the client tracks it as the bytes it has\n43: // consumed; `start` reports where a fresh stream began), reconnect with\n44: // from=<offset> after a drop, lose nothing. If the file shrinks below the\n45: // offset (truncated/rotated), the stream resets to byte 0 and says so with a\n46: // fresh `start` event.\n47: \n48: // streamPollInterval is how often the handler stats session.log for new bytes.\n49: // A var (not const) purely so tests can shorten it.\n50: var streamPollInterval = 500 * time.Millisecond\n51: \n52: // streamKeepalive is how long without an emitted event the handler waits\n53: // before writing an SSE comment (`: keepalive`), which carries no data but\n54: // keeps intermediaries (reverse proxies in particular) from declaring the\n55: // connection dead on idle. A var for the same reason.\n56: var streamKeepalive = 30 * time.Second\n57: \n58: // streamLineFlushBytes caps how many bytes may buffer while waiting for a\n59: // newline before the partial line is force-flushed as its own event — a\n60: // pathological no-newline writer (a binary blob tee'd into session.log)\n61: // otherwise grows the handler's line buffer without bound.\n62: const streamLineFlushBytes = 1 << 20 // 1 MiB\n63: \n64: // handleSessionLogStream streams a job's session.log growth as Server-Sent\n65: // Events. No lock: a read-only file tail, per the brief's Notes — streaming\n66: // logs doesn't touch git state and must not block behind an unrelated\n67: // done/delete.\n68: //\n69: // It returns when the client disconnects (r.Context) OR the daemon shuts down\n70: // (s.shutdownCtx — cancelled at the top of Server.Shutdown, because\n71: // http.Server.Shutdown alone only stops accepting new connections and waits\n72: // for in-flight handlers: it never interrupts a handler stuck in its own poll\n73: // loop, so without this select every open stream would force the drain to wait\n74: // out its full timeout).\n75: func (s *Server) handleSessionLogStream(w http.ResponseWriter, r *http.Request) {\n76: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n77: \tif !ok {\n78: \t\treturn\n79: \t}\n80: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n81: \tif !ok {\n82: \t\treturn\n83: \t}\n84: \tlogPath := filepath.Join(j.Dir, \"session.log\") // from the resolved job — never the URL segment\n85: \n86: \t// Parse ?from= before any SSE headers are written, so a bad value is a\n87: \t// clean 400 JSON envelope rather than an error mid-stream.\n88: \tfromSet := false\n89: \tvar from int64\n90: \tif raw := r.URL.Query().Get(\"from\"); raw != \"\" {\n91: \t\tv, err := strconv.ParseInt(raw, 10, 64)\n92: \t\tif err != nil || v < 0 {\n93: \t\t\twriteError(w, http.StatusBadRequest, \"from must be a non-negative byte offset\")\n94: \t\t\treturn\n95: \t\t}\n96: \t\tfrom, fromSet = v, true\n97: \t}\n98: \n99: \tflusher, canFlush := w.(http.Flusher)\n100: \tif !canFlush {\n101: \t\twriteError(w, http.StatusInternalServerError, \"streaming unsupported\")\n102: \t\treturn\n103: \t}\n104: \tw.Header().Set(\"Content-Type\", \"text/event-stream\")\n105: \tw.Header().Set(\"Cache-Control\", \"no-cache\")\n106: \t// Hint for reverse proxies (nginx): do not buffer this response.\n107: \tw.Header().Set(\"X-Accel-Buffering\", \"no\")\n108: \tw.WriteHeader(http.StatusOK)\n109: \n110: \t// Determine the starting offset. See the event-protocol comment above for\n111: \t// the three cases (explicit from / existing file / file not yet created).\n112: \tvar offset int64\n113: \tswitch {\n114: \tcase fromSet:\n115: \t\toffset = from\n116: \tdefault:\n117: \t\tif fi, err := os.Stat(logPath); err == nil {\n118: \t\t\toffset = fi.Size() // tail -f: only new growth\n119: \t\t} else {\n120: \t\t\toffset = 0 // no file yet: capture the whole run when it starts\n121: \t\t}\n122: \t}\n123: \n124: \twrite := func(event, data string) bool {\n125: \t\tif err := writeSSE(w, event, data); err != nil {\n126: \t\t\treturn false\n127: \t\t}\n128: \t\tflusher.Flush()\n129: \t\treturn true\n130: \t}\n131: \n132: \tif !write(\"start\", startEventData(offset)) {\n133: \t\treturn\n134: \t}\n135: \n136: \tvar pending []byte   // bytes of a not-yet-complete line (no \\n yet)\n137: \tlastEmit := time.Now()\n138: \n139: \temitLines := func(chunk []byte) bool {\n140: \t\tpending = append(pending, chunk...)\n141: \t\tfor {\n142: \t\t\tidx := bytes.IndexByte(pending, '\\n')\n143: \t\t\tforce := idx < 0 && len(pending) >= streamLineFlushBytes\n144: \t\t\tif idx < 0 && !force {\n145: \t\t\t\tbreak\n146: \t\t\t}\n147: \t\t\tvar line string\n148: \t\t\tif idx >= 0 {\n149: \t\t\t\tline, pending = string(pending[:idx]), pending[idx+1:]\n150: \t\t\t} else {\n151: \t\t\t\tline, pending = string(pending), nil\n152: \t\t\t}\n153: \t\t\tif !write(\"\", line) {\n154: \t\t\t\treturn false\n155: \t\t\t}\n156: \t\t\tlastEmit = time.Now()\n157: \t\t}\n158: \t\treturn true\n159: \t}\n160: \n161: \tticker := time.NewTicker(streamPollInterval)\n162: \tdefer ticker.Stop()\n163: \tfor {\n164: \t\tselect {\n165: \t\tcase <-r.Context().Done(): // client disconnected\n166: \t\t\tflushPartial(write, &pending)\n167: \t\t\treturn\n168: \t\tcase <-s.shutdownCtx.Done(): // daemon draining\n169: \t\t\tflushPartial(write, &pending)\n170: \t\t\treturn\n171: \t\tcase <-ticker.C:\n172: \t\t\tfi, err := os.Stat(logPath)\n173: \t\t\tswitch {\n174: \t\t\tcase os.IsNotExist(err):\n175: \t\t\t\t// Still waiting for the file to appear — nothing to read.\n176: \t\t\tcase err != nil:\n177: \t\t\t\t// Transient stat failure; retry on the next tick.\n178: \t\t\tcase fi.Size() < offset:\n179: \t\t\t\t// Truncated/rotated below the offset: restart from the top.\n180: \t\t\t\toffset = 0\n181: \t\t\t\tif !write(\"start\", startEventData(0)) {\n182: \t\t\t\t\treturn\n183: \t\t\t\t}\n184: \t\t\t\tlastEmit = time.Now()\n185: \t\t\tcase fi.Size() > offset:\n186: \t\t\t\tchunk, err := readBytesFrom(logPath, offset)\n187: \t\t\t\tif err != nil {\n188: \t\t\t\t\t// Read raced with a writer/truncation; the next tick\n189: \t\t\t\t\t// re-stats and recovers.\n190: \t\t\t\t\tcontinue\n191: \t\t\t\t}\n192: \t\t\t\toffset += int64(len(chunk))\n193: \t\t\t\tif !emitLines(chunk) {\n194: \t\t\t\t\treturn\n195: \t\t\t\t}\n196: \t\t\t}\n197: \t\t\tif time.Since(lastEmit) >= streamKeepalive {\n198: \t\t\t\tif !write(\"\", \"\") { // `: keepalive` comment — see writeSSE\n199: \t\t\t\t\treturn\n200: \t\t\t\t}\n201: \t\t\t\tlastEmit = time.Now()\n202: \t\t\t}\n203: \t\t}\n204: \t}\n205: }\n206: \n207: // flushPartial emits whatever bytes remain in the line buffer as one final\n208: // event, so a trailing line without its newline is not lost when the stream\n209: // ends. Best-effort: the connection may already be gone on a disconnect.\n210: func flushPartial(write func(event, data string) bool, pending *[]byte) {\n211: \tif len(*pending) > 0 {\n212: \t\twrite(\"\", string(*pending))\n213: \t\t*pending = nil\n214: \t}\n215: }\n216: \n217: // writeSSE writes one SSE frame. event is the named-event type (\"\" = the\n218: // default \"message\" event); data is the payload — each of its lines is\n219: // prefixed `data:` per the SSE wire format, and an empty data writes a bare\n220: // `:` comment (the keepalive form, ignored by every SSE parser).\n221: func writeSSE(w http.ResponseWriter, event, data string) error {\n222: \tvar b strings.Builder\n223: \tif event != \"\" {\n224: \t\tb.WriteString(\"event: \" + event + \"\\n\")\n225: \t}\n226: \tif data == \"\" {\n227: \t\tb.WriteString(\": keepalive\\n\\n\")\n228: \t} else {\n229: \t\tfor _, line := range strings.Split(data, \"\\n\") {\n230: \t\t\tb.WriteString(\"data: \" + line + \"\\n\")\n231: \t\t}\n232: \t\tb.WriteString(\"\\n\")\n233: \t}\n234: \t_, err := fmt.Fprint(w, b.String())\n235: \treturn err\n236: }\n237: \n238: // readBytesFrom reads the file's bytes from offset to its current end — a\n239: // fresh open per poll, which sidesteps inode rotation entirely (a held file\n240: // handle would silently keep reading the replaced file forever).\n241: func readBytesFrom(path string, offset int64) ([]byte, error) {\n242: \tf, err := os.Open(path)\n243: \tif err != nil {\n244: \t\treturn nil, err\n245: \t}\n246: \tdefer f.Close()\n247: \tif _, err := f.Seek(offset, 0); err != nil {\n248: \t\treturn nil, err\n249: \t}\n250: \treturn io.ReadAll(f)\n251: }\n252: \n253: // startEventData builds the `start` event's data payload: a JSON object\n254: // carrying the byte offset the stream began (or restarted) at. JSON (not a\n255: // bare number) so the payload is self-describing and forward-compatible —\n256: // the shape the doc comment at the top of this file and startEventOffset\n257: // (the test-side reader) both expect.\n258: func startEventData(offset int64) string {\n259: \treturn fmt.Sprintf(`{\"offset\":%d}`, offset)\n260: }\n261: \n262: // startEventOffset decodes the `start` event's data payload. Test-side helper\n263: // (the handler writes it; tests — and job three, eventually — read it).\n264: func startEventOffset(t testingT, data string) int64 {\n265: \tvar v struct {\n266: \t\tOffset int64 `json:\"offset\"`\n267: \t}\n268: \tif err := json.Unmarshal([]byte(data), &v); err != nil {\n269: \t\tt.Fatalf(\"start event data %q is not an offset: %v\", data, err)\n270: \t}\n271: \treturn v.Offset\n272: }\n273: \n274: // testingT is the subset of testing.T the helpers above need.\n275: type testingT interface {\n276: \tFatalf(format string, args ...any)\n277: }\n\n(End of file - total 277 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n)\n\n// --- GET /projects/{project}/jobs/{job}/session-log/stream (TASK-12) ---------\n\n// The session-log stream is Server-Sent Events over the plain net/http server:\n// no upgrade handshake, no framing protocol, no new dependency — the \"less\n// code against the existing server\" choice the brief's Notes steer toward","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/stream.go","text":"package serve\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n)\n\n// --- GET /projects/{project}/jobs/{job}/session-log/stream (TASK-12) ---------\n\n// The session-log stream is Server-Sent Events over the plain net/http server:\n// no upgrade handshake, no framing protocol, no new dependency — the \"less\n// code against the existing server\" choice the brief's Notes steer toward\n// (Go's stdlib has no WebSocket support natively; SSE is just a long-lived\n// chunked response with `data:` frames and http.Flusher).\n//\n// It is the network twin of the TUI's `l` key: the same\n// docs/jobs/<id>_<slug>/session.log the TUI tails locally, tailed over HTTP\n// instead. The file is a local append-only log, so the \"watch for growth\"\n// mechanism is a plain stat+read-new-bytes poll — no fsnotify/inotify.\n//\n// Event protocol (consumed by job three's web UI; also human-readable under\n// curl):\n//\n//\tevent: start\n//\tdata: {\"offset\":123}\n//\n//\t<one default (message) event per log line, in order>\n//\t<an idle `: keepalive` comment every streamKeepalive, invisible to EventSource>\n//\n// Offsets: with no ?from=, the stream starts at the file's current size when\n// it already exists (tail -f semantics — only new growth) and at byte 0 when\n// it doesn't yet (the launch-then-watch flow: everything from the top once the\n// run starts writing). ?from=<byte offset> overrides both — the reconnect\n// contract: remember the offset (the client tracks it as the bytes it has\n// consumed; `start` reports where a fresh stream began), reconnect with\n// from=<offset> after a drop, lose nothing. If the file shrinks below the\n// offset (truncated/rotated), the stream resets to byte 0 and says so with a\n// fresh `start` event.\n\n// streamPollInterval is how often the handler stats session.log for new bytes.\n// A var (not const) purely so tests can shorten it.\nvar streamPollInterval = 500 * time.Millisecond\n\n// streamKeepalive is how long without an emitted event the handler waits\n// before writing an SSE comment (`: keepalive`), which carries no data but\n// keeps intermediaries (reverse proxies in particular) from declaring the\n// connection dead on idle. A var for the same reason.\nvar streamKeepalive = 30 * time.Second\n\n// streamLineFlushBytes caps how many bytes may buffer while waiting for a\n// newline before the partial line is force-flushed as its own event — a\n// pathological no-newline writer (a binary blob tee'd into session.log)\n// otherwise grows the handler's line buffer without bound.\nconst streamLineFlushBytes = 1 << 20 // 1 MiB\n\n// handleSessionLogStream streams a job's session.log growth as Server-Sent\n// Events. No lock: a read-only file tail, per the brief's Notes — streaming\n// logs doesn't touch git state and must not block behind an unrelated\n// done/delete.\n//\n// It returns when the client disconnects (r.Context) OR the daemon shuts down\n// (s.shutdownCtx — cancelled at the top of Server.Shutdown, because\n// http.Server.Shutdown alone only stops accepting new connections and waits\n// for in-flight handlers: it never interrupts a handler stuck in its own poll\n// loop, so without this select every open stream would force the drain to wait\n// out its full timeout).\nfunc (s *Server) handleSessionLogStream(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\tlogPath := filepath.Join(j.Dir, \"session.log\") // from the resolved job — never the URL segment\n\n\t// Parse ?from= before any SSE headers are written, so a bad value is a\n\t// clean 400 JSON envelope rather than an error mid-stream.\n\tfromSet := false\n\tvar from int64\n\tif raw := r.URL.Query().Get(\"from\"); raw != \"\" {\n\t\tv, err := strconv.ParseInt(raw, 10, 64)\n\t\tif err != nil || v < 0 {\n\t\t\twriteError(w, http.StatusBadRequest, \"from must be a non-negative byte offset\")\n\t\t\treturn\n\t\t}\n\t\tfrom, fromSet = v, true\n\t}\n\n\tflusher, canFlush := w.(http.Flusher)\n\tif !canFlush {\n\t\twriteError(w, http.StatusInternalServerError, \"streaming unsupported\")\n\t\treturn\n\t}\n\tw.Header().Set(\"Content-Type\", \"text/event-stream\")\n\tw.Header().Set(\"Cache-Control\", \"no-cache\")\n\t// Hint for reverse proxies (nginx): do not buffer this response.\n\tw.Header().Set(\"X-Accel-Buffering\", \"no\")\n\tw.WriteHeader(http.StatusOK)\n\n\t// Determine the starting offset. See the event-protocol comment above for\n\t// the three cases (explicit from / existing file / file not yet created).\n\tvar offset int64\n\tswitch {\n\tcase fromSet:\n\t\toffset = from\n\tdefault:\n\t\tif fi, err := os.Stat(logPath); err == nil {\n\t\t\toffset = fi.Size() // tail -f: only new growth\n\t\t} else {\n\t\t\toffset = 0 // no file yet: capture the whole run when it starts\n\t\t}\n\t}\n\n\twrite := func(event, data string) bool {\n\t\tif err := writeSSE(w, event, data); err != nil {\n\t\t\treturn false\n\t\t}\n\t\tflusher.Flush()\n\t\treturn true\n\t}\n\n\tif !write(\"start\", startEventData(offset)) {\n\t\treturn\n\t}\n\n\tvar pending []byte   // bytes of a not-yet-complete line (no \\n yet)\n\tlastEmit := time.Now()\n\n\temitLines := func(chunk []byte) bool {\n\t\tpending = append(pending, chunk...)\n\t\tfor {\n\t\t\tidx := bytes.IndexByte(pending, '\\n')\n\t\t\tforce := idx < 0 && len(pending) >= streamLineFlushBytes\n\t\t\tif idx < 0 && !force {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tvar line string\n\t\t\tif idx >= 0 {\n\t\t\t\tline, pending = string(pending[:idx]), pending[idx+1:]\n\t\t\t} else {\n\t\t\t\tline, pending = string(pending), nil\n\t\t\t}\n\t\t\tif !write(\"\", line) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tlastEmit = time.Now()\n\t\t}\n\t\treturn true\n\t}\n\n\tticker := time.NewTicker(streamPollInterval)\n\tdefer ticker.Stop()\n\tfor {\n\t\tselect {\n\t\tcase <-r.Context().Done(): // client disconnected\n\t\t\tflushPartial(write, &pending)\n\t\t\treturn\n\t\tcase <-s.shutdownCtx.Done(): // daemon draining\n\t\t\tflushPartial(write, &pending)\n\t\t\treturn\n\t\tcase <-ticker.C:\n\t\t\tfi, err := os.Stat(logPath)\n\t\t\tswitch {\n\t\t\tcase os.IsNotExist(err):\n\t\t\t\t// Still waiting for the file to appear — nothing to read.\n\t\t\tcase err != nil:\n\t\t\t\t// Transient stat failure; retry on the next tick.\n\t\t\tcase fi.Size() < offset:\n\t\t\t\t// Truncated/rotated below the offset: restart from the top.\n\t\t\t\toffset = 0\n\t\t\t\tif !write(\"start\", startEventData(0)) {\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t\tlastEmit = time.Now()\n\t\t\tcase fi.Size() > offset:\n\t\t\t\tchunk, err := readBytesFrom(logPath, offset)\n\t\t\t\tif err != nil {\n\t\t\t\t\t// Read raced with a writer/truncation; the next tick\n\t\t\t\t\t// re-stats and recovers.\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\toffset += int64(len(chunk))\n\t\t\t\tif !emitLines(chunk) {\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t}\n\t\t\tif time.Since(lastEmit) >= streamKeepalive {\n\t\t\t\tif !write(\"\", \"\") { // `: keepalive` comment — see writeSSE\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t\tlastEmit = time.Now()\n\t\t\t}\n\t\t}\n\t}\n}\n\n// flushPartial emits whatever bytes remain in the line buffer as one final\n// event, so a trailing line without its newline is not lost when the stream\n// ends. Best-effort: the connection may already be gone on a disconnect.\nfunc flushPartial(write func(event, data string) bool, pending *[]byte) {\n\tif len(*pending) > 0 {\n\t\twrite(\"\", string(*pending))\n\t\t*pending = nil\n\t}\n}\n\n// writeSSE writes one SSE frame. event is the named-event type (\"\" = the\n// default \"message\" event); data is the payload — each of its lines is\n// prefixed `data:` per the SSE wire format, and an empty data writes a bare\n// `:` comment (the keepalive form, ignored by every SSE parser).\nfunc writeSSE(w http.ResponseWriter, event, data string) error {\n\tvar b strings.Builder\n\tif event != \"\" {\n\t\tb.WriteString(\"event: \" + event + \"\\n\")\n\t}\n\tif data == \"\" {\n\t\tb.WriteString(\": keepalive\\n\\n\")\n\t} else {\n\t\tfor _, line := range strings.Split(data, \"\\n\") {\n\t\t\tb.WriteString(\"data: \" + line + \"\\n\")\n\t\t}\n\t\tb.WriteString(\"\\n\")\n\t}\n\t_, err := fmt.Fprint(w, b.String())\n\treturn err\n}\n\n// readBytesFrom reads the file's bytes from offset to its current end — a\n// fresh open per poll, which sidesteps inode rotation entirely (a held file\n// handle would silently keep reading the replaced file forever).\nfunc readBytesFrom(path string, offset int64) ([]byte, error) {\n\tf, err := os.Open(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdefer f.Close()\n\tif _, err := f.Seek(offset, 0); err != nil {\n\t\treturn nil, err\n\t}\n\treturn io.ReadAll(f)\n}\n\n// startEventData builds the `start` event's data payload: a JSON object\n// carrying the byte offset the stream began (or restarted) at. JSON (not a\n// bare number) so the payload is self-describing and forward-compatible —\n// the shape the doc comment at the top of this file and startEventOffset\n// (the test-side reader) both expect.\nfunc startEventData(offset int64) string {\n\treturn fmt.Sprintf(`{\"offset\":%d}`, offset)\n}\n\n// startEventOffset decodes the `start` event's data payload. Test-side helper\n// (the handler writes it; tests — and job three, eventually — read it).\nfunc startEventOffset(t testingT, data string) int64 {\n\tvar v struct {\n\t\tOffset int64 `json:\"offset\"`\n\t}\n\tif err := json.Unmarshal([]byte(data), &v); err != nil {\n\t\tt.Fatalf(\"start event data %q is not an offset: %v\", data, err)\n\t}\n\treturn v.Offset\n}\n\n// testingT is the subset of testing.T the helpers above need.\ntype testingT interface {\n\tFatalf(format string, args ...any)\n}","lineStart":1,"lineEnd":277,"totalLines":277,"truncated":false}},"title":"src/internal/serve/stream.go","time":{"start":1787952481515,"end":1787952481519}},"id":"prt_04a45c4a30017PdYm55gC2vvMT","sessionID":"ses_fb5ba93f2ffe9RBBAgSFG35dIN","messageID":"msg_04a45b6fb001TM9PImwMP9TP42"}}
{"type":"tool_use","timestamp":1787952481611,"sessionID":"ses_fb5ba93f2ffe9RBBAgSFG35dIN","part":{"type":"tool","tool":"read","callID":"call_84a6141213e344af9ef2ba5b","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/session/oneshot.go"},"output":"<path>/workspace/src/internal/session/oneshot.go</path>\n<type>file</type>\n<content>\n1: package session\n2: \n3: import (\n4: \t\"bytes\"\n5: \t\"fmt\"\n6: \t\"io\"\n7: \t\"path/filepath\"\n8: \t\"strings\"\n9: \n10: \t\"github.com/lmuskalla/manigot/internal/job\"\n11: )\n12: \n13: // AgentRunner runs one non-interactive agent invocation for job j and\n14: // returns its captured raw output. live receives the exact same bytes as\n15: // they arrive, so a caller can tee them into a live log. Mirrors cmd/mg/\n16: // jdi.go's own AgentRunner interface — that package cannot be imported here\n17: // (cmd/mg already depends on internal/session, not the other way around),\n18: // so the shape is duplicated rather than shared; CommandAgentRunner below is\n19: // this package's own concrete implementation, independent of cmd/mg's\n20: // private commandAgentRunner.\n21: type AgentRunner interface {\n22: \tRun(agent string, j job.Job, live io.Writer) ([]byte, error)\n23: }\n24: \n25: // CommandAgentRunner is the real AgentRunner for callers outside mg-jdi\n26: // (internal/serve's detached one-shot agent launch, today): a single --print\n27: // invocation via this package's own ResolveProfile → ResolveRootFrom →\n28: // CheckAuth → BuildDockerInvocation → DockerInvocation.Run path, ending with\n29: // the same post-run worktree sweep (SweepJobWorktree) mg-jdi's own runner\n30: // performs so nothing an agent (or this invocation's own session.log\n31: // section) left uncommitted lingers in the job's worktree.\n32: type CommandAgentRunner struct {\n33: \t// ProjectRoot is where --job resolution starts from (mirrors\n34: \t// cmd/mg/jdi.go's commandAgentRunner.projectRoot).\n35: \tProjectRoot string\n36: \t// Profile is the subscription profile every invocation runs under.\n37: \tProfile string\n38: }\n39: \n40: // Run invokes the session launcher's --print path synchronously and returns\n41: // its captured stdout. live receives the exact same bytes as they arrive —\n42: // the io.MultiWriter tee that lets a caller grow a live log during the\n43: // invocation. j.Name (the exact job directory name) is passed rather than\n44: // j.ID to remove any ambiguity in the --job resolution.\n45: func (r *CommandAgentRunner) Run(agent string, j job.Job, live io.Writer) ([]byte, error) {\n46: \topts := Options{Print: true, Profile: r.Profile, Agent: agent, Job: j.Name}\n47: \tinfo, err := ResolveProfile(opts)\n48: \tif err != nil {\n49: \t\treturn nil, err\n50: \t}\n51: \troot, err := ResolveRootFrom(opts, r.ProjectRoot)\n52: \tif err != nil {\n53: \t\treturn nil, err\n54: \t}\n55: \tif err := info.CheckAuth(); err != nil {\n56: \t\treturn nil, err\n57: \t}\n58: \n59: \tvar diag bytes.Buffer\n60: \tinv, err := BuildDockerInvocation(opts, info, root, false, &diag)\n61: \tif err != nil {\n62: \t\treturn nil, err\n63: \t}\n64: \n65: \t// Prune orphaned manigot containers before the run — the same fail-soft\n66: \t// self-healing cleanup as every other launch path. A prune failure never\n67: \t// aborts the invocation.\n68: \tif _, err := PruneOrphans(&diag); err != nil {\n69: \t\tfmt.Fprintf(&diag, \"mg: warning: could not prune orphaned containers: %v\\n\", err)\n70: \t}\n71: \n72: \tvar stdout bytes.Buffer\n73: \t// No interactive stdin: this runner is only ever used for a detached,\n74: \t// one-shot --print invocation with nobody at a terminal to type into it.\n75: \tcode, ran := inv.Run(nil, io.MultiWriter(&stdout, live), &diag)\n76: \t// Same host-side sweep as every other --print invocation: commits\n77: \t// whatever the agent (and this invocation's own session.log section) left\n78: \t// uncommitted. Sweep only when the container actually ran.\n79: \tif ran {\n80: \t\tSweepJobWorktree(root, &diag)\n81: \t}\n82: \tif code != 0 {\n83: \t\treturn stdout.Bytes(), fmt.Errorf(\"mg --print --agent %s --job %s: exit code %d: %s\", agent, j.Name, code, strings.TrimSpace(diag.String()))\n84: \t}\n85: \treturn stdout.Bytes(), nil\n86: }\n87: \n88: // RunOneShot runs one agent invocation for job j via runner, opening a\n89: // job.OpenSessionLog section (attempt fixed at 1 — this is not part of an\n90: // mg-jdi run, so there is no per-agent attempt counter to thread through)\n91: // before the invocation and closing it after, tee-ing the invocation's raw\n92: // output into it live exactly as mg-jdi's own loop does.\n93: //\n94: // It is meant to be started in its own goroutine by an HTTP handler that\n95: // returns immediately instead of blocking for the invocation's full duration\n96: // (see internal/serve's detached agent-launch endpoint) — the goroutine's\n97: // own errors have nowhere to report back to an already-returned HTTP\n98: // response, so RunOneShot writes a failure into the same session.log section\n99: // rather than dropping it silently, in addition to returning it (for a\n100: // caller — chiefly a test — that runs it synchronously and wants the error\n101: // directly).\n102: //\n103: // A failure to even open the session.log is best-effort, matching mg-jdi's\n104: // own loop: the invocation still runs (with live output simply discarded),\n105: // and only the open failure itself is returned/reported.\n106: //\n107: // KNOWN LIMITATION (documented, not solved here — see the brief's own\n108: // callout): a concurrently-running mg-jdi loop against the SAME job would\n109: // also be writing to the same session.log file at the same time. That is\n110: // safe against file corruption — both are append-only,\n111: // single-writer-per-section — but the underlying git worktree itself would\n112: // have two independent processes touching it (container invocations,\n113: // worktree sweeps), which this function does not detect or prevent.\n114: func RunOneShot(runner AgentRunner, agent string, j job.Job) error {\n115: \tsess, sessErr := job.OpenSessionLog(filepath.Join(j.Dir, \"session.log\"), agent, 1)\n116: \tvar live io.Writer = io.Discard\n117: \tif sess != nil {\n118: \t\tlive = sess\n119: \t}\n120: \n121: \t_, runErr := runner.Run(agent, j, live)\n122: \n123: \tif runErr != nil && sess != nil {\n124: \t\tfmt.Fprintf(sess, \"\\nmg serve: agent invocation failed: %v\\n\", runErr)\n125: \t}\n126: \tif sess != nil {\n127: \t\tif cerr := sess.Close(); cerr != nil && runErr == nil {\n128: \t\t\trunErr = fmt.Errorf(\"could not finalize session log: %w\", cerr)\n129: \t\t}\n130: \t}\n131: \tif runErr != nil {\n132: \t\treturn runErr\n133: \t}\n134: \tif sessErr != nil {\n135: \t\treturn fmt.Errorf(\"could not open session log: %w\", sessErr)\n136: \t}\n137: \treturn nil\n138: }\n\n(End of file - total 138 lines)\n</content>","metadata":{"preview":"package session\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"io\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// AgentRunner runs one non-interactive agent invocation for job j and\n// returns its captured raw output. live receives the exact same bytes as\n// they arrive, so a caller can tee them into a live log. Mirrors cmd/mg/\n// jdi.go's own AgentRunner interface — that package cannot be imported here\n// (cmd/mg already depends on internal/session, not the other way around),\n// so the shape is duplicated rather than shared; CommandAgentRunner below is\n// this package's own concrete implementation, independent of cmd/mg's\n// private commandAgentRunner.","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/session/oneshot.go","text":"package session\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"io\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// AgentRunner runs one non-interactive agent invocation for job j and\n// returns its captured raw output. live receives the exact same bytes as\n// they arrive, so a caller can tee them into a live log. Mirrors cmd/mg/\n// jdi.go's own AgentRunner interface — that package cannot be imported here\n// (cmd/mg already depends on internal/session, not the other way around),\n// so the shape is duplicated rather than shared; CommandAgentRunner below is\n// this package's own concrete implementation, independent of cmd/mg's\n// private commandAgentRunner.\ntype AgentRunner interface {\n\tRun(agent string, j job.Job, live io.Writer) ([]byte, error)\n}\n\n// CommandAgentRunner is the real AgentRunner for callers outside mg-jdi\n// (internal/serve's detached one-shot agent launch, today): a single --print\n// invocation via this package's own ResolveProfile → ResolveRootFrom →\n// CheckAuth → BuildDockerInvocation → DockerInvocation.Run path, ending with\n// the same post-run worktree sweep (SweepJobWorktree) mg-jdi's own runner\n// performs so nothing an agent (or this invocation's own session.log\n// section) left uncommitted lingers in the job's worktree.\ntype CommandAgentRunner struct {\n\t// ProjectRoot is where --job resolution starts from (mirrors\n\t// cmd/mg/jdi.go's commandAgentRunner.projectRoot).\n\tProjectRoot string\n\t// Profile is the subscription profile every invocation runs under.\n\tProfile string\n}\n\n// Run invokes the session launcher's --print path synchronously and returns\n// its captured stdout. live receives the exact same bytes as they arrive —\n// the io.MultiWriter tee that lets a caller grow a live log during the\n// invocation. j.Name (the exact job directory name) is passed rather than\n// j.ID to remove any ambiguity in the --job resolution.\nfunc (r *CommandAgentRunner) Run(agent string, j job.Job, live io.Writer) ([]byte, error) {\n\topts := Options{Print: true, Profile: r.Profile, Agent: agent, Job: j.Name}\n\tinfo, err := ResolveProfile(opts)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\troot, err := ResolveRootFrom(opts, r.ProjectRoot)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif err := info.CheckAuth(); err != nil {\n\t\treturn nil, err\n\t}\n\n\tvar diag bytes.Buffer\n\tinv, err := BuildDockerInvocation(opts, info, root, false, &diag)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\t// Prune orphaned manigot containers before the run — the same fail-soft\n\t// self-healing cleanup as every other launch path. A prune failure never\n\t// aborts the invocation.\n\tif _, err := PruneOrphans(&diag); err != nil {\n\t\tfmt.Fprintf(&diag, \"mg: warning: could not prune orphaned containers: %v\\n\", err)\n\t}\n\n\tvar stdout bytes.Buffer\n\t// No interactive stdin: this runner is only ever used for a detached,\n\t// one-shot --print invocation with nobody at a terminal to type into it.\n\tcode, ran := inv.Run(nil, io.MultiWriter(&stdout, live), &diag)\n\t// Same host-side sweep as every other --print invocation: commits\n\t// whatever the agent (and this invocation's own session.log section) left\n\t// uncommitted. Sweep only when the container actually ran.\n\tif ran {\n\t\tSweepJobWorktree(root, &diag)\n\t}\n\tif code != 0 {\n\t\treturn stdout.Bytes(), fmt.Errorf(\"mg --print --agent %s --job %s: exit code %d: %s\", agent, j.Name, code, strings.TrimSpace(diag.String()))\n\t}\n\treturn stdout.Bytes(), nil\n}\n\n// RunOneShot runs one agent invocation for job j via runner, opening a\n// job.OpenSessionLog section (attempt fixed at 1 — this is not part of an\n// mg-jdi run, so there is no per-agent attempt counter to thread through)\n// before the invocation and closing it after, tee-ing the invocation's raw\n// output into it live exactly as mg-jdi's own loop does.\n//\n// It is meant to be started in its own goroutine by an HTTP handler that\n// returns immediately instead of blocking for the invocation's full duration\n// (see internal/serve's detached agent-launch endpoint) — the goroutine's\n// own errors have nowhere to report back to an already-returned HTTP\n// response, so RunOneShot writes a failure into the same session.log section\n// rather than dropping it silently, in addition to returning it (for a\n// caller — chiefly a test — that runs it synchronously and wants the error\n// directly).\n//\n// A failure to even open the session.log is best-effort, matching mg-jdi's\n// own loop: the invocation still runs (with live output simply discarded),\n// and only the open failure itself is returned/reported.\n//\n// KNOWN LIMITATION (documented, not solved here — see the brief's own\n// callout): a concurrently-running mg-jdi loop against the SAME job would\n// also be writing to the same session.log file at the same time. That is\n// safe against file corruption — both are append-only,\n// single-writer-per-section — but the underlying git worktree itself would\n// have two independent processes touching it (container invocations,\n// worktree sweeps), which this function does not detect or prevent.\nfunc RunOneShot(runner AgentRunner, agent string, j job.Job) error {\n\tsess, sessErr := job.OpenSessionLog(filepath.Join(j.Dir, \"session.log\"), agent, 1)\n\tvar live io.Writer = io.Discard\n\tif sess != nil {\n\t\tlive = sess\n\t}\n\n\t_, runErr := runner.Run(agent, j, live)\n\n\tif runErr != nil && sess != nil {\n\t\tfmt.Fprintf(sess, \"\\nmg serve: agent invocation failed: %v\\n\", runErr)\n\t}\n\tif sess != nil {\n\t\tif cerr := sess.Close(); cerr != nil && runErr == nil {\n\t\t\trunErr = fmt.Errorf(\"could not finalize session log: %w\", cerr)\n\t\t}\n\t}\n\tif runErr != nil {\n\t\treturn runErr\n\t}\n\tif sessErr != nil {\n\t\treturn fmt.Errorf(\"could not open session log: %w\", sessErr)\n\t}\n\treturn nil\n}","lineStart":1,"lineEnd":138,"totalLines":138,"truncated":false}},"title":"src/internal/session/oneshot.go","time":{"start":1787952481606,"end":1787952481610}},"id":"prt_04a45c4f0001TWitM8RAZ8SgKC","sessionID":"ses_fb5ba93f2ffe9RBBAgSFG35dIN","messageID":"msg_04a45b6fb001TM9PImwMP9TP42"}}
