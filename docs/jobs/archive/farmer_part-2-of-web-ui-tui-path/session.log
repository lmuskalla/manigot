{"type":"tool_use","timestamp":1787950322714,"sessionID":"ses_fb5dcd7a6ffeSGBPKFVeVpziRm","part":{"type":"tool","tool":"read","callID":"call_8eda9f6584fd4f33adf09981","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/api_test.go","offset":600},"output":"<path>/workspace/src/internal/serve/api_test.go</path>\n<type>file</type>\n<content>\n600: \n601: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/agents\", \"\")\n602: \tif rec.Code != http.StatusOK {\n603: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n604: \t}\n605: \tvar body agentsResponse\n606: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n607: \t\tt.Fatalf(\"body not JSON: %v\", err)\n608: \t}\n609: \tif len(body.Agents) != 2 {\n610: \t\tt.Fatalf(\"agents = %d, want 2:\\n%s\", len(body.Agents), rec.Body.String())\n611: \t}\n612: \t// Sorted by name: analyst first.\n613: \tif body.Agents[0].Name != \"analyst\" || !strings.Contains(body.Agents[0].Description, \"tasks\") {\n614: \t\tt.Errorf(\"agent[0] = %+v, want analyst with its description\", body.Agents[0])\n615: \t}\n616: \tif body.Agents[1].Name != \"reviewer\" {\n617: \t\tt.Errorf(\"agent[1] = %+v, want reviewer\", body.Agents[1])\n618: \t}\n619: \t// No full agent-file contents leak into the response.\n620: \tif strings.Contains(rec.Body.String(), \"name: analyst\") {\n621: \t\tt.Errorf(\"response leaks the raw agent file: %s\", rec.Body.String())\n622: \t}\n623: }\n624: \n625: // --- TASK-5: /health ---------------------------------------------------------\n626: \n627: // TestHandleHealthReportsVersionImageAndProfiles: /health reports the version,\n628: // docker image presence, and per-profile readiness — identifiers and booleans\n629: // only, never credential values. The docker presence and readiness booleans\n630: // depend on the machine the test runs on (session.ImagePresent degrades to\n631: // false when docker is missing; profile readiness is an env read), so the\n632: // shape — every profile present, every field present — is what is pinned.\n633: func TestHandleHealthReportsVersionImageAndProfiles(t *testing.T) {\n634: \tsrv := New(&Registry{}, \"1.2.3-test\", \"\", nil)\n635: \trec := get(t, srv, \"/health\", \"\")\n636: \tif rec.Code != http.StatusOK {\n637: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n638: \t}\n639: \tvar body healthResponse\n640: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n641: \t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n642: \t}\n643: \tif body.Version != \"1.2.3-test\" {\n644: \t\tt.Errorf(\"version = %q, want the version passed into New\", body.Version)\n645: \t}\n646: \t// imagePresent must be a real boolean (present in the JSON), whatever its\n647: \t// value on this machine.\n648: \tvar raw map[string]json.RawMessage\n649: \tif err := json.Unmarshal(rec.Body.Bytes(), &raw); err != nil {\n650: \t\tt.Fatal(err)\n651: \t}\n652: \tif _, ok := raw[\"imagePresent\"]; !ok {\n653: \t\tt.Errorf(\"imagePresent missing from /health: %s\", rec.Body.String())\n654: \t}\n655: \n656: \tif len(body.Profiles) != 5 {\n657: \t\tt.Fatalf(\"profiles = %d, want 5 (claude-pro, zai, opencode-go, opencode-zen, opencode-zen-free):\\n%s\",\n658: \t\t\tlen(body.Profiles), rec.Body.String())\n659: \t}\n660: \tseen := map[string]bool{}\n661: \tfor _, p := range body.Profiles {\n662: \t\tif p.ID == \"\" {\n663: \t\t\tt.Errorf(\"profile row with empty id: %+v\", p)\n664: \t\t}\n665: \t\tseen[p.ID] = true\n666: \t}\n667: \tfor _, id := range []string{\"claude-pro\", \"zai\", \"opencode-go\", \"opencode-zen\", \"opencode-zen-free\"} {\n668: \t\tif !seen[id] {\n669: \t\t\tt.Errorf(\"profile %q missing from /health\", id)\n670: \t\t}\n671: \t}\n672: }\n673: \n674: // TestHandleHealthRequiresAuth: /health is inside the same auth boundary as\n675: // every other endpoint — with a token configured, it is a 401 without one.\n676: func TestHandleHealthRequiresAuth(t *testing.T) {\n677: \tsrv := New(&Registry{}, \"1.2.3-test\", \"sekrit-token\", nil)\n678: \tif rec := get(t, srv, \"/health\", \"\"); rec.Code != http.StatusUnauthorized {\n679: \t\tt.Errorf(\"no token: status = %d, want 401\", rec.Code)\n680: \t}\n681: \tif rec := get(t, srv, \"/health\", \"Bearer sekrit-token\"); rec.Code != http.StatusOK {\n682: \t\tt.Errorf(\"with token: status = %d, want 200\", rec.Code)\n683: \t}\n684: }\n\n(End of file - total 684 lines)\n</content>","metadata":{"preview":"\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/agents\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body agentsResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif len(body.Agents) != 2 {\n\t\tt.Fatalf(\"agents = %d, want 2:\\n%s\", len(body.Agents), rec.Body.String())\n\t}\n\t// Sorted by name: analyst first.\n\tif body.Agents[0].Name != \"analyst\" || !strings.Contains(body.Agents[0].Description, \"tasks\") {\n\t\tt.Errorf(\"agent[0] = %+v, want analyst with its description\", body.Agents[0])\n\t}\n\tif body.Agents[1].Name != \"reviewer\" {\n\t\tt.Errorf(\"agent[1] = %+v, want reviewer\", body.Agents[1])\n\t}\n\t// No full agent-file contents leak into the response.","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/api_test.go","text":"\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/agents\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body agentsResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif len(body.Agents) != 2 {\n\t\tt.Fatalf(\"agents = %d, want 2:\\n%s\", len(body.Agents), rec.Body.String())\n\t}\n\t// Sorted by name: analyst first.\n\tif body.Agents[0].Name != \"analyst\" || !strings.Contains(body.Agents[0].Description, \"tasks\") {\n\t\tt.Errorf(\"agent[0] = %+v, want analyst with its description\", body.Agents[0])\n\t}\n\tif body.Agents[1].Name != \"reviewer\" {\n\t\tt.Errorf(\"agent[1] = %+v, want reviewer\", body.Agents[1])\n\t}\n\t// No full agent-file contents leak into the response.\n\tif strings.Contains(rec.Body.String(), \"name: analyst\") {\n\t\tt.Errorf(\"response leaks the raw agent file: %s\", rec.Body.String())\n\t}\n}\n\n// --- TASK-5: /health ---------------------------------------------------------\n\n// TestHandleHealthReportsVersionImageAndProfiles: /health reports the version,\n// docker image presence, and per-profile readiness — identifiers and booleans\n// only, never credential values. The docker presence and readiness booleans\n// depend on the machine the test runs on (session.ImagePresent degrades to\n// false when docker is missing; profile readiness is an env read), so the\n// shape — every profile present, every field present — is what is pinned.\nfunc TestHandleHealthReportsVersionImageAndProfiles(t *testing.T) {\n\tsrv := New(&Registry{}, \"1.2.3-test\", \"\", nil)\n\trec := get(t, srv, \"/health\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body healthResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif body.Version != \"1.2.3-test\" {\n\t\tt.Errorf(\"version = %q, want the version passed into New\", body.Version)\n\t}\n\t// imagePresent must be a real boolean (present in the JSON), whatever its\n\t// value on this machine.\n\tvar raw map[string]json.RawMessage\n\tif err := json.Unmarshal(rec.Body.Bytes(), &raw); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, ok := raw[\"imagePresent\"]; !ok {\n\t\tt.Errorf(\"imagePresent missing from /health: %s\", rec.Body.String())\n\t}\n\n\tif len(body.Profiles) != 5 {\n\t\tt.Fatalf(\"profiles = %d, want 5 (claude-pro, zai, opencode-go, opencode-zen, opencode-zen-free):\\n%s\",\n\t\t\tlen(body.Profiles), rec.Body.String())\n\t}\n\tseen := map[string]bool{}\n\tfor _, p := range body.Profiles {\n\t\tif p.ID == \"\" {\n\t\t\tt.Errorf(\"profile row with empty id: %+v\", p)\n\t\t}\n\t\tseen[p.ID] = true\n\t}\n\tfor _, id := range []string{\"claude-pro\", \"zai\", \"opencode-go\", \"opencode-zen\", \"opencode-zen-free\"} {\n\t\tif !seen[id] {\n\t\t\tt.Errorf(\"profile %q missing from /health\", id)\n\t\t}\n\t}\n}\n\n// TestHandleHealthRequiresAuth: /health is inside the same auth boundary as\n// every other endpoint — with a token configured, it is a 401 without one.\nfunc TestHandleHealthRequiresAuth(t *testing.T) {\n\tsrv := New(&Registry{}, \"1.2.3-test\", \"sekrit-token\", nil)\n\tif rec := get(t, srv, \"/health\", \"\"); rec.Code != http.StatusUnauthorized {\n\t\tt.Errorf(\"no token: status = %d, want 401\", rec.Code)\n\t}\n\tif rec := get(t, srv, \"/health\", \"Bearer sekrit-token\"); rec.Code != http.StatusOK {\n\t\tt.Errorf(\"with token: status = %d, want 200\", rec.Code)\n\t}\n}","lineStart":600,"lineEnd":684,"totalLines":684,"truncated":false}},"title":"src/internal/serve/api_test.go","time":{"start":1787950322709,"end":1787950322713}},"id":"prt_04a24d3dd001MKDi1mmzufKnKb","sessionID":"ses_fb5dcd7a6ffeSGBPKFVeVpziRm","messageID":"msg_04a24ce34001YSuYqlqrZOqn0k"}}
{"type":"tool_use","timestamp":1787950322841,"sessionID":"ses_fb5dcd7a6ffeSGBPKFVeVpziRm","part":{"type":"tool","tool":"read","callID":"call_963cceaba82b47bdad77b328","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/credentials_test.go"},"output":"<path>/workspace/src/internal/serve/credentials_test.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"encoding/json\"\n5: \t\"net/http\"\n6: \t\"os\"\n7: \t\"path/filepath\"\n8: \t\"strings\"\n9: \t\"testing\"\n10: \n11: \t\"github.com/lmuskalla/manigot/internal/job\"\n12: )\n13: \n14: // credentialKeys are the keys whose values must never appear in any response\n15: // body — the daemon's credential surface: subscription tokens, API keys, the\n16: // serve token, and the per-profile model keys. The test reads their values via\n17: // the same config.EnvValue path the daemon itself reads (the .env file in the\n18: // manigot checkout, then the process environment), so the test and the server\n19: // can never drift on what counts as a credential.\n20: var credentialKeys = []string{\n21: \t\"CLAUDE_CODE_OAUTH_TOKEN\",\n22: \t\"CLAUDE_ACCOUNT_UUID\",\n23: \t\"CLAUDE_EMAIL\",\n24: \t\"CLAUDE_ORG_UUID\",\n25: \t\"ANTHROPIC_API_KEY\",\n26: \t\"OPENCODE_API_KEY\",\n27: \t\"ZHIPU_API_KEY\",\n28: \t\"MG_SERVE_TOKEN\",\n29: \t\"OPENCODE_ZAI_MODEL\",\n30: \t\"OPENCODE_GO_MODEL\",\n31: \t\"OPENCODE_ZEN_MODEL\",\n32: \t\"OPENCODE_ZEN_FREE_MODEL\",\n33: \t\"OPENCODE_MODEL\",\n34: \t\"OPENCODE_THEME\",\n35: }\n36: \n37: // TestCredentialsNeverReturned is the brief's \"no .env content, no keys, no\n38: // tokens in any response, ever\" guarantee enforced over the whole surface: a\n39: // known credential value is planted in the daemon's real credential source\n40: // (.env + process env), every endpoint is hit (with the correct bearer token),\n41: // and every response body — including a 401 — is grepped for the values.\n42: func TestCredentialsNeverReturned(t *testing.T) {\n43: \t// The credential source: a fake checkout's .env plus the process\n44: \t// environment, both read through config.EnvValue exactly as the daemon\n45: \t// reads them.\n46: \tenvLines := map[string]string{}\n47: \tfor _, key := range credentialKeys {\n48: \t\tenvLines[key] = \"fixture-\" + key + \"-VALUE\"\n49: \t\tt.Setenv(key, envLines[key])\n50: \t}\n51: \tcheckout := fakeCheckout(t, map[string]string{\n52: \t\t\"analyst\": \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n53: \t})\n54: \t// The .env file itself — the daemon's preferred source. Two extra\n55: \t// non-credential lines ride along to pin the \"no full line of .env\n56: \t// content\" half of the guarantee.\n57: \tvar envFile strings.Builder\n58: \tfor _, key := range credentialKeys {\n59: \t\tenvFile.WriteString(key + \"=\" + envLines[key] + \"\\n\")\n60: \t}\n61: \tenvFile.WriteString(\"# a comment line in the env\\n\")\n62: \tenvFile.WriteString(\"UNRELATED_SETTING=some-value\\n\")\n63: \tif err := os.WriteFile(filepath.Join(checkout, \".env\"), []byte(envFile.String()), 0o644); err != nil {\n64: \t\tt.Fatal(err)\n65: \t}\n66: \n67: \t// A non-git project with a job (exercises projects/jobs/files/jdi/agents),\n68: \t// and a git repo with a job branch (exercises diff).\n69: \tjobProj := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"),\n70: \t\t\"tasks.md\", \"implementation.md\", \"verdict.md\")\n71: \tif err := writeJDIStatusForTest(t, jobProj, \"wood_oak\"); err != nil {\n72: \t\tt.Fatal(err)\n73: \t}\n74: \tlogDir := job.JDIStatusDir(jobProj, \"wood_oak\")\n75: \tif err := os.MkdirAll(logDir, 0o755); err != nil {\n76: \t\tt.Fatal(err)\n77: \t}\n78: \tif err := os.WriteFile(job.JDIRunLogPath(jobProj, \"wood_oak\"), []byte(\"run log content\\n\"), 0o644); err != nil {\n79: \t\tt.Fatal(err)\n80: \t}\n81: \tif err := os.WriteFile(filepath.Join(jobProj, \"docs\", \"jobs\", \"wood_oak\", \"session.log\"), []byte(\"session log content\\n\"), 0o644); err != nil {\n82: \t\tt.Fatal(err)\n83: \t}\n84: \n85: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n86: \tgitProj := initGitRepo(t)\n87: \trunGitT(t, gitProj, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n88: \tif err := os.WriteFile(filepath.Join(gitProj, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n89: \t\tt.Fatal(err)\n90: \t}\n91: \trunGitT(t, gitProj, \"add\", \"feature.txt\")\n92: \trunGitT(t, gitProj, \"commit\", \"-q\", \"-m\", \"add the feature\")\n93: \trunGitT(t, gitProj, \"checkout\", \"-q\", \"main\")\n94: \n95: \treg := &Registry{entries: []Entry{entryFor(jobProj), entryFor(gitProj)}}\n96: \ttoken := envLines[\"MG_SERVE_TOKEN\"]\n97: \tvar audit strings.Builder\n98: \tsrv := New(reg, \"test-version\", token, &audit)\n99: \tauth := \"Bearer \" + token\n100: \n101: \t// Every endpoint, plus a 401 (no token) and a 404 (unknown job) — the\n102: \t// error envelopes are response surfaces too.\n103: \tpaths := []string{\n104: \t\t\"/health\",\n105: \t\t\"/projects\",\n106: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs\",\n107: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/brief.md\",\n108: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/tasks.md\",\n109: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/implementation.md\",\n110: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/verdict.md\",\n111: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/jdi\",\n112: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/agents\",\n113: \t\t\"/projects/\" + filepath.Base(gitProj) + \"/jobs/wood_test/diff\",\n114: \t\t\"/projects/\" + filepath.Base(gitProj) + \"/jobs/wood_test/diff?full=1\",\n115: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/jdi?bogus=1\",\n116: \t\t\"/projects/no-such-project/jobs\",\n117: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/no-such-job/files/brief.md\",\n118: \t}\n119: \tfor _, p := range paths {\n120: \t\trec := get(t, srv, p, auth)\n121: \t\tassertBodyHasNoCredentials(t, rec.Body.String(), envLines, envFile.String())\n122: \t}\n123: \n124: \t// The 401 body (missing and wrong token) — an unauthenticated response\n125: \t// must not leak the token either.\n126: \tfor _, badAuth := range []string{\"\", \"Bearer wrong\"} {\n127: \t\trec := get(t, srv, \"/projects\", badAuth)\n128: \t\tif rec.Code != http.StatusUnauthorized {\n129: \t\t\tt.Fatalf(\"bad auth %q: status = %d, want 401\", badAuth, rec.Code)\n130: \t\t}\n131: \t\tassertBodyHasNoCredentials(t, rec.Body.String(), envLines, envFile.String())\n132: \t}\n133: \n134: \t// The audit log likewise never carries the Authorization header or the\n135: \t// token (the auth= field is the outcome classification only).\n136: \tif strings.Contains(audit.String(), token) {\n137: \t\tt.Errorf(\"audit log contains the token:\\n%s\", audit.String())\n138: \t}\n139: \tfor _, line := range strings.Split(audit.String(), \"\\n\") {\n140: \t\tif strings.Contains(line, \"Authorization\") || strings.Contains(line, \"Bearer \") {\n141: \t\t\tt.Errorf(\"audit log echoes the Authorization header: %q\", line)\n142: \t\t}\n143: \t}\n144: }\n145: \n146: // assertBodyHasNoCredentials fails the test if body contains any planted\n147: // credential value or any full line of the .env file.\n148: func assertBodyHasNoCredentials(t *testing.T, body string, envLines map[string]string, envFileContent string) {\n149: \tt.Helper()\n150: \tfor _, key := range credentialKeys {\n151: \t\tif strings.Contains(body, envLines[key]) {\n152: \t\t\tt.Errorf(\"response leaks the value of %s:\\n%s\", key, body)\n153: \t\t}\n154: \t}\n155: \tfor _, line := range strings.Split(envFileContent, \"\\n\") {\n156: \t\tif line == \"\" {\n157: \t\t\tcontinue\n158: \t\t}\n159: \t\tif strings.Contains(body, line) {\n160: \t\t\tt.Errorf(\"response contains a full .env line %q:\\n%s\", line, body)\n161: \t\t}\n162: \t}\n163: }\n164: \n165: // TestCredentialValuesDoNotAppearInErrorMessages: error envelopes carry only\n166: // validated identifiers — never anything that could echo a credential.\n167: func TestCredentialValuesDoNotAppearInErrorMessages(t *testing.T) {\n168: \tt.Setenv(\"MG_SERVE_TOKEN\", \"fixture-token-12345\")\n169: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n170: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"fixture-token-12345\", nil)\n171: \n172: \t// The error envelope shape is exactly {\"error\": \"...\"} — nothing else.\n173: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/nope/files/brief.md\", \"Bearer fixture-token-12345\")\n174: \tif rec.Code != http.StatusNotFound {\n175: \t\tt.Fatalf(\"status = %d, want 404\", rec.Code)\n176: \t}\n177: \tvar envelope map[string]string\n178: \tif err := json.Unmarshal(rec.Body.Bytes(), &envelope); err != nil {\n179: \t\tt.Fatalf(\"error body not a JSON envelope: %v (%s)\", err, rec.Body.String())\n180: \t}\n181: \tif len(envelope) != 1 || envelope[\"error\"] == \"\" {\n182: \t\tt.Errorf(\"error envelope = %v, want exactly one error key\", envelope)\n183: \t}\n184: \tif strings.Contains(rec.Body.String(), \"fixture-token-12345\") {\n185: \t\tt.Errorf(\"error body leaks the token: %s\", rec.Body.String())\n186: \t}\n187: }\n\n(End of file - total 187 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// credentialKeys are the keys whose values must never appear in any response\n// body — the daemon's credential surface: subscription tokens, API keys, the\n// serve token, and the per-profile model keys. The test reads their values via\n// the same config.EnvValue path the daemon itself reads (the .env file in the\n// manigot checkout, then the process environment), so the test and the server\n// can never drift on what counts as a credential.\nvar credentialKeys = []string{","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/credentials_test.go","text":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// credentialKeys are the keys whose values must never appear in any response\n// body — the daemon's credential surface: subscription tokens, API keys, the\n// serve token, and the per-profile model keys. The test reads their values via\n// the same config.EnvValue path the daemon itself reads (the .env file in the\n// manigot checkout, then the process environment), so the test and the server\n// can never drift on what counts as a credential.\nvar credentialKeys = []string{\n\t\"CLAUDE_CODE_OAUTH_TOKEN\",\n\t\"CLAUDE_ACCOUNT_UUID\",\n\t\"CLAUDE_EMAIL\",\n\t\"CLAUDE_ORG_UUID\",\n\t\"ANTHROPIC_API_KEY\",\n\t\"OPENCODE_API_KEY\",\n\t\"ZHIPU_API_KEY\",\n\t\"MG_SERVE_TOKEN\",\n\t\"OPENCODE_ZAI_MODEL\",\n\t\"OPENCODE_GO_MODEL\",\n\t\"OPENCODE_ZEN_MODEL\",\n\t\"OPENCODE_ZEN_FREE_MODEL\",\n\t\"OPENCODE_MODEL\",\n\t\"OPENCODE_THEME\",\n}\n\n// TestCredentialsNeverReturned is the brief's \"no .env content, no keys, no\n// tokens in any response, ever\" guarantee enforced over the whole surface: a\n// known credential value is planted in the daemon's real credential source\n// (.env + process env), every endpoint is hit (with the correct bearer token),\n// and every response body — including a 401 — is grepped for the values.\nfunc TestCredentialsNeverReturned(t *testing.T) {\n\t// The credential source: a fake checkout's .env plus the process\n\t// environment, both read through config.EnvValue exactly as the daemon\n\t// reads them.\n\tenvLines := map[string]string{}\n\tfor _, key := range credentialKeys {\n\t\tenvLines[key] = \"fixture-\" + key + \"-VALUE\"\n\t\tt.Setenv(key, envLines[key])\n\t}\n\tcheckout := fakeCheckout(t, map[string]string{\n\t\t\"analyst\": \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n\t})\n\t// The .env file itself — the daemon's preferred source. Two extra\n\t// non-credential lines ride along to pin the \"no full line of .env\n\t// content\" half of the guarantee.\n\tvar envFile strings.Builder\n\tfor _, key := range credentialKeys {\n\t\tenvFile.WriteString(key + \"=\" + envLines[key] + \"\\n\")\n\t}\n\tenvFile.WriteString(\"# a comment line in the env\\n\")\n\tenvFile.WriteString(\"UNRELATED_SETTING=some-value\\n\")\n\tif err := os.WriteFile(filepath.Join(checkout, \".env\"), []byte(envFile.String()), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\t// A non-git project with a job (exercises projects/jobs/files/jdi/agents),\n\t// and a git repo with a job branch (exercises diff).\n\tjobProj := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"),\n\t\t\"tasks.md\", \"implementation.md\", \"verdict.md\")\n\tif err := writeJDIStatusForTest(t, jobProj, \"wood_oak\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tlogDir := job.JDIStatusDir(jobProj, \"wood_oak\")\n\tif err := os.MkdirAll(logDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(job.JDIRunLogPath(jobProj, \"wood_oak\"), []byte(\"run log content\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(jobProj, \"docs\", \"jobs\", \"wood_oak\", \"session.log\"), []byte(\"session log content\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\tgitProj := initGitRepo(t)\n\trunGitT(t, gitProj, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n\tif err := os.WriteFile(filepath.Join(gitProj, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGitT(t, gitProj, \"add\", \"feature.txt\")\n\trunGitT(t, gitProj, \"commit\", \"-q\", \"-m\", \"add the feature\")\n\trunGitT(t, gitProj, \"checkout\", \"-q\", \"main\")\n\n\treg := &Registry{entries: []Entry{entryFor(jobProj), entryFor(gitProj)}}\n\ttoken := envLines[\"MG_SERVE_TOKEN\"]\n\tvar audit strings.Builder\n\tsrv := New(reg, \"test-version\", token, &audit)\n\tauth := \"Bearer \" + token\n\n\t// Every endpoint, plus a 401 (no token) and a 404 (unknown job) — the\n\t// error envelopes are response surfaces too.\n\tpaths := []string{\n\t\t\"/health\",\n\t\t\"/projects\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/brief.md\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/tasks.md\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/implementation.md\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/verdict.md\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/jdi\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/agents\",\n\t\t\"/projects/\" + filepath.Base(gitProj) + \"/jobs/wood_test/diff\",\n\t\t\"/projects/\" + filepath.Base(gitProj) + \"/jobs/wood_test/diff?full=1\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/jdi?bogus=1\",\n\t\t\"/projects/no-such-project/jobs\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/no-such-job/files/brief.md\",\n\t}\n\tfor _, p := range paths {\n\t\trec := get(t, srv, p, auth)\n\t\tassertBodyHasNoCredentials(t, rec.Body.String(), envLines, envFile.String())\n\t}\n\n\t// The 401 body (missing and wrong token) — an unauthenticated response\n\t// must not leak the token either.\n\tfor _, badAuth := range []string{\"\", \"Bearer wrong\"} {\n\t\trec := get(t, srv, \"/projects\", badAuth)\n\t\tif rec.Code != http.StatusUnauthorized {\n\t\t\tt.Fatalf(\"bad auth %q: status = %d, want 401\", badAuth, rec.Code)\n\t\t}\n\t\tassertBodyHasNoCredentials(t, rec.Body.String(), envLines, envFile.String())\n\t}\n\n\t// The audit log likewise never carries the Authorization header or the\n\t// token (the auth= field is the outcome classification only).\n\tif strings.Contains(audit.String(), token) {\n\t\tt.Errorf(\"audit log contains the token:\\n%s\", audit.String())\n\t}\n\tfor _, line := range strings.Split(audit.String(), \"\\n\") {\n\t\tif strings.Contains(line, \"Authorization\") || strings.Contains(line, \"Bearer \") {\n\t\t\tt.Errorf(\"audit log echoes the Authorization header: %q\", line)\n\t\t}\n\t}\n}\n\n// assertBodyHasNoCredentials fails the test if body contains any planted\n// credential value or any full line of the .env file.\nfunc assertBodyHasNoCredentials(t *testing.T, body string, envLines map[string]string, envFileContent string) {\n\tt.Helper()\n\tfor _, key := range credentialKeys {\n\t\tif strings.Contains(body, envLines[key]) {\n\t\t\tt.Errorf(\"response leaks the value of %s:\\n%s\", key, body)\n\t\t}\n\t}\n\tfor _, line := range strings.Split(envFileContent, \"\\n\") {\n\t\tif line == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif strings.Contains(body, line) {\n\t\t\tt.Errorf(\"response contains a full .env line %q:\\n%s\", line, body)\n\t\t}\n\t}\n}\n\n// TestCredentialValuesDoNotAppearInErrorMessages: error envelopes carry only\n// validated identifiers — never anything that could echo a credential.\nfunc TestCredentialValuesDoNotAppearInErrorMessages(t *testing.T) {\n\tt.Setenv(\"MG_SERVE_TOKEN\", \"fixture-token-12345\")\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"fixture-token-12345\", nil)\n\n\t// The error envelope shape is exactly {\"error\": \"...\"} — nothing else.\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/nope/files/brief.md\", \"Bearer fixture-token-12345\")\n\tif rec.Code != http.StatusNotFound {\n\t\tt.Fatalf(\"status = %d, want 404\", rec.Code)\n\t}\n\tvar envelope map[string]string\n\tif err := json.Unmarshal(rec.Body.Bytes(), &envelope); err != nil {\n\t\tt.Fatalf(\"error body not a JSON envelope: %v (%s)\", err, rec.Body.String())\n\t}\n\tif len(envelope) != 1 || envelope[\"error\"] == \"\" {\n\t\tt.Errorf(\"error envelope = %v, want exactly one error key\", envelope)\n\t}\n\tif strings.Contains(rec.Body.String(), \"fixture-token-12345\") {\n\t\tt.Errorf(\"error body leaks the token: %s\", rec.Body.String())\n\t}\n}","lineStart":1,"lineEnd":187,"totalLines":187,"truncated":false}},"title":"src/internal/serve/credentials_test.go","time":{"start":1787950322830,"end":1787950322833}},"id":"prt_04a24d432001fEvdcjcV2326T8","sessionID":"ses_fb5dcd7a6ffeSGBPKFVeVpziRm","messageID":"msg_04a24ce34001YSuYqlqrZOqn0k"}}
