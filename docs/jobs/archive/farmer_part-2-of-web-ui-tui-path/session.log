reconnect\n40: // contract: remember the offset (the client tracks it as the bytes it has\n41: // consumed; `start` reports where a fresh stream began), reconnect with\n42: // from=<offset> after a drop, lose nothing. If the file shrinks below the\n43: // offset (truncated/rotated), the stream resets to byte 0 and says so with a\n44: // fresh `start` event.\n45: \n46: // streamPollInterval is how often the handler stats session.log for new bytes.\n47: // A var (not const) purely so tests can shorten it.\n48: var streamPollInterval = 500 * time.Millisecond\n49: \n50: // streamKeepalive is how long without an emitted event the handler waits\n51: // before writing an SSE comment (`: keepalive`), which carries no data but\n52: // keeps intermediaries (reverse proxies in particular) from declaring the\n53: // connection dead on idle. A var for the same reason.\n54: var streamKeepalive = 30 * time.Second\n55: \n56: // streamLineFlushBytes caps how many bytes may buffer while waiting for a\n57: // newline before the partial line is force-flushed as its own event — a\n58: // pathological no-newline writer (a binary blob tee'd into session.log)\n59: // otherwise grows the handler's line buffer without bound.\n60: const streamLineFlushBytes = 1 << 20 // 1 MiB\n61: \n62: // handleSessionLogStream streams a job's session.log growth as Server-Sent\n63: // Events. No lock: a read-only file tail, per the brief's Notes — streaming\n64: // logs doesn't touch git state and must not block behind an unrelated\n65: // done/delete.\n66: //\n67: // It returns when the client disconnects (r.Context) OR the daemon shuts down\n68: // (s.shutdownCtx — cancelled at the top of Server.Shutdown, because\n69: // http.Server.Shutdown alone only stops accepting new connections and waits\n70: // for in-flight handlers: it never interrupts a handler stuck in its own poll\n71: // loop, so without this select every open stream would force the drain to wait\n72: // out its full timeout).\n73: func (s *Server) handleSessionLogStream(w http.ResponseWriter, r *http.Request) {\n74: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n75: \tif !ok {\n76: \t\treturn\n77: \t}\n78: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n79: \tif !ok {\n80: \t\treturn\n81: \t}\n82: \tlogPath := filepath.Join(j.Dir, \"session.log\") // from the resolved job — never the URL segment\n83: \n84: \t// Parse ?from= before any SSE headers are written, so a bad value is a\n85: \t// clean 400 JSON envelope rather than an error mid-stream.\n86: \tfromSet := false\n87: \tvar from int64\n88: \tif raw := r.URL.Query().Get(\"from\"); raw != \"\" {\n89: \t\tv, err := strconv.ParseInt(raw, 10, 64)\n90: \t\tif err != nil || v < 0 {\n91: \t\t\twriteError(w, http.StatusBadRequest, \"from must be a non-negative byte offset\")\n92: \t\t\treturn\n93: \t\t}\n94: \t\tfrom, fromSet = v, true\n95: \t}\n96: \n97: \tflusher, canFlush := w.(http.Flusher)\n98: \tif !canFlush {\n99: \t\twriteError(w, http.StatusInternalServerError, \"streaming unsupported\")\n100: \t\treturn\n101: \t}\n102: \tw.Header().Set(\"Content-Type\", \"text/event-stream\")\n103: \tw.Header().Set(\"Cache-Control\", \"no-cache\")\n104: \t// Hint for reverse proxies (nginx): do not buffer this response.\n105: \tw.Header().Set(\"X-Accel-Buffering\", \"no\")\n106: \tw.WriteHeader(http.StatusOK)\n107: \n108: \t// Determine the starting offset. See the event-protocol comment above for\n109: \t// the three cases (explicit from / existing file / file not yet created).\n110: \tvar offset int64\n111: \tswitch {\n112: \tcase fromSet:\n113: \t\toffset = from\n114: \tdefault:\n115: \t\tif fi, err := os.Stat(logPath); err == nil {\n116: \t\t\toffset = fi.Size() // tail -f: only new growth\n117: \t\t} else {\n118: \t\t\toffset = 0 // no file yet: capture the whole run when it starts\n119: \t\t}\n120: \t}\n121: \n122: \twrite := func(event, data string) bool {\n123: \t\tif err := writeSSE(w, event, data); err != nil {\n124: \t\t\treturn false\n125: \t\t}\n126: \t\tflusher.Flush()\n127: \t\treturn true\n128: \t}\n129: \n130: \tif !write(\"start\", strconv.FormatInt(offset, 10)) {\n131: \t\treturn\n132: \t}\n133: \n134: \tvar pending []byte   // bytes of a not-yet-complete line (no \\n yet)\n135: \tlastEmit := time.Now()\n136: \n137: \temitLines := func(chunk []byte) bool {\n138: \t\tpending = append(pending, chunk...)\n139: \t\tfor {\n140: \t\t\tidx := bytes.IndexByte(pending, '\\n')\n141: \t\t\tforce := idx < 0 && len(pending) >= streamLineFlushBytes\n142: \t\t\tif idx < 0 && !force {\n143: \t\t\t\tbreak\n144: \t\t\t}\n145: \t\t\tvar line string\n146: \t\t\tif idx >= 0 {\n147: \t\t\t\tline, pending = string(pending[:idx]), pending[idx+1:]\n148: \t\t\t} else {\n149: \t\t\t\tline, pending = string(pending), nil\n150: \t\t\t}\n151: \t\t\tif !write(\"\", line) {\n152: \t\t\t\treturn false\n153: \t\t\t}\n154: \t\t\tlastEmit = time.Now()\n155: \t\t}\n156: \t\treturn true\n157: \t}\n158: \n159: \tticker := time.NewTicker(streamPollInterval)\n160: \tdefer ticker.Stop()\n161: \tfor {\n162: \t\tselect {\n163: \t\tcase <-r.Context().Done(): // client disconnected\n164: \t\t\tflushPartial(write, &pending)\n165: \t\t\treturn\n166: \t\tcase <-s.shutdownCtx.Done(): // daemon draining\n167: \t\t\tflushPartial(write, &pending)\n168: \t\t\treturn\n169: \t\tcase <-ticker.C:\n170: \t\t\tfi, err := os.Stat(logPath)\n171: \t\t\tswitch {\n172: \t\t\tcase os.IsNotExist(err):\n173: \t\t\t\t// Still waiting for the file to appear — nothing to read.\n174: \t\t\tcase err != nil:\n175: \t\t\t\t// Transient stat failure; retry on the next tick.\n176: \t\t\tcase fi.Size() < offset:\n177: \t\t\t\t// Truncated/rotated below the offset: restart from the top.\n178: \t\t\t\toffset = 0\n179: \t\t\t\tif !write(\"start\", \"0\") {\n180: \t\t\t\t\treturn\n181: \t\t\t\t}\n182: \t\t\t\tlastEmit = time.Now()\n183: \t\t\tcase fi.Size() > offset:\n184: \t\t\t\tchunk, err := readBytesFrom(logPath, offset)\n185: \t\t\t\tif err != nil {\n186: \t\t\t\t\t// Read raced with a writer/truncation; the next tick\n187: \t\t\t\t\t// re-stats and recovers.\n188: \t\t\t\t\tcontinue\n189: \t\t\t\t}\n190: \t\t\t\toffset += int64(len(chunk))\n191: \t\t\t\tif !emitLines(chunk) {\n192: \t\t\t\t\treturn\n193: \t\t\t\t}\n194: \t\t\t}\n195: \t\t\tif time.Since(lastEmit) >= streamKeepalive {\n196: \t\t\t\tif !write(\"\", \"\") { // `: keepalive` comment — see writeSSE\n197: \t\t\t\t\treturn\n198: \t\t\t\t}\n199: \t\t\t\tlastEmit = time.Now()\n200: \t\t\t}\n201: \t\t}\n202: \t}\n203: }\n204: \n205: // flushPartial emits whatever bytes remain in the line buffer as one final\n206: // event, so a trailing line without its newline is not lost when the stream\n207: // ends. Best-effort: the connection may already be gone on a disconnect.\n208: func flushPartial(write func(event, data string) bool, pending *[]byte) {\n209: \tif len(*pending) > 0 {\n210: \t\twrite(\"\", string(*pending))\n211: \t\t*pending = nil\n212: \t}\n213: }\n214: \n215: // writeSSE writes one SSE frame. event is the named-event type (\"\" = the\n216: // default \"message\" event); data is the payload — each of its lines is\n217: // prefixed `data:` per the SSE wire format, and an empty data writes a bare\n218: // `:` comment (the keepalive form, ignored by every SSE parser).\n219: func writeSSE(w http.ResponseWriter, event, data string) error {\n220: \tvar b strings.Builder\n221: \tif event != \"\" {\n222: \t\tb.WriteString(\"event: \" + event + \"\\n\")\n223: \t}\n224: \tif data == \"\" {\n225: \t\tb.WriteString(\": keepalive\\n\\n\")\n226: \t} else {\n227: \t\tfor _, line := range strings.Split(data, \"\\n\") {\n228: \t\t\tb.WriteString(\"data: \" + line + \"\\n\")\n229: \t\t}\n230: \t\tb.WriteString(\"\\n\")\n231: \t}\n232: \t_, err := fmt.Fprint(w, b.String())\n233: \treturn err\n234: }\n235: \n236: // readBytesFrom reads the file's bytes from offset to its current end — a\n237: // fresh open per poll, which sidesteps inode rotation entirely (a held file\n238: // handle would silently keep reading the replaced file forever).\n239: func readBytesFrom(path string, offset int64) ([]byte, error) {\n240: \tf, err := os.Open(path)\n241: \tif err != nil {\n242: \t\treturn nil, err\n243: \t}\n244: \tdefer f.Close()\n245: \tif _, err := f.Seek(offset, 0); err != nil {\n246: \t\treturn nil, err\n247: \t}\n248: \treturn readAll(f)\n249: }\n250: \n251: // startEventOffset decodes the `start` event's data payload. Test-side helper\n252: // (the handler writes it; tests — and job three, eventually — read it).\n253: func startEventOffset(t testingT, data string) int64 {\n254: \tvar v struct {\n255: \t\tOffset int64 `json:\"offset\"`\n256: \t}\n257: \tif err := json.Unmarshal([]byte(data), &v); err != nil {\n258: \t\tt.Fatalf(\"start event data %q is not an offset: %v\", data, err)\n259: \t}\n260: \treturn v.Offset\n261: }\n262: \n263: // testingT is the subset of testing.T the helpers above need.\n264: type testingT interface {\n265: \tFatalf(format string, args ...any)\n266: }\n\n(End of file - total 266 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n)\n\n// --- GET /projects/{project}/jobs/{job}/session-log/stream (TASK-12) ---------\n\n// The session-log stream is Server-Sent Events over the plain net/http server:\n// no upgrade handshake, no framing protocol, no new dependency — the \"less\n// code against the existing server\" choice the brief's Notes steer toward\n// (Go's stdlib has no WebSocket support natively; SSE is just a long-lived\n// chunked response with `data:` frames and http.Flusher).","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/stream.go","text":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n)\n\n// --- GET /projects/{project}/jobs/{job}/session-log/stream (TASK-12) ---------\n\n// The session-log stream is Server-Sent Events over the plain net/http server:\n// no upgrade handshake, no framing protocol, no new dependency — the \"less\n// code against the existing server\" choice the brief's Notes steer toward\n// (Go's stdlib has no WebSocket support natively; SSE is just a long-lived\n// chunked response with `data:` frames and http.Flusher).\n//\n// It is the network twin of the TUI's `l` key: the same\n// docs/jobs/<id>_<slug>/session.log the TUI tails locally, tailed over HTTP\n// instead. The file is a local append-only log, so the \"watch for growth\"\n// mechanism is a plain stat+read-new-bytes poll — no fsnotify/inotify.\n//\n// Event protocol (consumed by job three's web UI; also human-readable under\n// curl):\n//\n//\tevent: start\n//\tdata: {\"offset\":123}\n//\n//\t<one default (message) event per log line, in order>\n//\t<an idle `: keepalive` comment every streamKeepalive, invisible to EventSource>\n//\n// Offsets: with no ?from=, the stream starts at the file's current size when\n// it already exists (tail -f semantics — only new growth) and at byte 0 when\n// it doesn't yet (the launch-then-watch flow: everything from the top once the\n// run starts writing). ?from=<byte offset> overrides both — the reconnect\n// contract: remember the offset (the client tracks it as the bytes it has\n// consumed; `start` reports where a fresh stream began), reconnect with\n// from=<offset> after a drop, lose nothing. If the file shrinks below the\n// offset (truncated/rotated), the stream resets to byte 0 and says so with a\n// fresh `start` event.\n\n// streamPollInterval is how often the handler stats session.log for new bytes.\n// A var (not const) purely so tests can shorten it.\nvar streamPollInterval = 500 * time.Millisecond\n\n// streamKeepalive is how long without an emitted event the handler waits\n// before writing an SSE comment (`: keepalive`), which carries no data but\n// keeps intermediaries (reverse proxies in particular) from declaring the\n// connection dead on idle. A var for the same reason.\nvar streamKeepalive = 30 * time.Second\n\n// streamLineFlushBytes caps how many bytes may buffer while waiting for a\n// newline before the partial line is force-flushed as its own event — a\n// pathological no-newline writer (a binary blob tee'd into session.log)\n// otherwise grows the handler's line buffer without bound.\nconst streamLineFlushBytes = 1 << 20 // 1 MiB\n\n// handleSessionLogStream streams a job's session.log growth as Server-Sent\n// Events. No lock: a read-only file tail, per the brief's Notes — streaming\n// logs doesn't touch git state and must not block behind an unrelated\n// done/delete.\n//\n// It returns when the client disconnects (r.Context) OR the daemon shuts down\n// (s.shutdownCtx — cancelled at the top of Server.Shutdown, because\n// http.Server.Shutdown alone only stops accepting new connections and waits\n// for in-flight handlers: it never interrupts a handler stuck in its own poll\n// loop, so without this select every open stream would force the drain to wait\n// out its full timeout).\nfunc (s *Server) handleSessionLogStream(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\tlogPath := filepath.Join(j.Dir, \"session.log\") // from the resolved job — never the URL segment\n\n\t// Parse ?from= before any SSE headers are written, so a bad value is a\n\t// clean 400 JSON envelope rather than an error mid-stream.\n\tfromSet := false\n\tvar from int64\n\tif raw := r.URL.Query().Get(\"from\"); raw != \"\" {\n\t\tv, err := strconv.ParseInt(raw, 10, 64)\n\t\tif err != nil || v < 0 {\n\t\t\twriteError(w, http.StatusBadRequest, \"from must be a non-negative byte offset\")\n\t\t\treturn\n\t\t}\n\t\tfrom, fromSet = v, true\n\t}\n\n\tflusher, canFlush := w.(http.Flusher)\n\tif !canFlush {\n\t\twriteError(w, http.StatusInternalServerError, \"streaming unsupported\")\n\t\treturn\n\t}\n\tw.Header().Set(\"Content-Type\", \"text/event-stream\")\n\tw.Header().Set(\"Cache-Control\", \"no-cache\")\n\t// Hint for reverse proxies (nginx): do not buffer this response.\n\tw.Header().Set(\"X-Accel-Buffering\", \"no\")\n\tw.WriteHeader(http.StatusOK)\n\n\t// Determine the starting offset. See the event-protocol comment above for\n\t// the three cases (explicit from / existing file / file not yet created).\n\tvar offset int64\n\tswitch {\n\tcase fromSet:\n\t\toffset = from\n\tdefault:\n\t\tif fi, err := os.Stat(logPath); err == nil {\n\t\t\toffset = fi.Size() // tail -f: only new growth\n\t\t} else {\n\t\t\toffset = 0 // no file yet: capture the whole run when it starts\n\t\t}\n\t}\n\n\twrite := func(event, data string) bool {\n\t\tif err := writeSSE(w, event, data); err != nil {\n\t\t\treturn false\n\t\t}\n\t\tflusher.Flush()\n\t\treturn true\n\t}\n\n\tif !write(\"start\", strconv.FormatInt(offset, 10)) {\n\t\treturn\n\t}\n\n\tvar pending []byte   // bytes of a not-yet-complete line (no \\n yet)\n\tlastEmit := time.Now()\n\n\temitLines := func(chunk []byte) bool {\n\t\tpending = append(pending, chunk...)\n\t\tfor {\n\t\t\tidx := bytes.IndexByte(pending, '\\n')\n\t\t\tforce := idx < 0 && len(pending) >= streamLineFlushBytes\n\t\t\tif idx < 0 && !force {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tvar line string\n\t\t\tif idx >= 0 {\n\t\t\t\tline, pending = string(pending[:idx]), pending[idx+1:]\n\t\t\t} else {\n\t\t\t\tline, pending = string(pending), nil\n\t\t\t}\n\t\t\tif !write(\"\", line) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tlastEmit = time.Now()\n\t\t}\n\t\treturn true\n\t}\n\n\tticker := time.NewTicker(streamPollInterval)\n\tdefer ticker.Stop()\n\tfor {\n\t\tselect {\n\t\tcase <-r.Context().Done(): // client disconnected\n\t\t\tflushPartial(write, &pending)\n\t\t\treturn\n\t\tcase <-s.shutdownCtx.Done(): // daemon draining\n\t\t\tflushPartial(write, &pending)\n\t\t\treturn\n\t\tcase <-ticker.C:\n\t\t\tfi, err := os.Stat(logPath)\n\t\t\tswitch {\n\t\t\tcase os.IsNotExist(err):\n\t\t\t\t// Still waiting for the file to appear — nothing to read.\n\t\t\tcase err != nil:\n\t\t\t\t// Transient stat failure; retry on the next tick.\n\t\t\tcase fi.Size() < offset:\n\t\t\t\t// Truncated/rotated below the offset: restart from the top.\n\t\t\t\toffset = 0\n\t\t\t\tif !write(\"start\", \"0\") {\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t\tlastEmit = time.Now()\n\t\t\tcase fi.Size() > offset:\n\t\t\t\tchunk, err := readBytesFrom(logPath, offset)\n\t\t\t\tif err != nil {\n\t\t\t\t\t// Read raced with a writer/truncation; the next tick\n\t\t\t\t\t// re-stats and recovers.\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\toffset += int64(len(chunk))\n\t\t\t\tif !emitLines(chunk) {\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t}\n\t\t\tif time.Since(lastEmit) >= streamKeepalive {\n\t\t\t\tif !write(\"\", \"\") { // `: keepalive` comment — see writeSSE\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t\tlastEmit = time.Now()\n\t\t\t}\n\t\t}\n\t}\n}\n\n// flushPartial emits whatever bytes remain in the line buffer as one final\n// event, so a trailing line without its newline is not lost when the stream\n// ends. Best-effort: the connection may already be gone on a disconnect.\nfunc flushPartial(write func(event, data string) bool, pending *[]byte) {\n\tif len(*pending) > 0 {\n\t\twrite(\"\", string(*pending))\n\t\t*pending = nil\n\t}\n}\n\n// writeSSE writes one SSE frame. event is the named-event type (\"\" = the\n// default \"message\" event); data is the payload — each of its lines is\n// prefixed `data:` per the SSE wire format, and an empty data writes a bare\n// `:` comment (the keepalive form, ignored by every SSE parser).\nfunc writeSSE(w http.ResponseWriter, event, data string) error {\n\tvar b strings.Builder\n\tif event != \"\" {\n\t\tb.WriteString(\"event: \" + event + \"\\n\")\n\t}\n\tif data == \"\" {\n\t\tb.WriteString(\": keepalive\\n\\n\")\n\t} else {\n\t\tfor _, line := range strings.Split(data, \"\\n\") {\n\t\t\tb.WriteString(\"data: \" + line + \"\\n\")\n\t\t}\n\t\tb.WriteString(\"\\n\")\n\t}\n\t_, err := fmt.Fprint(w, b.String())\n\treturn err\n}\n\n// readBytesFrom reads the file's bytes from offset to its current end — a\n// fresh open per poll, which sidesteps inode rotation entirely (a held file\n// handle would silently keep reading the replaced file forever).\nfunc readBytesFrom(path string, offset int64) ([]byte, error) {\n\tf, err := os.Open(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdefer f.Close()\n\tif _, err := f.Seek(offset, 0); err != nil {\n\t\treturn nil, err\n\t}\n\treturn readAll(f)\n}\n\n// startEventOffset decodes the `start` event's data payload. Test-side helper\n// (the handler writes it; tests — and job three, eventually — read it).\nfunc startEventOffset(t testingT, data string) int64 {\n\tvar v struct {\n\t\tOffset int64 `json:\"offset\"`\n\t}\n\tif err := json.Unmarshal([]byte(data), &v); err != nil {\n\t\tt.Fatalf(\"start event data %q is not an offset: %v\", data, err)\n\t}\n\treturn v.Offset\n}\n\n// testingT is the subset of testing.T the helpers above need.\ntype testingT interface {\n\tFatalf(format string, args ...any)\n}","lineStart":1,"lineEnd":266,"totalLines":266,"truncated":false}},"title":"src/internal/serve/stream.go","time":{"start":1787950276235,"end":1787950276238}},"id":"prt_04a241e1b001INdnhzqIt6TSMl","sessionID":"ses_fb5dcd7a6ffeSGBPKFVeVpziRm","messageID":"msg_04a2418a7001ETDN0hrpikew78"}}
