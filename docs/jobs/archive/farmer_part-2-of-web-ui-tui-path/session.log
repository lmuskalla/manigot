balAgentCleanup = func() { os.RemoveAll(tmp) }\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tglobalAgentMount = []string{\"-v\", globalAgentsDir + \":/home/claude/.claude/agents:ro\"}\n\t\t\t}\n\t\t}\n\t}\n\n\t// ── Global skills ─────────────────────────────────────────────────────\n\t// Skills follow the same global + project model as agents, applied to a\n\t// different unit: a skill is a directory (SKILL.md plus support files),\n\t// not a single file. Global skills live in the manigot checkout\n\t// (<home>/skills/) and are mounted read-only into the container at the\n","exit":0,"truncated":false},"title":"grep -rn \"func.*Run(\" internal/session/docker.go | head; echo \"---\"; sed -n '142,260p' internal/session/docker.go","time":{"start":1787950456311,"end":1787950456312}},"id":"prt_04a26dca60011bTKhTUgwJ0ck0","sessionID":"ses_fb5dcd7a6ffeSGBPKFVeVpziRm","messageID":"msg_04a26d5ef0014L20Kehxh2P7vH"}}
