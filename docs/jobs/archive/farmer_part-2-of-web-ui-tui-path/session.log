{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017BDoTZq5z8iznNyzUt4ZKD","type":"tool_result","content":"1\tpackage serve\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"io\"\n6\t\t\"net/http\"\n7\t\t\"net/http/httptest\"\n8\t\t\"strings\"\n9\t\t\"testing\"\n10\t)\n11\t\n12\t// testServer builds a Server over a registry holding one temp project root,\n13\t// returning the server and the registered root. audit is the audit writer\n14\t// (nil for tests that don't assert audit lines).\n15\tfunc testServer(t *testing.T, token string, audit io.Writer) (*Server, string) {\n16\t\tt.Helper()\n17\t\troot := t.TempDir()\n18\t\treg := &Registry{entries: []Entry{entryFor(root)}}\n19\t\treturn New(reg, \"test-version\", token, audit), root\n20\t}\n21\t\n22\t// get performs a GET against the handler with the given Authorization header.\n23\tfunc get(t *testing.T, srv *Server, path, auth string) *httptest.ResponseRecorder {\n24\t\tt.Helper()\n25\t\treq := httptest.NewRequest(http.MethodGet, path, nil)\n26\t\tif auth != \"\" {\n27\t\t\treq.Header.Set(\"Authorization\", auth)\n28\t\t}\n29\t\trec := httptest.NewRecorder()\n30\t\tsrv.Handler().ServeHTTP(rec, req)\n31\t\treturn rec\n32\t}\n33\t\n34\t// TestTokenRequiredPins the auth contract: with a token configured, the\n35\t// correct bearer header passes, and a missing or wrong token is a 401 before\n36\t// any handler logic runs.\n37\tfunc TestTokenRequiredPins(t *testing.T) {\n38\t\tsrv, _ := testServer(t, \"sekrit-token\", nil)\n39\t\n40\t\tif rec := get(t, srv, \"/projects\", \"Bearer sekrit-token\"); rec.Code != http.StatusOK {\n41\t\t\tt.Errorf(\"correct token: status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n42\t\t}\n43\t\tif rec := get(t, srv, \"/projects\", \"\"); rec.Code != http.StatusUnauthorized {\n44\t\t\tt.Errorf(\"missing token: status = %d, want 401\", rec.Code)\n45\t\t}\n46\t\tif rec := get(t, srv, \"/projects\", \"Bearer wrong-token\"); rec.Code != http.StatusUnauthorized {\n47\t\t\tt.Errorf(\"wrong token: status = %d, want 401\", rec.Code)\n48\t\t}\n49\t\tif rec := get(t, srv, \"/projects\", \"Basic sekrit-token\"); rec.Code != http.StatusUnauthorized {\n50\t\t\tt.Errorf(\"non-bearer scheme: status = %d, want 401\", rec.Code)\n51\t\t}\n52\t\tif rec := get(t, srv, \"/projects\", \"Bearer sekrit-token-extra\"); rec.Code != http.StatusUnauthorized {\n53\t\t\tt.Errorf(\"token with wrong length: status = %d, want 401\", rec.Code)\n54\t\t}\n55\t}\n56\t\n57\t// TestTokenlessLocalhostPins the default: no token configured means every\n58\t// request passes (the machine's own user is the trust boundary, as it is for\n59\t// the CLI today).\n60\tfunc TestTokenlessLocalhostPins(t *testing.T) {\n61\t\tsrv, _ := testServer(t, \"\", nil)\n62\t\tif rec := get(t, srv, \"/projects\", \"\"); rec.Code != http.StatusOK {\n63\t\t\tt.Errorf(\"tokenless: status = %d, want 200\", rec.Code)\n64\t\t}\n65\t\t// An Authorization header on a tokenless daemon is ignored, not rejected.\n66\t\tif rec := get(t, srv, \"/projects\", \"Bearer anything\"); rec.Code != http.StatusOK {\n67\t\t\tt.Errorf(\"tokenless with stray header: status = %d, want 200\", rec.Code)\n68\t\t}\n69\t}\n70\t\n71\t// TestUnauthorizedIsJSONError: the 401 body is the JSON error envelope, never\n72\t// a hint about the expected token.\n73\tfunc TestUnauthorizedIsJSONError(t *testing.T) {\n74\t\tsrv, _ := testServer(t, \"sekrit-token\", nil)\n75\t\trec := get(t, srv, \"/projects\", \"\")\n76\t\tvar body map[string]string\n77\t\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n78\t\t\tt.Fatalf(\"401 body not JSON: %v (%s)\", err, rec.Body.String())\n79\t\t}\n80\t\tif body[\"error\"] == \"\" {\n81\t\t\tt.Errorf(\"401 body = %v, want an error envelope\", body)\n82\t\t}\n83\t\tif strings.Contains(rec.Body.String(), \"sekrit-token\") {\n84\t\t\tt.Errorf(\"401 body echoes the token: %s\", rec.Body.String())\n85\t\t}\n86\t}\n87\t\n88\t// TestTokenMatchesConstantTimeCompare: the comparison goes through\n89\t// crypto/subtle.ConstantTimeCompare (the value path) once the length\n90\t// matches — asserted structurally by pinning the accept/reject behavior at\n91\t// the tokenMatches level, the function the middleware uses.\n92\tfunc TestTokenMatchesConstantTimeCompare(t *testing.T) {\n93\t\treq := httptest.NewRequest(http.MethodGet, \"/\", nil)\n94\t\treq.Header.Set(\"Authorization\", \"Bearer correct-horse\")\n95\t\tif !tokenMatches(req, \"correct-horse\") {\n96\t\t\tt.Error(\"tokenMatches with the right token = false, want true\")\n97\t\t}\n98\t\treq.Header.Set(\"Authorization\", \"Bearer correct-horsf\") // same length, wrong value\n99\t\tif tokenMatches(req, \"correct-horse\") {\n100\t\t\tt.Error(\"tokenMatches with a same-length wrong token = true, want false\")\n101\t\t}\n102\t\treq.Header.Set(\"Authorization\", \"Bearer short\")\n103\t\tif tokenMatches(req, \"correct-horse\") {\n104\t\t\tt.Error(\"tokenMatches with a different-length token = true, want false\")\n105\t\t}\n106\t\treq.Header.Set(\"Authorization\", \"Basic correct-horse\")\n107\t\tif tokenMatches(req, \"correct-horse\") {\n108\t\t\tt.Error(\"tokenMatches with a non-Bearer scheme = true, want false\")\n109\t\t}\n110\t}\n111\t\n112\t// TestIsLoopback pins the binding classification: 127.0.0.0/8, ::1 and\n113\t// localhost are loopback; everything else — including the empty host (binds\n114\t// all interfaces) — is not.\n115\tfunc TestIsLoopback(t *testing.T) {\n116\t\tfor _, host := range []string{\"127.0.0.1\", \"127.0.0.0\", \"127.99.99.99\", \"::1\", \"localhost\"} {\n117\t\t\tif !IsLoopback(host) {\n118\t\t\t\tt.Errorf(\"IsLoopback(%q) = false, want true\", host)\n119\t\t\t}\n120\t\t}\n121\t\tfor _, host := range []string{\"\", \"0.0.0.0\", \"::\", \"192.168.1.10\", \"10.0.0.5\", \"example.com\", \"2001:db8::1\"} {\n122\t\t\tif IsLoopback(host) {\n123\t\t\t\tt.Errorf(\"IsLoopback(%q) = true, want false\", host)\n124\t\t\t}\n125\t\t}\n126\t}\n127\t\n128\t// TestValidateStartupPins the hard invariant: a non-loopback bind without a\n129\t// token refuses to start; a token (or a loopback bind) permits it. There is\n130\t// no flag that turns the refusal off — only a token or a loopback bind.\n131\tfunc TestValidateStartupPins(t *testing.T) {\n132\t\tif err := ValidateStartup(\"0.0.0.0\", \"\"); err == nil {\n133\t\t\tt.Error(\"ValidateStartup(0.0.0.0, no token) = nil, want refusal\")\n134\t\t}\n135\t\tif err := ValidateStartup(\"192.168.1.10\", \"\"); err == nil {\n136\t\t\tt.Error(\"ValidateStartup(non-loopback, no token) = nil, want refusal\")\n137\t\t}\n138\t\tif err := ValidateStartup(\"2001:db8::1\", \"\"); err == nil {\n139\t\t\tt.Error(\"ValidateStartup(non-loopback IPv6, no token) = nil, want refusal\")\n140\t\t}\n141\t\tif err := ValidateStartup(\"0.0.0.0\", \"some-token\"); err != nil {\n142\t\t\tt.Errorf(\"ValidateStartup(0.0.0.0, token) = %v, want nil\", err)\n143\t\t}\n144\t\tif err := ValidateStartup(\"127.0.0.1\", \"\"); err != nil {\n145\t\t\tt.Errorf(\"ValidateStartup(127.0.0.1, no token) = %v, want nil\", err)\n146\t\t}\n147\t\tif err := ValidateStartup(\"::1\", \"\"); err != nil {\n148\t\t\tt.Errorf(\"ValidateStartup(::1, no token) = %v, want nil\", err)\n149\t\t}\n150\t\tif err := ValidateStartup(\"localhost\", \"\"); err != nil {\n151\t\t\tt.Errorf(\"ValidateStartup(localhost, no token) = %v, want nil\", err)\n152\t\t}\n153\t}\n154\t"}]},"parent_tool_use_id":null,"session_id":"ba948ea7-a157-4c42-8eb1-077540d9946d","uuid":"e59758d5-0ac1-4776-bb00-c9004a65cde7","timestamp":"2026-08-28T20:28:12.985Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/serve/auth_test.go","content":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// testServer builds a Server over a registry holding one temp project root,\n// returning the server and the registered root. audit is the audit writer\n// (nil for tests that don't assert audit lines).\nfunc testServer(t *testing.T, token string, audit io.Writer) (*Server, string) {\n\tt.Helper()\n\troot := t.TempDir()\n\treg := &Registry{entries: []Entry{entryFor(root)}}\n\treturn New(reg, \"test-version\", token, audit), root\n}\n\n// get performs a GET against the handler with the given Authorization header.\nfunc get(t *testing.T, srv *Server, path, auth string) *httptest.ResponseRecorder {\n\tt.Helper()\n\treq := httptest.NewRequest(http.MethodGet, path, nil)\n\tif auth != \"\" {\n\t\treq.Header.Set(\"Authorization\", auth)\n\t}\n\trec := httptest.NewRecorder()\n\tsrv.Handler().ServeHTTP(rec, req)\n\treturn rec\n}\n\n// TestTokenRequiredPins the auth contract: with a token configured, the\n// correct bearer header passes, and a missing or wrong token is a 401 before\n// any handler logic runs.\nfunc TestTokenRequiredPins(t *testing.T) {\n\tsrv, _ := testServer(t, \"sekrit-token\", nil)\n\n\tif rec := get(t, srv, \"/projects\", \"Bearer sekrit-token\"); rec.Code != http.StatusOK {\n\t\tt.Errorf(\"correct token: status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif rec := get(t, srv, \"/projects\", \"\"); rec.Code != http.StatusUnauthorized {\n\t\tt.Errorf(\"missing token: status = %d, want 401\", rec.Code)\n\t}\n\tif rec := get(t, srv, \"/projects\", \"Bearer wrong-token\"); rec.Code != http.StatusUnauthorized {\n\t\tt.Errorf(\"wrong token: status = %d, want 401\", rec.Code)\n\t}\n\tif rec := get(t, srv, \"/projects\", \"Basic sekrit-token\"); rec.Code != http.StatusUnauthorized {\n\t\tt.Errorf(\"non-bearer scheme: status = %d, want 401\", rec.Code)\n\t}\n\tif rec := get(t, srv, \"/projects\", \"Bearer sekrit-token-extra\"); rec.Code != http.StatusUnauthorized {\n\t\tt.Errorf(\"token with wrong length: status = %d, want 401\", rec.Code)\n\t}\n}\n\n// TestTokenlessLocalhostPins the default: no token configured means every\n// request passes (the machine's own user is the trust boundary, as it is for\n// the CLI today).\nfunc TestTokenlessLocalhostPins(t *testing.T) {\n\tsrv, _ := testServer(t, \"\", nil)\n\tif rec := get(t, srv, \"/projects\", \"\"); rec.Code != http.StatusOK {\n\t\tt.Errorf(\"tokenless: status = %d, want 200\", rec.Code)\n\t}\n\t// An Authorization header on a tokenless daemon is ignored, not rejected.\n\tif rec := get(t, srv, \"/projects\", \"Bearer anything\"); rec.Code != http.StatusOK {\n\t\tt.Errorf(\"tokenless with stray header: status = %d, want 200\", rec.Code)\n\t}\n}\n\n// TestUnauthorizedIsJSONError: the 401 body is the JSON error envelope, never\n// a hint about the expected token.\nfunc TestUnauthorizedIsJSONError(t *testing.T) {\n\tsrv, _ := testServer(t, \"sekrit-token\", nil)\n\trec := get(t, srv, \"/projects\", \"\")\n\tvar body map[string]string\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"401 body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif body[\"error\"] == \"\" {\n\t\tt.Errorf(\"401 body = %v, want an error envelope\", body)\n\t}\n\tif strings.Contains(rec.Body.String(), \"sekrit-token\") {\n\t\tt.Errorf(\"401 body echoes the token: %s\", rec.Body.String())\n\t}\n}\n\n// TestTokenMatchesConstantTimeCompare: the comparison goes through\n// crypto/subtle.ConstantTimeCompare (the value path) once the length\n// matches — asserted structurally by pinning the accept/reject behavior at\n// the tokenMatches level, the function the middleware uses.\nfunc TestTokenMatchesConstantTimeCompare(t *testing.T) {\n\treq := httptest.NewRequest(http.MethodGet, \"/\", nil)\n\treq.Header.Set(\"Authorization\", \"Bearer correct-horse\")\n\tif !tokenMatches(req, \"correct-horse\") {\n\t\tt.Error(\"tokenMatches with the right token = false, want true\")\n\t}\n\treq.Header.Set(\"Authorization\", \"Bearer correct-horsf\") // same length, wrong value\n\tif tokenMatches(req, \"correct-horse\") {\n\t\tt.Error(\"tokenMatches with a same-length wrong token = true, want false\")\n\t}\n\treq.Header.Set(\"Authorization\", \"Bearer short\")\n\tif tokenMatches(req, \"correct-horse\") {\n\t\tt.Error(\"tokenMatches with a different-length token = true, want false\")\n\t}\n\treq.Header.Set(\"Authorization\", \"Basic correct-horse\")\n\tif tokenMatches(req, \"correct-horse\") {\n\t\tt.Error(\"tokenMatches with a non-Bearer scheme = true, want false\")\n\t}\n}\n\n// TestIsLoopback pins the binding classification: 127.0.0.0/8, ::1 and\n// localhost are loopback; everything else — including the empty host (binds\n// all interfaces) — is not.\nfunc TestIsLoopback(t *testing.T) {\n\tfor _, host := range []string{\"127.0.0.1\", \"127.0.0.0\", \"127.99.99.99\", \"::1\", \"localhost\"} {\n\t\tif !IsLoopback(host) {\n\t\t\tt.Errorf(\"IsLoopback(%q) = false, want true\", host)\n\t\t}\n\t}\n\tfor _, host := range []string{\"\", \"0.0.0.0\", \"::\", \"192.168.1.10\", \"10.0.0.5\", \"example.com\", \"2001:db8::1\"} {\n\t\tif IsLoopback(host) {\n\t\t\tt.Errorf(\"IsLoopback(%q) = true, want false\", host)\n\t\t}\n\t}\n}\n\n// TestValidateStartupPins the hard invariant: a non-loopback bind without a\n// token refuses to start; a token (or a loopback bind) permits it. There is\n// no flag that turns the refusal off — only a token or a loopback bind.\nfunc TestValidateStartupPins(t *testing.T) {\n\tif err := ValidateStartup(\"0.0.0.0\", \"\"); err == nil {\n\t\tt.Error(\"ValidateStartup(0.0.0.0, no token) = nil, want refusal\")\n\t}\n\tif err := ValidateStartup(\"192.168.1.10\", \"\"); err == nil {\n\t\tt.Error(\"ValidateStartup(non-loopback, no token) = nil, want refusal\")\n\t}\n\tif err := ValidateStartup(\"2001:db8::1\", \"\"); err == nil {\n\t\tt.Error(\"ValidateStartup(non-loopback IPv6, no token) = nil, want refusal\")\n\t}\n\tif err := ValidateStartup(\"0.0.0.0\", \"some-token\"); err != nil {\n\t\tt.Errorf(\"ValidateStartup(0.0.0.0, token) = %v, want nil\", err)\n\t}\n\tif err := ValidateStartup(\"127.0.0.1\", \"\"); err != nil {\n\t\tt.Errorf(\"ValidateStartup(127.0.0.1, no token) = %v, want nil\", err)\n\t}\n\tif err := ValidateStartup(\"::1\", \"\"); err != nil {\n\t\tt.Errorf(\"ValidateStartup(::1, no token) = %v, want nil\", err)\n\t}\n\tif err := ValidateStartup(\"localhost\", \"\"); err != nil {\n\t\tt.Errorf(\"ValidateStartup(localhost, no token) = %v, want nil\", err)\n\t}\n}\n","numLines":154,"startLine":1,"totalLines":154}}}
