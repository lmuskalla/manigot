{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018yvi2z9b1YDMhRsj89ZAjf","type":"tool_result","content":"1\tpackage serve\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"net/http\"\n9\t\t\"os\"\n10\t\t\"path/filepath\"\n11\t\t\"strings\"\n12\t\t\"time\"\n13\t\n14\t\t\"github.com/lmuskalla/manigot/internal/agentlist\"\n15\t\t\"github.com/lmuskalla/manigot/internal/config\"\n16\t\t\"github.com/lmuskalla/manigot/internal/git\"\n17\t\t\"github.com/lmuskalla/manigot/internal/job\"\n18\t\t\"github.com/lmuskalla/manigot/internal/project\"\n19\t\t\"github.com/lmuskalla/manigot/internal/session\"\n20\t)\n21\t\n22\t// --- JSON helpers ------------------------------------------------------------\n23\t\n24\t// writeJSON writes v as a JSON response with the given status.\n25\tfunc writeJSON(w http.ResponseWriter, status int, v any) {\n26\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n27\t\tw.WriteHeader(status)\n28\t\t_ = json.NewEncoder(w).Encode(v)\n29\t}\n30\t\n31\t// apiError is the JSON error envelope every non-2xx response carries.\n32\ttype apiError struct {\n33\t\tError string `json:\"error\"`\n34\t}\n35\t\n36\t// writeError writes a JSON error envelope with the given status.\n37\tfunc writeError(w http.ResponseWriter, status int, msg string) {\n38\t\twriteJSON(w, status, apiError{Error: msg})\n39\t}\n40\t\n41\t// --- Resolution helpers — the zero-path-inputs choke point -------------------\n42\t//\n43\t// Every handler resolves its URL segments ONLY through these helpers. A\n44\t// segment is validated as a plain identifier (validSegment), then matched —\n45\t// never joined into a filesystem path. The registered roots (TASK-1), the\n46\t// discovered jobs, and the file whitelist are the only sources of paths the\n47\t// handlers ever open.\n48\t\n49\t// validSegment reports whether a URL segment is a plain, trustworthy\n50\t// identifier: non-empty, not \".\" or \"..\" (traversal), containing no path\n51\t// separator (forward or backslash — the backslash is a Windows separator and\n52\t// must never reach a filesystem path), and no NUL byte. Percent-encoded and\n53\t// double-encoded variants all decode to one of these forms before matching,\n54\t// so rejecting the decoded form rejects them all.\n55\tfunc validSegment(seg string) bool {\n56\t\tif seg == \"\" || seg == \".\" || seg == \"..\" {\n57\t\t\treturn false\n58\t\t}\n59\t\tif strings.ContainsAny(seg, \"/\\\\\") {\n60\t\t\treturn false\n61\t\t}\n62\t\treturn !strings.ContainsRune(seg, 0)\n63\t}\n64\t\n65\t// resolveProject maps a URL project segment to a registered root. The segment\n66\t// is validated, then matched against the registry by configured entry name\n67\t// only (Registry.Project) — it is never joined into a filesystem path. An\n68\t// invalid segment or no match is a 404; the handler returns false and must\n69\t// return immediately.\n70\tfunc (s *Server) resolveProject(w http.ResponseWriter, segment string) (string, bool) {\n71\t\tif !validSegment(segment) {\n72\t\t\twriteError(w, http.StatusNotFound, \"project not found\")\n73\t\t\treturn \"\", false\n74\t\t}\n75\t\troot, ok := s.reg.Project(segment)\n76\t\tif !ok {\n77\t\t\twriteError(w, http.StatusNotFound, \"project not found\")\n78\t\t\treturn \"\", false\n79\t\t}\n80\t\treturn root, true\n81\t}\n82\t\n83\t// resolveJob maps a URL job segment to a discovered job under root. The\n84\t// segment is validated, then matched against the project's discovered jobs by\n85\t// ID, then by id_slug name (the job directory name — the same identity the\n86\t// CLI's branch-tail matching uses), then by unique name prefix. It is never\n87\t// treated as a path. Not-found is a 404; an ambiguous prefix is a 409; the\n88\t// handler returns false and must return immediately.\n89\tfunc (s *Server) resolveJob(w http.ResponseWriter, root, segment string) (job.Job, bool) {\n90\t\tif !validSegment(segment) {\n91\t\t\twriteError(w, http.StatusNotFound, \"job not found\")\n92\t\t\treturn job.Job{}, false\n93\t\t}\n94\t\tjobs, err := job.Discover(root)\n95\t\tif err != nil {\n96\t\t\twriteError(w, http.StatusInternalServerError, \"cannot read jobs\")\n97\t\t\treturn job.Job{}, false\n98\t\t}\n99\t\n100\t\t// Exact by ID, then by name.\n101\t\tfor _, j := range jobs {\n102\t\t\tif j.ID == segment || j.Name == segment {\n103\t\t\t\treturn j, true\n104\t\t\t}\n105\t\t}\n106\t\n107\t\t// Unique prefix on the name.\n108\t\tvar matches []job.Job\n109\t\tfor _, j := range jobs {\n110\t\t\tif strings.HasPrefix(j.Name, segment) {\n111\t\t\t\tmatches = append(matches, j)\n112\t\t\t}\n113\t\t}\n114\t\tswitch len(matches) {\n115\t\tcase 0:\n116\t\t\twriteError(w, http.StatusNotFound, fmt.Sprintf(\"job '%s' not found among the project's jobs\", segment))\n117\t\t\treturn job.Job{}, false\n118\t\tcase 1:\n119\t\t\treturn matches[0], true\n120\t\tdefault:\n121\t\t\tnames := make([]string, 0, len(matches))\n122\t\t\tfor _, j := range matches {\n123\t\t\t\tnames = append(names, j.Name)\n124\t\t\t}\n125\t\t\twriteError(w, http.StatusConflict, fmt.Sprintf(\"job '%s' is ambiguous — matches jobs: %s\", segment, strings.Join(names, \" \")))\n126\t\t\treturn job.Job{}, false\n127\t\t}\n128\t}\n129\t\n130\t// jobFileNames is the whitelist of job files the API serves: a job's four\n131\t// markdown files, read as raw markdown text. Nothing else under the job dir\n132\t// is ever served.\n133\tvar jobFileNames = map[string]bool{\n134\t\t\"brief.md\":          true,\n135\t\t\"tasks.md\":          true,\n136\t\t\"implementation.md\": true,\n137\t\t\"verdict.md\":        true,\n138\t}\n139\t\n140\t// --- /health -----------------------------------------------------------------\n141\t\n142\t// healthProfileRow is one profile's credential readiness in the /health\n143\t// response: ready = the profile's ResolveProfile + CheckAuth succeed (the\n144\t// same check the session launcher runs). A missing key is \"not ready\", never\n145\t// an error; the credential values themselves are never reported.\n146\ttype healthProfileRow struct {\n147\t\tID    string `json:\"id\"`\n148\t\tReady bool   `json:\"ready\"`\n149\t}\n150\t\n151\t// healthResponse is the /health response shape: the mg version, whether the\n152\t// docker image is present (session.ImagePresent), and per-profile readiness.\n153\ttype healthResponse struct {\n154\t\tVersion      string             `json:\"version\"`\n155\t\tImagePresent bool               `json:\"imagePresent\"`\n156\t\tProfiles     []healthProfileRow `json:\"profiles\"`\n157\t}\n158\t\n159\t// profileReady reduces a profile's credential check to a boolean.\n160\tfunc profileReady(id string) bool {\n161\t\tinfo, err := session.ResolveProfile(session.Options{Profile: id})\n162\t\tif err != nil {\n163\t\t\treturn false\n164\t\t}\n165\t\treturn info.CheckAuth() == nil\n166\t}\n167\t\n168\t// handleHealth serves the daemon's health/status: version, docker image\n169\t// presence, and profile readiness — pure booleans and identifiers, never\n170\t// credential material.\n171\tfunc (s *Server) handleHealth(w http.ResponseWriter, r *http.Request) {\n172\t\tresp := healthResponse{\n173\t\t\tVersion:      s.version,\n174\t\t\tImagePresent: session.ImagePresent(),\n175\t\t}\n176\t\tfor _, p := range config.Profiles() {\n177\t\t\tresp.Profiles = append(resp.Profiles, healthProfileRow{ID: p.ID, Ready: profileReady(p.ID)})\n178\t\t}\n179\t\twriteJSON(w, http.StatusOK, resp)\n180\t}\n181\t\n182\t// --- /projects ---------------------------------------------------------------\n183\t\n184\t// projectRow is one entry in the /projects response: a registered root and\n185\t// its configured name (the URL segment that resolves to it).\n186\ttype projectRow struct {\n187\t\tPath string `json:\"path\"`\n188\t\tName string `json:\"name\"`\n189\t}\n190\t\n191\t// projectsResponse is the /projects response shape.\n192\ttype projectsResponse struct {\n193\t\tProjects []projectRow `json:\"projects\"`\n194\t}\n195\t\n196\t// handleProjects lists the registered project roots — pure registry data, the\n197\t// daemon never scans for projects it does not know.\n198\tfunc (s *Server) handleProjects(w http.ResponseWriter, r *http.Request) {\n199\t\tentries := s.reg.Entries()\n200\t\trows := make([]projectRow, 0, len(entries))\n201\t\tfor _, e := range entries {\n202\t\t\trows = append(rows, projectRow{Path: e.Path, Name: e.Name})\n203\t\t}\n204\t\twriteJSON(w, http.StatusOK, projectsResponse{Projects: rows})\n205\t}\n206\t\n207\t// --- /projects/{project}/jobs ------------------------------------------------\n208\t\n209\t// jdiStatusRow is the mg-jdi activity state for a job: state / agent / last\n210\t// update, from the job's status sidecar. Omitted when there is no live run\n211\t// state (a job mg-jdi never drove, or a stale/unreadable sidecar).\n212\ttype jdiStatusRow struct {\n213\t\tState   string `json:\"state\"`\n214\t\tAgent   string `json:\"agent\"`\n215\t\tUpdated string `json:\"updated\"` // RFC3339\n216\t}\n217\t\n218\t// jobRow is one row in the jobs response — the TUI's info design: id / status\n219\t// / stage / type / date / title, one row per job, in job.Discover's sort\n220\t// order (newest first).\n221\ttype jobRow struct {\n222\t\tID     string        `json:\"id\"`\n223\t\tName   string        `json:\"name\"`\n224\t\tStatus string        `json:\"status\"`\n225\t\tStage  string        `json:\"stage\"`\n226\t\tType   string        `json:\"type\"`\n227\t\tDate   string        `json:\"date\"`\n228\t\tTitle  string        `json:\"title\"`\n229\t\tBranch string        `json:\"branch,omitempty\"`\n230\t\tJDI    *jdiStatusRow `json:\"jdi,omitempty\"`\n231\t}\n232\t\n233\t// jobsResponse is the /projects/{project}/jobs response shape.\n234\ttype jobsResponse struct {\n235\t\tJobs []jobRow `json:\"jobs\"`\n236\t}\n237\t\n238\t// handleProjectJobs lists a project's open jobs with the mg-jdi activity\n239\t// state per job.\n240\tfunc (s *Server) handleProjectJobs(w http.ResponseWriter, r *http.Request) {\n241\t\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n242\t\tif !ok {\n243\t\t\treturn\n244\t\t}\n245\t\tjobs, err := job.Discover(root)\n246\t\tif err != nil {\n247\t\t\twriteError(w, http.StatusInternalServerError, \"cannot read jobs\")\n248\t\t\treturn\n249\t\t}\n250\t\trows := make([]jobRow, 0, len(jobs))\n251\t\tfor _, j := range jobs {\n252\t\t\trow := jobRow{\n253\t\t\t\tID:     j.ID,\n254\t\t\t\tName:   j.Name,\n255\t\t\t\tStatus: j.Status,\n256\t\t\t\tStage:  string(j.Stage()),\n257\t\t\t\tType:   j.Type,\n258\t\t\t\tDate:   j.Date,\n259\t\t\t\tTitle:  j.Title,\n260\t\t\t\tBranch: j.Branch,\n261\t\t\t}\n262\t\t\tif st, ok := job.ReadJDIStatus(root, j.Name); ok {\n263\t\t\t\trow.JDI = &jdiStatusRow{\n264\t\t\t\t\tState:   string(st.State),\n265\t\t\t\t\tAgent:   st.Agent,\n266\t\t\t\t\tUpdated: st.Updated.Format(time.RFC3339),\n267\t\t\t\t}\n268\t\t\t}\n269\t\t\trows = append(rows, row)\n270\t\t}\n271\t\twriteJSON(w, http.StatusOK, jobsResponse{Jobs: rows})\n272\t}\n273\t\n274\t// --- /projects/{project}/jobs/{job}/files/{file} -----------------------------\n275\t\n276\t// handleJobFile serves one of a job's four markdown files as raw markdown\n277\t// text. The file segment is whitelisted (jobFileNames); a missing file is a\n278\t// normal 404 (e.g. verdict.md before review).\n279\tfunc (s *Server) handleJobFile(w http.ResponseWriter, r *http.Request) {\n280\t\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n281\t\tif !ok {\n282\t\t\treturn\n283\t\t}\n284\t\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n285\t\tif !ok {\n286\t\t\treturn\n287\t\t}\n288\t\tfile := r.PathValue(\"file\")\n289\t\tif !jobFileNames[file] {\n290\t\t\twriteError(w, http.StatusNotFound, \"file not found\")\n291\t\t\treturn\n292\t\t}\n293\t\tdata, err := os.ReadFile(filepath.Join(j.Dir, file))\n294\t\tif err != nil {\n295\t\t\twriteError(w, http.StatusNotFound, \"file not found\")\n296\t\t\treturn\n297\t\t}\n298\t\tw.Header().Set(\"Content-Type\", \"text/markdown; charset=utf-8\")\n299\t\tw.WriteHeader(http.StatusOK)\n300\t\t_, _ = w.Write(data)\n301\t}\n302\t\n303\t// --- /projects/{project}/jobs/{job}/jdi -------------------------------------\n304\t\n305\t// jobJDIResponse is the /projects/{project}/jobs/{job}/jdi response shape:\n306\t// the mg-jdi status (state/agent/updated — null when there is no live run\n307\t// state), the run.log tail (null when mg-jdi never ran the job), and the\n308\t// job's session.log tail (null when no run output was captured yet — a\n309\t// normal \"no run yet\", not an error).\n310\ttype jobJDIResponse struct {\n311\t\tStatus     *jdiStatusRow `json:\"status\"`\n312\t\tRunLog     *string       `json:\"runLog\"`\n313\t\tSessionLog *string       `json:\"sessionLog\"`\n314\t}\n315\t\n316\t// tailBytes bounds how much of a log file the jdi endpoint loads into memory\n317\t// — a tail, not \"load everything\", the same bounded-viewport approach\n318\t// job.ReadJDIRunLogTail already uses for run.log (256 KiB, generous enough\n319\t// for many invocations' worth of text while a small, fixed cost).\n320\tconst tailBytes = 256 * 1024\n321\t\n322\t// readFileTail returns the last tailBytes of the file at path — the\n323\t// session.log counterpart of job.ReadJDIRunLogTail, applied to a job-dir file\n324\t// (docs/jobs/<name>/session.log). A possibly-partial first line is dropped so\n325\t// the tail starts at a clean boundary, with a truncation marker. ok is false\n326\t// only when the file is missing; an existing-but-empty file is (\"\", true).\n327\tfunc readFileTail(path string) (string, bool) {\n328\t\tf, err := os.Open(path)\n329\t\tif err != nil {\n330\t\t\treturn \"\", false\n331\t\t}\n332\t\tdefer f.Close()\n333\t\n334\t\tinfo, err := f.Stat()\n335\t\tif err != nil {\n336\t\t\treturn \"\", false\n337\t\t}\n338\t\tsize := info.Size()\n339\t\tif size == 0 {\n340\t\t\treturn \"\", true\n341\t\t}\n342\t\n343\t\tstart := int64(0)\n344\t\ttruncated := false\n345\t\tif size > tailBytes {\n346\t\t\tstart = size - tailBytes\n347\t\t\ttruncated = true\n348\t\t}\n349\t\tif _, err := f.Seek(start, io.SeekStart); err != nil {\n350\t\t\treturn \"\", false\n351\t\t}\n352\t\tdata, err := io.ReadAll(f)\n353\t\tif err != nil {\n354\t\t\treturn \"\", false\n355\t\t}\n356\t\n357\t\ttext := string(data)\n358\t\tif truncated {\n359\t\t\tif idx := strings.IndexByte(text, '\\n'); idx >= 0 {\n360\t\t\t\ttext = text[idx+1:]\n361\t\t\t}\n362\t\t\ttext = \"… (log truncated — showing the most recent portion)\\n\\n\" + text\n363\t\t}\n364\t\treturn text, true\n365\t}\n366\t\n367\t// handleJobJDI serves a job's mg-jdi run state and its captured logs: the\n368\t// status sidecar (ReadJDIStatus), the run.log tail (ReadJDIRunLogTail), and\n369\t// the job's own session.log tail. All three are file reads scoped to the\n370\t// resolved root/job — never client-supplied paths.\n371\tfunc (s *Server) handleJobJDI(w http.ResponseWriter, r *http.Request) {\n372\t\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n373\t\tif !ok {\n374\t\t\treturn\n375\t\t}\n376\t\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n377\t\tif !ok {\n378\t\t\treturn\n379\t\t}\n380\t\n381\t\tresp := jobJDIResponse{}\n382\t\tif st, ok := job.ReadJDIStatus(root, j.Name); ok {\n383\t\t\tresp.Status = &jdiStatusRow{\n384\t\t\t\tState:   string(st.State),\n385\t\t\t\tAgent:   st.Agent,\n386\t\t\t\tUpdated: st.Updated.Format(time.RFC3339),\n387\t\t\t}\n388\t\t}\n389\t\tif text, ok := job.ReadJDIRunLogTail(root, j.Name); ok {\n390\t\t\tresp.RunLog = &text\n391\t\t}\n392\t\tif text, ok := readFileTail(filepath.Join(j.Dir, \"session.log\")); ok {\n393\t\t\tresp.SessionLog = &text\n394\t\t}\n395\t\twriteJSON(w, http.StatusOK, resp)\n396\t}\n397\t\n398\t// --- /projects/{project}/jobs/{job}/diff ------------------------------------\n399\t\n400\t// jobDiffResponse is the /projects/{project}/jobs/{job}/diff response shape.\n401\t// Without ?full=1 it is the \"quick eyeball\" — the branch's commits\n402\t// (git.LogOneline) and its changed files (git.DiffStat), the same two calls\n403\t// `mg diff` makes. With ?full=1 it is the complete patch (git.Diff). The\n404\t// three-dot range <base>...<branch> is resolved exactly as mg diff resolves\n405\t// it.\n406\ttype jobDiffResponse struct {\n407\t\tLog   *string `json:\"log,omitempty\"`\n408\t\tStat  *string `json:\"stat,omitempty\"`\n409\t\tPatch *string `json:\"patch,omitempty\"`\n410\t}\n411\t\n412\t// errJobBranchNotFound / errJobBranchAmbiguous classify a failed job→branch\n413\t// resolution so the handler can map them to 404 / 409 with the CLI's wording.\n414\tvar (\n415\t\terrJobBranchNotFound  = errors.New(\"job branch not found\")\n416\t\terrJobBranchAmbiguous = errors.New(\"job branch ambiguous\")\n417\t)\n418\t\n419\t// resolveJobBranch mirrors cmd/mg/diff.go's resolveJobBranch — the same\n420\t// exact-then-prefix matching on the branch's id_slug tail segment, with the\n421\t// same error wording. Not-found and ambiguity are classified (errors.Is) so\n422\t// the API can map them onto 404 / 409.\n423\tfunc resolveJobBranch(branches []string, jobArg string) (string, error) {\n424\t\tif branch := git.ExactBranchMatch(branches, jobArg); branch != \"\" {\n425\t\t\treturn branch, nil\n426\t\t}\n427\t\tprefixMatches := git.PrefixBranchMatches(branches, jobArg)\n428\t\tswitch len(prefixMatches) {\n429\t\tcase 0:\n430\t\t\tmsg := fmt.Sprintf(\"job '%s' not found among local branches.\\nActive job branches:\", jobArg)\n431\t\t\tfor _, b := range branches {\n432\t\t\t\tmsg += \"\\n  \" + b\n433\t\t\t}\n434\t\t\treturn \"\", fmt.Errorf(\"%w: %s\", errJobBranchNotFound, msg)\n435\t\tcase 1:\n436\t\t\treturn prefixMatches[0], nil\n437\t\tdefault:\n438\t\t\treturn \"\", fmt.Errorf(\"%w: job '%s' is ambiguous — matches branches: %s\", errJobBranchAmbiguous, jobArg, strings.Join(prefixMatches, \" \"))\n439\t\t}\n440\t}\n441\t\n442\t// handleJobDiff serves a job's branch diff against the project's base branch\n443\t// — the `mg diff` quick eyeball (log + stat) or, with ?full=1, the complete\n444\t// patch. The base branch resolves exactly as mg diff does (the project's\n445\t// configured baseBranch, falling back to origin/HEAD → main); the job→branch\n446\t// resolution is the CLI's exact-then-prefix chain. All git access goes\n447\t// through internal/git — the package that owns every git shell-out. Read-only\n448\t// git commands only.\n449\tfunc (s *Server) handleJobDiff(w http.ResponseWriter, r *http.Request) {\n450\t\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n451\t\tif !ok {\n452\t\t\treturn\n453\t\t}\n454\t\tjobArg := r.PathValue(\"job\")\n455\t\tif !validSegment(jobArg) {\n456\t\t\twriteError(w, http.StatusNotFound, \"job not found\")\n457\t\t\treturn\n458\t\t}\n459\t\n460\t\tbranches, err := git.LocalBranches(root)\n461\t\tif err != nil {\n462\t\t\twriteError(w, http.StatusInternalServerError, \"cannot read branches\")\n463\t\t\treturn\n464\t\t}\n465\t\tbranch, err := resolveJobBranch(branches, jobArg)\n466\t\tif err != nil {\n467\t\t\tswitch {\n468\t\t\tcase errors.Is(err, errJobBranchAmbiguous):\n469\t\t\t\twriteError(w, http.StatusConflict, strings.TrimPrefix(err.Error(), \"job branch ambiguous: \"))\n470\t\t\tdefault:\n471\t\t\t\twriteError(w, http.StatusNotFound, strings.TrimPrefix(err.Error(), \"job branch not found: \"))\n472\t\t\t}\n473\t\t\treturn\n474\t\t}\n475\t\n476\t\tsettings, err := project.Load(root)\n477\t\tif err != nil {\n478\t\t\twriteError(w, http.StatusInternalServerError, \"cannot read project settings\")\n479\t\t\treturn\n480\t\t}\n481\t\tbase := settings.BaseBranch\n482\t\tif base == \"\" {\n483\t\t\tbase = git.SymbolicRefHead(root)\n484\t\t}\n485\t\n486\t\tif r.URL.Query().Get(\"full\") == \"1\" {\n487\t\t\tpatch, err := git.Diff(root, base, branch)\n488\t\t\tif err != nil {\n489\t\t\t\twriteError(w, http.StatusInternalServerError, \"cannot compute diff\")\n490\t\t\t\treturn\n491\t\t\t}\n492\t\t\twriteJSON(w, http.StatusOK, jobDiffResponse{Patch: &patch})\n493\t\t\treturn\n494\t\t}\n495\t\n496\t\tlogs, err := git.LogOneline(root, base, branch)\n497\t\tif err != nil {\n498\t\t\twriteError(w, http.StatusInternalServerError, \"cannot read log\")\n499\t\t\treturn\n500\t\t}\n501\t\tstat, err := git.DiffStat(root, base, branch)\n502\t\tif err != nil {\n503\t\t\twriteError(w, http.StatusInternalServerError, \"cannot read diff stat\")\n504\t\t\treturn\n505\t\t}\n506\t\twriteJSON(w, http.StatusOK, jobDiffResponse{Log: &logs, Stat: &stat})\n507\t}\n508\t\n509\t// --- /projects/{project}/agents ---------------------------------------------\n510\t\n511\t// agentRow is one entry in the agents response: name and one-line description\n512\t// only — never the agent files' contents beyond the description line.\n513\ttype agentRow struct {\n514\t\tName        string `json:\"name\"`\n515\t\tDescription string `json:\"description\"`\n516\t}\n517\t\n518\t// agentsResponse is the /projects/{project}/agents response shape.\n519\ttype agentsResponse struct {\n520\t\tAgents []agentRow `json:\"agents\"`\n521\t}\n522\t\n523\t// handleProjectAgents lists the agents available to a project — the `mg\n524\t// agents` list (agentlist.Discover), name + description only.\n525\tfunc (s *Server) handleProjectAgents(w http.ResponseWriter, r *http.Request) {\n526\t\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n527\t\tif !ok {\n528\t\t\treturn\n529\t\t}\n530\t\tagents, err := agentlist.Discover(root)\n531\t\tif err != nil {\n532\t\t\twriteError(w, http.StatusInternalServerError, \"cannot list agents\")\n533\t\t\treturn\n534\t\t}\n535\t\trows := make([]agentRow, 0, len(agents))\n536\t\tfor _, a := range agents {\n537\t\t\trows = append(rows, agentRow{Name: a.Name, Description: a.Description})\n538\t\t}\n539\t\twriteJSON(w, http.StatusOK, agentsResponse{Agents: rows})\n540\t}\n541\t"}]},"parent_tool_use_id":null,"session_id":"ba948ea7-a157-4c42-8eb1-077540d9946d","uuid":"0e1ffed2-37b8-4e83-8afe-12a752991ae2","timestamp":"2026-08-28T20:27:40.111Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/serve/api.go","content":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/agentlist\"\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n\t\"github.com/lmuskalla/manigot/internal/session\"\n)\n\n// --- JSON helpers ------------------------------------------------------------\n\n// writeJSON writes v as a JSON response with the given status.\nfunc writeJSON(w http.ResponseWriter, status int, v any) {\n\tw.Header().Set(\"Content-Type\", \"application/json\")\n\tw.WriteHeader(status)\n\t_ = json.NewEncoder(w).Encode(v)\n}\n\n// apiError is the JSON error envelope every non-2xx response carries.\ntype apiError struct {\n\tError string `json:\"error\"`\n}\n\n// writeError writes a JSON error envelope with the given status.\nfunc writeError(w http.ResponseWriter, status int, msg string) {\n\twriteJSON(w, status, apiError{Error: msg})\n}\n\n// --- Resolution helpers — the zero-path-inputs choke point -------------------\n//\n// Every handler resolves its URL segments ONLY through these helpers. A\n// segment is validated as a plain identifier (validSegment), then matched —\n// never joined into a filesystem path. The registered roots (TASK-1), the\n// discovered jobs, and the file whitelist are the only sources of paths the\n// handlers ever open.\n\n// validSegment reports whether a URL segment is a plain, trustworthy\n// identifier: non-empty, not \".\" or \"..\" (traversal), containing no path\n// separator (forward or backslash — the backslash is a Windows separator and\n// must never reach a filesystem path), and no NUL byte. Percent-encoded and\n// double-encoded variants all decode to one of these forms before matching,\n// so rejecting the decoded form rejects them all.\nfunc validSegment(seg string) bool {\n\tif seg == \"\" || seg == \".\" || seg == \"..\" {\n\t\treturn false\n\t}\n\tif strings.ContainsAny(seg, \"/\\\\\") {\n\t\treturn false\n\t}\n\treturn !strings.ContainsRune(seg, 0)\n}\n\n// resolveProject maps a URL project segment to a registered root. The segment\n// is validated, then matched against the registry by configured entry name\n// only (Registry.Project) — it is never joined into a filesystem path. An\n// invalid segment or no match is a 404; the handler returns false and must\n// return immediately.\nfunc (s *Server) resolveProject(w http.ResponseWriter, segment string) (string, bool) {\n\tif !validSegment(segment) {\n\t\twriteError(w, http.StatusNotFound, \"project not found\")\n\t\treturn \"\", false\n\t}\n\troot, ok := s.reg.Project(segment)\n\tif !ok {\n\t\twriteError(w, http.StatusNotFound, \"project not found\")\n\t\treturn \"\", false\n\t}\n\treturn root, true\n}\n\n// resolveJob maps a URL job segment to a discovered job under root. The\n// segment is validated, then matched against the project's discovered jobs by\n// ID, then by id_slug name (the job directory name — the same identity the\n// CLI's branch-tail matching uses), then by unique name prefix. It is never\n// treated as a path. Not-found is a 404; an ambiguous prefix is a 409; the\n// handler returns false and must return immediately.\nfunc (s *Server) resolveJob(w http.ResponseWriter, root, segment string) (job.Job, bool) {\n\tif !validSegment(segment) {\n\t\twriteError(w, http.StatusNotFound, \"job not found\")\n\t\treturn job.Job{}, false\n\t}\n\tjobs, err := job.Discover(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read jobs\")\n\t\treturn job.Job{}, false\n\t}\n\n\t// Exact by ID, then by name.\n\tfor _, j := range jobs {\n\t\tif j.ID == segment || j.Name == segment {\n\t\t\treturn j, true\n\t\t}\n\t}\n\n\t// Unique prefix on the name.\n\tvar matches []job.Job\n\tfor _, j := range jobs {\n\t\tif strings.HasPrefix(j.Name, segment) {\n\t\t\tmatches = append(matches, j)\n\t\t}\n\t}\n\tswitch len(matches) {\n\tcase 0:\n\t\twriteError(w, http.StatusNotFound, fmt.Sprintf(\"job '%s' not found among the project's jobs\", segment))\n\t\treturn job.Job{}, false\n\tcase 1:\n\t\treturn matches[0], true\n\tdefault:\n\t\tnames := make([]string, 0, len(matches))\n\t\tfor _, j := range matches {\n\t\t\tnames = append(names, j.Name)\n\t\t}\n\t\twriteError(w, http.StatusConflict, fmt.Sprintf(\"job '%s' is ambiguous — matches jobs: %s\", segment, strings.Join(names, \" \")))\n\t\treturn job.Job{}, false\n\t}\n}\n\n// jobFileNames is the whitelist of job files the API serves: a job's four\n// markdown files, read as raw markdown text. Nothing else under the job dir\n// is ever served.\nvar jobFileNames = map[string]bool{\n\t\"brief.md\":          true,\n\t\"tasks.md\":          true,\n\t\"implementation.md\": true,\n\t\"verdict.md\":        true,\n}\n\n// --- /health -----------------------------------------------------------------\n\n// healthProfileRow is one profile's credential readiness in the /health\n// response: ready = the profile's ResolveProfile + CheckAuth succeed (the\n// same check the session launcher runs). A missing key is \"not ready\", never\n// an error; the credential values themselves are never reported.\ntype healthProfileRow struct {\n\tID    string `json:\"id\"`\n\tReady bool   `json:\"ready\"`\n}\n\n// healthResponse is the /health response shape: the mg version, whether the\n// docker image is present (session.ImagePresent), and per-profile readiness.\ntype healthResponse struct {\n\tVersion      string             `json:\"version\"`\n\tImagePresent bool               `json:\"imagePresent\"`\n\tProfiles     []healthProfileRow `json:\"profiles\"`\n}\n\n// profileReady reduces a profile's credential check to a boolean.\nfunc profileReady(id string) bool {\n\tinfo, err := session.ResolveProfile(session.Options{Profile: id})\n\tif err != nil {\n\t\treturn false\n\t}\n\treturn info.CheckAuth() == nil\n}\n\n// handleHealth serves the daemon's health/status: version, docker image\n// presence, and profile readiness — pure booleans and identifiers, never\n// credential material.\nfunc (s *Server) handleHealth(w http.ResponseWriter, r *http.Request) {\n\tresp := healthResponse{\n\t\tVersion:      s.version,\n\t\tImagePresent: session.ImagePresent(),\n\t}\n\tfor _, p := range config.Profiles() {\n\t\tresp.Profiles = append(resp.Profiles, healthProfileRow{ID: p.ID, Ready: profileReady(p.ID)})\n\t}\n\twriteJSON(w, http.StatusOK, resp)\n}\n\n// --- /projects ---------------------------------------------------------------\n\n// projectRow is one entry in the /projects response: a registered root and\n// its configured name (the URL segment that resolves to it).\ntype projectRow struct {\n\tPath string `json:\"path\"`\n\tName string `json:\"name\"`\n}\n\n// projectsResponse is the /projects response shape.\ntype projectsResponse struct {\n\tProjects []projectRow `json:\"projects\"`\n}\n\n// handleProjects lists the registered project roots — pure registry data, the\n// daemon never scans for projects it does not know.\nfunc (s *Server) handleProjects(w http.ResponseWriter, r *http.Request) {\n\tentries := s.reg.Entries()\n\trows := make([]projectRow, 0, len(entries))\n\tfor _, e := range entries {\n\t\trows = append(rows, projectRow{Path: e.Path, Name: e.Name})\n\t}\n\twriteJSON(w, http.StatusOK, projectsResponse{Projects: rows})\n}\n\n// --- /projects/{project}/jobs ------------------------------------------------\n\n// jdiStatusRow is the mg-jdi activity state for a job: state / agent / last\n// update, from the job's status sidecar. Omitted when there is no live run\n// state (a job mg-jdi never drove, or a stale/unreadable sidecar).\ntype jdiStatusRow struct {\n\tState   string `json:\"state\"`\n\tAgent   string `json:\"agent\"`\n\tUpdated string `json:\"updated\"` // RFC3339\n}\n\n// jobRow is one row in the jobs response — the TUI's info design: id / status\n// / stage / type / date / title, one row per job, in job.Discover's sort\n// order (newest first).\ntype jobRow struct {\n\tID     string        `json:\"id\"`\n\tName   string        `json:\"name\"`\n\tStatus string        `json:\"status\"`\n\tStage  string        `json:\"stage\"`\n\tType   string        `json:\"type\"`\n\tDate   string        `json:\"date\"`\n\tTitle  string        `json:\"title\"`\n\tBranch string        `json:\"branch,omitempty\"`\n\tJDI    *jdiStatusRow `json:\"jdi,omitempty\"`\n}\n\n// jobsResponse is the /projects/{project}/jobs response shape.\ntype jobsResponse struct {\n\tJobs []jobRow `json:\"jobs\"`\n}\n\n// handleProjectJobs lists a project's open jobs with the mg-jdi activity\n// state per job.\nfunc (s *Server) handleProjectJobs(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tjobs, err := job.Discover(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read jobs\")\n\t\treturn\n\t}\n\trows := make([]jobRow, 0, len(jobs))\n\tfor _, j := range jobs {\n\t\trow := jobRow{\n\t\t\tID:     j.ID,\n\t\t\tName:   j.Name,\n\t\t\tStatus: j.Status,\n\t\t\tStage:  string(j.Stage()),\n\t\t\tType:   j.Type,\n\t\t\tDate:   j.Date,\n\t\t\tTitle:  j.Title,\n\t\t\tBranch: j.Branch,\n\t\t}\n\t\tif st, ok := job.ReadJDIStatus(root, j.Name); ok {\n\t\t\trow.JDI = &jdiStatusRow{\n\t\t\t\tState:   string(st.State),\n\t\t\t\tAgent:   st.Agent,\n\t\t\t\tUpdated: st.Updated.Format(time.RFC3339),\n\t\t\t}\n\t\t}\n\t\trows = append(rows, row)\n\t}\n\twriteJSON(w, http.StatusOK, jobsResponse{Jobs: rows})\n}\n\n// --- /projects/{project}/jobs/{job}/files/{file} -----------------------------\n\n// handleJobFile serves one of a job's four markdown files as raw markdown\n// text. The file segment is whitelisted (jobFileNames); a missing file is a\n// normal 404 (e.g. verdict.md before review).\nfunc (s *Server) handleJobFile(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\tfile := r.PathValue(\"file\")\n\tif !jobFileNames[file] {\n\t\twriteError(w, http.StatusNotFound, \"file not found\")\n\t\treturn\n\t}\n\tdata, err := os.ReadFile(filepath.Join(j.Dir, file))\n\tif err != nil {\n\t\twriteError(w, http.StatusNotFound, \"file not found\")\n\t\treturn\n\t}\n\tw.Header().Set(\"Content-Type\", \"text/markdown; charset=utf-8\")\n\tw.WriteHeader(http.StatusOK)\n\t_, _ = w.Write(data)\n}\n\n// --- /projects/{project}/jobs/{job}/jdi -------------------------------------\n\n// jobJDIResponse is the /projects/{project}/jobs/{job}/jdi response shape:\n// the mg-jdi status (state/agent/updated — null when there is no live run\n// state), the run.log tail (null when mg-jdi never ran the job), and the\n// job's session.log tail (null when no run output was captured yet — a\n// normal \"no run yet\", not an error).\ntype jobJDIResponse struct {\n\tStatus     *jdiStatusRow `json:\"status\"`\n\tRunLog     *string       `json:\"runLog\"`\n\tSessionLog *string       `json:\"sessionLog\"`\n}\n\n// tailBytes bounds how much of a log file the jdi endpoint loads into memory\n// — a tail, not \"load everything\", the same bounded-viewport approach\n// job.ReadJDIRunLogTail already uses for run.log (256 KiB, generous enough\n// for many invocations' worth of text while a small, fixed cost).\nconst tailBytes = 256 * 1024\n\n// readFileTail returns the last tailBytes of the file at path — the\n// session.log counterpart of job.ReadJDIRunLogTail, applied to a job-dir file\n// (docs/jobs/<name>/session.log). A possibly-partial first line is dropped so\n// the tail starts at a clean boundary, with a truncation marker. ok is false\n// only when the file is missing; an existing-but-empty file is (\"\", true).\nfunc readFileTail(path string) (string, bool) {\n\tf, err := os.Open(path)\n\tif err != nil {\n\t\treturn \"\", false\n\t}\n\tdefer f.Close()\n\n\tinfo, err := f.Stat()\n\tif err != nil {\n\t\treturn \"\", false\n\t}\n\tsize := info.Size()\n\tif size == 0 {\n\t\treturn \"\", true\n\t}\n\n\tstart := int64(0)\n\ttruncated := false\n\tif size > tailBytes {\n\t\tstart = size - tailBytes\n\t\ttruncated = true\n\t}\n\tif _, err := f.Seek(start, io.SeekStart); err != nil {\n\t\treturn \"\", false\n\t}\n\tdata, err := io.ReadAll(f)\n\tif err != nil {\n\t\treturn \"\", false\n\t}\n\n\ttext := string(data)\n\tif truncated {\n\t\tif idx := strings.IndexByte(text, '\\n'); idx >= 0 {\n\t\t\ttext = text[idx+1:]\n\t\t}\n\t\ttext = \"… (log truncated — showing the most recent portion)\\n\\n\" + text\n\t}\n\treturn text, true\n}\n\n// handleJobJDI serves a job's mg-jdi run state and its captured logs: the\n// status sidecar (ReadJDIStatus), the run.log tail (ReadJDIRunLogTail), and\n// the job's own session.log tail. All three are file reads scoped to the\n// resolved root/job — never client-supplied paths.\nfunc (s *Server) handleJobJDI(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\tresp := jobJDIResponse{}\n\tif st, ok := job.ReadJDIStatus(root, j.Name); ok {\n\t\tresp.Status = &jdiStatusRow{\n\t\t\tState:   string(st.State),\n\t\t\tAgent:   st.Agent,\n\t\t\tUpdated: st.Updated.Format(time.RFC3339),\n\t\t}\n\t}\n\tif text, ok := job.ReadJDIRunLogTail(root, j.Name); ok {\n\t\tresp.RunLog = &text\n\t}\n\tif text, ok := readFileTail(filepath.Join(j.Dir, \"session.log\")); ok {\n\t\tresp.SessionLog = &text\n\t}\n\twriteJSON(w, http.StatusOK, resp)\n}\n\n// --- /projects/{project}/jobs/{job}/diff ------------------------------------\n\n// jobDiffResponse is the /projects/{project}/jobs/{job}/diff response shape.\n// Without ?full=1 it is the \"quick eyeball\" — the branch's commits\n// (git.LogOneline) and its changed files (git.DiffStat), the same two calls\n// `mg diff` makes. With ?full=1 it is the complete patch (git.Diff). The\n// three-dot range <base>...<branch> is resolved exactly as mg diff resolves\n// it.\ntype jobDiffResponse struct {\n\tLog   *string `json:\"log,omitempty\"`\n\tStat  *string `json:\"stat,omitempty\"`\n\tPatch *string `json:\"patch,omitempty\"`\n}\n\n// errJobBranchNotFound / errJobBranchAmbiguous classify a failed job→branch\n// resolution so the handler can map them to 404 / 409 with the CLI's wording.\nvar (\n\terrJobBranchNotFound  = errors.New(\"job branch not found\")\n\terrJobBranchAmbiguous = errors.New(\"job branch ambiguous\")\n)\n\n// resolveJobBranch mirrors cmd/mg/diff.go's resolveJobBranch — the same\n// exact-then-prefix matching on the branch's id_slug tail segment, with the\n// same error wording. Not-found and ambiguity are classified (errors.Is) so\n// the API can map them onto 404 / 409.\nfunc resolveJobBranch(branches []string, jobArg string) (string, error) {\n\tif branch := git.ExactBranchMatch(branches, jobArg); branch != \"\" {\n\t\treturn branch, nil\n\t}\n\tprefixMatches := git.PrefixBranchMatches(branches, jobArg)\n\tswitch len(prefixMatches) {\n\tcase 0:\n\t\tmsg := fmt.Sprintf(\"job '%s' not found among local branches.\\nActive job branches:\", jobArg)\n\t\tfor _, b := range branches {\n\t\t\tmsg += \"\\n  \" + b\n\t\t}\n\t\treturn \"\", fmt.Errorf(\"%w: %s\", errJobBranchNotFound, msg)\n\tcase 1:\n\t\treturn prefixMatches[0], nil\n\tdefault:\n\t\treturn \"\", fmt.Errorf(\"%w: job '%s' is ambiguous — matches branches: %s\", errJobBranchAmbiguous, jobArg, strings.Join(prefixMatches, \" \"))\n\t}\n}\n\n// handleJobDiff serves a job's branch diff against the project's base branch\n// — the `mg diff` quick eyeball (log + stat) or, with ?full=1, the complete\n// patch. The base branch resolves exactly as mg diff does (the project's\n// configured baseBranch, falling back to origin/HEAD → main); the job→branch\n// resolution is the CLI's exact-then-prefix chain. All git access goes\n// through internal/git — the package that owns every git shell-out. Read-only\n// git commands only.\nfunc (s *Server) handleJobDiff(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tjobArg := r.PathValue(\"job\")\n\tif !validSegment(jobArg) {\n\t\twriteError(w, http.StatusNotFound, \"job not found\")\n\t\treturn\n\t}\n\n\tbranches, err := git.LocalBranches(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read branches\")\n\t\treturn\n\t}\n\tbranch, err := resolveJobBranch(branches, jobArg)\n\tif err != nil {\n\t\tswitch {\n\t\tcase errors.Is(err, errJobBranchAmbiguous):\n\t\t\twriteError(w, http.StatusConflict, strings.TrimPrefix(err.Error(), \"job branch ambiguous: \"))\n\t\tdefault:\n\t\t\twriteError(w, http.StatusNotFound, strings.TrimPrefix(err.Error(), \"job branch not found: \"))\n\t\t}\n\t\treturn\n\t}\n\n\tsettings, err := project.Load(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read project settings\")\n\t\treturn\n\t}\n\tbase := settings.BaseBranch\n\tif base == \"\" {\n\t\tbase = git.SymbolicRefHead(root)\n\t}\n\n\tif r.URL.Query().Get(\"full\") == \"1\" {\n\t\tpatch, err := git.Diff(root, base, branch)\n\t\tif err != nil {\n\t\t\twriteError(w, http.StatusInternalServerError, \"cannot compute diff\")\n\t\t\treturn\n\t\t}\n\t\twriteJSON(w, http.StatusOK, jobDiffResponse{Patch: &patch})\n\t\treturn\n\t}\n\n\tlogs, err := git.LogOneline(root, base, branch)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read log\")\n\t\treturn\n\t}\n\tstat, err := git.DiffStat(root, base, branch)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot read diff stat\")\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, jobDiffResponse{Log: &logs, Stat: &stat})\n}\n\n// --- /projects/{project}/agents ---------------------------------------------\n\n// agentRow is one entry in the agents response: name and one-line description\n// only — never the agent files' contents beyond the description line.\ntype agentRow struct {\n\tName        string `json:\"name\"`\n\tDescription string `json:\"description\"`\n}\n\n// agentsResponse is the /projects/{project}/agents response shape.\ntype agentsResponse struct {\n\tAgents []agentRow `json:\"agents\"`\n}\n\n// handleProjectAgents lists the agents available to a project — the `mg\n// agents` list (agentlist.Discover), name + description only.\nfunc (s *Server) handleProjectAgents(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tagents, err := agentlist.Discover(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot list agents\")\n\t\treturn\n\t}\n\trows := make([]agentRow, 0, len(agents))\n\tfor _, a := range agents {\n\t\trows = append(rows, agentRow{Name: a.Name, Description: a.Description})\n\t}\n\twriteJSON(w, http.StatusOK, agentsResponse{Agents: rows})\n}\n","numLines":541,"startLine":1,"totalLines":541}}}
