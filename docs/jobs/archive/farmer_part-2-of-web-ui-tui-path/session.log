{"type":"tool_use","timestamp":1787950590826,"sessionID":"ses_fb5dcd7a6ffeSGBPKFVeVpziRm","part":{"type":"tool","tool":"read","callID":"call_11fc0b808805408e86945102","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/session/prune.go"},"output":"<path>/workspace/src/internal/session/prune.go</path>\n<type>file</type>\n<content>\n1: package session\n2: \n3: import (\n4: \t\"fmt\"\n5: \t\"io\"\n6: \t\"os/exec\"\n7: \t\"strings\"\n8: )\n9: \n10: // PruneResult reports what a PruneOrphans run found and did.\n11: type PruneResult struct {\n12: \t// Removed is how many EXITED manigot-* containers were removed.\n13: \tRemoved int\n14: \t// Running is how many manigot-* containers are currently running —\n15: \t// reported, never touched.\n16: \tRunning int\n17: }\n18: \n19: // dockerCommand is the seam PruneOrphans shells out through. A package-level\n20: // var so tests can stub it without requiring docker (or a daemon) on the test\n21: // machine — mirrors cmd/mg/diff.go's tigLookPath pattern.\n22: var dockerCommand = func(args ...string) ([]byte, error) {\n23: \treturn exec.Command(\"docker\", args...).CombinedOutput()\n24: }\n25: \n26: // wrapDockerErr wraps a failed docker invocation, appending docker's own\n27: // captured output (CombinedOutput) when there is any — a down daemon's\n28: // \"Cannot connect to the Docker daemon ...\" diagnostic would otherwise be\n29: // swallowed and the user would see only \"exit status 1\".\n30: func wrapDockerErr(cmd string, err error, out []byte) error {\n31: \tif msg := strings.TrimSpace(string(out)); msg != \"\" {\n32: \t\treturn fmt.Errorf(\"docker %s: %w: %s\", cmd, err, msg)\n33: \t}\n34: \treturn fmt.Errorf(\"docker %s: %w\", cmd, err)\n35: }\n36: \n37: // PruneOrphans removes every EXITED container whose name matches the manigot\n38: // prefix (\"manigot-...\", as named by BuildDockerInvocation). Sessions normally\n39: // run with --rm, so orphans are purely the residue of abnormal ends — a killed\n40: // client, a killed pane/window, a host/daemon restart, a hung CLI — and\n41: // cleanup therefore only ever touches exited manigot containers. Running\n42: // manigot containers (a killed pane/window can leave an unattended agent that\n43: // is still working) and every foreign container are never touched — the same\n44: // semantics as `docker container prune`, scoped to manigot's own containers.\n45: //\n46: // The removed and running counts are both returned, so callers can report them\n47: // (the explicit `mg prune` command) or stay quiet (the launch path). A\n48: // pruning line is written to diag only when something was actually removed —\n49: // the launch path stays silent on the common nothing-to-prune case.\n50: //\n51: // docker missing or the daemon down is an error; the caller decides how to\n52: // surface it — the launch path warns on stderr and continues, `mg prune`\n53: // exits 1.\n54: func PruneOrphans(diag io.Writer) (PruneResult, error) {\n55: \t// The exited manigot containers — the only ones ever removed.\n56: \tout, err := dockerCommand(\"ps\", \"-aq\", \"--filter\", \"name=^/manigot-\", \"--filter\", \"status=exited\")\n57: \tif err != nil {\n58: \t\treturn PruneResult{}, wrapDockerErr(\"ps\", err, out)\n59: \t}\n60: \texited := strings.Fields(string(out))\n61: \n62: \tif len(exited) > 0 {\n63: \t\trmOut, err := dockerCommand(append([]string{\"rm\"}, exited...)...)\n64: \t\tif err != nil {\n65: \t\t\treturn PruneResult{}, wrapDockerErr(\"rm\", err, rmOut)\n66: \t\t}\n67: \t}\n68: \n69: \t// The running manigot containers — reported, never touched. A plain\n70: \t// `docker ps -q` (no -a) lists only running containers.\n71: \trunning, err := dockerCommand(\"ps\", \"-q\", \"--filter\", \"name=^/manigot-\")\n72: \tif err != nil {\n73: \t\treturn PruneResult{}, wrapDockerErr(\"ps\", err, running)\n74: \t}\n75: \n76: \tif diag != nil && len(exited) > 0 {\n77: \t\tfmt.Fprintf(diag, \"Pruned %d orphaned manigot container(s).\\n\", len(exited))\n78: \t}\n79: \treturn PruneResult{Removed: len(exited), Running: len(strings.Fields(string(running)))}, nil\n80: }\n\n(End of file - total 80 lines)\n</content>","metadata":{"preview":"package session\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os/exec\"\n\t\"strings\"\n)\n\n// PruneResult reports what a PruneOrphans run found and did.\ntype PruneResult struct {\n\t// Removed is how many EXITED manigot-* containers were removed.\n\tRemoved int\n\t// Running is how many manigot-* containers are currently running —\n\t// reported, never touched.\n\tRunning int\n}\n\n// dockerCommand is the seam PruneOrphans shells out through. A package-level\n// var so tests can stub it without requiring docker (or a daemon) on the test","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/session/prune.go","text":"package session\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os/exec\"\n\t\"strings\"\n)\n\n// PruneResult reports what a PruneOrphans run found and did.\ntype PruneResult struct {\n\t// Removed is how many EXITED manigot-* containers were removed.\n\tRemoved int\n\t// Running is how many manigot-* containers are currently running —\n\t// reported, never touched.\n\tRunning int\n}\n\n// dockerCommand is the seam PruneOrphans shells out through. A package-level\n// var so tests can stub it without requiring docker (or a daemon) on the test\n// machine — mirrors cmd/mg/diff.go's tigLookPath pattern.\nvar dockerCommand = func(args ...string) ([]byte, error) {\n\treturn exec.Command(\"docker\", args...).CombinedOutput()\n}\n\n// wrapDockerErr wraps a failed docker invocation, appending docker's own\n// captured output (CombinedOutput) when there is any — a down daemon's\n// \"Cannot connect to the Docker daemon ...\" diagnostic would otherwise be\n// swallowed and the user would see only \"exit status 1\".\nfunc wrapDockerErr(cmd string, err error, out []byte) error {\n\tif msg := strings.TrimSpace(string(out)); msg != \"\" {\n\t\treturn fmt.Errorf(\"docker %s: %w: %s\", cmd, err, msg)\n\t}\n\treturn fmt.Errorf(\"docker %s: %w\", cmd, err)\n}\n\n// PruneOrphans removes every EXITED container whose name matches the manigot\n// prefix (\"manigot-...\", as named by BuildDockerInvocation). Sessions normally\n// run with --rm, so orphans are purely the residue of abnormal ends — a killed\n// client, a killed pane/window, a host/daemon restart, a hung CLI — and\n// cleanup therefore only ever touches exited manigot containers. Running\n// manigot containers (a killed pane/window can leave an unattended agent that\n// is still working) and every foreign container are never touched — the same\n// semantics as `docker container prune`, scoped to manigot's own containers.\n//\n// The removed and running counts are both returned, so callers can report them\n// (the explicit `mg prune` command) or stay quiet (the launch path). A\n// pruning line is written to diag only when something was actually removed —\n// the launch path stays silent on the common nothing-to-prune case.\n//\n// docker missing or the daemon down is an error; the caller decides how to\n// surface it — the launch path warns on stderr and continues, `mg prune`\n// exits 1.\nfunc PruneOrphans(diag io.Writer) (PruneResult, error) {\n\t// The exited manigot containers — the only ones ever removed.\n\tout, err := dockerCommand(\"ps\", \"-aq\", \"--filter\", \"name=^/manigot-\", \"--filter\", \"status=exited\")\n\tif err != nil {\n\t\treturn PruneResult{}, wrapDockerErr(\"ps\", err, out)\n\t}\n\texited := strings.Fields(string(out))\n\n\tif len(exited) > 0 {\n\t\trmOut, err := dockerCommand(append([]string{\"rm\"}, exited...)...)\n\t\tif err != nil {\n\t\t\treturn PruneResult{}, wrapDockerErr(\"rm\", err, rmOut)\n\t\t}\n\t}\n\n\t// The running manigot containers — reported, never touched. A plain\n\t// `docker ps -q` (no -a) lists only running containers.\n\trunning, err := dockerCommand(\"ps\", \"-q\", \"--filter\", \"name=^/manigot-\")\n\tif err != nil {\n\t\treturn PruneResult{}, wrapDockerErr(\"ps\", err, running)\n\t}\n\n\tif diag != nil && len(exited) > 0 {\n\t\tfmt.Fprintf(diag, \"Pruned %d orphaned manigot container(s).\\n\", len(exited))\n\t}\n\treturn PruneResult{Removed: len(exited), Running: len(strings.Fields(string(running)))}, nil\n}","lineStart":1,"lineEnd":80,"totalLines":80,"truncated":false}},"title":"src/internal/session/prune.go","time":{"start":1787950590822,"end":1787950590825}},"id":"prt_04a28eaf6001Gy6Vjwl36oI1PZ","sessionID":"ses_fb5dcd7a6ffeSGBPKFVeVpziRm","messageID":"msg_04a28c145001x6FS7FdplQ81oj"}}
{"type":"tool_use","timestamp":1787950591521,"sessionID":"ses_fb5dcd7a6ffeSGBPKFVeVpziRm","part":{"type":"tool","tool":"read","callID":"call_eeec5a18612f4e1c8063536e","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/job/orphan.go","limit":80},"output":"<path>/workspace/src/internal/job/orphan.go</path>\n<type>file</type>\n<content>\n1: package job\n2: \n3: import (\n4: \t\"fmt\"\n5: \t\"io\"\n6: \t\"os\"\n7: \t\"path/filepath\"\n8: \t\"sort\"\n9: \t\"strings\"\n10: \n11: \t\"github.com/lmuskalla/manigot/internal/git\"\n12: )\n13: \n14: // Orphan is a leftover worktree directory under the project's\n15: // .manigot-worktrees/ whose git registration is gone: the directory still\n16: // exists, but the gitdir its .git file points at no longer does. git worktree\n17: // prune cannot reach these — it only prunes stale *metadata* for worktrees\n18: // whose working directory vanished, and deliberately leaves working\n19: // directories behind — so a job scaffolded and then abandoned leaves a dead\n20: // directory that no tool path removes until now.\n21: type Orphan struct {\n22: \t// Name is the base directory name (the id_slug), e.g.\n23: \t// \"o3kk3n_jdi-is-broken\" — the name mg delete resolves by.\n24: \tName string\n25: \n26: \t// Dir is the absolute path of the leftover directory.\n27: \tDir string\n28: \n29: \t// GitDir is the gitdir path the .git file recorded, now gone. Always\n30: \t// non-empty for a reported orphan — detection requires a .git pointer file\n31: \t// naming a vanished gitdir.\n32: \tGitDir string\n33: }\n34: \n35: // worktreeParents returns the two candidate parent directories under which a\n36: // project's job worktrees live: the sibling layout\n37: // (<dirname(root)>/.manigot-worktrees/<basename(root)>) and the nested\n38: // (mount-point) layout (<root>/.manigot-worktrees). Both are scanned because\n39: // the layout is decided per-creation, and either (or, after a migration, both)\n40: // can hold leftover worktrees.\n41: func worktreeParents(root string) []string {\n42: \treturn []string{\n43: \t\tfilepath.Join(filepath.Dir(root), \".manigot-worktrees\", filepath.Base(root)),\n44: \t\tfilepath.Join(root, \".manigot-worktrees\"),\n45: \t}\n46: }\n47: \n48: // DiscoverOrphans scans the project's .manigot-worktrees parents (sibling and\n49: // nested layouts) and returns every leftover worktree directory whose .git\n50: // file points to a gitdir that no longer exists.\n51: //\n52: // A directory only counts as an orphan when its .git file names a gitdir that\n53: // is gone. A live worktree's .git file names an existing gitdir, so it is\n54: // skipped; a directory with no .git file, or with a .git *directory* (a\n55: // standalone repository), is also skipped — the tool removes worktrees, not\n56: // arbitrary junk. No git invocation is involved: the scan is pure filesystem,\n57: // so it degrades gracefully on a non-repo or a repo with no .manigot-worktrees\n58: // parent at all (an empty result, not an error).\n59: func DiscoverOrphans(root string) ([]Orphan, error) {\n60: \tvar orphans []Orphan\n61: \tseen := map[string]bool{}\n62: \n63: \tfor _, parent := range worktreeParents(root) {\n64: \t\tentries, err := os.ReadDir(parent)\n65: \t\tif err != nil {\n66: \t\t\t// No .manigot-worktrees here — not an error.\n67: \t\t\tcontinue\n68: \t\t}\n69: \t\tfor _, e := range entries {\n70: \t\t\tif !e.IsDir() {\n71: \t\t\t\tcontinue\n72: \t\t\t}\n73: \t\t\tdir := filepath.Join(parent, e.Name())\n74: \t\t\tif seen[dir] {\n75: \t\t\t\tcontinue\n76: \t\t\t}\n77: \t\t\tgitdir := readGitdir(filepath.Join(dir, \".git\"))\n78: \t\t\tif gitdir == \"\" {\n79: \t\t\t\t// No .git pointer file at all — a stray non-worktree\n80: \t\t\t\t// directory, or a .git *directory* (a standalone repository).\n\n(Showing lines 1-80 of 212. Use offset=81 to continue.)\n</content>","metadata":{"preview":"package job\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/git\"\n)\n\n// Orphan is a leftover worktree directory under the project's\n// .manigot-worktrees/ whose git registration is gone: the directory still\n// exists, but the gitdir its .git file points at no longer does. git worktree\n// prune cannot reach these — it only prunes stale *metadata* for worktrees\n// whose working directory vanished, and deliberately leaves working\n// directories behind — so a job scaffolded and then abandoned leaves a dead\n// directory that no tool path removes until now.","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/job/orphan.go","text":"package job\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/git\"\n)\n\n// Orphan is a leftover worktree directory under the project's\n// .manigot-worktrees/ whose git registration is gone: the directory still\n// exists, but the gitdir its .git file points at no longer does. git worktree\n// prune cannot reach these — it only prunes stale *metadata* for worktrees\n// whose working directory vanished, and deliberately leaves working\n// directories behind — so a job scaffolded and then abandoned leaves a dead\n// directory that no tool path removes until now.\ntype Orphan struct {\n\t// Name is the base directory name (the id_slug), e.g.\n\t// \"o3kk3n_jdi-is-broken\" — the name mg delete resolves by.\n\tName string\n\n\t// Dir is the absolute path of the leftover directory.\n\tDir string\n\n\t// GitDir is the gitdir path the .git file recorded, now gone. Always\n\t// non-empty for a reported orphan — detection requires a .git pointer file\n\t// naming a vanished gitdir.\n\tGitDir string\n}\n\n// worktreeParents returns the two candidate parent directories under which a\n// project's job worktrees live: the sibling layout\n// (<dirname(root)>/.manigot-worktrees/<basename(root)>) and the nested\n// (mount-point) layout (<root>/.manigot-worktrees). Both are scanned because\n// the layout is decided per-creation, and either (or, after a migration, both)\n// can hold leftover worktrees.\nfunc worktreeParents(root string) []string {\n\treturn []string{\n\t\tfilepath.Join(filepath.Dir(root), \".manigot-worktrees\", filepath.Base(root)),\n\t\tfilepath.Join(root, \".manigot-worktrees\"),\n\t}\n}\n\n// DiscoverOrphans scans the project's .manigot-worktrees parents (sibling and\n// nested layouts) and returns every leftover worktree directory whose .git\n// file points to a gitdir that no longer exists.\n//\n// A directory only counts as an orphan when its .git file names a gitdir that\n// is gone. A live worktree's .git file names an existing gitdir, so it is\n// skipped; a directory with no .git file, or with a .git *directory* (a\n// standalone repository), is also skipped — the tool removes worktrees, not\n// arbitrary junk. No git invocation is involved: the scan is pure filesystem,\n// so it degrades gracefully on a non-repo or a repo with no .manigot-worktrees\n// parent at all (an empty result, not an error).\nfunc DiscoverOrphans(root string) ([]Orphan, error) {\n\tvar orphans []Orphan\n\tseen := map[string]bool{}\n\n\tfor _, parent := range worktreeParents(root) {\n\t\tentries, err := os.ReadDir(parent)\n\t\tif err != nil {\n\t\t\t// No .manigot-worktrees here — not an error.\n\t\t\tcontinue\n\t\t}\n\t\tfor _, e := range entries {\n\t\t\tif !e.IsDir() {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tdir := filepath.Join(parent, e.Name())\n\t\t\tif seen[dir] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tgitdir := readGitdir(filepath.Join(dir, \".git\"))\n\t\t\tif gitdir == \"\" {\n\t\t\t\t// No .git pointer file at all — a stray non-worktree\n\t\t\t\t// directory, or a .git *directory* (a standalone repository).","lineStart":1,"lineEnd":80,"totalLines":212,"truncated":true}},"title":"src/internal/job/orphan.go","time":{"start":1787950591517,"end":1787950591520}},"id":"prt_04a28eb96001nI7PZhdmRqwaVm","sessionID"