{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y2GE1ySzp6Kuba7oKQppLh","type":"tool_result","content":"1\t// mg serve — the listener: a long-running daemon exposing a read-only control\n2\t// API over a registry of project roots, so any surface (a web UI, a native\n3\t// GUI, a future CLI) can attach to it as a client — from localhost or from a\n4\t// VPS. This is job one of the control-plane sequence described in\n5\t// docs/web-interface.md and the listener brief: `mg serve` + project registry\n6\t// + read-only API + localhost default + audit log + serialization skeleton.\n7\t//\n8\t// The daemon is additive: the TUI stays in-process, and every existing\n9\t// command keeps working untouched. It binds to 127.0.0.1:8080 by default\n10\t// (tokenless — the machine's own user is the trust boundary, as it is for the\n11\t// CLI today); a non-loopback bind REQUIRES a bearer token (--token or\n12\t// $MG_SERVE_TOKEN) or the daemon refuses to start. TLS is the reverse proxy's\n13\t// job (Caddy/nginx), never the daemon's.\n14\tpackage main\n15\t\n16\timport (\n17\t\t\"context\"\n18\t\t\"errors\"\n19\t\t\"flag\"\n20\t\t\"fmt\"\n21\t\t\"io\"\n22\t\t\"net\"\n23\t\t\"net/http\"\n24\t\t\"os\"\n25\t\t\"os/signal\"\n26\t\t\"strconv\"\n27\t\t\"syscall\"\n28\t\t\"time\"\n29\t\n30\t\t\"github.com/lmuskalla/manigot/internal/config\"\n31\t\t\"github.com/lmuskalla/manigot/internal/serve\"\n32\t)\n33\t\n34\t// serveShutdownDrain bounds how long mg serve waits for in-flight requests to\n35\t// finish on SIGINT/SIGTERM before giving up — a hung request must never wedge\n36\t// the exit.\n37\tconst serveShutdownDrain = 10 * time.Second\n38\t\n39\t// runServe implements `mg serve` — the listener daemon. It parses the flags,\n40\t// loads the project registry, enforces the bind/auth startup guard, then\n41\t// blocks serving until SIGINT/SIGTERM, shutting down gracefully with a\n42\t// bounded drain. Returns the process exit code.\n43\tfunc runServe(args []string, stdout, stderr io.Writer) int {\n44\t\treturn serveCommand(args, stdout, stderr, nil)\n45\t}\n46\t\n47\t// serveCommand is runServe's testable core: it differs only in the listener\n48\t// source. When ln is non-nil it serves on that already-bound listener (tests\n49\t// hand over a bound 127.0.0.1:0 listener); when nil it binds one itself from\n50\t// the --addr/--port flags. Signal handling and the graceful shutdown path are\n51\t// identical in both shapes.\n52\tfunc serveCommand(args []string, stdout, stderr io.Writer, ln net.Listener) int {\n53\t\tfs := flag.NewFlagSet(\"mg serve\", flag.ContinueOnError)\n54\t\tfs.SetOutput(stderr)\n55\t\taddr := fs.String(\"addr\", \"127.0.0.1\", \"bind host (loopback default; a non-loopback bind requires a token)\")\n56\t\tport := fs.Int(\"port\", 8080, \"bind port\")\n57\t\tregistry := fs.String(\"registry\", \"\", \"path to the project registry config (default <checkout>/config/serve.json)\")\n58\t\ttokenFlag := fs.String(\"token\", \"\", \"bearer token required on every request (default $MG_SERVE_TOKEN)\")\n59\t\tfs.Usage = func() {\n60\t\t\tfmt.Fprintf(stderr, \"mg serve %s\\n\\n\", version)\n61\t\t\tfmt.Fprintf(stderr, \"The listener: a long-running daemon exposing a read-only control API\\n\")\n62\t\t\tfmt.Fprintf(stderr, \"over a registry of project roots (the basis for the web UI / native GUI\\n\")\n63\t\t\tfmt.Fprintf(stderr, \"control-plane sequence).\\n\\n\")\n64\t\t\tfmt.Fprintf(stderr, \"Usage:\\n\")\n65\t\t\tfmt.Fprintf(stderr, \"  mg serve [flags]\\n\\n\")\n66\t\t\tfmt.Fprintf(stderr, \"The registry config file holds the named project roots the daemon serves:\\n\")\n67\t\t\tfmt.Fprintf(stderr, \"  {\\\"projects\\\": [{\\\"name\\\": \\\"my-project\\\", \\\"path\\\": \\\"/abs/project/root\\\"}, ...]}\\n\")\n68\t\t\tfmt.Fprintf(stderr, \"\\\"name\\\" is the URL segment the project is served under (a single URL-safe\\n\")\n69\t\t\tfmt.Fprintf(stderr, \"path segment, unique across the registry); it is required and chosen by you.\\n\")\n70\t\t\tfmt.Fprintf(stderr, \"Default location: <manigot checkout>/config/serve.json (override with --registry).\\n\")\n71\t\t\tfmt.Fprintf(stderr, \"Changing the registered roots means editing the file and restarting.\\n\\n\")\n72\t\t\tfmt.Fprintf(stderr, \"Flags:\\n\")\n73\t\t\tfs.PrintDefaults()\n74\t\t}\n75\t\tif err := fs.Parse(args); err != nil {\n76\t\t\treturn 2 // the flag package already printed the error + usage\n77\t\t}\n78\t\tif fs.NArg() > 0 {\n79\t\t\tfmt.Fprintf(stderr, \"Unknown argument: %s\\n\", fs.Arg(0))\n80\t\t\treturn 1\n81\t\t}\n82\t\n83\t\t// Token precedence: --token flag, then $MG_SERVE_TOKEN (config.EnvValue —\n84\t\t// the .env file first, then the process environment, exactly like every\n85\t\t// other credential the daemon reads). A token is never issued, created, or\n86\t\t// returned by the API.\n87\t\ttoken := *tokenFlag\n88\t\tif token == \"\" {\n89\t\t\ttoken = config.EnvValue(\"MG_SERVE_TOKEN\")\n90\t\t}\n91\t\n92\t\t// The project registry: an explicit config file of project roots, read\n93\t\t// once at startup. No scanning, no auto-adopting.\n94\t\tregistryPath := *registry\n95\t\tif registryPath == \"\" {\n96\t\t\tregistryPath = serve.DefaultRegistryPath()\n97\t\t\tif registryPath == \"\" {\n98\t\t\t\tcliError(stderr, serve.ErrNoRegistryPath)\n99\t\t\t\treturn 1\n100\t\t\t}\n101\t\t}\n102\t\treg, err := serve.LoadRegistry(registryPath)\n103\t\tif err != nil {\n104\t\t\tcliError(stderr, err)\n105\t\t\treturn 1\n106\t\t}\n107\t\treg.WarnMissingDocs(stderr)\n108\t\n109\t\t// The startup guard — the hard invariant: a non-loopback bind with no\n110\t\t// token refuses to start. Unskippable: there is no flag that turns it off.\n111\t\tif err := serve.ValidateStartup(*addr, token); err != nil {\n112\t\t\tcliError(stderr, err)\n113\t\t\treturn 1\n114\t\t}\n115\t\n116\t\tsrv := serve.New(reg, version, token, stderr)\n117\t\n118\t\t// Bind (or accept the test-supplied listener) and announce.\n119\t\tif ln == nil {\n120\t\t\tbindAddr := net.JoinHostPort(*addr, strconv.Itoa(*port))\n121\t\t\tln, err = net.Listen(\"tcp\", bindAddr)\n122\t\t\tif err != nil {\n123\t\t\t\tcliError(stderr, fmt.Errorf(\"mg serve: cannot listen on %s: %v\", bindAddr, err))\n124\t\t\t\treturn 1\n125\t\t\t}\n126\t\t}\n127\t\tfmt.Fprintf(stdout, \"mg serve %s — listening on %s\\n\", version, ln.Addr())\n128\t\tif token != \"\" {\n129\t\t\tfmt.Fprintln(stdout, \"Bearer-token auth enabled — every request must carry Authorization: Bearer <token>.\")\n130\t\t\tfmt.Fprintln(stdout, \"TLS is the reverse proxy's job (Caddy/nginx); the daemon always serves plain HTTP.\")\n131\t\t} else {\n132\t\t\tfmt.Fprintln(stdout, \"No token configured — tokenless mode (safe only on a loopback bind).\")\n133\t\t}\n134\t\tif len(reg.Projects()) == 0 {\n135\t\t\tfmt.Fprintln(stdout, \"Warning: no projects registered — edit the registry config and restart to serve any.\")\n136\t\t}\n137\t\n138\t\t// Serve until SIGINT/SIGTERM, then drain in-flight requests within a\n139\t\t// bounded window and exit cleanly.\n140\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n141\t\tdefer stop()\n142\t\n143\t\terrCh := make(chan error, 1)\n144\t\tgo func() { errCh <- srv.Serve(ln) }()\n145\t\n146\t\tselect {\n147\t\tcase err := <-errCh:\n148\t\t\tif err != nil && !errors.Is(err, http.ErrServerClosed) {\n149\t\t\t\tcliError(stderr, fmt.Errorf(\"mg serve: %v\", err))\n150\t\t\t\treturn 1\n151\t\t\t}\n152\t\t\treturn 0\n153\t\tcase <-ctx.Done():\n154\t\t\tdrainCtx, cancel := context.WithTimeout(context.Background(), serveShutdownDrain)\n155\t\t\tdefer cancel()\n156\t\t\tif err := srv.Shutdown(drainCtx); err != nil {\n157\t\t\t\tcliError(stderr, fmt.Errorf(\"mg serve: graceful shutdown: %v\", err))\n158\t\t\t\treturn 1\n159\t\t\t}\n160\t\t\t<-errCh // the serve loop returns http.ErrServerClosed\n161\t\t\tfmt.Fprintln(stdout, \"mg serve: shutting down.\")\n162\t\t\treturn 0\n163\t\t}\n164\t}\n165\t"}]},"parent_tool_use_id":null,"session_id":"ba948ea7-a157-4c42-8eb1-077540d9946d","uuid":"3532d322-1ef3-4f59-aa9c-bf2600718a26","timestamp":"2026-08-28T20:29:06.388Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/cmd/mg/serve.go","content":"// mg serve — the listener: a long-running daemon exposing a read-only control\n// API over a registry of project roots, so any surface (a web UI, a native\n// GUI, a future CLI) can attach to it as a client — from localhost or from a\n// VPS. This is job one of the control-plane sequence described in\n// docs/web-interface.md and the listener brief: `mg serve` + project registry\n// + read-only API + localhost default + audit log + serialization skeleton.\n//\n// The daemon is additive: the TUI stays in-process, and every existing\n// command keeps working untouched. It binds to 127.0.0.1:8080 by default\n// (tokenless — the machine's own user is the trust boundary, as it is for the\n// CLI today); a non-loopback bind REQUIRES a bearer token (--token or\n// $MG_SERVE_TOKEN) or the daemon refuses to start. TLS is the reverse proxy's\n// job (Caddy/nginx), never the daemon's.\npackage main\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"net\"\n\t\"net/http\"\n\t\"os\"\n\t\"os/signal\"\n\t\"strconv\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/serve\"\n)\n\n// serveShutdownDrain bounds how long mg serve waits for in-flight requests to\n// finish on SIGINT/SIGTERM before giving up — a hung request must never wedge\n// the exit.\nconst serveShutdownDrain = 10 * time.Second\n\n// runServe implements `mg serve` — the listener daemon. It parses the flags,\n// loads the project registry, enforces the bind/auth startup guard, then\n// blocks serving until SIGINT/SIGTERM, shutting down gracefully with a\n// bounded drain. Returns the process exit code.\nfunc runServe(args []string, stdout, stderr io.Writer) int {\n\treturn serveCommand(args, stdout, stderr, nil)\n}\n\n// serveCommand is runServe's testable core: it differs only in the listener\n// source. When ln is non-nil it serves on that already-bound listener (tests\n// hand over a bound 127.0.0.1:0 listener); when nil it binds one itself from\n// the --addr/--port flags. Signal handling and the graceful shutdown path are\n// identical in both shapes.\nfunc serveCommand(args []string, stdout, stderr io.Writer, ln net.Listener) int {\n\tfs := flag.NewFlagSet(\"mg serve\", flag.ContinueOnError)\n\tfs.SetOutput(stderr)\n\taddr := fs.String(\"addr\", \"127.0.0.1\", \"bind host (loopback default; a non-loopback bind requires a token)\")\n\tport := fs.Int(\"port\", 8080, \"bind port\")\n\tregistry := fs.String(\"registry\", \"\", \"path to the project registry config (default <checkout>/config/serve.json)\")\n\ttokenFlag := fs.String(\"token\", \"\", \"bearer token required on every request (default $MG_SERVE_TOKEN)\")\n\tfs.Usage = func() {\n\t\tfmt.Fprintf(stderr, \"mg serve %s\\n\\n\", version)\n\t\tfmt.Fprintf(stderr, \"The listener: a long-running daemon exposing a read-only control API\\n\")\n\t\tfmt.Fprintf(stderr, \"over a registry of project roots (the basis for the web UI / native GUI\\n\")\n\t\tfmt.Fprintf(stderr, \"control-plane sequence).\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"Usage:\\n\")\n\t\tfmt.Fprintf(stderr, \"  mg serve [flags]\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"The registry config file holds the named project roots the daemon serves:\\n\")\n\t\tfmt.Fprintf(stderr, \"  {\\\"projects\\\": [{\\\"name\\\": \\\"my-project\\\", \\\"path\\\": \\\"/abs/project/root\\\"}, ...]}\\n\")\n\t\tfmt.Fprintf(stderr, \"\\\"name\\\" is the URL segment the project is served under (a single URL-safe\\n\")\n\t\tfmt.Fprintf(stderr, \"path segment, unique across the registry); it is required and chosen by you.\\n\")\n\t\tfmt.Fprintf(stderr, \"Default location: <manigot checkout>/config/serve.json (override with --registry).\\n\")\n\t\tfmt.Fprintf(stderr, \"Changing the registered roots means editing the file and restarting.\\n\\n\")\n\t\tfmt.Fprintf(stderr, \"Flags:\\n\")\n\t\tfs.PrintDefaults()\n\t}\n\tif err := fs.Parse(args); err != nil {\n\t\treturn 2 // the flag package already printed the error + usage\n\t}\n\tif fs.NArg() > 0 {\n\t\tfmt.Fprintf(stderr, \"Unknown argument: %s\\n\", fs.Arg(0))\n\t\treturn 1\n\t}\n\n\t// Token precedence: --token flag, then $MG_SERVE_TOKEN (config.EnvValue —\n\t// the .env file first, then the process environment, exactly like every\n\t// other credential the daemon reads). A token is never issued, created, or\n\t// returned by the API.\n\ttoken := *tokenFlag\n\tif token == \"\" {\n\t\ttoken = config.EnvValue(\"MG_SERVE_TOKEN\")\n\t}\n\n\t// The project registry: an explicit config file of project roots, read\n\t// once at startup. No scanning, no auto-adopting.\n\tregistryPath := *registry\n\tif registryPath == \"\" {\n\t\tregistryPath = serve.DefaultRegistryPath()\n\t\tif registryPath == \"\" {\n\t\t\tcliError(stderr, serve.ErrNoRegistryPath)\n\t\t\treturn 1\n\t\t}\n\t}\n\treg, err := serve.LoadRegistry(registryPath)\n\tif err != nil {\n\t\tcliError(stderr, err)\n\t\treturn 1\n\t}\n\treg.WarnMissingDocs(stderr)\n\n\t// The startup guard — the hard invariant: a non-loopback bind with no\n\t// token refuses to start. Unskippable: there is no flag that turns it off.\n\tif err := serve.ValidateStartup(*addr, token); err != nil {\n\t\tcliError(stderr, err)\n\t\treturn 1\n\t}\n\n\tsrv := serve.New(reg, version, token, stderr)\n\n\t// Bind (or accept the test-supplied listener) and announce.\n\tif ln == nil {\n\t\tbindAddr := net.JoinHostPort(*addr, strconv.Itoa(*port))\n\t\tln, err = net.Listen(\"tcp\", bindAddr)\n\t\tif err != nil {\n\t\t\tcliError(stderr, fmt.Errorf(\"mg serve: cannot listen on %s: %v\", bindAddr, err))\n\t\t\treturn 1\n\t\t}\n\t}\n\tfmt.Fprintf(stdout, \"mg serve %s — listening on %s\\n\", version, ln.Addr())\n\tif token != \"\" {\n\t\tfmt.Fprintln(stdout, \"Bearer-token auth enabled — every request must carry Authorization: Bearer <token>.\")\n\t\tfmt.Fprintln(stdout, \"TLS is the reverse proxy's job (Caddy/nginx); the daemon always serves plain HTTP.\")\n\t} else {\n\t\tfmt.Fprintln(stdout, \"No token configured — tokenless mode (safe only on a loopback bind).\")\n\t}\n\tif len(reg.Projects()) == 0 {\n\t\tfmt.Fprintln(stdout, \"Warning: no projects registered — edit the registry config and restart to serve any.\")\n\t}\n\n\t// Serve until SIGINT/SIGTERM, then drain in-flight requests within a\n\t// bounded window and exit cleanly.\n\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n\tdefer stop()\n\n\terrCh := make(chan error, 1)\n\tgo func() { errCh <- srv.Serve(ln) }()\n\n\tselect {\n\tcase err := <-errCh:\n\t\tif err != nil && !errors.Is(err, http.ErrServerClosed) {\n\t\t\tcliError(stderr, fmt.Errorf(\"mg serve: %v\", err))\n\t\t\treturn 1\n\t\t}\n\t\treturn 0\n\tcase <-ctx.Done():\n\t\tdrainCtx, cancel := context.WithTimeout(context.Background(), serveShutdownDrain)\n\t\tdefer cancel()\n\t\tif err := srv.Shutdown(drainCtx); err != nil {\n\t\t\tcliError(stderr, fmt.Errorf(\"mg serve: graceful shutdown: %v\", err))\n\t\t\treturn 1\n\t\t}\n\t\t<-errCh // the serve loop returns http.ErrServerClosed\n\t\tfmt.Fprintln(stdout, \"mg serve: shutting down.\")\n\t\treturn 0\n\t}\n}\n","numLines":165,"startLine":1,"totalLines":165}}}
