\nhost_test.go\noneshot.go\noneshot_test.go\nprune.go\nprune_test.go\nroot.go\nroot_test.go\nsession.go\nsession_test.go\nskillconv.go\nskillconv_test.go\nsweep.go\nsweep_test.go\n===\n/usr/bin/bash: line 1: rg: command not found\n","exit":0,"truncated":false},"title":"ls src/internal/serve/ src/internal/session/ src/internal/job/ | head -80 && echo === && rg -n \"stream|SSE|session-log\" src/internal/serve/server.go | head -20","time":{"start":1787949741956,"end":1787949741957}},"id":"prt_04a1bf77b001fsxbhVYTmLsVfm","sessionID":"ses_fb5e46073ffeurLEsOhSb1UBJi","messageID":"msg_04a1bd99400136rJka36GKQ41b"}}
