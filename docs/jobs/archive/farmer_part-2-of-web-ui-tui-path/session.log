{"type":"tool_use","timestamp":1787950711714,"sessionID":"ses_fb5dcd7a6ffeSGBPKFVeVpziRm","part":{"type":"tool","tool":"read","callID":"call_b4cba4c60c0f42a59c8a9724","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/job/delete.go"},"output":"<path>/workspace/src/internal/job/delete.go</path>\n<type>file</type>\n<content>\n1: package job\n2: \n3: import (\n4: \t\"errors\"\n5: \t\"fmt\"\n6: \t\"io\"\n7: \t\"os\"\n8: \t\"path/filepath\"\n9: \t\"strings\"\n10: \n11: \t\"github.com/lmuskalla/manigot/internal/fs\"\n12: \t\"github.com/lmuskalla/manigot/internal/git\"\n13: \t\"github.com/lmuskalla/manigot/internal/project\"\n14: )\n15: \n16: // DeleteResult is the outcome of a successful DeleteJob.\n17: type DeleteResult struct {\n18: \t// JobName is the job's directory name (the id_slug).\n19: \tJobName string\n20: \n21: \t// Branch is the deleted job branch (\"\" for a non-git project, which has\n22: \t// no branch).\n23: \tBranch string\n24: \n25: \t// Dir is the removed job directory.\n26: \tDir string\n27: }\n28: \n29: // DeleteJob ports scripts/delete-job.sh — the permanent job deletion lifecycle:\n30: // resolve the job (branch + worktree for a git project, a plain docs/jobs\n31: // directory otherwise), show the script's confirmation (with the dirty-worktree\n32: // warning wording), then remove the worktree (--force) and force-delete the\n33: // branch, and finally remove the job's mg-jdi status sidecar (best-effort —\n34: // the deletion itself has already succeeded by then). A non-git project is a\n35: // plain directory delete.\n36: //\n37: // root is the project root, resolved by the caller (the CLI's docs-walk-up,\n38: // or the TUI's a.root). confirm answers the script's `read -rp` prompts (a\n39: // declined answer returns ErrCancelled, the script's `exit 0`);\n40: // informational output goes to out.\n41: func DeleteJob(root, jobArg string, confirm ConfirmFunc, out io.Writer) (DeleteResult, error) {\n42: \n43: \t// ── Non-git project: plain directory delete, no git involved ──────────\n44: \tif _, err := git.LocalBranches(root); err != nil {\n45: \t\tif errors.Is(err, git.ErrNotARepo) {\n46: \t\t\treturn deleteNonGit(root, jobArg, confirm, out)\n47: \t\t}\n48: \t\treturn DeleteResult{}, err\n49: \t}\n50: \n51: \t// ── Resolve the job's branch + worktree ────────────────────────────────\n52: \tbranches, berr := git.LocalBranches(root)\n53: \tif berr != nil {\n54: \t\treturn DeleteResult{}, berr\n55: \t}\n56: \tbranch := git.ExactBranchMatch(branches, jobArg)\n57: \tif branch == \"\" {\n58: \t\tprefixMatches := git.PrefixBranchMatches(branches, jobArg)\n59: \t\tswitch len(prefixMatches) {\n60: \t\tcase 0:\n61: \t\t\treturn DeleteResult{}, jobNotFoundError(jobArg, branches)\n62: \t\tcase 1:\n63: \t\t\tbranch = prefixMatches[0]\n64: \t\tdefault:\n65: \t\t\treturn DeleteResult{}, fmt.Errorf(\"job '%s' is ambiguous — matches branches: %s\", jobArg, strings.Join(prefixMatches, \" \"))\n66: \t\t}\n67: \t}\n68: \tjobName := git.BranchTail(branch)\n69: \n70: \twtPath, ok, werr := git.WorktreeForBranch(root, branch)\n71: \tif werr != nil {\n72: \t\treturn DeleteResult{}, werr\n73: \t}\n74: \tif !ok {\n75: \t\treturn DeleteResult{}, fmt.Errorf(\"branch '%s' has no git worktree — cannot delete job '%s'.\\nA job's worktree is created by 'mg job' and should always exist for an open job; this is an inconsistent state.\", branch, jobName)\n76: \t}\n77: \n78: \tjobDir := filepath.Join(wtPath, JobsRelDir, jobName)\n79: \tjobTitle := briefTitle(filepath.Join(jobDir, \"brief.md\"))\n80: \n81: \t// Is the resolved worktree the main worktree itself? Needed for the\n82: \t// confirmation wording and to decide whether worktree removal is even\n83: \t// possible (the main worktree cannot be removed).\n84: \tmainWorktree, terr := git.RevParseToplevel(root)\n85: \tif terr != nil {\n86: \t\tmainWorktree = root\n87: \t}\n88: \tmainWorktreeCase := filepath.Clean(wtPath) == filepath.Clean(mainWorktree)\n89: \n90: \t// A delete discards the worktree wholesale — surface a dirty tree in the\n91: \t// confirmation rather than erroring (unlike mg done, there is no \"commit\n92: \t// first\" requirement for a delete).\n93: \tdirty, derr := git.WorkingTreeDirty(wtPath)\n94: \tif derr != nil {\n95: \t\treturn DeleteResult{}, derr\n96: \t}\n97: \n98: \t// ── Confirm ────────────────────────────────────────────────────────────\n99: \tfmt.Fprintln(out, \"\")\n100: \tfmt.Fprintf(out, \"This will permanently delete job: %s\\n\", jobName)\n101: \tfmt.Fprintf(out, \"  Title    : %s\\n\", titleOrName(jobTitle, jobName))\n102: \tfmt.Fprintf(out, \"  Worktree : %s\\n\", wtPath)\n103: \tfmt.Fprintf(out, \"  Branch   : %s (will be deleted, unmerged)\\n\", branch)\n104: \tif dirty {\n105: \t\tif mainWorktreeCase {\n106: \t\t\tfmt.Fprintln(out, \"  Warning  : the main worktree has uncommitted changes — the switch off \"+branch+\" will carry\")\n107: \t\t\tfmt.Fprintln(out, \"             them onto the default branch if they don't conflict, or abort (deleting nothing).\")\n108: \t\t} else {\n109: \t\t\tfmt.Fprintln(out, \"  Warning  : this worktree has uncommitted changes — they will be discarded.\")\n110: \t\t}\n111: \t}\n112: \tfmt.Fprintln(out, \"\")\n113: \tfmt.Fprintln(out, \"This cannot be undone.\")\n114: \tif err := askConfirm(confirm, out, \"  Proceed? [y/N] \"); err != nil {\n115: \t\treturn DeleteResult{}, err\n116: \t}\n117: \n118: \t// ── Resolve the base branch the main worktree is switched onto ─────────\n119: \tsettings, err := project.Load(root)\n120: \tif err != nil {\n121: \t\treturn DeleteResult{}, err\n122: \t}\n123: \tbaseBranch := settings.BaseBranch\n124: \tif baseBranch == \"\" {\n125: \t\tbaseBranch = git.SymbolicRefHead(root)\n126: \t}\n127: \n128: \t// The main worktree must not sit on the branch being deleted — switching\n129: \t// it off is what makes the branch deletable (and is exactly the\n130: \t// pre-worktree-job case, where there is no separate worktree to remove).\n131: \tcurrentMain, cerr := git.CurrentBranch(root)\n132: \tif cerr != nil {\n133: \t\treturn DeleteResult{}, cerr\n134: \t}\n135: \tif currentMain == branch {\n136: \t\tfmt.Fprintln(out, \"\")\n137: \t\tfmt.Fprintf(out, \"→ Switching the main worktree off %s...\\n\", branch)\n138: \t\tif err := git.Checkout(root, baseBranch); err != nil {\n139: \t\t\treturn DeleteResult{}, err\n140: \t\t}\n141: \t}\n142: \n143: \t// ── Remove the worktree, then delete the branch ────────────────────────\n144: \tif mainWorktreeCase {\n145: \t\tfmt.Fprintln(out, \"\")\n146: \t\tfmt.Fprintln(out, \"→ Job's worktree is the main worktree — skipping worktree removal.\")\n147: \t} else {\n148: \t\tfmt.Fprintln(out, \"\")\n149: \t\tfmt.Fprintf(out, \"→ Removing worktree %s (and everything committed on %s)...\\n\", wtPath, branch)\n150: \t\tif err := git.WorktreeRemoveForce(root, wtPath); err != nil {\n151: \t\t\treturn DeleteResult{}, err\n152: \t\t}\n153: \t\t_ = git.WorktreePrune(root)\n154: \t}\n155: \n156: \tfmt.Fprintf(out, \"→ Deleting branch %s...\\n\", branch)\n157: \tif err := git.BranchDelete(root, branch); err != nil {\n158: \t\treturn DeleteResult{}, err\n159: \t}\n160: \n161: \t// Clean up after mg-jdi too: the job is gone, so its status/run.log\n162: \t// sidecar is dead weight. Best-effort — the deletion itself already\n163: \t// succeeded, so a failure here is a warning, not an abort.\n164: \tif removed, err := RemoveJDIStatus(root, jobName); err != nil {\n165: \t\tfmt.Fprintf(out, \"  Warning: could not remove mg-jdi status for %s: %v\\n\", jobName, err)\n166: \t} else if removed {\n167: \t\tfmt.Fprintf(out, \"→ Removing mg-jdi status for %s...\\n\", jobName)\n168: \t}\n169: \n170: \tfmt.Fprintln(out, \"\")\n171: \tfmt.Fprintf(out, \"✓ Job deleted: %s\\n\", jobName)\n172: \tfmt.Fprintf(out, \"  Branch removed: %s\\n\", branch)\n173: \treturn DeleteResult{JobName: jobName, Branch: branch, Dir: jobDir}, nil\n174: }\n175: \n176: // deleteNonGit handles the non-git project path: resolve the job directory\n177: // (exact then prefix, excluding archive/), confirm, and remove it — a plain\n178: // directory delete, no git involved.\n179: func deleteNonGit(root, jobArg string, confirm ConfirmFunc, out io.Writer) (DeleteResult, error) {\n180: \tvar jobDir, jobName string\n181: \tif fs.IsDir(filepath.Join(root, JobsRelDir, jobArg)) {\n182: \t\tjobDir = filepath.Join(root, JobsRelDir, jobArg)\n183: \t\tjobName = jobArg\n184: \t} else {\n185: \t\tmatch := PrefixJobDirName(root, jobArg)\n186: \t\tif match == \"\" {\n187: \t\t\treturn DeleteResult{}, &jobNotFoundErr{msg: fmt.Sprintf(\"job '%s' not found under %s/\", jobArg, JobsRelDir)}\n188: \t\t}\n189: \t\tjobDir = filepath.Join(root, JobsRelDir, match)\n190: \t\tjobName = match\n191: \t}\n192: \n193: \tjobTitle := briefTitle(filepath.Join(jobDir, \"brief.md\"))\n194: \tfmt.Fprintln(out, \"\")\n195: \tfmt.Fprintf(out, \"This will permanently delete job: %s\\n\", jobName)\n196: \tfmt.Fprintf(out, \"  Title  : %s\\n\", titleOrName(jobTitle, jobName))\n197: \tfmt.Fprintf(out, \"  Dir    : %s/%s\\n\", JobsRelDir, jobName)\n198: \tfmt.Fprintln(out, \"\")\n199: \tfmt.Fprintln(out, \"This cannot be undone.\")\n200: \tif err := askConfirm(confirm, out, \"  Proceed? [y/N] \"); err != nil {\n201: \t\treturn DeleteResult{}, err\n202: \t}\n203: \tfmt.Fprintln(out, \"\")\n204: \tfmt.Fprintf(out, \"→ Removing %s/%s...\\n\", JobsRelDir, jobName)\n205: \tif err := os.RemoveAll(jobDir); err != nil {\n206: \t\treturn DeleteResult{}, err\n207: \t}\n208: \t// Same best-effort sidecar cleanup as the git path above.\n209: \tif removed, err := RemoveJDIStatus(root, jobName); err != nil {\n210: \t\tfmt.Fprintf(out, \"  Warning: could not remove mg-jdi status for %s: %v\\n\", jobName, err)\n211: \t} else if removed {\n212: \t\tfmt.Fprintf(out, \"→ Removing mg-jdi status for %s...\\n\", jobName)\n213: \t}\n214: \tfmt.Fprintln(out, \"\")\n215: \tfmt.Fprintf(out, \"✓ Job deleted: %s\\n\", jobName)\n216: \treturn DeleteResult{JobName: jobName, Dir: jobDir}, nil\n217: }\n218: \n219: // titleOrName returns title when non-empty, else name — the script's\n220: // `${JOB_TITLE:-$JOB_NAME}` default.\n221: func titleOrName(title, name string) string {\n222: \tif title == \"\" {\n223: \t\treturn name\n224: \t}\n225: \treturn title\n226: }\n\n(End of file - total 226 lines)\n</content>","metadata":{"preview":"package job\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/fs\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// DeleteResult is the outcome of a successful DeleteJob.\ntype DeleteResult struct {\n\t// JobName is the job's directory name (the id_slug).\n\tJobName string\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/job/delete.go","text":"package job\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/fs\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// DeleteResult is the outcome of a successful DeleteJob.\ntype DeleteResult struct {\n\t// JobName is the job's directory name (the id_slug).\n\tJobName string\n\n\t// Branch is the deleted job branch (\"\" for a non-git project, which has\n\t// no branch).\n\tBranch string\n\n\t// Dir is the removed job directory.\n\tDir string\n}\n\n// DeleteJob ports scripts/delete-job.sh — the permanent job deletion lifecycle:\n// resolve the job (branch + worktree for a git project, a plain docs/jobs\n// directory otherwise), show the script's confirmation (with the dirty-worktree\n// warning wording), then remove the worktree (--force) and force-delete the\n// branch, and finally remove the job's mg-jdi status sidecar (best-effort —\n// the deletion itself has already succeeded by then). A non-git project is a\n// plain directory delete.\n//\n// root is the project root, resolved by the caller (the CLI's docs-walk-up,\n// or the TUI's a.root). confirm answers the script's `read -rp` prompts (a\n// declined answer returns ErrCancelled, the script's `exit 0`);\n// informational output goes to out.\nfunc DeleteJob(root, jobArg string, confirm ConfirmFunc, out io.Writer) (DeleteResult, error) {\n\n\t// ── Non-git project: plain directory delete, no git involved ──────────\n\tif _, err := git.LocalBranches(root); err != nil {\n\t\tif errors.Is(err, git.ErrNotARepo) {\n\t\t\treturn deleteNonGit(root, jobArg, confirm, out)\n\t\t}\n\t\treturn DeleteResult{}, err\n\t}\n\n\t// ── Resolve the job's branch + worktree ────────────────────────────────\n\tbranches, berr := git.LocalBranches(root)\n\tif berr != nil {\n\t\treturn DeleteResult{}, berr\n\t}\n\tbranch := git.ExactBranchMatch(branches, jobArg)\n\tif branch == \"\" {\n\t\tprefixMatches := git.PrefixBranchMatches(branches, jobArg)\n\t\tswitch len(prefixMatches) {\n\t\tcase 0:\n\t\t\treturn DeleteResult{}, jobNotFoundError(jobArg, branches)\n\t\tcase 1:\n\t\t\tbranch = prefixMatches[0]\n\t\tdefault:\n\t\t\treturn DeleteResult{}, fmt.Errorf(\"job '%s' is ambiguous — matches branches: %s\", jobArg, strings.Join(prefixMatches, \" \"))\n\t\t}\n\t}\n\tjobName := git.BranchTail(branch)\n\n\twtPath, ok, werr := git.WorktreeForBranch(root, branch)\n\tif werr != nil {\n\t\treturn DeleteResult{}, werr\n\t}\n\tif !ok {\n\t\treturn DeleteResult{}, fmt.Errorf(\"branch '%s' has no git worktree — cannot delete job '%s'.\\nA job's worktree is created by 'mg job' and should always exist for an open job; this is an inconsistent state.\", branch, jobName)\n\t}\n\n\tjobDir := filepath.Join(wtPath, JobsRelDir, jobName)\n\tjobTitle := briefTitle(filepath.Join(jobDir, \"brief.md\"))\n\n\t// Is the resolved worktree the main worktree itself? Needed for the\n\t// confirmation wording and to decide whether worktree removal is even\n\t// possible (the main worktree cannot be removed).\n\tmainWorktree, terr := git.RevParseToplevel(root)\n\tif terr != nil {\n\t\tmainWorktree = root\n\t}\n\tmainWorktreeCase := filepath.Clean(wtPath) == filepath.Clean(mainWorktree)\n\n\t// A delete discards the worktree wholesale — surface a dirty tree in the\n\t// confirmation rather than erroring (unlike mg done, there is no \"commit\n\t// first\" requirement for a delete).\n\tdirty, derr := git.WorkingTreeDirty(wtPath)\n\tif derr != nil {\n\t\treturn DeleteResult{}, derr\n\t}\n\n\t// ── Confirm ────────────────────────────────────────────────────────────\n\tfmt.Fprintln(out, \"\")\n\tfmt.Fprintf(out, \"This will permanently delete job: %s\\n\", jobName)\n\tfmt.Fprintf(out, \"  Title    : %s\\n\", titleOrName(jobTitle, jobName))\n\tfmt.Fprintf(out, \"  Worktree : %s\\n\", wtPath)\n\tfmt.Fprintf(out, \"  Branch   : %s (will be deleted, unmerged)\\n\", branch)\n\tif dirty {\n\t\tif mainWorktreeCase {\n\t\t\tfmt.Fprintln(out, \"  Warning  : the main worktree has uncommitted changes — the switch off \"+branch+\" will carry\")\n\t\t\tfmt.Fprintln(out, \"             them onto the default branch if they don't conflict, or abort (deleting nothing).\")\n\t\t} else {\n\t\t\tfmt.Fprintln(out, \"  Warning  : this worktree has uncommitted changes — they will be discarded.\")\n\t\t}\n\t}\n\tfmt.Fprintln(out, \"\")\n\tfmt.Fprintln(out, \"This cannot be undone.\")\n\tif err := askConfirm(confirm, out, \"  Proceed? [y/N] \"); err != nil {\n\t\treturn DeleteResult{}, err\n\t}\n\n\t// ── Resolve the base branch the main worktree is switched onto ─────────\n\tsettings, err := project.Load(root)\n\tif err != nil {\n\t\treturn DeleteResult{}, err\n\t}\n\tbaseBranch := settings.BaseBranch\n\tif baseBranch == \"\" {\n\t\tbaseBranch = git.SymbolicRefHead(root)\n\t}\n\n\t// The main worktree must not sit on the branch being deleted — switching\n\t// it off is what makes the branch deletable (and is exactly the\n\t// pre-worktree-job case, where there is no separate worktree to remove).\n\tcurrentMain, cerr := git.CurrentBranch(root)\n\tif cerr != nil {\n\t\treturn DeleteResult{}, cerr\n\t}\n\tif currentMain == branch {\n\t\tfmt.Fprintln(out, \"\")\n\t\tfmt.Fprintf(out, \"→ Switching the main worktree off %s...\\n\", branch)\n\t\tif err := git.Checkout(root, baseBranch); err != nil {\n\t\t\treturn DeleteResult{}, err\n\t\t}\n\t}\n\n\t// ── Remove the worktree, then delete the branch ────────────────────────\n\tif mainWorktreeCase {\n\t\tfmt.Fprintln(out, \"\")\n\t\tfmt.Fprintln(out, \"→ Job's worktree is the main worktree — skipping worktree removal.\")\n\t} else {\n\t\tfmt.Fprintln(out, \"\")\n\t\tfmt.Fprintf(out, \"→ Removing worktree %s (and everything committed on %s)...\\n\", wtPath, branch)\n\t\tif err := git.WorktreeRemoveForce(root, wtPath); err != nil {\n\t\t\treturn DeleteResult{}, err\n\t\t}\n\t\t_ = git.WorktreePrune(root)\n\t}\n\n\tfmt.Fprintf(out, \"→ Deleting branch %s...\\n\", branch)\n\tif err := git.BranchDelete(root, branch); err != nil {\n\t\treturn DeleteResult{}, err\n\t}\n\n\t// Clean up after mg-jdi too: the job is gone, so its status/run.log\n\t// sidecar is dead weight. Best-effort — the deletion itself already\n\t// succeeded, so a failure here is a warning, not an abort.\n\tif removed, err := RemoveJDIStatus(root, jobName); err != nil {\n\t\tfmt.Fprintf(out, \"  Warning: could not remove mg-jdi status for %s: %v\\n\", jobName, err)\n\t} else if removed {\n\t\tfmt.Fprintf(out, \"→ Removing mg-jdi status for %s...\\n\", jobName)\n\t}\n\n\tfmt.Fprintln(out, \"\")\n\tfmt.Fprintf(out, \"✓ Job deleted: %s\\n\", jobName)\n\tfmt.Fprintf(out, \"  Branch removed: %s\\n\", branch)\n\treturn DeleteResult{JobName: jobName, Branch: branch, Dir: jobDir}, nil\n}\n\n// deleteNonGit handles the non-git project path: resolve the job directory\n// (exact then prefix, excluding archive/), confirm, and remove it — a plain\n// directory delete, no git involved.\nfunc deleteNonGit(root, jobArg string, confirm ConfirmFunc, out io.Writer) (DeleteResult, error) {\n\tvar jobDir, jobName string\n\tif fs.IsDir(filepath.Join(root, JobsRelDir, jobArg)) {\n\t\tjobDir = filepath.Join(root, JobsRelDir, jobArg)\n\t\tjobName = jobArg\n\t} else {\n\t\tmatch := PrefixJobDirName(root, jobArg)\n\t\tif match == \"\" {\n\t\t\treturn DeleteResult{}, &jobNotFoundErr{msg: fmt.Sprintf(\"job '%s' not found under %s/\", jobArg, JobsRelDir)}\n\t\t}\n\t\tjobDir = filepath.Join(root, JobsRelDir, match)\n\t\tjobName = match\n\t}\n\n\tjobTitle := briefTitle(filepath.Join(jobDir, \"brief.md\"))\n\tfmt.Fprintln(out, \"\")\n\tfmt.Fprintf(out, \"This will permanently delete job: %s\\n\", jobName)\n\tfmt.Fprintf(out, \"  Title  : %s\\n\", titleOrName(jobTitle, jobName))\n\tfmt.Fprintf(out, \"  Dir    : %s/%s\\n\", JobsRelDir, jobName)\n\tfmt.Fprintln(out, \"\")\n\tfmt.Fprintln(out, \"This cannot be undone.\")\n\tif err := askConfirm(confirm, out, \"  Proceed? [y/N] \"); err != nil {\n\t\treturn DeleteResult{}, err\n\t}\n\tfmt.Fprintln(out, \"\")\n\tfmt.Fprintf(out, \"→ Removing %s/%s...\\n\", JobsRelDir, jobName)\n\tif err := os.RemoveAll(jobDir); err != nil {\n\t\treturn DeleteResult{}, err\n\t}\n\t// Same best-effort sidecar cleanup as the git path above.\n\tif removed, err := RemoveJDIStatus(root, jobName); err != nil {\n\t\tfmt.Fprintf(out, \"  Warning: could not remove mg-jdi status for %s: %v\\n\", jobName, err)\n\t} else if removed {\n\t\tfmt.Fprintf(out, \"→ Removing mg-jdi status for %s...\\n\", jobName)\n\t}\n\tfmt.Fprintln(out, \"\")\n\tfmt.Fprintf(out, \"✓ Job deleted: %s\\n\", jobName)\n\treturn DeleteResult{JobName: jobName, Dir: jobDir}, nil\n}\n\n// titleOrName returns title when non-empty, else name — the script's\n// `${JOB_TITLE:-$JOB_NAME}` default.\nfunc titleOrName(title, name string) string {\n\tif title == \"\" {\n\t\treturn name\n\t}\n\treturn title\n}","lineStart":1,"lineEnd":226,"totalLines":226,"truncated":false}},"title":"src/internal/job/delete.go","time":{"start":1787950711709,"end":1787950711712}},"id":"prt_04a2ac356001u08JgwtW2SplYg","sessionID":"ses_fb5dcd7a6ffeSGBPKFVeVpziRm","messageID":"msg_04a2a26b3001GxoRxW6GYW08H1"}}
{"type":"tool_use","timestamp":1787950711865,"sessionID":"ses_fb5dcd7a6ffeSGBPKFVeVpziRm","part":{"type":"tool","tool":"read","callID":"call_5521bf7b7fb04e00b78a6d1b","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/job/orphan.go","offset":80},"output":"<path>/workspace/src/internal/job/orphan.go</path>\n<type>file</type>\n<content>\n80: \t\t\t\t// directory, or a .git *directory* (a standalone repository).\n81: \t\t\t\t// Neither is a linked worktree; never report or touch it.\n82: \t\t\t\tcontinue\n83: \t\t\t}\n84: \t\t\t// A .git file naming a gitdir that still exists → a live worktree\n85: \t\t\t// (registered or not), not an orphan.\n86: \t\t\tif _, err := os.Stat(gitdir); err == nil {\n87: \t\t\t\tcontinue\n88: \t\t\t}\n89: \t\t\tseen[dir] = true\n90: \t\t\torphans = append(orphans, Orphan{Name: e.Name(), Dir: dir, GitDir: gitdir})\n91: \t\t}\n92: \t}\n93: \n94: \tsort.Slice(orphans, func(i, j int) bool { return orphans[i].Name < orphans[j].Name })\n95: \treturn orphans, nil\n96: }\n97: \n98: // readGitdir parses a worktree's .git pointer file (\"gitdir: <path>\", the\n99: // format git worktree add writes) and returns the gitdir path it names, \"\" for\n100: // a file that is not such a pointer (including a .git *directory*, which has a\n101: // different shape and is never a worktree pointer).\n102: func readGitdir(dotgit string) string {\n103: \tfi, err := os.Stat(dotgit)\n104: \tif err != nil || fi.IsDir() {\n105: \t\treturn \"\"\n106: \t}\n107: \tdata, err := os.ReadFile(dotgit)\n108: \tif err != nil {\n109: \t\treturn \"\"\n110: \t}\n111: \tline := strings.TrimSpace(string(data))\n112: \tif !strings.HasPrefix(line, \"gitdir:\") {\n113: \t\treturn \"\"\n114: \t}\n115: \tpath := strings.TrimSpace(strings.TrimPrefix(line, \"gitdir:\"))\n116: \tif path == \"\" {\n117: \t\treturn \"\"\n118: \t}\n119: \tif !filepath.IsAbs(path) {\n120: \t\tpath = filepath.Join(filepath.Dir(dotgit), path)\n121: \t}\n122: \treturn filepath.Clean(path)\n123: }\n124: \n125: // MatchOrphan resolves jobArg against the project's orphaned worktrees, exact\n126: // then prefix on the orphan's base name — the same resolution DeleteJob\n127: // applies to branches, so `mg delete o3kk3n` reaches the orphan dir\n128: // \"o3kk3n_jdi-is-broken\". ok is false when nothing (or more than one prefix\n129: // candidate) matches.\n130: func MatchOrphan(root, jobArg string) (o Orphan, ok bool) {\n131: \torphans, err := DiscoverOrphans(root)\n132: \tif err != nil {\n133: \t\treturn Orphan{}, false\n134: \t}\n135: \tfor _, orph := range orphans {\n136: \t\tif orph.Name == jobArg {\n137: \t\t\treturn orph, true\n138: \t\t}\n139: \t}\n140: \tvar matches []Orphan\n141: \tfor _, orph := range orphans {\n142: \t\tif strings.HasPrefix(orph.Name, jobArg) {\n143: \t\t\tmatches = append(matches, orph)\n144: \t\t}\n145: \t}\n146: \tif len(matches) == 1 {\n147: \t\treturn matches[0], true\n148: \t}\n149: \treturn Orphan{}, false\n150: }\n151: \n152: // RemoveOrphans permanently deletes the given orphaned worktrees, each with\n153: // the same confirmation discipline as DeleteJob: an explicit listing of what\n154: // will be removed, \"This cannot be undone.\", and a Proceed? prompt. A declined\n155: // confirmation returns ErrCancelled (the scripts' `exit 0`) and stops — no\n156: // further orphan is touched. After removal it prunes stale worktree metadata\n157: // (mirroring `git worktree prune`), so the metadata side of the hole is closed\n158: // too.\n159: func RemoveOrphans(root string, orphans []Orphan, confirm ConfirmFunc, out io.Writer) error {\n160: \tfor _, o := range orphans {\n161: \t\tfmt.Fprintln(out, \"\")\n162: \t\tfmt.Fprintf(out, \"This will permanently delete orphaned worktree: %s\\n\", o.Name)\n163: \t\tfmt.Fprintf(out, \"  Dir     : %s\\n\", o.Dir)\n164: \t\tif o.GitDir != \"\" {\n165: \t\t\tfmt.Fprintf(out, \"  Gitdir  : %s (no longer exists)\\n\", o.GitDir)\n166: \t\t}\n167: \t\tfmt.Fprintln(out, \"  Note    : no branch or worktree registration — a leftover from an abandoned job\")\n168: \t\tfmt.Fprintln(out, \"\")\n169: \t\tfmt.Fprintln(out, \"This cannot be undone.\")\n170: \t\tif err := askConfirm(confirm, out, \"  Proceed? [y/N] \"); err != nil {\n171: \t\t\treturn err\n172: \t\t}\n173: \t\tfmt.Fprintln(out, \"\")\n174: \t\tfmt.Fprintf(out, \"→ Removing orphaned worktree %s...\\n\", o.Dir)\n175: \t\tif err := os.RemoveAll(o.Dir); err != nil {\n176: \t\t\treturn err\n177: \t\t}\n178: \t\t// An abandoned job may also have left its mg-jdi sidecar behind (the\n179: \t\t// same name as the orphan). Best-effort — the orphan itself is gone.\n180: \t\tif removed, err := RemoveJDIStatus(root, o.Name); err != nil {\n181: \t\t\tfmt.Fprintf(out, \"  Warning: could not remove mg-jdi status for %s: %v\\n\", o.Name, err)\n182: \t\t} else if removed {\n183: \t\t\tfmt.Fprintf(out, \"→ Removing mg-jdi status for %s...\\n\", o.Name)\n184: \t\t}\n185: \t\tfmt.Fprintf(out, \"✓ Orphan removed: %s\\n\", o.Name)\n186: \t}\n187: \t_ = git.WorktreePrune(root)\n188: \treturn nil\n189: }\n190: \n191: // RemoveOrphansConfirmed removes every orphan without further confirmation —\n192: // the caller (mg jobs' batch removal offer) has already confirmed the whole\n193: // set. Each removal prints its progress to out, and stale worktree metadata is\n194: // pruned at the end, mirroring `git worktree prune`.\n195: func RemoveOrphansConfirmed(root string, orphans []Orphan, out io.Writer) error {\n196: \tfor _, o := range orphans {\n197: \t\tfmt.Fprintln(out, \"\")\n198: \t\tfmt.Fprintf(out, \"→ Removing orphaned worktree %s...\\n\", o.Dir)\n199: \t\tif err := os.RemoveAll(o.Dir); err != nil {\n200: \t\t\treturn err\n201: \t\t}\n202: \t\t// Same best-effort sidecar cleanup as RemoveOrphans above.\n203: \t\tif removed, err := RemoveJDIStatus(root, o.Name); err != nil {\n204: \t\t\tfmt.Fprintf(out, \"  Warning: could not remove mg-jdi status for %s: %v\\n\", o.Name, err)\n205: \t\t} else if removed {\n206: \t\t\tfmt.Fprintf(out, \"→ Removing mg-jdi status for %s...\\n\", o.Name)\n207: \t\t}\n208: \t\tfmt.Fprintf(out, \"✓ Orphan removed: %s\\n\", o.Name)\n209: \t}\n210: \t_ = git.WorktreePrune(root)\n211: \treturn nil\n212: }\n\n(End of file - total 212 lines)\n</content>","metadata":{"preview":"\t\t\t\t// directory, or a .git *directory* (a standalone repository).\n\t\t\t\t// Neither is a linked worktree; never report or touch it.\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\t// A .git file naming a gitdir that still exists → a live worktree\n\t\t\t// (registered or not), not an orphan.\n\t\t\tif _, err := os.Stat(gitdir); err == nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tseen[dir] = true\n\t\t\torphans = append(orphans, Orphan{Name: e.Name(), Dir: dir, GitDir: gitdir})\n\t\t}\n\t}\n\n\tsort.Slice(orphans, func(i, j int) bool { return orphans[i].Name < orphans[j].Name })\n\treturn orphans, nil\n}\n\n// readGitdir parses a worktree's .git pointer file (\"gitdir: <path>\", the\n// format git worktree add writes) and returns the gitdir path it names, \"\" for","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/job/orphan.go","text":"\t\t\t\t// directory, or a .git *directory* (a standalone repository).\n\t\t\t\t// Neither is a linked worktree; never report or touch it.\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\t// A .git file naming a gitdir that still exists → a live worktree\n\t\t\t// (registered or not), not an orphan.\n\t\t\tif _, err := os.Stat(gitdir); err == nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tseen[dir] = true\n\t\t\torphans = append(orphans, Orphan{Name: e.Name(), Dir: dir, GitDir: gitdir})\n\t\t}\n\t}\n\n\tsort.Slice(orphans, func(i, j int) bool { return orphans[i].Name < orphans[j].Name })\n\treturn orphans, nil\n}\n\n// readGitdir parses a worktree's .git pointer file (\"gitdir: <path>\", the\n// format git worktree add writes) and returns the gitdir path it names, \"\" for\n// a file that is not such a pointer (including a .git *directory*, which has a\n// different shape and is never a worktree pointer).\nfunc readGitdir(dotgit string) string {\n\tfi, err := os.Stat(dotgit)\n\tif err != nil || fi.IsDir() {\n\t\treturn \"\"\n\t}\n\tdata, err := os.ReadFile(dotgit)\n\tif err != nil {\n\t\treturn \"\"\n\t}\n\tline := strings.TrimSpace(string(data))\n\tif !strings.HasPrefix(line, \"gitdir:\") {\n\t\treturn \"\"\n\t}\n\tpath := strings.TrimSpace(strings.TrimPrefix(line, \"gitdir:\"))\n\tif path == \"\" {\n\t\treturn \"\"\n\t}\n\tif !filepath.IsAbs(path) {\n\t\tpath = filepath.Join(filepath.Dir(dotgit), path)\n\t}\n\treturn filepath.Clean(path)\n}\n\n// MatchOrphan resolves jobArg against the project's orphaned worktrees, exact\n// then prefix on the orphan's base name — the same resolution DeleteJob\n// applies to branches, so `mg delete o3kk3n` reaches the orphan dir\n// \"o3kk3n_jdi-is-broken\". ok is false when nothing (or more than one prefix\n// candidate) matches.\nfunc MatchOrphan(root, jobArg string) (o Orphan, ok bool) {\n\torphans, err := DiscoverOrphans(root)\n\tif err != nil {\n\t\treturn Orphan{}, false\n\t}\n\tfor _, orph := range orphans {\n\t\tif orph.Name == jobArg {\n\t\t\treturn orph, true\n\t\t}\n\t}\n\tvar matches []Orphan\n\tfor _, orph := range orphans {\n\t\tif strings.HasPrefix(orph.Name, jobArg) {\n\t\t\tmatches = append(matches, orph)\n\t\t}\n\t}\n\tif len(matches) == 1 {\n\t\treturn matches[0], true\n\t}\n\treturn Orphan{}, false\n}\n\n// RemoveOrphans permanently deletes the given orphaned worktrees, each with\n// the same confirmation discipline as DeleteJob: an explicit listing of what\n// will be removed, \"This cannot be undone.\", and a Proceed? prompt. A declined\n// confirmation returns ErrCancelled (the scripts' `exit 0`) and stops — no\n// further orphan is touched. After removal it prunes stale worktree metadata\n// (mirroring `git worktree prune`), so the metadata side of the hole is closed\n// too.\nfunc RemoveOrphans(root string, orphans []Orphan, confirm ConfirmFunc, out io.Writer) error {\n\tfor _, o := range orphans {\n\t\tfmt.Fprintln(out, \"\")\n\t\tfmt.Fprintf(out, \"This will permanently delete orphaned worktree: %s\\n\", o.Name)\n\t\tfmt.Fprintf(out, \"  Dir     : %s\\n\", o.Dir)\n\t\tif o.GitDir != \"\" {\n\t\t\tfmt.Fprintf(out, \"  Gitdir  : %s (no longer exists)\\n\", o.GitDir)\n\t\t}\n\t\tfmt.Fprintln(out, \"  Note    : no branch or worktree registration — a leftover from an abandoned job\")\n\t\tfmt.Fprintln(out, \"\")\n\t\tfmt.Fprintln(out, \"This cannot be undone.\")\n\t\tif err := askConfirm(confirm, out, \"  Proceed? [y/N] \"); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tfmt.Fprintln(out, \"\")\n\t\tfmt.Fprintf(out, \"→ Removing orphaned worktree %s...\\n\", o.Dir)\n\t\tif err := os.RemoveAll(o.Dir); err != nil {\n\t\t\treturn err\n\t\t}\n\t\t// An abandoned job may also have left its mg-jdi sidecar behind (the\n\t\t// same name as the orphan). Best-effort — the orphan itself is gone.\n\t\tif removed, err := RemoveJDIStatus(root, o.Name); err != nil {\n\t\t\tfmt.Fprintf(out, \"  Warning: could not remove mg-jdi status for %s: %v\\n\", o.Name, err)\n\t\t} else if removed {\n\t\t\tfmt.Fprintf(out, \"→ Removing mg-jdi status for %s...\\n\", o.Name)\n\t\t}\n\t\tfmt.Fprintf(out, \"✓ Orphan removed: %s\\n\", o.Name)\n\t}\n\t_ = git.WorktreePrune(root)\n\treturn nil\n}\n\n// RemoveOrphansConfirmed removes every orphan without further confirmation —\n// the caller (mg jobs' batch removal offer) has already confirmed the whole\n// set. Each removal prints its progress to out, and stale worktree metadata is\n// pruned at the end, mirroring `git worktree prune`.\nfunc RemoveOrphansConfirmed(root string, orphans []Orphan, out io.Writer) error {\n\tfor _, o := range orphans {\n\t\tfmt.Fprintln(out, \"\")\n\t\tfmt.Fprintf(out, \"→ Removing orphaned worktree %s...\\n\", o.Dir)\n\t\tif err := os.RemoveAll(o.Dir); err != nil {\n\t\t\treturn err\n\t\t}\n\t\t// Same best-effort sidecar cleanup as RemoveOrphans above.\n\t\tif removed, err := RemoveJDIStatus(root, o.Name); err != nil {\n\t\t\tfmt.Fprintf(out, \"  Warning: could not remove mg-jdi status for %s: %v\\n\", o.Name, err)\n\t\t} else if removed {\n\t\t\tfmt.Fprintf(out, \"→ Removing mg-jdi status for %s...\\n\", o.Name)\n\t\t}\n\t\tfmt.Fprintf(out, \"✓ Orphan removed: %s\\n\", o.Name)\n\t}\n\t_ = git.WorktreePrune(root)\n\treturn nil\n}","lineStart":80,"lineEnd":212,"totalLines":212,"truncated":false}},"title":"src/internal/job/orphan.go","time":{"start":1787950711860,"end":1787950711863}},"id":"prt_04a2ac3af001gc8zH6pLHUtfhr","sessionID":"ses_fb5dcd7a6ffeSGBPKFVeVpziRm","messageID":"msg_04a2a26b3001GxoRxW6GYW08H1"}}
