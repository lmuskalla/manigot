{"type":"tool_use","timestamp":1787952955776,"sessionID":"ses_fb5b402d5ffesBMXb1jVe3Cozl","part":{"type":"tool","tool":"read","callID":"call_7bb8b9e71e0541e6b8c808ed","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/mutate_test.go","limit":325},"output":"<path>/workspace/src/internal/serve/mutate_test.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"bytes\"\n5: \t\"encoding/json\"\n6: \t\"io\"\n7: \t\"net/http\"\n8: \t\"os\"\n9: \t\"os/exec\"\n10: \t\"path/filepath\"\n11: \t\"strings\"\n12: \t\"testing\"\n13: \t\"time\"\n14: \n15: \t\"github.com/lmuskalla/manigot/internal/job\"\n16: \t\"github.com/lmuskalla/manigot/internal/launch\"\n17: )\n18: \n19: // fixedID forces CreateJob to use the given id — the deterministic-id\n20: // counterpart of internal/job's own test helper, needed here so endpoint tests\n21: // know the exact branch/job name a created job will carry.\n22: func fixedID(id string) func() (string, error) {\n23: \treturn func() (string, error) { return id, nil }\n24: }\n25: \n26: // yesConfirm answers every prompt with yes — the same pre-approved confirm the\n27: // HTTP delete endpoint relies on.\n28: func yesConfirm(prompt string) (bool, error) { return true, nil }\n29: \n30: // gitJobProject creates a real git project (initGitRepo: main + initial\n31: // commit) with a docs/jobs dir, then creates a job with the fixed id \"ab12cd\"\n32: // via job.CreateJob (branch feature/ab12cd_roundtrip-job, real worktree).\n33: // Requires real git on PATH — the caller must t.Setenv(\"PATH\",\n34: // pathWithRealGitOnly(t)) first. Returns the project root and the create\n35: // result.\n36: func gitJobProject(t *testing.T) (root string, res job.CreateResult) {\n37: \tt.Helper()\n38: \troot = initGitRepo(t)\n39: \tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n40: \t\tt.Fatal(err)\n41: \t}\n42: \tvar out bytes.Buffer\n43: \tres, err := job.CreateJob(root, \"Roundtrip Job\", job.CreateOptions{RandomID: fixedID(\"ab12cd\")}, &out)\n44: \tif err != nil {\n45: \t\tt.Fatalf(\"CreateJob: %v\\n%s\", err, out.String())\n46: \t}\n47: \treturn root, res\n48: }\n49: \n50: // --- TASK-3: POST /projects/{project}/jobs -----------------------------------\n51: \n52: // TestHandleCreateJobGitProject: a real git project gets a real branch +\n53: // worktree, reported in the response.\n54: func TestHandleCreateJobGitProject(t *testing.T) {\n55: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n56: \troot := initGitRepo(t)\n57: \tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n58: \t\tt.Fatal(err)\n59: \t}\n60: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n61: \tbase := filepath.Base(root)\n62: \n63: \trec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Add Gallery Block\"}`)\n64: \tif rec.Code != http.StatusCreated {\n65: \t\tt.Fatalf(\"status = %d, want 201 (body %s)\", rec.Code, rec.Body.String())\n66: \t}\n67: \tvar body createJobResponse\n68: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n69: \t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n70: \t}\n71: \tif body.Job.ID == \"\" || body.Job.Name == \"\" {\n72: \t\tt.Errorf(\"job row missing id/name: %+v\", body.Job)\n73: \t}\n74: \tif body.Job.Title != \"Add Gallery Block\" || body.Job.Type != \"feature\" || body.Job.Status != \"open\" {\n75: \t\tt.Errorf(\"job row = %+v, want title/type/status\", body.Job)\n76: \t}\n77: \tif body.Branch == \"\" || !strings.HasPrefix(body.Branch, \"feature/\") {\n78: \t\tt.Errorf(\"branch = %q, want feature/...\", body.Branch)\n79: \t}\n80: \tif body.WorktreePath == \"\" {\n81: \t\tt.Errorf(\"worktreePath empty for a git project\")\n82: \t} else if _, err := os.Stat(body.WorktreePath); err != nil {\n83: \t\tt.Errorf(\"worktreePath %q does not exist: %v\", body.WorktreePath, err)\n84: \t}\n85: \n86: \t// The created job is discoverable through the API.\n87: \trec = get(t, srv, \"/projects/\"+base+\"/jobs\", \"\")\n88: \tvar list struct {\n89: \t\tJobs []jobRow `json:\"jobs\"`\n90: \t}\n91: \tif err := json.Unmarshal(rec.Body.Bytes(), &list); err != nil {\n92: \t\tt.Fatalf(\"list not JSON: %v\", err)\n93: \t}\n94: \tfound := false\n95: \tfor _, j := range list.Jobs {\n96: \t\tif j.Name == body.Job.Name {\n97: \t\t\tfound = true\n98: \t\t}\n99: \t}\n100: \tif !found {\n101: \t\tt.Errorf(\"created job %q not listed after creation:\\n%s\", body.Job.Name, rec.Body.String())\n102: \t}\n103: \n104: \t// Clean up the created worktree + branch.\n105: \tif _, err := job.DeleteJob(root, body.Job.Name, yesConfirm, io.Discard); err != nil {\n106: \t\tt.Errorf(\"cleanup DeleteJob: %v\", err)\n107: \t}\n108: }\n109: \n110: // TestHandleCreateJobNonGitProject: a non-git project takes the plain-directory\n111: // fallback — branch \"(no git)\", no worktree path.\n112: func TestHandleCreateJobNonGitProject(t *testing.T) {\n113: \troot := fakeJobProject(t, \"existing_job\", minimalBrief(\"Existing\", \"ex\", \"open\", \"feature\", \"2026-08-01\"))\n114: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n115: \tbase := filepath.Base(root)\n116: \n117: \trec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Plain Job\"}`)\n118: \tif rec.Code != http.StatusCreated {\n119: \t\tt.Fatalf(\"status = %d, want 201 (body %s)\", rec.Code, rec.Body.String())\n120: \t}\n121: \tvar body createJobResponse\n122: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n123: \t\tt.Fatalf(\"body not JSON: %v\", err)\n124: \t}\n125: \tif body.Branch != \"(no git)\" {\n126: \t\tt.Errorf(\"branch = %q, want (no git)\", body.Branch)\n127: \t}\n128: \tif body.WorktreePath != \"\" {\n129: \t\tt.Errorf(\"worktreePath = %q, want empty for a non-git project\", body.WorktreePath)\n130: \t}\n131: \t// The job directory exists under docs/jobs.\n132: \tif _, err := os.Stat(filepath.Join(root, \"docs\", \"jobs\", body.Job.Name)); err != nil {\n133: \t\tt.Errorf(\"created job dir missing: %v\", err)\n134: \t}\n135: }\n136: \n137: // TestHandleCreateJobValidation: bad type and empty title are clean 400s —\n138: // not CreateJob's own \"Invalid type\" text surfacing as a 500.\n139: func TestHandleCreateJobValidation(t *testing.T) {\n140: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n141: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n142: \tbase := filepath.Base(root)\n143: \n144: \tif rec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"X\",\"type\":\"bogus\"}`); rec.Code != http.StatusBadRequest {\n145: \t\tt.Errorf(\"bad type: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n146: \t}\n147: \tif rec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"type\":\"feature\"}`); rec.Code != http.StatusBadRequest {\n148: \t\tt.Errorf(\"missing title: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n149: \t}\n150: \tif rec := post(t, srv, \"/projects/no-such-project/jobs\", \"\", `{\"title\":\"X\"}`); rec.Code != http.StatusNotFound {\n151: \t\tt.Errorf(\"unknown project: status = %d, want 404\", rec.Code)\n152: \t}\n153: }\n154: \n155: // --- TASK-4: PUT /projects/{project}/jobs/{job}/files/brief ------------------\n156: \n157: // TestHandleEditBriefReplacesAndCommits: a git-project job's brief.md is\n158: // replaced AND committed in the job's own worktree (the sweep commit), so the\n159: // edit never sits as an uncommitted change.\n160: func TestHandleEditBriefReplacesAndCommits(t *testing.T) {\n161: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n162: \troot, res := gitJobProject(t)\n163: \tdefer os.RemoveAll(res.WorktreePath)\n164: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n165: \tbase := filepath.Base(root)\n166: \n167: \tnewBrief := \"# Brief: Edited\\n\\nstatus: open\\ntype: feature\\nid: ab12cd\\n\\n## What\\n\\nChanged.\\n\"\n168: \trec := put(t, srv, \"/projects/\"+base+\"/jobs/ab12cd/files/brief\", \"\", newBrief)\n169: \tif rec.Code != http.StatusOK {\n170: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n171: \t}\n172: \tvar body editBriefResponse\n173: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n174: \t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n175: \t}\n176: \tif body.Status != \"ok\" {\n177: \t\tt.Errorf(\"status field = %q, want ok\", body.Status)\n178: \t}\n179: \n180: \t// The file on disk (in the job's worktree) was replaced.\n181: \tgot, err := os.ReadFile(filepath.Join(res.Job.Dir, \"brief.md\"))\n182: \tif err != nil {\n183: \t\tt.Fatal(err)\n184: \t}\n185: \tif string(got) != newBrief {\n186: \t\tt.Errorf(\"brief.md = %q, want the PUT body\", string(got))\n187: \t}\n188: \n189: \t// The edit was committed in the job's worktree — the sweep commit.\n190: \tlast := gitCmd(t, res.WorktreePath, \"log\", \"-1\", \"--format=%s\")\n191: \tif !strings.Contains(last, \"[ab12cd] chore: commit all\") {\n192: \t\tt.Errorf(\"worktree HEAD = %q, want the [ab12cd] chore: commit all sweep commit\", last)\n193: \t}\n194: }\n195: \n196: // TestHandleEditBriefNonGitProject: on a non-git project the write still\n197: // succeeds; only the commit cannot happen (no worktree to resolve) — reported\n198: // as a warning, not a failure.\n199: func TestHandleEditBriefNonGitProject(t *testing.T) {\n200: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n201: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n202: \tbase := filepath.Base(root)\n203: \n204: \tnewBrief := \"# Brief: Changed\\n\\nstatus: open\\n\"\n205: \trec := put(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/files/brief\", \"\", newBrief)\n206: \tif rec.Code != http.StatusOK {\n207: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n208: \t}\n209: \tgot, err := os.ReadFile(filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\", \"brief.md\"))\n210: \tif err != nil {\n211: \t\tt.Fatal(err)\n212: \t}\n213: \tif string(got) != newBrief {\n214: \t\tt.Errorf(\"brief.md = %q, want the PUT body\", string(got))\n215: \t}\n216: }\n217: \n218: // TestHandleEditBriefValidation: an empty body and an unknown job are clean\n219: // 400/404s.\n220: func TestHandleEditBriefValidation(t *testing.T) {\n221: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n222: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n223: \tbase := filepath.Base(root)\n224: \n225: \tif rec := put(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/files/brief\", \"\", \"\"); rec.Code != http.StatusBadRequest {\n226: \t\tt.Errorf(\"empty body: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n227: \t}\n228: \tif rec := put(t, srv, \"/projects/\"+base+\"/jobs/no-such-job/files/brief\", \"\", \"# Brief: X\\n\"); rec.Code != http.StatusNotFound {\n229: \t\tt.Errorf(\"unknown job: status = %d, want 404\", rec.Code)\n230: \t}\n231: }\n232: \n233: // --- TASK-5: POST /projects/{project}/jobs/{job}/agents/{agent} --------------\n234: \n235: // TestHandleLaunchAgentDetached: a known agent returns 202 immediately (the\n236: // run happens in a background goroutine) and writes a session.log section for\n237: // the job — the caller's only window onto the detached run.\n238: func TestHandleLaunchAgentDetached(t *testing.T) {\n239: \tfakeCheckout(t, map[string]string{\n240: \t\t\"analyst\":  \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n241: \t\t\"reviewer\": \"name: reviewer\\ndescription: Reviews changes.\\n\",\n242: \t})\n243: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n244: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n245: \tbase := filepath.Base(root)\n246: \n247: \trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/agents/analyst\", \"\", \"\")\n248: \tif rec.Code != http.StatusAccepted {\n249: \t\tt.Fatalf(\"status = %d, want 202 (body %s)\", rec.Code, rec.Body.String())\n250: \t}\n251: \tvar body map[string]string\n252: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n253: \t\tt.Fatalf(\"body not JSON: %v\", err)\n254: \t}\n255: \tif body[\"status\"] != \"started\" || body[\"agent\"] != \"analyst\" || body[\"job\"] != \"wood_oak\" {\n256: \t\tt.Errorf(\"body = %v, want status=started agent=analyst job=wood_oak\", body)\n257: \t}\n258: \n259: \t// The detached run opens a session.log section in the job dir (the\n260: \t// goroutine writes its section header immediately, before the invocation\n261: \t// itself runs — which will fail fast in this test env without docker).\n262: \tlogPath := filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\", \"session.log\")\n263: \twaitFor(t, func() bool {\n264: \t\tdata, err := os.ReadFile(logPath)\n265: \t\treturn err == nil && strings.Contains(string(data), \"=== \")\n266: \t}, \"session.log section header\")\n267: }\n268: \n269: // TestHandleLaunchAgentUnknownAndBadProfile: an unknown agent is a fast 404\n270: // (validated against agentlist.Discover before any container spin-up); a bad\n271: // profile is a 400.\n272: func TestHandleLaunchAgentUnknownAndBadProfile(t *testing.T) {\n273: \tfakeCheckout(t, map[string]string{\n274: \t\t\"analyst\": \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n275: \t})\n276: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n277: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n278: \tbase := filepath.Base(root)\n279: \n280: \tif rec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/agents/no-such-agent\", \"\", \"\"); rec.Code != http.StatusNotFound {\n281: \t\tt.Errorf(\"unknown agent: status = %d, want 404 (body %s)\", rec.Code, rec.Body.String())\n282: \t}\n283: \tif rec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/agents/analyst\", \"\", `{\"profile\":\"bogus-profile\"}`); rec.Code != http.StatusBadRequest {\n284: \t\tt.Errorf(\"bad profile: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n285: \t}\n286: }\n287: \n288: // --- TASK-6: POST /projects/{project}/jobs/{job}/jdi -------------------------\n289: \n290: // stubJdiExe points the launch package's executable lookup at a harmless\n291: // command for the duration of a test — launch.Jdi spawns whatever JdiExe\n292: // returns with the mg-jdi argv, and the default (os.Executable()) would be the\n293: // test binary itself, recursively re-running the whole suite. Mirrors\n294: // internal/launch's own stubJdiExe.\n295: func stubJdiExe(t *testing.T, stub string) {\n296: \tt.Helper()\n297: \told := launch.JdiExe\n298: \tlaunch.JdiExe = func() (string, error) { return stub, nil }\n299: \tt.Cleanup(func() { launch.JdiExe = old })\n300: }\n301: \n302: // TestHandleLaunchJDIDetached: launching mg jdi detached returns 202; an\n303: // already-running mg-jdi (per the status sidecar) is a 409.\n304: func TestHandleLaunchJDIDetached(t *testing.T) {\n305: \tstubJdiExe(t, \"/bin/true\") // never spawn the real mg (or the test binary)\n306: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n307: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n308: \tbase := filepath.Base(root)\n309: \n310: \trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/jdi\", \"\", \"\")\n311: \tif rec.Code != http.StatusAccepted {\n312: \t\tt.Fatalf(\"status = %d, want 202 (body %s)\", rec.Code, rec.Body.String())\n313: \t}\n314: \n315: \t// Now mark the job as already running → the next launch is a 409.\n316: \tif err := job.WriteJDIStatus(root, \"wood_oak\", job.JDIRunning, \"reviewer\"); err != nil {\n317: \t\tt.Fatal(err)\n318: \t}\n319: \trec = post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/jdi\", \"\", \"\")\n320: \tif rec.Code != http.StatusConflict {\n321: \t\tt.Errorf(\"already-running launch: status = %d, want 409 (body %s)\", rec.Code, rec.Body.String())\n322: \t}\n323: }\n324: \n325: // --- TASK-7: POST /projects/{project}/jobs/{job}/done ------------------------\n\n(Showing lines 1-325 of 658. Use offset=326 to continue.)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/launch\"\n)\n\n// fixedID forces CreateJob to use the given id — the deterministic-id\n// counterpart of internal/job's own test helper, needed here so endpoint tests","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/mutate_test.go","text":"package serve\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/launch\"\n)\n\n// fixedID forces CreateJob to use the given id — the deterministic-id\n// counterpart of internal/job's own test helper, needed here so endpoint tests\n// know the exact branch/job name a created job will carry.\nfunc fixedID(id string) func() (string, error) {\n\treturn func() (string, error) { return id, nil }\n}\n\n// yesConfirm answers every prompt with yes — the same pre-approved confirm the\n// HTTP delete endpoint relies on.\nfunc yesConfirm(prompt string) (bool, error) { return true, nil }\n\n// gitJobProject creates a real git project (initGitRepo: main + initial\n// commit) with a docs/jobs dir, then creates a job with the fixed id \"ab12cd\"\n// via job.CreateJob (branch feature/ab12cd_roundtrip-job, real worktree).\n// Requires real git on PATH — the caller must t.Setenv(\"PATH\",\n// pathWithRealGitOnly(t)) first. Returns the project root and the create\n// result.\nfunc gitJobProject(t *testing.T) (root string, res job.CreateResult) {\n\tt.Helper()\n\troot = initGitRepo(t)\n\tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tvar out bytes.Buffer\n\tres, err := job.CreateJob(root, \"Roundtrip Job\", job.CreateOptions{RandomID: fixedID(\"ab12cd\")}, &out)\n\tif err != nil {\n\t\tt.Fatalf(\"CreateJob: %v\\n%s\", err, out.String())\n\t}\n\treturn root, res\n}\n\n// --- TASK-3: POST /projects/{project}/jobs -----------------------------------\n\n// TestHandleCreateJobGitProject: a real git project gets a real branch +\n// worktree, reported in the response.\nfunc TestHandleCreateJobGitProject(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\troot := initGitRepo(t)\n\tif err := os.MkdirAll(filepath.Join(root, \"docs\", \"jobs\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\trec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Add Gallery Block\"}`)\n\tif rec.Code != http.StatusCreated {\n\t\tt.Fatalf(\"status = %d, want 201 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body createJobResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif body.Job.ID == \"\" || body.Job.Name == \"\" {\n\t\tt.Errorf(\"job row missing id/name: %+v\", body.Job)\n\t}\n\tif body.Job.Title != \"Add Gallery Block\" || body.Job.Type != \"feature\" || body.Job.Status != \"open\" {\n\t\tt.Errorf(\"job row = %+v, want title/type/status\", body.Job)\n\t}\n\tif body.Branch == \"\" || !strings.HasPrefix(body.Branch, \"feature/\") {\n\t\tt.Errorf(\"branch = %q, want feature/...\", body.Branch)\n\t}\n\tif body.WorktreePath == \"\" {\n\t\tt.Errorf(\"worktreePath empty for a git project\")\n\t} else if _, err := os.Stat(body.WorktreePath); err != nil {\n\t\tt.Errorf(\"worktreePath %q does not exist: %v\", body.WorktreePath, err)\n\t}\n\n\t// The created job is discoverable through the API.\n\trec = get(t, srv, \"/projects/\"+base+\"/jobs\", \"\")\n\tvar list struct {\n\t\tJobs []jobRow `json:\"jobs\"`\n\t}\n\tif err := json.Unmarshal(rec.Body.Bytes(), &list); err != nil {\n\t\tt.Fatalf(\"list not JSON: %v\", err)\n\t}\n\tfound := false\n\tfor _, j := range list.Jobs {\n\t\tif j.Name == body.Job.Name {\n\t\t\tfound = true\n\t\t}\n\t}\n\tif !found {\n\t\tt.Errorf(\"created job %q not listed after creation:\\n%s\", body.Job.Name, rec.Body.String())\n\t}\n\n\t// Clean up the created worktree + branch.\n\tif _, err := job.DeleteJob(root, body.Job.Name, yesConfirm, io.Discard); err != nil {\n\t\tt.Errorf(\"cleanup DeleteJob: %v\", err)\n\t}\n}\n\n// TestHandleCreateJobNonGitProject: a non-git project takes the plain-directory\n// fallback — branch \"(no git)\", no worktree path.\nfunc TestHandleCreateJobNonGitProject(t *testing.T) {\n\troot := fakeJobProject(t, \"existing_job\", minimalBrief(\"Existing\", \"ex\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\trec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Plain Job\"}`)\n\tif rec.Code != http.StatusCreated {\n\t\tt.Fatalf(\"status = %d, want 201 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body createJobResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif body.Branch != \"(no git)\" {\n\t\tt.Errorf(\"branch = %q, want (no git)\", body.Branch)\n\t}\n\tif body.WorktreePath != \"\" {\n\t\tt.Errorf(\"worktreePath = %q, want empty for a non-git project\", body.WorktreePath)\n\t}\n\t// The job directory exists under docs/jobs.\n\tif _, err := os.Stat(filepath.Join(root, \"docs\", \"jobs\", body.Job.Name)); err != nil {\n\t\tt.Errorf(\"created job dir missing: %v\", err)\n\t}\n}\n\n// TestHandleCreateJobValidation: bad type and empty title are clean 400s —\n// not CreateJob's own \"Invalid type\" text surfacing as a 500.\nfunc TestHandleCreateJobValidation(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tif rec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"X\",\"type\":\"bogus\"}`); rec.Code != http.StatusBadRequest {\n\t\tt.Errorf(\"bad type: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif rec := post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"type\":\"feature\"}`); rec.Code != http.StatusBadRequest {\n\t\tt.Errorf(\"missing title: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif rec := post(t, srv, \"/projects/no-such-project/jobs\", \"\", `{\"title\":\"X\"}`); rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"unknown project: status = %d, want 404\", rec.Code)\n\t}\n}\n\n// --- TASK-4: PUT /projects/{project}/jobs/{job}/files/brief ------------------\n\n// TestHandleEditBriefReplacesAndCommits: a git-project job's brief.md is\n// replaced AND committed in the job's own worktree (the sweep commit), so the\n// edit never sits as an uncommitted change.\nfunc TestHandleEditBriefReplacesAndCommits(t *testing.T) {\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\troot, res := gitJobProject(t)\n\tdefer os.RemoveAll(res.WorktreePath)\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tnewBrief := \"# Brief: Edited\\n\\nstatus: open\\ntype: feature\\nid: ab12cd\\n\\n## What\\n\\nChanged.\\n\"\n\trec := put(t, srv, \"/projects/\"+base+\"/jobs/ab12cd/files/brief\", \"\", newBrief)\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body editBriefResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v (%s)\", err, rec.Body.String())\n\t}\n\tif body.Status != \"ok\" {\n\t\tt.Errorf(\"status field = %q, want ok\", body.Status)\n\t}\n\n\t// The file on disk (in the job's worktree) was replaced.\n\tgot, err := os.ReadFile(filepath.Join(res.Job.Dir, \"brief.md\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif string(got) != newBrief {\n\t\tt.Errorf(\"brief.md = %q, want the PUT body\", string(got))\n\t}\n\n\t// The edit was committed in the job's worktree — the sweep commit.\n\tlast := gitCmd(t, res.WorktreePath, \"log\", \"-1\", \"--format=%s\")\n\tif !strings.Contains(last, \"[ab12cd] chore: commit all\") {\n\t\tt.Errorf(\"worktree HEAD = %q, want the [ab12cd] chore: commit all sweep commit\", last)\n\t}\n}\n\n// TestHandleEditBriefNonGitProject: on a non-git project the write still\n// succeeds; only the commit cannot happen (no worktree to resolve) — reported\n// as a warning, not a failure.\nfunc TestHandleEditBriefNonGitProject(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tnewBrief := \"# Brief: Changed\\n\\nstatus: open\\n\"\n\trec := put(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/files/brief\", \"\", newBrief)\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tgot, err := os.ReadFile(filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\", \"brief.md\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif string(got) != newBrief {\n\t\tt.Errorf(\"brief.md = %q, want the PUT body\", string(got))\n\t}\n}\n\n// TestHandleEditBriefValidation: an empty body and an unknown job are clean\n// 400/404s.\nfunc TestHandleEditBriefValidation(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tif rec := put(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/files/brief\", \"\", \"\"); rec.Code != http.StatusBadRequest {\n\t\tt.Errorf(\"empty body: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif rec := put(t, srv, \"/projects/\"+base+\"/jobs/no-such-job/files/brief\", \"\", \"# Brief: X\\n\"); rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"unknown job: status = %d, want 404\", rec.Code)\n\t}\n}\n\n// --- TASK-5: POST /projects/{project}/jobs/{job}/agents/{agent} --------------\n\n// TestHandleLaunchAgentDetached: a known agent returns 202 immediately (the\n// run happens in a background goroutine) and writes a session.log section for\n// the job — the caller's only window onto the detached run.\nfunc TestHandleLaunchAgentDetached(t *testing.T) {\n\tfakeCheckout(t, map[string]string{\n\t\t\"analyst\":  \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n\t\t\"reviewer\": \"name: reviewer\\ndescription: Reviews changes.\\n\",\n\t})\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/agents/analyst\", \"\", \"\")\n\tif rec.Code != http.StatusAccepted {\n\t\tt.Fatalf(\"status = %d, want 202 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tvar body map[string]string\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"body not JSON: %v\", err)\n\t}\n\tif body[\"status\"] != \"started\" || body[\"agent\"] != \"analyst\" || body[\"job\"] != \"wood_oak\" {\n\t\tt.Errorf(\"body = %v, want status=started agent=analyst job=wood_oak\", body)\n\t}\n\n\t// The detached run opens a session.log section in the job dir (the\n\t// goroutine writes its section header immediately, before the invocation\n\t// itself runs — which will fail fast in this test env without docker).\n\tlogPath := filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\", \"session.log\")\n\twaitFor(t, func() bool {\n\t\tdata, err := os.ReadFile(logPath)\n\t\treturn err == nil && strings.Contains(string(data), \"=== \")\n\t}, \"session.log section header\")\n}\n\n// TestHandleLaunchAgentUnknownAndBadProfile: an unknown agent is a fast 404\n// (validated against agentlist.Discover before any container spin-up); a bad\n// profile is a 400.\nfunc TestHandleLaunchAgentUnknownAndBadProfile(t *testing.T) {\n\tfakeCheckout(t, map[string]string{\n\t\t\"analyst\": \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n\t})\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tif rec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/agents/no-such-agent\", \"\", \"\"); rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"unknown agent: status = %d, want 404 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\tif rec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/agents/analyst\", \"\", `{\"profile\":\"bogus-profile\"}`); rec.Code != http.StatusBadRequest {\n\t\tt.Errorf(\"bad profile: status = %d, want 400 (body %s)\", rec.Code, rec.Body.String())\n\t}\n}\n\n// --- TASK-6: POST /projects/{project}/jobs/{job}/jdi -------------------------\n\n// stubJdiExe points the launch package's executable lookup at a harmless\n// command for the duration of a test — launch.Jdi spawns whatever JdiExe\n// returns with the mg-jdi argv, and the default (os.Executable()) would be the\n// test binary itself, recursively re-running the whole suite. Mirrors\n// internal/launch's own stubJdiExe.\nfunc stubJdiExe(t *testing.T, stub string) {\n\tt.Helper()\n\told := launch.JdiExe\n\tlaunch.JdiExe = func() (string, error) { return stub, nil }\n\tt.Cleanup(func() { launch.JdiExe = old })\n}\n\n// TestHandleLaunchJDIDetached: launching mg jdi detached returns 202; an\n// already-running mg-jdi (per the status sidecar) is a 409.\nfunc TestHandleLaunchJDIDetached(t *testing.T) {\n\tstubJdiExe(t, \"/bin/true\") // never spawn the real mg (or the test binary)\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/jdi\", \"\", \"\")\n\tif rec.Code != http.StatusAccepted {\n\t\tt.Fatalf(\"status = %d, want 202 (body %s)\", rec.Code, rec.Body.String())\n\t}\n\n\t// Now mark the job as already running → the next launch is a 409.\n\tif err := job.WriteJDIStatus(root, \"wood_oak\", job.JDIRunning, \"reviewer\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trec = post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/jdi\", \"\", \"\")\n\tif rec.Code != http.StatusConflict {\n\t\tt.Errorf(\"already-running launch: status = %d, want 409 (body %s)\", rec.Code, rec.Body.String())\n\t}\n}\n\n// --- TASK-7: POST /projects/{project}/jobs/{job}/done ------------------------","lineStart":1,"lineEnd":325,"totalLines":658,"truncated":true}},"title":"src/internal/serve/mutate_test.go","time":{"start":1787952955769,"end":1787952955775}},"id":"prt_04a4d00f70011xuNTp9Omg5El6","sessionI