{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NJnYH83zuJCC7pkjsbdt7x","type":"tool_result","content":"1\tpackage ui\n2\t\n3\timport (\n4\t\t\"strings\"\n5\t\t\"unicode/utf8\"\n6\t\n7\t\ttea \"github.com/charmbracelet/bubbletea\"\n8\t\t\"github.com/charmbracelet/x/ansi\"\n9\t\t\"github.com/mattn/go-runewidth\"\n10\t)\n11\t\n12\t// gpAction is what gitPanelView.update returns for the App to act on.\n13\ttype gpAction int\n14\t\n15\tconst (\n16\t\tgpNone   gpAction = iota\n17\t\tgpCancel          // esc / q — discard and return to the detail view\n18\t\tgpSubmit          // enter — run the highlighted git action\n19\t)\n20\t\n21\t// gitAction is one selectable git command in the panel.\n22\ttype gitAction int\n23\t\n24\tconst (\n25\t\tgitActionCommitAll gitAction = iota\n26\t\tgitActionPush\n27\t\tgitActionMerge\n28\t)\n29\t\n30\t// gitPanelActions lists the panel's actions in display order, with the label\n31\t// shown for each row. This is the single source of truth for both the\n32\t// rendering and the App's dispatch (updateGitPanel's switch on gitAction).\n33\t// The three actions mirror the detail view's git surface: the \"c\" commit-all\n34\t// and \"P\" push-to-origin accelerators plus the \"merge default branch\" action\n35\t// that brings a job's worktree up to speed with the project's base branch.\n36\tvar gitPanelActions = []struct {\n37\t\taction gitAction\n38\t\tlabel  string\n39\t}{\n40\t\t{gitActionCommitAll, \"Commit all\"},\n41\t\t{gitActionPush, \"Push to origin\"},\n42\t\t{gitActionMerge, \"Merge default branch\"},\n43\t}\n44\t\n45\t// gitPanelView is the small \"git\" modal opened by \"g\" from the detail view: a\n46\t// non-destructive picker of the git commands the detail view offers, one per\n47\t// row, moved through with ↑/↓ and run with enter. It deliberately has no\n48\t// type-to-filter (three fixed rows need none, unlike the agents picker) and\n49\t// no filtering bookkeeping at all — the App acts on gpSubmit via the\n50\t// selected() action, exactly like agentsPickerView hands its apSubmit to\n51\t// launch.AgentQuick. Like every other overlay view it renders nothing by\n52\t// itself at the App level; the App's View() switches on stateGitPanel.\n53\ttype gitPanelView struct {\n54\t\tcursor int\n55\t\twidth  int\n56\t\theight int\n57\t}\n58\t\n59\t// newGitPanelView builds the git panel for the given viewport size.\n60\tfunc newGitPanelView(width, height int) *gitPanelView {\n61\t\treturn &gitPanelView{width: width, height: height}\n62\t}\n63\t\n64\t// resize updates the viewport on terminal resize.\n65\tfunc (v *gitPanelView) resize(width, height int) {\n66\t\tv.width, v.height = width, height\n67\t}\n68\t\n69\t// update processes a key for the panel and reports the resulting action:\n70\t// ↑/↓ move the cursor (clamped to the three rows), enter submits, esc/q\n71\t// cancel. Every other key is a no-op.\n72\tfunc (v *gitPanelView) update(msg tea.KeyMsg) gpAction {\n73\t\tswitch msg.String() {\n74\t\tcase \"enter\":\n75\t\t\treturn gpSubmit\n76\t\tcase \"esc\", \"q\":\n77\t\t\treturn gpCancel\n78\t\tcase \"up\":\n79\t\t\tif v.cursor > 0 {\n80\t\t\t\tv.cursor--\n81\t\t\t}\n82\t\tcase \"down\":\n83\t\t\tif v.cursor < len(gitPanelActions)-1 {\n84\t\t\t\tv.cursor++\n85\t\t\t}\n86\t\t}\n87\t\treturn gpNone\n88\t}\n89\t\n90\t// selected returns the action under the cursor, or false if the cursor is out\n91\t// of range (defensive — the cursor is always clamped by update).\n92\tfunc (v *gitPanelView) selected() (gitAction, bool) {\n93\t\tif v.cursor < 0 || v.cursor >= len(gitPanelActions) {\n94\t\t\treturn gitActionCommitAll, false\n95\t\t}\n96\t\treturn gitPanelActions[v.cursor].action, true\n97\t}\n98\t\n99\t// render draws the panel: a title, one row per action (the cursor row\n100\t// highlighted the same way the agents picker highlights its selected row),\n101\t// and a footer key hint.\n102\tfunc (v *gitPanelView) render() string {\n103\t\tvar b strings.Builder\n104\t\tb.WriteString(titleStyle.Render(\"Git\"))\n105\t\tb.WriteString(\"\\n\\n\")\n106\t\tfor i, a := range gitPanelActions {\n107\t\t\tif i == v.cursor {\n108\t\t\t\tb.WriteString(selectedStyle.Render(\"▶ \" + a.label))\n109\t\t\t} else {\n110\t\t\t\tb.WriteString(dimStyle.Render(\"  \" + a.label))\n111\t\t\t}\n112\t\t\tb.WriteString(\"\\n\")\n113\t\t}\n114\t\tb.WriteString(\"\\n\")\n115\t\tb.WriteString(dimStyle.Render(\"↑/↓ navigate · enter run · esc/q cancel\"))\n116\t\treturn b.String()\n117\t}\n118\t\n119\t// gitPanelOverlay renders the git panel as a popup modal floating over the\n120\t// still-visible detail view: the detail frame stays on screen underneath and\n121\t// the panel's styled box (gitPanelModalStyle) is drawn centered on top of it,\n122\t// so \"g\" reads as a popup rather than the full-frame swap it used to be — the\n123\t// surrounding detail content keeps giving context while the three actions sit\n124\t// in a box over it. The box has a solid background, so the cells it covers\n125\t// are replaced wholesale; everything else is left untouched. Purely\n126\t// compositional — the panel view itself, its keys, and the App's dispatch\n127\t// (updateGitPanel) are unchanged.\n128\tfunc (a *App) gitPanelOverlay() string {\n129\t\tbase := \"\"\n130\t\tif a.detail != nil {\n131\t\t\tbase = a.detail.render()\n132\t\t}\n133\t\tif a.gitPanel == nil {\n134\t\t\treturn base\n135\t\t}\n136\t\tmodal := gitPanelModalStyle.Render(a.gitPanel.render())\n137\t\treturn placeOverlay(base, modal, a.width, a.height)\n138\t}\n139\t\n140\t// placeOverlay centers modal over base and merges the two cell by cell: the\n141\t// modal's solid box replaces the base cells it covers and the rest of the\n142\t// base stays visible, producing a floating popup over a live background (as\n143\t// opposed to a full-frame swap). Every base line is padded to the frame width\n144\t// first, so the box lands at the same centered column on every row regardless\n145\t// of how wide that row's content is, then spliced at the modal's column range\n146\t// with cut — ANSI-aware, so escape sequences and wide runes are never split\n147\t// mid-code — with the modal's own ANSI carried in wholesale. A base shorter\n148\t// than the frame is padded with blank rows so the box is never clipped at the\n149\t// bottom. The placement is clamped to the frame so an oversized modal hugs the\n150\t// top left instead of being pushed off-screen.\n151\tfunc placeOverlay(base, modal string, width, height int) string {\n152\t\tmodalLines := strings.Split(modal, \"\\n\")\n153\t\tmodalW := 0\n154\t\tfor _, l := range modalLines {\n155\t\t\tif w := ansi.StringWidth(l); w > modalW {\n156\t\t\t\tmodalW = w\n157\t\t\t}\n158\t\t}\n159\t\tmodalH := len(modalLines)\n160\t\tx := clamp((width-modalW)/2, 0, width)\n161\t\ty := clamp((height-modalH)/2, 0, height)\n162\t\tpad := strings.Repeat(\" \", width)\n163\t\tbaseLines := strings.Split(base, \"\\n\")\n164\t\t// A base shorter than the frame gets blank rows below it, so the frame is\n165\t\t// always height rows tall and a box taller than the content still has\n166\t\t// room (the blank area renders as empty terminal cells, like a short view\n167\t\t// would on a real screen).\n168\t\tfor len(baseLines) < height {\n169\t\t\tbaseLines = append(baseLines, \"\")\n170\t\t}\n171\t\tout := make([]string, 0, len(baseLines))\n172\t\tfor i, bl := range baseLines {\n173\t\t\tif w := ansi.StringWidth(bl); w < width {\n174\t\t\t\tbl += pad[:width-w]\n175\t\t\t}\n176\t\t\tif i >= y && i < y+modalH {\n177\t\t\t\tml := modalLines[i-y]\n178\t\t\t\tprefix, suffix := cut(bl, x, x+ansi.StringWidth(ml))\n179\t\t\t\tout = append(out, prefix+ml+suffix)\n180\t\t\t} else {\n181\t\t\t\tout = append(out, bl)\n182\t\t\t}\n183\t\t}\n184\t\treturn strings.Join(out, \"\\n\")\n185\t}\n186\t\n187\t// cut splits a rendered line s at display columns [lo, hi), returning\n188\t// everything before lo and everything from hi on with the middle dropped.\n189\t// ANSI escape sequences are zero-width and carried whole into whichever side\n190\t// they belong to — never split — and wide/combining runes are counted by\n191\t// display width, so a rune that straddles lo or hi is kept whole in the\n192\t// nearer side rather than torn apart.\n193\tfunc cut(s string, lo, hi int) (left, right string) {\n194\t\tvar lb, rb strings.Builder\n195\t\tcol := 0\n196\t\tfor i := 0; i < len(s); {\n197\t\t\tif s[i] == '\\x1b' {\n198\t\t\t\tseq, n := scanAnsi(s[i:])\n199\t\t\t\t// Sequences inside the dropped range are covered by the modal\n200\t\t\t\t// box's own codes; those outside are carried through so the\n201\t\t\t\t// surrounding base keeps its styling.\n202\t\t\t\tif col < lo {\n203\t\t\t\t\tlb.WriteString(seq)\n204\t\t\t\t} else if col >= hi {\n205\t\t\t\t\trb.WriteString(seq)\n206\t\t\t\t}\n207\t\t\t\ti += n\n208\t\t\t\tcontinue\n209\t\t\t}\n210\t\t\tr, n := utf8.DecodeRuneInString(s[i:])\n211\t\t\tif col < lo {\n212\t\t\t\tlb.WriteRune(r)\n213\t\t\t} else if col >= hi {\n214\t\t\t\trb.WriteRune(r)\n215\t\t\t}\n216\t\t\tcol += runewidth.RuneWidth(r)\n217\t\t\ti += n\n218\t\t}\n219\t\treturn lb.String(), rb.String()\n220\t}\n221\t\n222\t// scanAnsi returns the escape sequence beginning at s (s[0] must be ESC) and\n223\t// its byte length. It handles the forms lipgloss/glamour emit — CSI (ESC [\n224\t// … final byte), OSC (ESC ] … BEL or ESC \\), and the generic ESC + one-byte\n225\t// case — consuming an unrecognized prefix wholesale so no sequence can ever\n226\t// be split mid-code.\n227\tfunc scanAnsi(s string) (string, int) {\n228\t\tif len(s) < 2 {\n229\t\t\treturn s, len(s)\n230\t\t}\n231\t\tswitch s[1] {\n232\t\tcase '[': // CSI — params/intermediates (0x20–0x2F) then final (0x40–0x7E)\n233\t\t\tfor i := 2; i < len(s); i++ {\n234\t\t\t\tif s[i] >= 0x40 && s[i] <= 0x7e {\n235\t\t\t\t\treturn s[:i+1], i + 1\n236\t\t\t\t}\n237\t\t\t}\n238\t\t\treturn s, len(s)\n239\t\tcase ']': // OSC — until BEL (0x07) or ST (ESC \\)\n240\t\t\tfor i := 2; i < len(s); i++ {\n241\t\t\t\tif s[i] == 0x07 {\n242\t\t\t\t\treturn s[:i+1], i + 1\n243\t\t\t\t}\n244\t\t\t\tif s[i] == 0x1b && i+1 < len(s) && s[i+1] == '\\\\' {\n245\t\t\t\t\treturn s[:i+2], i + 2\n246\t\t\t\t}\n247\t\t\t}\n248\t\t\treturn s, len(s)\n249\t\tdefault:\n250\t\t\treturn s[:2], 2\n251\t\t}\n252\t}\n253\t"}]},"parent_tool_use_id":null,"session_id":"5af88135-9c7b-453b-b119-c245e62a60fb","uuid":"94a50aa1-288d-4dae-aee6-72bf898c170b","timestamp":"2026-08-28T20:16:41.958Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/ui/gitpanel.go","content":"package ui\n\nimport (\n\t\"strings\"\n\t\"unicode/utf8\"\n\n\ttea \"github.com/charmbracelet/bubbletea\"\n\t\"github.com/charmbracelet/x/ansi\"\n\t\"github.com/mattn/go-runewidth\"\n)\n\n// gpAction is what gitPanelView.update returns for the App to act on.\ntype gpAction int\n\nconst (\n\tgpNone   gpAction = iota\n\tgpCancel          // esc / q — discard and return to the detail view\n\tgpSubmit          // enter — run the highlighted git action\n)\n\n// gitAction is one selectable git command in the panel.\ntype gitAction int\n\nconst (\n\tgitActionCommitAll gitAction = iota\n\tgitActionPush\n\tgitActionMerge\n)\n\n// gitPanelActions lists the panel's actions in display order, with the label\n// shown for each row. This is the single source of truth for both the\n// rendering and the App's dispatch (updateGitPanel's switch on gitAction).\n// The three actions mirror the detail view's git surface: the \"c\" commit-all\n// and \"P\" push-to-origin accelerators plus the \"merge default branch\" action\n// that brings a job's worktree up to speed with the project's base branch.\nvar gitPanelActions = []struct {\n\taction gitAction\n\tlabel  string\n}{\n\t{gitActionCommitAll, \"Commit all\"},\n\t{gitActionPush, \"Push to origin\"},\n\t{gitActionMerge, \"Merge default branch\"},\n}\n\n// gitPanelView is the small \"git\" modal opened by \"g\" from the detail view: a\n// non-destructive picker of the git commands the detail view offers, one per\n// row, moved through with ↑/↓ and run with enter. It deliberately has no\n// type-to-filter (three fixed rows need none, unlike the agents picker) and\n// no filtering bookkeeping at all — the App acts on gpSubmit via the\n// selected() action, exactly like agentsPickerView hands its apSubmit to\n// launch.AgentQuick. Like every other overlay view it renders nothing by\n// itself at the App level; the App's View() switches on stateGitPanel.\ntype gitPanelView struct {\n\tcursor int\n\twidth  int\n\theight int\n}\n\n// newGitPanelView builds the git panel for the given viewport size.\nfunc newGitPanelView(width, height int) *gitPanelView {\n\treturn &gitPanelView{width: width, height: height}\n}\n\n// resize updates the viewport on terminal resize.\nfunc (v *gitPanelView) resize(width, height int) {\n\tv.width, v.height = width, height\n}\n\n// update processes a key for the panel and reports the resulting action:\n// ↑/↓ move the cursor (clamped to the three rows), enter submits, esc/q\n// cancel. Every other key is a no-op.\nfunc (v *gitPanelView) update(msg tea.KeyMsg) gpAction {\n\tswitch msg.String() {\n\tcase \"enter\":\n\t\treturn gpSubmit\n\tcase \"esc\", \"q\":\n\t\treturn gpCancel\n\tcase \"up\":\n\t\tif v.cursor > 0 {\n\t\t\tv.cursor--\n\t\t}\n\tcase \"down\":\n\t\tif v.cursor < len(gitPanelActions)-1 {\n\t\t\tv.cursor++\n\t\t}\n\t}\n\treturn gpNone\n}\n\n// selected returns the action under the cursor, or false if the cursor is out\n// of range (defensive — the cursor is always clamped by update).\nfunc (v *gitPanelView) selected() (gitAction, bool) {\n\tif v.cursor < 0 || v.cursor >= len(gitPanelActions) {\n\t\treturn gitActionCommitAll, false\n\t}\n\treturn gitPanelActions[v.cursor].action, true\n}\n\n// render draws the panel: a title, one row per action (the cursor row\n// highlighted the same way the agents picker highlights its selected row),\n// and a footer key hint.\nfunc (v *gitPanelView) render() string {\n\tvar b strings.Builder\n\tb.WriteString(titleStyle.Render(\"Git\"))\n\tb.WriteString(\"\\n\\n\")\n\tfor i, a := range gitPanelActions {\n\t\tif i == v.cursor {\n\t\t\tb.WriteString(selectedStyle.Render(\"▶ \" + a.label))\n\t\t} else {\n\t\t\tb.WriteString(dimStyle.Render(\"  \" + a.label))\n\t\t}\n\t\tb.WriteString(\"\\n\")\n\t}\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"↑/↓ navigate · enter run · esc/q cancel\"))\n\treturn b.String()\n}\n\n// gitPanelOverlay renders the git panel as a popup modal floating over the\n// still-visible detail view: the detail frame stays on screen underneath and\n// the panel's styled box (gitPanelModalStyle) is drawn centered on top of it,\n// so \"g\" reads as a popup rather than the full-frame swap it used to be — the\n// surrounding detail content keeps giving context while the three actions sit\n// in a box over it. The box has a solid background, so the cells it covers\n// are replaced wholesale; everything else is left untouched. Purely\n// compositional — the panel view itself, its keys, and the App's dispatch\n// (updateGitPanel) are unchanged.\nfunc (a *App) gitPanelOverlay() string {\n\tbase := \"\"\n\tif a.detail != nil {\n\t\tbase = a.detail.render()\n\t}\n\tif a.gitPanel == nil {\n\t\treturn base\n\t}\n\tmodal := gitPanelModalStyle.Render(a.gitPanel.render())\n\treturn placeOverlay(base, modal, a.width, a.height)\n}\n\n// placeOverlay centers modal over base and merges the two cell by cell: the\n// modal's solid box replaces the base cells it covers and the rest of the\n// base stays visible, producing a floating popup over a live background (as\n// opposed to a full-frame swap). Every base line is padded to the frame width\n// first, so the box lands at the same centered column on every row regardless\n// of how wide that row's content is, then spliced at the modal's column range\n// with cut — ANSI-aware, so escape sequences and wide runes are never split\n// mid-code — with the modal's own ANSI carried in wholesale. A base shorter\n// than the frame is padded with blank rows so the box is never clipped at the\n// bottom. The placement is clamped to the frame so an oversized modal hugs the\n// top left instead of being pushed off-screen.\nfunc placeOverlay(base, modal string, width, height int) string {\n\tmodalLines := strings.Split(modal, \"\\n\")\n\tmodalW := 0\n\tfor _, l := range modalLines {\n\t\tif w := ansi.StringWidth(l); w > modalW {\n\t\t\tmodalW = w\n\t\t}\n\t}\n\tmodalH := len(modalLines)\n\tx := clamp((width-modalW)/2, 0, width)\n\ty := clamp((height-modalH)/2, 0, height)\n\tpad := strings.Repeat(\" \", width)\n\tbaseLines := strings.Split(base, \"\\n\")\n\t// A base shorter than the frame gets blank rows below it, so the frame is\n\t// always height rows tall and a box taller than the content still has\n\t// room (the blank area renders as empty terminal cells, like a short view\n\t// would on a real screen).\n\tfor len(baseLines) < height {\n\t\tbaseLines = append(baseLines, \"\")\n\t}\n\tout := make([]string, 0, len(baseLines))\n\tfor i, bl := range baseLines {\n\t\tif w := ansi.StringWidth(bl); w < width {\n\t\t\tbl += pad[:width-w]\n\t\t}\n\t\tif i >= y && i < y+modalH {\n\t\t\tml := modalLines[i-y]\n\t\t\tprefix, suffix := cut(bl, x, x+ansi.StringWidth(ml))\n\t\t\tout = append(out, prefix+ml+suffix)\n\t\t} else {\n\t\t\tout = append(out, bl)\n\t\t}\n\t}\n\treturn strings.Join(out, \"\\n\")\n}\n\n// cut splits a rendered line s at display columns [lo, hi), returning\n// everything before lo and everything from hi on with the middle dropped.\n// ANSI escape sequences are zero-width and carried whole into whichever side\n// they belong to — never split — and wide/combining runes are counted by\n// display width, so a rune that straddles lo or hi is kept whole in the\n// nearer side rather than torn apart.\nfunc cut(s string, lo, hi int) (left, right string) {\n\tvar lb, rb strings.Builder\n\tcol := 0\n\tfor i := 0; i < len(s); {\n\t\tif s[i] == '\\x1b' {\n\t\t\tseq, n := scanAnsi(s[i:])\n\t\t\t// Sequences inside the dropped range are covered by the modal\n\t\t\t// box's own codes; those outside are carried through so the\n\t\t\t// surrounding base keeps its styling.\n\t\t\tif col < lo {\n\t\t\t\tlb.WriteString(seq)\n\t\t\t} else if col >= hi {\n\t\t\t\trb.WriteString(seq)\n\t\t\t}\n\t\t\ti += n\n\t\t\tcontinue\n\t\t}\n\t\tr, n := utf8.DecodeRuneInString(s[i:])\n\t\tif col < lo {\n\t\t\tlb.WriteRune(r)\n\t\t} else if col >= hi {\n\t\t\trb.WriteRune(r)\n\t\t}\n\t\tcol += runewidth.RuneWidth(r)\n\t\ti += n\n\t}\n\treturn lb.String(), rb.String()\n}\n\n// scanAnsi returns the escape sequence beginning at s (s[0] must be ESC) and\n// its byte length. It handles the forms lipgloss/glamour emit — CSI (ESC [\n// … final byte), OSC (ESC ] … BEL or ESC \\), and the generic ESC + one-byte\n// case — consuming an unrecognized prefix wholesale so no sequence can ever\n// be split mid-code.\nfunc scanAnsi(s string) (string, int) {\n\tif len(s) < 2 {\n\t\treturn s, len(s)\n\t}\n\tswitch s[1] {\n\tcase '[': // CSI — params/intermediates (0x20–0x2F) then final (0x40–0x7E)\n\t\tfor i := 2; i < len(s); i++ {\n\t\t\tif s[i] >= 0x40 && s[i] <= 0x7e {\n\t\t\t\treturn s[:i+1], i + 1\n\t\t\t}\n\t\t}\n\t\treturn s, len(s)\n\tcase ']': // OSC — until BEL (0x07) or ST (ESC \\)\n\t\tfor i := 2; i < len(s); i++ {\n\t\t\tif s[i] == 0x07 {\n\t\t\t\treturn s[:i+1], i + 1\n\t\t\t}\n\t\t\tif s[i] == 0x1b && i+1 < len(s) && s[i+1] == '\\\\' {\n\t\t\t\treturn s[:i+2], i + 2\n\t\t\t}\n\t\t}\n\t\treturn s, len(s)\n\tdefault:\n\t\treturn s[:2], 2\n\t}\n}\n","numLines":253,"startLine":1,"totalLines":253}}}
