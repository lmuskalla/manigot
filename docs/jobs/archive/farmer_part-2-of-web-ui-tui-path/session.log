{"type":"tool_use","timestamp":1787952903884,"sessionID":"ses_fb5b402d5ffesBMXb1jVe3Cozl","part":{"type":"tool","tool":"read","callID":"call_ee450cb8ac94449bb73c84fb","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/mutate.go"},"output":"<path>/workspace/src/internal/serve/mutate.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"bytes\"\n5: \t\"context\"\n6: \t\"encoding/json\"\n7: \t\"errors\"\n8: \t\"fmt\"\n9: \t\"io\"\n10: \t\"net/http\"\n11: \t\"os\"\n12: \t\"path/filepath\"\n13: \t\"strings\"\n14: \t\"time\"\n15: \n16: \t\"github.com/lmuskalla/manigot/internal/agentlist\"\n17: \t\"github.com/lmuskalla/manigot/internal/config\"\n18: \t\"github.com/lmuskalla/manigot/internal/git\"\n19: \t\"github.com/lmuskalla/manigot/internal/job\"\n20: \t\"github.com/lmuskalla/manigot/internal/launch\"\n21: \t\"github.com/lmuskalla/manigot/internal/session\"\n22: )\n23: \n24: // maxJSONBodyBytes bounds every JSON request body this API decodes — a sane\n25: // cap well above any realistic request (a title, a profile name, a force\n26: // flag) while still refusing an unbounded upload.\n27: const maxJSONBodyBytes = 1 << 20 // 1 MiB\n28: \n29: // approvedConfirm is the pre-approved job.ConfirmFunc every mutating endpoint\n30: // that wraps a confirm-gated job.* function passes: the HTTP call itself is\n31: // the confirmation, mirroring internal/ui/app.go's own yesConfirm — the same\n32: // precedent the TUI already established for its confirm-then-call pattern.\n33: // Any warning this API wants to gate behind an explicit decision (see\n34: // handleDoneJob's {\"force\":true} requirement) is intercepted before the\n35: // wrapped function's own confirm prompts are ever reached.\n36: func approvedConfirm(prompt string) (bool, error) { return true, nil }\n37: \n38: // decodeJSONBody decodes r's body into v, tolerating a fully empty body (a\n39: // zero-value v — every mutating endpoint's request body is either optional\n40: // or has every field itself optional). A non-empty-but-invalid body is a 400.\n41: func decodeJSONBody(w http.ResponseWriter, r *http.Request, v any) bool {\n42: \tif r.Body == nil || r.ContentLength == 0 {\n43: \t\treturn true\n44: \t}\n45: \tdec := json.NewDecoder(io.LimitReader(r.Body, maxJSONBodyBytes))\n46: \tif err := dec.Decode(v); err != nil {\n47: \t\tif errors.Is(err, io.EOF) {\n48: \t\t\treturn true // an empty body decodes as EOF — same as no body\n49: \t\t}\n50: \t\twriteError(w, http.StatusBadRequest, \"invalid JSON body\")\n51: \t\treturn false\n52: \t}\n53: \treturn true\n54: }\n55: \n56: // resolveProfile validates an optional profile string (from a request body),\n57: // defaulting to config.ProfileClaudePro like every other launch path (mg\n58: // jdi's own --profile flag, the session launcher). An unrecognized non-empty\n59: // value is reported to the caller (ok=false; the handler must return\n60: // immediately) rather than silently falling through to a launch failure deep\n61: // inside a container spin-up.\n62: func resolveProfile(w http.ResponseWriter, raw string) (profile string, ok bool) {\n63: \tprofile = strings.TrimSpace(raw)\n64: \tif profile == \"\" {\n65: \t\treturn config.ProfileClaudePro, true\n66: \t}\n67: \tif _, known := config.ProfileByID(profile); !known {\n68: \t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"unknown profile %q\", profile))\n69: \t\treturn \"\", false\n70: \t}\n71: \treturn profile, true\n72: }\n73: \n74: // --- POST /projects/{project}/jobs (TASK-3) ----------------------------------\n75: \n76: // createJobRequest is the create-job endpoint's request body. Type defaults\n77: // to \"feature\" when empty; BaseBranch optionally overrides the project's\n78: // configured base branch for this one job.\n79: type createJobRequest struct {\n80: \tTitle      string `json:\"title\"`\n81: \tType       string `json:\"type\"`\n82: \tBaseBranch string `json:\"baseBranch\"`\n83: }\n84: \n85: // createJobResponse is the create-job endpoint's response: the created job's\n86: // row (the same shape GET .../jobs returns) plus the branch/worktree path\n87: // from job.CreateResult.\n88: type createJobResponse struct {\n89: \tJob          jobRow `json:\"job\"`\n90: \tBranch       string `json:\"branch\"`\n91: \tWorktreePath string `json:\"worktreePath,omitempty\"`\n92: }\n93: \n94: // validJobTypes mirrors job.CreateJob's own accepted set (internal/job/\n95: // create.go) — checked here so a bad value is a clean 400 instead of\n96: // CreateJob's own \"Invalid type '...' ...\" error text surfacing as a 500.\n97: var validJobTypes = map[string]bool{\"\": true, \"feature\": true, \"fix\": true, \"chore\": true}\n98: \n99: // jobRowFromJob builds a jobRow — the exact shape handleProjectJobs returns —\n100: // from an already-resolved job.Job, so a mutating endpoint's response carries\n101: // the identical fields a subsequent GET .../jobs listing would show for it.\n102: func jobRowFromJob(j job.Job) jobRow {\n103: \treturn jobRow{\n104: \t\tID:     j.ID,\n105: \t\tName:   j.Name,\n106: \t\tStatus: j.Status,\n107: \t\tStage:  string(j.Stage()),\n108: \t\tType:   j.Type,\n109: \t\tDate:   j.Date,\n110: \t\tTitle:  j.Title,\n111: \t\tBranch: j.Branch,\n112: \t}\n113: }\n114: \n115: // handleCreateJob creates a new job (job.CreateJob) under the project lock —\n116: // git-mutating: it creates a branch + worktree, one of the operations the\n117: // brief's Notes names explicitly.\n118: func (s *Server) handleCreateJob(w http.ResponseWriter, r *http.Request) {\n119: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n120: \tif !ok {\n121: \t\treturn\n122: \t}\n123: \n124: \tvar req createJobRequest\n125: \tif !decodeJSONBody(w, r, &req) {\n126: \t\treturn\n127: \t}\n128: \tif strings.TrimSpace(req.Title) == \"\" {\n129: \t\twriteError(w, http.StatusBadRequest, \"title is required\")\n130: \t\treturn\n131: \t}\n132: \tif !validJobTypes[req.Type] {\n133: \t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"invalid type %q — use feature, fix, or chore\", req.Type))\n134: \t\treturn\n135: \t}\n136: \n137: \ts.locks.Lock(root)\n138: \tdefer s.locks.Unlock(root)\n139: \n140: \tres, err := job.CreateJob(root, req.Title, job.CreateOptions{Type: req.Type, BaseBranchOverride: req.BaseBranch}, io.Discard)\n141: \tif err != nil {\n142: \t\twriteError(w, http.StatusInternalServerError, err.Error())\n143: \t\treturn\n144: \t}\n145: \twriteJSON(w, http.StatusCreated, createJobResponse{\n146: \t\tJob:          jobRowFromJob(res.Job),\n147: \t\tBranch:       res.Branch,\n148: \t\tWorktreePath: res.WorktreePath,\n149: \t})\n150: }\n151: \n152: // --- PUT /projects/{project}/jobs/{job}/files/brief (TASK-4) -----------------\n153: \n154: // maxBriefBytes bounds the edit-brief endpoint's request body — a sane cap\n155: // well above any realistic brief.md while still refusing an unbounded upload.\n156: const maxBriefBytes = 1 << 20 // 1 MiB\n157: \n158: // editBriefResponse is the edit-brief endpoint's response. Warning is set\n159: // only when the post-write commit sweep could not be attempted or failed —\n160: // the write itself already succeeded either way, so this is a diagnostic, not\n161: // a failure of the request.\n162: type editBriefResponse struct {\n163: \tStatus  string `json:\"status\"`\n164: \tWarning string `json:\"warning,omitempty\"`\n165: }\n166: \n167: // handleEditBrief replaces a job's brief.md wholesale with the raw request\n168: // body — the one job file this API makes writable (tasks/implementation/\n169: // verdict stay read-only, written only by their respective agents: no\n170: // $EDITOR here, this is an HTTP body write) — then commits the change in the\n171: // job's own worktree via session.SweepJobWorktree (the same \"commit\n172: // everything uncommitted\" primitive every session-ending sweep already\n173: // uses), so the edit never sits as an uncommitted change waiting for\n174: // something else to sweep it.\n175: //\n176: // Takes the project lock: the commit itself touches git, even though the\n177: // brief's Notes paragraph only names create/done/delete/push explicitly in\n178: // its git-mutating set — a real race against a concurrent done/delete on the\n179: // same worktree otherwise (this task's own reasoned addition, not something\n180: // the brief pins either way).\n181: func (s *Server) handleEditBrief(w http.ResponseWriter, r *http.Request) {\n182: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n183: \tif !ok {\n184: \t\treturn\n185: \t}\n186: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n187: \tif !ok {\n188: \t\treturn\n189: \t}\n190: \n191: \tbody, err := io.ReadAll(io.LimitReader(r.Body, maxBriefBytes+1))\n192: \tif err != nil {\n193: \t\twriteError(w, http.StatusBadRequest, \"could not read request body\")\n194: \t\treturn\n195: \t}\n196: \tif len(body) == 0 {\n197: \t\twriteError(w, http.StatusBadRequest, \"request body must not be empty\")\n198: \t\treturn\n199: \t}\n200: \tif len(body) > maxBriefBytes {\n201: \t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"request body exceeds the %d byte limit\", maxBriefBytes))\n202: \t\treturn\n203: \t}\n204: \n205: \ts.locks.Lock(root)\n206: \tdefer s.locks.Unlock(root)\n207: \n208: \tif err := os.WriteFile(filepath.Join(j.Dir, \"brief.md\"), body, 0o644); err != nil {\n209: \t\twriteError(w, http.StatusInternalServerError, \"could not write brief.md\")\n210: \t\treturn\n211: \t}\n212: \n213: \tresp := editBriefResponse{Status: \"ok\"}\n214: \tvar diag bytes.Buffer\n215: \tif wt, wtOK, werr := git.WorktreeForBranch(root, j.Branch); werr != nil {\n216: \t\tresp.Warning = \"brief.md written, but could not resolve the job's worktree to commit it: \" + werr.Error()\n217: \t} else if wtOK {\n218: \t\tsession.SweepJobWorktree(session.Root{ProjectRoot: wt, InvocationRoot: root, Job: j.Name}, &diag)\n219: \t\tif diag.Len() > 0 {\n220: \t\t\tresp.Warning = strings.TrimSpace(diag.String())\n221: \t\t}\n222: \t} else {\n223: \t\t// A branch with no registered worktree is an inconsistent state — the\n224: \t\t// edit is written but cannot be committed, so say so rather than\n225: \t\t// claiming a clean ok.\n226: \t\tresp.Warning = fmt.Sprintf(\"brief.md written, but branch '%s' has no registered worktree to commit it — the edit may be lost on a later checkout\", j.Branch)\n227: \t}\n228: \twriteJSON(w, http.StatusOK, resp)\n229: }\n230: \n231: // --- POST /projects/{project}/jobs/{job}/agents/{agent} (TASK-5) ------------\n232: \n233: // handleLaunchAgent launches one agent, one-shot, via internal/session's\n234: // RunOneShot/CommandAgentRunner (TASK-2) — never an attached/interactive\n235: // session, per the brief's explicit out-of-scope note. The agent name is\n236: // validated against agentlist.Discover(root) first, for a fast 404 on an\n237: // unknown agent rather than letting an invalid agent fail deep inside a\n238: // container spin-up. Does NOT take s.locks: launching an agent doesn't touch\n239: // git state and shouldn't block behind an unrelated done/delete (the brief's\n240: // own Notes).\n241: //\n242: // Responds 202 Accepted immediately — the run happens in a background\n243: // goroutine; the caller watches it via the session-log SSE stream (TASK-12)\n244: // or by polling GET .../jdi's sessionLog tail.\n245: func (s *Server) handleLaunchAgent(w http.ResponseWriter, r *http.Request) {\n246: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n247: \tif !ok {\n248: \t\treturn\n249: \t}\n250: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n251: \tif !ok {\n252: \t\treturn\n253: \t}\n254: \n255: \tagent := r.PathValue(\"agent\")\n256: \tif !validSegment(agent) {\n257: \t\twriteError(w, http.StatusNotFound, \"agent not found\")\n258: \t\treturn\n259: \t}\n260: \tagents, err := agentlist.Discover(root)\n261: \tif err != nil {\n262: \t\twriteError(w, http.StatusInternalServerError, \"cannot list agents\")\n263: \t\treturn\n264: \t}\n265: \tknown := false\n266: \tfor _, a := range agents {\n267: \t\tif a.Name == agent {\n268: \t\t\tknown = true\n269: \t\t\tbreak\n270: \t\t}\n271: \t}\n272: \tif !known {\n273: \t\twriteError(w, http.StatusNotFound, fmt.Sprintf(\"agent '%s' not found\", agent))\n274: \t\treturn\n275: \t}\n276: \n277: \tvar req struct {\n278: \t\tProfile string `json:\"profile\"`\n279: \t}\n280: \tif !decodeJSONBody(w, r, &req) {\n281: \t\treturn\n282: \t}\n283: \tprofile, ok := resolveProfile(w, req.Profile)\n284: \tif !ok {\n285: \t\treturn\n286: \t}\n287: \n288: \trunner := &session.CommandAgentRunner{ProjectRoot: root, Profile: profile}\n289: \tgo session.RunOneShot(runner, agent, j)\n290: \n291: \twriteJSON(w, http.StatusAccepted, map[string]string{\"status\": \"started\", \"agent\": agent, \"job\": j.Name})\n292: }\n293: \n294: // --- POST /projects/{project}/jobs/{job}/jdi (TASK-6) -----------------------\n295: \n296: // handleLaunchJDI launches `mg jdi` detached for a job (launch.Jdi — already\n297: // exactly the shape this needs: a detached subprocess, no attached terminal,\n298: // stdio discarded, reaped asynchronously). Before launching it checks\n299: // job.ReadJDIStatus for an already-running state and rejects with 409 if\n300: // found — a best-effort guard (not airtight: two launches issued\n301: // back-to-back before the first process writes its own status sidecar could\n302: // still both proceed) against two concurrent mg-jdi loops racing on the same\n303: // job's git branch. No s.locks — same reasoning as handleLaunchAgent.\n304: func (s *Server) handleLaunchJDI(w http.ResponseWriter, r *http.Request) {\n305: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n306: \tif !ok {\n307: \t\treturn\n308: \t}\n309: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n310: \tif !ok {\n311: \t\treturn\n312: \t}\n313: \n314: \tif st, running := job.ReadJDIStatus(root, j.Name); running && st.State == job.JDIRunning {\n315: \t\twriteError(w, http.StatusConflict, fmt.Sprintf(\"mg jdi is already running for job '%s'\", j.Name))\n316: \t\treturn\n317: \t}\n318: \n319: \tvar req struct {\n320: \t\tProfile string `json:\"profile\"`\n321: \t}\n322: \tif !decodeJSONBody(w, r, &req) {\n323: \t\treturn\n324: \t}\n325: \tprofile, ok := resolveProfile(w, req.Profile)\n326: \tif !ok {\n327: \t\treturn\n328: \t}\n329: \n330: \tif err := launch.Jdi(j.Name, root, profile); err != nil {\n331: \t\twriteError(w, http.StatusInternalServerError, err.Error())\n332: \t\treturn\n333: \t}\n334: \twriteJSON(w, http.StatusAccepted, map[string]string{\"status\": \"started\", \"job\": j.Name})\n335: }\n336: \n337: // --- POST /projects/{project}/jobs/{job}/done (TASK-7) ----------------------\n338: \n339: // doneRequest is the done endpoint's request body: force, when true,\n340: // proceeds past the \"verdict not approved\" / \"no verdict.md\" warnings the CLI\n341: // would otherwise interactively confirm past — there is no human physically\n342: // reading a terminal warning over this API, so the default is to refuse\n343: // (409) rather than silently auto-approve a risky merge the way the TUI's\n344: // yesConfirm does today.\n345: type doneRequest struct {\n346: \tForce bool `json:\"force\"`\n347: }\n348: \n349: // doneResponse is the done endpoint's response: the finished job's name, the\n350: // branch that was merged and deleted, and the base branch it was merged into.\n351: type doneResponse struct {\n352: \tJobName    string `json:\"jobName\"`\n353: \tBranch     string `json:\"branch\"`\n354: \tBaseBranch string `json:\"baseBranch\"`\n355: }\n356: \n357: // doneVerdictWarning reproduces FinishJob's own pre-merge verdict check\n358: // (internal/job/finish.go) without duplicating its regex classification: it\n359: // reads the same job.Job.VerdictStatus/job.VerdictNotApproved exported\n360: // helpers FinishJob itself is built on, so the two can never drift. hasWarning\n361: // is true — with the CLI's own warning text — for exactly the three cases\n362: // FinishJob would otherwise interactively confirm past: an undetermined\n363: // status, a REJECTED/NEEDS WORK status, or a missing verdict.md.\n364: func doneVerdictWarning(j job.Job) (warning string, hasWarning bool) {\n365: \tverdictPath := filepath.Join(j.Dir, \"verdict.md\")\n366: \tswitch _, err := os.Stat(verdictPath); {\n367: \tcase err == nil:\n368: \t\tstatus := j.VerdictStatus()\n369: \t\tswitch {\n370: \t\tcase status == \"\":\n371: \t\t\treturn \"Warning: could not determine verdict status from verdict.md\", true\n372: \t\tcase job.VerdictNotApproved(status):\n373: \t\t\treturn fmt.Sprintf(\"Warning: verdict is '%s' — job is not approved.\", status), true\n374: \t\tdefault:\n375: \t\t\treturn \"\", false\n376: \t\t}\n377: \tcase os.IsNotExist(err):\n378: \t\treturn \"Warning: no verdict.md found — job has not been reviewed.\", true\n379: \tdefault:\n380: \t\treturn \"\", false // unreadable for some other reason — let FinishJob itself surface it\n381: \t}\n382: }\n383: \n384: // handleDoneJob archives a finished job (job.FinishJobWithOptions) under the\n385: // project lock (git-mutating, named explicitly in the brief's Notes).\n386: //\n387: // A squash-merge conflict is reported as a structured 409 error\n388: // (job.ErrSquashMergeConflict, via FinishOptions.NoConflictRecovery) and the\n389: // job is left exactly where FinishJob left it — no automatic rollback, no\n390: // automatic @git-solver handoff — per the brief's own explicit pinning that\n391: // this must not silently fall back to either of FinishJob's two interactive\n392: // behaviors; resolving it is an explicit follow-up decision through some\n393: // other call (e.g. launching @git-solver via the agent-launch endpoint, or\n394: // `mg host` from a terminal).\n395: //\n396: // Separately (not pinned by the brief at all): the earlier \"verdict not\n397: // approved\" / \"no verdict.md\" warnings require {\"force\": true} to proceed\n398: // past — a 409 echoing the CLI's own warning text when force is absent —\n399: // rather than silently auto-approving a risky merge the way the TUI's\n400: // yesConfirm does today.\n401: func (s *Server) handleDoneJob(w http.ResponseWriter, r *http.Request) {\n402: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n403: \tif !ok {\n404: \t\treturn\n405: \t}\n406: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n407: \tif !ok {\n408: \t\treturn\n409: \t}\n410: \n411: \tvar req doneRequest\n412: \tif !decodeJSONBody(w, r, &req) {\n413: \t\treturn\n414: \t}\n415: \n416: \tif warning, has := doneVerdictWarning(j); has && !req.Force {\n417: \t\twriteError(w, http.StatusConflict, warning+\" Pass {\\\"force\\\": true} to proceed anyway.\")\n418: \t\treturn\n419: \t}\n420: \n421: \ts.locks.Lock(root)\n422: \tdefer s.locks.Unlock(root)\n423: \n424: \tvar out bytes.Buffer\n425: \tres, err := job.FinishJobWithOptions(root, j.Name, approvedConfirm, &out, job.FinishOptions{NoConflictRecovery: true})\n426: \tif err != nil {\n427: \t\tif errors.Is(err, job.ErrSquashMergeConflict) {\n428: \t\t\twriteError(w, http.StatusConflict, err.Error())\n429: \t\t\treturn\n430: \t\t}\n431: \t\twriteError(w, http.StatusInternalServerError, err.Error())\n432: \t\treturn\n433: \t}\n434: \twriteJSON(w, http.StatusOK, doneResponse{JobName: res.JobName, Branch: res.Branch, BaseBranch: res.BaseBranch})\n435: }\n436: \n437: // --- POST /projects/{project}/jobs/{job}/delete (TASK-8) --------------------\n438: \n439: // deleteJobResponse is the delete endpoint's response — job.DeleteResult's\n440: // fields.\n441: type deleteJobResponse struct {\n442: \tJobName string `json:\"jobName\"`\n443: \tBranch  string `json:\"branch,omitempty\"`\n444: \tDir     string `json:\"dir\"`\n445: }\n446: \n447: // handleDeleteJob permanently deletes a job (job.DeleteJob) under the project\n448: // lock (git-mutating, named explicitly in the brief's Notes). The HTTP call\n449: // itself is the confirmation (approvedConfirm) — no merge step, so unlike\n450: // done there is no conflict-handling ambiguity here.\n451: func (s *Server) handleDeleteJob(w http.ResponseWriter, r *http.Request) {\n452: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n453: \tif !ok {\n454: \t\treturn\n455: \t}\n456: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n457: \tif !ok {\n458: \t\treturn\n459: \t}\n460: \n461: \ts.locks.Lock(root)\n462: \tdefer s.locks.Unlock(root)\n463: \n464: \tvar out bytes.Buffer\n465: \tres, err := job.DeleteJob(root, j.Name, approvedConfirm, &out)\n466: \tif err != nil {\n467: \t\twriteError(w, http.StatusInternalServerError, err.Error())\n468: \t\treturn\n469: \t}\n470: \twriteJSON(w, http.StatusOK, deleteJobResponse{JobName: res.JobName, Branch: res.Branch, Dir: res.Dir})\n471: }\n472: \n473: // --- POST /projects/{project}/jobs/{job}/push (TASK-9) ----------------------\n474: \n475: // pushTimeout bounds the push endpoint's git call, mirroring the TUI git\n476: // panel's own hostGitTimeout (src/internal/ui/app.go): long enough for a\n477: // real push, short enough that a stalled/unreachable remote can't hang the\n478: // request forever.\n479: const pushTimeout = 30 * time.Second\n480: \n481: // handlePushJob pushes a job's branch to origin (git.PushWithContext — `git\n482: // push -u origin <branch>`, mirroring the TUI git panel's \"Push to origin\"\n483: // action) under the project lock (git-mutating, named explicitly in the\n484: // brief's Notes). A push failure (auth, network, non-fast-forward) surfaces\n485: // as a structured error with git's own message, never silently swallowed.\n486: func (s *Server) handlePushJob(w http.ResponseWriter, r *http.Request) {\n487: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n488: \tif !ok {\n489: \t\treturn\n490: \t}\n491: \tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n492: \tif !ok {\n493: \t\treturn\n494: \t}\n495: \n496: \ts.locks.Lock(root)\n497: \tdefer s.locks.Unlock(root)\n498: \n499: \tctx, cancel := context.WithTimeout(r.Context(), pushTimeout)\n500: \tdefer cancel()\n501: \tif err := git.PushWithContext(ctx, root, j.Branch); err != nil {\n502: \t\twriteError(w, http.StatusInternalServerError, err.Error())\n503: \t\treturn\n504: \t}\n505: \twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"pushed\", \"branch\": j.Branch})\n506: }\n507: \n508: // --- POST /prune (TASK-10) ---------------------------------------------------\n509: \n510: // pruneResponse mirrors mg prune's own reporting (session.PruneResult).\n511: type pruneResponse struct {\n512: \tRemoved int `json:\"removed\"`\n513: \tRunning int `json:\"running\"`\n514: }\n515: \n516: // handlePrune wraps session.PruneOrphans — the same function cmd/mg/prune.go's\n517: // runPrune calls. Deliberately top-level (not nested under /projects/{project})\n518: // rather than project-scoped: orphaned manigot-* containers are not\n519: // partitioned by project (docker has no concept of \"which registered project\"\n520: // a leftover container belongs to). No s.locks: no git or project-scoped\n521: // state at all.\n522: func (s *Server) handlePrune(w http.ResponseWriter, r *http.Request) {\n523: \tres, err := session.PruneOrphans(io.Discard)\n524: \tif err != nil {\n525: \t\twriteError(w, http.StatusInternalServerError, err.Error())\n526: \t\treturn\n527: \t}\n528: \twriteJSON(w, http.StatusOK, pruneResponse{Removed: res.Removed, Running: res.Running})\n529: }\n530: \n531: // --- /projects/{project}/orphans (TASK-11) ----------------------------------\n532: \n533: // orphanRow is one orphaned worktree in the response — job.Orphan's fields.\n534: type orphanRow struct {\n535: \tName   string `json:\"name\"`\n536: \tDir    string `json:\"dir\"`\n537: \tGitDir string `json:\"gitDir\"`\n538: }\n539: \n540: // orphansResponse is the list-orphans endpoint's response shape.\n541: type orphansResponse struct {\n542: \tOrphans []orphanRow `json:\"orphans\"`\n543: }\n544: \n545: // handleProjectOrphans lists a project's orphaned worktrees (job.\n546: // DiscoverOrphans) — read-only, no lock.\n547: func (s *Server) handleProjectOrphans(w http.ResponseWriter, r *http.Request) {\n548: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n549: \tif !ok {\n550: \t\treturn\n551: \t}\n552: \torphans, err := job.DiscoverOrphans(root)\n553: \tif err != nil {\n554: \t\twriteError(w, http.StatusInternalServerError, \"cannot list orphaned worktrees\")\n555: \t\treturn\n556: \t}\n557: \trows := make([]orphanRow, 0, len(orphans))\n558: \tfor _, o := range orphans {\n559: \t\trows = append(rows, orphanRow{Name: o.Name, Dir: o.Dir, GitDir: o.GitDir})\n560: \t}\n561: \twriteJSON(w, http.StatusOK, orphansResponse{Orphans: rows})\n562: }\n563: \n564: // handleDeleteOrphan resolves one named orphan (job.MatchOrphan, exact then\n565: // prefix on the orphan's base name) and removes it (job.\n566: // RemoveOrphansConfirmed — the HTTP call itself is the confirmation, no\n567: // further prompt) under the project lock: RemoveOrphansConfirmed calls\n568: // git.WorktreePrune, which touches git worktree metadata and can race with a\n569: // concurrent create/done/delete on the same project — this task's own\n570: // reasoned addition, since the brief's Notes paragraph does not name orphan\n571: // cleanup in its git-mutating set at all.\n572: //\n573: // One named resource per call, consistent with every other mutating endpoint\n574: // in this API, rather than a single \"delete everything\" call that risks\n575: // removing something the caller didn't expect to see gone.\n576: func (s *Server) handleDeleteOrphan(w http.ResponseWriter, r *http.Request) {\n577: \troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n578: \tif !ok {\n579: \t\treturn\n580: \t}\n581: \tname := r.PathValue(\"name\")\n582: \tif !validSegment(name) {\n583: \t\twriteError(w, http.StatusNotFound, \"orphan not found\")\n584: \t\treturn\n585: \t}\n586: \to, found := job.MatchOrphan(root, name)\n587: \tif !found {\n588: \t\twriteError(w, http.StatusNotFound, fmt.Sprintf(\"orphan '%s' not found among the project's orphaned worktrees\", name))\n589: \t\treturn\n590: \t}\n591: \n592: \ts.locks.Lock(root)\n593: \tdefer s.locks.Unlock(root)\n594: \n595: \tvar out bytes.Buffer\n596: \tif err := job.RemoveOrphansConfirmed(root, []job.Orphan{o}, &out); err != nil {\n597: \t\twriteError(w, http.StatusInternalServerError, err.Error())\n598: \t\treturn\n599: \t}\n600: \twriteJSON(w, http.StatusOK, orphanRow{Name: o.Name, Dir: o.Dir, GitDir: o.GitDir})\n601: }\n\n(End of file - total 601 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/agentlist\"\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/launch\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/mutate.go","text":"package serve\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/agentlist\"\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/git\"\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/launch\"\n\t\"github.com/lmuskalla/manigot/internal/session\"\n)\n\n// maxJSONBodyBytes bounds every JSON request body this API decodes — a sane\n// cap well above any realistic request (a title, a profile name, a force\n// flag) while still refusing an unbounded upload.\nconst maxJSONBodyBytes = 1 << 20 // 1 MiB\n\n// approvedConfirm is the pre-approved job.ConfirmFunc every mutating endpoint\n// that wraps a confirm-gated job.* function passes: the HTTP call itself is\n// the confirmation, mirroring internal/ui/app.go's own yesConfirm — the same\n// precedent the TUI already established for its confirm-then-call pattern.\n// Any warning this API wants to gate behind an explicit decision (see\n// handleDoneJob's {\"force\":true} requirement) is intercepted before the\n// wrapped function's own confirm prompts are ever reached.\nfunc approvedConfirm(prompt string) (bool, error) { return true, nil }\n\n// decodeJSONBody decodes r's body into v, tolerating a fully empty body (a\n// zero-value v — every mutating endpoint's request body is either optional\n// or has every field itself optional). A non-empty-but-invalid body is a 400.\nfunc decodeJSONBody(w http.ResponseWriter, r *http.Request, v any) bool {\n\tif r.Body == nil || r.ContentLength == 0 {\n\t\treturn true\n\t}\n\tdec := json.NewDecoder(io.LimitReader(r.Body, maxJSONBodyBytes))\n\tif err := dec.Decode(v); err != nil {\n\t\tif errors.Is(err, io.EOF) {\n\t\t\treturn true // an empty body decodes as EOF — same as no body\n\t\t}\n\t\twriteError(w, http.StatusBadRequest, \"invalid JSON body\")\n\t\treturn false\n\t}\n\treturn true\n}\n\n// resolveProfile validates an optional profile string (from a request body),\n// defaulting to config.ProfileClaudePro like every other launch path (mg\n// jdi's own --profile flag, the session launcher). An unrecognized non-empty\n// value is reported to the caller (ok=false; the handler must return\n// immediately) rather than silently falling through to a launch failure deep\n// inside a container spin-up.\nfunc resolveProfile(w http.ResponseWriter, raw string) (profile string, ok bool) {\n\tprofile = strings.TrimSpace(raw)\n\tif profile == \"\" {\n\t\treturn config.ProfileClaudePro, true\n\t}\n\tif _, known := config.ProfileByID(profile); !known {\n\t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"unknown profile %q\", profile))\n\t\treturn \"\", false\n\t}\n\treturn profile, true\n}\n\n// --- POST /projects/{project}/jobs (TASK-3) ----------------------------------\n\n// createJobRequest is the create-job endpoint's request body. Type defaults\n// to \"feature\" when empty; BaseBranch optionally overrides the project's\n// configured base branch for this one job.\ntype createJobRequest struct {\n\tTitle      string `json:\"title\"`\n\tType       string `json:\"type\"`\n\tBaseBranch string `json:\"baseBranch\"`\n}\n\n// createJobResponse is the create-job endpoint's response: the created job's\n// row (the same shape GET .../jobs returns) plus the branch/worktree path\n// from job.CreateResult.\ntype createJobResponse struct {\n\tJob          jobRow `json:\"job\"`\n\tBranch       string `json:\"branch\"`\n\tWorktreePath string `json:\"worktreePath,omitempty\"`\n}\n\n// validJobTypes mirrors job.CreateJob's own accepted set (internal/job/\n// create.go) — checked here so a bad value is a clean 400 instead of\n// CreateJob's own \"Invalid type '...' ...\" error text surfacing as a 500.\nvar validJobTypes = map[string]bool{\"\": true, \"feature\": true, \"fix\": true, \"chore\": true}\n\n// jobRowFromJob builds a jobRow — the exact shape handleProjectJobs returns —\n// from an already-resolved job.Job, so a mutating endpoint's response carries\n// the identical fields a subsequent GET .../jobs listing would show for it.\nfunc jobRowFromJob(j job.Job) jobRow {\n\treturn jobRow{\n\t\tID:     j.ID,\n\t\tName:   j.Name,\n\t\tStatus: j.Status,\n\t\tStage:  string(j.Stage()),\n\t\tType:   j.Type,\n\t\tDate:   j.Date,\n\t\tTitle:  j.Title,\n\t\tBranch: j.Branch,\n\t}\n}\n\n// handleCreateJob creates a new job (job.CreateJob) under the project lock —\n// git-mutating: it creates a branch + worktree, one of the operations the\n// brief's Notes names explicitly.\nfunc (s *Server) handleCreateJob(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\tvar req createJobRequest\n\tif !decodeJSONBody(w, r, &req) {\n\t\treturn\n\t}\n\tif strings.TrimSpace(req.Title) == \"\" {\n\t\twriteError(w, http.StatusBadRequest, \"title is required\")\n\t\treturn\n\t}\n\tif !validJobTypes[req.Type] {\n\t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"invalid type %q — use feature, fix, or chore\", req.Type))\n\t\treturn\n\t}\n\n\ts.locks.Lock(root)\n\tdefer s.locks.Unlock(root)\n\n\tres, err := job.CreateJob(root, req.Title, job.CreateOptions{Type: req.Type, BaseBranchOverride: req.BaseBranch}, io.Discard)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusCreated, createJobResponse{\n\t\tJob:          jobRowFromJob(res.Job),\n\t\tBranch:       res.Branch,\n\t\tWorktreePath: res.WorktreePath,\n\t})\n}\n\n// --- PUT /projects/{project}/jobs/{job}/files/brief (TASK-4) -----------------\n\n// maxBriefBytes bounds the edit-brief endpoint's request body — a sane cap\n// well above any realistic brief.md while still refusing an unbounded upload.\nconst maxBriefBytes = 1 << 20 // 1 MiB\n\n// editBriefResponse is the edit-brief endpoint's response. Warning is set\n// only when the post-write commit sweep could not be attempted or failed —\n// the write itself already succeeded either way, so this is a diagnostic, not\n// a failure of the request.\ntype editBriefResponse struct {\n\tStatus  string `json:\"status\"`\n\tWarning string `json:\"warning,omitempty\"`\n}\n\n// handleEditBrief replaces a job's brief.md wholesale with the raw request\n// body — the one job file this API makes writable (tasks/implementation/\n// verdict stay read-only, written only by their respective agents: no\n// $EDITOR here, this is an HTTP body write) — then commits the change in the\n// job's own worktree via session.SweepJobWorktree (the same \"commit\n// everything uncommitted\" primitive every session-ending sweep already\n// uses), so the edit never sits as an uncommitted change waiting for\n// something else to sweep it.\n//\n// Takes the project lock: the commit itself touches git, even though the\n// brief's Notes paragraph only names create/done/delete/push explicitly in\n// its git-mutating set — a real race against a concurrent done/delete on the\n// same worktree otherwise (this task's own reasoned addition, not something\n// the brief pins either way).\nfunc (s *Server) handleEditBrief(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\tbody, err := io.ReadAll(io.LimitReader(r.Body, maxBriefBytes+1))\n\tif err != nil {\n\t\twriteError(w, http.StatusBadRequest, \"could not read request body\")\n\t\treturn\n\t}\n\tif len(body) == 0 {\n\t\twriteError(w, http.StatusBadRequest, \"request body must not be empty\")\n\t\treturn\n\t}\n\tif len(body) > maxBriefBytes {\n\t\twriteError(w, http.StatusBadRequest, fmt.Sprintf(\"request body exceeds the %d byte limit\", maxBriefBytes))\n\t\treturn\n\t}\n\n\ts.locks.Lock(root)\n\tdefer s.locks.Unlock(root)\n\n\tif err := os.WriteFile(filepath.Join(j.Dir, \"brief.md\"), body, 0o644); err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"could not write brief.md\")\n\t\treturn\n\t}\n\n\tresp := editBriefResponse{Status: \"ok\"}\n\tvar diag bytes.Buffer\n\tif wt, wtOK, werr := git.WorktreeForBranch(root, j.Branch); werr != nil {\n\t\tresp.Warning = \"brief.md written, but could not resolve the job's worktree to commit it: \" + werr.Error()\n\t} else if wtOK {\n\t\tsession.SweepJobWorktree(session.Root{ProjectRoot: wt, InvocationRoot: root, Job: j.Name}, &diag)\n\t\tif diag.Len() > 0 {\n\t\t\tresp.Warning = strings.TrimSpace(diag.String())\n\t\t}\n\t} else {\n\t\t// A branch with no registered worktree is an inconsistent state — the\n\t\t// edit is written but cannot be committed, so say so rather than\n\t\t// claiming a clean ok.\n\t\tresp.Warning = fmt.Sprintf(\"brief.md written, but branch '%s' has no registered worktree to commit it — the edit may be lost on a later checkout\", j.Branch)\n\t}\n\twriteJSON(w, http.StatusOK, resp)\n}\n\n// --- POST /projects/{project}/jobs/{job}/agents/{agent} (TASK-5) ------------\n\n// handleLaunchAgent launches one agent, one-shot, via internal/session's\n// RunOneShot/CommandAgentRunner (TASK-2) — never an attached/interactive\n// session, per the brief's explicit out-of-scope note. The agent name is\n// validated against agentlist.Discover(root) first, for a fast 404 on an\n// unknown agent rather than letting an invalid agent fail deep inside a\n// container spin-up. Does NOT take s.locks: launching an agent doesn't touch\n// git state and shouldn't block behind an unrelated done/delete (the brief's\n// own Notes).\n//\n// Responds 202 Accepted immediately — the run happens in a background\n// goroutine; the caller watches it via the session-log SSE stream (TASK-12)\n// or by polling GET .../jdi's sessionLog tail.\nfunc (s *Server) handleLaunchAgent(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\tagent := r.PathValue(\"agent\")\n\tif !validSegment(agent) {\n\t\twriteError(w, http.StatusNotFound, \"agent not found\")\n\t\treturn\n\t}\n\tagents, err := agentlist.Discover(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot list agents\")\n\t\treturn\n\t}\n\tknown := false\n\tfor _, a := range agents {\n\t\tif a.Name == agent {\n\t\t\tknown = true\n\t\t\tbreak\n\t\t}\n\t}\n\tif !known {\n\t\twriteError(w, http.StatusNotFound, fmt.Sprintf(\"agent '%s' not found\", agent))\n\t\treturn\n\t}\n\n\tvar req struct {\n\t\tProfile string `json:\"profile\"`\n\t}\n\tif !decodeJSONBody(w, r, &req) {\n\t\treturn\n\t}\n\tprofile, ok := resolveProfile(w, req.Profile)\n\tif !ok {\n\t\treturn\n\t}\n\n\trunner := &session.CommandAgentRunner{ProjectRoot: root, Profile: profile}\n\tgo session.RunOneShot(runner, agent, j)\n\n\twriteJSON(w, http.StatusAccepted, map[string]string{\"status\": \"started\", \"agent\": agent, \"job\": j.Name})\n}\n\n// --- POST /projects/{project}/jobs/{job}/jdi (TASK-6) -----------------------\n\n// handleLaunchJDI launches `mg jdi` detached for a job (launch.Jdi — already\n// exactly the shape this needs: a detached subprocess, no attached terminal,\n// stdio discarded, reaped asynchronously). Before launching it checks\n// job.ReadJDIStatus for an already-running state and rejects with 409 if\n// found — a best-effort guard (not airtight: two launches issued\n// back-to-back before the first process writes its own status sidecar could\n// still both proceed) against two concurrent mg-jdi loops racing on the same\n// job's git branch. No s.locks — same reasoning as handleLaunchAgent.\nfunc (s *Server) handleLaunchJDI(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\tif st, running := job.ReadJDIStatus(root, j.Name); running && st.State == job.JDIRunning {\n\t\twriteError(w, http.StatusConflict, fmt.Sprintf(\"mg jdi is already running for job '%s'\", j.Name))\n\t\treturn\n\t}\n\n\tvar req struct {\n\t\tProfile string `json:\"profile\"`\n\t}\n\tif !decodeJSONBody(w, r, &req) {\n\t\treturn\n\t}\n\tprofile, ok := resolveProfile(w, req.Profile)\n\tif !ok {\n\t\treturn\n\t}\n\n\tif err := launch.Jdi(j.Name, root, profile); err != nil {\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusAccepted, map[string]string{\"status\": \"started\", \"job\": j.Name})\n}\n\n// --- POST /projects/{project}/jobs/{job}/done (TASK-7) ----------------------\n\n// doneRequest is the done endpoint's request body: force, when true,\n// proceeds past the \"verdict not approved\" / \"no verdict.md\" warnings the CLI\n// would otherwise interactively confirm past — there is no human physically\n// reading a terminal warning over this API, so the default is to refuse\n// (409) rather than silently auto-approve a risky merge the way the TUI's\n// yesConfirm does today.\ntype doneRequest struct {\n\tForce bool `json:\"force\"`\n}\n\n// doneResponse is the done endpoint's response: the finished job's name, the\n// branch that was merged and deleted, and the base branch it was merged into.\ntype doneResponse struct {\n\tJobName    string `json:\"jobName\"`\n\tBranch     string `json:\"branch\"`\n\tBaseBranch string `json:\"baseBranch\"`\n}\n\n// doneVerdictWarning reproduces FinishJob's own pre-merge verdict check\n// (internal/job/finish.go) without duplicating its regex classification: it\n// reads the same job.Job.VerdictStatus/job.VerdictNotApproved exported\n// helpers FinishJob itself is built on, so the two can never drift. hasWarning\n// is true — with the CLI's own warning text — for exactly the three cases\n// FinishJob would otherwise interactively confirm past: an undetermined\n// status, a REJECTED/NEEDS WORK status, or a missing verdict.md.\nfunc doneVerdictWarning(j job.Job) (warning string, hasWarning bool) {\n\tverdictPath := filepath.Join(j.Dir, \"verdict.md\")\n\tswitch _, err := os.Stat(verdictPath); {\n\tcase err == nil:\n\t\tstatus := j.VerdictStatus()\n\t\tswitch {\n\t\tcase status == \"\":\n\t\t\treturn \"Warning: could not determine verdict status from verdict.md\", true\n\t\tcase job.VerdictNotApproved(status):\n\t\t\treturn fmt.Sprintf(\"Warning: verdict is '%s' — job is not approved.\", status), true\n\t\tdefault:\n\t\t\treturn \"\", false\n\t\t}\n\tcase os.IsNotExist(err):\n\t\treturn \"Warning: no verdict.md found — job has not been reviewed.\", true\n\tdefault:\n\t\treturn \"\", false // unreadable for some other reason — let FinishJob itself surface it\n\t}\n}\n\n// handleDoneJob archives a finished job (job.FinishJobWithOptions) under the\n// project lock (git-mutating, named explicitly in the brief's Notes).\n//\n// A squash-merge conflict is reported as a structured 409 error\n// (job.ErrSquashMergeConflict, via FinishOptions.NoConflictRecovery) and the\n// job is left exactly where FinishJob left it — no automatic rollback, no\n// automatic @git-solver handoff — per the brief's own explicit pinning that\n// this must not silently fall back to either of FinishJob's two interactive\n// behaviors; resolving it is an explicit follow-up decision through some\n// other call (e.g. launching @git-solver via the agent-launch endpoint, or\n// `mg host` from a terminal).\n//\n// Separately (not pinned by the brief at all): the earlier \"verdict not\n// approved\" / \"no verdict.md\" warnings require {\"force\": true} to proceed\n// past — a 409 echoing the CLI's own warning text when force is absent —\n// rather than silently auto-approving a risky merge the way the TUI's\n// yesConfirm does today.\nfunc (s *Server) handleDoneJob(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\tvar req doneRequest\n\tif !decodeJSONBody(w, r, &req) {\n\t\treturn\n\t}\n\n\tif warning, has := doneVerdictWarning(j); has && !req.Force {\n\t\twriteError(w, http.StatusConflict, warning+\" Pass {\\\"force\\\": true} to proceed anyway.\")\n\t\treturn\n\t}\n\n\ts.locks.Lock(root)\n\tdefer s.locks.Unlock(root)\n\n\tvar out bytes.Buffer\n\tres, err := job.FinishJobWithOptions(root, j.Name, approvedConfirm, &out, job.FinishOptions{NoConflictRecovery: true})\n\tif err != nil {\n\t\tif errors.Is(err, job.ErrSquashMergeConflict) {\n\t\t\twriteError(w, http.StatusConflict, err.Error())\n\t\t\treturn\n\t\t}\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, doneResponse{JobName: res.JobName, Branch: res.Branch, BaseBranch: res.BaseBranch})\n}\n\n// --- POST /projects/{project}/jobs/{job}/delete (TASK-8) --------------------\n\n// deleteJobResponse is the delete endpoint's response — job.DeleteResult's\n// fields.\ntype deleteJobResponse struct {\n\tJobName string `json:\"jobName\"`\n\tBranch  string `json:\"branch,omitempty\"`\n\tDir     string `json:\"dir\"`\n}\n\n// handleDeleteJob permanently deletes a job (job.DeleteJob) under the project\n// lock (git-mutating, named explicitly in the brief's Notes). The HTTP call\n// itself is the confirmation (approvedConfirm) — no merge step, so unlike\n// done there is no conflict-handling ambiguity here.\nfunc (s *Server) handleDeleteJob(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\ts.locks.Lock(root)\n\tdefer s.locks.Unlock(root)\n\n\tvar out bytes.Buffer\n\tres, err := job.DeleteJob(root, j.Name, approvedConfirm, &out)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, deleteJobResponse{JobName: res.JobName, Branch: res.Branch, Dir: res.Dir})\n}\n\n// --- POST /projects/{project}/jobs/{job}/push (TASK-9) ----------------------\n\n// pushTimeout bounds the push endpoint's git call, mirroring the TUI git\n// panel's own hostGitTimeout (src/internal/ui/app.go): long enough for a\n// real push, short enough that a stalled/unreachable remote can't hang the\n// request forever.\nconst pushTimeout = 30 * time.Second\n\n// handlePushJob pushes a job's branch to origin (git.PushWithContext — `git\n// push -u origin <branch>`, mirroring the TUI git panel's \"Push to origin\"\n// action) under the project lock (git-mutating, named explicitly in the\n// brief's Notes). A push failure (auth, network, non-fast-forward) surfaces\n// as a structured error with git's own message, never silently swallowed.\nfunc (s *Server) handlePushJob(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tj, ok := s.resolveJob(w, root, r.PathValue(\"job\"))\n\tif !ok {\n\t\treturn\n\t}\n\n\ts.locks.Lock(root)\n\tdefer s.locks.Unlock(root)\n\n\tctx, cancel := context.WithTimeout(r.Context(), pushTimeout)\n\tdefer cancel()\n\tif err := git.PushWithContext(ctx, root, j.Branch); err != nil {\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"pushed\", \"branch\": j.Branch})\n}\n\n// --- POST /prune (TASK-10) ---------------------------------------------------\n\n// pruneResponse mirrors mg prune's own reporting (session.PruneResult).\ntype pruneResponse struct {\n\tRemoved int `json:\"removed\"`\n\tRunning int `json:\"running\"`\n}\n\n// handlePrune wraps session.PruneOrphans — the same function cmd/mg/prune.go's\n// runPrune calls. Deliberately top-level (not nested under /projects/{project})\n// rather than project-scoped: orphaned manigot-* containers are not\n// partitioned by project (docker has no concept of \"which registered project\"\n// a leftover container belongs to). No s.locks: no git or project-scoped\n// state at all.\nfunc (s *Server) handlePrune(w http.ResponseWriter, r *http.Request) {\n\tres, err := session.PruneOrphans(io.Discard)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, pruneResponse{Removed: res.Removed, Running: res.Running})\n}\n\n// --- /projects/{project}/orphans (TASK-11) ----------------------------------\n\n// orphanRow is one orphaned worktree in the response — job.Orphan's fields.\ntype orphanRow struct {\n\tName   string `json:\"name\"`\n\tDir    string `json:\"dir\"`\n\tGitDir string `json:\"gitDir\"`\n}\n\n// orphansResponse is the list-orphans endpoint's response shape.\ntype orphansResponse struct {\n\tOrphans []orphanRow `json:\"orphans\"`\n}\n\n// handleProjectOrphans lists a project's orphaned worktrees (job.\n// DiscoverOrphans) — read-only, no lock.\nfunc (s *Server) handleProjectOrphans(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\torphans, err := job.DiscoverOrphans(root)\n\tif err != nil {\n\t\twriteError(w, http.StatusInternalServerError, \"cannot list orphaned worktrees\")\n\t\treturn\n\t}\n\trows := make([]orphanRow, 0, len(orphans))\n\tfor _, o := range orphans {\n\t\trows = append(rows, orphanRow{Name: o.Name, Dir: o.Dir, GitDir: o.GitDir})\n\t}\n\twriteJSON(w, http.StatusOK, orphansResponse{Orphans: rows})\n}\n\n// handleDeleteOrphan resolves one named orphan (job.MatchOrphan, exact then\n// prefix on the orphan's base name) and removes it (job.\n// RemoveOrphansConfirmed — the HTTP call itself is the confirmation, no\n// further prompt) under the project lock: RemoveOrphansConfirmed calls\n// git.WorktreePrune, which touches git worktree metadata and can race with a\n// concurrent create/done/delete on the same project — this task's own\n// reasoned addition, since the brief's Notes paragraph does not name orphan\n// cleanup in its git-mutating set at all.\n//\n// One named resource per call, consistent with every other mutating endpoint\n// in this API, rather than a single \"delete everything\" call that risks\n// removing something the caller didn't expect to see gone.\nfunc (s *Server) handleDeleteOrphan(w http.ResponseWriter, r *http.Request) {\n\troot, ok := s.resolveProject(w, r.PathValue(\"project\"))\n\tif !ok {\n\t\treturn\n\t}\n\tname := r.PathValue(\"name\")\n\tif !validSegment(name) {\n\t\twriteError(w, http.StatusNotFound, \"orphan not found\")\n\t\treturn\n\t}\n\to, found := job.MatchOrphan(root, name)\n\tif !found {\n\t\twriteError(w, http.StatusNotFound, fmt.Sprintf(\"orphan '%s' not found among the project's orphaned worktrees\", name))\n\t\treturn\n\t}\n\n\ts.locks.Lock(root)\n\tdefer s.locks.Unlock(root)\n\n\tvar out bytes.Buffer\n\tif err := job.RemoveOrphansConfirmed(root, []job.Orphan{o}, &out); err != nil {\n\t\twriteError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\twriteJSON(w, http.StatusOK, orphanRow{Name: o.Name, Dir: o.Dir, GitDir: o.GitDir})\n}","lineStart":1,"lineEnd":601,"totalLines":601,"truncated":false}},"title":"src/internal/serve/mutate.go","time":{"start":1787952903878,"end":1787952903882}},"id":"prt_04a4c36c2001aMup4oxTRMXNUQ","sessionID":"ses_fb5b402d5ffesBMXb1jVe3Cozl","messageID":"msg_04a4c304c001oiugSLa98Z2ZpL"}}
