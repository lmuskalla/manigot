{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ML46eQwmmA9sxybKbvmBnH","type":"tool_result","content":"1\tpackage session\n2\t\n3\timport (\n4\t\t\"errors\"\n5\t\t\"fmt\"\n6\t\t\"io\"\n7\t\t\"strings\"\n8\t\n9\t\t\"github.com/lmuskalla/manigot/internal/git\"\n10\t)\n11\t\n12\t// SweepJobWorktree commits whatever an agent session left uncommitted in a\n13\t// job worktree, after the container run has returned. It is the host-side\n14\t// guarantee behind \"every agent always commits\": agents don't reliably follow\n15\t// commit instructions, and the read-only agents — the analyst above all,\n16\t// whose tasks.md this commits — physically cannot commit at all (`commit:\n17\t// false` → read-only git mount), so the host sweeps the worktree after every\n18\t// job-worktree session and mg done's clean-tree check stops being tripped by\n19\t// agent leftovers.\n20\t//\n21\t// It is a no-op for a plain (non-job) session — root.Job == \"\" — where the\n22\t// user's own uncommitted work lives, and for any --job resolution that never\n23\t// left the main worktree — root.ProjectRoot == root.InvocationRoot — which\n24\t// covers two distinct shapes: the flat-scan fallback (a git repo with no\n25\t// local branches, or a non-git project: the job's files live directly in the\n26\t// main project root) and a pre-worktree job (the job's branch is checked out\n27\t// in the main worktree itself, an explicitly supported transitional state —\n28\t// see job.Discover / FinishJob's main-worktree handling —\n29\t// where git.WorktreeForBranch resolves to the main worktree, not a linked\n30\t// one). Both would otherwise commit the user's own uncommitted work —\n31\t// including an unexcluded .env — onto the job branch; a linked job worktree's\n32\t// ProjectRoot always differs from InvocationRoot, so the comparison is a\n33\t// precise worktree gate in every resolution shape.\n34\t// A clean worktree is not an error either (ErrNothingToCommit is swallowed),\n35\t// and a broken-worktree CommitAll failure of the ErrNotARepo kind is\n36\t// swallowed too. Any other failure warns on diag — stderr — and never aborts\n37\t// the caller.\n38\t//\n39\t// The sweep commit reuses the TUI \"c\" key's message convention\n40\t// ([<id>] chore: commit all), which deliberately does not match the\n41\t// verdict-commit pattern ([<id>] verdict: ...) that mg-jdi's retry budget and\n42\t// re-review decisions count (git.CountVerdictCommits /\n43\t// git.LatestCommitIsVerdict), so the state machine is unaffected. Because the\n44\t// sweep runs inside the session path — before mg-jdi's post-run stall probe\n45\t// reads HEAD — the sweep commit counts as agent progress there.\n46\tfunc SweepJobWorktree(root Root, diag io.Writer) {\n47\t\t// Job-worktree sessions only. root.Job alone is not enough: the --job\n48\t\t// flat-scan fallback and a pre-worktree job (branch checked out in the\n49\t\t// main worktree itself) both set Job while ProjectRoot never left the\n50\t\t// MAIN project root, where the user's own uncommitted work lives;\n51\t\t// sweeping there would commit it — .env included — as a commit on the job\n52\t\t// branch (or the repo's first commit, in the flat-scan case). A linked\n53\t\t// job worktree's ProjectRoot always differs from InvocationRoot, so that\n54\t\t// comparison is the worktree gate in every resolution shape.\n55\t\tif root.Job == \"\" || root.ProjectRoot == root.InvocationRoot {\n56\t\t\treturn\n57\t\t}\n58\t\tid := jobIDFromName(root.Job)\n59\t\tmsg := fmt.Sprintf(\"[%s] chore: commit all\", id)\n60\t\tif err := git.CommitAll(root.ProjectRoot, msg); err != nil {\n61\t\t\tswitch {\n62\t\t\tcase errors.Is(err, git.ErrNothingToCommit), errors.Is(err, git.ErrNotARepo):\n63\t\t\t\t// Clean worktree or a non-git job — nothing to sweep.\n64\t\t\tdefault:\n65\t\t\t\tfmt.Fprintf(diag, \"mg: warning: could not commit leftover changes in %s: %v\\n\", root.ProjectRoot, err)\n66\t\t\t}\n67\t\t\treturn\n68\t\t}\n69\t\tfmt.Fprintf(diag, \"mg: committed leftover changes in %s (%s).\\n\", root.ProjectRoot, msg)\n70\t}\n71\t\n72\t// jobIDFromName derives the job id from a job name (<id>_<slug>): everything\n73\t// before the first underscore — the slug part may itself contain underscores,\n74\t// so the split is on the first one only. Falls back to the whole name when\n75\t// there is no underscore, or when the id part is empty.\n76\tfunc jobIDFromName(name string) string {\n77\t\tid, _, _ := strings.Cut(name, \"_\")\n78\t\tif id == \"\" {\n79\t\t\treturn name\n80\t\t}\n81\t\treturn id\n82\t}\n83\t"}]},"parent_tool_use_id":null,"session_id":"ba948ea7-a157-4c42-8eb1-077540d9946d","uuid":"df347cca-45ef-497f-9dce-e47c20bfa1b8","timestamp":"2026-08-28T20:32:47.595Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/session/sweep.go","content":"package session\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"strings\"\n\n\t\"github.com/lmuskalla/manigot/internal/git\"\n)\n\n// SweepJobWorktree commits whatever an agent session left uncommitted in a\n// job worktree, after the container run has returned. It is the host-side\n// guarantee behind \"every agent always commits\": agents don't reliably follow\n// commit instructions, and the read-only agents — the analyst above all,\n// whose tasks.md this commits — physically cannot commit at all (`commit:\n// false` → read-only git mount), so the host sweeps the worktree after every\n// job-worktree session and mg done's clean-tree check stops being tripped by\n// agent leftovers.\n//\n// It is a no-op for a plain (non-job) session — root.Job == \"\" — where the\n// user's own uncommitted work lives, and for any --job resolution that never\n// left the main worktree — root.ProjectRoot == root.InvocationRoot — which\n// covers two distinct shapes: the flat-scan fallback (a git repo with no\n// local branches, or a non-git project: the job's files live directly in the\n// main project root) and a pre-worktree job (the job's branch is checked out\n// in the main worktree itself, an explicitly supported transitional state —\n// see job.Discover / FinishJob's main-worktree handling —\n// where git.WorktreeForBranch resolves to the main worktree, not a linked\n// one). Both would otherwise commit the user's own uncommitted work —\n// including an unexcluded .env — onto the job branch; a linked job worktree's\n// ProjectRoot always differs from InvocationRoot, so the comparison is a\n// precise worktree gate in every resolution shape.\n// A clean worktree is not an error either (ErrNothingToCommit is swallowed),\n// and a broken-worktree CommitAll failure of the ErrNotARepo kind is\n// swallowed too. Any other failure warns on diag — stderr — and never aborts\n// the caller.\n//\n// The sweep commit reuses the TUI \"c\" key's message convention\n// ([<id>] chore: commit all), which deliberately does not match the\n// verdict-commit pattern ([<id>] verdict: ...) that mg-jdi's retry budget and\n// re-review decisions count (git.CountVerdictCommits /\n// git.LatestCommitIsVerdict), so the state machine is unaffected. Because the\n// sweep runs inside the session path — before mg-jdi's post-run stall probe\n// reads HEAD — the sweep commit counts as agent progress there.\nfunc SweepJobWorktree(root Root, diag io.Writer) {\n\t// Job-worktree sessions only. root.Job alone is not enough: the --job\n\t// flat-scan fallback and a pre-worktree job (branch checked out in the\n\t// main worktree itself) both set Job while ProjectRoot never left the\n\t// MAIN project root, where the user's own uncommitted work lives;\n\t// sweeping there would commit it — .env included — as a commit on the job\n\t// branch (or the repo's first commit, in the flat-scan case). A linked\n\t// job worktree's ProjectRoot always differs from InvocationRoot, so that\n\t// comparison is the worktree gate in every resolution shape.\n\tif root.Job == \"\" || root.ProjectRoot == root.InvocationRoot {\n\t\treturn\n\t}\n\tid := jobIDFromName(root.Job)\n\tmsg := fmt.Sprintf(\"[%s] chore: commit all\", id)\n\tif err := git.CommitAll(root.ProjectRoot, msg); err != nil {\n\t\tswitch {\n\t\tcase errors.Is(err, git.ErrNothingToCommit), errors.Is(err, git.ErrNotARepo):\n\t\t\t// Clean worktree or a non-git job — nothing to sweep.\n\t\tdefault:\n\t\t\tfmt.Fprintf(diag, \"mg: warning: could not commit leftover changes in %s: %v\\n\", root.ProjectRoot, err)\n\t\t}\n\t\treturn\n\t}\n\tfmt.Fprintf(diag, \"mg: committed leftover changes in %s (%s).\\n\", root.ProjectRoot, msg)\n}\n\n// jobIDFromName derives the job id from a job name (<id>_<slug>): everything\n// before the first underscore — the slug part may itself contain underscores,\n// so the split is on the first one only. Falls back to the whole name when\n// there is no underscore, or when the id part is empty.\nfunc jobIDFromName(name string) string {\n\tid, _, _ := strings.Cut(name, \"_\")\n\tif id == \"\" {\n\t\treturn name\n\t}\n\treturn id\n}\n","numLines":83,"startLine":1,"totalLines":83}}}
