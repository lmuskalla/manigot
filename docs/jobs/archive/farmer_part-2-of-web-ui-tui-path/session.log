, \"\", \"\")\n512: \tif rec.Code != http.StatusOK {\n513: \t\tt.Fatalf(\"status = %d, want 200 (body %s)\", rec.Code, rec.Body.String())\n514: \t}\n515: \tvar body map[string]string\n516: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n517: \t\tt.Fatalf(\"body not JSON: %v\", err)\n518: \t}\n519: \tif body[\"status\"] != \"pushed\" {\n520: \t\tt.Errorf(\"body = %v, want status=pushed\", body)\n521: \t}\n522: \t// The branch exists on the remote.\n523: \tbranches := gitCmd(t, bare, \"branch\", \"--list\")\n524: \tif !strings.Contains(branches, \"feature/ab12cd_roundtrip-job\") {\n525: \t\tt.Errorf(\"remote branches = %q, want the pushed job branch\", branches)\n526: \t}\n527: }\n528: \n529: // --- TASK-10: POST /prune ----------------------------------------------------\n530: \n531: // TestHandlePruneReportsCounts: /prune mirrors mg prune's reporting. Docker is\n532: // absent in this environment, so the endpoint surfaces the docker error as a\n533: // structured 500 — the meaningful contract here is that the response is a\n534: // JSON envelope, never a silent no-op.\n535: func TestHandlePrune(t *testing.T) {\n536: \tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n537: \trec := post(t, srv, \"/prune\", \"\", \"\")\n538: \t// Docker is not available in the test env → 500 with the docker error.\n539: \tif rec.Code != http.StatusInternalServerError {\n540: \t\tt.Fatalf(\"status = %d, want 500 (docker unavailable) (body %s)\", rec.Code, rec.Body.String())\n541: \t}\n542: \tif !strings.Contains(rec.Body.String(), \"docker\") {\n543: \t\tt.Errorf(\"500 body missing the docker error: %s\", rec.Body.String())\n544: \t}\n545: }\n546: \n547: // --- TASK-11: /projects/{project}/orphans ------------------------------------\n548: \n549: // fakeOrphan creates a leftover worktree dir (a .git file pointing at a\n550: // nonexistent gitdir) under the project's nested .manigot-worktrees parent —\n551: // the shape DiscoverOrphans reports as an orphan.\n552: 