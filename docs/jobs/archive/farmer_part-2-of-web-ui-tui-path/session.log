{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ShBnTWjpgBdbffiE3A4kjQ","type":"tool_result","content":"1\tpackage main\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"os\"\n6\t\t\"os/exec\"\n7\t\t\"path/filepath\"\n8\t\t\"strings\"\n9\t\t\"testing\"\n10\t\t\"time\"\n11\t\n12\t\t\"github.com/lmuskalla/manigot/internal/job\"\n13\t\t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n14\t)\n15\t\n16\tfunc TestLogStarted(t *testing.T) {\n17\t\tvar buf bytes.Buffer\n18\t\tlogStarted(&buf, \"aaaa01_test-job\", \"claude-pro\")\n19\t\tgot := buf.String()\n20\t\tif !strings.Contains(got, \"mg jdi started\") {\n21\t\t\tt.Errorf(\"logStarted output missing 'mg jdi started', got:\\n%s\", got)\n22\t\t}\n23\t\tif !strings.Contains(got, \"aaaa01_test-job\") {\n24\t\t\tt.Errorf(\"logStarted output missing job name, got:\\n%s\", got)\n25\t\t}\n26\t\tif !strings.Contains(got, \"claude-pro\") {\n27\t\t\tt.Errorf(\"logStarted output missing profile, got:\\n%s\", got)\n28\t\t}\n29\t}\n30\t\n31\tfunc TestLogAgentInvoked(t *testing.T) {\n32\t\tvar buf bytes.Buffer\n33\t\tlogAgentInvoked(&buf, \"developer\", 2)\n34\t\tgot := buf.String()\n35\t\tif !strings.Contains(got, \"developer invoked (attempt 2)\") {\n36\t\t\tt.Errorf(\"logAgentInvoked output missing header, got:\\n%s\", got)\n37\t\t}\n38\t}\n39\t\n40\tfunc TestLogJobFinishedIncludesReasonByDefault(t *testing.T) {\n41\t\tvar buf bytes.Buffer\n42\t\tlogJobFinished(&buf, orchestrate.StopFinished, \"verdict.md's Overall verdict is APPROVED\", true)\n43\t\tgot := buf.String()\n44\t\tif !strings.Contains(got, \"mg jdi finished\") {\n45\t\t\tt.Errorf(\"logJobFinished output missing 'mg jdi finished', got:\\n%s\", got)\n46\t\t}\n47\t\tif !strings.Contains(got, \"stop-finished\") {\n48\t\t\tt.Errorf(\"logJobFinished output missing the outcome kind, got:\\n%s\", got)\n49\t\t}\n50\t\tif !strings.Contains(got, \"verdict.md's Overall verdict is APPROVED\") {\n51\t\t\tt.Errorf(\"logJobFinished output missing reason, got:\\n%s\", got)\n52\t\t}\n53\t}\n54\t\n55\tfunc TestLogJobFinishedOmitsReasonWhenAlreadyLogged(t *testing.T) {\n56\t\tvar buf bytes.Buffer\n57\t\tlogJobFinished(&buf, orchestrate.StopNeedsHuman, \"brief.md is not written yet\", false)\n58\t\tgot := buf.String()\n59\t\tif !strings.Contains(got, \"mg jdi finished\") {\n60\t\t\tt.Errorf(\"logJobFinished output missing 'mg jdi finished', got:\\n%s\", got)\n61\t\t}\n62\t\tif strings.Contains(got, \"brief.md is not written yet\") {\n63\t\t\tt.Errorf(\"logJobFinished output repeats reason despite includeReason=false, got:\\n%s\", got)\n64\t\t}\n65\t}\n66\t\n67\tfunc TestLogInvocationPlainText(t *testing.T) {\n68\t\tvar buf bytes.Buffer\n69\t\tlogInvocation(&buf, \"developer\", 1, []byte(\"did the thing\\n\"), \"\", \"\")\n70\t\tgot := buf.String()\n71\t\tif !strings.Contains(got, \"developer finished (attempt 1)\") {\n72\t\t\tt.Errorf(\"logInvocation output missing header, got:\\n%s\", got)\n73\t\t}\n74\t\tif !strings.Contains(got, \"did the thing\") {\n75\t\t\tt.Errorf(\"logInvocation output missing agent text, got:\\n%s\", got)\n76\t\t}\n77\t}\n78\t\n79\tfunc TestLogInvocationExtractsJSONResult(t *testing.T) {\n80\t\tvar buf bytes.Buffer\n81\t\traw := []byte(`{\"type\":\"result\",\"result\":\"All done, committed TASK-1.\"}`)\n82\t\tlogInvocation(&buf, \"developer\", 2, raw, \"\", \"\")\n83\t\tgot := buf.String()\n84\t\tif !strings.Contains(got, \"All done, committed TASK-1.\") {\n85\t\t\tt.Errorf(\"logInvocation did not extract the JSON result field, got:\\n%s\", got)\n86\t\t}\n87\t\tif strings.Contains(got, `\"type\":\"result\"`) {\n88\t\t\tt.Errorf(\"logInvocation leaked raw JSON into the log, got:\\n%s\", got)\n89\t\t}\n90\t}\n91\t\n92\tfunc TestLogInvocationEmptyOutput(t *testing.T) {\n93\t\tvar buf bytes.Buffer\n94\t\tlogInvocation(&buf, \"analyst\", 1, nil, \"\", \"\")\n95\t\tgot := buf.String()\n96\t\tif !strings.Contains(got, \"(no output)\") {\n97\t\t\tt.Errorf(\"logInvocation on empty output = %q, want it to note there was no output\", got)\n98\t\t}\n99\t}\n100\t\n101\t// --- TASK-5: dedup already-committed file content -----------------------\n102\t\n103\tfunc TestLogInvocationOmitsDuplicateOutput(t *testing.T) {\n104\t\tvar buf bytes.Buffer\n105\t\tfileContent := \"# Tasks\\n\\nTASK-1: do the thing\\n\"\n106\t\traw := []byte(\"Sure, here's what I wrote:\\n\\n\" + fileContent + \"\\nAll done!\")\n107\t\tlogInvocation(&buf, \"analyst\", 1, raw, \"tasks.md\", fileContent)\n108\t\tgot := buf.String()\n109\t\tif !strings.Contains(got, \"(output matches tasks.md, omitted)\") {\n110\t\t\tt.Errorf(\"logInvocation did not dedup matching output, got:\\n%s\", got)\n111\t\t}\n112\t\tif strings.Contains(got, \"TASK-1: do the thing\") {\n113\t\t\tt.Errorf(\"logInvocation printed the full duplicated text instead of omitting it, got:\\n%s\", got)\n114\t\t}\n115\t}\n116\t\n117\tfunc TestLogInvocationKeepsDistinctOutput(t *testing.T) {\n118\t\tvar buf bytes.Buffer\n119\t\tfileContent := \"# Tasks\\n\\nTASK-1: do the thing\\n\"\n120\t\traw := []byte(\"I analyzed the brief and decided on a different approach entirely.\")\n121\t\tlogInvocation(&buf, \"analyst\", 1, raw, \"tasks.md\", fileContent)\n122\t\tgot := buf.String()\n123\t\tif strings.Contains(got, \"omitted\") {\n124\t\t\tt.Errorf(\"logInvocation dedup'd distinct output, got:\\n%s\", got)\n125\t\t}\n126\t\tif !strings.Contains(got, \"I analyzed the brief\") {\n127\t\t\tt.Errorf(\"logInvocation output missing agent text, got:\\n%s\", got)\n128\t\t}\n129\t}\n130\t\n131\tfunc TestLogInvocationSkipsDedupWhenTargetFileEmpty(t *testing.T) {\n132\t\tvar buf bytes.Buffer\n133\t\traw := []byte(\"some response text\")\n134\t\tlogInvocation(&buf, \"analyst\", 1, raw, \"\", \"\")\n135\t\tgot := buf.String()\n136\t\tif strings.Contains(got, \"omitted\") {\n137\t\t\tt.Errorf(\"logInvocation dedup'd with no target file, got:\\n%s\", got)\n138\t\t}\n139\t\tif !strings.Contains(got, \"some response text\") {\n140\t\t\tt.Errorf(\"logInvocation output missing agent text, got:\\n%s\", got)\n141\t\t}\n142\t}\n143\t\n144\tfunc TestIsDuplicateOutput(t *testing.T) {\n145\t\tcases := []struct {\n146\t\t\tname        string\n147\t\t\ttext        string\n148\t\t\tfileContent string\n149\t\t\twant        bool\n150\t\t}{\n151\t\t\t{\"exact substring\", \"prose\\n# Tasks\\nTASK-1\\nmore prose\", \"# Tasks\\nTASK-1\", true},\n152\t\t\t{\"whitespace differs\", \"prose\\n#  Tasks\\n\\nTASK-1  \\nmore prose\", \"# Tasks\\nTASK-1\", true},\n153\t\t\t{\"not present\", \"totally different text\", \"# Tasks\\nTASK-1\", false},\n154\t\t\t{\"empty file content never matches\", \"anything at all\", \"\", false},\n155\t\t}\n156\t\tfor _, c := range cases {\n157\t\t\tt.Run(c.name, func(t *testing.T) {\n158\t\t\t\tif got := isDuplicateOutput(c.text, c.fileContent); got != c.want {\n159\t\t\t\t\tt.Errorf(\"isDuplicateOutput(%q, %q) = %v, want %v\", c.text, c.fileContent, got, c.want)\n160\t\t\t\t}\n161\t\t\t})\n162\t\t}\n163\t}\n164\t\n165\tfunc TestOpenRunLogCreatesSidecarAndAppends(t *testing.T) {\n166\t\troot := t.TempDir()\n167\t\tconst jobName = \"aaaa01_test-job\"\n168\t\n169\t\tf, _, err := openRunLog(root, jobName)\n170\t\tif err != nil {\n171\t\t\tt.Fatalf(\"openRunLog: %v\", err)\n172\t\t}\n173\t\tif _, err := f.WriteString(\"first run\\n\"); err != nil {\n174\t\t\tt.Fatal(err)\n175\t\t}\n176\t\tf.Close()\n177\t\n178\t\t// A second open must append, not truncate — a fresh mg-jdi run\n179\t\t// continues the same job's transcript.\n180\t\tf2, hadContent, err := openRunLog(root, jobName)\n181\t\tif err != nil {\n182\t\t\tt.Fatalf(\"openRunLog (second): %v\", err)\n183\t\t}\n184\t\tif !hadContent {\n185\t\t\tt.Error(\"second open of a non-empty run.log reported hadContent=false, want true\")\n186\t\t}\n187\t\tif _, err := f2.WriteString(\"second run\\n\"); err != nil {\n188\t\t\tt.Fatal(err)\n189\t\t}\n190\t\tf2.Close()\n191\t\n192\t\tdata, err := os.ReadFile(job.JDIRunLogPath(root, jobName))\n193\t\tif err != nil {\n194\t\t\tt.Fatalf(\"reading run.log: %v\", err)\n195\t\t}\n196\t\tgot := string(data)\n197\t\tif !strings.Contains(got, \"first run\") || !strings.Contains(got, \"second run\") {\n198\t\t\tt.Errorf(\"run.log = %q, want both writes present (append, not truncate)\", got)\n199\t\t}\n200\t}\n201\t\n202\tfunc TestOpenRunLogReportsEmptyFreshLog(t *testing.T) {\n203\t\troot := t.TempDir()\n204\t\tconst jobName = \"aaaa02_test-job\"\n205\t\n206\t\tf, hadContent, err := openRunLog(root, jobName)\n207\t\tif err != nil {\n208\t\t\tt.Fatalf(\"openRunLog: %v\", err)\n209\t\t}\n210\t\tif hadContent {\n211\t\t\tt.Error(\"first open of a fresh run.log reported hadContent=true, want false\")\n212\t\t}\n213\t\tf.Close()\n214\t}\n215\t\n216\t// TestRunLogSeparationAcrossRuns wires openRunLog and sectionWriter together\n217\t// exactly as main() does, across two runs of the same job: the first run\n218\t// ever written to the log starts it at the top (no leading blank line), and\n219\t// the second run's first header picks up the separating blank line.\n220\tfunc TestRunLogSeparationAcrossRuns(t *testing.T) {\n221\t\troot := t.TempDir()\n222\t\tconst jobName = \"aaaa03_test-job\"\n223\t\n224\t\trun := func() {\n225\t\t\tf, hadContent, err := openRunLog(root, jobName)\n226\t\t\tif err != nil {\n227\t\t\t\tt.Fatalf(\"openRunLog: %v\", err)\n228\t\t\t}\n229\t\t\tdefer f.Close()\n230\t\t\tw := &sectionWriter{w: f, wroteSection: hadContent}\n231\t\t\tlogStarted(w, jobName, \"claude-pro\")\n232\t\t\tlogJobFinished(w, orchestrate.StopFinished, \"verdict APPROVED\", true)\n233\t\t}\n234\t\n235\t\trun()\n236\t\tdata, err := os.ReadFile(job.JDIRunLogPath(root, jobName))\n237\t\tif err != nil {\n238\t\t\tt.Fatalf(\"reading run.log: %v\", err)\n239\t\t}\n240\t\tfirst := string(data)\n241\t\tif strings.HasPrefix(first, \"\\n\") {\n242\t\t\tt.Errorf(\"first run ever must not open the log with a blank line, got:\\n%q\", first)\n243\t\t}\n244\t\tif n := sectionHeaderCount(first); n != 2 {\n245\t\t\tt.Fatalf(\"first run wrote %d headers, want 2:\\n%q\", n, first)\n246\t\t}\n247\t\tif n := strings.Count(first, \"\\n\\n\\n===\"); n != 1 {\n248\t\t\tt.Errorf(\"first run should have exactly 1 separator (between its two headers), got %d:\\n%q\", n, first)\n249\t\t}\n250\t\n251\t\trun()\n252\t\tdata, err = os.ReadFile(job.JDIRunLogPath(root, jobName))\n253\t\tif err != nil {\n254\t\t\tt.Fatalf(\"reading run.log: %v\", err)\n255\t\t}\n256\t\tboth := string(data)\n257\t\tif n := sectionHeaderCount(both); n != 4 {\n258\t\t\tt.Fatalf(\"after two runs got %d headers, want 4:\\n%q\", n, both)\n259\t\t}\n260\t\tif n := strings.Count(both, \"\\n\\n\\n===\"); n != 3 {\n261\t\t\tt.Errorf(\"second run should add 2 separators (1 between its own headers + 1 from the prior run's last header), got %d:\\n%q\", n, both)\n262\t\t}\n263\t}\n264\t\n265\t// --- sectionWriter -----------------------------------------------------------\n266\t\n267\t// TestSectionWriterSeparatesHeadersButNotFirstRunEver covers the two\n268\t// sectionWriter behaviors together: within a single writer, the very first\n269\t// section header (a fresh log — the first run ever written to it) gets no\n270\t// leading blank line, while every subsequent header gets \"\\n\\n\", and\n271\t// non-header writes (an agent-text or reason body following its header)\n272\t// pass through untouched — sectionWriter never inserts blank lines inside a\n273\t// section. The invocation body's two blank lines of separation (brief: jdi\n274\t// logs new line) are logInvocation's own writes, asserted below.\n275\tfunc TestSectionWriterSeparatesHeadersButNotFirstRunEver(t *testing.T) {\n276\t\tvar buf bytes.Buffer\n277\t\tw := &sectionWriter{w: &buf, wroteSection: false}\n278\t\n279\t\tlogStarted(w, \"aaaa01_test-job\", \"claude-pro\")\n280\t\tlogAgentInvoked(w, \"analyst\", 1)\n281\t\tlogInvocation(w, \"analyst\", 1, []byte(\"wrote tasks.md\"), \"\", \"\")\n282\t\tlogJobFinished(w, orchestrate.StopFinished, \"verdict APPROVED\", true)\n283\t\n284\t\tgot := buf.String()\n285\t\tif strings.HasPrefix(got, \"\\n\") {\n286\t\t\tt.Errorf(\"fresh log must start at the top with no leading blank line, got:\\n%q\", got)\n287\t\t}\n288\t\t// Every header line after the first must be preceded by a blank line —\n289\t\t// the separator is \"\\n\\n\" on top of the preceding header's own trailing\n290\t\t// newline, so between two headers the text reads \"\\n\\n\\n===\", and that\n291\t\t// separator must appear exactly once per header after the first.\n292\t\tif n := sectionHeaderCount(got); n != 4 {\n293\t\t\tt.Fatalf(\"got %d section headers, want 4:\\n%q\", n, got)\n294\t\t}\n295\t\tif n := strings.Count(got, \"\\n\\n\\n===\"); n != 3 {\n296\t\t\tt.Errorf(\"got %d blank-line separators, want 3 (one before every header but the first):\\n%q\", n, got)\n297\t\t}\n298\t\t// The invocation body is deliberately separated from its \"finished\"\n299\t\t// header by two blank lines (brief: jdi logs new line): the header's own\n300\t\t// trailing newline plus the two blank lines reads as\n301\t\t// \"finished (attempt 1) ===\\n\\n\\nwrote tasks.md\", so the agent's output\n302\t\t// no longer looks glued to the finished statement.\n303\t\tif !strings.Contains(got, \"finished (attempt 1) ===\\n\\n\\nwrote tasks.md\") {\n304\t\t\tt.Errorf(\"expected two blank lines between the finished header and its body, got:\\n%q\", got)\n305\t\t}\n306\t\tif strings.Contains(got, \"finished (attempt 1) ===\\n\\n\\n\\nwrote tasks.md\") {\n307\t\t\tt.Errorf(\"more than two blank lines between the finished header and its body, got:\\n%q\", got)\n308\t\t}\n309\t}\n310\t\n311\t// TestSectionWriterJoinsPriorRunWithBlankLine covers the \"second run\" case:\n312\t// a run.log that already has content (wroteSection seeded true) must get the\n313\t// separating blank line before its very first header too.\n314\tfunc TestSectionWriterJoinsPriorRunWithBlankLine(t *testing.T) {\n315\t\tvar buf bytes.Buffer\n316\t\tbuf.WriteString(\"=== 2026-01-01T00:00:00Z mg jdi started: job aaaa01, profile claude-pro ===\\n\")\n317\t\tw := &sectionWriter{w: &buf, wroteSection: true}\n318\t\n319\t\tlogStarted(w, \"aaaa01_test-job\", \"claude-pro\")\n320\t\tlogAgentInvoked(w, \"reviewer\", 1)\n321\t\n322\t\tgot := buf.String()\n323\t\tif n := sectionHeaderCount(got); n != 3 {\n324\t\t\tt.Fatalf(\"got %d section headers, want 3:\\n%q\", n, got)\n325\t\t}\n326\t\tif n := strings.Count(got, \"\\n\\n\\n===\"); n != 2 {\n327\t\t\tt.Errorf(\"got %d blank-line separators, want 2 (before both of this run's headers — the prior run's own header was the first ever written, so it correctly has none):\\n%q\", n, got)\n328\t\t}\n329\t}\n330\t\n331\t// sectionHeaderCount counts the \"=== ... ===\" state-log header lines in s —\n332\t// lines that begin (at the very start, or right after a newline) with \"===\".\n333\t// Counting occurrences of the \"===\" literal itself would overcount, since\n334\t// each header line both opens and closes with it.\n335\tfunc sectionHeaderCount(s string) int {\n336\t\tn := 0\n337\t\tfor _, line := range strings.Split(s, \"\\n\") {\n338\t\t\tif strings.HasPrefix(line, \"===\") {\n339\t\t\t\tn++\n340\t\t\t}\n341\t\t}\n342\t\treturn n\n343\t}\n344\t\n345\t// TestSectionWriterPassesThroughNonHeaders ensures a write that does not\n346\t// begin with the \"===\" literal — e.g. an invocation's agent text or a stop\n347\t// reason — is never prefixed, so blank lines only ever separate sections.\n348\tfunc TestSectionWriterPassesThroughNonHeaders(t *testing.T) {\n349\t\tvar buf bytes.Buffer\n350\t\tw := &sectionWriter{w: &buf, wroteSection: true}\n351\t\n352\t\t// A reason line written straight through must not pick up a prefix.\n353\t\tif _, err := w.Write([]byte(\"brief.md is not written yet\\n\")); err != nil {\n354\t\t\tt.Fatal(err)\n355\t\t}\n356\t\t// A subsequent real header still gets separated from it.\n357\t\tlogImmediateStop(w, \"brief.md is not written yet\")\n358\t\n359\t\tgot := buf.String()\n360\t\tif !strings.HasPrefix(got, \"brief.md is not written yet\\n\") {\n361\t\t\tt.Errorf(\"non-header write was not passed through verbatim, got:\\n%q\", got)\n362\t\t}\n363\t\tif n := strings.Count(got, \"\\n\\n\\n===\"); n != 1 {\n364\t\t\tt.Errorf(\"got %d separators, want exactly 1 (only before the header):\\n%q\", n, got)\n365\t\t}\n366\t}\n367\t\n368\t// --- ensureSidecarIgnored ----------------------------------------------------\n369\t//\n370\t// Regression coverage for a bug a real end-to-end mg-jdi run (TASK-14) caught:\n371\t// without this, an agent's own `git add -A` (run inside the container against\n372\t// the *target project*, not manigot's own checkout) swept the status/run.log\n373\t// sidecar straight into a real job-branch commit.\n374\t\n375\tfunc gitRunForOutputTest(t *testing.T, dir string, args ...string) {\n376\t\tt.Helper()\n377\t\tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n378\t\tif out, err := cmd.CombinedOutput(); err != nil {\n379\t\t\tt.Fatalf(\"git %s in %s: %v\\n%s\", strings.Join(args, \" \"), dir, err, out)\n380\t\t}\n381\t}\n382\t\n383\tfunc initGitRepoForOutputTest(t *testing.T) string {\n384\t\tt.Helper()\n385\t\tdir := t.TempDir()\n386\t\tgitRunForOutputTest(t, dir, \"init\", \"-q\")\n387\t\tgitRunForOutputTest(t, dir, \"config\", \"user.email\", \"t@example.com\")\n388\t\tgitRunForOutputTest(t, dir, \"config\", \"user.name\", \"Test\")\n389\t\tgitRunForOutputTest(t, dir, \"config\", \"commit.gpgsign\", \"false\")\n390\t\tif err := os.WriteFile(filepath.Join(dir, \"README\"), []byte(\"init\\n\"), 0o644); err != nil {\n391\t\t\tt.Fatal(err)\n392\t\t}\n393\t\tgitRunForOutputTest(t, dir, \"add\", \"README\")\n394\t\tgitRunForOutputTest(t, dir, \"commit\", \"-q\", \"-m\", \"init\")\n395\t\treturn dir\n396\t}\n397\t\n398\tfunc TestEnsureSidecarIgnoredWritesExcludeFile(t *testing.T) {\n399\t\troot := initGitRepoForOutputTest(t)\n400\t\n401\t\tif err := ensureSidecarIgnored(root); err != nil {\n402\t\t\tt.Fatalf(\"ensureSidecarIgnored: %v\", err)\n403\t\t}\n404\t\n405\t\tdata, err := os.ReadFile(filepath.Join(root, \".git\", \"info\", \"exclude\"))\n406\t\tif err != nil {\n407\t\t\tt.Fatalf(\"reading .git/info/exclude: %v\", err)\n408\t\t}\n409\t\tif !strings.Contains(string(data), \".manigot/jdi-status/\") {\n410\t\t\tt.Errorf(\".git/info/exclude = %q, want it to contain .manigot/jdi-status/\", string(data))\n411\t\t}\n412\t}\n413\t\n414\tfunc TestEnsureSidecarIgnoredIsIdempotent(t *testing.T) {\n415\t\troot := initGitRepoForOutputTest(t)\n416\t\n417\t\tif err := ensureSidecarIgnored(root); err != nil {\n418\t\t\tt.Fatal(err)\n419\t\t}\n420\t\tif err := ensureSidecarIgnored(root); err != nil {\n421\t\t\tt.Fatal(err)\n422\t\t}\n423\t\n424\t\tdata, err := os.ReadFile(filepath.Join(root, \".git\", \"info\", \"exclude\"))\n425\t\tif err != nil {\n426\t\t\tt.Fatal(err)\n427\t\t}\n428\t\tcount := strings.Count(string(data), \".manigot/jdi-status/\")\n429\t\tif count != 1 {\n430\t\t\tt.Errorf(\"pattern appears %d times after two calls, want exactly 1 (idempotent)\", count)\n431\t\t}\n432\t}\n433\t\n434\tfunc TestEnsureSidecarIgnoredPreservesExistingContent(t *testing.T) {\n435\t\troot := initGitRepoForOutputTest(t)\n436\t\texcludeDir := filepath.Join(root, \".git\", \"info\")\n437\t\tif err := os.MkdirAll(excludeDir, 0o755); err != nil {\n438\t\t\tt.Fatal(err)\n439\t\t}\n440\t\tif err := os.WriteFile(filepath.Join(excludeDir, \"exclude\"), []byte(\"*.local\\n\"), 0o644); err != nil {\n441\t\t\tt.Fatal(err)\n442\t\t}\n443\t\n444\t\tif err := ensureSidecarIgnored(root); err != nil {\n445\t\t\tt.Fatal(err)\n446\t\t}\n447\t\n448\t\tdata, err := os.ReadFile(filepath.Join(excludeDir, \"exclude\"))\n449\t\tif err != nil {\n450\t\t\tt.Fatal(err)\n451\t\t}\n452\t\tgot := string(data)\n453\t\tif !strings.Contains(got, \"*.local\") {\n454\t\t\tt.Errorf(\".git/info/exclude lost its pre-existing content: %q\", got)\n455\t\t}\n456\t\tif !strings.Contains(got, \".manigot/jdi-status/\") {\n457\t\t\tt.Errorf(\".git/info/exclude missing the sidecar pattern: %q\", got)\n458\t\t}\n459\t}\n460\t\n461\t// TestEnsureSidecarIgnoredActuallyWorksWithGit is the real regression test:\n462\t// after ensureSidecarIgnored, `git add -A` inside the project must not pick\n463\t// up the sidecar directory at all — the exact scenario the TASK-14 manual\n464\t// run caught.\n465\tfunc TestEnsureSidecarIgnoredActuallyWorksWithGit(t *testing.T) {\n466\t\troot := initGitRepoForOutputTest(t)\n467\t\tif err := ensureSidecarIgnored(root); err != nil {\n468\t\t\tt.Fatal(err)\n469\t\t}\n470\t\n471\t\tsidecarFile := filepath.Join(root, \".manigot\", \"jdi-status\", \"aaaa01_x\", \"status\")\n472\t\tif err := os.MkdirAll(filepath.Dir(sidecarFile), 0o755); err != nil {\n473\t\t\tt.Fatal(err)\n474\t\t}\n475\t\tif err := os.WriteFile(sidecarFile, []byte(\"{}\"), 0o644); err != nil {\n476\t\t\tt.Fatal(err)\n477\t\t}\n478\t\t// A normal job file, tracked as usual, to prove add -A isn't just a\n479\t\t// no-op — it should still pick this up.\n480\t\tjobFile := filepath.Join(root, \"docs\", \"jobs\", \"aaaa01_x\", \"tasks.md\")\n481\t\tif err := os.MkdirAll(filepath.Dir(jobFile), 0o755); err != nil {\n482\t\t\tt.Fatal(err)\n483\t\t}\n484\t\tif err := os.WriteFile(jobFile, []byte(\"# Tasks\\n\"), 0o644); err != nil {\n485\t\t\tt.Fatal(err)\n486\t\t}\n487\t\n488\t\tgitRunForOutputTest(t, root, \"add\", \"-A\")\n489\t\n490\t\tout, err := exec.Command(\"git\", \"-C\", root, \"diff\", \"--cached\", \"--name-only\").Output()\n491\t\tif err != nil {\n492\t\t\tt.Fatal(err)\n493\t\t}\n494\t\tstaged := string(out)\n495\t\tif strings.Contains(staged, \"jdi-status\") {\n496\t\t\tt.Errorf(\"git add -A staged the sidecar despite ensureSidecarIgnored:\\n%s\", staged)\n497\t\t}\n498\t\tif !strings.Contains(staged, \"docs/jobs/aaaa01_x/tasks.md\") {\n499\t\t\tt.Errorf(\"git add -A did not stage the real job file — test itself is broken:\\n%s\", staged)\n500\t\t}\n501\t}\n502\t\n503\t// --- session.log live-stream helper (openSessionLog + sessionLog) ----------\n504\t\n505\t// writeAndClose streams raw into a freshly opened session.log section and\n506\t// closes it, failing the test on either error.\n507\tfunc writeAndClose(t *testing.T, path, agent string, attempt int, raw []byte) {\n508\t\tt.Helper()\n509\t\ts, err := openSessionLog(path, agent, attempt)\n510\t\tif err != nil {\n511\t\t\tt.Fatalf(\"openSessionLog: %v\", err)\n512\t\t}\n513\t\tif _, err := s.Write(raw); err != nil {\n514\t\t\tt.Fatalf(\"sessionLog.Write: %v\", err)\n515\t\t}\n516\t\tif err := s.Close(); err != nil {\n517\t\t\tt.Fatalf(\"sessionLog.Close: %v\", err)\n518\t\t}\n519\t}\n520\t\n521\tfunc TestOpenSessionLogCreatesOnFirstUse(t *testing.T) {\n522\t\tpath := filepath.Join(t.TempDir(), \"session.log\")\n523\t\twriteAndClose(t, path, \"analyst\", 1, []byte(\"Wrote tasks.md.\\n\"))\n524\t\tdata, err := os.ReadFile(path)\n525\t\tif err != nil {\n526\t\t\tt.Fatalf(\"reading session.log: %v\", err)\n527\t\t}\n528\t\tgot := string(data)\n529\t\tif !strings.Contains(got, \"analyst (attempt 1)\") {\n530\t\t\tt.Errorf(\"session.log = %q, want an analyst (attempt 1) header\", got)\n531\t\t}\n532\t\tif !strings.Contains(got, \"Wrote tasks.md.\") {\n533\t\t\tt.Errorf(\"session.log = %q, want the raw output preserved\", got)\n534\t\t}\n535\t}\n536\t\n537\tfunc TestOpenSessionLogAppendsAcrossSections(t *testing.T) {\n538\t\tpath := filepath.Join(t.TempDir(), \"session.log\")\n539\t\twriteAndClose(t, path, \"analyst\", 1, []byte(\"first output\\n\"))\n540\t\twriteAndClose(t, path, \"developer\", 2, []byte(\"second output\\n\"))\n541\t\tdata, err := os.ReadFile(path)\n542\t\tif err != nil {\n543\t\t\tt.Fatal(err)\n544\t\t}\n545\t\tgot := string(data)\n546\t\tif i, j := strings.Index(got, \"analyst (attempt 1)\"), strings.Index(got, \"developer (attempt 2)\"); i == -1 || j == -1 || i > j {\n547\t\t\tt.Errorf(\"session.log sections out of order or missing, got:\\n%s\", got)\n548\t\t}\n549\t\tif i, j := strings.Index(got, \"first output\"), strings.Index(got, \"second output\"); i == -1 || j == -1 || i > j {\n550\t\t\tt.Errorf(\"session.log raw outputs out of order or missing, got:\\n%s\", got)\n551\t\t}\n552\t}\n553\t\n554\tfunc TestOpenSessionLogHeaderCarriesAgentAttemptTimestamp(t *testing.T) {\n555\t\tpath := filepath.Join(t.TempDir(), \"session.log\")\n556\t\twriteAndClose(t, path, \"reviewer\", 3, []byte(\"ok\\n\"))\n557\t\tdata, err := os.ReadFile(path)\n558\t\tif err != nil {\n559\t\t\tt.Fatal(err)\n560\t\t}\n561\t\t// The header is the first line: \"=== <RFC3339 timestamp> <agent>\n562\t\t// (attempt N) ===\".\n563\t\tline, _, _ := strings.Cut(string(data), \"\\n\")\n564\t\tif !strings.HasPrefix(line, \"=== \") || !strings.HasSuffix(line, \" reviewer (attempt 3) ===\") {\n565\t\t\tt.Fatalf(\"header line = %q, want %q shape\", line, \"=== <timestamp> reviewer (attempt 3) ===\")\n566\t\t}\n567\t\tts := strings.TrimSuffix(strings.TrimPrefix(line, \"=== \"), \" reviewer (attempt 3) ===\")\n568\t\tif _, err := time.Parse(time.RFC3339, ts); err != nil {\n569\t\t\tt.Errorf(\"header timestamp %q is not RFC3339: %v\", ts, err)\n570\t\t}\n571\t}\n572\t\n573\tfunc TestOpenSessionLogPreservesRawVerbatim(t *testing.T) {\n574\t\tpath := filepath.Join(t.TempDir(), \"session.log\")\n575\t\traw := []byte(\"line one\\nline two\\nline three\\n\")\n576\t\twriteAndClose(t, path, \"analyst\", 1, raw)\n577\t\tdata, err := os.ReadFile(path)\n578\t\tif err != nil {\n579\t\t\tt.Fatal(err)\n580\t\t}\n581\t\tif !strings.Contains(string(data), \"line one\\nline two\\nline three\\n\") {\n582\t\t\tt.Errorf(\"session.log = %q, want the raw bytes preserved verbatim\", string(data))\n583\t\t}\n584\t}\n585\t\n586\tfunc TestOpenSessionLogSectionsSeparated(t *testing.T) {\n587\t\tpath := filepath.Join(t.TempDir(), \"session.log\")\n588\t\t// Two sections where the first's raw output deliberately lacks a\n589\t\t// trailing newline: the blank-line separator plus the trailing-newline\n590\t\t// guarantee must keep the second section's header from gluing to it.\n591\t\twriteAndClose(t, path, \"analyst\", 1, []byte(\"no trailing newline\"))\n592\t\twriteAndClose(t, path, \"developer\", 1, []byte(\"second\\n\"))\n593\t\tdata, err := os.ReadFile(path)\n594\t\tif err != nil {\n595\t\t\tt.Fatal(err)\n596\t\t}\n597\t\tgot := string(data)\n598\t\tif !strings.Contains(got, \"no trailing newline\\n\\n=== \") {\n599\t\t\tt.Errorf(\"sections not separated by a blank line, got:\\n%q\", got)\n600\t\t}\n601\t}\n602\t\n603\tfunc TestOpenSessionLogTrailingNewlineGuarantee(t *testing.T) {\n604\t\t// Raw output without a trailing newline gets one appended on Close...\n605\t\tpath := filepath.Join(t.TempDir(), \"session.log\")\n606\t\twriteAndClose(t, path, \"analyst\", 1, []byte(\"no newline\"))\n607\t\tdata, err := os.ReadFile(path)\n608\t\tif err != nil {\n609\t\t\tt.Fatal(err)\n610\t\t}\n611\t\tif !strings.HasSuffix(string(data), \"no newline\\n\") {\n612\t\t\tt.Errorf(\"session.log = %q, want the raw output to end with a newline\", string(data))\n613\t\t}\n614\t\t// ...and output that already ends with one is not double-newlined.\n615\t\tpath2 := filepath.Join(t.TempDir(), \"session.log\")\n616\t\twriteAndClose(t, path2, \"analyst\", 1, []byte(\"has newline\\n\"))\n617\t\tdata2, err := os.ReadFile(path2)\n618\t\tif err != nil {\n619\t\t\tt.Fatal(err)\n620\t\t}\n621\t\tif strings.HasSuffix(string(data2), \"has newline\\n\\n\") {\n622\t\t\tt.Errorf(\"session.log = %q, want exactly one trailing newline\", string(data2))\n623\t\t}\n624\t}\n625\t\n626\tfunc TestOpenSessionLogEmptyRawStillWritesHeader(t *testing.T) {\n627\t\tpath := filepath.Join(t.TempDir(), \"session.log\")\n628\t\t// An invocation that produces no output still opens + closes its\n629\t\t// section: the header (with its own trailing newline) is the section.\n630\t\ts, err := openSessionLog(path, \"analyst\", 1)\n631\t\tif err != nil {\n632\t\t\tt.Fatal(err)\n633\t\t}\n634\t\tif err := s.Close(); err != nil {\n635\t\t\tt.Fatal(err)\n636\t\t}\n637\t\tdata, err := os.ReadFile(path)\n638\t\tif err != nil {\n639\t\t\tt.Fatal(err)\n640\t\t}\n641\t\tif got := string(data); !strings.Contains(got, \"analyst (attempt 1)\") {\n642\t\t\tt.Errorf(\"session.log = %q, want the header even for empty output\", got)\n643\t\t}\n644\t\tif !strings.HasSuffix(string(data), \"===\\n\") {\n645\t\t\tt.Errorf(\"session.log = %q, want the header's own newline as the section end\", string(data))\n646\t\t}\n647\t}\n648\t"}]},"parent_tool_use_id":null,"session_id":"ba948ea7-a157-4c42-8eb1-077540d9946d","uuid":"a0742c86-643b-47b7-960c-91d65daad170","timestamp":"2026-08-28T20:24:40.758Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/cmd/mg/jdioutput_test.go","content":"package main\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n\t\"github.com/lmuskalla/manigot/internal/orchestrate\"\n)\n\nfunc TestLogStarted(t *testing.T) {\n\tvar buf bytes.Buffer\n\tlogStarted(&buf, \"aaaa01_test-job\", \"claude-pro\")\n\tgot := buf.String()\n\tif !strings.Contains(got, \"mg jdi started\") {\n\t\tt.Errorf(\"logStarted output missing 'mg jdi started', got:\\n%s\", got)\n\t}\n\tif !strings.Contains(got, \"aaaa01_test-job\") {\n\t\tt.Errorf(\"logStarted output missing job name, got:\\n%s\", got)\n\t}\n\tif !strings.Contains(got, \"claude-pro\") {\n\t\tt.Errorf(\"logStarted output missing profile, got:\\n%s\", got)\n\t}\n}\n\nfunc TestLogAgentInvoked(t *testing.T) {\n\tvar buf bytes.Buffer\n\tlogAgentInvoked(&buf, \"developer\", 2)\n\tgot := buf.String()\n\tif !strings.Contains(got, \"developer invoked (attempt 2)\") {\n\t\tt.Errorf(\"logAgentInvoked output missing header, got:\\n%s\", got)\n\t}\n}\n\nfunc TestLogJobFinishedIncludesReasonByDefault(t *testing.T) {\n\tvar buf bytes.Buffer\n\tlogJobFinished(&buf, orchestrate.StopFinished, \"verdict.md's Overall verdict is APPROVED\", true)\n\tgot := buf.String()\n\tif !strings.Contains(got, \"mg jdi finished\") {\n\t\tt.Errorf(\"logJobFinished output missing 'mg jdi finished', got:\\n%s\", got)\n\t}\n\tif !strings.Contains(got, \"stop-finished\") {\n\t\tt.Errorf(\"logJobFinished output missing the outcome kind, got:\\n%s\", got)\n\t}\n\tif !strings.Contains(got, \"verdict.md's Overall verdict is APPROVED\") {\n\t\tt.Errorf(\"logJobFinished output missing reason, got:\\n%s\", got)\n\t}\n}\n\nfunc TestLogJobFinishedOmitsReasonWhenAlreadyLogged(t *testing.T) {\n\tvar buf bytes.Buffer\n\tlogJobFinished(&buf, orchestrate.StopNeedsHuman, \"brief.md is not written yet\", false)\n\tgot := buf.String()\n\tif !strings.Contains(got, \"mg jdi finished\") {\n\t\tt.Errorf(\"logJobFinished output missing 'mg jdi finished', got:\\n%s\", got)\n\t}\n\tif strings.Contains(got, \"brief.md is not written yet\") {\n\t\tt.Errorf(\"logJobFinished output repeats reason despite includeReason=false, got:\\n%s\", got)\n\t}\n}\n\nfunc TestLogInvocationPlainText(t *testing.T) {\n\tvar buf bytes.Buffer\n\tlogInvocation(&buf, \"developer\", 1, []byte(\"did the thing\\n\"), \"\", \"\")\n\tgot := buf.String()\n\tif !strings.Contains(got, \"developer finished (attempt 1)\") {\n\t\tt.Errorf(\"logInvocation output missing header, got:\\n%s\", got)\n\t}\n\tif !strings.Contains(got, \"did the thing\") {\n\t\tt.Errorf(\"logInvocation output missing agent text, got:\\n%s\", got)\n\t}\n}\n\nfunc TestLogInvocationExtractsJSONResult(t *testing.T) {\n\tvar buf bytes.Buffer\n\traw := []byte(`{\"type\":\"result\",\"result\":\"All done, committed TASK-1.\"}`)\n\tlogInvocation(&buf, \"developer\", 2, raw, \"\", \"\")\n\tgot := buf.String()\n\tif !strings.Contains(got, \"All done, committed TASK-1.\") {\n\t\tt.Errorf(\"logInvocation did not extract the JSON result field, got:\\n%s\", got)\n\t}\n\tif strings.Contains(got, `\"type\":\"result\"`) {\n\t\tt.Errorf(\"logInvocation leaked raw JSON into the log, got:\\n%s\", got)\n\t}\n}\n\nfunc TestLogInvocationEmptyOutput(t *testing.T) {\n\tvar buf bytes.Buffer\n\tlogInvocation(&buf, \"analyst\", 1, nil, \"\", \"\")\n\tgot := buf.String()\n\tif !strings.Contains(got, \"(no output)\") {\n\t\tt.Errorf(\"logInvocation on empty output = %q, want it to note there was no output\", got)\n\t}\n}\n\n// --- TASK-5: dedup already-committed file content -----------------------\n\nfunc TestLogInvocationOmitsDuplicateOutput(t *testing.T) {\n\tvar buf bytes.Buffer\n\tfileContent := \"# Tasks\\n\\nTASK-1: do the thing\\n\"\n\traw := []byte(\"Sure, here's what I wrote:\\n\\n\" + fileContent + \"\\nAll done!\")\n\tlogInvocation(&buf, \"analyst\", 1, raw, \"tasks.md\", fileContent)\n\tgot := buf.String()\n\tif !strings.Contains(got, \"(output matches tasks.md, omitted)\") {\n\t\tt.Errorf(\"logInvocation did not dedup matching output, got:\\n%s\", got)\n\t}\n\tif strings.Contains(got, \"TASK-1: do the thing\") {\n\t\tt.Errorf(\"logInvocation printed the full duplicated text instead of omitting it, got:\\n%s\", got)\n\t}\n}\n\nfunc TestLogInvocationKeepsDistinctOutput(t *testing.T) {\n\tvar buf bytes.Buffer\n\tfileContent := \"# Tasks\\n\\nTASK-1: do the thing\\n\"\n\traw := []byte(\"I analyzed the brief and decided on a different approach entirely.\")\n\tlogInvocation(&buf, \"analyst\", 1, raw, \"tasks.md\", fileContent)\n\tgot := buf.String()\n\tif strings.Contains(got, \"omitted\") {\n\t\tt.Errorf(\"logInvocation dedup'd distinct output, got:\\n%s\", got)\n\t}\n\tif !strings.Contains(got, \"I analyzed the brief\") {\n\t\tt.Errorf(\"logInvocation output missing agent text, got:\\n%s\", got)\n\t}\n}\n\nfunc TestLogInvocationSkipsDedupWhenTargetFileEmpty(t *testing.T) {\n\tvar buf bytes.Buffer\n\traw := []byte(\"some response text\")\n\tlogInvocation(&buf, \"analyst\", 1, raw, \"\", \"\")\n\tgot := buf.String()\n\tif strings.Contains(got, \"omitted\") {\n\t\tt.Errorf(\"logInvocation dedup'd with no target file, got:\\n%s\", got)\n\t}\n\tif !strings.Contains(got, \"some response text\") {\n\t\tt.Errorf(\"logInvocation output missing agent text, got:\\n%s\", got)\n\t}\n}\n\nfunc TestIsDuplicateOutput(t *testing.T) {\n\tcases := []struct {\n\t\tname        string\n\t\ttext        string\n\t\tfileContent string\n\t\twant        bool\n\t}{\n\t\t{\"exact substring\", \"prose\\n# Tasks\\nTASK-1\\nmore prose\", \"# Tasks\\nTASK-1\", true},\n\t\t{\"whitespace differs\", \"prose\\n#  Tasks\\n\\nTASK-1  \\nmore prose\", \"# Tasks\\nTASK-1\", true},\n\t\t{\"not present\", \"totally different text\", \"# Tasks\\nTASK-1\", false},\n\t\t{\"empty file content never matches\", \"anything at all\", \"\", false},\n\t}\n\tfor _, c := range cases {\n\t\tt.Run(c.name, func(t *testing.T) {\n\t\t\tif got := isDuplicateOutput(c.text, c.fileContent); got != c.want {\n\t\t\t\tt.Errorf(\"isDuplicateOutput(%q, %q) = %v, want %v\", c.text, c.fileContent, got, c.want)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestOpenRunLogCreatesSidecarAndAppends(t *testing.T) {\n\troot := t.TempDir()\n\tconst jobName = \"aaaa01_test-job\"\n\n\tf, _, err := openRunLog(root, jobName)\n\tif err != nil {\n\t\tt.Fatalf(\"openRunLog: %v\", err)\n\t}\n\tif _, err := f.WriteString(\"first run\\n\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.Close()\n\n\t// A second open must append, not truncate — a fresh mg-jdi run\n\t// continues the same job's transcript.\n\tf2, hadContent, err := openRunLog(root, jobName)\n\tif err != nil {\n\t\tt.Fatalf(\"openRunLog (second): %v\", err)\n\t}\n\tif !hadContent {\n\t\tt.Error(\"second open of a non-empty run.log reported hadContent=false, want true\")\n\t}\n\tif _, err := f2.WriteString(\"second run\\n\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf2.Close()\n\n\tdata, err := os.ReadFile(job.JDIRunLogPath(root, jobName))\n\tif err != nil {\n\t\tt.Fatalf(\"reading run.log: %v\", err)\n\t}\n\tgot := string(data)\n\tif !strings.Contains(got, \"first run\") || !strings.Contains(got, \"second run\") {\n\t\tt.Errorf(\"run.log = %q, want both writes present (append, not truncate)\", got)\n\t}\n}\n\nfunc TestOpenRunLogReportsEmptyFreshLog(t *testing.T) {\n\troot := t.TempDir()\n\tconst jobName = \"aaaa02_test-job\"\n\n\tf, hadContent, err := openRunLog(root, jobName)\n\tif err != nil {\n\t\tt.Fatalf(\"openRunLog: %v\", err)\n\t}\n\tif hadContent {\n\t\tt.Error(\"first open of a fresh run.log reported hadContent=true, want false\")\n\t}\n\tf.Close()\n}\n\n// TestRunLogSeparationAcrossRuns wires openRunLog and sectionWriter together\n// exactly as main() does, across two runs of the same job: the first run\n// ever written to the log starts it at the top (no leading blank line), and\n// the second run's first header picks up the separating blank line.\nfunc TestRunLogSeparationAcrossRuns(t *testing.T) {\n\troot := t.TempDir()\n\tconst jobName = \"aaaa03_test-job\"\n\n\trun := func() {\n\t\tf, hadContent, err := openRunLog(root, jobName)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"openRunLog: %v\", err)\n\t\t}\n\t\tdefer f.Close()\n\t\tw := &sectionWriter{w: f, wroteSection: hadContent}\n\t\tlogStarted(w, jobName, \"claude-pro\")\n\t\tlogJobFinished(w, orchestrate.StopFinished, \"verdict APPROVED\", true)\n\t}\n\n\trun()\n\tdata, err := os.ReadFile(job.JDIRunLogPath(root, jobName))\n\tif err != nil {\n\t\tt.Fatalf(\"reading run.log: %v\", err)\n\t}\n\tfirst := string(data)\n\tif strings.HasPrefix(first, \"\\n\") {\n\t\tt.Errorf(\"first run ever must not open the log with a blank line, got:\\n%q\", first)\n\t}\n\tif n := sectionHeaderCount(first); n != 2 {\n\t\tt.Fatalf(\"first run wrote %d headers, want 2:\\n%q\", n, first)\n\t}\n\tif n := strings.Count(first, \"\\n\\n\\n===\"); n != 1 {\n\t\tt.Errorf(\"first run should have exactly 1 separator (between its two headers), got %d:\\n%q\", n, first)\n\t}\n\n\trun()\n\tdata, err = os.ReadFile(job.JDIRunLogPath(root, jobName))\n\tif err != nil {\n\t\tt.Fatalf(\"reading run.log: %v\", err)\n\t}\n\tboth := string(data)\n\tif n := sectionHeaderCount(both); n != 4 {\n\t\tt.Fatalf(\"after two runs got %d headers, want 4:\\n%q\", n, both)\n\t}\n\tif n := strings.Count(both, \"\\n\\n\\n===\"); n != 3 {\n\t\tt.Errorf(\"second run should add 2 separators (1 between its own headers + 1 from the prior run's last header), got %d:\\n%q\", n, both)\n\t}\n}\n\n// --- sectionWriter -----------------------------------------------------------\n\n// TestSectionWriterSeparatesHeadersButNotFirstRunEver covers the two\n// sectionWriter behaviors together: within a single writer, the very first\n// section header (a fresh log — the first run ever written to it) gets no\n// leading blank line, while every subsequent header gets \"\\n\\n\", and\n// non-header writes (an agent-text or reason body following its header)\n// pass through untouched — sectionWriter never inserts blank lines inside a\n// section. The invocation body's two blank lines of separation (brief: jdi\n// logs new line) are logInvocation's own writes, asserted below.\nfunc TestSectionWriterSeparatesHeadersButNotFirstRunEver(t *testing.T) {\n\tvar buf bytes.Buffer\n\tw := &sectionWriter{w: &buf, wroteSection: false}\n\n\tlogStarted(w, \"aaaa01_test-job\", \"claude-pro\")\n\tlogAgentInvoked(w, \"analyst\", 1)\n\tlogInvocation(w, \"analyst\", 1, []byte(\"wrote tasks.md\"), \"\", \"\")\n\tlogJobFinished(w, orchestrate.StopFinished, \"verdict APPROVED\", true)\n\n\tgot := buf.String()\n\tif strings.HasPrefix(got, \"\\n\") {\n\t\tt.Errorf(\"fresh log must start at the top with no leading blank line, got:\\n%q\", got)\n\t}\n\t// Every header line after the first must be preceded by a blank line —\n\t// the separator is \"\\n\\n\" on top of the preceding header's own trailing\n\t// newline, so between two headers the text reads \"\\n\\n\\n===\", and that\n\t// separator must appear exactly once per header after the first.\n\tif n := sectionHeaderCount(got); n != 4 {\n\t\tt.Fatalf(\"got %d section headers, want 4:\\n%q\", n, got)\n\t}\n\tif n := strings.Count(got, \"\\n\\n\\n===\"); n != 3 {\n\t\tt.Errorf(\"got %d blank-line separators, want 3 (one before every header but the first):\\n%q\", n, got)\n\t}\n\t// The invocation body is deliberately separated from its \"finished\"\n\t// header by two blank lines (brief: jdi logs new line): the header's own\n\t// trailing newline plus the two blank lines reads as\n\t// \"finished (attempt 1) ===\\n\\n\\nwrote tasks.md\", so the agent's output\n\t// no longer looks glued to the finished statement.\n\tif !strings.Contains(got, \"finished (attempt 1) ===\\n\\n\\nwrote tasks.md\") {\n\t\tt.Errorf(\"expected two blank lines between the finished header and its body, got:\\n%q\", got)\n\t}\n\tif strings.Contains(got, \"finished (attempt 1) ===\\n\\n\\n\\nwrote tasks.md\") {\n\t\tt.Errorf(\"more than two blank lines between the finished header and its body, got:\\n%q\", got)\n\t}\n}\n\n// TestSectionWriterJoinsPriorRunWithBlankLine covers the \"second run\" case:\n// a run.log that already has content (wroteSection seeded true) must get the\n// separating blank line before its very first header too.\nfunc TestSectionWriterJoinsPriorRunWithBlankLine(t *testing.T) {\n\tvar buf bytes.Buffer\n\tbuf.WriteString(\"=== 2026-01-01T00:00:00Z mg jdi started: job aaaa01, profile claude-pro ===\\n\")\n\tw := &sectionWriter{w: &buf, wroteSection: true}\n\n\tlogStarted(w, \"aaaa01_test-job\", \"claude-pro\")\n\tlogAgentInvoked(w, \"reviewer\", 1)\n\n\tgot := buf.String()\n\tif n := sectionHeaderCount(got); n != 3 {\n\t\tt.Fatalf(\"got %d section headers, want 3:\\n%q\", n, got)\n\t}\n\tif n := strings.Count(got, \"\\n\\n\\n===\"); n != 2 {\n\t\tt.Errorf(\"got %d blank-line separators, want 2 (before both of this run's headers — the prior run's own header was the first ever written, so it correctly has none):\\n%q\", n, got)\n\t}\n}\n\n// sectionHeaderCount counts the \"=== ... ===\" state-log header lines in s —\n// lines that begin (at the very start, or right after a newline) with \"===\".\n// Counting occurrences of the \"===\" literal itself would overcount, since\n// each header line both opens and closes with it.\nfunc sectionHeaderCount(s string) int {\n\tn := 0\n\tfor _, line := range strings.Split(s, \"\\n\") {\n\t\tif strings.HasPrefix(line, \"===\") {\n\t\t\tn++\n\t\t}\n\t}\n\treturn n\n}\n\n// TestSectionWriterPassesThroughNonHeaders ensures a write that does not\n// begin with the \"===\" literal — e.g. an invocation's agent text or a stop\n// reason — is never prefixed, so blank lines only ever separate sections.\nfunc TestSectionWriterPassesThroughNonHeaders(t *testing.T) {\n\tvar buf bytes.Buffer\n\tw := &sectionWriter{w: &buf, wroteSection: true}\n\n\t// A reason line written straight through must not pick up a prefix.\n\tif _, err := w.Write([]byte(\"brief.md is not written yet\\n\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// A subsequent real header still gets separated from it.\n\tlogImmediateStop(w, \"brief.md is not written yet\")\n\n\tgot := buf.String()\n\tif !strings.HasPrefix(got, \"brief.md is not written yet\\n\") {\n\t\tt.Errorf(\"non-header write was not passed through verbatim, got:\\n%q\", got)\n\t}\n\tif n := strings.Count(got, \"\\n\\n\\n===\"); n != 1 {\n\t\tt.Errorf(\"got %d separators, want exactly 1 (only before the header):\\n%q\", n, got)\n\t}\n}\n\n// --- ensureSidecarIgnored ----------------------------------------------------\n//\n// Regression coverage for a bug a real end-to-end mg-jdi run (TASK-14) caught:\n// without this, an agent's own `git add -A` (run inside the container against\n// the *target project*, not manigot's own checkout) swept the status/run.log\n// sidecar straight into a real job-branch commit.\n\nfunc gitRunForOutputTest(t *testing.T, dir string, args ...string) {\n\tt.Helper()\n\tcmd := exec.Command(\"git\", append([]string{\"-C\", dir}, args...)...)\n\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"git %s in %s: %v\\n%s\", strings.Join(args, \" \"), dir, err, out)\n\t}\n}\n\nfunc initGitRepoForOutputTest(t *testing.T) string {\n\tt.Helper()\n\tdir := t.TempDir()\n\tgitRunForOutputTest(t, dir, \"init\", \"-q\")\n\tgitRunForOutputTest(t, dir, \"config\", \"user.email\", \"t@example.com\")\n\tgitRunForOutputTest(t, dir, \"config\", \"user.name\", \"Test\")\n\tgitRunForOutputTest(t, dir, \"config\", \"commit.gpgsign\", \"false\")\n\tif err := os.WriteFile(filepath.Join(dir, \"README\"), []byte(\"init\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgitRunForOutputTest(t, dir, \"add\", \"README\")\n\tgitRunForOutputTest(t, dir, \"commit\", \"-q\", \"-m\", \"init\")\n\treturn dir\n}\n\nfunc TestEnsureSidecarIgnoredWritesExcludeFile(t *testing.T) {\n\troot := initGitRepoForOutputTest(t)\n\n\tif err := ensureSidecarIgnored(root); err != nil {\n\t\tt.Fatalf(\"ensureSidecarIgnored: %v\", err)\n\t}\n\n\tdata, err := os.ReadFile(filepath.Join(root, \".git\", \"info\", \"exclude\"))\n\tif err != nil {\n\t\tt.Fatalf(\"reading .git/info/exclude: %v\", err)\n\t}\n\tif !strings.Contains(string(data), \".manigot/jdi-status/\") {\n\t\tt.Errorf(\".git/info/exclude = %q, want it to contain .manigot/jdi-status/\", string(data))\n\t}\n}\n\nfunc TestEnsureSidecarIgnoredIsIdempotent(t *testing.T) {\n\troot := initGitRepoForOutputTest(t)\n\n\tif err := ensureSidecarIgnored(root); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := ensureSidecarIgnored(root); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tdata, err := os.ReadFile(filepath.Join(root, \".git\", \"info\", \"exclude\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcount := strings.Count(string(data), \".manigot/jdi-status/\")\n\tif count != 1 {\n\t\tt.Errorf(\"pattern appears %d times after two calls, want exactly 1 (idempotent)\", count)\n\t}\n}\n\nfunc TestEnsureSidecarIgnoredPreservesExistingContent(t *testing.T) {\n\troot := initGitRepoForOutputTest(t)\n\texcludeDir := filepath.Join(root, \".git\", \"info\")\n\tif err := os.MkdirAll(excludeDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(excludeDir, \"exclude\"), []byte(\"*.local\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tif err := ensureSidecarIgnored(root); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tdata, err := os.ReadFile(filepath.Join(excludeDir, \"exclude\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgot := string(data)\n\tif !strings.Contains(got, \"*.local\") {\n\t\tt.Errorf(\".git/info/exclude lost its pre-existing content: %q\", got)\n\t}\n\tif !strings.Contains(got, \".manigot/jdi-status/\") {\n\t\tt.Errorf(\".git/info/exclude missing the sidecar pattern: %q\", got)\n\t}\n}\n\n// TestEnsureSidecarIgnoredActuallyWorksWithGit is the real regression test:\n// after ensureSidecarIgnored, `git add -A` inside the project must not pick\n// up the sidecar directory at all — the exact scenario the TASK-14 manual\n// run caught.\nfunc TestEnsureSidecarIgnoredActuallyWorksWithGit(t *testing.T) {\n\troot := initGitRepoForOutputTest(t)\n\tif err := ensureSidecarIgnored(root); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tsidecarFile := filepath.Join(root, \".manigot\", \"jdi-status\", \"aaaa01_x\", \"status\")\n\tif err := os.MkdirAll(filepath.Dir(sidecarFile), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(sidecarFile, []byte(\"{}\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// A normal job file, tracked as usual, to prove add -A isn't just a\n\t// no-op — it should still pick this up.\n\tjobFile := filepath.Join(root, \"docs\", \"jobs\", \"aaaa01_x\", \"tasks.md\")\n\tif err := os.MkdirAll(filepath.Dir(jobFile), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(jobFile, []byte(\"# Tasks\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tgitRunForOutputTest(t, root, \"add\", \"-A\")\n\n\tout, err := exec.Command(\"git\", \"-C\", root, \"diff\", \"--cached\", \"--name-only\").Output()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstaged := string(out)\n\tif strings.Contains(staged, \"jdi-status\") {\n\t\tt.Errorf(\"git add -A staged the sidecar despite ensureSidecarIgnored:\\n%s\", staged)\n\t}\n\tif !strings.Contains(staged, \"docs/jobs/aaaa01_x/tasks.md\") {\n\t\tt.Errorf(\"git add -A did not stage the real job file — test itself is broken:\\n%s\", staged)\n\t}\n}\n\n// --- session.log live-stream helper (openSessionLog + sessionLog) ----------\n\n// writeAndClose streams raw into a freshly opened session.log section and\n// closes it, failing the test on either error.\nfunc writeAndClose(t *testing.T, path, agent string, attempt int, raw []byte) {\n\tt.Helper()\n\ts, err := openSessionLog(path, agent, attempt)\n\tif err != nil {\n\t\tt.Fatalf(\"openSessionLog: %v\", err)\n\t}\n\tif _, err := s.Write(raw); err != nil {\n\t\tt.Fatalf(\"sessionLog.Write: %v\", err)\n\t}\n\tif err := s.Close(); err != nil {\n\t\tt.Fatalf(\"sessionLog.Close: %v\", err)\n\t}\n}\n\nfunc TestOpenSessionLogCreatesOnFirstUse(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\twriteAndClose(t, path, \"analyst\", 1, []byte(\"Wrote tasks.md.\\n\"))\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatalf(\"reading session.log: %v\", err)\n\t}\n\tgot := string(data)\n\tif !strings.Contains(got, \"analyst (attempt 1)\") {\n\t\tt.Errorf(\"session.log = %q, want an analyst (attempt 1) header\", got)\n\t}\n\tif !strings.Contains(got, \"Wrote tasks.md.\") {\n\t\tt.Errorf(\"session.log = %q, want the raw output preserved\", got)\n\t}\n}\n\nfunc TestOpenSessionLogAppendsAcrossSections(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\twriteAndClose(t, path, \"analyst\", 1, []byte(\"first output\\n\"))\n\twriteAndClose(t, path, \"developer\", 2, []byte(\"second output\\n\"))\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgot := string(data)\n\tif i, j := strings.Index(got, \"analyst (attempt 1)\"), strings.Index(got, \"developer (attempt 2)\"); i == -1 || j == -1 || i > j {\n\t\tt.Errorf(\"session.log sections out of order or missing, got:\\n%s\", got)\n\t}\n\tif i, j := strings.Index(got, \"first output\"), strings.Index(got, \"second output\"); i == -1 || j == -1 || i > j {\n\t\tt.Errorf(\"session.log raw outputs out of order or missing, got:\\n%s\", got)\n\t}\n}\n\nfunc TestOpenSessionLogHeaderCarriesAgentAttemptTimestamp(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\twriteAndClose(t, path, \"reviewer\", 3, []byte(\"ok\\n\"))\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// The header is the first line: \"=== <RFC3339 timestamp> <agent>\n\t// (attempt N) ===\".\n\tline, _, _ := strings.Cut(string(data), \"\\n\")\n\tif !strings.HasPrefix(line, \"=== \") || !strings.HasSuffix(line, \" reviewer (attempt 3) ===\") {\n\t\tt.Fatalf(\"header line = %q, want %q shape\", line, \"=== <timestamp> reviewer (attempt 3) ===\")\n\t}\n\tts := strings.TrimSuffix(strings.TrimPrefix(line, \"=== \"), \" reviewer (attempt 3) ===\")\n\tif _, err := time.Parse(time.RFC3339, ts); err != nil {\n\t\tt.Errorf(\"header timestamp %q is not RFC3339: %v\", ts, err)\n\t}\n}\n\nfunc TestOpenSessionLogPreservesRawVerbatim(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\traw := []byte(\"line one\\nline two\\nline three\\n\")\n\twriteAndClose(t, path, \"analyst\", 1, raw)\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !strings.Contains(string(data), \"line one\\nline two\\nline three\\n\") {\n\t\tt.Errorf(\"session.log = %q, want the raw bytes preserved verbatim\", string(data))\n\t}\n}\n\nfunc TestOpenSessionLogSectionsSeparated(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\t// Two sections where the first's raw output deliberately lacks a\n\t// trailing newline: the blank-line separator plus the trailing-newline\n\t// guarantee must keep the second section's header from gluing to it.\n\twriteAndClose(t, path, \"analyst\", 1, []byte(\"no trailing newline\"))\n\twriteAndClose(t, path, \"developer\", 1, []byte(\"second\\n\"))\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgot := string(data)\n\tif !strings.Contains(got, \"no trailing newline\\n\\n=== \") {\n\t\tt.Errorf(\"sections not separated by a blank line, got:\\n%q\", got)\n\t}\n}\n\nfunc TestOpenSessionLogTrailingNewlineGuarantee(t *testing.T) {\n\t// Raw output without a trailing newline gets one appended on Close...\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\twriteAndClose(t, path, \"analyst\", 1, []byte(\"no newline\"))\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !strings.HasSuffix(string(data), \"no newline\\n\") {\n\t\tt.Errorf(\"session.log = %q, want the raw output to end with a newline\", string(data))\n\t}\n\t// ...and output that already ends with one is not double-newlined.\n\tpath2 := filepath.Join(t.TempDir(), \"session.log\")\n\twriteAndClose(t, path2, \"analyst\", 1, []byte(\"has newline\\n\"))\n\tdata2, err := os.ReadFile(path2)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif strings.HasSuffix(string(data2), \"has newline\\n\\n\") {\n\t\tt.Errorf(\"session.log = %q, want exactly one trailing newline\", string(data2))\n\t}\n}\n\nfunc TestOpenSessionLogEmptyRawStillWritesHeader(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\t// An invocation that produces no output still opens + closes its\n\t// section: the header (with its own trailing newline) is the section.\n\ts, err := openSessionLog(path, \"analyst\", 1)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := s.Close(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif got := string(data); !strings.Contains(got, \"analyst (attempt 1)\") {\n\t\tt.Errorf(\"session.log = %q, want the header even for empty output\", got)\n\t}\n\tif !strings.HasSuffix(string(data), \"===\\n\") {\n\t\tt.Errorf(\"session.log = %q, want the header's own newline as the section end\", string(data))\n\t}\n}\n","numLines":648,"startLine":1,"totalLines":648}}}
