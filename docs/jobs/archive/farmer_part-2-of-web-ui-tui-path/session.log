{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EyCQXvQQGghU8L1V2cMEUb","type":"tool_result","content":"1\tpackage job\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"errors\"\n6\t\t\"os\"\n7\t\t\"os/exec\"\n8\t\t\"path/filepath\"\n9\t\t\"strings\"\n10\t\t\"testing\"\n11\t)\n12\t\n13\t// yesConfirm answers every prompt with yes.\n14\tfunc yesConfirm(prompt string) (bool, error) { return true, nil }\n15\t\n16\t// noConfirm answers every prompt with no.\n17\tfunc noConfirm(prompt string) (bool, error) { return false, nil }\n18\t\n19\t// recordingConfirm answers with yes and records every prompt asked.\n20\tfunc recordingConfirm(recorded *[]string) ConfirmFunc {\n21\t\treturn func(prompt string) (bool, error) {\n22\t\t\t*recorded = append(*recorded, prompt)\n23\t\t\treturn true, nil\n24\t\t}\n25\t}\n26\t\n27\t// decliningGitSolverConfirm answers yes to every prompt except the @git-solver\n28\t// offer, which it declines — the \"roll back and leave the repo clean\" path.\n29\tfunc decliningGitSolverConfirm(recorded *[]string) ConfirmFunc {\n30\t\treturn func(prompt string) (bool, error) {\n31\t\t\t*recorded = append(*recorded, prompt)\n32\t\t\tif strings.Contains(prompt, \"@git-solver\") {\n33\t\t\t\treturn false, nil\n34\t\t\t}\n35\t\t\treturn true, nil\n36\t\t}\n37\t}\n38\t\n39\t// conflictJob sets up a job whose squash merge into main will conflict: both\n40\t// sides modify docs/jobs/.gitkeep differently. Returns the create result.\n41\tfunc conflictJob(t *testing.T) (root string, res CreateResult) {\n42\t\tt.Helper()\n43\t\troot, res = createWorkedJob(t)\n44\t\twriteTestFile(t, filepath.Join(root, \"docs\", \"jobs\", \".gitkeep\"), \"main side\\n\")\n45\t\tgitCmd(t, root, \"add\", \"-A\")\n46\t\tgitCmd(t, root, \"commit\", \"-q\", \"-m\", \"main side change\")\n47\t\twriteTestFile(t, filepath.Join(res.WorktreePath, \"docs\", \"jobs\", \".gitkeep\"), \"job side\\n\")\n48\t\tgitCmd(t, res.WorktreePath, \"add\", \"-A\")\n49\t\tgitCmd(t, res.WorktreePath, \"commit\", \"-q\", \"-m\", \"job side change\")\n50\t\treturn root, res\n51\t}\n52\t\n53\t// mergeConflictError asserts the FinishJob error is the failed squash merge\n54\t// itself (not a handoff or an unrelated failure).\n55\tfunc mergeConflictError(t *testing.T, err error) {\n56\t\tt.Helper()\n57\t\tif errors.Is(err, ErrGitSolverHandoff) {\n58\t\t\tt.Fatalf(\"FinishJob handed off to git-solver, want the merge error\")\n59\t\t}\n60\t\tif err == nil || !strings.Contains(err.Error(), \"git merge --squash\") {\n61\t\t\tt.Fatalf(\"FinishJob error = %v, want the squash-merge failure\", err)\n62\t\t}\n63\t}\n64\t\n65\tfunc TestFinishJobMergeConflictDeclinedRollsBack(t *testing.T) {\n66\t\troot, res := conflictJob(t)\n67\t\tdefer os.RemoveAll(res.WorktreePath)\n68\t\n69\t\tvar prompts []string\n70\t\tvar out bytes.Buffer\n71\t\t_, err := FinishJob(root, \"ab12cd\", decliningGitSolverConfirm(&prompts), &out)\n72\t\tmergeConflictError(t, err)\n73\t\t// The offer was made and declined (it is the last prompt asked).\n74\t\tif len(prompts) == 0 || prompts[len(prompts)-1] != \"  Start @git-solver now (mg host)? [y/N] \" {\n75\t\t\tt.Errorf(\"git-solver offer not the last prompt asked: %v\", prompts)\n76\t\t}\n77\t\tif !strings.Contains(out.String(), \"Rolled the failed merge back\") {\n78\t\t\tt.Errorf(\"missing rollback line:\\n%s\", out.String())\n79\t\t}\n80\t\t// Rolled back: the main worktree is clean again, no unmerged entries.\n81\t\tif dirty := gitCmd(t, root, \"status\", \"--porcelain\"); dirty != \"\" {\n82\t\t\tt.Errorf(\"main worktree not clean after rollback:\\n%s\", dirty)\n83\t\t}\n84\t\t// The job's branch + worktree survive the failed finish.\n85\t\tif ok, _ := gitExists(root, \"feature/ab12cd_roundtrip-job\"); !ok {\n86\t\t\tt.Error(\"job branch was deleted despite the failed merge\")\n87\t\t}\n88\t\tif _, err := os.Stat(res.WorktreePath); err != nil {\n89\t\t\tt.Errorf(\"job worktree was removed despite the failed merge: %v\", err)\n90\t\t}\n91\t}\n92\t\n93\tfunc TestFinishJobMergeConflictHandsOffToGitSolver(t *testing.T) {\n94\t\troot, res := conflictJob(t)\n95\t\tdefer os.RemoveAll(res.WorktreePath)\n96\t\n97\t\t// Stub the launch: record the args, report a successful spawn.\n98\t\tvar launchedAgent, launchedPrompt, launchedRoot string\n99\t\torig := GitSolverLaunch\n100\t\tGitSolverLaunch = func(agent, prompt, projectRoot, profile, terminal string) (string, error) {\n101\t\t\tlaunchedAgent, launchedPrompt, launchedRoot = agent, prompt, projectRoot\n102\t\t\treturn \"tmux pane\", nil\n103\t\t}\n104\t\tdefer func() { GitSolverLaunch = orig }()\n105\t\n106\t\tvar out bytes.Buffer\n107\t\t_, err := FinishJob(root, \"ab12cd\", yesConfirm, &out)\n108\t\tif !errors.Is(err, ErrGitSolverHandoff) {\n109\t\t\tt.Fatalf(\"FinishJob = %v, want ErrGitSolverHandoff\\n%s\", err, out.String())\n110\t\t}\n111\t\tif launchedAgent != \"git-solver\" || launchedRoot != root {\n112\t\t\tt.Errorf(\"launch args: agent=%q root=%q, want git-solver at the project root\", launchedAgent, launchedRoot)\n113\t\t}\n114\t\tfor _, want := range []string{\"ab12cd_roundtrip-job\", \"feature/ab12cd_roundtrip-job\", \"docs/jobs/archive/ab12cd_roundtrip-job\"} {\n115\t\t\tif !strings.Contains(launchedPrompt, want) {\n116\t\t\t\tt.Errorf(\"git-solver prompt missing %q:\\n%s\", want, launchedPrompt)\n117\t\t\t}\n118\t\t}\n119\t\tif !strings.Contains(out.String(), \"→ Started @git-solver in tmux pane\") {\n120\t\t\tt.Errorf(\"missing handoff line:\\n%s\", out.String())\n121\t\t}\n122\t\t// The broken state is left in place for git-solver to fix — no rollback.\n123\t\tif u := gitCmd(t, root, \"ls-files\", \"-u\"); u == \"\" {\n124\t\t\tt.Errorf(\"no unmerged entries left for git-solver:\\n%s\", out.String())\n125\t\t}\n126\t}\n127\t\n128\tfunc TestFinishJobMergeConflictLaunchFailureRollsBack(t *testing.T) {\n129\t\troot, res := conflictJob(t)\n130\t\tdefer os.RemoveAll(res.WorktreePath)\n131\t\n132\t\torig := GitSolverLaunch\n133\t\tGitSolverLaunch = func(agent, prompt, projectRoot, profile, terminal string) (string, error) {\n134\t\t\treturn \"\", errors.New(\"no terminal launcher found\")\n135\t\t}\n136\t\tdefer func() { GitSolverLaunch = orig }()\n137\t\n138\t\tvar out bytes.Buffer\n139\t\t_, err := FinishJob(root, \"ab12cd\", yesConfirm, &out)\n140\t\tmergeConflictError(t, err)\n141\t\tif !strings.Contains(out.String(), \"could not start @git-solver\") {\n142\t\t\tt.Errorf(\"missing launch-failure warning:\\n%s\", out.String())\n143\t\t}\n144\t\tif !strings.Contains(out.String(), \"Rolled the failed merge back\") {\n145\t\t\tt.Errorf(\"missing rollback line:\\n%s\", out.String())\n146\t\t}\n147\t\tif dirty := gitCmd(t, root, \"status\", \"--porcelain\"); dirty != \"\" {\n148\t\t\tt.Errorf(\"main worktree not clean after rollback:\\n%s\", dirty)\n149\t\t}\n150\t}\n151\t\n152\tfunc TestFinishJobMergeConflictDirtyMainWorktreeNotRolledBack(t *testing.T) {\n153\t\t// The main worktree holds an uncommitted tracked change before the merge:\n154\t\t// rollback would destroy it, so FinishJob must refuse to reset and say so.\n155\t\troot, res := conflictJob(t)\n156\t\tdefer os.RemoveAll(res.WorktreePath)\n157\t\twriteTestFile(t, filepath.Join(root, \"notes.txt\"), \"user's uncommitted work\\n\")\n158\t\tgitCmd(t, root, \"add\", \"notes.txt\")\n159\t\tgitCmd(t, root, \"commit\", \"-q\", \"-m\", \"track notes\")\n160\t\twriteTestFile(t, filepath.Join(root, \"notes.txt\"), \"user's uncommitted edit\\n\")\n161\t\n162\t\tvar prompts []string\n163\t\tvar out bytes.Buffer\n164\t\t_, err := FinishJob(root, \"ab12cd\", decliningGitSolverConfirm(&prompts), &out)\n165\t\tmergeConflictError(t, err)\n166\t\tif !strings.Contains(out.String(), \"had uncommitted changes before the merge — could not auto-roll-back\") {\n167\t\t\tt.Errorf(\"missing no-rollback warning:\\n%s\", out.String())\n168\t\t}\n169\t\t// The user's uncommitted edit survived untouched.\n170\t\tdata, rerr := os.ReadFile(filepath.Join(root, \"notes.txt\"))\n171\t\tif rerr != nil || string(data) != \"user's uncommitted edit\\n\" {\n172\t\t\tt.Errorf(\"user's uncommitted edit lost: %q, %v\", data, rerr)\n173\t\t}\n174\t}\n175\t\n176\tfunc TestGitSolverPrompt(t *testing.T) {\n177\t\tp := gitSolverPrompt(\"ab12cd_roundtrip-job\", \"feature/ab12cd_roundtrip-job\", \"main\")\n178\t\tfor _, want := range []string{\n179\t\t\t\"ab12cd_roundtrip-job\",\n180\t\t\t\"feature/ab12cd_roundtrip-job\",\n181\t\t\t\"main\",\n182\t\t\t\"docs/jobs/archive/ab12cd_roundtrip-job\",\n183\t\t\t\".manigot/jdi-status\",\n184\t\t} {\n185\t\t\tif !strings.Contains(p, want) {\n186\t\t\t\tt.Errorf(\"git-solver prompt missing %q:\\n%s\", want, p)\n187\t\t\t}\n188\t\t}\n189\t}\n190\t\n191\t// createWorkedJob creates a job and adds some work (implementation.md +\n192\t// verdict.md + commits), returning the create result. The job's worktree is\n193\t// left clean and on the job branch.\n194\tfunc createWorkedJob(t *testing.T) (root string, res CreateResult) {\n195\t\tt.Helper()\n196\t\troot = createCheckout(t, t.TempDir())\n197\t\tvar out bytes.Buffer\n198\t\tres, err := CreateJob(root, \"Roundtrip Job\", CreateOptions{RandomID: fixedID(\"ab12cd\")}, &out)\n199\t\tif err != nil {\n200\t\t\tt.Fatalf(\"CreateJob: %v\", err)\n201\t\t}\n202\t\tjobDir := res.Job.Dir\n203\t\twriteTestFile(t, filepath.Join(jobDir, \"implementation.md\"), \"# Implementation: Roundtrip Job\\n\\n## Summary\\n\\nDone.\\n\")\n204\t\twriteTestFile(t, filepath.Join(jobDir, \"tasks.md\"), \"# Tasks: Roundtrip Job\\n\\nTASK-1: implement\\n\")\n205\t\twriteTestFile(t, filepath.Join(jobDir, \"verdict.md\"), \"# Verdict: Roundtrip Job\\n\\n## Overall\\n\\nAPPROVED\\n\")\n206\t\tgitCmd(t, res.WorktreePath, \"add\", \"-A\")\n207\t\tgitCmd(t, res.WorktreePath, \"commit\", \"-q\", \"-m\", \"[ab12cd] implementation: add summary\")\n208\t\treturn root, res\n209\t}\n210\t\n211\tfunc writeTestFile(t *testing.T, path, content string) {\n212\t\tt.Helper()\n213\t\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n214\t\t\tt.Fatal(err)\n215\t\t}\n216\t}\n217\t\n218\tfunc TestFinishJobFullRoundtrip(t *testing.T) {\n219\t\troot, res := createWorkedJob(t)\n220\t\n221\t\tvar out bytes.Buffer\n222\t\tfin, err := FinishJob(root, \"ab12cd\", yesConfirm, &out)\n223\t\tif err != nil {\n224\t\t\tt.Fatalf(\"FinishJob: %v\\n%s\", err, out.String())\n225\t\t}\n226\t\tif fin.JobName != \"ab12cd_roundtrip-job\" || fin.Branch != \"feature/ab12cd_roundtrip-job\" || fin.BaseBranch != \"main\" {\n227\t\t\tt.Errorf(\"FinishResult = %+v\", fin)\n228\t\t}\n229\t\n230\t\t// Branch deleted.\n231\t\tif ok, _ := gitExists(root, \"feature/ab12cd_roundtrip-job\"); ok {\n232\t\t\tt.Error(\"job branch still exists after FinishJob\")\n233\t\t}\n234\t\t// Main worktree back on the base branch.\n235\t\tif cur := gitCmd(t, root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\"); cur != \"main\" {\n236\t\t\tt.Errorf(\"main worktree on %q, want main\", cur)\n237\t\t}\n238\t\t// Job worktree removed.\n239\t\tif _, err := os.Stat(res.WorktreePath); !os.IsNotExist(err) {\n240\t\t\tt.Errorf(\"job worktree still exists after FinishJob\")\n241\t\t}\n242\t\t// The job's work is on the base branch, archived under docs/jobs/archive/.\n243\t\tarchived := filepath.Join(root, \"docs\", \"jobs\", \"archive\", \"ab12cd_roundtrip-job\")\n244\t\tif _, err := os.Stat(filepath.Join(archived, \"implementation.md\")); err != nil {\n245\t\t\tt.Errorf(\"archived implementation.md missing: %v\", err)\n246\t\t}\n247\t\tbrief, _ := os.ReadFile(filepath.Join(archived, \"brief.md\"))\n248\t\tif !strings.Contains(string(brief), \"status: done\") {\n249\t\t\tt.Errorf(\"archived brief not marked done:\\n%s\", brief)\n250\t\t}\n251\t\t// One squash commit on main carrying the whole job.\n252\t\tlog := gitCmd(t, root, \"log\", \"--oneline\", \"main\")\n253\t\tif n := len(strings.Split(strings.TrimSpace(log), \"\\n\")); n != 2 {\n254\t\t\tt.Errorf(\"main has %d commits after finish, want 2 (init + squash):\\n%s\", n, log)\n255\t\t}\n256\t\tif outStr := out.String(); !strings.Contains(outStr, \"✓ Job finished: ab12cd_roundtrip-job\") {\n257\t\t\tt.Errorf(\"missing finish line:\\n%s\", outStr)\n258\t\t}\n259\t}\n260\t\n261\tfunc TestFinishJobRemovesJDISidecar(t *testing.T) {\n262\t\troot, res := createWorkedJob(t)\n263\t\t// A job mg-jdi previously drove: status sidecar + run.log under the\n264\t\t// project's .manigot/jdi-status/.\n265\t\tif err := WriteJDIStatus(root, res.Job.Name, JDIStoppedFinished, \"reviewer\"); err != nil {\n266\t\t\tt.Fatal(err)\n267\t\t}\n268\t\twriteTestFile(t, JDIRunLogPath(root, res.Job.Name), \"=== mg jdi started ===\\n\")\n269\t\n270\t\tvar out bytes.Buffer\n271\t\tif _, err := FinishJob(root, \"ab12cd\", yesConfirm, &out); err != nil {\n272\t\t\tt.Fatalf(\"FinishJob: %v\\n%s\", err, out.String())\n273\t\t}\n274\t\t// The sidecar is gone with the finished job — the archive keeps the job's\n275\t\t// docs, and mg-jdi never runs against an archived job.\n276\t\tif _, err := os.Stat(JDIStatusDir(root, res.Job.Name)); !os.IsNotExist(err) {\n277\t\t\tt.Errorf(\"mg-jdi sidecar still exists after finish: %v\", err)\n278\t\t}\n279\t\tif !strings.Contains(out.String(), \"→ Removing mg-jdi status for \"+res.Job.Name+\"...\") {\n280\t\t\tt.Errorf(\"missing sidecar-removal line:\\n%s\", out.String())\n281\t\t}\n282\t}\n283\t\n284\tfunc TestFinishJobDeclinedProceed(t *testing.T) {\n285\t\troot, res := createWorkedJob(t)\n286\t\tdefer os.RemoveAll(res.WorktreePath) // cleanup: nothing was done\n287\t\n288\t\tvar out bytes.Buffer\n289\t\t_, err := FinishJob(root, \"ab12cd\", noConfirm, &out)\n290\t\tif !errors.Is(err, ErrCancelled) {\n291\t\t\tt.Fatalf(\"declined proceed: err = %v, want ErrCancelled\", err)\n292\t\t}\n293\t\t// Nothing happened: branch + worktree intact.\n294\t\tif ok, _ := gitExists(root, \"feature/ab12cd_roundtrip-job\"); !ok {\n295\t\t\tt.Error(\"branch was deleted despite a declined confirmation\")\n296\t\t}\n297\t}\n298\t\n299\tfunc TestFinishJobNotApprovedVerdictWarns(t *testing.T) {\n300\t\troot, res := createWorkedJob(t)\n301\t\t// Overwrite the verdict with a NEEDS WORK one and commit.\n302\t\twriteTestFile(t, filepath.Join(res.Job.Dir, \"verdict.md\"), \"# Verdict\\n\\n## Overall\\n\\nNEEDS WORK — TASK-1 incomplete\\n\")\n303\t\tgitCmd(t, res.WorktreePath, \"add\", \"-A\")\n304\t\tgitCmd(t, res.WorktreePath, \"commit\", \"-q\", \"-m\", \"[ab12cd] verdict: needs work\")\n305\t\n306\t\tvar prompts []string\n307\t\tvar out bytes.Buffer\n308\t\t_, err := FinishJob(root, \"ab12cd\", recordingConfirm(&prompts), &out)\n309\t\tif err != nil {\n310\t\t\tt.Fatalf(\"FinishJob: %v\", err)\n311\t\t}\n312\t\tif !strings.Contains(out.String(), \"Warning: verdict is 'NEEDS WORK — TASK-1 incomplete' — job is not approved.\") {\n313\t\t\tt.Errorf(\"missing not-approved warning:\\n%s\", out.String())\n314\t\t}\n315\t\tif len(prompts) < 2 || prompts[0] != \"  Continue anyway? [y/N] \" || prompts[1] != \"  Proceed? [y/N] \" {\n316\t\t\tt.Errorf(\"prompts = %v\", prompts)\n317\t\t}\n318\t}\n319\t\n320\tfunc TestFinishJobNoVerdictWarns(t *testing.T) {\n321\t\troot, res := createWorkedJob(t)\n322\t\tos.Remove(filepath.Join(res.Job.Dir, \"verdict.md\"))\n323\t\tgitCmd(t, res.WorktreePath, \"add\", \"-A\")\n324\t\tgitCmd(t, res.WorktreePath, \"commit\", \"-q\", \"-m\", \"[ab12cd] drop verdict\")\n325\t\n326\t\tvar prompts []string\n327\t\tvar out bytes.Buffer\n328\t\tif _, err := FinishJob(root, \"ab12cd\", recordingConfirm(&prompts), &out); err != nil {\n329\t\t\tt.Fatalf(\"FinishJob: %v\", err)\n330\t\t}\n331\t\tif !strings.Contains(out.String(), \"Warning: no verdict.md found — job has not been reviewed.\") {\n332\t\t\tt.Errorf(\"missing no-verdict warning:\\n%s\", out.String())\n333\t\t}\n334\t\tif len(prompts) < 1 || prompts[0] != \"  Continue anyway? [y/N] \" {\n335\t\t\tt.Errorf(\"prompts = %v\", prompts)\n336\t\t}\n337\t}\n338\t\n339\tfunc TestFinishJobDirtyWorktreeRejected(t *testing.T) {\n340\t\troot, res := createWorkedJob(t)\n341\t\t// Uncommitted change in the worktree.\n342\t\twriteTestFile(t, filepath.Join(res.Job.Dir, \"tasks.md\"), \"uncommitted edit\\n\")\n343\t\n344\t\tvar out bytes.Buffer\n345\t\t_, err := FinishJob(root, \"ab12cd\", yesConfirm, &out)\n346\t\tif err == nil || !strings.Contains(err.Error(), \"uncommitted changes in the worktree for branch 'feature/ab12cd_roundtrip-job'. Commit or stash before finishing.\") {\n347\t\t\tt.Errorf(\"dirty-tree error = %v\", err)\n348\t\t}\n349\t}\n350\t\n351\tfunc TestFinishJobMainWorktreeCase(t *testing.T) {\n352\t\t// A pre-worktree job: the job's branch is checked out in the main\n353\t\t// worktree itself, so WorktreeForBranch resolves to the main worktree and\n354\t\t// the removal step must be skipped.\n355\t\troot := createCheckout(t, t.TempDir())\n356\t\tgitCmd(t, root, \"checkout\", \"-q\", \"-b\", \"feature/ef34gh_main-wt\")\n357\t\tjobDir := filepath.Join(root, \"docs\", \"jobs\", \"ef34gh_main-wt\")\n358\t\tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n359\t\t\tt.Fatal(err)\n360\t\t}\n361\t\twriteTestFile(t, filepath.Join(jobDir, \"brief.md\"), \"# Brief: Main WT\\n\\nstatus: open\\nid: ef34gh\\n\")\n362\t\twriteTestFile(t, filepath.Join(jobDir, \"tasks.md\"), \"# Tasks\\n\\nTASK-1\\n\")\n363\t\twriteTestFile(t, filepath.Join(jobDir, \"implementation.md\"), \"# Implementation\\n\\nDone.\\n\")\n364\t\twriteTestFile(t, filepath.Join(jobDir, \"verdict.md\"), \"# Verdict\\n\\n## Overall\\n\\nAPPROVED\\n\")\n365\t\tgitCmd(t, root, \"add\", \"-A\")\n366\t\tgitCmd(t, root, \"commit\", \"-q\", \"-m\", \"[ef34gh] work\")\n367\t\n368\t\tvar out bytes.Buffer\n369\t\tfin, err := FinishJob(root, \"ef34gh\", yesConfirm, &out)\n370\t\tif err != nil {\n371\t\t\tt.Fatalf(\"FinishJob (main-worktree case): %v\\n%s\", err, out.String())\n372\t\t}\n373\t\tif fin.BaseBranch != \"main\" {\n374\t\t\tt.Errorf(\"base branch = %q\", fin.BaseBranch)\n375\t\t}\n376\t\tif !strings.Contains(out.String(), \"→ Worktree is the main worktree — skipping worktree removal.\") {\n377\t\t\tt.Errorf(\"missing skip-removal line:\\n%s\", out.String())\n378\t\t}\n379\t\t// The main worktree was switched onto the base branch.\n380\t\tif cur := gitCmd(t, root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\"); cur != \"main\" {\n381\t\t\tt.Errorf(\"main worktree on %q, want main\", cur)\n382\t\t}\n383\t\t// Branch deleted; work archived on main.\n384\t\tif ok, _ := gitExists(root, \"feature/ef34gh_main-wt\"); ok {\n385\t\t\tt.Error(\"job branch still exists\")\n386\t\t}\n387\t\tif _, err := os.Stat(filepath.Join(root, \"docs\", \"jobs\", \"archive\", \"ef34gh_main-wt\", \"implementation.md\")); err != nil {\n388\t\t\tt.Errorf(\"archived work missing: %v\", err)\n389\t\t}\n390\t}\n391\t\n392\tfunc TestFinishJobJobNotFound(t *testing.T) {\n393\t\troot := createCheckout(t, t.TempDir())\n394\t\tvar out bytes.Buffer\n395\t\t_, err := FinishJob(root, \"zzzz99\", yesConfirm, &out)\n396\t\tif err == nil || !strings.Contains(err.Error(), \"job 'zzzz99' not found among local branches.\") {\n397\t\t\tt.Errorf(\"not-found error = %v\", err)\n398\t\t}\n399\t\tif !strings.Contains(err.Error(), \"Active job branches:\") {\n400\t\t\tt.Errorf(\"not-found error missing branch listing: %v\", err)\n401\t\t}\n402\t}\n403\t\n404\tfunc TestFinishJobAmbiguous(t *testing.T) {\n405\t\troot := createCheckout(t, t.TempDir())\n406\t\tgitCmd(t, root, \"branch\", \"feature/ab12cd_alpha\")\n407\t\tgitCmd(t, root, \"branch\", \"feature/ab12cd_beta\")\n408\t\t// A branch with no worktree can't be finished — but ambiguity is reported\n409\t\t// first, matching the script's resolution order.\n410\t\tvar out bytes.Buffer\n411\t\t_, err := FinishJob(root, \"ab12cd\", yesConfirm, &out)\n412\t\tif err == nil || !strings.Contains(err.Error(), \"job 'ab12cd' is ambiguous — matches branches:\") {\n413\t\t\tt.Errorf(\"ambiguity error = %v\", err)\n414\t\t}\n415\t}\n416\t\n417\tfunc TestBriefTitle(t *testing.T) {\n418\t\tdir := t.TempDir()\n419\t\twriteTestFile(t, filepath.Join(dir, \"brief.md\"), \"# Brief: My Job Title\\n\\nstatus: open\\n\")\n420\t\tif got := briefTitle(filepath.Join(dir, \"brief.md\")); got != \"My Job Title\" {\n421\t\t\tt.Errorf(\"briefTitle = %q\", got)\n422\t\t}\n423\t\t// A first line that isn't a Brief heading stays as-is (sed's no-match\n424\t\t// behavior).\n425\t\twriteTestFile(t, filepath.Join(dir, \"brief.md\"), \"Some other first line\\n\")\n426\t\tif got := briefTitle(filepath.Join(dir, \"brief.md\")); got != \"Some other first line\" {\n427\t\t\tt.Errorf(\"briefTitle (no heading) = %q\", got)\n428\t\t}\n429\t}\n430\t\n431\t// gitExists reports whether the local branch ref exists.\n432\tfunc gitExists(root, branch string) (bool, error) {\n433\t\t_, err := execGit(root, \"rev-parse\", \"--verify\", \"--quiet\", \"refs/heads/\"+branch)\n434\t\tif err == nil {\n435\t\t\treturn true, nil\n436\t\t}\n437\t\treturn false, nil\n438\t}\n439\t\n440\t// execGit runs `git -C root args` and returns trimmed combined output.\n441\tfunc execGit(root string, args ...string) (string, error) {\n442\t\tcmd := exec.Command(\"git\", append([]string{\"-C\", root}, args...)...)\n443\t\tout, err := cmd.CombinedOutput()\n444\t\treturn strings.TrimSpace(string(out)), err\n445\t}\n446\t"}]},"parent_tool_use_id":null,"session_id":"ba948ea7-a157-4c42-8eb1-077540d9946d","uuid":"c65609e3-15f0-4ba3-8fb3-35d248fb0246","timestamp":"2026-08-28T20:28:43.448Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/internal/job/finish_test.go","content":"package job\n\nimport (\n\t\"bytes\"\n\t\"errors\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// yesConfirm answers every prompt with yes.\nfunc yesConfirm(prompt string) (bool, error) { return true, nil }\n\n// noConfirm answers every prompt with no.\nfunc noConfirm(prompt string) (bool, error) { return false, nil }\n\n// recordingConfirm answers with yes and records every prompt asked.\nfunc recordingConfirm(recorded *[]string) ConfirmFunc {\n\treturn func(prompt string) (bool, error) {\n\t\t*recorded = append(*recorded, prompt)\n\t\treturn true, nil\n\t}\n}\n\n// decliningGitSolverConfirm answers yes to every prompt except the @git-solver\n// offer, which it declines — the \"roll back and leave the repo clean\" path.\nfunc decliningGitSolverConfirm(recorded *[]string) ConfirmFunc {\n\treturn func(prompt string) (bool, error) {\n\t\t*recorded = append(*recorded, prompt)\n\t\tif strings.Contains(prompt, \"@git-solver\") {\n\t\t\treturn false, nil\n\t\t}\n\t\treturn true, nil\n\t}\n}\n\n// conflictJob sets up a job whose squash merge into main will conflict: both\n// sides modify docs/jobs/.gitkeep differently. Returns the create result.\nfunc conflictJob(t *testing.T) (root string, res CreateResult) {\n\tt.Helper()\n\troot, res = createWorkedJob(t)\n\twriteTestFile(t, filepath.Join(root, \"docs\", \"jobs\", \".gitkeep\"), \"main side\\n\")\n\tgitCmd(t, root, \"add\", \"-A\")\n\tgitCmd(t, root, \"commit\", \"-q\", \"-m\", \"main side change\")\n\twriteTestFile(t, filepath.Join(res.WorktreePath, \"docs\", \"jobs\", \".gitkeep\"), \"job side\\n\")\n\tgitCmd(t, res.WorktreePath, \"add\", \"-A\")\n\tgitCmd(t, res.WorktreePath, \"commit\", \"-q\", \"-m\", \"job side change\")\n\treturn root, res\n}\n\n// mergeConflictError asserts the FinishJob error is the failed squash merge\n// itself (not a handoff or an unrelated failure).\nfunc mergeConflictError(t *testing.T, err error) {\n\tt.Helper()\n\tif errors.Is(err, ErrGitSolverHandoff) {\n\t\tt.Fatalf(\"FinishJob handed off to git-solver, want the merge error\")\n\t}\n\tif err == nil || !strings.Contains(err.Error(), \"git merge --squash\") {\n\t\tt.Fatalf(\"FinishJob error = %v, want the squash-merge failure\", err)\n\t}\n}\n\nfunc TestFinishJobMergeConflictDeclinedRollsBack(t *testing.T) {\n\troot, res := conflictJob(t)\n\tdefer os.RemoveAll(res.WorktreePath)\n\n\tvar prompts []string\n\tvar out bytes.Buffer\n\t_, err := FinishJob(root, \"ab12cd\", decliningGitSolverConfirm(&prompts), &out)\n\tmergeConflictError(t, err)\n\t// The offer was made and declined (it is the last prompt asked).\n\tif len(prompts) == 0 || prompts[len(prompts)-1] != \"  Start @git-solver now (mg host)? [y/N] \" {\n\t\tt.Errorf(\"git-solver offer not the last prompt asked: %v\", prompts)\n\t}\n\tif !strings.Contains(out.String(), \"Rolled the failed merge back\") {\n\t\tt.Errorf(\"missing rollback line:\\n%s\", out.String())\n\t}\n\t// Rolled back: the main worktree is clean again, no unmerged entries.\n\tif dirty := gitCmd(t, root, \"status\", \"--porcelain\"); dirty != \"\" {\n\t\tt.Errorf(\"main worktree not clean after rollback:\\n%s\", dirty)\n\t}\n\t// The job's branch + worktree survive the failed finish.\n\tif ok, _ := gitExists(root, \"feature/ab12cd_roundtrip-job\"); !ok {\n\t\tt.Error(\"job branch was deleted despite the failed merge\")\n\t}\n\tif _, err := os.Stat(res.WorktreePath); err != nil {\n\t\tt.Errorf(\"job worktree was removed despite the failed merge: %v\", err)\n\t}\n}\n\nfunc TestFinishJobMergeConflictHandsOffToGitSolver(t *testing.T) {\n\troot, res := conflictJob(t)\n\tdefer os.RemoveAll(res.WorktreePath)\n\n\t// Stub the launch: record the args, report a successful spawn.\n\tvar launchedAgent, launchedPrompt, launchedRoot string\n\torig := GitSolverLaunch\n\tGitSolverLaunch = func(agent, prompt, projectRoot, profile, terminal string) (string, error) {\n\t\tlaunchedAgent, launchedPrompt, launchedRoot = agent, prompt, projectRoot\n\t\treturn \"tmux pane\", nil\n\t}\n\tdefer func() { GitSolverLaunch = orig }()\n\n\tvar out bytes.Buffer\n\t_, err := FinishJob(root, \"ab12cd\", yesConfirm, &out)\n\tif !errors.Is(err, ErrGitSolverHandoff) {\n\t\tt.Fatalf(\"FinishJob = %v, want ErrGitSolverHandoff\\n%s\", err, out.String())\n\t}\n\tif launchedAgent != \"git-solver\" || launchedRoot != root {\n\t\tt.Errorf(\"launch args: agent=%q root=%q, want git-solver at the project root\", launchedAgent, launchedRoot)\n\t}\n\tfor _, want := range []string{\"ab12cd_roundtrip-job\", \"feature/ab12cd_roundtrip-job\", \"docs/jobs/archive/ab12cd_roundtrip-job\"} {\n\t\tif !strings.Contains(launchedPrompt, want) {\n\t\t\tt.Errorf(\"git-solver prompt missing %q:\\n%s\", want, launchedPrompt)\n\t\t}\n\t}\n\tif !strings.Contains(out.String(), \"→ Started @git-solver in tmux pane\") {\n\t\tt.Errorf(\"missing handoff line:\\n%s\", out.String())\n\t}\n\t// The broken state is left in place for git-solver to fix — no rollback.\n\tif u := gitCmd(t, root, \"ls-files\", \"-u\"); u == \"\" {\n\t\tt.Errorf(\"no unmerged entries left for git-solver:\\n%s\", out.String())\n\t}\n}\n\nfunc TestFinishJobMergeConflictLaunchFailureRollsBack(t *testing.T) {\n\troot, res := conflictJob(t)\n\tdefer os.RemoveAll(res.WorktreePath)\n\n\torig := GitSolverLaunch\n\tGitSolverLaunch = func(agent, prompt, projectRoot, profile, terminal string) (string, error) {\n\t\treturn \"\", errors.New(\"no terminal launcher found\")\n\t}\n\tdefer func() { GitSolverLaunch = orig }()\n\n\tvar out bytes.Buffer\n\t_, err := FinishJob(root, \"ab12cd\", yesConfirm, &out)\n\tmergeConflictError(t, err)\n\tif !strings.Contains(out.String(), \"could not start @git-solver\") {\n\t\tt.Errorf(\"missing launch-failure warning:\\n%s\", out.String())\n\t}\n\tif !strings.Contains(out.String(), \"Rolled the failed merge back\") {\n\t\tt.Errorf(\"missing rollback line:\\n%s\", out.String())\n\t}\n\tif dirty := gitCmd(t, root, \"status\", \"--porcelain\"); dirty != \"\" {\n\t\tt.Errorf(\"main worktree not clean after rollback:\\n%s\", dirty)\n\t}\n}\n\nfunc TestFinishJobMergeConflictDirtyMainWorktreeNotRolledBack(t *testing.T) {\n\t// The main worktree holds an uncommitted tracked change before the merge:\n\t// rollback would destroy it, so FinishJob must refuse to reset and say so.\n\troot, res := conflictJob(t)\n\tdefer os.RemoveAll(res.WorktreePath)\n\twriteTestFile(t, filepath.Join(root, \"notes.txt\"), \"user's uncommitted work\\n\")\n\tgitCmd(t, root, \"add\", \"notes.txt\")\n\tgitCmd(t, root, \"commit\", \"-q\", \"-m\", \"track notes\")\n\twriteTestFile(t, filepath.Join(root, \"notes.txt\"), \"user's uncommitted edit\\n\")\n\n\tvar prompts []string\n\tvar out bytes.Buffer\n\t_, err := FinishJob(root, \"ab12cd\", decliningGitSolverConfirm(&prompts), &out)\n\tmergeConflictError(t, err)\n\tif !strings.Contains(out.String(), \"had uncommitted changes before the merge — could not auto-roll-back\") {\n\t\tt.Errorf(\"missing no-rollback warning:\\n%s\", out.String())\n\t}\n\t// The user's uncommitted edit survived untouched.\n\tdata, rerr := os.ReadFile(filepath.Join(root, \"notes.txt\"))\n\tif rerr != nil || string(data) != \"user's uncommitted edit\\n\" {\n\t\tt.Errorf(\"user's uncommitted edit lost: %q, %v\", data, rerr)\n\t}\n}\n\nfunc TestGitSolverPrompt(t *testing.T) {\n\tp := gitSolverPrompt(\"ab12cd_roundtrip-job\", \"feature/ab12cd_roundtrip-job\", \"main\")\n\tfor _, want := range []string{\n\t\t\"ab12cd_roundtrip-job\",\n\t\t\"feature/ab12cd_roundtrip-job\",\n\t\t\"main\",\n\t\t\"docs/jobs/archive/ab12cd_roundtrip-job\",\n\t\t\".manigot/jdi-status\",\n\t} {\n\t\tif !strings.Contains(p, want) {\n\t\t\tt.Errorf(\"git-solver prompt missing %q:\\n%s\", want, p)\n\t\t}\n\t}\n}\n\n// createWorkedJob creates a job and adds some work (implementation.md +\n// verdict.md + commits), returning the create result. The job's worktree is\n// left clean and on the job branch.\nfunc createWorkedJob(t *testing.T) (root string, res CreateResult) {\n\tt.Helper()\n\troot = createCheckout(t, t.TempDir())\n\tvar out bytes.Buffer\n\tres, err := CreateJob(root, \"Roundtrip Job\", CreateOptions{RandomID: fixedID(\"ab12cd\")}, &out)\n\tif err != nil {\n\t\tt.Fatalf(\"CreateJob: %v\", err)\n\t}\n\tjobDir := res.Job.Dir\n\twriteTestFile(t, filepath.Join(jobDir, \"implementation.md\"), \"# Implementation: Roundtrip Job\\n\\n## Summary\\n\\nDone.\\n\")\n\twriteTestFile(t, filepath.Join(jobDir, \"tasks.md\"), \"# Tasks: Roundtrip Job\\n\\nTASK-1: implement\\n\")\n\twriteTestFile(t, filepath.Join(jobDir, \"verdict.md\"), \"# Verdict: Roundtrip Job\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\tgitCmd(t, res.WorktreePath, \"add\", \"-A\")\n\tgitCmd(t, res.WorktreePath, \"commit\", \"-q\", \"-m\", \"[ab12cd] implementation: add summary\")\n\treturn root, res\n}\n\nfunc writeTestFile(t *testing.T, path, content string) {\n\tt.Helper()\n\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\nfunc TestFinishJobFullRoundtrip(t *testing.T) {\n\troot, res := createWorkedJob(t)\n\n\tvar out bytes.Buffer\n\tfin, err := FinishJob(root, \"ab12cd\", yesConfirm, &out)\n\tif err != nil {\n\t\tt.Fatalf(\"FinishJob: %v\\n%s\", err, out.String())\n\t}\n\tif fin.JobName != \"ab12cd_roundtrip-job\" || fin.Branch != \"feature/ab12cd_roundtrip-job\" || fin.BaseBranch != \"main\" {\n\t\tt.Errorf(\"FinishResult = %+v\", fin)\n\t}\n\n\t// Branch deleted.\n\tif ok, _ := gitExists(root, \"feature/ab12cd_roundtrip-job\"); ok {\n\t\tt.Error(\"job branch still exists after FinishJob\")\n\t}\n\t// Main worktree back on the base branch.\n\tif cur := gitCmd(t, root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\"); cur != \"main\" {\n\t\tt.Errorf(\"main worktree on %q, want main\", cur)\n\t}\n\t// Job worktree removed.\n\tif _, err := os.Stat(res.WorktreePath); !os.IsNotExist(err) {\n\t\tt.Errorf(\"job worktree still exists after FinishJob\")\n\t}\n\t// The job's work is on the base branch, archived under docs/jobs/archive/.\n\tarchived := filepath.Join(root, \"docs\", \"jobs\", \"archive\", \"ab12cd_roundtrip-job\")\n\tif _, err := os.Stat(filepath.Join(archived, \"implementation.md\")); err != nil {\n\t\tt.Errorf(\"archived implementation.md missing: %v\", err)\n\t}\n\tbrief, _ := os.ReadFile(filepath.Join(archived, \"brief.md\"))\n\tif !strings.Contains(string(brief), \"status: done\") {\n\t\tt.Errorf(\"archived brief not marked done:\\n%s\", brief)\n\t}\n\t// One squash commit on main carrying the whole job.\n\tlog := gitCmd(t, root, \"log\", \"--oneline\", \"main\")\n\tif n := len(strings.Split(strings.TrimSpace(log), \"\\n\")); n != 2 {\n\t\tt.Errorf(\"main has %d commits after finish, want 2 (init + squash):\\n%s\", n, log)\n\t}\n\tif outStr := out.String(); !strings.Contains(outStr, \"✓ Job finished: ab12cd_roundtrip-job\") {\n\t\tt.Errorf(\"missing finish line:\\n%s\", outStr)\n\t}\n}\n\nfunc TestFinishJobRemovesJDISidecar(t *testing.T) {\n\troot, res := createWorkedJob(t)\n\t// A job mg-jdi previously drove: status sidecar + run.log under the\n\t// project's .manigot/jdi-status/.\n\tif err := WriteJDIStatus(root, res.Job.Name, JDIStoppedFinished, \"reviewer\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\twriteTestFile(t, JDIRunLogPath(root, res.Job.Name), \"=== mg jdi started ===\\n\")\n\n\tvar out bytes.Buffer\n\tif _, err := FinishJob(root, \"ab12cd\", yesConfirm, &out); err != nil {\n\t\tt.Fatalf(\"FinishJob: %v\\n%s\", err, out.String())\n\t}\n\t// The sidecar is gone with the finished job — the archive keeps the job's\n\t// docs, and mg-jdi never runs against an archived job.\n\tif _, err := os.Stat(JDIStatusDir(root, res.Job.Name)); !os.IsNotExist(err) {\n\t\tt.Errorf(\"mg-jdi sidecar still exists after finish: %v\", err)\n\t}\n\tif !strings.Contains(out.String(), \"→ Removing mg-jdi status for \"+res.Job.Name+\"...\") {\n\t\tt.Errorf(\"missing sidecar-removal line:\\n%s\", out.String())\n\t}\n}\n\nfunc TestFinishJobDeclinedProceed(t *testing.T) {\n\troot, res := createWorkedJob(t)\n\tdefer os.RemoveAll(res.WorktreePath) // cleanup: nothing was done\n\n\tvar out bytes.Buffer\n\t_, err := FinishJob(root, \"ab12cd\", noConfirm, &out)\n\tif !errors.Is(err, ErrCancelled) {\n\t\tt.Fatalf(\"declined proceed: err = %v, want ErrCancelled\", err)\n\t}\n\t// Nothing happened: branch + worktree intact.\n\tif ok, _ := gitExists(root, \"feature/ab12cd_roundtrip-job\"); !ok {\n\t\tt.Error(\"branch was deleted despite a declined confirmation\")\n\t}\n}\n\nfunc TestFinishJobNotApprovedVerdictWarns(t *testing.T) {\n\troot, res := createWorkedJob(t)\n\t// Overwrite the verdict with a NEEDS WORK one and commit.\n\twriteTestFile(t, filepath.Join(res.Job.Dir, \"verdict.md\"), \"# Verdict\\n\\n## Overall\\n\\nNEEDS WORK — TASK-1 incomplete\\n\")\n\tgitCmd(t, res.WorktreePath, \"add\", \"-A\")\n\tgitCmd(t, res.WorktreePath, \"commit\", \"-q\", \"-m\", \"[ab12cd] verdict: needs work\")\n\n\tvar prompts []string\n\tvar out bytes.Buffer\n\t_, err := FinishJob(root, \"ab12cd\", recordingConfirm(&prompts), &out)\n\tif err != nil {\n\t\tt.Fatalf(\"FinishJob: %v\", err)\n\t}\n\tif !strings.Contains(out.String(), \"Warning: verdict is 'NEEDS WORK — TASK-1 incomplete' — job is not approved.\") {\n\t\tt.Errorf(\"missing not-approved warning:\\n%s\", out.String())\n\t}\n\tif len(prompts) < 2 || prompts[0] != \"  Continue anyway? [y/N] \" || prompts[1] != \"  Proceed? [y/N] \" {\n\t\tt.Errorf(\"prompts = %v\", prompts)\n\t}\n}\n\nfunc TestFinishJobNoVerdictWarns(t *testing.T) {\n\troot, res := createWorkedJob(t)\n\tos.Remove(filepath.Join(res.Job.Dir, \"verdict.md\"))\n\tgitCmd(t, res.WorktreePath, \"add\", \"-A\")\n\tgitCmd(t, res.WorktreePath, \"commit\", \"-q\", \"-m\", \"[ab12cd] drop verdict\")\n\n\tvar prompts []string\n\tvar out bytes.Buffer\n\tif _, err := FinishJob(root, \"ab12cd\", recordingConfirm(&prompts), &out); err != nil {\n\t\tt.Fatalf(\"FinishJob: %v\", err)\n\t}\n\tif !strings.Contains(out.String(), \"Warning: no verdict.md found — job has not been reviewed.\") {\n\t\tt.Errorf(\"missing no-verdict warning:\\n%s\", out.String())\n\t}\n\tif len(prompts) < 1 || prompts[0] != \"  Continue anyway? [y/N] \" {\n\t\tt.Errorf(\"prompts = %v\", prompts)\n\t}\n}\n\nfunc TestFinishJobDirtyWorktreeRejected(t *testing.T) {\n\troot, res := createWorkedJob(t)\n\t// Uncommitted change in the worktree.\n\twriteTestFile(t, filepath.Join(res.Job.Dir, \"tasks.md\"), \"uncommitted edit\\n\")\n\n\tvar out bytes.Buffer\n\t_, err := FinishJob(root, \"ab12cd\", yesConfirm, &out)\n\tif err == nil || !strings.Contains(err.Error(), \"uncommitted changes in the worktree for branch 'feature/ab12cd_roundtrip-job'. Commit or stash before finishing.\") {\n\t\tt.Errorf(\"dirty-tree error = %v\", err)\n\t}\n}\n\nfunc TestFinishJobMainWorktreeCase(t *testing.T) {\n\t// A pre-worktree job: the job's branch is checked out in the main\n\t// worktree itself, so WorktreeForBranch resolves to the main worktree and\n\t// the removal step must be skipped.\n\troot := createCheckout(t, t.TempDir())\n\tgitCmd(t, root, \"checkout\", \"-q\", \"-b\", \"feature/ef34gh_main-wt\")\n\tjobDir := filepath.Join(root, \"docs\", \"jobs\", \"ef34gh_main-wt\")\n\tif err := os.MkdirAll(jobDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\twriteTestFile(t, filepath.Join(jobDir, \"brief.md\"), \"# Brief: Main WT\\n\\nstatus: open\\nid: ef34gh\\n\")\n\twriteTestFile(t, filepath.Join(jobDir, \"tasks.md\"), \"# Tasks\\n\\nTASK-1\\n\")\n\twriteTestFile(t, filepath.Join(jobDir, \"implementation.md\"), \"# Implementation\\n\\nDone.\\n\")\n\twriteTestFile(t, filepath.Join(jobDir, \"verdict.md\"), \"# Verdict\\n\\n## Overall\\n\\nAPPROVED\\n\")\n\tgitCmd(t, root, \"add\", \"-A\")\n\tgitCmd(t, root, \"commit\", \"-q\", \"-m\", \"[ef34gh] work\")\n\n\tvar out bytes.Buffer\n\tfin, err := FinishJob(root, \"ef34gh\", yesConfirm, &out)\n\tif err != nil {\n\t\tt.Fatalf(\"FinishJob (main-worktree case): %v\\n%s\", err, out.String())\n\t}\n\tif fin.BaseBranch != \"main\" {\n\t\tt.Errorf(\"base branch = %q\", fin.BaseBranch)\n\t}\n\tif !strings.Contains(out.String(), \"→ Worktree is the main worktree — skipping worktree removal.\") {\n\t\tt.Errorf(\"missing skip-removal line:\\n%s\", out.String())\n\t}\n\t// The main worktree was switched onto the base branch.\n\tif cur := gitCmd(t, root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\"); cur != \"main\" {\n\t\tt.Errorf(\"main worktree on %q, want main\", cur)\n\t}\n\t// Branch deleted; work archived on main.\n\tif ok, _ := gitExists(root, \"feature/ef34gh_main-wt\"); ok {\n\t\tt.Error(\"job branch still exists\")\n\t}\n\tif _, err := os.Stat(filepath.Join(root, \"docs\", \"jobs\", \"archive\", \"ef34gh_main-wt\", \"implementation.md\")); err != nil {\n\t\tt.Errorf(\"archived work missing: %v\", err)\n\t}\n}\n\nfunc TestFinishJobJobNotFound(t *testing.T) {\n\troot := createCheckout(t, t.TempDir())\n\tvar out bytes.Buffer\n\t_, err := FinishJob(root, \"zzzz99\", yesConfirm, &out)\n\tif err == nil || !strings.Contains(err.Error(), \"job 'zzzz99' not found among local branches.\") {\n\t\tt.Errorf(\"not-found error = %v\", err)\n\t}\n\tif !strings.Contains(err.Error(), \"Active job branches:\") {\n\t\tt.Errorf(\"not-found error missing branch listing: %v\", err)\n\t}\n}\n\nfunc TestFinishJobAmbiguous(t *testing.T) {\n\troot := createCheckout(t, t.TempDir())\n\tgitCmd(t, root, \"branch\", \"feature/ab12cd_alpha\")\n\tgitCmd(t, root, \"branch\", \"feature/ab12cd_beta\")\n\t// A branch with no worktree can't be finished — but ambiguity is reported\n\t// first, matching the script's resolution order.\n\tvar out bytes.Buffer\n\t_, err := FinishJob(root, \"ab12cd\", yesConfirm, &out)\n\tif err == nil || !strings.Contains(err.Error(), \"job 'ab12cd' is ambiguous — matches branches:\") {\n\t\tt.Errorf(\"ambiguity error = %v\", err)\n\t}\n}\n\nfunc TestBriefTitle(t *testing.T) {\n\tdir := t.TempDir()\n\twriteTestFile(t, filepath.Join(dir, \"brief.md\"), \"# Brief: My Job Title\\n\\nstatus: open\\n\")\n\tif got := briefTitle(filepath.Join(dir, \"brief.md\")); got != \"My Job Title\" {\n\t\tt.Errorf(\"briefTitle = %q\", got)\n\t}\n\t// A first line that isn't a Brief heading stays as-is (sed's no-match\n\t// behavior).\n\twriteTestFile(t, filepath.Join(dir, \"brief.md\"), \"Some other first line\\n\")\n\tif got := briefTitle(filepath.Join(dir, \"brief.md\")); got != \"Some other first line\" {\n\t\tt.Errorf(\"briefTitle (no heading) = %q\", got)\n\t}\n}\n\n// gitExists reports whether the local branch ref exists.\nfunc gitExists(root, branch string) (bool, error) {\n\t_, err := execGit(root, \"rev-parse\", \"--verify\", \"--quiet\", \"refs/heads/\"+branch)\n\tif err == nil {\n\t\treturn true, nil\n\t}\n\treturn false, nil\n}\n\n// execGit runs `git -C root args` and returns trimmed combined output.\nfunc execGit(root string, args ...string) (string, error) {\n\tcmd := exec.Command(\"git\", append([]string{\"-C\", root}, args...)...)\n\tout, err := cmd.CombinedOutput()\n\treturn strings.TrimSpace(string(out)), err\n}\n","numLines":446,"startLine":1,"totalLines":446}}}
