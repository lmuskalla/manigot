{"type":"tool_use","timestamp":1787951113931,"sessionID":"ses_fb5dcd7a6ffeSGBPKFVeVpziRm","part":{"type":"tool","tool":"read","callID":"call_c4767b9b4eb94899af9a1041","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/project/settings.go"},"output":"<path>/workspace/src/internal/project/settings.go</path>\n<type>file</type>\n<content>\n1: // Package project persists project-scoped manigot settings — conventions that\n2: // belong to the project itself (not to a single user's TUI) and are meant to be\n3: // committed and shared across a team. It is the project-level counterpart to\n4: // the personal/global config package (editor, subscription profile), which\n5: // stays gitignored and per-user.\n6: //\n7: // The project conventions are the base branch (the ref new job branches are\n8: // cut from and the TUI's \"b\" quick-checkout lands on) and the job branch\n9: // prefix (the namespace job branches live under). They live here rather than\n10: // in config because both are shared project conventions, not personal\n11: // preferences.\n12: package project\n13: \n14: import (\n15: \t\"encoding/json\"\n16: \t\"fmt\"\n17: \t\"os\"\n18: \t\"path/filepath\"\n19: )\n20: \n21: // Settings holds the project-scoped manigot conventions, read from / written\n22: // to .manigot/manigot.json in the target project's root. Only fields with a\n23: // project-wide (committable, shareable) lifecycle belong here; anything\n24: // personal (editor, subscription profile) stays in the global config package.\n25: type Settings struct {\n26: \t// BaseBranch is the ref new job branches are cut from and the TUI's\n27: \t// list-view \"b\" quick-checkout lands on. Empty is treated as \"main\" —\n28: \t// see BaseBranchValue.\n29: \tBaseBranch string `json:\"baseBranch,omitempty\"`\n30: \n31: \t// JobBranchPrefix is the namespace job branches live under, prepended to\n32: \t// the type segment: with prefix \"jobs\" a feature job's branch is\n33: \t// \"jobs/feature/<id>_<slug>\" instead of \"feature/<id>_<slug>\". Empty\n34: \t// means no prefix (today's naming). A project that already has a plain\n35: \t// branch named exactly \"feature\", \"fix\" or \"chore\" cannot create\n36: \t// branches under that name in git (\"cannot lock ref: 'refs/heads/feature'\n37: \t// exists\"), so the prefix lets it move job branches into a free\n38: \t// namespace without renaming anything.\n39: \tJobBranchPrefix string `json:\"jobBranchPrefix,omitempty\"`\n40: }\n41: \n42: // BaseBranchValue returns s.BaseBranch, defaulting to \"main\" when unset so\n43: // every reader (the TUI's lifecycle actions, mg job) gets a usable ref even\n44: // when .manigot/manigot.json is absent or doesn't set the key.\n45: func (s Settings) BaseBranchValue() string {\n46: \tif s.BaseBranch == \"\" {\n47: \t\treturn \"main\"\n48: \t}\n49: \treturn s.BaseBranch\n50: }\n51: \n52: // Path returns the project settings file's path under the given project root:\n53: // <root>/.manigot/manigot.json. The root is the target project root the TUI\n54: // was launched in (App.root), not the manigot checkout — these settings\n55: // travel with the project being worked on, not with the tool.\n56: func Path(root string) string {\n57: \treturn filepath.Join(root, \".manigot\", \"manigot.json\")\n58: }\n59: \n60: // Load reads the project settings file under root. A file that does not exist\n61: // yet (the project hasn't been initialized, or no project settings have ever\n62: // been saved) is not an error — it yields the zero-value Settings, which every\n63: // caller treats as \"defaults\" via BaseBranchValue. This mirrors config.Load's\n64: // shape exactly so the two packages degrade the same way.\n65: func Load(root string) (Settings, error) {\n66: \tdata, err := os.ReadFile(Path(root))\n67: \tif err != nil {\n68: \t\tif os.IsNotExist(err) {\n69: \t\t\treturn Settings{}, nil\n70: \t\t}\n71: \t\treturn Settings{}, err\n72: \t}\n73: \tvar s Settings\n74: \tif err := json.Unmarshal(data, &s); err != nil {\n75: \t\treturn Settings{}, fmt.Errorf(\"%s: %w\", Path(root), err)\n76: \t}\n77: \treturn s, nil\n78: }\n79: \n80: // Save writes s to the project settings file under root. The .manigot/\n81: // directory is created if it doesn't already exist — it may not (the TUI's\n82: // baseline is an initialized project whose docs/ exists, but .manigot/ is\n83: // only created once the first project setting is saved).\n84: // The file is committable: it holds only a public ref name, no secrets.\n85: func Save(root string, s Settings) error {\n86: \tdir := filepath.Join(root, \".manigot\")\n87: \tif err := os.MkdirAll(dir, 0o755); err != nil {\n88: \t\treturn err\n89: \t}\n90: \tdata, err := json.MarshalIndent(s, \"\", \"  \")\n91: \tif err != nil {\n92: \t\treturn err\n93: \t}\n94: \treturn os.WriteFile(Path(root), data, 0o644)\n95: }\n\n(End of file - total 95 lines)\n</content>","metadata":{"preview":"// Package project persists project-scoped manigot settings — conventions that\n// belong to the project itself (not to a single user's TUI) and are meant to be\n// committed and shared across a team. It is the project-level counterpart to\n// the personal/global config package (editor, subscription profile), which\n// stays gitignored and per-user.\n//\n// The project conventions are the base branch (the ref new job branches are\n// cut from and the TUI's \"b\" quick-checkout lands on) and the job branch\n// prefix (the namespace job branches live under). They live here rather than\n// in config because both are shared project conventions, not personal\n// preferences.\npackage project\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n)\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/project/settings.go","text":"// Package project persists project-scoped manigot settings — conventions that\n// belong to the project itself (not to a single user's TUI) and are meant to be\n// committed and shared across a team. It is the project-level counterpart to\n// the personal/global config package (editor, subscription profile), which\n// stays gitignored and per-user.\n//\n// The project conventions are the base branch (the ref new job branches are\n// cut from and the TUI's \"b\" quick-checkout lands on) and the job branch\n// prefix (the namespace job branches live under). They live here rather than\n// in config because both are shared project conventions, not personal\n// preferences.\npackage project\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n)\n\n// Settings holds the project-scoped manigot conventions, read from / written\n// to .manigot/manigot.json in the target project's root. Only fields with a\n// project-wide (committable, shareable) lifecycle belong here; anything\n// personal (editor, subscription profile) stays in the global config package.\ntype Settings struct {\n\t// BaseBranch is the ref new job branches are cut from and the TUI's\n\t// list-view \"b\" quick-checkout lands on. Empty is treated as \"main\" —\n\t// see BaseBranchValue.\n\tBaseBranch string `json:\"baseBranch,omitempty\"`\n\n\t// JobBranchPrefix is the namespace job branches live under, prepended to\n\t// the type segment: with prefix \"jobs\" a feature job's branch is\n\t// \"jobs/feature/<id>_<slug>\" instead of \"feature/<id>_<slug>\". Empty\n\t// means no prefix (today's naming). A project that already has a plain\n\t// branch named exactly \"feature\", \"fix\" or \"chore\" cannot create\n\t// branches under that name in git (\"cannot lock ref: 'refs/heads/feature'\n\t// exists\"), so the prefix lets it move job branches into a free\n\t// namespace without renaming anything.\n\tJobBranchPrefix string `json:\"jobBranchPrefix,omitempty\"`\n}\n\n// BaseBranchValue returns s.BaseBranch, defaulting to \"main\" when unset so\n// every reader (the TUI's lifecycle actions, mg job) gets a usable ref even\n// when .manigot/manigot.json is absent or doesn't set the key.\nfunc (s Settings) BaseBranchValue() string {\n\tif s.BaseBranch == \"\" {\n\t\treturn \"main\"\n\t}\n\treturn s.BaseBranch\n}\n\n// Path returns the project settings file's path under the given project root:\n// <root>/.manigot/manigot.json. The root is the target project root the TUI\n// was launched in (App.root), not the manigot checkout — these settings\n// travel with the project being worked on, not with the tool.\nfunc Path(root string) string {\n\treturn filepath.Join(root, \".manigot\", \"manigot.json\")\n}\n\n// Load reads the project settings file under root. A file that does not exist\n// yet (the project hasn't been initialized, or no project settings have ever\n// been saved) is not an error — it yields the zero-value Settings, which every\n// caller treats as \"defaults\" via BaseBranchValue. This mirrors config.Load's\n// shape exactly so the two packages degrade the same way.\nfunc Load(root string) (Settings, error) {\n\tdata, err := os.ReadFile(Path(root))\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn Settings{}, nil\n\t\t}\n\t\treturn Settings{}, err\n\t}\n\tvar s Settings\n\tif err := json.Unmarshal(data, &s); err != nil {\n\t\treturn Settings{}, fmt.Errorf(\"%s: %w\", Path(root), err)\n\t}\n\treturn s, nil\n}\n\n// Save writes s to the project settings file under root. The .manigot/\n// directory is created if it doesn't already exist — it may not (the TUI's\n// baseline is an initialized project whose docs/ exists, but .manigot/ is\n// only created once the first project setting is saved).\n// The file is committable: it holds only a public ref name, no secrets.\nfunc Save(root string, s Settings) error {\n\tdir := filepath.Join(root, \".manigot\")\n\tif err := os.MkdirAll(dir, 0o755); err != nil {\n\t\treturn err\n\t}\n\tdata, err := json.MarshalIndent(s, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.WriteFile(Path(root), data, 0o644)\n}","lineStart":1,"lineEnd":95,"totalLines":95,"truncated":false}},"title":"src/internal/project/settings.go","time":{"start":1787951113927,"end":1787951113930}},"id":"prt_04a30e3c30013ITmnAAwvUNq4m","sessionID":"ses_fb5dcd7a6ffeSGBPKFVeVpziRm","messageID":"msg_04a30dd9f001RWUjPDvSRocUqt"}}
