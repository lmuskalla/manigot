{"type":"tool_use","timestamp":1787952615238,"sessionID":"ses_fb5ba93f2ffe9RBBAgSFG35dIN","part":{"type":"tool","tool":"read","callID":"call_e88e2ac58ec845178b1a832a","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/concurrency_test.go"},"output":"<path>/workspace/src/internal/serve/concurrency_test.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"encoding/json\"\n5: \t\"net/http\"\n6: \t\"net/http/httptest\"\n7: \t\"os\"\n8: \t\"path/filepath\"\n9: \t\"testing\"\n10: \t\"time\"\n11: )\n12: \n13: // This file pins the ProjectLocks boundary across the handler surface: which\n14: // operations take s.locks.Lock(root) and which deliberately do not. The\n15: // boundary is a real correctness property — over-serializing (a launch that\n16: // waits behind an unrelated done) defeats the point of a responsive control\n17: // plane, under-serializing (two git-mutating ops racing on the same project)\n18: // corrupts git metadata. Each test holds the project lock itself (simulating\n19: // an in-flight mutating operation on that project) and asserts the request\n20: // under test either blocks behind it (a lock-taking handler) or completes\n21: // immediately (a non-locking handler).\n22: \n23: // lockBlockTimeout is how long a request that SHOULD block behind the held\n24: // project lock is given before the test concludes it blocked. A handler that\n25: // wrongly skipped the lock would complete in microseconds, so 200ms is an\n26: // enormous margin.\n27: const lockBlockTimeout = 200 * time.Millisecond\n28: \n29: // lockReleaseTimeout is how long a blocked request is given to complete after\n30: // the lock is released.\n31: const lockReleaseTimeout = 3 * time.Second\n32: \n33: // assertBlocksWhileLockHeld starts fn in a goroutine, holds the project lock\n34: // for root, and asserts fn does NOT complete until the lock is released (a\n35: // lock-taking handler). fn is the request's completion signal — it must close\n36: // done when the request finishes. On return the lock has been released and the\n37: // goroutine has completed (the test waits for it, so a fixture-dir cleanup\n38: // never races the still-running handler).\n39: func assertBlocksWhileLockHeld(t *testing.T, srv *Server, root string, fn func(done chan struct{})) {\n40: \tt.Helper()\n41: \tsrv.locks.Lock(root)\n42: \n43: \tdone := make(chan struct{})\n44: \tgo fn(done)\n45: \n46: \tselect {\n47: \tcase <-done:\n48: \t\tsrv.locks.Unlock(root)\n49: \t\tt.Fatal(\"request completed while the project lock was held — a mutating handler must serialize behind s.locks.Lock(root)\")\n50: \tcase <-time.After(lockBlockTimeout):\n51: \t\t// blocked as expected\n52: \t}\n53: \n54: \tsrv.locks.Unlock(root)\n55: \tselect {\n56: \tcase <-done:\n57: \tcase <-time.After(lockReleaseTimeout):\n58: \t\tt.Fatal(\"request did not proceed after the project lock was released\")\n59: \t}\n60: }\n61: \n62: // releaseAndExpectDone releases the lock and asserts the blocked request now\n63: // completes.\n64: func releaseAndExpectDone(t *testing.T, srv *Server, root string, done chan struct{}) {\n65: \tt.Helper()\n66: \tsrv.locks.Unlock(root)\n67: \tselect {\n68: \tcase <-done:\n69: \tcase <-time.After(lockReleaseTimeout):\n70: \t\tt.Fatal(\"request did not proceed after the project lock was released\")\n71: \t}\n72: }\n73: \n74: // assertCompletesWhileLockHeld holds the project lock and asserts fn completes\n75: // promptly — a handler that must NOT take the lock (launch-agent, launch-jdi,\n76: // prune, reads).\n77: func assertCompletesWhileLockHeld(t *testing.T, srv *Server, root string, fn func(done chan struct{})) {\n78: \tt.Helper()\n79: \tsrv.locks.Lock(root)\n80: \tdefer srv.locks.Unlock(root)\n81: \n82: \tdone := make(chan struct{})\n83: \tgo fn(done)\n84: \n85: \tselect {\n86: \tcase <-done:\n87: \t\t// completed without waiting — the boundary holds\n88: \tcase <-time.After(lockBlockTimeout):\n89: \t\tt.Fatal(\"request did not complete while the project lock was held — a non-mutating handler must not block behind s.locks.Lock(root)\")\n90: \t}\n91: }\n92: \n93: // --- lock-taking handlers ----------------------------------------------------\n94: \n95: // TestCreateBlocksBehindProjectLock: create-job takes the lock (git-mutating:\n96: // creates a branch + worktree) — a create issued while another mutating\n97: // operation holds the same project's lock must wait.\n98: func TestCreateBlocksBehindProjectLock(t *testing.T) {\n99: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n100: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n101: \tbase := filepath.Base(root)\n102: \n103: \tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n104: \t\tpost(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Blocked Create\"}`)\n105: \t\tclose(done)\n106: \t})\n107: }\n108: \n109: // TestEditBriefBlocksBehindProjectLock: edit-brief takes the lock (the\n110: // post-write commit touches git) — a write issued behind another mutating\n111: // operation on the same project must wait, so the commit can never race a\n112: // concurrent done/delete on the same worktree.\n113: func TestEditBriefBlocksBehindProjectLock(t *testing.T) {\n114: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n115: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n116: \tbase := filepath.Base(root)\n117: \n118: \tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n119: \t\tput(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/files/brief\", \"\", \"# Brief: X\\n\")\n120: \t\tclose(done)\n121: \t})\n122: }\n123: \n124: // TestDoneBlocksBehindProjectLock: done takes the lock (git-mutating: archive\n125: // + squash merge + branch delete). force:true is required so the request\n126: // reaches the lock rather than returning early on the verdict warning.\n127: func TestDoneBlocksBehindProjectLock(t *testing.T) {\n128: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n129: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n130: \tbase := filepath.Base(root)\n131: \n132: \tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n133: \t\tpost(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/done\", \"\", `{\"force\":true}`)\n134: \t\tclose(done)\n135: \t})\n136: }\n137: \n138: // TestDeleteBlocksBehindProjectLock: delete takes the lock (git-mutating:\n139: // worktree force-remove + branch -D).\n140: func TestDeleteBlocksBehindProjectLock(t *testing.T) {\n141: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n142: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n143: \tbase := filepath.Base(root)\n144: \n145: \tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n146: \t\tpost(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/delete\", \"\", \"\")\n147: \t\tclose(done)\n148: \t})\n149: }\n150: \n151: // TestPushBlocksBehindProjectLock: push takes the lock (git-mutating: pushes\n152: // the branch).\n153: func TestPushBlocksBehindProjectLock(t *testing.T) {\n154: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n155: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n156: \tbase := filepath.Base(root)\n157: \n158: \tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n159: \t\tpost(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/push\", \"\", \"\")\n160: \t\tclose(done)\n161: \t})\n162: }\n163: \n164: // TestOrphanDeleteBlocksBehindProjectLock: orphan-delete takes the lock\n165: // (RemoveOrphansConfirmed calls git.WorktreePrune, which touches git worktree\n166: // metadata) — this task's own reasoned addition to the boundary, since the\n167: // brief's Notes don't name orphan cleanup in the git-mutating set.\n168: func TestOrphanDeleteBlocksBehindProjectLock(t *testing.T) {\n169: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n170: \tfakeOrphan(t, root, \"abandoned_1\")\n171: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n172: \tbase := filepath.Base(root)\n173: \n174: \tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n175: \t\tpost(t, srv, \"/projects/\"+base+\"/orphans/abandoned_1/delete\", \"\", \"\")\n176: \t\tclose(done)\n177: \t})\n178: }\n179: \n180: // --- non-locking handlers ----------------------------------------------------\n181: \n182: // TestLaunchAgentDoesNotBlockBehindProjectLock: launch-agent takes no lock\n183: // (per the brief's Notes — launching an agent doesn't touch git state and\n184: // must not wait behind an unrelated done/delete). A launch issued while\n185: // another mutating operation holds the same project's lock completes\n186: // immediately.\n187: func TestLaunchAgentDoesNotBlockBehindProjectLock(t *testing.T) {\n188: \tfakeCheckout(t, map[string]string{\n189: \t\t\"analyst\": \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n190: \t})\n191: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n192: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n193: \tbase := filepath.Base(root)\n194: \n195: \tassertCompletesWhileLockHeld(t, srv, root, func(done chan struct{}) {\n196: \t\trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/agents/analyst\", \"\", \"\")\n197: \t\tif rec.Code != http.StatusAccepted {\n198: \t\t\tt.Errorf(\"launch-agent status = %d, want 202\", rec.Code)\n199: \t\t}\n200: \t\tclose(done)\n201: \t})\n202: }\n203: \n204: // TestLaunchJDIDoesNotBlockBehindProjectLock: launch-jdi takes no lock (same\n205: // reasoning as launch-agent).\n206: func TestLaunchJDIDoesNotBlockBehindProjectLock(t *testing.T) {\n207: \tstubJdiExe(t, \"/bin/true\")\n208: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n209: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n210: \tbase := filepath.Base(root)\n211: \n212: \tassertCompletesWhileLockHeld(t, srv, root, func(done chan struct{}) {\n213: \t\trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/jdi\", \"\", \"\")\n214: \t\tif rec.Code != http.StatusAccepted {\n215: \t\t\tt.Errorf(\"launch-jdi status = %d, want 202\", rec.Code)\n216: \t\t}\n217: \t\tclose(done)\n218: \t})\n219: }\n220: \n221: // TestPruneDoesNotBlockBehindProjectLock: prune takes no lock (no git or\n222: // project-scoped state at all — orphaned containers are not partitioned by\n223: // project). It completes even while a project lock is held.\n224: func TestPruneDoesNotBlockBehindProjectLock(t *testing.T) {\n225: \tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n226: \n227: \tassertCompletesWhileLockHeld(t, srv, \"\", func(done chan struct{}) {\n228: \t\tpost(t, srv, \"/prune\", \"\", \"\")\n229: \t\tclose(done)\n230: \t})\n231: }\n232: \n233: // TestReadsDoNotBlockBehindProjectLock: read endpoints take no locks — a\n234: // listing issued while a mutating operation holds the project lock completes\n235: // immediately (v1's deliberate no-lock reads).\n236: func TestReadsDoNotBlockBehindProjectLock(t *testing.T) {\n237: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n238: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n239: \tbase := filepath.Base(root)\n240: \n241: \tassertCompletesWhileLockHeld(t, srv, root, func(done chan struct{}) {\n242: \t\tget(t, srv, \"/projects/\"+base+\"/jobs\", \"\")\n243: \t\tclose(done)\n244: \t})\n245: }\n246: \n247: // --- per-project independence ------------------------------------------------\n248: \n249: // TestDifferentProjectsProceedIndependently: the lock is keyed by project\n250: // root — a mutating call on project B proceeds while project A's lock is held\n251: // (the property that keeps a multi-project daemon responsive).\n252: func TestDifferentProjectsProceedIndependently(t *testing.T) {\n253: \trootA := fakeJobProject(t, \"project_a\", minimalBrief(\"A\", \"a\", \"open\", \"feature\", \"2026-08-01\"))\n254: \trootB := fakeJobProject(t, \"project_b\", minimalBrief(\"B\", \"b\", \"open\", \"feature\", \"2026-08-01\"))\n255: \treg := &Registry{entries: []Entry{entryFor(rootA), entryFor(rootB)}}\n256: \tsrv := New(reg, \"test-version\", \"\", nil)\n257: \tbaseB := filepath.Base(rootB)\n258: \n259: \t// Hold A's lock, then create a job in B — B must proceed immediately.\n260: \tassertCompletesWhileLockHeld(t, srv, rootA, func(done chan struct{}) {\n261: \t\trec := post(t, srv, \"/projects/\"+baseB+\"/jobs\", \"\", `{\"title\":\"Independent B\"}`)\n262: \t\tif rec.Code != http.StatusCreated {\n263: \t\t\tt.Errorf(\"create in project B status = %d, want 201\", rec.Code)\n264: \t\t}\n265: \t\tclose(done)\n266: \t})\n267: }\n268: \n269: // TestConcurrentMutatingCallsSerializeSameProject: two mutating calls against\n270: // the SAME project serialize end to end — a blocked create behind a held lock\n271: // proceeds (and succeeds) once the lock is released, proving the handler\n272: // acquires the lock for its whole critical section, not just part of it.\n273: func TestConcurrentMutatingCallsSerializeSameProject(t *testing.T) {\n274: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n275: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n276: \tbase := filepath.Base(root)\n277: \n278: \tsrv.locks.Lock(root)\n279: \tdone := make(chan struct{})\n280: \tvar rec *httptest.ResponseRecorder\n281: \tgo func() {\n282: \t\trec = post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Serialized Create\"}`)\n283: \t\tclose(done)\n284: \t}()\n285: \n286: \tselect {\n287: \tcase <-done:\n288: \t\tt.Fatal(\"create completed while the project lock was held\")\n289: \tcase <-time.After(lockBlockTimeout):\n290: \t}\n291: \n292: \tsrv.locks.Unlock(root)\n293: \tselect {\n294: \tcase <-done:\n295: \tcase <-time.After(lockReleaseTimeout):\n296: \t\tt.Fatal(\"create did not proceed after the project lock was released\")\n297: \t}\n298: \tif rec.Code != http.StatusCreated {\n299: \t\tt.Errorf(\"create status = %d, want 201 after the lock was released\", rec.Code)\n300: \t}\n301: \t// The created job's directory actually exists — the critical section ran\n302: \t// to completion, not just past the lock acquisition.\n303: \tvar body createJobResponse\n304: \tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n305: \t\tt.Fatalf(\"create body not JSON: %v\", err)\n306: \t}\n307: \tif _, err := os.Stat(filepath.Join(root, \"docs\", \"jobs\", body.Job.Name)); err != nil {\n308: \t\tt.Errorf(\"created job dir missing after serialized create: %v\", err)\n309: \t}\n310: }\n\n(End of file - total 310 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n\t\"time\"\n)\n\n// This file pins the ProjectLocks boundary across the handler surface: which\n// operations take s.locks.Lock(root) and which deliberately do not. The\n// boundary is a real correctness property — over-serializing (a launch that\n// waits behind an unrelated done) defeats the point of a responsive control\n// plane, under-serializing (two git-mutating ops racing on the same project)\n// corrupts git metadata. Each test holds the project lock itself (simulating\n// an in-flight mutating operation on that project) and asserts the request\n// under test either blocks behind it (a lock-taking handler) or completes","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/concurrency_test.go","text":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n\t\"time\"\n)\n\n// This file pins the ProjectLocks boundary across the handler surface: which\n// operations take s.locks.Lock(root) and which deliberately do not. The\n// boundary is a real correctness property — over-serializing (a launch that\n// waits behind an unrelated done) defeats the point of a responsive control\n// plane, under-serializing (two git-mutating ops racing on the same project)\n// corrupts git metadata. Each test holds the project lock itself (simulating\n// an in-flight mutating operation on that project) and asserts the request\n// under test either blocks behind it (a lock-taking handler) or completes\n// immediately (a non-locking handler).\n\n// lockBlockTimeout is how long a request that SHOULD block behind the held\n// project lock is given before the test concludes it blocked. A handler that\n// wrongly skipped the lock would complete in microseconds, so 200ms is an\n// enormous margin.\nconst lockBlockTimeout = 200 * time.Millisecond\n\n// lockReleaseTimeout is how long a blocked request is given to complete after\n// the lock is released.\nconst lockReleaseTimeout = 3 * time.Second\n\n// assertBlocksWhileLockHeld starts fn in a goroutine, holds the project lock\n// for root, and asserts fn does NOT complete until the lock is released (a\n// lock-taking handler). fn is the request's completion signal — it must close\n// done when the request finishes. On return the lock has been released and the\n// goroutine has completed (the test waits for it, so a fixture-dir cleanup\n// never races the still-running handler).\nfunc assertBlocksWhileLockHeld(t *testing.T, srv *Server, root string, fn func(done chan struct{})) {\n\tt.Helper()\n\tsrv.locks.Lock(root)\n\n\tdone := make(chan struct{})\n\tgo fn(done)\n\n\tselect {\n\tcase <-done:\n\t\tsrv.locks.Unlock(root)\n\t\tt.Fatal(\"request completed while the project lock was held — a mutating handler must serialize behind s.locks.Lock(root)\")\n\tcase <-time.After(lockBlockTimeout):\n\t\t// blocked as expected\n\t}\n\n\tsrv.locks.Unlock(root)\n\tselect {\n\tcase <-done:\n\tcase <-time.After(lockReleaseTimeout):\n\t\tt.Fatal(\"request did not proceed after the project lock was released\")\n\t}\n}\n\n// releaseAndExpectDone releases the lock and asserts the blocked request now\n// completes.\nfunc releaseAndExpectDone(t *testing.T, srv *Server, root string, done chan struct{}) {\n\tt.Helper()\n\tsrv.locks.Unlock(root)\n\tselect {\n\tcase <-done:\n\tcase <-time.After(lockReleaseTimeout):\n\t\tt.Fatal(\"request did not proceed after the project lock was released\")\n\t}\n}\n\n// assertCompletesWhileLockHeld holds the project lock and asserts fn completes\n// promptly — a handler that must NOT take the lock (launch-agent, launch-jdi,\n// prune, reads).\nfunc assertCompletesWhileLockHeld(t *testing.T, srv *Server, root string, fn func(done chan struct{})) {\n\tt.Helper()\n\tsrv.locks.Lock(root)\n\tdefer srv.locks.Unlock(root)\n\n\tdone := make(chan struct{})\n\tgo fn(done)\n\n\tselect {\n\tcase <-done:\n\t\t// completed without waiting — the boundary holds\n\tcase <-time.After(lockBlockTimeout):\n\t\tt.Fatal(\"request did not complete while the project lock was held — a non-mutating handler must not block behind s.locks.Lock(root)\")\n\t}\n}\n\n// --- lock-taking handlers ----------------------------------------------------\n\n// TestCreateBlocksBehindProjectLock: create-job takes the lock (git-mutating:\n// creates a branch + worktree) — a create issued while another mutating\n// operation holds the same project's lock must wait.\nfunc TestCreateBlocksBehindProjectLock(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\tpost(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Blocked Create\"}`)\n\t\tclose(done)\n\t})\n}\n\n// TestEditBriefBlocksBehindProjectLock: edit-brief takes the lock (the\n// post-write commit touches git) — a write issued behind another mutating\n// operation on the same project must wait, so the commit can never race a\n// concurrent done/delete on the same worktree.\nfunc TestEditBriefBlocksBehindProjectLock(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\tput(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/files/brief\", \"\", \"# Brief: X\\n\")\n\t\tclose(done)\n\t})\n}\n\n// TestDoneBlocksBehindProjectLock: done takes the lock (git-mutating: archive\n// + squash merge + branch delete). force:true is required so the request\n// reaches the lock rather than returning early on the verdict warning.\nfunc TestDoneBlocksBehindProjectLock(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\tpost(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/done\", \"\", `{\"force\":true}`)\n\t\tclose(done)\n\t})\n}\n\n// TestDeleteBlocksBehindProjectLock: delete takes the lock (git-mutating:\n// worktree force-remove + branch -D).\nfunc TestDeleteBlocksBehindProjectLock(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\tpost(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/delete\", \"\", \"\")\n\t\tclose(done)\n\t})\n}\n\n// TestPushBlocksBehindProjectLock: push takes the lock (git-mutating: pushes\n// the branch).\nfunc TestPushBlocksBehindProjectLock(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\tpost(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/push\", \"\", \"\")\n\t\tclose(done)\n\t})\n}\n\n// TestOrphanDeleteBlocksBehindProjectLock: orphan-delete takes the lock\n// (RemoveOrphansConfirmed calls git.WorktreePrune, which touches git worktree\n// metadata) — this task's own reasoned addition to the boundary, since the\n// brief's Notes don't name orphan cleanup in the git-mutating set.\nfunc TestOrphanDeleteBlocksBehindProjectLock(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tfakeOrphan(t, root, \"abandoned_1\")\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertBlocksWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\tpost(t, srv, \"/projects/\"+base+\"/orphans/abandoned_1/delete\", \"\", \"\")\n\t\tclose(done)\n\t})\n}\n\n// --- non-locking handlers ----------------------------------------------------\n\n// TestLaunchAgentDoesNotBlockBehindProjectLock: launch-agent takes no lock\n// (per the brief's Notes — launching an agent doesn't touch git state and\n// must not wait behind an unrelated done/delete). A launch issued while\n// another mutating operation holds the same project's lock completes\n// immediately.\nfunc TestLaunchAgentDoesNotBlockBehindProjectLock(t *testing.T) {\n\tfakeCheckout(t, map[string]string{\n\t\t\"analyst\": \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n\t})\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertCompletesWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/agents/analyst\", \"\", \"\")\n\t\tif rec.Code != http.StatusAccepted {\n\t\t\tt.Errorf(\"launch-agent status = %d, want 202\", rec.Code)\n\t\t}\n\t\tclose(done)\n\t})\n}\n\n// TestLaunchJDIDoesNotBlockBehindProjectLock: launch-jdi takes no lock (same\n// reasoning as launch-agent).\nfunc TestLaunchJDIDoesNotBlockBehindProjectLock(t *testing.T) {\n\tstubJdiExe(t, \"/bin/true\")\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertCompletesWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\trec := post(t, srv, \"/projects/\"+base+\"/jobs/wood_oak/jdi\", \"\", \"\")\n\t\tif rec.Code != http.StatusAccepted {\n\t\t\tt.Errorf(\"launch-jdi status = %d, want 202\", rec.Code)\n\t\t}\n\t\tclose(done)\n\t})\n}\n\n// TestPruneDoesNotBlockBehindProjectLock: prune takes no lock (no git or\n// project-scoped state at all — orphaned containers are not partitioned by\n// project). It completes even while a project lock is held.\nfunc TestPruneDoesNotBlockBehindProjectLock(t *testing.T) {\n\tsrv := New(&Registry{}, \"test-version\", \"\", nil)\n\n\tassertCompletesWhileLockHeld(t, srv, \"\", func(done chan struct{}) {\n\t\tpost(t, srv, \"/prune\", \"\", \"\")\n\t\tclose(done)\n\t})\n}\n\n// TestReadsDoNotBlockBehindProjectLock: read endpoints take no locks — a\n// listing issued while a mutating operation holds the project lock completes\n// immediately (v1's deliberate no-lock reads).\nfunc TestReadsDoNotBlockBehindProjectLock(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tassertCompletesWhileLockHeld(t, srv, root, func(done chan struct{}) {\n\t\tget(t, srv, \"/projects/\"+base+\"/jobs\", \"\")\n\t\tclose(done)\n\t})\n}\n\n// --- per-project independence ------------------------------------------------\n\n// TestDifferentProjectsProceedIndependently: the lock is keyed by project\n// root — a mutating call on project B proceeds while project A's lock is held\n// (the property that keeps a multi-project daemon responsive).\nfunc TestDifferentProjectsProceedIndependently(t *testing.T) {\n\trootA := fakeJobProject(t, \"project_a\", minimalBrief(\"A\", \"a\", \"open\", \"feature\", \"2026-08-01\"))\n\trootB := fakeJobProject(t, \"project_b\", minimalBrief(\"B\", \"b\", \"open\", \"feature\", \"2026-08-01\"))\n\treg := &Registry{entries: []Entry{entryFor(rootA), entryFor(rootB)}}\n\tsrv := New(reg, \"test-version\", \"\", nil)\n\tbaseB := filepath.Base(rootB)\n\n\t// Hold A's lock, then create a job in B — B must proceed immediately.\n\tassertCompletesWhileLockHeld(t, srv, rootA, func(done chan struct{}) {\n\t\trec := post(t, srv, \"/projects/\"+baseB+\"/jobs\", \"\", `{\"title\":\"Independent B\"}`)\n\t\tif rec.Code != http.StatusCreated {\n\t\t\tt.Errorf(\"create in project B status = %d, want 201\", rec.Code)\n\t\t}\n\t\tclose(done)\n\t})\n}\n\n// TestConcurrentMutatingCallsSerializeSameProject: two mutating calls against\n// the SAME project serialize end to end — a blocked create behind a held lock\n// proceeds (and succeeds) once the lock is released, proving the handler\n// acquires the lock for its whole critical section, not just part of it.\nfunc TestConcurrentMutatingCallsSerializeSameProject(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\tsrv.locks.Lock(root)\n\tdone := make(chan struct{})\n\tvar rec *httptest.ResponseRecorder\n\tgo func() {\n\t\trec = post(t, srv, \"/projects/\"+base+\"/jobs\", \"\", `{\"title\":\"Serialized Create\"}`)\n\t\tclose(done)\n\t}()\n\n\tselect {\n\tcase <-done:\n\t\tt.Fatal(\"create completed while the project lock was held\")\n\tcase <-time.After(lockBlockTimeout):\n\t}\n\n\tsrv.locks.Unlock(root)\n\tselect {\n\tcase <-done:\n\tcase <-time.After(lockReleaseTimeout):\n\t\tt.Fatal(\"create did not proceed after the project lock was released\")\n\t}\n\tif rec.Code != http.StatusCreated {\n\t\tt.Errorf(\"create status = %d, want 201 after the lock was released\", rec.Code)\n\t}\n\t// The created job's directory actually exists — the critical section ran\n\t// to completion, not just past the lock acquisition.\n\tvar body createJobResponse\n\tif err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {\n\t\tt.Fatalf(\"create body not JSON: %v\", err)\n\t}\n\tif _, err := os.Stat(filepath.Join(root, \"docs\", \"jobs\", body.Job.Name)); err != nil {\n\t\tt.Errorf(\"created job dir missing after serialized create: %v\", err)\n\t}\n}","lineStart":1,"lineEnd":310,"totalLines":310,"truncated":false}},"title":"src/internal/serve/concurrency_test.go","time":{"start":1787952615233,"end":1787952615237}},"id":"prt_04a47ced5001p88DwZDKBC0f5z","sessionID":"ses_fb5ba93f2ffe9RBBAgSFG35dIN","messageID":"msg_04a47c01d001EORQB1t3O5BpQ8"}}
{"type":"step_finish","timestamp":1787952615308,"sessionID":"ses_fb5ba93f2ffe9RBBAgSFG35dIN","part":{"id":"prt_04a47cf85001DO0RrsXaICpLvT","reason":"tool-calls","snapshot":"","messageID":"msg_04a47c01d001EORQB1t3O5BpQ8","sessionID":"ses_fb5ba93f2ffe9RBBAgSFG35dIN","type":"step-finish","tokens":{"total":146576,"input":4795,"output":469,"reasoning":0,"cache":{"write":0,"read":141312}},"cost":0.004759356}}
{"type":"step_start","timestamp":1787952616866,"sessionID":"ses_fb5ba93f2ffe9RBBAgSFG35dIN","part":{"id":"prt_04a47d5a0001XyAMUAk0cwRA6y","messageID":"msg_04a47cf8b001Ixj183DzBCpvmI","sessionID":"ses_fb5ba93f2ffe9RBBAgSFG35dIN","snapshot":"","type":"step-start"}}
{"type":"tool_use","timestamp":1787952617658,"sessionID":"ses_fb5ba93f2ffe9RBBAgSFG35dIN","part":{"type":"tool","tool":"read","callID":"call_4ac684068259491cb9b513a4","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/security_test.go"},"output":"<path>/workspace/src/internal/serve/security_test.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"net/http\"\n5: \t\"os\"\n6: \t\"path/filepath\"\n7: \t\"strings\"\n8: \t\"testing\"\n9: )\n10: \n11: // hostileSegments are the URL-path segment forms that must never resolve to a\n12: // filesystem path: encoded traversal (single and double), absolute-path\n13: // segments, Windows separators, and NUL bytes. These are the ENCODED forms as\n14: // they appear in a URL — net/http's single decoding pass hands the handler\n15: // the decoded value, which validSegment then rejects. Raw `..` / `.` segments\n16: // in the URL path never reach a handler (ServeMux's own path sanitization\n17: // redirects them first), so they are not in this list; the endpoint tests\n18: // assert that redirect separately.\n19: //\n20: // Why the ENCODED forms reach the handler at all (pinned empirically on\n21: // Go 1.22+): ServeMux's cleanPath sanitization runs on the ESCAPED request\n22: // path (r.URL.EscapedPath), where a segment spelled `%2e%2e` is not the\n23: // literal `.`/`..` cleanPath looks for — so it is not redirected. Only the\n24: // raw literal forms (`/projects/../jobs`) trigger the redirect. The encoded\n25: // forms are therefore matched as wildcard segments with the DECODED hostile\n26: // value in PathValue, and it is validSegment's rejection of that decoded\n27: // value that answers them with 4xx. A future ServeMux that cleaned the\n28: // decoded path instead would answer these with a 3xx redirect — equally\n29: // nothing served, equally nothing read — which is why the endpoint tests\n30: // assert \"4xx\" for the handler-rejected forms and \"3xx\" for the\n31: // mux-sanitized raw forms separately.\n32: var hostileSegments = []string{\n33: \t\"..%2f..%2fetc%2fpasswd\",         // decodes to ../../\n34: \t\"%2e%2e\",                         // decodes to \"..\"\n35: \t\"%2e\",                            // decodes to \".\"\n36: \t\".%2e\",                           // decodes to \"..\"\n37: \t\"%2e%2e%2f%2e%2e%2fetc%2fpasswd\", // fully-encoded traversal\n38: \t\"%2fetc%2fpasswd\",                // decodes to an absolute path\n39: \t\"a%2fb\",                          // decodes to a forward slash\n40: \t\"a%5cb\",                          // decodes to a Windows backslash\n41: \t\"a%00b\",                          // decodes to a NUL byte\n42: \t\"..%252f..%252fetc%252fpasswd\",   // double-encoded traversal\n43: \t\"%252e%252e%252f%252e%252e%252fetc%252fpasswd\",\n44: }\n45: \n46: // decodedHostileSegments are the DECODED segment values — exactly what\n47: // r.PathValue hands the handlers — that validSegment must reject outright.\n48: var decodedHostileSegments = []string{\n49: \t\"..\",\n50: \t\".\",\n51: \t\"../../etc/passwd\",\n52: \t\"/etc/passwd\",\n53: \t\"a/b\",\n54: \t\"a\\\\b\",\n55: \t\"a\\x00b\",\n56: \t\"..\\\\..\\\\etc\\\\passwd\",\n57: \t\"sub/../../x\",\n58: \t\"..\\x00\",\n59: }\n60: \n61: // TestValidSegmentRejectsHostileInput pins the choke-point primitive: every\n62: // hostile decoded segment is rejected outright, while legitimate identifiers\n63: // (job ids, id_slug names, file names) pass. A rejected segment can never\n64: // even reach the matching logic, so it can never be joined into a path.\n65: func TestValidSegmentRejectsHostileInput(t *testing.T) {\n66: \tfor _, seg := range decodedHostileSegments {\n67: \t\tif validSegment(seg) {\n68: \t\t\tt.Errorf(\"validSegment(%q) = true, want false\", seg)\n69: \t\t}\n70: \t}\n71: \tfor _, seg := range []string{\"wood\", \"wood_oak\", \"brief.md\", \"tasks.md\", \"some-project\"} {\n72: \t\tif !validSegment(seg) {\n73: \t\t\tt.Errorf(\"validSegment(%q) = false, want true\", seg)\n74: \t\t}\n75: \t}\n76: }\n77: \n78: // TestValidSegmentRejectsTraversalSubstrings: beyond the exact-segment forms,\n79: // any decoded segment containing a path separator or NUL is rejected — the\n80: // belt-and-braces layer under the whitelists.\n81: func TestValidSegmentRejectsTraversalSubstrings(t *testing.T) {\n82: \tfor _, seg := range []string{\n83: \t\t\"../../etc/passwd\",\n84: \t\t\"/etc/passwd\",\n85: \t\t\"..\\\\..\\\\etc\\\\passwd\",\n86: \t\t\"sub/../../x\",\n87: \t\t\"a\\x00b\",\n88: \t\t\"..\\x00\",\n89: \t} {\n90: \t\tif validSegment(seg) {\n91: \t\t\tt.Errorf(\"validSegment(%q) = true, want false\", seg)\n92: \t\t}\n93: \t}\n94: }\n95: \n96: // TestResolveProjectNeverResolvesOutsideRegistry: the project choke point\n97: // returns not-found for every hostile segment and for unregistered names —\n98: // never a path the handler could open.\n99: func TestResolveProjectNeverResolvesOutsideRegistry(t *testing.T) {\n100: \tsrv, root := testServer(t, \"\", nil)\n101: \tbase := filepath.Base(root)\n102: \n103: \t// The registered base name resolves; hostile and unknown segments do not.\n104: \tfor _, seg := range append(hostileSegments, \"no-such-project\", \"etc\") {\n105: \t\tif _, ok := srv.reg.Project(seg); ok {\n106: \t\t\tt.Errorf(\"Project(%q) resolved, want not-found\", seg)\n107: \t\t}\n108: \t}\n109: \tif got, ok := srv.reg.Project(base); !ok || got != filepath.Clean(root) {\n110: \t\tt.Errorf(\"Project(%q) = %q, %v; want the registered root\", base, got, ok)\n111: \t}\n112: }\n113: \n114: // TestHostileURLsRejectedAtEveryPathPosition: the full endpoint surface — a\n115: // suite of hostile URLs against the project, job, and file path positions,\n116: // asserting 4xx and — critically — that no response carries content from\n117: // outside the registered roots (a secret planted in an unregistered\n118: // directory must never appear).\n119: func TestHostileURLsRejectedAtEveryPathPosition(t *testing.T) {\n120: \t// A secret in an UNREGISTERED directory (a sibling of the registered\n121: \t// project) that hostile URLs must never reach.\n122: \toutside := t.TempDir()\n123: \tif err := os.WriteFile(filepath.Join(outside, \"secret.txt\"), []byte(\"TOP-SECRET-OUTSIDE\"), 0o644); err != nil {\n124: \t\tt.Fatal(err)\n125: \t}\n126: \n127: \t// A secret INSIDE the registered project but outside any whitelisted job\n128: \t// file (session.log — never served by the file endpoint).\n129: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"), \"session.log\")\n130: \tif err := os.WriteFile(filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\", \"session.log\"), []byte(\"TOP-SECRET-SESSION\"), 0o644); err != nil {\n131: \t\tt.Fatal(err)\n132: \t}\n133: \t// And a secret directly in the project root (docs/../secret.txt position).\n134: \tif err := os.WriteFile(filepath.Join(root, \"secret.txt\"), []byte(\"TOP-SECRET-ROOT\"), 0o644); err != nil {\n135: \t\tt.Fatal(err)\n136: \t}\n137: \n138: \treg := &Registry{entries: []Entry{entryFor(root)}}\n139: \tsrv := New(reg, \"test-version\", \"\", nil)\n140: \tbase := filepath.Base(root)\n141: \n142: \ttype hostileURL struct {\n143: \t\tpath string\n144: \t\tdesc string\n145: \t}\n146: \tvar urls []hostileURL\n147: \t// Project position: every hostile segment as the project.\n148: \tfor _, seg := range hostileSegments {\n149: \t\turls = append(urls, hostileURL{\"/projects/\" + seg + \"/jobs\", \"project segment \" + seg})\n150: \t\turls = append(urls, hostileURL{\"/projects/\" + seg + \"/agents\", \"project segment \" + seg})\n151: \t}\n152: \t// Job position: hostile segments as the job (project resolves by base name).\n153: \tfor _, seg := range hostileSegments {\n154: \t\turls = append(urls, hostileURL{\"/projects/\" + base + \"/jobs/\" + seg + \"/files/brief.md\", \"job segment \" + seg})\n155: \t\turls = append(urls, hostileURL{\"/projects/\" + base + \"/jobs/\" + seg + \"/jdi\", \"job segment \" + seg})\n156: \t}\n157: \t// File position: hostile segments as the file (project + job resolve).\n158: \tfor _, seg := range hostileSegments {\n159: \t\turls = append(urls, hostileURL{\"/projects/\" + base + \"/jobs/wood_oak/files/\" + seg, \"file segment \" + seg})\n160: \t}\n161: \t// Attempts to reach the secrets by name.\n162: \turls = append(urls,\n163: \t\thostileURL{\"/projects/\" + base + \"/jobs/wood_oak/files/secret.txt\", \"secret.txt inside the job\"},\n164: \t\thostileURL{\"/projects/\" + base + \"/jobs/wood_oak/files/session.log\", \"session.log (not whitelisted)\"},\n165: \t\thostileURL{\"/projects/\" + filepath.Base(outside) + \"/jobs\", \"unregistered project (secret dir)\"},\n166: \t)\n167: \n168: \tfor _, u := range urls {\n169: \t\trec := get(t, srv, u.path, \"\")\n170: \t\tif rec.Code < 400 || rec.Code >= 500 {\n171: \t\t\tt.Errorf(\"%s (%s): status = %d, want 4xx\", u.desc, u.path, rec.Code)\n172: \t\t}\n173: \t\tif body := rec.Body.String(); strings.Contains(body, \"TOP-SECRET\") {\n174: \t\t\tt.Errorf(\"%s (%s): response leaks secret content: %s\", u.desc, u.path, body)\n175: \t\t}\n176: \t}\n177: \n178: \t// Raw `..` / `.` path segments are redirected by ServeMux's own\n179: \t// sanitization before routing — still never served, never read.\n180: \tfor _, seg := range []string{\"..\", \".\"} {\n181: \t\trec := get(t, srv, \"/projects/\"+seg+\"/jobs\", \"\")\n182: \t\tif rec.Code < 300 || rec.Code >= 400 {\n183: \t\t\tt.Errorf(\"raw %q segment: status = %d, want a 3xx sanitization redirect\", seg, rec.Code)\n184: \t\t}\n185: \t}\n186: }\n187: \n188: // TestResolveJobNeverTreatsSegmentAsPath: the job choke point matches against\n189: // discovered jobs (ID, name, unique prefix) — a segment that is a valid\n190: // identifier but matches nothing is a 404, and no job path is ever derived\n191: // from the segment itself.\n192: func TestResolveJobNeverTreatsSegmentAsPath(t *testing.T) {\n193: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n194: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n195: \n196: \t// A valid-looking identifier that matches nothing → 404.\n197: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/wood_birch/files/brief.md\", \"\")\n198: \tif rec.Code != http.StatusNotFound {\n199: \t\tt.Errorf(\"unmatched job segment: status = %d, want 404\", rec.Code)\n200: \t}\n201: \t// The resolved job's files are read from the discovered job's Dir — never\n202: \t// from a path built from the URL.\n203: \trec = get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/wood_oak/files/brief.md\", \"\")\n204: \tif rec.Code != http.StatusOK {\n205: \t\tt.Errorf(\"matched job segment: status = %d, want 200\", rec.Code)\n206: \t}\n207: }\n208: \n209: // TestHostileURLsRejectedOnMutatingSurface extends the hostile-segment suite\n210: // to job two's mutating endpoints: every new URL position (the {agent} and\n211: // {name} segments, and the mutating methods on the existing {project}/{job}\n212: // positions) must reject encoded traversal with a 4xx and never leak content\n213: // from outside the registered roots. Mutating requests are never allowed to\n214: // reach a handler's critical section with a hostile segment — validation\n215: // happens in the same resolveProject/resolveJob/validSegment choke points the\n216: // read-only surface uses.\n217: func TestHostileURLsRejectedOnMutatingSurface(t *testing.T) {\n218: \toutside := t.TempDir()\n219: \tif err := os.WriteFile(filepath.Join(outside, \"secret.txt\"), []byte(\"TOP-SECRET-MUTATE\"), 0o644); err != nil {\n220: \t\tt.Fatal(err)\n221: \t}\n222: \t// A checkout so agentlist.Discover succeeds (the launch-agent handler\n223: \t// lists agents before validating the {agent} segment) — the hostile\n224: \t// segment then correctly 404s as an unknown agent rather than hitting the\n225: \t// \"cannot list agents\" 500 path.\n226: \tfakeCheckout(t, map[string]string{\n227: \t\t\"analyst\": \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n228: \t})\n229: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n230: \treg := &Registry{entries: []Entry{entryFor(root)}}\n231: \tsrv := New(reg, \"test-version\", \"\", nil)\n232: \tbase := filepath.Base(root)\n233: \n234: \ttype mutURL struct {\n235: \t\tmethod, path string\n236: \t\tdesc         string\n237: \t}\n238: \tvar urls []mutURL\n239: \n240: \t// Project position on the create route (the one mutating route with a\n241: \t// {project} segment and no {job}).\n242: \tfor _, seg := range hostileSegments {\n243: \t\turls = append(urls, mutURL{http.MethodPost, \"/projects/\" + seg + \"/jobs\", \"create project segment \" + seg})\n244: \t}\n245: \t// Job position on every mutating route.\n246: \tfor _, seg := range hostileSegments {\n247: \t\turls = append(urls,\n248: \t\t\tmutURL{http.MethodPut, \"/projects/\" + base + \"/jobs/\" + seg + \"/files/brief\", \"edit-brief job segment \" + seg},\n249: \t\t\tmutURL{http.MethodPost, \"/projects/\" + base + \"/jobs/\" + seg + \"/agents/analyst\", \"launch-agent job segment \" + seg},\n250: \t\t\tmutURL{http.MethodPost, \"/projects/\" + base + \"/jobs/\" + seg + \"/jdi\", \"launch-jdi job segment \" + seg},\n251: \t\t\tmutURL{http.MethodPost, \"/projects/\" + base + \"/jobs/\" + seg + \"/done\", \"done job segment \" + seg},\n252: \t\t\tmutURL{http.MethodPost, \"/projects/\" + base + \"/jobs/\" + seg + \"/delete\", \"delete job segment \" + seg},\n253: \t\t\tmutURL{http.MethodPost, \"/projects/\" + base + \"/jobs/\" + seg + \"/push\", \"push job segment \" + seg},\n254: \t\t)\n255: \t}\n256: \t// Agent position: hostile segments as the {agent}.\n257: \tfor _, seg := range hostileSegments {\n258: \t\turls = append(urls, mutURL{http.MethodPost, \"/projects/\" + base + \"/jobs/wood_oak/agents/\" + seg, \"agent segment \" + seg})\n259: \t}\n260: \t// Orphan-name position: hostile segments as the {name}.\n261: \tfor _, seg := range hostileSegments {\n262: \t\turls = append(urls, mutURL{http.MethodPost, \"/projects/\" + base + \"/orphans/\" + seg + \"/delete\", \"orphan name segment \" + seg})\n263: \t}\n264: \n265: \tfor _, u := range urls {\n266: \t\trec := request(t, srv, u.method, u.path, \"\", \"\")\n267: \t\tif rec.Code < 400 || rec.Code >= 500 {\n268: \t\t\tt.Errorf(\"%s (%s %s): status = %d, want 4xx\", u.desc, u.method, u.path, rec.Code)\n269: \t\t}\n270: \t\tif body := rec.Body.String(); strings.Contains(body, \"TOP-SECRET\") {\n271: \t\t\tt.Errorf(\"%s (%s %s): response leaks secret content: %s\", u.desc, u.method, u.path, body)\n272: \t\t}\n273: \t}\n274: }\n\n(End of file - total 274 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// hostileSegments are the URL-path segment forms that must never resolve to a\n// filesystem path: encoded traversal (single and double), absolute-path\n// segments, Windows separators, and NUL bytes. These are the ENCODED forms as\n// they appear in a URL — net/http's single decoding pass hands the handler\n// the decoded value, which validSegment then rejects. Raw `..` / `.` segments\n// in the URL path never reach a handler (ServeMux's own path sanitization\n// redirects them first), so they are not in this list; the endpoint tests\n// assert that redirect separately.\n//\n// Why the ENCODED forms reach the handler at all (pinned empirically on","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/security_test.go","text":"package serve\n\nimport (\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// hostileSegments are the URL-path segment forms that must never resolve to a\n// filesystem path: encoded traversal (single and double), absolute-path\n// segments, Windows separators, and NUL bytes. These are the ENCODED forms as\n// they appear in a URL — net/http's single decoding pass hands the handler\n// the decoded value, which validSegment then rejects. Raw `..` / `.` segments\n// in the URL path never reach a handler (ServeMux's own path sanitization\n// redirects them first), so they are not in this list; the endpoint tests\n// assert that redirect separately.\n//\n// Why the ENCODED forms reach the handler at all (pinned empirically on\n// Go 1.22+): ServeMux's cleanPath sanitization runs on the ESCAPED request\n// path (r.URL.EscapedPath), where a segment spelled `%2e%2e` is not the\n// literal `.`/`..` cleanPath looks for — so it is not redirected. Only the\n// raw literal forms (`/projects/../jobs`) trigger the redirect. The encoded\n// forms are therefore matched as wildcard segments with the DECODED hostile\n// value in PathValue, and it is validSegment's rejection of that decoded\n// value that answers them with 4xx. A future ServeMux that cleaned the\n// decoded path instead would answer these with a 3xx redirect — equally\n// nothing served, equally nothing read — which is why the endpoint tests\n// assert \"4xx\" for the handler-rejected forms and \"3xx\" for the\n// mux-sanitized raw forms separately.\nvar hostileSegments = []string{\n\t\"..%2f..%2fetc%2fpasswd\",         // decodes to ../../\n\t\"%2e%2e\",                         // decodes to \"..\"\n\t\"%2e\",                            // decodes to \".\"\n\t\".%2e\",                           // decodes to \"..\"\n\t\"%2e%2e%2f%2e%2e%2fetc%2fpasswd\", // fully-encoded traversal\n\t\"%2fetc%2fpasswd\",                // decodes to an absolute path\n\t\"a%2fb\",                          // decodes to a forward slash\n\t\"a%5cb\",                          // decodes to a Windows backslash\n\t\"a%00b\",                          // decodes to a NUL byte\n\t\"..%252f..%252fetc%252fpasswd\",   // double-encoded traversal\n\t\"%252e%252e%252f%252e%252e%252fetc%252fpasswd\",\n}\n\n// decodedHostileSegments are the DECODED segment values — exactly what\n// r.PathValue hands the handlers — that validSegment must reject outright.\nvar decodedHostileSegments = []string{\n\t\"..\",\n\t\".\",\n\t\"../../etc/passwd\",\n\t\"/etc/passwd\",\n\t\"a/b\",\n\t\"a\\\\b\",\n\t\"a\\x00b\",\n\t\"..\\\\..\\\\etc\\\\passwd\",\n\t\"sub/../../x\",\n\t\"..\\x00\",\n}\n\n// TestValidSegmentRejectsHostileInput pins the choke-point primitive: every\n// hostile decoded segment is rejected outright, while legitimate identifiers\n// (job ids, id_slug names, file names) pass. A rejected segment can never\n// even reach the matching logic, so it can never be joined into a path.\nfunc TestValidSegmentRejectsHostileInput(t *testing.T) {\n\tfor _, seg := range decodedHostileSegments {\n\t\tif validSegment(seg) {\n\t\t\tt.Errorf(\"validSegment(%q) = true, want false\", seg)\n\t\t}\n\t}\n\tfor _, seg := range []string{\"wood\", \"wood_oak\", \"brief.md\", \"tasks.md\", \"some-project\"} {\n\t\tif !validSegment(seg) {\n\t\t\tt.Errorf(\"validSegment(%q) = false, want true\", seg)\n\t\t}\n\t}\n}\n\n// TestValidSegmentRejectsTraversalSubstrings: beyond the exact-segment forms,\n// any decoded segment containing a path separator or NUL is rejected — the\n// belt-and-braces layer under the whitelists.\nfunc TestValidSegmentRejectsTraversalSubstrings(t *testing.T) {\n\tfor _, seg := range []string{\n\t\t\"../../etc/passwd\",\n\t\t\"/etc/passwd\",\n\t\t\"..\\\\..\\\\etc\\\\passwd\",\n\t\t\"sub/../../x\",\n\t\t\"a\\x00b\",\n\t\t\"..\\x00\",\n\t} {\n\t\tif validSegment(seg) {\n\t\t\tt.Errorf(\"validSegment(%q) = true, want false\", seg)\n\t\t}\n\t}\n}\n\n// TestResolveProjectNeverResolvesOutsideRegistry: the project choke point\n// returns not-found for every hostile segment and for unregistered names —\n// never a path the handler could open.\nfunc TestResolveProjectNeverResolvesOutsideRegistry(t *testing.T) {\n\tsrv, root := testServer(t, \"\", nil)\n\tbase := filepath.Base(root)\n\n\t// The registered base name resolves; hostile and unknown segments do not.\n\tfor _, seg := range append(hostileSegments, \"no-such-project\", \"etc\") {\n\t\tif _, ok := srv.reg.Project(seg); ok {\n\t\t\tt.Errorf(\"Project(%q) resolved, want not-found\", seg)\n\t\t}\n\t}\n\tif got, ok := srv.reg.Project(base); !ok || got != filepath.Clean(root) {\n\t\tt.Errorf(\"Project(%q) = %q, %v; want the registered root\", base, got, ok)\n\t}\n}\n\n// TestHostileURLsRejectedAtEveryPathPosition: the full endpoint surface — a\n// suite of hostile URLs against the project, job, and file path positions,\n// asserting 4xx and — critically — that no response carries content from\n// outside the registered roots (a secret planted in an unregistered\n// directory must never appear).\nfunc TestHostileURLsRejectedAtEveryPathPosition(t *testing.T) {\n\t// A secret in an UNREGISTERED directory (a sibling of the registered\n\t// project) that hostile URLs must never reach.\n\toutside := t.TempDir()\n\tif err := os.WriteFile(filepath.Join(outside, \"secret.txt\"), []byte(\"TOP-SECRET-OUTSIDE\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\t// A secret INSIDE the registered project but outside any whitelisted job\n\t// file (session.log — never served by the file endpoint).\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"), \"session.log\")\n\tif err := os.WriteFile(filepath.Join(root, \"docs\", \"jobs\", \"wood_oak\", \"session.log\"), []byte(\"TOP-SECRET-SESSION\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// And a secret directly in the project root (docs/../secret.txt position).\n\tif err := os.WriteFile(filepath.Join(root, \"secret.txt\"), []byte(\"TOP-SECRET-ROOT\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\treg := &Registry{entries: []Entry{entryFor(root)}}\n\tsrv := New(reg, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\ttype hostileURL struct {\n\t\tpath string\n\t\tdesc string\n\t}\n\tvar urls []hostileURL\n\t// Project position: every hostile segment as the project.\n\tfor _, seg := range hostileSegments {\n\t\turls = append(urls, hostileURL{\"/projects/\" + seg + \"/jobs\", \"project segment \" + seg})\n\t\turls = append(urls, hostileURL{\"/projects/\" + seg + \"/agents\", \"project segment \" + seg})\n\t}\n\t// Job position: hostile segments as the job (project resolves by base name).\n\tfor _, seg := range hostileSegments {\n\t\turls = append(urls, hostileURL{\"/projects/\" + base + \"/jobs/\" + seg + \"/files/brief.md\", \"job segment \" + seg})\n\t\turls = append(urls, hostileURL{\"/projects/\" + base + \"/jobs/\" + seg + \"/jdi\", \"job segment \" + seg})\n\t}\n\t// File position: hostile segments as the file (project + job resolve).\n\tfor _, seg := range hostileSegments {\n\t\turls = append(urls, hostileURL{\"/projects/\" + base + \"/jobs/wood_oak/files/\" + seg, \"file segment \" + seg})\n\t}\n\t// Attempts to reach the secrets by name.\n\turls = append(urls,\n\t\thostileURL{\"/projects/\" + base + \"/jobs/wood_oak/files/secret.txt\", \"secret.txt inside the job\"},\n\t\thostileURL{\"/projects/\" + base + \"/jobs/wood_oak/files/session.log\", \"session.log (not whitelisted)\"},\n\t\thostileURL{\"/projects/\" + filepath.Base(outside) + \"/jobs\", \"unregistered project (secret dir)\"},\n\t)\n\n\tfor _, u := range urls {\n\t\trec := get(t, srv, u.path, \"\")\n\t\tif rec.Code < 400 || rec.Code >= 500 {\n\t\t\tt.Errorf(\"%s (%s): status = %d, want 4xx\", u.desc, u.path, rec.Code)\n\t\t}\n\t\tif body := rec.Body.String(); strings.Contains(body, \"TOP-SECRET\") {\n\t\t\tt.Errorf(\"%s (%s): response leaks secret content: %s\", u.desc, u.path, body)\n\t\t}\n\t}\n\n\t// Raw `..` / `.` path segments are redirected by ServeMux's own\n\t// sanitization before routing — still never served, never read.\n\tfor _, seg := range []string{\"..\", \".\"} {\n\t\trec := get(t, srv, \"/projects/\"+seg+\"/jobs\", \"\")\n\t\tif rec.Code < 300 || rec.Code >= 400 {\n\t\t\tt.Errorf(\"raw %q segment: status = %d, want a 3xx sanitization redirect\", seg, rec.Code)\n\t\t}\n\t}\n}\n\n// TestResolveJobNeverTreatsSegmentAsPath: the job choke point matches against\n// discovered jobs (ID, name, unique prefix) — a segment that is a valid\n// identifier but matches nothing is a 404, and no job path is ever derived\n// from the segment itself.\nfunc TestResolveJobNeverTreatsSegmentAsPath(t *testing.T) {\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"\", nil)\n\n\t// A valid-looking identifier that matches nothing → 404.\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/wood_birch/files/brief.md\", \"\")\n\tif rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"unmatched job segment: status = %d, want 404\", rec.Code)\n\t}\n\t// The resolved job's files are read from the discovered job's Dir — never\n\t// from a path built from the URL.\n\trec = get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/wood_oak/files/brief.md\", \"\")\n\tif rec.Code != http.StatusOK {\n\t\tt.Errorf(\"matched job segment: status = %d, want 200\", rec.Code)\n\t}\n}\n\n// TestHostileURLsRejectedOnMutatingSurface extends the hostile-segment suite\n// to job two's mutating endpoints: every new URL position (the {agent} and\n// {name} segments, and the mutating methods on the existing {project}/{job}\n// positions) must reject encoded traversal with a 4xx and never leak content\n// from outside the registered roots. Mutating requests are never allowed to\n// reach a handler's critical section with a hostile segment — validation\n// happens in the same resolveProject/resolveJob/validSegment choke points the\n// read-only surface uses.\nfunc TestHostileURLsRejectedOnMutatingSurface(t *testing.T) {\n\toutside := t.TempDir()\n\tif err := os.WriteFile(filepath.Join(outside, \"secret.txt\"), []byte(\"TOP-SECRET-MUTATE\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// A checkout so agentlist.Discover succeeds (the launch-agent handler\n\t// lists agents before validating the {agent} segment) — the hostile\n\t// segment then correctly 404s as an unknown agent rather than hitting the\n\t// \"cannot list agents\" 500 path.\n\tfakeCheckout(t, map[string]string{\n\t\t\"analyst\": \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n\t})\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\treg := &Registry{entries: []Entry{entryFor(root)}}\n\tsrv := New(reg, \"test-version\", \"\", nil)\n\tbase := filepath.Base(root)\n\n\ttype mutURL struct {\n\t\tmethod, path string\n\t\tdesc         string\n\t}\n\tvar urls []mutURL\n\n\t// Project position on the create route (the one mutating route with a\n\t// {project} segment and no {job}).\n\tfor _, seg := range hostileSegments {\n\t\turls = append(urls, mutURL{http.MethodPost, \"/projects/\" + seg + \"/jobs\", \"create project segment \" + seg})\n\t}\n\t// Job position on every mutating route.\n\tfor _, seg := range hostileSegments {\n\t\turls = append(urls,\n\t\t\tmutURL{http.MethodPut, \"/projects/\" + base + \"/jobs/\" + seg + \"/files/brief\", \"edit-brief job segment \" + seg},\n\t\t\tmutURL{http.MethodPost, \"/projects/\" + base + \"/jobs/\" + seg + \"/agents/analyst\", \"launch-agent job segment \" + seg},\n\t\t\tmutURL{http.MethodPost, \"/projects/\" + base + \"/jobs/\" + seg + \"/jdi\", \"launch-jdi job segment \" + seg},\n\t\t\tmutURL{http.MethodPost, \"/projects/\" + base + \"/jobs/\" + seg + \"/done\", \"done job segment \" + seg},\n\t\t\tmutURL{http.MethodPost, \"/projects/\" + base + \"/jobs/\" + seg + \"/delete\", \"delete job segment \" + seg},\n\t\t\tmutURL{http.MethodPost, \"/projects/\" + base + \"/jobs/\" + seg + \"/push\", \"push job segment \" + seg},\n\t\t)\n\t}\n\t// Agent position: hostile segments as the {agent}.\n\tfor _, seg := range hostileSegments {\n\t\turls = append(urls, mutURL{http.MethodPost, \"/projects/\" + base + \"/jobs/wood_oak/agents/\" + seg, \"agent segment \" + seg})\n\t}\n\t// Orphan-name position: hostile segments as the {name}.\n\tfor _, seg := range hostileSegments {\n\t\turls = append(urls, mutURL{http.MethodPost, \"/projects/\" + base + \"/orphans/\" + seg + \"/delete\", \"orphan name segment \" + seg})\n\t}\n\n\tfor _, u := range urls {\n\t\trec := request(t, srv, u.method, u.path, \"\", \"\")\n\t\tif rec.Code < 400 || rec.Code >= 500 {\n\t\t\tt.Errorf(\"%s (%s %s): status = %d, want 4xx\", u.desc, u.method, u.path, rec.Code)\n\t\t}\n\t\tif body := rec.Body.String(); strings.Contains(body, \"TOP-SECRET\") {\n\t\t\tt.Errorf(\"%s (%s %s): response leaks secret content: %s\", u.desc, u.method, u.path, body)\n\t\t}\n\t}\n}","lineStart":1,"lineEnd":274,"totalLines":274,"truncated":false}},"title":"src/internal/serve/security_test.go","time":{"start":1787952617653,"end":1787952617656}},"id":"prt_04a47d86e001C6ApnYMjBec6LA","sessionID":"ses_fb5ba93f2ffe9RBBAgSFG35dIN","messageID":"msg_04a47cf8b001Ixj183DzBCpvmI"}}
{"type":"tool_use","timestamp":1787952617775,"sessionID":"ses_fb5ba93f2ffe9RBBAgSFG35dIN","part":{"type":"tool","tool":"read","callID":"call_27f05c61b3b64c6ca4622d0c","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/serve/credentials_test.go"},"output":"<path>/workspace/src/internal/serve/credentials_test.go</path>\n<type>file</type>\n<content>\n1: package serve\n2: \n3: import (\n4: \t\"encoding/json\"\n5: \t\"net/http\"\n6: \t\"os\"\n7: \t\"path/filepath\"\n8: \t\"strings\"\n9: \t\"testing\"\n10: \n11: \t\"github.com/lmuskalla/manigot/internal/job\"\n12: )\n13: \n14: // credentialKeys are the keys whose values must never appear in any response\n15: // body — the daemon's credential surface: subscription tokens, API keys, the\n16: // serve token, and the per-profile model keys. The test reads their values via\n17: // the same config.EnvValue path the daemon itself reads (the .env file in the\n18: // manigot checkout, then the process environment), so the test and the server\n19: // can never drift on what counts as a credential.\n20: var credentialKeys = []string{\n21: \t\"CLAUDE_CODE_OAUTH_TOKEN\",\n22: \t\"CLAUDE_ACCOUNT_UUID\",\n23: \t\"CLAUDE_EMAIL\",\n24: \t\"CLAUDE_ORG_UUID\",\n25: \t\"ANTHROPIC_API_KEY\",\n26: \t\"OPENCODE_API_KEY\",\n27: \t\"ZHIPU_API_KEY\",\n28: \t\"MG_SERVE_TOKEN\",\n29: \t\"OPENCODE_ZAI_MODEL\",\n30: \t\"OPENCODE_GO_MODEL\",\n31: \t\"OPENCODE_ZEN_MODEL\",\n32: \t\"OPENCODE_ZEN_FREE_MODEL\",\n33: \t\"OPENCODE_MODEL\",\n34: \t\"OPENCODE_THEME\",\n35: }\n36: \n37: // TestCredentialsNeverReturned is the brief's \"no .env content, no keys, no\n38: // tokens in any response, ever\" guarantee enforced over the whole surface: a\n39: // known credential value is planted in the daemon's real credential source\n40: // (.env + process env), every endpoint is hit (with the correct bearer token),\n41: // and every response body — including a 401 — is grepped for the values.\n42: func TestCredentialsNeverReturned(t *testing.T) {\n43: \t// The credential source: a fake checkout's .env plus the process\n44: \t// environment, both read through config.EnvValue exactly as the daemon\n45: \t// reads them.\n46: \tenvLines := map[string]string{}\n47: \tfor _, key := range credentialKeys {\n48: \t\tenvLines[key] = \"fixture-\" + key + \"-VALUE\"\n49: \t\tt.Setenv(key, envLines[key])\n50: \t}\n51: \tcheckout := fakeCheckout(t, map[string]string{\n52: \t\t\"analyst\": \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n53: \t})\n54: \t// The .env file itself — the daemon's preferred source. Two extra\n55: \t// non-credential lines ride along to pin the \"no full line of .env\n56: \t// content\" half of the guarantee.\n57: \tvar envFile strings.Builder\n58: \tfor _, key := range credentialKeys {\n59: \t\tenvFile.WriteString(key + \"=\" + envLines[key] + \"\\n\")\n60: \t}\n61: \tenvFile.WriteString(\"# a comment line in the env\\n\")\n62: \tenvFile.WriteString(\"UNRELATED_SETTING=some-value\\n\")\n63: \tif err := os.WriteFile(filepath.Join(checkout, \".env\"), []byte(envFile.String()), 0o644); err != nil {\n64: \t\tt.Fatal(err)\n65: \t}\n66: \n67: \t// A non-git project with a job (exercises projects/jobs/files/jdi/agents),\n68: \t// and a git repo with a job branch (exercises diff).\n69: \tjobProj := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"),\n70: \t\t\"tasks.md\", \"implementation.md\", \"verdict.md\")\n71: \tif err := writeJDIStatusForTest(t, jobProj, \"wood_oak\"); err != nil {\n72: \t\tt.Fatal(err)\n73: \t}\n74: \tlogDir := job.JDIStatusDir(jobProj, \"wood_oak\")\n75: \tif err := os.MkdirAll(logDir, 0o755); err != nil {\n76: \t\tt.Fatal(err)\n77: \t}\n78: \tif err := os.WriteFile(job.JDIRunLogPath(jobProj, \"wood_oak\"), []byte(\"run log content\\n\"), 0o644); err != nil {\n79: \t\tt.Fatal(err)\n80: \t}\n81: \tif err := os.WriteFile(filepath.Join(jobProj, \"docs\", \"jobs\", \"wood_oak\", \"session.log\"), []byte(\"session log content\\n\"), 0o644); err != nil {\n82: \t\tt.Fatal(err)\n83: \t}\n84: \n85: \tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n86: \tgitProj := initGitRepo(t)\n87: \trunGitT(t, gitProj, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n88: \tif err := os.WriteFile(filepath.Join(gitProj, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n89: \t\tt.Fatal(err)\n90: \t}\n91: \trunGitT(t, gitProj, \"add\", \"feature.txt\")\n92: \trunGitT(t, gitProj, \"commit\", \"-q\", \"-m\", \"add the feature\")\n93: \trunGitT(t, gitProj, \"checkout\", \"-q\", \"main\")\n94: \n95: \treg := &Registry{entries: []Entry{entryFor(jobProj), entryFor(gitProj)}}\n96: \ttoken := envLines[\"MG_SERVE_TOKEN\"]\n97: \tvar audit strings.Builder\n98: \tsrv := New(reg, \"test-version\", token, &audit)\n99: \tauth := \"Bearer \" + token\n100: \n101: \t// Every endpoint, plus a 401 (no token) and a 404 (unknown job) — the\n102: \t// error envelopes are response surfaces too.\n103: \tpaths := []string{\n104: \t\t\"/health\",\n105: \t\t\"/projects\",\n106: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs\",\n107: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/brief.md\",\n108: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/tasks.md\",\n109: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/implementation.md\",\n110: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/verdict.md\",\n111: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/jdi\",\n112: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/agents\",\n113: \t\t\"/projects/\" + filepath.Base(gitProj) + \"/jobs/wood_test/diff\",\n114: \t\t\"/projects/\" + filepath.Base(gitProj) + \"/jobs/wood_test/diff?full=1\",\n115: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/jdi?bogus=1\",\n116: \t\t\"/projects/no-such-project/jobs\",\n117: \t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/no-such-job/files/brief.md\",\n118: \t}\n119: \tfor _, p := range paths {\n120: \t\trec := get(t, srv, p, auth)\n121: \t\tassertBodyHasNoCredentials(t, rec.Body.String(), envLines, envFile.String())\n122: \t}\n123: \n124: \t// Job two's mutating surface — every mutating endpoint's response or error\n125: \t// body (the 2xx success envelopes and the 4xx/5xx structured errors alike)\n126: \t// must never echo .env content. All of these run against the fake non-git\n127: \t// jobProj (gitProj has no docs/jobs, so its mutating routes resolve no\n128: \t// job), which exercises the resolution + error-envelope paths; the success\n129: \t// envelopes (create, edit-brief, orphans-list) carry only identifiers and\n130: \t// status text.\n131: \tmutating := []struct {\n132: \t\tmethod, path, body string\n133: \t}{\n134: \t\t// create: succeeds (non-git fallback) — the 201 envelope must not echo\n135: \t\t// credentials.\n136: \t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs\", `{\"title\":\"Cred Check\"}`},\n137: \t\t// create with a bad type: a 400 error envelope.\n138: \t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs\", `{\"title\":\"X\",\"type\":\"bogus\"}`},\n139: \t\t// edit-brief: succeeds — the write + (non-git) warning envelope.\n140: \t\t{http.MethodPut, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/brief\", \"# Brief: Cred Check\\n\"},\n141: \t\t// launch-agent: 404 for an unknown agent (agentlist.Discover reads the\n142: \t\t// checkout's agents — see fakeCheckout above), never a credential echo.\n143: \t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/agents/no-such-agent\", \"\"},\n144: \t\t// launch-jdi: 202 (the mg binary is stubbed), or a structured error.\n145: \t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/jdi\", \"\"},\n146: \t\t// done: 409 verdict warning (the fake job has no verdict) — the\n147: \t\t// warning text must not echo credentials.\n148: \t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/done\", \"\"},\n149: \t\t// push: non-git project → a structured 500 git error envelope.\n150: \t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/push\", \"\"},\n151: \t\t// prune: docker absent → a structured 500 error envelope.\n152: \t\t{http.MethodPost, \"/prune\", \"\"},\n153: \t\t// orphans list: read-only, an empty (or populated) list envelope.\n154: \t\t{http.MethodGet, \"/projects/\" + filepath.Base(jobProj) + \"/orphans\", \"\"},\n155: \t\t// orphan delete: 404 for an unknown orphan — the error envelope.\n156: \t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/orphans/no-such-orphan/delete\", \"\"},\n157: \t\t// session-log stream: a bad ?from is a 400 before any SSE body — the\n158: \t\t// error envelope (the stream itself is exercised in stream_test.go).\n159: \t\t{http.MethodGet, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/session-log/stream?from=-1\", \"\"},\n160: \t\t// delete: resolves a real (non-git) job — the DeleteResult envelope.\n161: \t\t// Kept last: it removes wood_oak, so every earlier request still\n162: \t\t// resolves the job.\n163: \t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/delete\", \"\"},\n164: \t}\n165: \tstubJdiExe(t, \"/bin/true\")\n166: \tfor _, m := range mutating {\n167: \t\trec := request(t, srv, m.method, m.path, auth, m.body)\n168: \t\tassertBodyHasNoCredentials(t, rec.Body.String(), envLines, envFile.String())\n169: \t}\n170: \n171: \t// The 401 body (missing and wrong token) — an unauthenticated response\n172: \t// must not leak the token either.\n173: \tfor _, badAuth := range []string{\"\", \"Bearer wrong\"} {\n174: \t\trec := get(t, srv, \"/projects\", badAuth)\n175: \t\tif rec.Code != http.StatusUnauthorized {\n176: \t\t\tt.Fatalf(\"bad auth %q: status = %d, want 401\", badAuth, rec.Code)\n177: \t\t}\n178: \t\tassertBodyHasNoCredentials(t, rec.Body.String(), envLines, envFile.String())\n179: \t}\n180: \n181: \t// The audit log likewise never carries the Authorization header or the\n182: \t// token (the auth= field is the outcome classification only).\n183: \tif strings.Contains(audit.String(), token) {\n184: \t\tt.Errorf(\"audit log contains the token:\\n%s\", audit.String())\n185: \t}\n186: \tfor _, line := range strings.Split(audit.String(), \"\\n\") {\n187: \t\tif strings.Contains(line, \"Authorization\") || strings.Contains(line, \"Bearer \") {\n188: \t\t\tt.Errorf(\"audit log echoes the Authorization header: %q\", line)\n189: \t\t}\n190: \t}\n191: }\n192: \n193: // assertBodyHasNoCredentials fails the test if body contains any planted\n194: // credential value or any full line of the .env file.\n195: func assertBodyHasNoCredentials(t *testing.T, body string, envLines map[string]string, envFileContent string) {\n196: \tt.Helper()\n197: \tfor _, key := range credentialKeys {\n198: \t\tif strings.Contains(body, envLines[key]) {\n199: \t\t\tt.Errorf(\"response leaks the value of %s:\\n%s\", key, body)\n200: \t\t}\n201: \t}\n202: \tfor _, line := range strings.Split(envFileContent, \"\\n\") {\n203: \t\tif line == \"\" {\n204: \t\t\tcontinue\n205: \t\t}\n206: \t\tif strings.Contains(body, line) {\n207: \t\t\tt.Errorf(\"response contains a full .env line %q:\\n%s\", line, body)\n208: \t\t}\n209: \t}\n210: }\n211: \n212: // TestCredentialValuesDoNotAppearInErrorMessages: error envelopes carry only\n213: // validated identifiers — never anything that could echo a credential.\n214: func TestCredentialValuesDoNotAppearInErrorMessages(t *testing.T) {\n215: \tt.Setenv(\"MG_SERVE_TOKEN\", \"fixture-token-12345\")\n216: \troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n217: \tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"fixture-token-12345\", nil)\n218: \n219: \t// The error envelope shape is exactly {\"error\": \"...\"} — nothing else.\n220: \trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/nope/files/brief.md\", \"Bearer fixture-token-12345\")\n221: \tif rec.Code != http.StatusNotFound {\n222: \t\tt.Fatalf(\"status = %d, want 404\", rec.Code)\n223: \t}\n224: \tvar envelope map[string]string\n225: \tif err := json.Unmarshal(rec.Body.Bytes(), &envelope); err != nil {\n226: \t\tt.Fatalf(\"error body not a JSON envelope: %v (%s)\", err, rec.Body.String())\n227: \t}\n228: \tif len(envelope) != 1 || envelope[\"error\"] == \"\" {\n229: \t\tt.Errorf(\"error envelope = %v, want exactly one error key\", envelope)\n230: \t}\n231: \tif strings.Contains(rec.Body.String(), \"fixture-token-12345\") {\n232: \t\tt.Errorf(\"error body leaks the token: %s\", rec.Body.String())\n233: \t}\n234: }\n\n(End of file - total 234 lines)\n</content>","metadata":{"preview":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// credentialKeys are the keys whose values must never appear in any response\n// body — the daemon's credential surface: subscription tokens, API keys, the\n// serve token, and the per-profile model keys. The test reads their values via\n// the same config.EnvValue path the daemon itself reads (the .env file in the\n// manigot checkout, then the process environment), so the test and the server\n// can never drift on what counts as a credential.\nvar credentialKeys = []string{","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/serve/credentials_test.go","text":"package serve\n\nimport (\n\t\"encoding/json\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/lmuskalla/manigot/internal/job\"\n)\n\n// credentialKeys are the keys whose values must never appear in any response\n// body — the daemon's credential surface: subscription tokens, API keys, the\n// serve token, and the per-profile model keys. The test reads their values via\n// the same config.EnvValue path the daemon itself reads (the .env file in the\n// manigot checkout, then the process environment), so the test and the server\n// can never drift on what counts as a credential.\nvar credentialKeys = []string{\n\t\"CLAUDE_CODE_OAUTH_TOKEN\",\n\t\"CLAUDE_ACCOUNT_UUID\",\n\t\"CLAUDE_EMAIL\",\n\t\"CLAUDE_ORG_UUID\",\n\t\"ANTHROPIC_API_KEY\",\n\t\"OPENCODE_API_KEY\",\n\t\"ZHIPU_API_KEY\",\n\t\"MG_SERVE_TOKEN\",\n\t\"OPENCODE_ZAI_MODEL\",\n\t\"OPENCODE_GO_MODEL\",\n\t\"OPENCODE_ZEN_MODEL\",\n\t\"OPENCODE_ZEN_FREE_MODEL\",\n\t\"OPENCODE_MODEL\",\n\t\"OPENCODE_THEME\",\n}\n\n// TestCredentialsNeverReturned is the brief's \"no .env content, no keys, no\n// tokens in any response, ever\" guarantee enforced over the whole surface: a\n// known credential value is planted in the daemon's real credential source\n// (.env + process env), every endpoint is hit (with the correct bearer token),\n// and every response body — including a 401 — is grepped for the values.\nfunc TestCredentialsNeverReturned(t *testing.T) {\n\t// The credential source: a fake checkout's .env plus the process\n\t// environment, both read through config.EnvValue exactly as the daemon\n\t// reads them.\n\tenvLines := map[string]string{}\n\tfor _, key := range credentialKeys {\n\t\tenvLines[key] = \"fixture-\" + key + \"-VALUE\"\n\t\tt.Setenv(key, envLines[key])\n\t}\n\tcheckout := fakeCheckout(t, map[string]string{\n\t\t\"analyst\": \"name: analyst\\ndescription: Breaks requests into tasks.\\n\",\n\t})\n\t// The .env file itself — the daemon's preferred source. Two extra\n\t// non-credential lines ride along to pin the \"no full line of .env\n\t// content\" half of the guarantee.\n\tvar envFile strings.Builder\n\tfor _, key := range credentialKeys {\n\t\tenvFile.WriteString(key + \"=\" + envLines[key] + \"\\n\")\n\t}\n\tenvFile.WriteString(\"# a comment line in the env\\n\")\n\tenvFile.WriteString(\"UNRELATED_SETTING=some-value\\n\")\n\tif err := os.WriteFile(filepath.Join(checkout, \".env\"), []byte(envFile.String()), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\t// A non-git project with a job (exercises projects/jobs/files/jdi/agents),\n\t// and a git repo with a job branch (exercises diff).\n\tjobProj := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"),\n\t\t\"tasks.md\", \"implementation.md\", \"verdict.md\")\n\tif err := writeJDIStatusForTest(t, jobProj, \"wood_oak\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tlogDir := job.JDIStatusDir(jobProj, \"wood_oak\")\n\tif err := os.MkdirAll(logDir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(job.JDIRunLogPath(jobProj, \"wood_oak\"), []byte(\"run log content\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(jobProj, \"docs\", \"jobs\", \"wood_oak\", \"session.log\"), []byte(\"session log content\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tt.Setenv(\"PATH\", pathWithRealGitOnly(t))\n\tgitProj := initGitRepo(t)\n\trunGitT(t, gitProj, \"checkout\", \"-q\", \"-b\", \"feature/wood_test\")\n\tif err := os.WriteFile(filepath.Join(gitProj, \"feature.txt\"), []byte(\"feature\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\trunGitT(t, gitProj, \"add\", \"feature.txt\")\n\trunGitT(t, gitProj, \"commit\", \"-q\", \"-m\", \"add the feature\")\n\trunGitT(t, gitProj, \"checkout\", \"-q\", \"main\")\n\n\treg := &Registry{entries: []Entry{entryFor(jobProj), entryFor(gitProj)}}\n\ttoken := envLines[\"MG_SERVE_TOKEN\"]\n\tvar audit strings.Builder\n\tsrv := New(reg, \"test-version\", token, &audit)\n\tauth := \"Bearer \" + token\n\n\t// Every endpoint, plus a 401 (no token) and a 404 (unknown job) — the\n\t// error envelopes are response surfaces too.\n\tpaths := []string{\n\t\t\"/health\",\n\t\t\"/projects\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/brief.md\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/tasks.md\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/implementation.md\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/verdict.md\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/jdi\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/agents\",\n\t\t\"/projects/\" + filepath.Base(gitProj) + \"/jobs/wood_test/diff\",\n\t\t\"/projects/\" + filepath.Base(gitProj) + \"/jobs/wood_test/diff?full=1\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/jdi?bogus=1\",\n\t\t\"/projects/no-such-project/jobs\",\n\t\t\"/projects/\" + filepath.Base(jobProj) + \"/jobs/no-such-job/files/brief.md\",\n\t}\n\tfor _, p := range paths {\n\t\trec := get(t, srv, p, auth)\n\t\tassertBodyHasNoCredentials(t, rec.Body.String(), envLines, envFile.String())\n\t}\n\n\t// Job two's mutating surface — every mutating endpoint's response or error\n\t// body (the 2xx success envelopes and the 4xx/5xx structured errors alike)\n\t// must never echo .env content. All of these run against the fake non-git\n\t// jobProj (gitProj has no docs/jobs, so its mutating routes resolve no\n\t// job), which exercises the resolution + error-envelope paths; the success\n\t// envelopes (create, edit-brief, orphans-list) carry only identifiers and\n\t// status text.\n\tmutating := []struct {\n\t\tmethod, path, body string\n\t}{\n\t\t// create: succeeds (non-git fallback) — the 201 envelope must not echo\n\t\t// credentials.\n\t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs\", `{\"title\":\"Cred Check\"}`},\n\t\t// create with a bad type: a 400 error envelope.\n\t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs\", `{\"title\":\"X\",\"type\":\"bogus\"}`},\n\t\t// edit-brief: succeeds — the write + (non-git) warning envelope.\n\t\t{http.MethodPut, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/files/brief\", \"# Brief: Cred Check\\n\"},\n\t\t// launch-agent: 404 for an unknown agent (agentlist.Discover reads the\n\t\t// checkout's agents — see fakeCheckout above), never a credential echo.\n\t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/agents/no-such-agent\", \"\"},\n\t\t// launch-jdi: 202 (the mg binary is stubbed), or a structured error.\n\t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/jdi\", \"\"},\n\t\t// done: 409 verdict warning (the fake job has no verdict) — the\n\t\t// warning text must not echo credentials.\n\t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/done\", \"\"},\n\t\t// push: non-git project → a structured 500 git error envelope.\n\t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/push\", \"\"},\n\t\t// prune: docker absent → a structured 500 error envelope.\n\t\t{http.MethodPost, \"/prune\", \"\"},\n\t\t// orphans list: read-only, an empty (or populated) list envelope.\n\t\t{http.MethodGet, \"/projects/\" + filepath.Base(jobProj) + \"/orphans\", \"\"},\n\t\t// orphan delete: 404 for an unknown orphan — the error envelope.\n\t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/orphans/no-such-orphan/delete\", \"\"},\n\t\t// session-log stream: a bad ?from is a 400 before any SSE body — the\n\t\t// error envelope (the stream itself is exercised in stream_test.go).\n\t\t{http.MethodGet, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/session-log/stream?from=-1\", \"\"},\n\t\t// delete: resolves a real (non-git) job — the DeleteResult envelope.\n\t\t// Kept last: it removes wood_oak, so every earlier request still\n\t\t// resolves the job.\n\t\t{http.MethodPost, \"/projects/\" + filepath.Base(jobProj) + \"/jobs/wood_oak/delete\", \"\"},\n\t}\n\tstubJdiExe(t, \"/bin/true\")\n\tfor _, m := range mutating {\n\t\trec := request(t, srv, m.method, m.path, auth, m.body)\n\t\tassertBodyHasNoCredentials(t, rec.Body.String(), envLines, envFile.String())\n\t}\n\n\t// The 401 body (missing and wrong token) — an unauthenticated response\n\t// must not leak the token either.\n\tfor _, badAuth := range []string{\"\", \"Bearer wrong\"} {\n\t\trec := get(t, srv, \"/projects\", badAuth)\n\t\tif rec.Code != http.StatusUnauthorized {\n\t\t\tt.Fatalf(\"bad auth %q: status = %d, want 401\", badAuth, rec.Code)\n\t\t}\n\t\tassertBodyHasNoCredentials(t, rec.Body.String(), envLines, envFile.String())\n\t}\n\n\t// The audit log likewise never carries the Authorization header or the\n\t// token (the auth= field is the outcome classification only).\n\tif strings.Contains(audit.String(), token) {\n\t\tt.Errorf(\"audit log contains the token:\\n%s\", audit.String())\n\t}\n\tfor _, line := range strings.Split(audit.String(), \"\\n\") {\n\t\tif strings.Contains(line, \"Authorization\") || strings.Contains(line, \"Bearer \") {\n\t\t\tt.Errorf(\"audit log echoes the Authorization header: %q\", line)\n\t\t}\n\t}\n}\n\n// assertBodyHasNoCredentials fails the test if body contains any planted\n// credential value or any full line of the .env file.\nfunc assertBodyHasNoCredentials(t *testing.T, body string, envLines map[string]string, envFileContent string) {\n\tt.Helper()\n\tfor _, key := range credentialKeys {\n\t\tif strings.Contains(body, envLines[key]) {\n\t\t\tt.Errorf(\"response leaks the value of %s:\\n%s\", key, body)\n\t\t}\n\t}\n\tfor _, line := range strings.Split(envFileContent, \"\\n\") {\n\t\tif line == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif strings.Contains(body, line) {\n\t\t\tt.Errorf(\"response contains a full .env line %q:\\n%s\", line, body)\n\t\t}\n\t}\n}\n\n// TestCredentialValuesDoNotAppearInErrorMessages: error envelopes carry only\n// validated identifiers — never anything that could echo a credential.\nfunc TestCredentialValuesDoNotAppearInErrorMessages(t *testing.T) {\n\tt.Setenv(\"MG_SERVE_TOKEN\", \"fixture-token-12345\")\n\troot := fakeJobProject(t, \"wood_oak\", minimalBrief(\"Oak\", \"wod\", \"open\", \"feature\", \"2026-08-01\"))\n\tsrv := New(&Registry{entries: []Entry{entryFor(root)}}, \"test-version\", \"fixture-token-12345\", nil)\n\n\t// The error envelope shape is exactly {\"error\": \"...\"} — nothing else.\n\trec := get(t, srv, \"/projects/\"+filepath.Base(root)+\"/jobs/nope/files/brief.md\", \"Bearer fixture-token-12345\")\n\tif rec.Code != http.StatusNotFound {\n\t\tt.Fatalf(\"status = %d, want 404\", rec.Code)\n\t}\n\tvar envelope map[string]string\n\tif err := json.Unmarshal(rec.Body.Bytes(), &envelope); err != nil {\n\t\tt.Fatalf(\"error body not a JSON envelope: %v (%s)\", err, rec.Body.String())\n\t}\n\tif len(envelope) != 1 || envelope[\"error\"] == \"\" {\n\t\tt.Errorf(\"error envelope = %v, want exactly one error key\", envelope)\n\t}\n\tif strings.Contains(rec.Body.String(), \"fixture-token-12345\") {\n\t\tt.Errorf(\"error body leaks the token: %s\", rec.Body.String())\n\t}\n}","lineStart":1,"lineEnd":234,"totalLines":234,"truncated":false}},"title":"src/internal/serve/credentials_test.go","time":{"start":1787952617771,"end":1787952617774}},"id":"prt_04a47d8cf00141IhdWWU0EumQi","sessionID":"ses_fb5ba93f2ffe9RBBAgSFG35dIN","messageID":"msg_04a47cf8b001Ixj183DzBCpvmI"}}
