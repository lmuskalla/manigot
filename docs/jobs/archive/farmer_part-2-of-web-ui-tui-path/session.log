[]byte(\"first output\\n\"))\n48: \twriteAndClose(t, path, \"developer\", 2, []byte(\"second output\\n\"))\n49: \tdata, err := os.ReadFile(path)\n50: \tif err != nil {\n51: \t\tt.Fatal(err)\n52: \t}\n53: \tgot := string(data)\n54: \tif i, j := strings.Index(got, \"analyst (attempt 1)\"), strings.Index(got, \"developer (attempt 2)\"); i == -1 || j == -1 || i > j {\n55: \t\tt.Errorf(\"session.log sections out of order or missing, got:\\n%s\", got)\n56: \t}\n57: \tif i, j := strings.Index(got, \"first output\"), strings.Index(got, \"second output\"); i == -1 || j == -1 || i > j {\n58: \t\tt.Errorf(\"session.log raw outputs out of order or missing, got:\\n%s\", got)\n59: \t}\n60: }\n61: \n62: func TestOpenSessionLogHeaderCarriesAgentAttemptTimestamp(t *testing.T) {\n63: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n64: \twriteAndClose(t, path, \"reviewer\", 3, []byte(\"ok\\n\"))\n65: \tdata, err := os.ReadFile(path)\n66: \tif err != nil {\n67: \t\tt.Fatal(err)\n68: \t}\n69: \t// The header is the first line: \"=== <RFC3339 timestamp> <agent>\n70: \t// (attempt N) ===\".\n71: \tline, _, _ := strings.Cut(string(data), \"\\n\")\n72: \tif !strings.HasPrefix(line, \"=== \") || !strings.HasSuffix(line, \" reviewer (attempt 3) ===\") {\n73: \t\tt.Fatalf(\"header line = %q, want %q shape\", line, \"=== <timestamp> reviewer (attempt 3) ===\")\n74: \t}\n75: \tts := strings.TrimSuffix(strings.TrimPrefix(line, \"=== \"), \" reviewer (attempt 3) ===\")\n76: \tif _, err := time.Parse(time.RFC3339, ts); err != nil {\n77: \t\tt.Errorf(\"header timestamp %q is not RFC3339: %v\", ts, err)\n78: \t}\n79: }\n80: \n81: func TestOpenSessionLogPreservesRawVerbatim(t *testing.T) {\n82: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n83: \traw := []byte(\"line one\\nline two\\nline three\\n\")\n84: \twriteAndClose(t, path, \"analyst\", 1, raw)\n85: \tdata, err := os.ReadFile(path)\n86: \tif err != nil {\n87: \t\tt.Fatal(err)\n88: \t}\n89: \tif !strings.Contains(string(data), \"line one\\nline two\\nline three\\n\") {\n90: \t\tt.Errorf(\"session.log = %q, want the raw bytes preserved verbatim\", string(data))\n91: \t}\n92: }\n93: \n94: func TestOpenSessionLogSectionsSeparated(t *testing.T) {\n95: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n96: \t// Two sections where the first's raw output deliberately lacks a\n97: \t// trailing newline: the blank-line separator plus the trailing-newline\n98: \t// guarantee must keep the second section's header from gluing to it.\n99: \twriteAndClose(t, path, \"analyst\", 1, []byte(\"no trailing newline\"))\n100: \twriteAndClose(t, path, \"developer\", 1, []byte(\"second\\n\"))\n101: \tdata, err := os.ReadFile(path)\n102: \tif err != nil {\n103: \t\tt.Fatal(err)\n104: \t}\n105: \tgot := string(data)\n106: \tif !strings.Contains(got, \"no trailing newline\\n\\n=== \") {\n107: \t\tt.Errorf(\"sections not separated by a blank line, got:\\n%q\", got)\n108: \t}\n109: }\n110: \n111: func TestOpenSessionLogTrailingNewlineGuarantee(t *testing.T) {\n112: \t// Raw output without a trailing newline gets one appended on Close...\n113: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n114: \twriteAndClose(t, path, \"analyst\", 1, []byte(\"no newline\"))\n115: \tdata, err := os.ReadFile(path)\n116: \tif err != nil {\n117: \t\tt.Fatal(err)\n118: \t}\n119: \tif !strings.HasSuffix(string(data), \"no newline\\n\") {\n120: \t\tt.Errorf(\"session.log = %q, want the raw output to end with a newline\", string(data))\n121: \t}\n122: \t// ...and output that already ends with one is not double-newlined.\n123: \tpath2 := filepath.Join(t.TempDir(), \"session.log\")\n124: \twriteAndClose(t, path2, \"analyst\", 1, []byte(\"has newline\\n\"))\n125: \tdata2, err := os.ReadFile(path2)\n126: \tif err != nil {\n127: \t\tt.Fatal(err)\n128: \t}\n129: \tif strings.HasSuffix(string(data2), \"has newline\\n\\n\") {\n130: \t\tt.Errorf(\"session.log = %q, want exactly one trailing newline\", string(data2))\n131: \t}\n132: }\n133: \n134: func TestOpenSessionLogEmptyRawStillWritesHeader(t *testing.T) {\n135: \tpath := filepath.Join(t.TempDir(), \"session.log\")\n136: \t// An invocation that produces no output still opens + closes its\n137: \t// section: the header (with its own trailing newline) is the section.\n138: \ts, err := OpenSessionLog(path, \"analyst\", 1)\n139: \tif err != nil {\n140: \t\tt.Fatal(err)\n141: \t}\n142: \tif err := s.Close(); err != nil {\n143: \t\tt.Fatal(err)\n144: \t}\n145: \tdata, err := os.ReadFile(path)\n146: \tif err != nil {\n147: \t\tt.Fatal(err)\n148: \t}\n149: \tif got := string(data); !strings.Contains(got, \"analyst (attempt 1)\") {\n150: \t\tt.Errorf(\"session.log = %q, want the header even for empty output\", got)\n151: \t}\n152: \tif !strings.HasSuffix(string(data), \"===\\n\") {\n153: \t\tt.Errorf(\"session.log = %q, want the header's own newline as the section end\", string(data))\n154: \t}\n155: }\n\n(End of file - total 155 lines)\n</content>","metadata":{"preview":"package job\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\n// --- session.log live-stream helper (OpenSessionLog + SessionLog) ----------\n\n// writeAndClose streams raw into a freshly opened session.log section and\n// closes it, failing the test on either error.\nfunc writeAndClose(t *testing.T, path, agent string, attempt int, raw []byte) {\n\tt.Helper()\n\ts, err := OpenSessionLog(path, agent, attempt)\n\tif err != nil {\n\t\tt.Fatalf(\"OpenSessionLog: %v\", err)\n\t}","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/job/sessionlog_test.go","text":"package job\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\n// --- session.log live-stream helper (OpenSessionLog + SessionLog) ----------\n\n// writeAndClose streams raw into a freshly opened session.log section and\n// closes it, failing the test on either error.\nfunc writeAndClose(t *testing.T, path, agent string, attempt int, raw []byte) {\n\tt.Helper()\n\ts, err := OpenSessionLog(path, agent, attempt)\n\tif err != nil {\n\t\tt.Fatalf(\"OpenSessionLog: %v\", err)\n\t}\n\tif _, err := s.Write(raw); err != nil {\n\t\tt.Fatalf(\"SessionLog.Write: %v\", err)\n\t}\n\tif err := s.Close(); err != nil {\n\t\tt.Fatalf(\"SessionLog.Close: %v\", err)\n\t}\n}\n\nfunc TestOpenSessionLogCreatesOnFirstUse(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\twriteAndClose(t, path, \"analyst\", 1, []byte(\"Wrote tasks.md.\\n\"))\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatalf(\"reading session.log: %v\", err)\n\t}\n\tgot := string(data)\n\tif !strings.Contains(got, \"analyst (attempt 1)\") {\n\t\tt.Errorf(\"session.log = %q, want an analyst (attempt 1) header\", got)\n\t}\n\tif !strings.Contains(got, \"Wrote tasks.md.\") {\n\t\tt.Errorf(\"session.log = %q, want the raw output preserved\", got)\n\t}\n}\n\nfunc TestOpenSessionLogAppendsAcrossSections(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\twriteAndClose(t, path, \"analyst\", 1, []byte(\"first output\\n\"))\n\twriteAndClose(t, path, \"developer\", 2, []byte(\"second output\\n\"))\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgot := string(data)\n\tif i, j := strings.Index(got, \"analyst (attempt 1)\"), strings.Index(got, \"developer (attempt 2)\"); i == -1 || j == -1 || i > j {\n\t\tt.Errorf(\"session.log sections out of order or missing, got:\\n%s\", got)\n\t}\n\tif i, j := strings.Index(got, \"first output\"), strings.Index(got, \"second output\"); i == -1 || j == -1 || i > j {\n\t\tt.Errorf(\"session.log raw outputs out of order or missing, got:\\n%s\", got)\n\t}\n}\n\nfunc TestOpenSessionLogHeaderCarriesAgentAttemptTimestamp(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\twriteAndClose(t, path, \"reviewer\", 3, []byte(\"ok\\n\"))\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// The header is the first line: \"=== <RFC3339 timestamp> <agent>\n\t// (attempt N) ===\".\n\tline, _, _ := strings.Cut(string(data), \"\\n\")\n\tif !strings.HasPrefix(line, \"=== \") || !strings.HasSuffix(line, \" reviewer (attempt 3) ===\") {\n\t\tt.Fatalf(\"header line = %q, want %q shape\", line, \"=== <timestamp> reviewer (attempt 3) ===\")\n\t}\n\tts := strings.TrimSuffix(strings.TrimPrefix(line, \"=== \"), \" reviewer (attempt 3) ===\")\n\tif _, err := time.Parse(time.RFC3339, ts); err != nil {\n\t\tt.Errorf(\"header timestamp %q is not RFC3339: %v\", ts, err)\n\t}\n}\n\nfunc TestOpenSessionLogPreservesRawVerbatim(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\traw := []byte(\"line one\\nline two\\nline three\\n\")\n\twriteAndClose(t, path, \"analyst\", 1, raw)\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !strings.Contains(string(data), \"line one\\nline two\\nline three\\n\") {\n\t\tt.Errorf(\"session.log = %q, want the raw bytes preserved verbatim\", string(data))\n\t}\n}\n\nfunc TestOpenSessionLogSectionsSeparated(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\t// Two sections where the first's raw output deliberately lacks a\n\t// trailing newline: the blank-line separator plus the trailing-newline\n\t// guarantee must keep the second section's header from gluing to it.\n\twriteAndClose(t, path, \"analyst\", 1, []byte(\"no trailing newline\"))\n\twriteAndClose(t, path, \"developer\", 1, []byte(\"second\\n\"))\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgot := string(data)\n\tif !strings.Contains(got, \"no trailing newline\\n\\n=== \") {\n\t\tt.Errorf(\"sections not separated by a blank line, got:\\n%q\", got)\n\t}\n}\n\nfunc TestOpenSessionLogTrailingNewlineGuarantee(t *testing.T) {\n\t// Raw output without a trailing newline gets one appended on Close...\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\twriteAndClose(t, path, \"analyst\", 1, []byte(\"no newline\"))\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !strings.HasSuffix(string(data), \"no newline\\n\") {\n\t\tt.Errorf(\"session.log = %q, want the raw output to end with a newline\", string(data))\n\t}\n\t// ...and output that already ends with one is not double-newlined.\n\tpath2 := filepath.Join(t.TempDir(), \"session.log\")\n\twriteAndClose(t, path2, \"analyst\", 1, []byte(\"has newline\\n\"))\n\tdata2, err := os.ReadFile(path2)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif strings.HasSuffix(string(data2), \"has newline\\n\\n\") {\n\t\tt.Errorf(\"session.log = %q, want exactly one trailing newline\", string(data2))\n\t}\n}\n\nfunc TestOpenSessionLogEmptyRawStillWritesHeader(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"session.log\")\n\t// An invocation that produces no output still opens + closes its\n\t// section: the header (with its own trailing newline) is the section.\n\ts, err := OpenSessionLog(path, \"analyst\", 1)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := s.Close(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif got := string(data); !strings.Contains(got, \"analyst (attempt 1)\") {\n\t\tt.Errorf(\"session.log = %q, want the header even for empty output\", got)\n\t}\n\tif !strings.HasSuffix(string(data), \"===\\n\") {\n\t\tt.Errorf(\"session.log = %q, want the header's own newline as the section end\", string(data))\n\t}\n}","lineStart":1,"lineEnd":155,"totalLines":155,"truncated":false}},"title":"src/internal/job/sessionlog_test.go","time":{"start":1787952953648,"end":1787952953654}},"id":"prt_04a4cf902001LuRrJPn35NUy8E","sessionID":"ses_fb5b402d5ffesBMXb1jVe3Cozl","messageID":"msg_04a4cf3bb0019U6fop9UBJuQZU"}}
