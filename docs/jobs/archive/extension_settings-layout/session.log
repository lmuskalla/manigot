{"type":"tool_use","timestamp":1787920728346,"sessionID":"ses_fb79f1c04ffeYG6ohZOnXBocr5","part":{"type":"tool","tool":"read","callID":"call_00_r00A44j7ADtWs4JztyCz2267","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/ui/settings.go"},"output":"<path>/workspace/src/internal/ui/settings.go</path>\n<type>file</type>\n<content>\n1: package ui\n2: \n3: import (\n4: \t\"fmt\"\n5: \t\"strconv\"\n6: \t\"strings\"\n7: \n8: \t\"github.com/charmbracelet/bubbles/textinput\"\n9: \ttea \"github.com/charmbracelet/bubbletea\"\n10: \t\"github.com/charmbracelet/lipgloss\"\n11: \n12: \t\"github.com/lmuskalla/manigot/internal/config\"\n13: \t\"github.com/lmuskalla/manigot/internal/project\"\n14: )\n15: \n16: // profileOptions mirrors the profiles accepted by scripts/run.sh's --profile\n17: // flag, in cycle order.\n18: var profileOptions = config.Profiles()\n19: \n20: // recentActivityCountMax is the upper end of the valid range for the\n21: // recent-activity count setting (the floor is 1). Values outside 1–100 are\n22: // rejected by the settings form.\n23: const recentActivityCountMax = 100\n24: \n25: // Number of focusable fields in the settings form: editor, base branch, job\n26: // branch prefix, recent activity count, profile, terminal, theme — in tab\n27: // cycle order. Kept as a named constant so the tab/shift+tab cycle and focus\n28: // comparisons don't all hardcode a literal that has to be kept in sync field\n29: // by field.\n30: const stFieldCount = 7\n31: \n32: // settingsLabelWidth is the display width of the settings form's label\n33: // column — the length of the longest setting headline (\"Job branch prefix\")\n34: // — so every text input starts at the same x and the form reads as aligned\n35: // columns rather than a ragged wall of label+input pairs.\n36: const settingsLabelWidth = 17\n37: \n38: // Focus indices for the settings form's fields, in tab cycle order: editor →\n39: // base branch → job branch prefix → recent activity count → profile →\n40: // terminal → theme → editor. Used by update() and render() instead of bare\n41: // ints. Terminal was appended after Profile, and Theme after Terminal, rather\n42: // than inserted next to Editor, so the existing constants keep their values\n43: // unchanged.\n44: const (\n45: \tstFocusEditor    = 0\n46: \tstFocusBranch    = 1\n47: \tstFocusJobPrefix = 2\n48: \tstFocusCount     = 3\n49: \tstFocusProfile   = 4\n50: \tstFocusTerminal  = 5\n51: \tstFocusTheme     = 6\n52: )\n53: \n54: // stAction is what update returns for the App to act on.\n55: type stAction int\n56: \n57: const (\n58: \tstNone   stAction = iota\n59: \tstCancel          // esc — discard and return to the list\n60: \tstSubmit          // enter — persist the settings\n61: )\n62: \n63: // settingsView is the \"Settings\" form, laid out as two bold-headed sections\n64: // that mirror the storage split the form edits:\n65: //\n66: //   - Personal settings — the editor preference, the recent-activity count,\n67: //     the subscription profile, the terminal and the theme: global, personal\n68: //     preferences stored in config/tui-settings.json (editor, recent activity,\n69: //     terminal) and manigot/.env (the profile as MANIGOT_PROFILE — the one\n70: //     default shared between CLI and TUI: bare `mg` resolves to it, `mg\n71: //     profiles` writes it, and this form reads/writes the same key — and the\n72: //     theme as OPENCODE_THEME), both gitignored, in the manigot checkout;\n73: //   - Project settings — the base branch and job branch prefix: shared\n74: //     project conventions, committable, in the target project's\n75: //     .manigot/manigot.json.\n76: //\n77: // Like newJobView, it does not persist anything itself — the App calls\n78: // config.Save and project.Save on submit so this stays a pure input\n79: // component.\n80: type settingsView struct {\n81: \teditor          textinput.Model\n82: \tbaseBranch      textinput.Model\n83: \tjobBranchPrefix textinput.Model\n84: \trecentCount     textinput.Model\n85: \tterminal        textinput.Model\n86: \ttheme           textinput.Model\n87: \tprofile         int // index into profileOptions\n88: \tfocus           int // stFocusEditor / stFocusBranch / stFocusJobPrefix / stFocusCount / stFocusProfile / stFocusTerminal / stFocusTheme\n89: \twidth           int\n90: \theight          int\n91: \tstatus          string // validation/save error message\n92: }\n93: \n94: // newSettingsView builds the form seeded from the current global config and\n95: // project settings. The editor field is focused first, matching the form's\n96: // pre-base-branch behaviour.\n97: func newSettingsView(global config.Settings, proj project.Settings, width, height int) *settingsView {\n98: \teditor := textinput.New()\n99: \teditor.Placeholder = \"$VISUAL / $EDITOR / nano\"\n100: \teditor.Prompt = \"\" // we render our own \"Editor:\" label\n101: \teditor.CharLimit = 120\n102: \teditor.SetValue(global.Editor)\n103: \teditor.Focus()\n104: \teditor.Width = 60\n105: \n106: \tbaseBranch := textinput.New()\n107: \tbaseBranch.Placeholder = \"main\"\n108: \tbaseBranch.Prompt = \"\" // we render our own \"Base branch:\" label\n109: \tbaseBranch.CharLimit = 120\n110: \tbaseBranch.SetValue(proj.BaseBranch)\n111: \tbaseBranch.Width = 60\n112: \n113: \tjobBranchPrefix := textinput.New()\n114: \tjobBranchPrefix.Placeholder = \"jobs\"\n115: \tjobBranchPrefix.Prompt = \"\" // we render our own \"Job branch prefix:\" label\n116: \tjobBranchPrefix.CharLimit = 120\n117: \tjobBranchPrefix.SetValue(proj.JobBranchPrefix)\n118: \tjobBranchPrefix.Width = 60\n119: \n120: \trecentCount := textinput.New()\n121: \trecentCount.Placeholder = strconv.Itoa(config.DefaultRecentActivityCount)\n122: \trecentCount.Prompt = \"\" // we render our own \"Recent activity:\" label\n123: \trecentCount.CharLimit = 3\n124: \t// Seed with the resolved number so the user sees the effective value;\n125: \t// clearing it means \"default\" (see recentActivityCount).\n126: \trecentCount.SetValue(strconv.Itoa(global.RecentActivityCountValue()))\n127: \trecentCount.Width = 60\n128: \n129: \tterminal := textinput.New()\n130: \tterminal.Placeholder = \"blank = auto-detect\"\n131: \tterminal.Prompt = \"\" // we render our own \"Terminal:\" label\n132: \tterminal.CharLimit = 120\n133: \tterminal.SetValue(global.Terminal)\n134: \tterminal.Width = 60\n135: \n136: \ttheme := textinput.New()\n137: \ttheme.Placeholder = \"blank = OpenCode's own default\"\n138: \ttheme.Prompt = \"\" // we render our own \"Theme:\" label\n139: \ttheme.CharLimit = 120\n140: \ttheme.SetValue(global.ThemeValue())\n141: \ttheme.Width = 60\n142: \n143: \tv := &settingsView{\n144: \t\teditor:          editor,\n145: \t\tbaseBranch:      baseBranch,\n146: \t\tjobBranchPrefix: jobBranchPrefix,\n147: \t\trecentCount:     recentCount,\n148: \t\tterminal:        terminal,\n149: \t\ttheme:           theme,\n150: \t\tprofile:         profileIndex(global.ProfileValue()),\n151: \t\tfocus:           stFocusEditor,\n152: \t\twidth:           width,\n153: \t\theight:          height,\n154: \t}\n155: \tif width > 0 {\n156: \t\tw := stInputWidth(width)\n157: \t\tv.editor.Width = w\n158: \t\tv.baseBranch.Width = w\n159: \t\tv.jobBranchPrefix.Width = w\n160: \t\tv.recentCount.Width = w\n161: \t\tv.terminal.Width = w\n162: \t\tv.theme.Width = w\n163: \t}\n164: \treturn v\n165: }\n166: \n167: // stInputWidth returns the usable width for a settings text input, given the\n168: // available form width. All text inputs share the same width rule: the label\n169: // column (settingsLabelWidth) plus the 2-space indent and the 2-space gap\n170: // between label and input.\n171: func stInputWidth(width int) int {\n172: \tw := width - settingsLabelWidth - 4\n173: \tif w < 20 {\n174: \t\tw = 20\n175: \t}\n176: \treturn w\n177: }\n178: \n179: // profileIndex finds id in profileOptions, defaulting to index 0 (claude-pro)\n180: // for an unrecognized value.\n181: func profileIndex(id string) int {\n182: \tfor i, p := range profileOptions {\n183: \t\tif p.ID == id {\n184: \t\t\treturn i\n185: \t\t}\n186: \t}\n187: \treturn 0\n188: }\n189: \n190: // resize updates the viewport (and the text input widths) on terminal resize.\n191: func (v *settingsView) resize(width, height int) {\n192: \tif width == v.width && height == v.height {\n193: \t\treturn\n194: \t}\n195: \tv.width, v.height = width, height\n196: \tif width > 0 {\n197: \t\tw := stInputWidth(width)\n198: \t\tv.editor.Width = w\n199: \t\tv.baseBranch.Width = w\n200: \t\tv.jobBranchPrefix.Width = w\n201: \t\tv.recentCount.Width = w\n202: \t\tv.terminal.Width = w\n203: \t\tv.theme.Width = w\n204: \t}\n205: }\n206: \n207: // update processes a key for the form and reports the resulting action.\n208: func (v *settingsView) update(msg tea.KeyMsg) stAction {\n209: \tswitch msg.String() {\n210: \tcase \"esc\":\n211: \t\treturn stCancel\n212: \tcase \"tab\":\n213: \t\tv.setFocus((v.focus + 1) % stFieldCount)\n214: \t\treturn stNone\n215: \tcase \"shift+tab\":\n216: \t\tv.setFocus((v.focus + stFieldCount - 1) % stFieldCount)\n217: \t\treturn stNone\n218: \tcase \"enter\":\n219: \t\treturn stSubmit\n220: \t}\n221: \n222: \tif v.focus == stFocusProfile {\n223: \t\t// Profile selector: cycle with ←/→.\n224: \t\tswitch msg.String() {\n225: \t\tcase \"left\":\n226: \t\t\tv.profile = (v.profile + len(profileOptions) - 1) % len(profileOptions)\n227: \t\tcase \"right\":\n228: \t\t\tv.profile = (v.profile + 1) % len(profileOptions)\n229: \t\t}\n230: \t\treturn stNone\n231: \t}\n232: \n233: \t// A text input is focused (editor, base branch, job branch prefix, recent\n234: \t// count, terminal or theme): route the key to it.\n235: \tvar ti *textinput.Model\n236: \tswitch v.focus {\n237: \tcase stFocusEditor:\n238: \t\tti = &v.editor\n239: \tcase stFocusBranch:\n240: \t\tti = &v.baseBranch\n241: \tcase stFocusJobPrefix:\n242: \t\tti = &v.jobBranchPrefix\n243: \tcase stFocusCount:\n244: \t\tti = &v.recentCount\n245: \tcase stFocusTerminal:\n246: \t\tti = &v.terminal\n247: \tdefault: // stFocusTheme\n248: \t\tti = &v.theme\n249: \t}\n250: \tm, _ := ti.Update(msg)\n251: \t*ti = m\n252: \treturn stNone\n253: }\n254: \n255: // setFocus moves focus to field i and keeps the text inputs' focus state in\n256: // sync: only the editor, base branch, job branch prefix, recent count,\n257: // terminal or theme holds the text cursor; the profile selector is\n258: // keyboard-driven (←/→), not a text input.\n259: func (v *settingsView) setFocus(i int) {\n260: \tv.focus = i\n261: \tv.editor.Blur()\n262: \tv.baseBranch.Blur()\n263: \tv.jobBranchPrefix.Blur()\n264: \tv.recentCount.Blur()\n265: \tv.terminal.Blur()\n266: \tv.theme.Blur()\n267: \tswitch i {\n268: \tcase stFocusEditor:\n269: \t\tv.editor.Focus()\n270: \tcase stFocusBranch:\n271: \t\tv.baseBranch.Focus()\n272: \tcase stFocusJobPrefix:\n273: \t\tv.jobBranchPrefix.Focus()\n274: \tcase stFocusCount:\n275: \t\tv.recentCount.Focus()\n276: \tcase stFocusTerminal:\n277: \t\tv.terminal.Focus()\n278: \tcase stFocusTheme:\n279: \t\tv.theme.Focus()\n280: \tdefault: // stFocusProfile\n281: \t\t// no text input to focus — the profile selector is keyboard-driven\n282: \t}\n283: }\n284: \n285: // recentActivityCount parses and validates the form's recent-activity count\n286: // field. A trimmed empty input means \"unset → default\"\n287: // (config.DefaultRecentActivityCount). Anything that does not parse as an\n288: // integer in 1–recentActivityCountMax returns an error so the caller can\n289: // surface it and keep the form open without persisting anything.\n290: func (v *settingsView) recentActivityCount() (int, error) {\n291: \traw := strings.TrimSpace(v.recentCount.Value())\n292: \tif raw == \"\" {\n293: \t\treturn config.DefaultRecentActivityCount, nil\n294: \t}\n295: \tn, err := strconv.Atoi(raw)\n296: \tif err != nil || n < 1 || n > recentActivityCountMax {\n297: \t\treturn 0, fmt.Errorf(\"recent activity count must be an integer between 1 and %d (blank = %d)\", recentActivityCountMax, config.DefaultRecentActivityCount)\n298: \t}\n299: \treturn n, nil\n300: }\n301: \n302: // settingsValue returns the form's current global values as config.Settings,\n303: // ready to be persisted with config.Save. The recent-activity count is\n304: // included only when valid — callers must run recentActivityCount() first (as\n305: // updateSettings does) so an invalid value never silently reaches disk as 0.\n306: func (v *settingsView) settingsValue() config.Settings {\n307: \ts := config.Settings{\n308: \t\tEditor:   strings.TrimSpace(v.editor.Value()),\n309: \t\tProfile:  profileOptions[v.profile].ID,\n310: \t\tTerminal: strings.TrimSpace(v.terminal.Value()),\n311: \t\tTheme:    strings.TrimSpace(v.theme.Value()),\n312: \t}\n313: \tif n, err := v.recentActivityCount(); err == nil {\n314: \t\ts.RecentActivityCount = n\n315: \t}\n316: \treturn s\n317: }\n318: \n319: // projectValue returns the form's current project values as project.Settings,\n320: // ready to be persisted with project.Save.\n321: func (v *settingsView) projectValue() project.Settings {\n322: \treturn project.Settings{\n323: \t\tBaseBranch:      strings.TrimSpace(v.baseBranch.Value()),\n324: \t\tJobBranchPrefix: strings.TrimSpace(v.jobBranchPrefix.Value()),\n325: \t}\n326: }\n327: \n328: // settingsField renders one setting's headline row: the bold label and the\n329: // value (a text input view) next to it, the label right-padded to\n330: // settingsLabelWidth so every input starts at the same x. The label stays\n331: // bold whether focused or not — only the value dims when its field is\n332: // unfocused, so a glance at the form still finds each setting by its bold\n333: // headline.\n334: func settingsField(focused bool, label, value string) string {\n335: \tpadded := label + strings.Repeat(\" \", settingsLabelWidth-len(label))\n336: \tif focused {\n337: \t\treturn \"  \" + headerStyle.Render(padded) + \"  \" + value\n338: \t}\n339: \treturn \"  \" + headerStyle.Render(padded) + \"  \" + dimStyle.Render(value)\n340: }\n341: \n342: // render draws the form.\n343: func (v *settingsView) render() string {\n344: \tvar b strings.Builder\n345: \tb.WriteString(titleStyle.Render(\"Settings\"))\n346: \tb.WriteString(\"\\n\\n\")\n347: \n348: \t// Personal settings section (global): editor, recent activity count,\n349: \t// profile, terminal, theme. The section headline carries the storage\n350: \t// location once, so the per-field examples below can stay short.\n351: \tb.WriteString(headerStyle.Render(\"Personal settings\"))\n352: \tb.WriteString(\" — \")\n353: \tb.WriteString(dimStyle.Render(\"saved in config/tui-settings.json + manigot/.env\"))\n354: \tb.WriteString(\"\\n\")\n355: \n356: \t// Editor row (global).\n357: \tb.WriteString(settingsField(v.focus == stFocusEditor, \"Editor\", v.editor.View()))\n358: \tb.WriteString(\"\\n\")\n359: \tb.WriteString(dimStyle.Render(\"  blank = use $VISUAL / $EDITOR / nano / vi\"))\n360: \tb.WriteString(\"\\n\")\n361: \n362: \t// Recent activity count row (global): the maximum number of entries the\n363: \t// dashboard's recent-activity strip may show.\n364: \tb.WriteString(settingsField(v.focus == stFocusCount, \"Recent activity\", v.recentCount.View()))\n365: \tb.WriteString(\"\\n\")\n366: \tb.WriteString(dimStyle.Render(\"  1–100 · blank = 5 · dashboard recent activity strip\"))\n367: \tb.WriteString(\"\\n\\n\")\n368: \n369: \t// Profile row (global): the label has no text input next to it — the\n370: \t// options are listed below, one per line, the selected one highlighted.\n371: \tb.WriteString(\"  \" + headerStyle.Render(\"Profile\"))\n372: \tb.WriteString(\"\\n\")\n373: \tfor i, p := range profileOptions {\n374: \t\tvar mark, id, rest string\n375: \t\tif i == v.profile && v.focus == stFocusProfile {\n376: \t\t\tmark = accentStyle.Render(\"▸ \")\n377: \t\t\tid = accentStyle.Render(p.ID)\n378: \t\t} else if i == v.profile {\n379: \t\t\tmark = lipgloss.NewStyle().Bold(true).Render(\"● \")\n380: \t\t\tid = lipgloss.NewStyle().Bold(true).Render(p.ID)\n381: \t\t} else {\n382: \t\t\tmark = \"  \"\n383: \t\t\tid = dimStyle.Render(p.ID)\n384: \t\t}\n385: \t\trest = \"  \" + dimStyle.Render(p.Label)\n386: \t\tb.WriteString(\"    \" + mark + id + rest)\n387: \t\tb.WriteString(\"\\n\")\n388: \t}\n389: \t// Where the choice is stored and who it is shared with. The model is\n390: \t// deliberately not shown — the opencode profiles' model lives in manigot's\n391: \t// .env (OPENCODE_ZAI_MODEL/OPENCODE_GO_MODEL/OPENCODE_ZEN_MODEL/\n392: \t// OPENCODE_ZEN_FREE_MODEL), which the TUI does not read.\n393: \tb.WriteString(dimStyle.Render(\"    saved as MANIGOT_PROFILE in manigot/.env — shared with the CLI (bare mg / mg profiles)\"))\n394: \tb.WriteString(\"\\n\\n\")\n395: \n396: \t// Terminal row (global): the command used to spawn an agent session's\n397: \t// terminal, replacing launch's auto-detect spawn order when set. Inside\n398: \t// tmux the split pane always wins, regardless of this setting.\n399: \tb.WriteString(settingsField(v.focus == stFocusTerminal, \"Terminal\", v.terminal.View()))\n400: \tb.WriteString(\"\\n\")\n401: \tb.WriteString(dimStyle.Render(\"  blank = auto-detect (tmux / Terminal.app / ...) · in tmux the split pane always wins\"))\n402: \tb.WriteString(\"\\n\")\n403: \n404: \t// Theme row (global): the OpenCode theme name (e.g. \"nord\", \"tokyonight\"),\n405: \t// shared across every OpenCode profile — Claude Code already respects the\n406: \t// host terminal's own theme, so this has no effect there. Not validated\n407: \t// against a fixed list here, matching `mg theme`.\n408: \tb.WriteString(settingsField(v.focus == stFocusTheme, \"Theme\", v.theme.View()))\n409: \tb.WriteString(\"\\n\")\n410: \tb.WriteString(dimStyle.Render(\"  blank = OpenCode's own default · OpenCode only\"))\n411: \tb.WriteString(\"\\n\\n\")\n412: \n413: \t// Project settings section: base branch and job branch prefix — shared\n414: \t// project conventions, committable, in the target project's\n415: \t// .manigot/manigot.json.\n416: \tb.WriteString(headerStyle.Render(\"Project settings\"))\n417: \tb.WriteString(\" — \")\n418: \tb.WriteString(dimStyle.Render(\"stored in .manigot/manigot.json, shared with your team\"))\n419: \tb.WriteString(\"\\n\")\n420: \n421: \t// Base branch row (project).\n422: \tb.WriteString(settingsField(v.focus == stFocusBranch, \"Base branch\", v.baseBranch.View()))\n423: \tb.WriteString(\"\\n\")\n424: \tb.WriteString(dimStyle.Render(\"  blank = main\"))\n425: \tb.WriteString(\"\\n\")\n426: \n427: \t// Job branch prefix row (project): the namespace job branches live under,\n428: \t// e.g. \"jobs\" makes a feature job's branch \"jobs/feature/<id>_<slug>\".\n429: \tb.WriteString(settingsField(v.focus == stFocusJobPrefix, \"Job branch prefix\", v.jobBranchPrefix.View()))\n430: \tb.WriteString(\"\\n\")\n431: \tb.WriteString(dimStyle.Render(\"  blank = feature/… · namespace for job branches\"))\n432: \tb.WriteString(\"\\n\\n\")\n433: \n434: \t// Footer: status or a focus-aware hint.\n435: \tif v.status != \"\" {\n436: \t\tb.WriteString(statusStyle.Render(v.status))\n437: \t} else {\n438: \t\tb.WriteString(dimStyle.Render(v.hint()))\n439: \t}\n440: \treturn b.String()\n441: }\n442: \n443: // hint returns the footer key hint, varied by which field is focused so it\n444: // always names the fields tab moves between rather than a static list.\n445: func (v *settingsView) hint() string {\n446: \tprefix := \"enter save · esc cancel\"\n447: \tswitch v.focus {\n448: \tcase stFocusEditor:\n449: \t\treturn \"tab/shift+tab base branch · \" + prefix\n450: \tcase stFocusBranch:\n451: \t\treturn \"tab/shift+tab job branch prefix · \" + prefix\n452: \tcase stFocusJobPrefix:\n453: \t\treturn \"tab/shift+tab recent activity · \" + prefix\n454: \tcase stFocusCount:\n455: \t\treturn \"tab/shift+tab profile · \" + prefix\n456: \tcase stFocusProfile:\n457: \t\treturn \"←/→ change profile · tab/shift+tab terminal · \" + prefix\n458: \tcase stFocusTerminal:\n459: \t\treturn \"tab/shift+tab theme · \" + prefix\n460: \tdefault: // stFocusTheme\n461: \t\treturn \"tab/shift+tab editor · \" + prefix\n462: \t}\n463: }\n\n(End of file - total 463 lines)\n</content>","metadata":{"preview":"package ui\n\nimport (\n\t\"fmt\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/charmbracelet/bubbles/textinput\"\n\ttea \"github.com/charmbracelet/bubbletea\"\n\t\"github.com/charmbracelet/lipgloss\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// profileOptions mirrors the profiles accepted by scripts/run.sh's --profile\n// flag, in cycle order.\nvar profileOptions = config.Profiles()\n\n// recentActivityCountMax is the upper end of the valid range for the","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/ui/settings.go","text":"package ui\n\nimport (\n\t\"fmt\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/charmbracelet/bubbles/textinput\"\n\ttea \"github.com/charmbracelet/bubbletea\"\n\t\"github.com/charmbracelet/lipgloss\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// profileOptions mirrors the profiles accepted by scripts/run.sh's --profile\n// flag, in cycle order.\nvar profileOptions = config.Profiles()\n\n// recentActivityCountMax is the upper end of the valid range for the\n// recent-activity count setting (the floor is 1). Values outside 1–100 are\n// rejected by the settings form.\nconst recentActivityCountMax = 100\n\n// Number of focusable fields in the settings form: editor, base branch, job\n// branch prefix, recent activity count, profile, terminal, theme — in tab\n// cycle order. Kept as a named constant so the tab/shift+tab cycle and focus\n// comparisons don't all hardcode a literal that has to be kept in sync field\n// by field.\nconst stFieldCount = 7\n\n// settingsLabelWidth is the display width of the settings form's label\n// column — the length of the longest setting headline (\"Job branch prefix\")\n// — so every text input starts at the same x and the form reads as aligned\n// columns rather than a ragged wall of label+input pairs.\nconst settingsLabelWidth = 17\n\n// Focus indices for the settings form's fields, in tab cycle order: editor →\n// base branch → job branch prefix → recent activity count → profile →\n// terminal → theme → editor. Used by update() and render() instead of bare\n// ints. Terminal was appended after Profile, and Theme after Terminal, rather\n// than inserted next to Editor, so the existing constants keep their values\n// unchanged.\nconst (\n\tstFocusEditor    = 0\n\tstFocusBranch    = 1\n\tstFocusJobPrefix = 2\n\tstFocusCount     = 3\n\tstFocusProfile   = 4\n\tstFocusTerminal  = 5\n\tstFocusTheme     = 6\n)\n\n// stAction is what update returns for the App to act on.\ntype stAction int\n\nconst (\n\tstNone   stAction = iota\n\tstCancel          // esc — discard and return to the list\n\tstSubmit          // enter — persist the settings\n)\n\n// settingsView is the \"Settings\" form, laid out as two bold-headed sections\n// that mirror the storage split the form edits:\n//\n//   - Personal settings — the editor preference, the recent-activity count,\n//     the subscription profile, the terminal and the theme: global, personal\n//     preferences stored in config/tui-settings.json (editor, recent activity,\n//     terminal) and manigot/.env (the profile as MANIGOT_PROFILE — the one\n//     default shared between CLI and TUI: bare `mg` resolves to it, `mg\n//     profiles` writes it, and this form reads/writes the same key — and the\n//     theme as OPENCODE_THEME), both gitignored, in the manigot checkout;\n//   - Project settings — the base branch and job branch prefix: shared\n//     project conventions, committable, in the target project's\n//     .manigot/manigot.json.\n//\n// Like newJobView, it does not persist anything itself — the App calls\n// config.Save and project.Save on submit so this stays a pure input\n// component.\ntype settingsView struct {\n\teditor          textinput.Model\n\tbaseBranch      textinput.Model\n\tjobBranchPrefix textinput.Model\n\trecentCount     textinput.Model\n\tterminal        textinput.Model\n\ttheme           textinput.Model\n\tprofile         int // index into profileOptions\n\tfocus           int // stFocusEditor / stFocusBranch / stFocusJobPrefix / stFocusCount / stFocusProfile / stFocusTerminal / stFocusTheme\n\twidth           int\n\theight          int\n\tstatus          string // validation/save error message\n}\n\n// newSettingsView builds the form seeded from the current global config and\n// project settings. The editor field is focused first, matching the form's\n// pre-base-branch behaviour.\nfunc newSettingsView(global config.Settings, proj project.Settings, width, height int) *settingsView {\n\teditor := textinput.New()\n\teditor.Placeholder = \"$VISUAL / $EDITOR / nano\"\n\teditor.Prompt = \"\" // we render our own \"Editor:\" label\n\teditor.CharLimit = 120\n\teditor.SetValue(global.Editor)\n\teditor.Focus()\n\teditor.Width = 60\n\n\tbaseBranch := textinput.New()\n\tbaseBranch.Placeholder = \"main\"\n\tbaseBranch.Prompt = \"\" // we render our own \"Base branch:\" label\n\tbaseBranch.CharLimit = 120\n\tbaseBranch.SetValue(proj.BaseBranch)\n\tbaseBranch.Width = 60\n\n\tjobBranchPrefix := textinput.New()\n\tjobBranchPrefix.Placeholder = \"jobs\"\n\tjobBranchPrefix.Prompt = \"\" // we render our own \"Job branch prefix:\" label\n\tjobBranchPrefix.CharLimit = 120\n\tjobBranchPrefix.SetValue(proj.JobBranchPrefix)\n\tjobBranchPrefix.Width = 60\n\n\trecentCount := textinput.New()\n\trecentCount.Placeholder = strconv.Itoa(config.DefaultRecentActivityCount)\n\trecentCount.Prompt = \"\" // we render our own \"Recent activity:\" label\n\trecentCount.CharLimit = 3\n\t// Seed with the resolved number so the user sees the effective value;\n\t// clearing it means \"default\" (see recentActivityCount).\n\trecentCount.SetValue(strconv.Itoa(global.RecentActivityCountValue()))\n\trecentCount.Width = 60\n\n\tterminal := textinput.New()\n\tterminal.Placeholder = \"blank = auto-detect\"\n\tterminal.Prompt = \"\" // we render our own \"Terminal:\" label\n\tterminal.CharLimit = 120\n\tterminal.SetValue(global.Terminal)\n\tterminal.Width = 60\n\n\ttheme := textinput.New()\n\ttheme.Placeholder = \"blank = OpenCode's own default\"\n\ttheme.Prompt = \"\" // we render our own \"Theme:\" label\n\ttheme.CharLimit = 120\n\ttheme.SetValue(global.ThemeValue())\n\ttheme.Width = 60\n\n\tv := &settingsView{\n\t\teditor:          editor,\n\t\tbaseBranch:      baseBranch,\n\t\tjobBranchPrefix: jobBranchPrefix,\n\t\trecentCount:     recentCount,\n\t\tterminal:        terminal,\n\t\ttheme:           theme,\n\t\tprofile:         profileIndex(global.ProfileValue()),\n\t\tfocus:           stFocusEditor,\n\t\twidth:           width,\n\t\theight:          height,\n\t}\n\tif width > 0 {\n\t\tw := stInputWidth(width)\n\t\tv.editor.Width = w\n\t\tv.baseBranch.Width = w\n\t\tv.jobBranchPrefix.Width = w\n\t\tv.recentCount.Width = w\n\t\tv.terminal.Width = w\n\t\tv.theme.Width = w\n\t}\n\treturn v\n}\n\n// stInputWidth returns the usable width for a settings text input, given the\n// available form width. All text inputs share the same width rule: the label\n// column (settingsLabelWidth) plus the 2-space indent and the 2-space gap\n// between label and input.\nfunc stInputWidth(width int) int {\n\tw := width - settingsLabelWidth - 4\n\tif w < 20 {\n\t\tw = 20\n\t}\n\treturn w\n}\n\n// profileIndex finds id in profileOptions, defaulting to index 0 (claude-pro)\n// for an unrecognized value.\nfunc profileIndex(id string) int {\n\tfor i, p := range profileOptions {\n\t\tif p.ID == id {\n\t\t\treturn i\n\t\t}\n\t}\n\treturn 0\n}\n\n// resize updates the viewport (and the text input widths) on terminal resize.\nfunc (v *settingsView) resize(width, height int) {\n\tif width == v.width && height == v.height {\n\t\treturn\n\t}\n\tv.width, v.height = width, height\n\tif width > 0 {\n\t\tw := stInputWidth(width)\n\t\tv.editor.Width = w\n\t\tv.baseBranch.Width = w\n\t\tv.jobBranchPrefix.Width = w\n\t\tv.recentCount.Width = w\n\t\tv.terminal.Width = w\n\t\tv.theme.Width = w\n\t}\n}\n\n// update processes a key for the form and reports the resulting action.\nfunc (v *settingsView) update(msg tea.KeyMsg) stAction {\n\tswitch msg.String() {\n\tcase \"esc\":\n\t\treturn stCancel\n\tcase \"tab\":\n\t\tv.setFocus((v.focus + 1) % stFieldCount)\n\t\treturn stNone\n\tcase \"shift+tab\":\n\t\tv.setFocus((v.focus + stFieldCount - 1) % stFieldCount)\n\t\treturn stNone\n\tcase \"enter\":\n\t\treturn stSubmit\n\t}\n\n\tif v.focus == stFocusProfile {\n\t\t// Profile selector: cycle with ←/→.\n\t\tswitch msg.String() {\n\t\tcase \"left\":\n\t\t\tv.profile = (v.profile + len(profileOptions) - 1) % len(profileOptions)\n\t\tcase \"right\":\n\t\t\tv.profile = (v.profile + 1) % len(profileOptions)\n\t\t}\n\t\treturn stNone\n\t}\n\n\t// A text input is focused (editor, base branch, job branch prefix, recent\n\t// count, terminal or theme): route the key to it.\n\tvar ti *textinput.Model\n\tswitch v.focus {\n\tcase stFocusEditor:\n\t\tti = &v.editor\n\tcase stFocusBranch:\n\t\tti = &v.baseBranch\n\tcase stFocusJobPrefix:\n\t\tti = &v.jobBranchPrefix\n\tcase stFocusCount:\n\t\tti = &v.recentCount\n\tcase stFocusTerminal:\n\t\tti = &v.terminal\n\tdefault: // stFocusTheme\n\t\tti = &v.theme\n\t}\n\tm, _ := ti.Update(msg)\n\t*ti = m\n\treturn stNone\n}\n\n// setFocus moves focus to field i and keeps the text inputs' focus state in\n// sync: only the editor, base branch, job branch prefix, recent count,\n// terminal or theme holds the text cursor; the profile selector is\n// keyboard-driven (←/→), not a text input.\nfunc (v *settingsView) setFocus(i int) {\n\tv.focus = i\n\tv.editor.Blur()\n\tv.baseBranch.Blur()\n\tv.jobBranchPrefix.Blur()\n\tv.recentCount.Blur()\n\tv.terminal.Blur()\n\tv.theme.Blur()\n\tswitch i {\n\tcase stFocusEditor:\n\t\tv.editor.Focus()\n\tcase stFocusBranch:\n\t\tv.baseBranch.Focus()\n\tcase stFocusJobPrefix:\n\t\tv.jobBranchPrefix.Focus()\n\tcase stFocusCount:\n\t\tv.recentCount.Focus()\n\tcase stFocusTerminal:\n\t\tv.terminal.Focus()\n\tcase stFocusTheme:\n\t\tv.theme.Focus()\n\tdefault: // stFocusProfile\n\t\t// no text input to focus — the profile selector is keyboard-driven\n\t}\n}\n\n// recentActivityCount parses and validates the form's recent-activity count\n// field. A trimmed empty input means \"unset → default\"\n// (config.DefaultRecentActivityCount). Anything that does not parse as an\n// integer in 1–recentActivityCountMax returns an error so the caller can\n// surface it and keep the form open without persisting anything.\nfunc (v *settingsView) recentActivityCount() (int, error) {\n\traw := strings.TrimSpace(v.recentCount.Value())\n\tif raw == \"\" {\n\t\treturn config.DefaultRecentActivityCount, nil\n\t}\n\tn, err := strconv.Atoi(raw)\n\tif err != nil || n < 1 || n > recentActivityCountMax {\n\t\treturn 0, fmt.Errorf(\"recent activity count must be an integer between 1 and %d (blank = %d)\", recentActivityCountMax, config.DefaultRecentActivityCount)\n\t}\n\treturn n, nil\n}\n\n// settingsValue returns the form's current global values as config.Settings,\n// ready to be persisted with config.Save. The recent-activity count is\n// included only when valid — callers must run recentActivityCount() first (as\n// updateSettings does) so an invalid value never silently reaches disk as 0.\nfunc (v *settingsView) settingsValue() config.Settings {\n\ts := config.Settings{\n\t\tEditor:   strings.TrimSpace(v.editor.Value()),\n\t\tProfile:  profileOptions[v.profile].ID,\n\t\tTerminal: strings.TrimSpace(v.terminal.Value()),\n\t\tTheme:    strings.TrimSpace(v.theme.Value()),\n\t}\n\tif n, err := v.recentActivityCount(); err == nil {\n\t\ts.RecentActivityCount = n\n\t}\n\treturn s\n}\n\n// projectValue returns the form's current project values as project.Settings,\n// ready to be persisted with project.Save.\nfunc (v *settingsView) projectValue() project.Settings {\n\treturn project.Settings{\n\t\tBaseBranch:      strings.TrimSpace(v.baseBranch.Value()),\n\t\tJobBranchPrefix: strings.TrimSpace(v.jobBranchPrefix.Value()),\n\t}\n}\n\n// settingsField renders one setting's headline row: the bold label and the\n// value (a text input view) next to it, the label right-padded to\n// settingsLabelWidth so every input starts at the same x. The label stays\n// bold whether focused or not — only the value dims when its field is\n// unfocused, so a glance at the form still finds each setting by its bold\n// headline.\nfunc settingsField(focused bool, label, value string) string {\n\tpadded := label + strings.Repeat(\" \", settingsLabelWidth-len(label))\n\tif focused {\n\t\treturn \"  \" + headerStyle.Render(padded) + \"  \" + value\n\t}\n\treturn \"  \" + headerStyle.Render(padded) + \"  \" + dimStyle.Render(value)\n}\n\n// render draws the form.\nfunc (v *settingsView) render() string {\n\tvar b strings.Builder\n\tb.WriteString(titleStyle.Render(\"Settings\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Personal settings section (global): editor, recent activity count,\n\t// profile, terminal, theme. The section headline carries the storage\n\t// location once, so the per-field examples below can stay short.\n\tb.WriteString(headerStyle.Render(\"Personal settings\"))\n\tb.WriteString(\" — \")\n\tb.WriteString(dimStyle.Render(\"saved in config/tui-settings.json + manigot/.env\"))\n\tb.WriteString(\"\\n\")\n\n\t// Editor row (global).\n\tb.WriteString(settingsField(v.focus == stFocusEditor, \"Editor\", v.editor.View()))\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"  blank = use $VISUAL / $EDITOR / nano / vi\"))\n\tb.WriteString(\"\\n\")\n\n\t// Recent activity count row (global): the maximum number of entries the\n\t// dashboard's recent-activity strip may show.\n\tb.WriteString(settingsField(v.focus == stFocusCount, \"Recent activity\", v.recentCount.View()))\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"  1–100 · blank = 5 · dashboard recent activity strip\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Profile row (global): the label has no text input next to it — the\n\t// options are listed below, one per line, the selected one highlighted.\n\tb.WriteString(\"  \" + headerStyle.Render(\"Profile\"))\n\tb.WriteString(\"\\n\")\n\tfor i, p := range profileOptions {\n\t\tvar mark, id, rest string\n\t\tif i == v.profile && v.focus == stFocusProfile {\n\t\t\tmark = accentStyle.Render(\"▸ \")\n\t\t\tid = accentStyle.Render(p.ID)\n\t\t} else if i == v.profile {\n\t\t\tmark = lipgloss.NewStyle().Bold(true).Render(\"● \")\n\t\t\tid = lipgloss.NewStyle().Bold(true).Render(p.ID)\n\t\t} else {\n\t\t\tmark = \"  \"\n\t\t\tid = dimStyle.Render(p.ID)\n\t\t}\n\t\trest = \"  \" + dimStyle.Render(p.Label)\n\t\tb.WriteString(\"    \" + mark + id + rest)\n\t\tb.WriteString(\"\\n\")\n\t}\n\t// Where the choice is stored and who it is shared with. The model is\n\t// deliberately not shown — the opencode profiles' model lives in manigot's\n\t// .env (OPENCODE_ZAI_MODEL/OPENCODE_GO_MODEL/OPENCODE_ZEN_MODEL/\n\t// OPENCODE_ZEN_FREE_MODEL), which the TUI does not read.\n\tb.WriteString(dimStyle.Render(\"    saved as MANIGOT_PROFILE in manigot/.env — shared with the CLI (bare mg / mg profiles)\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Terminal row (global): the command used to spawn an agent session's\n\t// terminal, replacing launch's auto-detect spawn order when set. Inside\n\t// tmux the split pane always wins, regardless of this setting.\n\tb.WriteString(settingsField(v.focus == stFocusTerminal, \"Terminal\", v.terminal.View()))\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"  blank = auto-detect (tmux / Terminal.app / ...) · in tmux the split pane always wins\"))\n\tb.WriteString(\"\\n\")\n\n\t// Theme row (global): the OpenCode theme name (e.g. \"nord\", \"tokyonight\"),\n\t// shared across every OpenCode profile — Claude Code already respects the\n\t// host terminal's own theme, so this has no effect there. Not validated\n\t// against a fixed list here, matching `mg theme`.\n\tb.WriteString(settingsField(v.focus == stFocusTheme, \"Theme\", v.theme.View()))\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"  blank = OpenCode's own default · OpenCode only\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Project settings section: base branch and job branch prefix — shared\n\t// project conventions, committable, in the target project's\n\t// .manigot/manigot.json.\n\tb.WriteString(headerStyle.Render(\"Project settings\"))\n\tb.WriteString(\" — \")\n\tb.WriteString(dimStyle.Render(\"stored in .manigot/manigot.json, shared with your team\"))\n\tb.WriteString(\"\\n\")\n\n\t// Base branch row (project).\n\tb.WriteString(settingsField(v.focus == stFocusBranch, \"Base branch\", v.baseBranch.View()))\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"  blank = main\"))\n\tb.WriteString(\"\\n\")\n\n\t// Job branch prefix row (project): the namespace job branches live under,\n\t// e.g. \"jobs\" makes a feature job's branch \"jobs/feature/<id>_<slug>\".\n\tb.WriteString(settingsField(v.focus == stFocusJobPrefix, \"Job branch prefix\", v.jobBranchPrefix.View()))\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"  blank = feature/… · namespace for job branches\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Footer: status or a focus-aware hint.\n\tif v.status != \"\" {\n\t\tb.WriteString(statusStyle.Render(v.status))\n\t} else {\n\t\tb.WriteString(dimStyle.Render(v.hint()))\n\t}\n\treturn b.String()\n}\n\n// hint returns the footer key hint, varied by which field is focused so it\n// always names the fields tab moves between rather than a static list.\nfunc (v *settingsView) hint() string {\n\tprefix := \"enter save · esc cancel\"\n\tswitch v.focus {\n\tcase stFocusEditor:\n\t\treturn \"tab/shift+tab base branch · \" + prefix\n\tcase stFocusBranch:\n\t\treturn \"tab/shift+tab job branch prefix · \" + prefix\n\tcase stFocusJobPrefix:\n\t\treturn \"tab/shift+tab recent activity · \" + prefix\n\tcase stFocusCount:\n\t\treturn \"tab/shift+tab profile · \" + prefix\n\tcase stFocusProfile:\n\t\treturn \"←/→ change profile · tab/shift+tab terminal · \" + prefix\n\tcase stFocusTerminal:\n\t\treturn \"tab/shift+tab theme · \" + prefix\n\tdefault: // stFocusTheme\n\t\treturn \"tab/shift+tab editor · \" + prefix\n\t}\n}","lineStart":1,"lineEnd":463,"totalLines":463,"truncated":false}},"title":"src/internal/ui/settings.go","time":{"start":1787920728339,"end":1787920728344}},"id":"prt_0486140ab001pmMdWKc4rvriII","sessionID":"ses_fb79f1c04ffeYG6ohZOnXBocr5","messageID":"msg_04861389f001Lpa6qlR4iiYWCN"}}
