ng(dimStyle.Render(\"  blank = use $VISUAL / $EDITOR / nano / vi\"))\n360: \tb.WriteString(\"\\n\")\n361: \n362: \t// Recent activity count row (global): the maximum number of entries the\n363: \t// dashboard's recent-activity strip may show.\n364: \tb.WriteString(settingsField(v.focus == stFocusCount, \"Recent activity\", v.recentCount.View()))\n365: \tb.WriteString(\"\\n\")\n366: \tb.WriteString(dimStyle.Render(\"  1–100 · blank = 5 · dashboard recent activity strip\"))\n367: \tb.WriteString(\"\\n\\n\")\n368: \n369: \t// Profile row (global): the label has no text input next to it — the\n370: \t// options are listed below, one per line, the selected one highlighted.\n371: \tb.WriteString(\"  \" + headerStyle.Render(\"Profile\"))\n372: \tb.WriteString(\"\\n\")\n373: \tfor i, p := range profileOptions {\n374: \t\tvar mark, id, rest string\n375: \t\tif i == v.profile && v.focus == stFocusProfile {\n376: \t\t\tmark = accentStyle.Render(\"▸ \")\n377: \t\t\tid = accentStyle.Render(p.ID)\n378: \t\t} else if i == v.profile {\n379: \t\t\tmark = lipgloss.NewStyle().Bold(true).Render(\"● \")\n380: \t\t\tid = lipgloss.NewStyle().Bold(true).Render(p.ID)\n381: \t\t} else {\n382: \t\t\tmark = \"  \"\n383: \t\t\tid = dimStyle.Render(p.ID)\n384: \t\t}\n385: \t\trest = \"  \" + dimStyle.Render(p.Label)\n386: \t\tb.WriteString(\"    \" + mark + id + rest)\n387: \t\tb.WriteString(\"\\n\")\n388: \t}\n389: \t// Where the choice is stored and who it is shared with. The model is\n390: \t// deliberately not shown — the opencode profiles' model lives in manigot's\n391: \t// .env (OPENCODE_ZAI_MODEL/OPENCODE_GO_MODEL/OPENCODE_ZEN_MODEL/\n392: \t// OPENCODE_ZEN_FREE_MODEL), which the TUI does not read.\n393: \tb.WriteString(dimStyle.Render(\"    saved as MANIGOT_PROFILE in manigot/.env — shared with the CLI (bare mg / mg profiles)\"))\n394: \tb.WriteString(\"\\n\\n\")\n395: \n396: \t// Terminal row (global): the command used to spawn an agent session's\n397: \t// terminal, replacing launch's