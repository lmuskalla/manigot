{"type":"tool_use","timestamp":1787919305290,"sessionID":"ses_fb7b4a8d5ffeJWKjfWHud2qnLO","part":{"type":"tool","tool":"read","callID":"call_0164e7f094fd4aefb6cd20c5","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/ui/settings.go"},"output":"<path>/workspace/src/internal/ui/settings.go</path>\n<type>file</type>\n<content>\n1: package ui\n2: \n3: import (\n4: \t\"fmt\"\n5: \t\"strconv\"\n6: \t\"strings\"\n7: \n8: \t\"github.com/charmbracelet/bubbles/textinput\"\n9: \ttea \"github.com/charmbracelet/bubbletea\"\n10: \t\"github.com/charmbracelet/lipgloss\"\n11: \n12: \t\"github.com/lmuskalla/manigot/internal/config\"\n13: \t\"github.com/lmuskalla/manigot/internal/project\"\n14: )\n15: \n16: // profileOptions mirrors the profiles accepted by scripts/run.sh's --profile\n17: // flag, in cycle order.\n18: var profileOptions = config.Profiles()\n19: \n20: // recentActivityCountMax is the upper end of the valid range for the\n21: // recent-activity count setting (the floor is 1). Values outside 1–100 are\n22: // rejected by the settings form.\n23: const recentActivityCountMax = 100\n24: \n25: // Number of focusable fields in the settings form: editor, base branch, job\n26: // branch prefix, recent activity count, profile, terminal, theme — in tab\n27: // cycle order. Kept as a named constant so the tab/shift+tab cycle and focus\n28: // comparisons don't all hardcode a literal that has to be kept in sync field\n29: // by field.\n30: const stFieldCount = 7\n31: \n32: // Focus indices for the settings form's fields, in tab cycle order: editor →\n33: // base branch → job branch prefix → recent activity count → profile →\n34: // terminal → theme → editor. Used by update() and render() instead of bare\n35: // ints. Terminal was appended after Profile, and Theme after Terminal, rather\n36: // than inserted next to Editor, so the existing constants keep their values\n37: // unchanged.\n38: const (\n39: \tstFocusEditor    = 0\n40: \tstFocusBranch    = 1\n41: \tstFocusJobPrefix = 2\n42: \tstFocusCount     = 3\n43: \tstFocusProfile   = 4\n44: \tstFocusTerminal  = 5\n45: \tstFocusTheme     = 6\n46: )\n47: \n48: // stAction is what update returns for the App to act on.\n49: type stAction int\n50: \n51: const (\n52: \tstNone   stAction = iota\n53: \tstCancel          // esc — discard and return to the list\n54: \tstSubmit          // enter — persist the settings\n55: )\n56: \n57: // settingsView is the \"Settings\" form. It edits three files at once:\n58: //\n59: //   - config/tui-settings.json — the editor preference and the recent-activity\n60: //     count (personal, gitignored, in the manigot checkout);\n61: //   - manigot/.env — the subscription profile, as MANIGOT_PROFILE: the one\n62: //     default shared between CLI and TUI (bare `mg` resolves to it, `mg\n63: //     profiles` writes it, and this form reads/writes the same key); and\n64: //   - the project.Settings (base branch, job branch prefix) — shared project\n65: //     conventions, committable, in the target project's .manigot/manigot.json.\n66: //\n67: // Like newJobView, it does not persist anything itself — the App calls\n68: // config.Save and project.Save on submit so this stays a pure input\n69: // component.\n70: type settingsView struct {\n71: \teditor          textinput.Model\n72: \tbaseBranch      textinput.Model\n73: \tjobBranchPrefix textinput.Model\n74: \trecentCount     textinput.Model\n75: \tterminal        textinput.Model\n76: \ttheme           textinput.Model\n77: \tprofile         int // index into profileOptions\n78: \tfocus           int // stFocusEditor / stFocusBranch / stFocusJobPrefix / stFocusCount / stFocusProfile / stFocusTerminal / stFocusTheme\n79: \twidth           int\n80: \theight          int\n81: \tstatus          string // validation/save error message\n82: }\n83: \n84: // newSettingsView builds the form seeded from the current global config and\n85: // project settings. The editor field is focused first, matching the form's\n86: // pre-base-branch behaviour.\n87: func newSettingsView(global config.Settings, proj project.Settings, width, height int) *settingsView {\n88: \teditor := textinput.New()\n89: \teditor.Placeholder = \"$VISUAL / $EDITOR / nano\"\n90: \teditor.Prompt = \"\" // we render our own \"Editor:\" label\n91: \teditor.CharLimit = 120\n92: \teditor.SetValue(global.Editor)\n93: \teditor.Focus()\n94: \teditor.Width = 60\n95: \n96: \tbaseBranch := textinput.New()\n97: \tbaseBranch.Placeholder = \"main\"\n98: \tbaseBranch.Prompt = \"\" // we render our own \"Base branch:\" label\n99: \tbaseBranch.CharLimit = 120\n100: \tbaseBranch.SetValue(proj.BaseBranch)\n101: \tbaseBranch.Width = 60\n102: \n103: \tjobBranchPrefix := textinput.New()\n104: \tjobBranchPrefix.Placeholder = \"jobs\"\n105: \tjobBranchPrefix.Prompt = \"\" // we render our own \"Job branch prefix:\" label\n106: \tjobBranchPrefix.CharLimit = 120\n107: \tjobBranchPrefix.SetValue(proj.JobBranchPrefix)\n108: \tjobBranchPrefix.Width = 60\n109: \n110: \trecentCount := textinput.New()\n111: \trecentCount.Placeholder = strconv.Itoa(config.DefaultRecentActivityCount)\n112: \trecentCount.Prompt = \"\" // we render our own \"Recent activity:\" label\n113: \trecentCount.CharLimit = 3\n114: \t// Seed with the resolved number so the user sees the effective value;\n115: \t// clearing it means \"default\" (see recentActivityCount).\n116: \trecentCount.SetValue(strconv.Itoa(global.RecentActivityCountValue()))\n117: \trecentCount.Width = 60\n118: \n119: \tterminal := textinput.New()\n120: \tterminal.Placeholder = \"blank = auto-detect\"\n121: \tterminal.Prompt = \"\" // we render our own \"Terminal:\" label\n122: \tterminal.CharLimit = 120\n123: \tterminal.SetValue(global.Terminal)\n124: \tterminal.Width = 60\n125: \n126: \ttheme := textinput.New()\n127: \ttheme.Placeholder = \"blank = OpenCode's own default\"\n128: \ttheme.Prompt = \"\" // we render our own \"Theme:\" label\n129: \ttheme.CharLimit = 120\n130: \ttheme.SetValue(global.ThemeValue())\n131: \ttheme.Width = 60\n132: \n133: \tv := &settingsView{\n134: \t\teditor:          editor,\n135: \t\tbaseBranch:      baseBranch,\n136: \t\tjobBranchPrefix: jobBranchPrefix,\n137: \t\trecentCount:     recentCount,\n138: \t\tterminal:        terminal,\n139: \t\ttheme:           theme,\n140: \t\tprofile:         profileIndex(global.ProfileValue()),\n141: \t\tfocus:           stFocusEditor,\n142: \t\twidth:           width,\n143: \t\theight:          height,\n144: \t}\n145: \tif width > 0 {\n146: \t\tw := stInputWidth(width)\n147: \t\tv.editor.Width = w\n148: \t\tv.baseBranch.Width = w\n149: \t\tv.jobBranchPrefix.Width = w\n150: \t\tv.recentCount.Width = w\n151: \t\tv.terminal.Width = w\n152: \t\tv.theme.Width = w\n153: \t}\n154: \treturn v\n155: }\n156: \n157: // stInputWidth returns the usable width for a settings text input, given the\n158: // available form width. All text inputs share the same width rule.\n159: func stInputWidth(width int) int {\n160: \tw := width - 12\n161: \tif w < 20 {\n162: \t\tw = 20\n163: \t}\n164: \treturn w\n165: }\n166: \n167: // profileIndex finds id in profileOptions, defaulting to index 0 (claude-pro)\n168: // for an unrecognized value.\n169: func profileIndex(id string) int {\n170: \tfor i, p := range profileOptions {\n171: \t\tif p.ID == id {\n172: \t\t\treturn i\n173: \t\t}\n174: \t}\n175: \treturn 0\n176: }\n177: \n178: // resize updates the viewport (and the text input widths) on terminal resize.\n179: func (v *settingsView) resize(width, height int) {\n180: \tif width == v.width && height == v.height {\n181: \t\treturn\n182: \t}\n183: \tv.width, v.height = width, height\n184: \tif width > 0 {\n185: \t\tw := stInputWidth(width)\n186: \t\tv.editor.Width = w\n187: \t\tv.baseBranch.Width = w\n188: \t\tv.jobBranchPrefix.Width = w\n189: \t\tv.recentCount.Width = w\n190: \t\tv.terminal.Width = w\n191: \t\tv.theme.Width = w\n192: \t}\n193: }\n194: \n195: // update processes a key for the form and reports the resulting action.\n196: func (v *settingsView) update(msg tea.KeyMsg) stAction {\n197: \tswitch msg.String() {\n198: \tcase \"esc\":\n199: \t\treturn stCancel\n200: \tcase \"tab\":\n201: \t\tv.setFocus((v.focus + 1) % stFieldCount)\n202: \t\treturn stNone\n203: \tcase \"shift+tab\":\n204: \t\tv.setFocus((v.focus + stFieldCount - 1) % stFieldCount)\n205: \t\treturn stNone\n206: \tcase \"enter\":\n207: \t\treturn stSubmit\n208: \t}\n209: \n210: \tif v.focus == stFocusProfile {\n211: \t\t// Profile selector: cycle with ←/→.\n212: \t\tswitch msg.String() {\n213: \t\tcase \"left\":\n214: \t\t\tv.profile = (v.profile + len(profileOptions) - 1) % len(profileOptions)\n215: \t\tcase \"right\":\n216: \t\t\tv.profile = (v.profile + 1) % len(profileOptions)\n217: \t\t}\n218: \t\treturn stNone\n219: \t}\n220: \n221: \t// A text input is focused (editor, base branch, job branch prefix, recent\n222: \t// count, terminal or theme): route the key to it.\n223: \tvar ti *textinput.Model\n224: \tswitch v.focus {\n225: \tcase stFocusEditor:\n226: \t\tti = &v.editor\n227: \tcase stFocusBranch:\n228: \t\tti = &v.baseBranch\n229: \tcase stFocusJobPrefix:\n230: \t\tti = &v.jobBranchPrefix\n231: \tcase stFocusCount:\n232: \t\tti = &v.recentCount\n233: \tcase stFocusTerminal:\n234: \t\tti = &v.terminal\n235: \tdefault: // stFocusTheme\n236: \t\tti = &v.theme\n237: \t}\n238: \tm, _ := ti.Update(msg)\n239: \t*ti = m\n240: \treturn stNone\n241: }\n242: \n243: // setFocus moves focus to field i and keeps the text inputs' focus state in\n244: // sync: only the editor, base branch, job branch prefix, recent count,\n245: // terminal or theme holds the text cursor; the profile selector is\n246: // keyboard-driven (←/→), not a text input.\n247: func (v *settingsView) setFocus(i int) {\n248: \tv.focus = i\n249: \tv.editor.Blur()\n250: \tv.baseBranch.Blur()\n251: \tv.jobBranchPrefix.Blur()\n252: \tv.recentCount.Blur()\n253: \tv.terminal.Blur()\n254: \tv.theme.Blur()\n255: \tswitch i {\n256: \tcase stFocusEditor:\n257: \t\tv.editor.Focus()\n258: \tcase stFocusBranch:\n259: \t\tv.baseBranch.Focus()\n260: \tcase stFocusJobPrefix:\n261: \t\tv.jobBranchPrefix.Focus()\n262: \tcase stFocusCount:\n263: \t\tv.recentCount.Focus()\n264: \tcase stFocusTerminal:\n265: \t\tv.terminal.Focus()\n266: \tcase stFocusTheme:\n267: \t\tv.theme.Focus()\n268: \tdefault: // stFocusProfile\n269: \t\t// no text input to focus — the profile selector is keyboard-driven\n270: \t}\n271: }\n272: \n273: // recentActivityCount parses and validates the form's recent-activity count\n274: // field. A trimmed empty input means \"unset → default\"\n275: // (config.DefaultRecentActivityCount). Anything that does not parse as an\n276: // integer in 1–recentActivityCountMax returns an error so the caller can\n277: // surface it and keep the form open without persisting anything.\n278: func (v *settingsView) recentActivityCount() (int, error) {\n279: \traw := strings.TrimSpace(v.recentCount.Value())\n280: \tif raw == \"\" {\n281: \t\treturn config.DefaultRecentActivityCount, nil\n282: \t}\n283: \tn, err := strconv.Atoi(raw)\n284: \tif err != nil || n < 1 || n > recentActivityCountMax {\n285: \t\treturn 0, fmt.Errorf(\"recent activity count must be an integer between 1 and %d (blank = %d)\", recentActivityCountMax, config.DefaultRecentActivityCount)\n286: \t}\n287: \treturn n, nil\n288: }\n289: \n290: // settingsValue returns the form's current global values as config.Settings,\n291: // ready to be persisted with config.Save. The recent-activity count is\n292: // included only when valid — callers must run recentActivityCount() first (as\n293: // updateSettings does) so an invalid value never silently reaches disk as 0.\n294: func (v *settingsView) settingsValue() config.Settings {\n295: \ts := config.Settings{\n296: \t\tEditor:   strings.TrimSpace(v.editor.Value()),\n297: \t\tProfile:  profileOptions[v.profile].ID,\n298: \t\tTerminal: strings.TrimSpace(v.terminal.Value()),\n299: \t\tTheme:    strings.TrimSpace(v.theme.Value()),\n300: \t}\n301: \tif n, err := v.recentActivityCount(); err == nil {\n302: \t\ts.RecentActivityCount = n\n303: \t}\n304: \treturn s\n305: }\n306: \n307: // projectValue returns the form's current project values as project.Settings,\n308: // ready to be persisted with project.Save.\n309: func (v *settingsView) projectValue() project.Settings {\n310: \treturn project.Settings{\n311: \t\tBaseBranch:      strings.TrimSpace(v.baseBranch.Value()),\n312: \t\tJobBranchPrefix: strings.TrimSpace(v.jobBranchPrefix.Value()),\n313: \t}\n314: }\n315: \n316: // render draws the form.\n317: func (v *settingsView) render() string {\n318: \tvar b strings.Builder\n319: \tb.WriteString(titleStyle.Render(\"Settings\"))\n320: \tb.WriteString(\"\\n\\n\")\n321: \n322: \t// Editor row (global).\n323: \teditorLabel := \"  Editor: \"\n324: \tif v.focus == stFocusEditor {\n325: \t\tb.WriteString(editorLabel + v.editor.View())\n326: \t} else {\n327: \t\tb.WriteString(dimStyle.Render(editorLabel) + dimStyle.Render(v.editor.View()))\n328: \t}\n329: \tb.WriteString(\"\\n\")\n330: \tb.WriteString(dimStyle.Render(\"           blank = use $VISUAL / $EDITOR / nano / vi\"))\n331: \tb.WriteString(\"\\n\\n\")\n332: \n333: \t// Base branch row (project). Labeled project-scoped so it's clear this\n334: \t// writes a different file (.manigot/manigot.json, committable) than the\n335: \t// editor/profile rows above and below it.\n336: \tbranchLabel := \"  Base branch (project): \"\n337: \tif v.focus == stFocusBranch {\n338: \t\tb.WriteString(branchLabel + v.baseBranch.View())\n339: \t} else {\n340: \t\tb.WriteString(dimStyle.Render(branchLabel) + dimStyle.Render(v.baseBranch.View()))\n341: \t}\n342: \tb.WriteString(\"\\n\")\n343: \tb.WriteString(dimStyle.Render(\"           blank = main · stored in .manigot/manigot.json, shared with your team\"))\n344: \tb.WriteString(\"\\n\\n\")\n345: \n346: \t// Job branch prefix row (project): the namespace job branches live under,\n347: \t// e.g. \"jobs\" makes a feature job's branch \"jobs/feature/<id>_<slug>\".\n348: \t// Project-scoped like base branch, so the same project-file note applies.\n349: \tprefixLabel := \"  Job branch prefix (project): \"\n350: \tif v.focus == stFocusJobPrefix {\n351: \t\tb.WriteString(prefixLabel + v.jobBranchPrefix.View())\n352: \t} else {\n353: \t\tb.WriteString(dimStyle.Render(prefixLabel) + dimStyle.Render(v.jobBranchPrefix.View()))\n354: \t}\n355: \tb.WriteString(\"\\n\")\n356: \tb.WriteString(dimStyle.Render(\"           blank = feature/… · stored in .manigot/manigot.json, shared with your team\"))\n357: \tb.WriteString(\"\\n\\n\")\n358: \n359: \t// Recent activity count row (global): the maximum number of entries the\n360: \t// dashboard's recent-activity strip may show.\n361: \tcountLabel := \"  Recent activity: \"\n362: \tif v.focus == stFocusCount {\n363: \t\tb.WriteString(countLabel + v.recentCount.View())\n364: \t} else {\n365: \t\tb.WriteString(dimStyle.Render(countLabel) + dimStyle.Render(v.recentCount.View()))\n366: \t}\n367: \tb.WriteString(\"\\n\")\n368: \tb.WriteString(dimStyle.Render(\"           blank = 5 · max entries shown in the dashboard's recent activity strip, stored in config/tui-settings.json\"))\n369: \tb.WriteString(\"\\n\\n\")\n370: \n371: \t// Profile row (global): one line per profile, the selected one highlighted.\n372: \tb.WriteString(\"  Profile:\\n\")\n373: \tfor i, p := range profileOptions {\n374: \t\tvar mark, id, rest string\n375: \t\tif i == v.profile && v.focus == stFocusProfile {\n376: \t\t\tmark = accentStyle.Render(\"▸ \")\n377: \t\t\tid = accentStyle.Render(p.ID)\n378: \t\t} else if i == v.profile {\n379: \t\t\tmark = lipgloss.NewStyle().Bold(true).Render(\"● \")\n380: \t\t\tid = lipgloss.NewStyle().Bold(true).Render(p.ID)\n381: \t\t} else {\n382: \t\t\tmark = \"  \"\n383: \t\t\tid = dimStyle.Render(p.ID)\n384: \t\t}\n385: \t\trest = \"  \" + dimStyle.Render(p.Label)\n386: \t\tb.WriteString(\"    \" + mark + id + rest)\n387: \t\tb.WriteString(\"\\n\")\n388: \t}\n389: \t// Describe the selected profile: which agent CLI it launches and what it\n390: \t// bills against, then where the choice is stored. The model is\n391: \t// deliberately not shown — the opencode profiles' model lives in manigot's\n392: \t// .env (OPENCODE_ZAI_MODEL/OPENCODE_GO_MODEL/OPENCODE_ZEN_MODEL/\n393: \t// OPENCODE_ZEN_FREE_MODEL), which the TUI does not read.\n394: \tsel := profileOptions[v.profile]\n395: \tselDesc := \"tool: \" + sel.Tool\n396: \tselDesc += \" · billed via \" + sel.Auth\n397: \tb.WriteString(dimStyle.Render(\"    \" + selDesc))\n398: \tb.WriteString(\"\\n\")\n399: \tb.WriteString(dimStyle.Render(\"    saved as MANIGOT_PROFILE in manigot/.env — shared with the CLI (bare mg / mg profiles)\"))\n400: \tb.WriteString(\"\\n\\n\")\n401: \n402: \t// Terminal row (global): the command used to spawn an agent session's\n403: \t// terminal, replacing launch's auto-detect spawn order when set. Inside\n404: \t// tmux the split pane always wins, regardless of this setting.\n405: \tterminalLabel := \"  Terminal: \"\n406: \tif v.focus == stFocusTerminal {\n407: \t\tb.WriteString(terminalLabel + v.terminal.View())\n408: \t} else {\n409: \t\tb.WriteString(dimStyle.Render(terminalLabel) + dimStyle.Render(v.terminal.View()))\n410: \t}\n411: \tb.WriteString(\"\\n\")\n412: \tb.WriteString(dimStyle.Render(\"           blank = auto-detect (tmux / Terminal.app / gnome-terminal / ...) · inside tmux the split pane always wins · stored in config/tui-settings.json\"))\n413: \tb.WriteString(\"\\n\\n\")\n414: \n415: \t// Theme row (global): the OpenCode theme name (e.g. \"nord\", \"tokyonight\"),\n416: \t// shared across every OpenCode profile — Claude Code already respects the\n417: \t// host terminal's own theme, so this has no effect there. Not validated\n418: \t// against a fixed list here, matching `mg theme`.\n419: \tthemeLabel := \"  Theme: \"\n420: \tif v.focus == stFocusTheme {\n421: \t\tb.WriteString(themeLabel + v.theme.View())\n422: \t} else {\n423: \t\tb.WriteString(dimStyle.Render(themeLabel) + dimStyle.Render(v.theme.View()))\n424: \t}\n425: \tb.WriteString(\"\\n\")\n426: \tb.WriteString(dimStyle.Render(\"           blank = OpenCode's own default/config · OpenCode only · saved as OPENCODE_THEME in manigot/.env\"))\n427: \tb.WriteString(\"\\n\\n\")\n428: \n429: \t// Footer: status or a focus-aware hint.\n430: \tif v.status != \"\" {\n431: \t\tb.WriteString(statusStyle.Render(v.status))\n432: \t} else {\n433: \t\tb.WriteString(dimStyle.Render(v.hint()))\n434: \t}\n435: \treturn b.String()\n436: }\n437: \n438: // hint returns the footer key hint, varied by which field is focused so it\n439: // always names the fields tab moves between rather than a static list.\n440: func (v *settingsView) hint() string {\n441: \tprefix := \"enter save · esc cancel\"\n442: \tswitch v.focus {\n443: \tcase stFocusEditor:\n444: \t\treturn \"tab/shift+tab base branch · \" + prefix\n445: \tcase stFocusBranch:\n446: \t\treturn \"tab/shift+tab job branch prefix · \" + prefix\n447: \tcase stFocusJobPrefix:\n448: \t\treturn \"tab/shift+tab recent activity · \" + prefix\n449: \tcase stFocusCount:\n450: \t\treturn \"tab/shift+tab profile · \" + prefix\n451: \tcase stFocusProfile:\n452: \t\treturn \"←/→ change profile · tab/shift+tab terminal · \" + prefix\n453: \tcase stFocusTerminal:\n454: \t\treturn \"tab/shift+tab theme · \" + prefix\n455: \tdefault: // stFocusTheme\n456: \t\treturn \"tab/shift+tab editor · \" + prefix\n457: \t}\n458: }\n\n(End of file - total 458 lines)\n</content>","metadata":{"preview":"package ui\n\nimport (\n\t\"fmt\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/charmbracelet/bubbles/textinput\"\n\ttea \"github.com/charmbracelet/bubbletea\"\n\t\"github.com/charmbracelet/lipgloss\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// profileOptions mirrors the profiles accepted by scripts/run.sh's --profile\n// flag, in cycle order.\nvar profileOptions = config.Profiles()\n\n// recentActivityCountMax is the upper end of the valid range for the","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/ui/settings.go","text":"package ui\n\nimport (\n\t\"fmt\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/charmbracelet/bubbles/textinput\"\n\ttea \"github.com/charmbracelet/bubbletea\"\n\t\"github.com/charmbracelet/lipgloss\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// profileOptions mirrors the profiles accepted by scripts/run.sh's --profile\n// flag, in cycle order.\nvar profileOptions = config.Profiles()\n\n// recentActivityCountMax is the upper end of the valid range for the\n// recent-activity count setting (the floor is 1). Values outside 1–100 are\n// rejected by the settings form.\nconst recentActivityCountMax = 100\n\n// Number of focusable fields in the settings form: editor, base branch, job\n// branch prefix, recent activity count, profile, terminal, theme — in tab\n// cycle order. Kept as a named constant so the tab/shift+tab cycle and focus\n// comparisons don't all hardcode a literal that has to be kept in sync field\n// by field.\nconst stFieldCount = 7\n\n// Focus indices for the settings form's fields, in tab cycle order: editor →\n// base branch → job branch prefix → recent activity count → profile →\n// terminal → theme → editor. Used by update() and render() instead of bare\n// ints. Terminal was appended after Profile, and Theme after Terminal, rather\n// than inserted next to Editor, so the existing constants keep their values\n// unchanged.\nconst (\n\tstFocusEditor    = 0\n\tstFocusBranch    = 1\n\tstFocusJobPrefix = 2\n\tstFocusCount     = 3\n\tstFocusProfile   = 4\n\tstFocusTerminal  = 5\n\tstFocusTheme     = 6\n)\n\n// stAction is what update returns for the App to act on.\ntype stAction int\n\nconst (\n\tstNone   stAction = iota\n\tstCancel          // esc — discard and return to the list\n\tstSubmit          // enter — persist the settings\n)\n\n// settingsView is the \"Settings\" form. It edits three files at once:\n//\n//   - config/tui-settings.json — the editor preference and the recent-activity\n//     count (personal, gitignored, in the manigot checkout);\n//   - manigot/.env — the subscription profile, as MANIGOT_PROFILE: the one\n//     default shared between CLI and TUI (bare `mg` resolves to it, `mg\n//     profiles` writes it, and this form reads/writes the same key); and\n//   - the project.Settings (base branch, job branch prefix) — shared project\n//     conventions, committable, in the target project's .manigot/manigot.json.\n//\n// Like newJobView, it does not persist anything itself — the App calls\n// config.Save and project.Save on submit so this stays a pure input\n// component.\ntype settingsView struct {\n\teditor          textinput.Model\n\tbaseBranch      textinput.Model\n\tjobBranchPrefix textinput.Model\n\trecentCount     textinput.Model\n\tterminal        textinput.Model\n\ttheme           textinput.Model\n\tprofile         int // index into profileOptions\n\tfocus           int // stFocusEditor / stFocusBranch / stFocusJobPrefix / stFocusCount / stFocusProfile / stFocusTerminal / stFocusTheme\n\twidth           int\n\theight          int\n\tstatus          string // validation/save error message\n}\n\n// newSettingsView builds the form seeded from the current global config and\n// project settings. The editor field is focused first, matching the form's\n// pre-base-branch behaviour.\nfunc newSettingsView(global config.Settings, proj project.Settings, width, height int) *settingsView {\n\teditor := textinput.New()\n\teditor.Placeholder = \"$VISUAL / $EDITOR / nano\"\n\teditor.Prompt = \"\" // we render our own \"Editor:\" label\n\teditor.CharLimit = 120\n\teditor.SetValue(global.Editor)\n\teditor.Focus()\n\teditor.Width = 60\n\n\tbaseBranch := textinput.New()\n\tbaseBranch.Placeholder = \"main\"\n\tbaseBranch.Prompt = \"\" // we render our own \"Base branch:\" label\n\tbaseBranch.CharLimit = 120\n\tbaseBranch.SetValue(proj.BaseBranch)\n\tbaseBranch.Width = 60\n\n\tjobBranchPrefix := textinput.New()\n\tjobBranchPrefix.Placeholder = \"jobs\"\n\tjobBranchPrefix.Prompt = \"\" // we render our own \"Job branch prefix:\" label\n\tjobBranchPrefix.CharLimit = 120\n\tjobBranchPrefix.SetValue(proj.JobBranchPrefix)\n\tjobBranchPrefix.Width = 60\n\n\trecentCount := textinput.New()\n\trecentCount.Placeholder = strconv.Itoa(config.DefaultRecentActivityCount)\n\trecentCount.Prompt = \"\" // we render our own \"Recent activity:\" label\n\trecentCount.CharLimit = 3\n\t// Seed with the resolved number so the user sees the effective value;\n\t// clearing it means \"default\" (see recentActivityCount).\n\trecentCount.SetValue(strconv.Itoa(global.RecentActivityCountValue()))\n\trecentCount.Width = 60\n\n\tterminal := textinput.New()\n\tterminal.Placeholder = \"blank = auto-detect\"\n\tterminal.Prompt = \"\" // we render our own \"Terminal:\" label\n\tterminal.CharLimit = 120\n\tterminal.SetValue(global.Terminal)\n\tterminal.Width = 60\n\n\ttheme := textinput.New()\n\ttheme.Placeholder = \"blank = OpenCode's own default\"\n\ttheme.Prompt = \"\" // we render our own \"Theme:\" label\n\ttheme.CharLimit = 120\n\ttheme.SetValue(global.ThemeValue())\n\ttheme.Width = 60\n\n\tv := &settingsView{\n\t\teditor:          editor,\n\t\tbaseBranch:      baseBranch,\n\t\tjobBranchPrefix: jobBranchPrefix,\n\t\trecentCount:     recentCount,\n\t\tterminal:        terminal,\n\t\ttheme:           theme,\n\t\tprofile:         profileIndex(global.ProfileValue()),\n\t\tfocus:           stFocusEditor,\n\t\twidth:           width,\n\t\theight:          height,\n\t}\n\tif width > 0 {\n\t\tw := stInputWidth(width)\n\t\tv.editor.Width = w\n\t\tv.baseBranch.Width = w\n\t\tv.jobBranchPrefix.Width = w\n\t\tv.recentCount.Width = w\n\t\tv.terminal.Width = w\n\t\tv.theme.Width = w\n\t}\n\treturn v\n}\n\n// stInputWidth returns the usable width for a settings text input, given the\n// available form width. All text inputs share the same width rule.\nfunc stInputWidth(width int) int {\n\tw := width - 12\n\tif w < 20 {\n\t\tw = 20\n\t}\n\treturn w\n}\n\n// profileIndex finds id in profileOptions, defaulting to index 0 (claude-pro)\n// for an unrecognized value.\nfunc profileIndex(id string) int {\n\tfor i, p := range profileOptions {\n\t\tif p.ID == id {\n\t\t\treturn i\n\t\t}\n\t}\n\treturn 0\n}\n\n// resize updates the viewport (and the text input widths) on terminal resize.\nfunc (v *settingsView) resize(width, height int) {\n\tif width == v.width && height == v.height {\n\t\treturn\n\t}\n\tv.width, v.height = width, height\n\tif width > 0 {\n\t\tw := stInputWidth(width)\n\t\tv.editor.Width = w\n\t\tv.baseBranch.Width = w\n\t\tv.jobBranchPrefix.Width = w\n\t\tv.recentCount.Width = w\n\t\tv.terminal.Width = w\n\t\tv.theme.Width = w\n\t}\n}\n\n// update processes a key for the form and reports the resulting action.\nfunc (v *settingsView) update(msg tea.KeyMsg) stAction {\n\tswitch msg.String() {\n\tcase \"esc\":\n\t\treturn stCancel\n\tcase \"tab\":\n\t\tv.setFocus((v.focus + 1) % stFieldCount)\n\t\treturn stNone\n\tcase \"shift+tab\":\n\t\tv.setFocus((v.focus + stFieldCount - 1) % stFieldCount)\n\t\treturn stNone\n\tcase \"enter\":\n\t\treturn stSubmit\n\t}\n\n\tif v.focus == stFocusProfile {\n\t\t// Profile selector: cycle with ←/→.\n\t\tswitch msg.String() {\n\t\tcase \"left\":\n\t\t\tv.profile = (v.profile + len(profileOptions) - 1) % len(profileOptions)\n\t\tcase \"right\":\n\t\t\tv.profile = (v.profile + 1) % len(profileOptions)\n\t\t}\n\t\treturn stNone\n\t}\n\n\t// A text input is focused (editor, base branch, job branch prefix, recent\n\t// count, terminal or theme): route the key to it.\n\tvar ti *textinput.Model\n\tswitch v.focus {\n\tcase stFocusEditor:\n\t\tti = &v.editor\n\tcase stFocusBranch:\n\t\tti = &v.baseBranch\n\tcase stFocusJobPrefix:\n\t\tti = &v.jobBranchPrefix\n\tcase stFocusCount:\n\t\tti = &v.recentCount\n\tcase stFocusTerminal:\n\t\tti = &v.terminal\n\tdefault: // stFocusTheme\n\t\tti = &v.theme\n\t}\n\tm, _ := ti.Update(msg)\n\t*ti = m\n\treturn stNone\n}\n\n// setFocus moves focus to field i and keeps the text inputs' focus state in\n// sync: only the editor, base branch, job branch prefix, recent count,\n// terminal or theme holds the text cursor; the profile selector is\n// keyboard-driven (←/→), not a text input.\nfunc (v *settingsView) setFocus(i int) {\n\tv.focus = i\n\tv.editor.Blur()\n\tv.baseBranch.Blur()\n\tv.jobBranchPrefix.Blur()\n\tv.recentCount.Blur()\n\tv.terminal.Blur()\n\tv.theme.Blur()\n\tswitch i {\n\tcase stFocusEditor:\n\t\tv.editor.Focus()\n\tcase stFocusBranch:\n\t\tv.baseBranch.Focus()\n\tcase stFocusJobPrefix:\n\t\tv.jobBranchPrefix.Focus()\n\tcase stFocusCount:\n\t\tv.recentCount.Focus()\n\tcase stFocusTerminal:\n\t\tv.terminal.Focus()\n\tcase stFocusTheme:\n\t\tv.theme.Focus()\n\tdefault: // stFocusProfile\n\t\t// no text input to focus — the profile selector is keyboard-driven\n\t}\n}\n\n// recentActivityCount parses and validates the form's recent-activity count\n// field. A trimmed empty input means \"unset → default\"\n// (config.DefaultRecentActivityCount). Anything that does not parse as an\n// integer in 1–recentActivityCountMax returns an error so the caller can\n// surface it and keep the form open without persisting anything.\nfunc (v *settingsView) recentActivityCount() (int, error) {\n\traw := strings.TrimSpace(v.recentCount.Value())\n\tif raw == \"\" {\n\t\treturn config.DefaultRecentActivityCount, nil\n\t}\n\tn, err := strconv.Atoi(raw)\n\tif err != nil || n < 1 || n > recentActivityCountMax {\n\t\treturn 0, fmt.Errorf(\"recent activity count must be an integer between 1 and %d (blank = %d)\", recentActivityCountMax, config.DefaultRecentActivityCount)\n\t}\n\treturn n, nil\n}\n\n// settingsValue returns the form's current global values as config.Settings,\n// ready to be persisted with config.Save. The recent-activity count is\n// included only when valid — callers must run recentActivityCount() first (as\n// updateSettings does) so an invalid value never silently reaches disk as 0.\nfunc (v *settingsView) settingsValue() config.Settings {\n\ts := config.Settings{\n\t\tEditor:   strings.TrimSpace(v.editor.Value()),\n\t\tProfile:  profileOptions[v.profile].ID,\n\t\tTerminal: strings.TrimSpace(v.terminal.Value()),\n\t\tTheme:    strings.TrimSpace(v.theme.Value()),\n\t}\n\tif n, err := v.recentActivityCount(); err == nil {\n\t\ts.RecentActivityCount = n\n\t}\n\treturn s\n}\n\n// projectValue returns the form's current project values as project.Settings,\n// ready to be persisted with project.Save.\nfunc (v *settingsView) projectValue() project.Settings {\n\treturn project.Settings{\n\t\tBaseBranch:      strings.TrimSpace(v.baseBranch.Value()),\n\t\tJobBranchPrefix: strings.TrimSpace(v.jobBranchPrefix.Value()),\n\t}\n}\n\n// render draws the form.\nfunc (v *settingsView) render() string {\n\tvar b strings.Builder\n\tb.WriteString(titleStyle.Render(\"Settings\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Editor row (global).\n\teditorLabel := \"  Editor: \"\n\tif v.focus == stFocusEditor {\n\t\tb.WriteString(editorLabel + v.editor.View())\n\t} else {\n\t\tb.WriteString(dimStyle.Render(editorLabel) + dimStyle.Render(v.editor.View()))\n\t}\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"           blank = use $VISUAL / $EDITOR / nano / vi\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Base branch row (project). Labeled project-scoped so it's clear this\n\t// writes a different file (.manigot/manigot.json, committable) than the\n\t// editor/profile rows above and below it.\n\tbranchLabel := \"  Base branch (project): \"\n\tif v.focus == stFocusBranch {\n\t\tb.WriteString(branchLabel + v.baseBranch.View())\n\t} else {\n\t\tb.WriteString(dimStyle.Render(branchLabel) + dimStyle.Render(v.baseBranch.View()))\n\t}\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"           blank = main · stored in .manigot/manigot.json, shared with your team\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Job branch prefix row (project): the namespace job branches live under,\n\t// e.g. \"jobs\" makes a feature job's branch \"jobs/feature/<id>_<slug>\".\n\t// Project-scoped like base branch, so the same project-file note applies.\n\tprefixLabel := \"  Job branch prefix (project): \"\n\tif v.focus == stFocusJobPrefix {\n\t\tb.WriteString(prefixLabel + v.jobBranchPrefix.View())\n\t} else {\n\t\tb.WriteString(dimStyle.Render(prefixLabel) + dimStyle.Render(v.jobBranchPrefix.View()))\n\t}\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"           blank = feature/… · stored in .manigot/manigot.json, shared with your team\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Recent activity count row (global): the maximum number of entries the\n\t// dashboard's recent-activity strip may show.\n\tcountLabel := \"  Recent activity: \"\n\tif v.focus == stFocusCount {\n\t\tb.WriteString(countLabel + v.recentCount.View())\n\t} else {\n\t\tb.WriteString(dimStyle.Render(countLabel) + dimStyle.Render(v.recentCount.View()))\n\t}\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"           blank = 5 · max entries shown in the dashboard's recent activity strip, stored in config/tui-settings.json\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Profile row (global): one line per profile, the selected one highlighted.\n\tb.WriteString(\"  Profile:\\n\")\n\tfor i, p := range profileOptions {\n\t\tvar mark, id, rest string\n\t\tif i == v.profile && v.focus == stFocusProfile {\n\t\t\tmark = accentStyle.Render(\"▸ \")\n\t\t\tid = accentStyle.Render(p.ID)\n\t\t} else if i == v.profile {\n\t\t\tmark = lipgloss.NewStyle().Bold(true).Render(\"● \")\n\t\t\tid = lipgloss.NewStyle().Bold(true).Render(p.ID)\n\t\t} else {\n\t\t\tmark = \"  \"\n\t\t\tid = dimStyle.Render(p.ID)\n\t\t}\n\t\trest = \"  \" + dimStyle.Render(p.Label)\n\t\tb.WriteString(\"    \" + mark + id + rest)\n\t\tb.WriteString(\"\\n\")\n\t}\n\t// Describe the selected profile: which agent CLI it launches and what it\n\t// bills against, then where the choice is stored. The model is\n\t// deliberately not shown — the opencode profiles' model lives in manigot's\n\t// .env (OPENCODE_ZAI_MODEL/OPENCODE_GO_MODEL/OPENCODE_ZEN_MODEL/\n\t// OPENCODE_ZEN_FREE_MODEL), which the TUI does not read.\n\tsel := profileOptions[v.profile]\n\tselDesc := \"tool: \" + sel.Tool\n\tselDesc += \" · billed via \" + sel.Auth\n\tb.WriteString(dimStyle.Render(\"    \" + selDesc))\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"    saved as MANIGOT_PROFILE in manigot/.env — shared with the CLI (bare mg / mg profiles)\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Terminal row (global): the command used to spawn an agent session's\n\t// terminal, replacing launch's auto-detect spawn order when set. Inside\n\t// tmux the split pane always wins, regardless of this setting.\n\tterminalLabel := \"  Terminal: \"\n\tif v.focus == stFocusTerminal {\n\t\tb.WriteString(terminalLabel + v.terminal.View())\n\t} else {\n\t\tb.WriteString(dimStyle.Render(terminalLabel) + dimStyle.Render(v.terminal.View()))\n\t}\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"           blank = auto-detect (tmux / Terminal.app / gnome-terminal / ...) · inside tmux the split pane always wins · stored in config/tui-settings.json\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Theme row (global): the OpenCode theme name (e.g. \"nord\", \"tokyonight\"),\n\t// shared across every OpenCode profile — Claude Code already respects the\n\t// host terminal's own theme, so this has no effect there. Not validated\n\t// against a fixed list here, matching `mg theme`.\n\tthemeLabel := \"  Theme: \"\n\tif v.focus == stFocusTheme {\n\t\tb.WriteString(themeLabel + v.theme.View())\n\t} else {\n\t\tb.WriteString(dimStyle.Render(themeLabel) + dimStyle.Render(v.theme.View()))\n\t}\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"           blank = OpenCode's own default/config · OpenCode only · saved as OPENCODE_THEME in manigot/.env\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Footer: status or a focus-aware hint.\n\tif v.status != \"\" {\n\t\tb.WriteString(statusStyle.Render(v.status))\n\t} else {\n\t\tb.WriteString(dimStyle.Render(v.hint()))\n\t}\n\treturn b.String()\n}\n\n// hint returns the footer key hint, varied by which field is focused so it\n// always names the fields tab moves between rather than a static list.\nfunc (v *settingsView) hint() string {\n\tprefix := \"enter save · esc cancel\"\n\tswitch v.focus {\n\tcase stFocusEditor:\n\t\treturn \"tab/shift+tab base branch · \" + prefix\n\tcase stFocusBranch:\n\t\treturn \"tab/shift+tab job branch prefix · \" + prefix\n\tcase stFocusJobPrefix:\n\t\treturn \"tab/shift+tab recent activity · \" + prefix\n\tcase stFocusCount:\n\t\treturn \"tab/shift+tab profile · \" + prefix\n\tcase stFocusProfile:\n\t\treturn \"←/→ change profile · tab/shift+tab terminal · \" + prefix\n\tcase stFocusTerminal:\n\t\treturn \"tab/shift+tab theme · \" + prefix\n\tdefault: // stFocusTheme\n\t\treturn \"tab/shift+tab editor · \" + prefix\n\t}\n}","lineStart":1,"lineEnd":458,"totalLines":458,"truncated":false}},"title":"src/internal/ui/settings.go","time":{"start":1787919305283,"end":1787919305288}},"id":"prt_0484b8a0a001nIG0O9sorDDSO4","sessionID":"ses_fb7b4a8d5ffeJWKjfWHud2qnLO","messageID":"msg_0484b79d2001craZifS68wDs0i"}}
{"type":"tool_use","timestamp":1787919305427,"sessionID":"ses_fb7b4a8d5ffeJWKjfWHud2qnLO","part":{"type":"tool","tool":"read","callID":"call_b770b539cd8c4ca5b98b45bb","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/ui/settings_test.go"},"output":"<path>/workspace/src/internal/ui/settings_test.go</path>\n<type>file</type>\n<content>\n1: package ui\n2: \n3: import (\n4: \t\"testing\"\n5: \n6: \ttea \"github.com/charmbracelet/bubbletea\"\n7: \n8: \t\"github.com/lmuskalla/manigot/internal/config\"\n9: \t\"github.com/lmuskalla/manigot/internal/project\"\n10: )\n11: \n12: func TestSettingsInitialFocus(t *testing.T) {\n13: \tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n14: \tif v.focus != stFocusEditor {\n15: \t\tt.Errorf(\"initial focus = %d, want %d (editor)\", v.focus, stFocusEditor)\n16: \t}\n17: }\n18: \n19: func TestSettingsActions(t *testing.T) {\n20: \tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n21: \tif v.update(key(t, tea.KeyEscape)) != stCancel {\n22: \t\tt.Error(\"esc should cancel\")\n23: \t}\n24: \tif v.update(key(t, tea.KeyEnter)) != stSubmit {\n25: \t\tt.Error(\"enter should submit\")\n26: \t}\n27: }\n28: \n29: func TestSettingsTabCyclesFocus(t *testing.T) {\n30: \tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n31: \tif v.focus != stFocusEditor {\n32: \t\tt.Fatal(\"expected initial focus editor\")\n33: \t}\n34: \tv.update(key(t, tea.KeyTab))\n35: \tif v.focus != stFocusBranch {\n36: \t\tt.Errorf(\"after tab, focus = %d, want %d (base branch)\", v.focus, stFocusBranch)\n37: \t}\n38: \tv.update(key(t, tea.KeyTab))\n39: \tif v.focus != stFocusJobPrefix {\n40: \t\tt.Errorf(\"after second tab, focus = %d, want %d (job branch prefix)\", v.focus, stFocusJobPrefix)\n41: \t}\n42: \tv.update(key(t, tea.KeyTab))\n43: \tif v.focus != stFocusCount {\n44: \t\tt.Errorf(\"after third tab, focus = %d, want %d (recent activity count)\", v.focus, stFocusCount)\n45: \t}\n46: \tv.update(key(t, tea.KeyTab))\n47: \tif v.focus != stFocusProfile {\n48: \t\tt.Errorf(\"after fourth tab, focus = %d, want %d (profile)\", v.focus, stFocusProfile)\n49: \t}\n50: \tv.update(key(t, tea.KeyTab))\n51: \tif v.focus != stFocusTerminal {\n52: \t\tt.Errorf(\"after fifth tab, focus = %d, want %d (terminal)\", v.focus, stFocusTerminal)\n53: \t}\n54: \tv.update(key(t, tea.KeyTab))\n55: \tif v.focus != stFocusTheme {\n56: \t\tt.Errorf(\"after sixth tab, focus = %d, want %d (theme)\", v.focus, stFocusTheme)\n57: \t}\n58: \tv.update(key(t, tea.KeyTab))\n59: \tif v.focus != stFocusEditor {\n60: \t\tt.Errorf(\"after seventh tab (wrap), focus = %d, want %d (editor)\", v.focus, stFocusEditor)\n61: \t}\n62: }\n63: \n64: func TestSettingsShiftTabCyclesFocusBackward(t *testing.T) {\n65: \tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n66: \tif v.focus != stFocusEditor {\n67: \t\tt.Fatal(\"expected initial focus editor\")\n68: \t}\n69: \t// shift+tab from editor wraps back to theme.\n70: \tv.update(keyMsg(\"shift+tab\"))\n71: \tif v.focus != stFocusTheme {\n72: \t\tt.Errorf(\"after shift+tab, focus = %d, want %d (theme)\", v.focus, stFocusTheme)\n73: \t}\n74: \tv.update(keyMsg(\"shift+tab\"))\n75: \tif v.focus != stFocusTerminal {\n76: \t\tt.Errorf(\"after second shift+tab, focus = %d, want %d (terminal)\", v.focus, stFocusTerminal)\n77: \t}\n78: \tv.update(keyMsg(\"shift+tab\"))\n79: \tif v.focus != stFocusProfile {\n80: \t\tt.Errorf(\"after third shift+tab, focus = %d, want %d (profile)\", v.focus, stFocusProfile)\n81: \t}\n82: \tv.update(keyMsg(\"shift+tab\"))\n83: \tif v.focus != stFocusCount {\n84: \t\tt.Errorf(\"after fourth shift+tab, focus = %d, want %d (recent activity count)\", v.focus, stFocusCount)\n85: \t}\n86: \tv.update(keyMsg(\"shift+tab\"))\n87: \tif v.focus != stFocusJobPrefix {\n88: \t\tt.Errorf(\"after fifth shift+tab, focus = %d, want %d (job branch prefix)\", v.focus, stFocusJobPrefix)\n89: \t}\n90: \tv.update(keyMsg(\"shift+tab\"))\n91: \tif v.focus != stFocusBranch {\n92: \t\tt.Errorf(\"after sixth shift+tab, focus = %d, want %d (base branch)\", v.focus, stFocusBranch)\n93: \t}\n94: \tv.update(keyMsg(\"shift+tab\"))\n95: \tif v.focus != stFocusEditor {\n96: \t\tt.Errorf(\"after seventh shift+tab, focus = %d, want %d (editor)\", v.focus, stFocusEditor)\n97: \t}\n98: }\n99: \n100: func TestSettingsProfileCycleOnlyWhenProfileFocused(t *testing.T) {\n101: \tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n102: \t// focus on editor: left/right must not change the profile.\n103: \tbefore := v.profile\n104: \tv.update(key(t, tea.KeyRight))\n105: \tif v.profile != before {\n106: \t\tt.Errorf(\"left/right while editor focused changed profile: %d -> %d\", before, v.profile)\n107: \t}\n108: \n109: \t// focus on profile (four tabs away now): right cycles claude-pro -> zai ->\n110: \t// opencode-go -> opencode-zen -> opencode-zen-free -> claude-pro.\n111: \tv.update(key(t, tea.KeyTab)) // editor -> base branch\n112: \tv.update(key(t, tea.KeyTab)) // base branch -> job branch prefix\n113: \tv.update(key(t, tea.KeyTab)) // job branch prefix -> recent activity count\n114: \tv.update(key(t, tea.KeyTab)) // recent activity count -> profile\n115: \t// left/right must not mutate the text inputs while profile is focused either.\n116: \tbranchBefore := v.baseBranch.Value()\n117: \tv.update(key(t, tea.KeyRight))\n118: \tif v.baseBranch.Value() != branchBefore {\n119: \t\tt.Errorf(\"right while profile focused edited the base branch field: %q -> %q\", branchBefore, v.baseBranch.Value())\n120: \t}\n121: \tif got := v.settingsValue().Profile; got != config.ProfileZAI {\n122: \t\tt.Errorf(\"after right: profile = %q, want %q\", got, config.ProfileZAI)\n123: \t}\n124: \tv.update(key(t, tea.KeyRight))\n125: \tif got := v.settingsValue().Profile; got != config.ProfileOpenCodeGo {\n126: \t\tt.Errorf(\"after right: profile = %q, want %q\", got, config.ProfileOpenCodeGo)\n127: \t}\n128: \tv.update(key(t, tea.KeyRight))\n129: \tif got := v.settingsValue().Profile; got != config.ProfileOpenCodeZen {\n130: \t\tt.Errorf(\"after right: profile = %q, want %q\", got, config.ProfileOpenCodeZen)\n131: \t}\n132: \tv.update(key(t, tea.KeyRight))\n133: \tif got := v.settingsValue().Profile; got != config.ProfileOpenCodeZenFree {\n134: \t\tt.Errorf(\"after right: profile = %q, want %q\", got, config.ProfileOpenCodeZenFree)\n135: \t}\n136: \tv.update(key(t, tea.KeyRight))\n137: \tif got := v.settingsValue().Profile; got != config.ProfileClaudePro {\n138: \t\tt.Errorf(\"after right wrap: profile = %q, want %q\", got, config.ProfileClaudePro)\n139: \t}\n140: \t// left cycles backwards.\n141: \tv.update(key(t, tea.KeyLeft))\n142: \tif got := v.settingsValue().Profile; got != config.ProfileOpenCodeZenFree {\n143: \t\tt.Errorf(\"after left: profile = %q, want %q\", got, config.ProfileOpenCodeZenFree)\n144: \t}\n145: }\n146: \n147: func TestSettingsEditorEdits(t *testing.T) {\n148: \tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n149: \tv.update(key(t, tea.KeyRunes, 'h', 'i'))\n150: \tif got := v.editor.Value(); got != \"hi\" {\n151: \t\tt.Errorf(\"editor after typing = %q, want hi\", got)\n152: \t}\n153: }\n154: \n155: func TestSettingsBaseBranchEdits(t *testing.T) {\n156: \tv := newSettingsView(config.Settings{Editor: \"x\"}, project.Settings{BaseBranch: \"main\"}, 80, 24)\n157: \t// Focus the base branch field, then type into it.\n158: \tv.update(key(t, tea.KeyTab)) // editor -> base branch\n159: \tv.update(key(t, tea.KeyRunes, 'd', 'e', 'v'))\n160: \tif got := v.baseBranch.Value(); got != \"maindev\" {\n161: \t\tt.Errorf(\"base branch after typing = %q, want maindev\", got)\n162: \t}\n163: \t// Typing into base branch must not leak into the editor.\n164: \tif got := v.editor.Value(); got != \"x\" {\n165: \t\tt.Errorf(\"editor leaked = %q, want x\", got)\n166: \t}\n167: }\n168: \n169: func TestSettingsSeededFromProjectSettings(t *testing.T) {\n170: \tv := newSettingsView(config.Settings{}, project.Settings{BaseBranch: \"develop\"}, 80, 24)\n171: \tif got := v.baseBranch.Value(); got != \"develop\" {\n172: \t\tt.Errorf(\"base branch seed = %q, want develop\", got)\n173: \t}\n174: \tif got := v.projectValue().BaseBranch; got != \"develop\" {\n175: \t\tt.Errorf(\"projectValue after seed = %q, want develop\", got)\n176: \t}\n177: }\n178: \n179: func TestSettingsJobPrefixEdits(t *testing.T) {\n180: \tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n181: \t// Focus the job branch prefix field (two tabs), then type into it.\n182: \tv.update(key(t, tea.KeyTab)) // editor -> base branch\n183: \tv.update(key(t, tea.KeyTab)) // base branch -> job branch prefix\n184: \tv.update(key(t, tea.KeyRunes, 'j', 'o', 'b', 's'))\n185: \tif got := v.jobBranchPrefix.Value(); got != \"jobs\" {\n186: \t\tt.Errorf(\"job branch prefix after typing = %q, want jobs\", got)\n187: \t}\n188: \t// projectValue carries it through, trimmed.\n189: \tif got := v.projectValue().JobBranchPrefix; got != \"jobs\" {\n190: \t\tt.Errorf(\"projectValue after typing = %q, want jobs\", got)\n191: \t}\n192: \t// Typing into job prefix must not leak into the other fields.\n193: \tif got := v.editor.Value(); got != \"\" {\n194: \t\tt.Errorf(\"editor leaked = %q, want empty\", got)\n195: \t}\n196: \tif got := v.baseBranch.Value(); got != \"\" {\n197: \t\tt.Errorf(\"base branch leaked = %q, want empty\", got)\n198: \t}\n199: }\n200: \n201: func TestSettingsJobPrefixSeededFromProjectSettings(t *testing.T) {\n202: \tv := newSettingsView(config.Settings{}, project.Settings{JobBranchPrefix: \"mg\"}, 80, 24)\n203: \tif got := v.jobBranchPrefix.Value(); got != \"mg\" {\n204: \t\tt.Errorf(\"job branch prefix seed = %q, want mg\", got)\n205: \t}\n206: \tif got := v.projectValue().JobBranchPrefix; got != \"mg\" {\n207: \t\tt.Errorf(\"projectValue after seed = %q, want mg\", got)\n208: \t}\n209: }\n210: \n211: func TestSettingsProjectValueTrimsAndStaysSeparateFromGlobal(t *testing.T) {\n212: \tv := newSettingsView(config.Settings{Editor: \"vim\", Profile: config.ProfileZAI}, project.Settings{}, 80, 24)\n213: \t// Set a base branch with surrounding whitespace; projectValue should trim it.\n214: \tv.update(key(t, tea.KeyTab)) // editor -> base branch\n215: \tv.update(key(t, tea.KeyRunes, ' ', 't', 'r', 'u', 'n', 'k', ' '))\n216: \tif got := v.projectValue(); got != (project.Settings{BaseBranch: \"trunk\"}) {\n217: \t\tt.Errorf(\"projectValue = %+v, want {trunk}\", got)\n218: \t}\n219: \t// Global settings are unaffected by base branch edits (the recent-activity\n220: \t// count field carries its seeded default).\n221: \tif got := v.settingsValue(); got != (config.Settings{Editor: \"vim\", Profile: config.ProfileZAI, RecentActivityCount: config.DefaultRecentActivityCount}) {\n222: \t\tt.Errorf(\"settingsValue leaked from base branch = %+v, want {vim zai count:%d}\", got, config.DefaultRecentActivityCount)\n223: \t}\n224: }\n225: \n226: func TestSettingsRender(t *testing.T) {\n227: \tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n228: \tv.update(key(t, tea.KeyRunes, 'a', 'b', 'c'))\n229: \tout := v.render()\n230: \tfor _, want := range []string{\"Editor:\", \"Base branch\", \"Job branch prefix\", \"Recent activity:\", \"claude-pro\", \"zai\", \"opencode-go\", \"opencode-zen\", \"opencode-zen-free\", \"abc\", \"Profile\", \"recent activity strip\", \"Terminal:\", \"auto-detect\", \"Theme:\", \"OPENCODE_THEME\"} {\n231: \t\tif !contains(out, want) {\n232: \t\t\tt.Errorf(\"render missing %q\", want)\n233: \t\t}\n234: \t}\n235: }\n236: \n237: func TestSettingsTerminalSeeded(t *testing.T) {\n238: \tv := newSettingsView(config.Settings{Terminal: \"kitty\"}, project.Settings{}, 80, 24)\n239: \tif got := v.terminal.Value(); got != \"kitty\" {\n240: \t\tt.Errorf(\"terminal seed = %q, want kitty\", got)\n241: \t}\n242: \tif got := v.settingsValue().Terminal; got != \"kitty\" {\n243: \t\tt.Errorf(\"settingsValue().Terminal = %q, want kitty\", got)\n244: \t}\n245: }\n246: \n247: func TestSettingsTerminalEdits(t *testing.T) {\n248: \tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n249: \tv.update(key(t, tea.KeyTab)) // editor -> base branch\n250: \tv.update(key(t, tea.KeyTab)) // base branch -> job branch prefix\n251: \tv.update(key(t, tea.KeyTab)) // job branch prefix -> recent activity count\n252: \tv.update(key(t, tea.KeyTab)) // recent activity count -> profile\n253: \tv.update(key(t, tea.KeyTab)) // profile -> terminal\n254: \tif v.focus != stFocusTerminal {\n255: \t\tt.Fatalf(\"focus = %d, want %d (terminal)\", v.focus, stFocusTerminal)\n256: \t}\n257: \tv.update(key(t, tea.KeyRunes, 'a', 'l', 'a', 'c', 'r', 'i', 't', 't', 'y'))\n258: \tif got := v.terminal.Value(); got != \"alacritty\" {\n259: \t\tt.Errorf(\"terminal after typing = %q, want alacritty\", got)\n260: \t}\n261: \t// Typing into terminal must not leak into the other fields.\n262: \tif got := v.editor.Value(); got != \"\" {\n263: \t\tt.Errorf(\"editor leaked = %q, want empty\", got)\n264: \t}\n265: }\n266: \n267: func TestSettingsTerminalValueTrims(t *testing.T) {\n268: \tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n269: \tv.terminal.SetValue(\"  kitty  \")\n270: \tif got := v.settingsValue().Terminal; got != \"kitty\" {\n271: \t\tt.Errorf(\"settingsValue().Terminal = %q, want trimmed kitty\", got)\n272: \t}\n273: }\n274: \n275: func TestSettingsThemeSeeded(t *testing.T) {\n276: \tv := newSettingsView(config.Settings{Theme: \"nord\"}, project.Settings{}, 80, 24)\n277: \tif got := v.theme.Value(); got != \"nord\" {\n278: \t\tt.Errorf(\"theme seed = %q, want nord\", got)\n279: \t}\n280: \tif got := v.settingsValue().Theme; got != \"nord\" {\n281: \t\tt.Errorf(\"settingsValue().Theme = %q, want nord\", got)\n282: \t}\n283: }\n284: \n285: func TestSettingsThemeEdits(t *testing.T) {\n286: \tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n287: \tv.update(key(t, tea.KeyTab)) // editor -> base branch\n288: \tv.update(key(t, tea.KeyTab)) // base branch -> job branch prefix\n289: \tv.update(key(t, tea.KeyTab)) // job branch prefix -> recent activity count\n290: \tv.update(key(t, tea.KeyTab)) // recent activity count -> profile\n291: \tv.update(key(t, tea.KeyTab)) // profile -> terminal\n292: \tv.update(key(t, tea.KeyTab)) // terminal -> theme\n293: \tif v.focus != stFocusTheme {\n294: \t\tt.Fatalf(\"focus = %d, want %d (theme)\", v.focus, stFocusTheme)\n295: \t}\n296: \tv.update(key(t, tea.KeyRunes, 'n', 'o', 'r', 'd'))\n297: \tif got := v.theme.Value(); got != \"nord\" {\n298: \t\tt.Errorf(\"theme after typing = %q, want nord\", got)\n299: \t}\n300: \t// Typing into theme must not leak into the other fields.\n301: \tif got := v.editor.Value(); got != \"\" {\n302: \t\tt.Errorf(\"editor leaked = %q, want empty\", got)\n303: \t}\n304: \tif got := v.terminal.Value(); got != \"\" {\n305: \t\tt.Errorf(\"terminal leaked = %q, want empty\", got)\n306: \t}\n307: }\n308: \n309: func TestSettingsThemeValueTrims(t *testing.T) {\n310: \tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n311: \tv.theme.SetValue(\"  nord  \")\n312: \tif got := v.settingsValue().Theme; got != \"nord\" {\n313: \t\tt.Errorf(\"settingsValue().Theme = %q, want trimmed nord\", got)\n314: \t}\n315: }\n316: \n317: func TestSettingsRecentCountSeeded(t *testing.T) {\n318: \t// An explicit value seeds the field with the resolved number.\n319: \tv := newSettingsView(config.Settings{RecentActivityCount: 12}, project.Settings{}, 80, 24)\n320: \tif got := v.recentCount.Value(); got != \"12\" {\n321: \t\tt.Errorf(\"recent count seed = %q, want 12\", got)\n322: \t}\n323: \t// Unset (0) seeds with the default, so the user always sees the effective\n324: \t// value.\n325: \tv = newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n326: \tif got := v.recentCount.Value(); got != \"5\" {\n327: \t\tt.Errorf(\"recent count default seed = %q, want 5\", got)\n328: \t}\n329: }\n330: \n331: func TestSettingsRecentCountEdits(t *testing.T) {\n332: \tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n333: \tv.update(key(t, tea.KeyTab)) // editor -> base branch\n334: \tv.update(key(t, tea.KeyTab)) // base branch -> job branch prefix\n335: \tv.update(key(t, tea.KeyTab)) // job branch prefix -> recent activity count\n336: \tv.recentCount.SetValue(\"\")   // clear the seeded default\n337: \tv.update(key(t, tea.KeyRunes, '3'))\n338: \tif got := v.recentCount.Value(); got != \"3\" {\n339: \t\tt.Errorf(\"recent count after typing = %q, want 3\", got)\n340: \t}\n341: \t// Typing into recent count must not leak into the other fields.\n342: \tif got := v.editor.Value(); got != \"\" {\n343: \t\tt.Errorf(\"editor leaked = %q, want empty\", got)\n344: \t}\n345: \tif got := v.baseBranch.Value(); got != \"\" {\n346: \t\tt.Errorf(\"base branch leaked = %q, want empty\", got)\n347: \t}\n348: }\n349: \n350: func TestSettingsRecentCountValidation(t *testing.T) {\n351: \tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n352: \n353: \t// Blank -> default.\n354: \tv.recentCount.SetValue(\"\")\n355: \tif n, err := v.recentActivityCount(); err != nil || n != config.DefaultRecentActivityCount {\n356: \t\tt.Errorf(\"blank count = (%d, %v), want (%d, nil)\", n, err, config.DefaultRecentActivityCount)\n357: \t}\n358: \n359: \t// Valid integer in range -> parsed, and reflected in settingsValue.\n360: \tv.recentCount.SetValue(\"12\")\n361: \tif n, err := v.recentActivityCount(); err != nil || n != 12 {\n362: \t\tt.Errorf(\"12 = (%d, %v), want (12, nil)\", n, err)\n363: \t}\n364: \tif got := v.settingsValue().RecentActivityCount; got != 12 {\n365: \t\tt.Errorf(\"settingsValue().RecentActivityCount = %d, want 12\", got)\n366: \t}\n367: \n368: \t// Anything else -> error, and settingsValue must not smuggle it out.\n369: \tfor _, bad := range []string{\"abc\", \"0\", \"-1\", \"101\", \"12.5\"} {\n370: \t\tv.recentCount.SetValue(bad)\n371: \t\tif _, err := v.recentActivityCount(); err == nil {\n372: \t\t\tt.Errorf(\"count %q accepted, want an error\", bad)\n373: \t\t}\n374: \t\tif got := v.settingsValue().RecentActivityCount; got != 0 {\n375: \t\t\tt.Errorf(\"invalid count %q leaked into settingsValue as %d, want 0\", bad, got)\n376: \t\t}\n377: \t}\n378: }\n379: \n380: func TestSettingsSubmitInvalidCountKeepsFormOpen(t *testing.T) {\n381: \troot := t.TempDir()\n382: \ta := NewApp(root, nil)\n383: \ta.width, a.height = 80, 24\n384: \ta.settings.RecentActivityCount = 7 // pin regardless of on-disk settings\n385: \ta.updateList(keyMsg(\"s\"))          // open the settings form\n386: \tif a.settingsView == nil {\n387: \t\tt.Fatal(\"settings view did not open\")\n388: \t}\n389: \n390: \ta.settingsView.recentCount.SetValue(\"abc\")\n391: \ta.updateSettings(key(t, tea.KeyEnter)) // submit\n392: \n393: \t// The form must stay open with a status message, and nothing persisted.\n394: \tif a.settingsView == nil {\n395: \t\tt.Fatal(\"settings form closed despite an invalid recent activity count\")\n396: \t}\n397: \tif a.settingsView.status == \"\" {\n398: \t\tt.Error(\"status not set for an invalid recent activity count\")\n399: \t}\n400: \tif a.settings.RecentActivityCount != 7 {\n401: \t\tt.Errorf(\"in-memory settings changed on invalid submit: RecentActivityCount = %d, want 7\", a.settings.RecentActivityCount)\n402: \t}\n403: }\n\n(End of file - total 403 lines)\n</content>","metadata":{"preview":"package ui\n\nimport (\n\t\"testing\"\n\n\ttea \"github.com/charmbracelet/bubbletea\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\nfunc TestSettingsInitialFocus(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n\tif v.focus != stFocusEditor {\n\t\tt.Errorf(\"initial focus = %d, want %d (editor)\", v.focus, stFocusEditor)\n\t}\n}\n\nfunc TestSettingsActions(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/ui/settings_test.go","text":"package ui\n\nimport (\n\t\"testing\"\n\n\ttea \"github.com/charmbracelet/bubbletea\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\nfunc TestSettingsInitialFocus(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n\tif v.focus != stFocusEditor {\n\t\tt.Errorf(\"initial focus = %d, want %d (editor)\", v.focus, stFocusEditor)\n\t}\n}\n\nfunc TestSettingsActions(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n\tif v.update(key(t, tea.KeyEscape)) != stCancel {\n\t\tt.Error(\"esc should cancel\")\n\t}\n\tif v.update(key(t, tea.KeyEnter)) != stSubmit {\n\t\tt.Error(\"enter should submit\")\n\t}\n}\n\nfunc TestSettingsTabCyclesFocus(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n\tif v.focus != stFocusEditor {\n\t\tt.Fatal(\"expected initial focus editor\")\n\t}\n\tv.update(key(t, tea.KeyTab))\n\tif v.focus != stFocusBranch {\n\t\tt.Errorf(\"after tab, focus = %d, want %d (base branch)\", v.focus, stFocusBranch)\n\t}\n\tv.update(key(t, tea.KeyTab))\n\tif v.focus != stFocusJobPrefix {\n\t\tt.Errorf(\"after second tab, focus = %d, want %d (job branch prefix)\", v.focus, stFocusJobPrefix)\n\t}\n\tv.update(key(t, tea.KeyTab))\n\tif v.focus != stFocusCount {\n\t\tt.Errorf(\"after third tab, focus = %d, want %d (recent activity count)\", v.focus, stFocusCount)\n\t}\n\tv.update(key(t, tea.KeyTab))\n\tif v.focus != stFocusProfile {\n\t\tt.Errorf(\"after fourth tab, focus = %d, want %d (profile)\", v.focus, stFocusProfile)\n\t}\n\tv.update(key(t, tea.KeyTab))\n\tif v.focus != stFocusTerminal {\n\t\tt.Errorf(\"after fifth tab, focus = %d, want %d (terminal)\", v.focus, stFocusTerminal)\n\t}\n\tv.update(key(t, tea.KeyTab))\n\tif v.focus != stFocusTheme {\n\t\tt.Errorf(\"after sixth tab, focus = %d, want %d (theme)\", v.focus, stFocusTheme)\n\t}\n\tv.update(key(t, tea.KeyTab))\n\tif v.focus != stFocusEditor {\n\t\tt.Errorf(\"after seventh tab (wrap), focus = %d, want %d (editor)\", v.focus, stFocusEditor)\n\t}\n}\n\nfunc TestSettingsShiftTabCyclesFocusBackward(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n\tif v.focus != stFocusEditor {\n\t\tt.Fatal(\"expected initial focus editor\")\n\t}\n\t// shift+tab from editor wraps back to theme.\n\tv.update(keyMsg(\"shift+tab\"))\n\tif v.focus != stFocusTheme {\n\t\tt.Errorf(\"after shift+tab, focus = %d, want %d (theme)\", v.focus, stFocusTheme)\n\t}\n\tv.update(keyMsg(\"shift+tab\"))\n\tif v.focus != stFocusTerminal {\n\t\tt.Errorf(\"after second shift+tab, focus = %d, want %d (terminal)\", v.focus, stFocusTerminal)\n\t}\n\tv.update(keyMsg(\"shift+tab\"))\n\tif v.focus != stFocusProfile {\n\t\tt.Errorf(\"after third shift+tab, focus = %d, want %d (profile)\", v.focus, stFocusProfile)\n\t}\n\tv.update(keyMsg(\"shift+tab\"))\n\tif v.focus != stFocusCount {\n\t\tt.Errorf(\"after fourth shift+tab, focus = %d, want %d (recent activity count)\", v.focus, stFocusCount)\n\t}\n\tv.update(keyMsg(\"shift+tab\"))\n\tif v.focus != stFocusJobPrefix {\n\t\tt.Errorf(\"after fifth shift+tab, focus = %d, want %d (job branch prefix)\", v.focus, stFocusJobPrefix)\n\t}\n\tv.update(keyMsg(\"shift+tab\"))\n\tif v.focus != stFocusBranch {\n\t\tt.Errorf(\"after sixth shift+tab, focus = %d, want %d (base branch)\", v.focus, stFocusBranch)\n\t}\n\tv.update(keyMsg(\"shift+tab\"))\n\tif v.focus != stFocusEditor {\n\t\tt.Errorf(\"after seventh shift+tab, focus = %d, want %d (editor)\", v.focus, stFocusEditor)\n\t}\n}\n\nfunc TestSettingsProfileCycleOnlyWhenProfileFocused(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n\t// focus on editor: left/right must not change the profile.\n\tbefore := v.profile\n\tv.update(key(t, tea.KeyRight))\n\tif v.profile != before {\n\t\tt.Errorf(\"left/right while editor focused changed profile: %d -> %d\", before, v.profile)\n\t}\n\n\t// focus on profile (four tabs away now): right cycles claude-pro -> zai ->\n\t// opencode-go -> opencode-zen -> opencode-zen-free -> claude-pro.\n\tv.update(key(t, tea.KeyTab)) // editor -> base branch\n\tv.update(key(t, tea.KeyTab)) // base branch -> job branch prefix\n\tv.update(key(t, tea.KeyTab)) // job branch prefix -> recent activity count\n\tv.update(key(t, tea.KeyTab)) // recent activity count -> profile\n\t// left/right must not mutate the text inputs while profile is focused either.\n\tbranchBefore := v.baseBranch.Value()\n\tv.update(key(t, tea.KeyRight))\n\tif v.baseBranch.Value() != branchBefore {\n\t\tt.Errorf(\"right while profile focused edited the base branch field: %q -> %q\", branchBefore, v.baseBranch.Value())\n\t}\n\tif got := v.settingsValue().Profile; got != config.ProfileZAI {\n\t\tt.Errorf(\"after right: profile = %q, want %q\", got, config.ProfileZAI)\n\t}\n\tv.update(key(t, tea.KeyRight))\n\tif got := v.settingsValue().Profile; got != config.ProfileOpenCodeGo {\n\t\tt.Errorf(\"after right: profile = %q, want %q\", got, config.ProfileOpenCodeGo)\n\t}\n\tv.update(key(t, tea.KeyRight))\n\tif got := v.settingsValue().Profile; got != config.ProfileOpenCodeZen {\n\t\tt.Errorf(\"after right: profile = %q, want %q\", got, config.ProfileOpenCodeZen)\n\t}\n\tv.update(key(t, tea.KeyRight))\n\tif got := v.settingsValue().Profile; got != config.ProfileOpenCodeZenFree {\n\t\tt.Errorf(\"after right: profile = %q, want %q\", got, config.ProfileOpenCodeZenFree)\n\t}\n\tv.update(key(t, tea.KeyRight))\n\tif got := v.settingsValue().Profile; got != config.ProfileClaudePro {\n\t\tt.Errorf(\"after right wrap: profile = %q, want %q\", got, config.ProfileClaudePro)\n\t}\n\t// left cycles backwards.\n\tv.update(key(t, tea.KeyLeft))\n\tif got := v.settingsValue().Profile; got != config.ProfileOpenCodeZenFree {\n\t\tt.Errorf(\"after left: profile = %q, want %q\", got, config.ProfileOpenCodeZenFree)\n\t}\n}\n\nfunc TestSettingsEditorEdits(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n\tv.update(key(t, tea.KeyRunes, 'h', 'i'))\n\tif got := v.editor.Value(); got != \"hi\" {\n\t\tt.Errorf(\"editor after typing = %q, want hi\", got)\n\t}\n}\n\nfunc TestSettingsBaseBranchEdits(t *testing.T) {\n\tv := newSettingsView(config.Settings{Editor: \"x\"}, project.Settings{BaseBranch: \"main\"}, 80, 24)\n\t// Focus the base branch field, then type into it.\n\tv.update(key(t, tea.KeyTab)) // editor -> base branch\n\tv.update(key(t, tea.KeyRunes, 'd', 'e', 'v'))\n\tif got := v.baseBranch.Value(); got != \"maindev\" {\n\t\tt.Errorf(\"base branch after typing = %q, want maindev\", got)\n\t}\n\t// Typing into base branch must not leak into the editor.\n\tif got := v.editor.Value(); got != \"x\" {\n\t\tt.Errorf(\"editor leaked = %q, want x\", got)\n\t}\n}\n\nfunc TestSettingsSeededFromProjectSettings(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{BaseBranch: \"develop\"}, 80, 24)\n\tif got := v.baseBranch.Value(); got != \"develop\" {\n\t\tt.Errorf(\"base branch seed = %q, want develop\", got)\n\t}\n\tif got := v.projectValue().BaseBranch; got != \"develop\" {\n\t\tt.Errorf(\"projectValue after seed = %q, want develop\", got)\n\t}\n}\n\nfunc TestSettingsJobPrefixEdits(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n\t// Focus the job branch prefix field (two tabs), then type into it.\n\tv.update(key(t, tea.KeyTab)) // editor -> base branch\n\tv.update(key(t, tea.KeyTab)) // base branch -> job branch prefix\n\tv.update(key(t, tea.KeyRunes, 'j', 'o', 'b', 's'))\n\tif got := v.jobBranchPrefix.Value(); got != \"jobs\" {\n\t\tt.Errorf(\"job branch prefix after typing = %q, want jobs\", got)\n\t}\n\t// projectValue carries it through, trimmed.\n\tif got := v.projectValue().JobBranchPrefix; got != \"jobs\" {\n\t\tt.Errorf(\"projectValue after typing = %q, want jobs\", got)\n\t}\n\t// Typing into job prefix must not leak into the other fields.\n\tif got := v.editor.Value(); got != \"\" {\n\t\tt.Errorf(\"editor leaked = %q, want empty\", got)\n\t}\n\tif got := v.baseBranch.Value(); got != \"\" {\n\t\tt.Errorf(\"base branch leaked = %q, want empty\", got)\n\t}\n}\n\nfunc TestSettingsJobPrefixSeededFromProjectSettings(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{JobBranchPrefix: \"mg\"}, 80, 24)\n\tif got := v.jobBranchPrefix.Value(); got != \"mg\" {\n\t\tt.Errorf(\"job branch prefix seed = %q, want mg\", got)\n\t}\n\tif got := v.projectValue().JobBranchPrefix; got != \"mg\" {\n\t\tt.Errorf(\"projectValue after seed = %q, want mg\", got)\n\t}\n}\n\nfunc TestSettingsProjectValueTrimsAndStaysSeparateFromGlobal(t *testing.T) {\n\tv := newSettingsView(config.Settings{Editor: \"vim\", Profile: config.ProfileZAI}, project.Settings{}, 80, 24)\n\t// Set a base branch with surrounding whitespace; projectValue should trim it.\n\tv.update(key(t, tea.KeyTab)) // editor -> base branch\n\tv.update(key(t, tea.KeyRunes, ' ', 't', 'r', 'u', 'n', 'k', ' '))\n\tif got := v.projectValue(); got != (project.Settings{BaseBranch: \"trunk\"}) {\n\t\tt.Errorf(\"projectValue = %+v, want {trunk}\", got)\n\t}\n\t// Global settings are unaffected by base branch edits (the recent-activity\n\t// count field carries its seeded default).\n\tif got := v.settingsValue(); got != (config.Settings{Editor: \"vim\", Profile: config.ProfileZAI, RecentActivityCount: config.DefaultRecentActivityCount}) {\n\t\tt.Errorf(\"settingsValue leaked from base branch = %+v, want {vim zai count:%d}\", got, config.DefaultRecentActivityCount)\n\t}\n}\n\nfunc TestSettingsRender(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n\tv.update(key(t, tea.KeyRunes, 'a', 'b', 'c'))\n\tout := v.render()\n\tfor _, want := range []string{\"Editor:\", \"Base branch\", \"Job branch prefix\", \"Recent activity:\", \"claude-pro\", \"zai\", \"opencode-go\", \"opencode-zen\", \"opencode-zen-free\", \"abc\", \"Profile\", \"recent activity strip\", \"Terminal:\", \"auto-detect\", \"Theme:\", \"OPENCODE_THEME\"} {\n\t\tif !contains(out, want) {\n\t\t\tt.Errorf(\"render missing %q\", want)\n\t\t}\n\t}\n}\n\nfunc TestSettingsTerminalSeeded(t *testing.T) {\n\tv := newSettingsView(config.Settings{Terminal: \"kitty\"}, project.Settings{}, 80, 24)\n\tif got := v.terminal.Value(); got != \"kitty\" {\n\t\tt.Errorf(\"terminal seed = %q, want kitty\", got)\n\t}\n\tif got := v.settingsValue().Terminal; got != \"kitty\" {\n\t\tt.Errorf(\"settingsValue().Terminal = %q, want kitty\", got)\n\t}\n}\n\nfunc TestSettingsTerminalEdits(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n\tv.update(key(t, tea.KeyTab)) // editor -> base branch\n\tv.update(key(t, tea.KeyTab)) // base branch -> job branch prefix\n\tv.update(key(t, tea.KeyTab)) // job branch prefix -> recent activity count\n\tv.update(key(t, tea.KeyTab)) // recent activity count -> profile\n\tv.update(key(t, tea.KeyTab)) // profile -> terminal\n\tif v.focus != stFocusTerminal {\n\t\tt.Fatalf(\"focus = %d, want %d (terminal)\", v.focus, stFocusTerminal)\n\t}\n\tv.update(key(t, tea.KeyRunes, 'a', 'l', 'a', 'c', 'r', 'i', 't', 't', 'y'))\n\tif got := v.terminal.Value(); got != \"alacritty\" {\n\t\tt.Errorf(\"terminal after typing = %q, want alacritty\", got)\n\t}\n\t// Typing into terminal must not leak into the other fields.\n\tif got := v.editor.Value(); got != \"\" {\n\t\tt.Errorf(\"editor leaked = %q, want empty\", got)\n\t}\n}\n\nfunc TestSettingsTerminalValueTrims(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n\tv.terminal.SetValue(\"  kitty  \")\n\tif got := v.settingsValue().Terminal; got != \"kitty\" {\n\t\tt.Errorf(\"settingsValue().Terminal = %q, want trimmed kitty\", got)\n\t}\n}\n\nfunc TestSettingsThemeSeeded(t *testing.T) {\n\tv := newSettingsView(config.Settings{Theme: \"nord\"}, project.Settings{}, 80, 24)\n\tif got := v.theme.Value(); got != \"nord\" {\n\t\tt.Errorf(\"theme seed = %q, want nord\", got)\n\t}\n\tif got := v.settingsValue().Theme; got != \"nord\" {\n\t\tt.Errorf(\"settingsValue().Theme = %q, want nord\", got)\n\t}\n}\n\nfunc TestSettingsThemeEdits(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n\tv.update(key(t, tea.KeyTab)) // editor -> base branch\n\tv.update(key(t, tea.KeyTab)) // base branch -> job branch prefix\n\tv.update(key(t, tea.KeyTab)) // job branch prefix -> recent activity count\n\tv.update(key(t, tea.KeyTab)) // recent activity count -> profile\n\tv.update(key(t, tea.KeyTab)) // profile -> terminal\n\tv.update(key(t, tea.KeyTab)) // terminal -> theme\n\tif v.focus != stFocusTheme {\n\t\tt.Fatalf(\"focus = %d, want %d (theme)\", v.focus, stFocusTheme)\n\t}\n\tv.update(key(t, tea.KeyRunes, 'n', 'o', 'r', 'd'))\n\tif got := v.theme.Value(); got != \"nord\" {\n\t\tt.Errorf(\"theme after typing = %q, want nord\", got)\n\t}\n\t// Typing into theme must not leak into the other fields.\n\tif got := v.editor.Value(); got != \"\" {\n\t\tt.Errorf(\"editor leaked = %q, want empty\", got)\n\t}\n\tif got := v.terminal.Value(); got != \"\" {\n\t\tt.Errorf(\"terminal leaked = %q, want empty\", got)\n\t}\n}\n\nfunc TestSettingsThemeValueTrims(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n\tv.theme.SetValue(\"  nord  \")\n\tif got := v.settingsValue().Theme; got != \"nord\" {\n\t\tt.Errorf(\"settingsValue().Theme = %q, want trimmed nord\", got)\n\t}\n}\n\nfunc TestSettingsRecentCountSeeded(t *testing.T) {\n\t// An explicit value seeds the field with the resolved number.\n\tv := newSettingsView(config.Settings{RecentActivityCount: 12}, project.Settings{}, 80, 24)\n\tif got := v.recentCount.Value(); got != \"12\" {\n\t\tt.Errorf(\"recent count seed = %q, want 12\", got)\n\t}\n\t// Unset (0) seeds with the default, so the user always sees the effective\n\t// value.\n\tv = newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n\tif got := v.recentCount.Value(); got != \"5\" {\n\t\tt.Errorf(\"recent count default seed = %q, want 5\", got)\n\t}\n}\n\nfunc TestSettingsRecentCountEdits(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n\tv.update(key(t, tea.KeyTab)) // editor -> base branch\n\tv.update(key(t, tea.KeyTab)) // base branch -> job branch prefix\n\tv.update(key(t, tea.KeyTab)) // job branch prefix -> recent activity count\n\tv.recentCount.SetValue(\"\")   // clear the seeded default\n\tv.update(key(t, tea.KeyRunes, '3'))\n\tif got := v.recentCount.Value(); got != \"3\" {\n\t\tt.Errorf(\"recent count after typing = %q, want 3\", got)\n\t}\n\t// Typing into recent count must not leak into the other fields.\n\tif got := v.editor.Value(); got != \"\" {\n\t\tt.Errorf(\"editor leaked = %q, want empty\", got)\n\t}\n\tif got := v.baseBranch.Value(); got != \"\" {\n\t\tt.Errorf(\"base branch leaked = %q, want empty\", got)\n\t}\n}\n\nfunc TestSettingsRecentCountValidation(t *testing.T) {\n\tv := newSettingsView(config.Settings{}, project.Settings{}, 80, 24)\n\n\t// Blank -> default.\n\tv.recentCount.SetValue(\"\")\n\tif n, err := v.recentActivityCount(); err != nil || n != config.DefaultRecentActivityCount {\n\t\tt.Errorf(\"blank count = (%d, %v), want (%d, nil)\", n, err, config.DefaultRecentActivityCount)\n\t}\n\n\t// Valid integer in range -> parsed, and reflected in settingsValue.\n\tv.recentCount.SetValue(\"12\")\n\tif n, err := v.recentActivityCount(); err != nil || n != 12 {\n\t\tt.Errorf(\"12 = (%d, %v), want (12, nil)\", n, err)\n\t}\n\tif got := v.settingsValue().RecentActivityCount; got != 12 {\n\t\tt.Errorf(\"settingsValue().RecentActivityCount = %d, want 12\", got)\n\t}\n\n\t// Anything else -> error, and settingsValue must not smuggle it out.\n\tfor _, bad := range []string{\"abc\", \"0\", \"-1\", \"101\", \"12.5\"} {\n\t\tv.recentCount.SetValue(bad)\n\t\tif _, err := v.recentActivityCount(); err == nil {\n\t\t\tt.Errorf(\"count %q accepted, want an error\", bad)\n\t\t}\n\t\tif got := v.settingsValue().RecentActivityCount; got != 0 {\n\t\t\tt.Errorf(\"invalid count %q leaked into settingsValue as %d, want 0\", bad, got)\n\t\t}\n\t}\n}\n\nfunc TestSettingsSubmitInvalidCountKeepsFormOpen(t *testing.T) {\n\troot := t.TempDir()\n\ta := NewApp(root, nil)\n\ta.width, a.height = 80, 24\n\ta.settings.RecentActivityCount = 7 // pin regardless of on-disk settings\n\ta.updateList(keyMsg(\"s\"))          // open the settings form\n\tif a.settingsView == nil {\n\t\tt.Fatal(\"settings view did not open\")\n\t}\n\n\ta.settingsView.recentCount.SetValue(\"abc\")\n\ta.updateSettings(key(t, tea.KeyEnter)) // submit\n\n\t// The form must stay open with a status message, and nothing persisted.\n\tif a.settingsView == nil {\n\t\tt.Fatal(\"settings form closed despite an invalid recent activity count\")\n\t}\n\tif a.settingsView.status == \"\" {\n\t\tt.Error(\"status not set for an invalid recent activity count\")\n\t}\n\tif a.settings.RecentActivityCount != 7 {\n\t\tt.Errorf(\"in-memory settings changed on invalid submit: RecentActivityCount = %d, want 7\", a.settings.RecentActivityCount)\n\t}\n}","lineStart":1,"lineEnd":403,"totalLines":403,"truncated":false}},"title":"src/internal/ui/settings_test.go","time":{"start":1787919305421,"end":1787919305425}},"id":"prt_0484b8a5e001c7mEvb0yzdrUn6","sessionID":"ses_fb7b4a8d5ffeJWKjfWHud2qnLO","messageID":"msg_0484b79d2001craZifS68wDs0i"}}
