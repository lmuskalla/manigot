{"type":"tool_use","timestamp":1787919431048,"sessionID":"ses_fb7b4a8d5ffeJWKjfWHud2qnLO","part":{"type":"tool","tool":"read","callID":"call_d91c986b30d549008c6ec753","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/ui/newjob.go"},"output":"<path>/workspace/src/internal/ui/newjob.go</path>\n<type>file</type>\n<content>\n1: package ui\n2: \n3: import (\n4: \t\"strings\"\n5: \n6: \t\"github.com/charmbracelet/bubbles/textinput\"\n7: \ttea \"github.com/charmbracelet/bubbletea\"\n8: \t\"github.com/charmbracelet/lipgloss\"\n9: )\n10: \n11: // jobTypes mirrors the --type values accepted by scripts/new-job.sh.\n12: var jobTypes = []string{\"feature\", \"fix\", \"chore\"}\n13: \n14: // njAction is what update returns for the App to act on.\n15: type njAction int\n16: \n17: const (\n18: \tnjNone   njAction = iota\n19: \tnjCancel          // esc — discard and return to the list\n20: \tnjSubmit          // enter — create the job\n21: )\n22: \n23: // newJobView is the \"New job\" form: a title text input and a cycled type\n24: // selector. It does not run the command itself — the App does that on submit so\n25: // the view stays a pure input component.\n26: type newJobView struct {\n27: \ttitle  textinput.Model\n28: \ttyp    int // index into jobTypes\n29: \tfocus  int // 0 = title, 1 = type\n30: \twidth  int\n31: \theight int\n32: \tstatus string // validation/launch error message\n33: }\n34: \n35: func newNewJobView(width, height int) *newJobView {\n36: \tti := textinput.New()\n37: \tti.Placeholder = \"add image gallery block\"\n38: \tti.Prompt = \"\" // we render our own \"Title:\" label\n39: \tti.CharLimit = 120\n40: \tti.Focus()\n41: \tti.Width = 60\n42: \tv := &newJobView{title: ti, focus: 0, width: width, height: height}\n43: \tif width > 0 {\n44: \t\tv.title.Width = width - 12\n45: \t\tif v.title.Width < 20 {\n46: \t\t\tv.title.Width = 20\n47: \t\t}\n48: \t}\n49: \treturn v\n50: }\n51: \n52: // resize updates the viewport (and the title field width) on terminal resize.\n53: func (v *newJobView) resize(width, height int) {\n54: \tif width == v.width && height == v.height {\n55: \t\treturn\n56: \t}\n57: \tv.width, v.height = width, height\n58: \tif width > 0 {\n59: \t\tw := width - 12\n60: \t\tif w < 20 {\n61: \t\t\tw = 20\n62: \t\t}\n63: \t\tv.title.Width = w\n64: \t}\n65: }\n66: \n67: // update processes a key for the form and reports the resulting action.\n68: func (v *newJobView) update(msg tea.KeyMsg) njAction {\n69: \tswitch msg.String() {\n70: \tcase \"esc\":\n71: \t\treturn njCancel\n72: \tcase \"tab\", \"shift+tab\":\n73: \t\tv.focus = 1 - v.focus\n74: \t\tif v.focus == 0 {\n75: \t\t\tv.title.Focus()\n76: \t\t} else {\n77: \t\t\tv.title.Blur()\n78: \t\t}\n79: \t\treturn njNone\n80: \tcase \"enter\":\n81: \t\treturn njSubmit\n82: \t}\n83: \n84: \tif v.focus == 1 {\n85: \t\t// Type selector: cycle with ←/→.\n86: \t\tswitch msg.String() {\n87: \t\tcase \"left\":\n88: \t\t\tv.typ = (v.typ + len(jobTypes) - 1) % len(jobTypes)\n89: \t\tcase \"right\":\n90: \t\t\tv.typ = (v.typ + 1) % len(jobTypes)\n91: \t\t}\n92: \t\treturn njNone\n93: \t}\n94: \n95: \t// Title field: route the key to the text input (cursor movement, editing).\n96: \tm, _ := v.title.Update(msg)\n97: \tv.title = m\n98: \treturn njNone\n99: }\n100: \n101: // typeValue returns the selected type string.\n102: func (v *newJobView) typeValue() string { return jobTypes[v.typ] }\n103: \n104: // render draws the form.\n105: func (v *newJobView) render() string {\n106: \tvar b strings.Builder\n107: \tb.WriteString(titleStyle.Render(\"New job\"))\n108: \tb.WriteString(\"\\n\\n\")\n109: \n110: \t// Title row.\n111: \tlabel := \"  Title: \"\n112: \tif v.focus == 0 {\n113: \t\tb.WriteString(label + v.title.View())\n114: \t} else {\n115: \t\tb.WriteString(dimStyle.Render(label) + dimStyle.Render(v.title.View()))\n116: \t}\n117: \tb.WriteString(\"\\n\\n\")\n118: \n119: \t// Type row.\n120: \tb.WriteString(\"  Type:  \")\n121: \tfor i, t := range jobTypes {\n122: \t\tvar cell string\n123: \t\tswitch {\n124: \t\tcase i == v.typ && v.focus == 1:\n125: \t\t\tcell = accentStyle.Render(\"▸ \" + t)\n126: \t\tcase i == v.typ:\n127: \t\t\tcell = lipgloss.NewStyle().Bold(true).Render(\"● \" + t)\n128: \t\tdefault:\n129: \t\t\tcell = dimStyle.Render(\"○ \" + t)\n130: \t\t}\n131: \t\tb.WriteString(cell)\n132: \t\tb.WriteString(\"    \")\n133: \t}\n134: \tb.WriteString(\"\\n\\n\")\n135: \n136: \t// Footer: status or hint.\n137: \tif v.status != \"\" {\n138: \t\tb.WriteString(statusStyle.Render(v.status))\n139: \t} else if v.focus == 1 {\n140: \t\tb.WriteString(dimStyle.Render(\"←/→ change type · tab/shift+tab title · enter create · esc cancel\"))\n141: \t} else {\n142: \t\tb.WriteString(dimStyle.Render(\"tab/shift+tab type · enter create · esc cancel\"))\n143: \t}\n144: \treturn b.String()\n145: }\n\n(End of file - total 145 lines)\n</content>","metadata":{"preview":"package ui\n\nimport (\n\t\"strings\"\n\n\t\"github.com/charmbracelet/bubbles/textinput\"\n\ttea \"github.com/charmbracelet/bubbletea\"\n\t\"github.com/charmbracelet/lipgloss\"\n)\n\n// jobTypes mirrors the --type values accepted by scripts/new-job.sh.\nvar jobTypes = []string{\"feature\", \"fix\", \"chore\"}\n\n// njAction is what update returns for the App to act on.\ntype njAction int\n\nconst (\n\tnjNone   njAction = iota\n\tnjCancel          // esc — discard and return to the list\n\tnjSubmit          // enter — create the job","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/ui/newjob.go","text":"package ui\n\nimport (\n\t\"strings\"\n\n\t\"github.com/charmbracelet/bubbles/textinput\"\n\ttea \"github.com/charmbracelet/bubbletea\"\n\t\"github.com/charmbracelet/lipgloss\"\n)\n\n// jobTypes mirrors the --type values accepted by scripts/new-job.sh.\nvar jobTypes = []string{\"feature\", \"fix\", \"chore\"}\n\n// njAction is what update returns for the App to act on.\ntype njAction int\n\nconst (\n\tnjNone   njAction = iota\n\tnjCancel          // esc — discard and return to the list\n\tnjSubmit          // enter — create the job\n)\n\n// newJobView is the \"New job\" form: a title text input and a cycled type\n// selector. It does not run the command itself — the App does that on submit so\n// the view stays a pure input component.\ntype newJobView struct {\n\ttitle  textinput.Model\n\ttyp    int // index into jobTypes\n\tfocus  int // 0 = title, 1 = type\n\twidth  int\n\theight int\n\tstatus string // validation/launch error message\n}\n\nfunc newNewJobView(width, height int) *newJobView {\n\tti := textinput.New()\n\tti.Placeholder = \"add image gallery block\"\n\tti.Prompt = \"\" // we render our own \"Title:\" label\n\tti.CharLimit = 120\n\tti.Focus()\n\tti.Width = 60\n\tv := &newJobView{title: ti, focus: 0, width: width, height: height}\n\tif width > 0 {\n\t\tv.title.Width = width - 12\n\t\tif v.title.Width < 20 {\n\t\t\tv.title.Width = 20\n\t\t}\n\t}\n\treturn v\n}\n\n// resize updates the viewport (and the title field width) on terminal resize.\nfunc (v *newJobView) resize(width, height int) {\n\tif width == v.width && height == v.height {\n\t\treturn\n\t}\n\tv.width, v.height = width, height\n\tif width > 0 {\n\t\tw := width - 12\n\t\tif w < 20 {\n\t\t\tw = 20\n\t\t}\n\t\tv.title.Width = w\n\t}\n}\n\n// update processes a key for the form and reports the resulting action.\nfunc (v *newJobView) update(msg tea.KeyMsg) njAction {\n\tswitch msg.String() {\n\tcase \"esc\":\n\t\treturn njCancel\n\tcase \"tab\", \"shift+tab\":\n\t\tv.focus = 1 - v.focus\n\t\tif v.focus == 0 {\n\t\t\tv.title.Focus()\n\t\t} else {\n\t\t\tv.title.Blur()\n\t\t}\n\t\treturn njNone\n\tcase \"enter\":\n\t\treturn njSubmit\n\t}\n\n\tif v.focus == 1 {\n\t\t// Type selector: cycle with ←/→.\n\t\tswitch msg.String() {\n\t\tcase \"left\":\n\t\t\tv.typ = (v.typ + len(jobTypes) - 1) % len(jobTypes)\n\t\tcase \"right\":\n\t\t\tv.typ = (v.typ + 1) % len(jobTypes)\n\t\t}\n\t\treturn njNone\n\t}\n\n\t// Title field: route the key to the text input (cursor movement, editing).\n\tm, _ := v.title.Update(msg)\n\tv.title = m\n\treturn njNone\n}\n\n// typeValue returns the selected type string.\nfunc (v *newJobView) typeValue() string { return jobTypes[v.typ] }\n\n// render draws the form.\nfunc (v *newJobView) render() string {\n\tvar b strings.Builder\n\tb.WriteString(titleStyle.Render(\"New job\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Title row.\n\tlabel := \"  Title: \"\n\tif v.focus == 0 {\n\t\tb.WriteString(label + v.title.View())\n\t} else {\n\t\tb.WriteString(dimStyle.Render(label) + dimStyle.Render(v.title.View()))\n\t}\n\tb.WriteString(\"\\n\\n\")\n\n\t// Type row.\n\tb.WriteString(\"  Type:  \")\n\tfor i, t := range jobTypes {\n\t\tvar cell string\n\t\tswitch {\n\t\tcase i == v.typ && v.focus == 1:\n\t\t\tcell = accentStyle.Render(\"▸ \" + t)\n\t\tcase i == v.typ:\n\t\t\tcell = lipgloss.NewStyle().Bold(true).Render(\"● \" + t)\n\t\tdefault:\n\t\t\tcell = dimStyle.Render(\"○ \" + t)\n\t\t}\n\t\tb.WriteString(cell)\n\t\tb.WriteString(\"    \")\n\t}\n\tb.WriteString(\"\\n\\n\")\n\n\t// Footer: status or hint.\n\tif v.status != \"\" {\n\t\tb.WriteString(statusStyle.Render(v.status))\n\t} else if v.focus == 1 {\n\t\tb.WriteString(dimStyle.Render(\"←/→ change type · tab/shift+tab title · enter create · esc cancel\"))\n\t} else {\n\t\tb.WriteString(dimStyle.Render(\"tab/shift+tab type · enter create · esc cancel\"))\n\t}\n\treturn b.String()\n}","lineStart":1,"lineEnd":145,"totalLines":145,"truncated":false}},"title":"src/internal/ui/newjob.go","time":{"start":1787919431038,"end":1787919431047}},"id":"prt_0484d7516001Vqx0fvKuaKzqyc","sessionID":"ses_fb7b4a8d5ffeJWKjfWHud2qnLO","messageID":"msg_0484cd9c3001N7phhPLgDwZVsk"}}
