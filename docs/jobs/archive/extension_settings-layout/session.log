{"type":"tool_use","timestamp":1787919653691,"sessionID":"ses_fb7af5935ffeLyhZ1lIHw0GPEP","part":{"type":"tool","tool":"read","callID":"call_00_JMSfPcgumaZANGKD4TSf9658","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/ui/settings.go"},"output":"<path>/workspace/src/internal/ui/settings.go</path>\n<type>file</type>\n<content>\n1: package ui\n2: \n3: import (\n4: \t\"fmt\"\n5: \t\"strconv\"\n6: \t\"strings\"\n7: \n8: \t\"github.com/charmbracelet/bubbles/textinput\"\n9: \ttea \"github.com/charmbracelet/bubbletea\"\n10: \t\"github.com/charmbracelet/lipgloss\"\n11: \n12: \t\"github.com/lmuskalla/manigot/internal/config\"\n13: \t\"github.com/lmuskalla/manigot/internal/project\"\n14: )\n15: \n16: // profileOptions mirrors the profiles accepted by scripts/run.sh's --profile\n17: // flag, in cycle order.\n18: var profileOptions = config.Profiles()\n19: \n20: // recentActivityCountMax is the upper end of the valid range for the\n21: // recent-activity count setting (the floor is 1). Values outside 1–100 are\n22: // rejected by the settings form.\n23: const recentActivityCountMax = 100\n24: \n25: // Number of focusable fields in the settings form: editor, base branch, job\n26: // branch prefix, recent activity count, profile, terminal, theme — in tab\n27: // cycle order. Kept as a named constant so the tab/shift+tab cycle and focus\n28: // comparisons don't all hardcode a literal that has to be kept in sync field\n29: // by field.\n30: const stFieldCount = 7\n31: \n32: // Focus indices for the settings form's fields, in tab cycle order: editor →\n33: // base branch → job branch prefix → recent activity count → profile →\n34: // terminal → theme → editor. Used by update() and render() instead of bare\n35: // ints. Terminal was appended after Profile, and Theme after Terminal, rather\n36: // than inserted next to Editor, so the existing constants keep their values\n37: // unchanged.\n38: const (\n39: \tstFocusEditor    = 0\n40: \tstFocusBranch    = 1\n41: \tstFocusJobPrefix = 2\n42: \tstFocusCount     = 3\n43: \tstFocusProfile   = 4\n44: \tstFocusTerminal  = 5\n45: \tstFocusTheme     = 6\n46: )\n47: \n48: // stAction is what update returns for the App to act on.\n49: type stAction int\n50: \n51: const (\n52: \tstNone   stAction = iota\n53: \tstCancel          // esc — discard and return to the list\n54: \tstSubmit          // enter — persist the settings\n55: )\n56: \n57: // settingsView is the \"Settings\" form. It edits three files at once:\n58: //\n59: //   - config/tui-settings.json — the editor preference and the recent-activity\n60: //     count (personal, gitignored, in the manigot checkout);\n61: //   - manigot/.env — the subscription profile, as MANIGOT_PROFILE: the one\n62: //     default shared between CLI and TUI (bare `mg` resolves to it, `mg\n63: //     profiles` writes it, and this form reads/writes the same key); and\n64: //   - the project.Settings (base branch, job branch prefix) — shared project\n65: //     conventions, committable, in the target project's .manigot/manigot.json.\n66: //\n67: // Like newJobView, it does not persist anything itself — the App calls\n68: // config.Save and project.Save on submit so this stays a pure input\n69: // component.\n70: type settingsView struct {\n71: \teditor          textinput.Model\n72: \tbaseBranch      textinput.Model\n73: \tjobBranchPrefix textinput.Model\n74: \trecentCount     textinput.Model\n75: \tterminal        textinput.Model\n76: \ttheme           textinput.Model\n77: \tprofile         int // index into profileOptions\n78: \tfocus           int // stFocusEditor / stFocusBranch / stFocusJobPrefix / stFocusCount / stFocusProfile / stFocusTerminal / stFocusTheme\n79: \twidth           int\n80: \theight          int\n81: \tstatus          string // validation/save error message\n82: }\n83: \n84: // newSettingsView builds the form seeded from the current global config and\n85: // project settings. The editor field is focused first, matching the form's\n86: // pre-base-branch behaviour.\n87: func newSettingsView(global config.Settings, proj project.Settings, width, height int) *settingsView {\n88: \teditor := textinput.New()\n89: \teditor.Placeholder = \"$VISUAL / $EDITOR / nano\"\n90: \teditor.Prompt = \"\" // we render our own \"Editor:\" label\n91: \teditor.CharLimit = 120\n92: \teditor.SetValue(global.Editor)\n93: \teditor.Focus()\n94: \teditor.Width = 60\n95: \n96: \tbaseBranch := textinput.New()\n97: \tbaseBranch.Placeholder = \"main\"\n98: \tbaseBranch.Prompt = \"\" // we render our own \"Base branch:\" label\n99: \tbaseBranch.CharLimit = 120\n100: \tbaseBranch.SetValue(proj.BaseBranch)\n101: \tbaseBranch.Width = 60\n102: \n103: \tjobBranchPrefix := textinput.New()\n104: \tjobBranchPrefix.Placeholder = \"jobs\"\n105: \tjobBranchPrefix.Prompt = \"\" // we render our own \"Job branch prefix:\" label\n106: \tjobBranchPrefix.CharLimit = 120\n107: \tjobBranchPrefix.SetValue(proj.JobBranchPrefix)\n108: \tjobBranchPrefix.Width = 60\n109: \n110: \trecentCount := textinput.New()\n111: \trecentCount.Placeholder = strconv.Itoa(config.DefaultRecentActivityCount)\n112: \trecentCount.Prompt = \"\" // we render our own \"Recent activity:\" label\n113: \trecentCount.CharLimit = 3\n114: \t// Seed with the resolved number so the user sees the effective value;\n115: \t// clearing it means \"default\" (see recentActivityCount).\n116: \trecentCount.SetValue(strconv.Itoa(global.RecentActivityCountValue()))\n117: \trecentCount.Width = 60\n118: \n119: \tterminal := textinput.New()\n120: \tterminal.Placeholder = \"blank = auto-detect\"\n121: \tterminal.Prompt = \"\" // we render our own \"Terminal:\" label\n122: \tterminal.CharLimit = 120\n123: \tterminal.SetValue(global.Terminal)\n124: \tterminal.Width = 60\n125: \n126: \ttheme := textinput.New()\n127: \ttheme.Placeholder = \"blank = OpenCode's own default\"\n128: \ttheme.Prompt = \"\" // we render our own \"Theme:\" label\n129: \ttheme.CharLimit = 120\n130: \ttheme.SetValue(global.ThemeValue())\n131: \ttheme.Width = 60\n132: \n133: \tv := &settingsView{\n134: \t\teditor:          editor,\n135: \t\tbaseBranch:      baseBranch,\n136: \t\tjobBranchPrefix: jobBranchPrefix,\n137: \t\trecentCount:     recentCount,\n138: \t\tterminal:        terminal,\n139: \t\ttheme:           theme,\n140: \t\tprofile:         profileIndex(global.ProfileValue()),\n141: \t\tfocus:           stFocusEditor,\n142: \t\twidth:           width,\n143: \t\theight:          height,\n144: \t}\n145: \tif width > 0 {\n146: \t\tw := stInputWidth(width)\n147: \t\tv.editor.Width = w\n148: \t\tv.baseBranch.Width = w\n149: \t\tv.jobBranchPrefix.Width = w\n150: \t\tv.recentCount.Width = w\n151: \t\tv.terminal.Width = w\n152: \t\tv.theme.Width = w\n153: \t}\n154: \treturn v\n155: }\n156: \n157: // stInputWidth returns the usable width for a settings text input, given the\n158: // available form width. All text inputs share the same width rule.\n159: func stInputWidth(width int) int {\n160: \tw := width - 12\n161: \tif w < 20 {\n162: \t\tw = 20\n163: \t}\n164: \treturn w\n165: }\n166: \n167: // profileIndex finds id in profileOptions, defaulting to index 0 (claude-pro)\n168: // for an unrecognized value.\n169: func profileIndex(id string) int {\n170: \tfor i, p := range profileOptions {\n171: \t\tif p.ID == id {\n172: \t\t\treturn i\n173: \t\t}\n174: \t}\n175: \treturn 0\n176: }\n177: \n178: // resize updates the viewport (and the text input widths) on terminal resize.\n179: func (v *settingsView) resize(width, height int) {\n180: \tif width == v.width && height == v.height {\n181: \t\treturn\n182: \t}\n183: \tv.width, v.height = width, height\n184: \tif width > 0 {\n185: \t\tw := stInputWidth(width)\n186: \t\tv.editor.Width = w\n187: \t\tv.baseBranch.Width = w\n188: \t\tv.jobBranchPrefix.Width = w\n189: \t\tv.recentCount.Width = w\n190: \t\tv.terminal.Width = w\n191: \t\tv.theme.Width = w\n192: \t}\n193: }\n194: \n195: // update processes a key for the form and reports the resulting action.\n196: func (v *settingsView) update(msg tea.KeyMsg) stAction {\n197: \tswitch msg.String() {\n198: \tcase \"esc\":\n199: \t\treturn stCancel\n200: \tcase \"tab\":\n201: \t\tv.setFocus((v.focus + 1) % stFieldCount)\n202: \t\treturn stNone\n203: \tcase \"shift+tab\":\n204: \t\tv.setFocus((v.focus + stFieldCount - 1) % stFieldCount)\n205: \t\treturn stNone\n206: \tcase \"enter\":\n207: \t\treturn stSubmit\n208: \t}\n209: \n210: \tif v.focus == stFocusProfile {\n211: \t\t// Profile selector: cycle with ←/→.\n212: \t\tswitch msg.String() {\n213: \t\tcase \"left\":\n214: \t\t\tv.profile = (v.profile + len(profileOptions) - 1) % len(profileOptions)\n215: \t\tcase \"right\":\n216: \t\t\tv.profile = (v.profile + 1) % len(profileOptions)\n217: \t\t}\n218: \t\treturn stNone\n219: \t}\n220: \n221: \t// A text input is focused (editor, base branch, job branch prefix, recent\n222: \t// count, terminal or theme): route the key to it.\n223: \tvar ti *textinput.Model\n224: \tswitch v.focus {\n225: \tcase stFocusEditor:\n226: \t\tti = &v.editor\n227: \tcase stFocusBranch:\n228: \t\tti = &v.baseBranch\n229: \tcase stFocusJobPrefix:\n230: \t\tti = &v.jobBranchPrefix\n231: \tcase stFocusCount:\n232: \t\tti = &v.recentCount\n233: \tcase stFocusTerminal:\n234: \t\tti = &v.terminal\n235: \tdefault: // stFocusTheme\n236: \t\tti = &v.theme\n237: \t}\n238: \tm, _ := ti.Update(msg)\n239: \t*ti = m\n240: \treturn stNone\n241: }\n242: \n243: // setFocus moves focus to field i and keeps the text inputs' focus state in\n244: // sync: only the editor, base branch, job branch prefix, recent count,\n245: // terminal or theme holds the text cursor; the profile selector is\n246: // keyboard-driven (←/→), not a text input.\n247: func (v *settingsView) setFocus(i int) {\n248: \tv.focus = i\n249: \tv.editor.Blur()\n250: \tv.baseBranch.Blur()\n251: \tv.jobBranchPrefix.Blur()\n252: \tv.recentCount.Blur()\n253: \tv.terminal.Blur()\n254: \tv.theme.Blur()\n255: \tswitch i {\n256: \tcase stFocusEditor:\n257: \t\tv.editor.Focus()\n258: \tcase stFocusBranch:\n259: \t\tv.baseBranch.Focus()\n260: \tcase stFocusJobPrefix:\n261: \t\tv.jobBranchPrefix.Focus()\n262: \tcase stFocusCount:\n263: \t\tv.recentCount.Focus()\n264: \tcase stFocusTerminal:\n265: \t\tv.terminal.Focus()\n266: \tcase stFocusTheme:\n267: \t\tv.theme.Focus()\n268: \tdefault: // stFocusProfile\n269: \t\t// no text input to focus — the profile selector is keyboard-driven\n270: \t}\n271: }\n272: \n273: // recentActivityCount parses and validates the form's recent-activity count\n274: // field. A trimmed empty input means \"unset → default\"\n275: // (config.DefaultRecentActivityCount). Anything that does not parse as an\n276: // integer in 1–recentActivityCountMax returns an error so the caller can\n277: // surface it and keep the form open without persisting anything.\n278: func (v *settingsView) recentActivityCount() (int, error) {\n279: \traw := strings.TrimSpace(v.recentCount.Value())\n280: \tif raw == \"\" {\n281: \t\treturn config.DefaultRecentActivityCount, nil\n282: \t}\n283: \tn, err := strconv.Atoi(raw)\n284: \tif err != nil || n < 1 || n > recentActivityCountMax {\n285: \t\treturn 0, fmt.Errorf(\"recent activity count must be an integer between 1 and %d (blank = %d)\", recentActivityCountMax, config.DefaultRecentActivityCount)\n286: \t}\n287: \treturn n, nil\n288: }\n289: \n290: // settingsValue returns the form's current global values as config.Settings,\n291: // ready to be persisted with config.Save. The recent-activity count is\n292: // included only when valid — callers must run recentActivityCount() first (as\n293: // updateSettings does) so an invalid value never silently reaches disk as 0.\n294: func (v *settingsView) settingsValue() config.Settings {\n295: \ts := config.Settings{\n296: \t\tEditor:   strings.TrimSpace(v.editor.Value()),\n297: \t\tProfile:  profileOptions[v.profile].ID,\n298: \t\tTerminal: strings.TrimSpace(v.terminal.Value()),\n299: \t\tTheme:    strings.TrimSpace(v.theme.Value()),\n300: \t}\n301: \tif n, err := v.recentActivityCount(); err == nil {\n302: \t\ts.RecentActivityCount = n\n303: \t}\n304: \treturn s\n305: }\n306: \n307: // projectValue returns the form's current project values as project.Settings,\n308: // ready to be persisted with project.Save.\n309: func (v *settingsView) projectValue() project.Settings {\n310: \treturn project.Settings{\n311: \t\tBaseBranch:      strings.TrimSpace(v.baseBranch.Value()),\n312: \t\tJobBranchPrefix: strings.TrimSpace(v.jobBranchPrefix.Value()),\n313: \t}\n314: }\n315: \n316: // render draws the form.\n317: func (v *settingsView) render() string {\n318: \tvar b strings.Builder\n319: \tb.WriteString(titleStyle.Render(\"Settings\"))\n320: \tb.WriteString(\"\\n\\n\")\n321: \n322: \t// Editor row (global).\n323: \teditorLabel := \"  Editor: \"\n324: \tif v.focus == stFocusEditor {\n325: \t\tb.WriteString(editorLabel + v.editor.View())\n326: \t} else {\n327: \t\tb.WriteString(dimStyle.Render(editorLabel) + dimStyle.Render(v.editor.View()))\n328: \t}\n329: \tb.WriteString(\"\\n\")\n330: \tb.WriteString(dimStyle.Render(\"           blank = use $VISUAL / $EDITOR / nano / vi\"))\n331: \tb.WriteString(\"\\n\\n\")\n332: \n333: \t// Base branch row (project). Labeled project-scoped so it's clear this\n334: \t// writes a different file (.manigot/manigot.json, committable) than the\n335: \t// editor/profile rows above and below it.\n336: \tbranchLabel := \"  Base branch (project): \"\n337: \tif v.focus == stFocusBranch {\n338: \t\tb.WriteString(branchLabel + v.baseBranch.View())\n339: \t} else {\n340: \t\tb.WriteString(dimStyle.Render(branchLabel) + dimStyle.Render(v.baseBranch.View()))\n341: \t}\n342: \tb.WriteString(\"\\n\")\n343: \tb.WriteString(dimStyle.Render(\"           blank = main · stored in .manigot/manigot.json, shared with your team\"))\n344: \tb.WriteString(\"\\n\\n\")\n345: \n346: \t// Job branch prefix row (project): the namespace job branches live under,\n347: \t// e.g. \"jobs\" makes a feature job's branch \"jobs/feature/<id>_<slug>\".\n348: \t// Project-scoped like base branch, so the same project-file note applies.\n349: \tprefixLabel := \"  Job branch prefix (project): \"\n350: \tif v.focus == stFocusJobPrefix {\n351: \t\tb.WriteString(prefixLabel + v.jobBranchPrefix.View())\n352: \t} else {\n353: \t\tb.WriteString(dimStyle.Render(prefixLabel) + dimStyle.Render(v.jobBranchPrefix.View()))\n354: \t}\n355: \tb.WriteString(\"\\n\")\n356: \tb.WriteString(dimStyle.Render(\"           blank = feature/… · stored in .manigot/manigot.json, shared with your team\"))\n357: \tb.WriteString(\"\\n\\n\")\n358: \n359: \t// Recent activity count row (global): the maximum number of entries the\n360: \t// dashboard's recent-activity strip may show.\n361: \tcountLabel := \"  Recent activity: \"\n362: \tif v.focus == stFocusCount {\n363: \t\tb.WriteString(countLabel + v.recentCount.View())\n364: \t} else {\n365: \t\tb.WriteString(dimStyle.Render(countLabel) + dimStyle.Render(v.recentCount.View()))\n366: \t}\n367: \tb.WriteString(\"\\n\")\n368: \tb.WriteString(dimStyle.Render(\"           blank = 5 · max entries shown in the dashboard's recent activity strip, stored in config/tui-settings.json\"))\n369: \tb.WriteString(\"\\n\\n\")\n370: \n371: \t// Profile row (global): one line per profile, the selected one highlighted.\n372: \tb.WriteString(\"  Profile:\\n\")\n373: \tfor i, p := range profileOptions {\n374: \t\tvar mark, id, rest string\n375: \t\tif i == v.profile && v.focus == stFocusProfile {\n376: \t\t\tmark = accentStyle.Render(\"▸ \")\n377: \t\t\tid = accentStyle.Render(p.ID)\n378: \t\t} else if i == v.profile {\n379: \t\t\tmark = lipgloss.NewStyle().Bold(true).Render(\"● \")\n380: \t\t\tid = lipgloss.NewStyle().Bold(true).Render(p.ID)\n381: \t\t} else {\n382: \t\t\tmark = \"  \"\n383: \t\t\tid = dimStyle.Render(p.ID)\n384: \t\t}\n385: \t\trest = \"  \" + dimStyle.Render(p.Label)\n386: \t\tb.WriteString(\"    \" + mark + id + rest)\n387: \t\tb.WriteString(\"\\n\")\n388: \t}\n389: \t// Describe the selected profile: which agent CLI it launches and what it\n390: \t// bills against, then where the choice is stored. The model is\n391: \t// deliberately not shown — the opencode profiles' model lives in manigot's\n392: \t// .env (OPENCODE_ZAI_MODEL/OPENCODE_GO_MODEL/OPENCODE_ZEN_MODEL/\n393: \t// OPENCODE_ZEN_FREE_MODEL), which the TUI does not read.\n394: \tsel := profileOptions[v.profile]\n395: \tselDesc := \"tool: \" + sel.Tool\n396: \tselDesc += \" · billed via \" + sel.Auth\n397: \tb.WriteString(dimStyle.Render(\"    \" + selDesc))\n398: \tb.WriteString(\"\\n\")\n399: \tb.WriteString(dimStyle.Render(\"    saved as MANIGOT_PROFILE in manigot/.env — shared with the CLI (bare mg / mg profiles)\"))\n400: \tb.WriteString(\"\\n\\n\")\n401: \n402: \t// Terminal row (global): the command used to spawn an agent session's\n403: \t// terminal, replacing launch's auto-detect spawn order when set. Inside\n404: \t// tmux the split pane always wins, regardless of this setting.\n405: \tterminalLabel := \"  Terminal: \"\n406: \tif v.focus == stFocusTerminal {\n407: \t\tb.WriteString(terminalLabel + v.terminal.View())\n408: \t} else {\n409: \t\tb.WriteString(dimStyle.Render(terminalLabel) + dimStyle.Render(v.terminal.View()))\n410: \t}\n411: \tb.WriteString(\"\\n\")\n412: \tb.WriteString(dimStyle.Render(\"           blank = auto-detect (tmux / Terminal.app / gnome-terminal / ...) · inside tmux the split pane always wins · stored in config/tui-settings.json\"))\n413: \tb.WriteString(\"\\n\\n\")\n414: \n415: \t// Theme row (global): the OpenCode theme name (e.g. \"nord\", \"tokyonight\"),\n416: \t// shared across every OpenCode profile — Claude Code already respects the\n417: \t// host terminal's own theme, so this has no effect there. Not validated\n418: \t// against a fixed list here, matching `mg theme`.\n419: \tthemeLabel := \"  Theme: \"\n420: \tif v.focus == stFocusTheme {\n421: \t\tb.WriteString(themeLabel + v.theme.View())\n422: \t} else {\n423: \t\tb.WriteString(dimStyle.Render(themeLabel) + dimStyle.Render(v.theme.View()))\n424: \t}\n425: \tb.WriteString(\"\\n\")\n426: \tb.WriteString(dimStyle.Render(\"           blank = OpenCode's own default/config · OpenCode only · saved as OPENCODE_THEME in manigot/.env\"))\n427: \tb.WriteString(\"\\n\\n\")\n428: \n429: \t// Footer: status or a focus-aware hint.\n430: \tif v.status != \"\" {\n431: \t\tb.WriteString(statusStyle.Render(v.status))\n432: \t} else {\n433: \t\tb.WriteString(dimStyle.Render(v.hint()))\n434: \t}\n435: \treturn b.String()\n436: }\n437: \n438: // hint returns the footer key hint, varied by which field is focused so it\n439: // always names the fields tab moves between rather than a static list.\n440: func (v *settingsView) hint() string {\n441: \tprefix := \"enter save · esc cancel\"\n442: \tswitch v.focus {\n443: \tcase stFocusEditor:\n444: \t\treturn \"tab/shift+tab base branch · \" + prefix\n445: \tcase stFocusBranch:\n446: \t\treturn \"tab/shift+tab job branch prefix · \" + prefix\n447: \tcase stFocusJobPrefix:\n448: \t\treturn \"tab/shift+tab recent activity · \" + prefix\n449: \tcase stFocusCount:\n450: \t\treturn \"tab/shift+tab profile · \" + prefix\n451: \tcase stFocusProfile:\n452: \t\treturn \"←/→ change profile · tab/shift+tab terminal · \" + prefix\n453: \tcase stFocusTerminal:\n454: \t\treturn \"tab/shift+tab theme · \" + prefix\n455: \tdefault: // stFocusTheme\n456: \t\treturn \"tab/shift+tab editor · \" + prefix\n457: \t}\n458: }\n\n(End of file - total 458 lines)\n</content>","metadata":{"preview":"package ui\n\nimport (\n\t\"fmt\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/charmbracelet/bubbles/textinput\"\n\ttea \"github.com/charmbracelet/bubbletea\"\n\t\"github.com/charmbracelet/lipgloss\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// profileOptions mirrors the profiles accepted by scripts/run.sh's --profile\n// flag, in cycle order.\nvar profileOptions = config.Profiles()\n\n// recentActivityCountMax is the upper end of the valid range for the","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/ui/settings.go","text":"package ui\n\nimport (\n\t\"fmt\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/charmbracelet/bubbles/textinput\"\n\ttea \"github.com/charmbracelet/bubbletea\"\n\t\"github.com/charmbracelet/lipgloss\"\n\n\t\"github.com/lmuskalla/manigot/internal/config\"\n\t\"github.com/lmuskalla/manigot/internal/project\"\n)\n\n// profileOptions mirrors the profiles accepted by scripts/run.sh's --profile\n// flag, in cycle order.\nvar profileOptions = config.Profiles()\n\n// recentActivityCountMax is the upper end of the valid range for the\n// recent-activity count setting (the floor is 1). Values outside 1–100 are\n// rejected by the settings form.\nconst recentActivityCountMax = 100\n\n// Number of focusable fields in the settings form: editor, base branch, job\n// branch prefix, recent activity count, profile, terminal, theme — in tab\n// cycle order. Kept as a named constant so the tab/shift+tab cycle and focus\n// comparisons don't all hardcode a literal that has to be kept in sync field\n// by field.\nconst stFieldCount = 7\n\n// Focus indices for the settings form's fields, in tab cycle order: editor →\n// base branch → job branch prefix → recent activity count → profile →\n// terminal → theme → editor. Used by update() and render() instead of bare\n// ints. Terminal was appended after Profile, and Theme after Terminal, rather\n// than inserted next to Editor, so the existing constants keep their values\n// unchanged.\nconst (\n\tstFocusEditor    = 0\n\tstFocusBranch    = 1\n\tstFocusJobPrefix = 2\n\tstFocusCount     = 3\n\tstFocusProfile   = 4\n\tstFocusTerminal  = 5\n\tstFocusTheme     = 6\n)\n\n// stAction is what update returns for the App to act on.\ntype stAction int\n\nconst (\n\tstNone   stAction = iota\n\tstCancel          // esc — discard and return to the list\n\tstSubmit          // enter — persist the settings\n)\n\n// settingsView is the \"Settings\" form. It edits three files at once:\n//\n//   - config/tui-settings.json — the editor preference and the recent-activity\n//     count (personal, gitignored, in the manigot checkout);\n//   - manigot/.env — the subscription profile, as MANIGOT_PROFILE: the one\n//     default shared between CLI and TUI (bare `mg` resolves to it, `mg\n//     profiles` writes it, and this form reads/writes the same key); and\n//   - the project.Settings (base branch, job branch prefix) — shared project\n//     conventions, committable, in the target project's .manigot/manigot.json.\n//\n// Like newJobView, it does not persist anything itself — the App calls\n// config.Save and project.Save on submit so this stays a pure input\n// component.\ntype settingsView struct {\n\teditor          textinput.Model\n\tbaseBranch      textinput.Model\n\tjobBranchPrefix textinput.Model\n\trecentCount     textinput.Model\n\tterminal        textinput.Model\n\ttheme           textinput.Model\n\tprofile         int // index into profileOptions\n\tfocus           int // stFocusEditor / stFocusBranch / stFocusJobPrefix / stFocusCount / stFocusProfile / stFocusTerminal / stFocusTheme\n\twidth           int\n\theight          int\n\tstatus          string // validation/save error message\n}\n\n// newSettingsView builds the form seeded from the current global config and\n// project settings. The editor field is focused first, matching the form's\n// pre-base-branch behaviour.\nfunc newSettingsView(global config.Settings, proj project.Settings, width, height int) *settingsView {\n\teditor := textinput.New()\n\teditor.Placeholder = \"$VISUAL / $EDITOR / nano\"\n\teditor.Prompt = \"\" // we render our own \"Editor:\" label\n\teditor.CharLimit = 120\n\teditor.SetValue(global.Editor)\n\teditor.Focus()\n\teditor.Width = 60\n\n\tbaseBranch := textinput.New()\n\tbaseBranch.Placeholder = \"main\"\n\tbaseBranch.Prompt = \"\" // we render our own \"Base branch:\" label\n\tbaseBranch.CharLimit = 120\n\tbaseBranch.SetValue(proj.BaseBranch)\n\tbaseBranch.Width = 60\n\n\tjobBranchPrefix := textinput.New()\n\tjobBranchPrefix.Placeholder = \"jobs\"\n\tjobBranchPrefix.Prompt = \"\" // we render our own \"Job branch prefix:\" label\n\tjobBranchPrefix.CharLimit = 120\n\tjobBranchPrefix.SetValue(proj.JobBranchPrefix)\n\tjobBranchPrefix.Width = 60\n\n\trecentCount := textinput.New()\n\trecentCount.Placeholder = strconv.Itoa(config.DefaultRecentActivityCount)\n\trecentCount.Prompt = \"\" // we render our own \"Recent activity:\" label\n\trecentCount.CharLimit = 3\n\t// Seed with the resolved number so the user sees the effective value;\n\t// clearing it means \"default\" (see recentActivityCount).\n\trecentCount.SetValue(strconv.Itoa(global.RecentActivityCountValue()))\n\trecentCount.Width = 60\n\n\tterminal := textinput.New()\n\tterminal.Placeholder = \"blank = auto-detect\"\n\tterminal.Prompt = \"\" // we render our own \"Terminal:\" label\n\tterminal.CharLimit = 120\n\tterminal.SetValue(global.Terminal)\n\tterminal.Width = 60\n\n\ttheme := textinput.New()\n\ttheme.Placeholder = \"blank = OpenCode's own default\"\n\ttheme.Prompt = \"\" // we render our own \"Theme:\" label\n\ttheme.CharLimit = 120\n\ttheme.SetValue(global.ThemeValue())\n\ttheme.Width = 60\n\n\tv := &settingsView{\n\t\teditor:          editor,\n\t\tbaseBranch:      baseBranch,\n\t\tjobBranchPrefix: jobBranchPrefix,\n\t\trecentCount:     recentCount,\n\t\tterminal:        terminal,\n\t\ttheme:           theme,\n\t\tprofile:         profileIndex(global.ProfileValue()),\n\t\tfocus:           stFocusEditor,\n\t\twidth:           width,\n\t\theight:          height,\n\t}\n\tif width > 0 {\n\t\tw := stInputWidth(width)\n\t\tv.editor.Width = w\n\t\tv.baseBranch.Width = w\n\t\tv.jobBranchPrefix.Width = w\n\t\tv.recentCount.Width = w\n\t\tv.terminal.Width = w\n\t\tv.theme.Width = w\n\t}\n\treturn v\n}\n\n// stInputWidth returns the usable width for a settings text input, given the\n// available form width. All text inputs share the same width rule.\nfunc stInputWidth(width int) int {\n\tw := width - 12\n\tif w < 20 {\n\t\tw = 20\n\t}\n\treturn w\n}\n\n// profileIndex finds id in profileOptions, defaulting to index 0 (claude-pro)\n// for an unrecognized value.\nfunc profileIndex(id string) int {\n\tfor i, p := range profileOptions {\n\t\tif p.ID == id {\n\t\t\treturn i\n\t\t}\n\t}\n\treturn 0\n}\n\n// resize updates the viewport (and the text input widths) on terminal resize.\nfunc (v *settingsView) resize(width, height int) {\n\tif width == v.width && height == v.height {\n\t\treturn\n\t}\n\tv.width, v.height = width, height\n\tif width > 0 {\n\t\tw := stInputWidth(width)\n\t\tv.editor.Width = w\n\t\tv.baseBranch.Width = w\n\t\tv.jobBranchPrefix.Width = w\n\t\tv.recentCount.Width = w\n\t\tv.terminal.Width = w\n\t\tv.theme.Width = w\n\t}\n}\n\n// update processes a key for the form and reports the resulting action.\nfunc (v *settingsView) update(msg tea.KeyMsg) stAction {\n\tswitch msg.String() {\n\tcase \"esc\":\n\t\treturn stCancel\n\tcase \"tab\":\n\t\tv.setFocus((v.focus + 1) % stFieldCount)\n\t\treturn stNone\n\tcase \"shift+tab\":\n\t\tv.setFocus((v.focus + stFieldCount - 1) % stFieldCount)\n\t\treturn stNone\n\tcase \"enter\":\n\t\treturn stSubmit\n\t}\n\n\tif v.focus == stFocusProfile {\n\t\t// Profile selector: cycle with ←/→.\n\t\tswitch msg.String() {\n\t\tcase \"left\":\n\t\t\tv.profile = (v.profile + len(profileOptions) - 1) % len(profileOptions)\n\t\tcase \"right\":\n\t\t\tv.profile = (v.profile + 1) % len(profileOptions)\n\t\t}\n\t\treturn stNone\n\t}\n\n\t// A text input is focused (editor, base branch, job branch prefix, recent\n\t// count, terminal or theme): route the key to it.\n\tvar ti *textinput.Model\n\tswitch v.focus {\n\tcase stFocusEditor:\n\t\tti = &v.editor\n\tcase stFocusBranch:\n\t\tti = &v.baseBranch\n\tcase stFocusJobPrefix:\n\t\tti = &v.jobBranchPrefix\n\tcase stFocusCount:\n\t\tti = &v.recentCount\n\tcase stFocusTerminal:\n\t\tti = &v.terminal\n\tdefault: // stFocusTheme\n\t\tti = &v.theme\n\t}\n\tm, _ := ti.Update(msg)\n\t*ti = m\n\treturn stNone\n}\n\n// setFocus moves focus to field i and keeps the text inputs' focus state in\n// sync: only the editor, base branch, job branch prefix, recent count,\n// terminal or theme holds the text cursor; the profile selector is\n// keyboard-driven (←/→), not a text input.\nfunc (v *settingsView) setFocus(i int) {\n\tv.focus = i\n\tv.editor.Blur()\n\tv.baseBranch.Blur()\n\tv.jobBranchPrefix.Blur()\n\tv.recentCount.Blur()\n\tv.terminal.Blur()\n\tv.theme.Blur()\n\tswitch i {\n\tcase stFocusEditor:\n\t\tv.editor.Focus()\n\tcase stFocusBranch:\n\t\tv.baseBranch.Focus()\n\tcase stFocusJobPrefix:\n\t\tv.jobBranchPrefix.Focus()\n\tcase stFocusCount:\n\t\tv.recentCount.Focus()\n\tcase stFocusTerminal:\n\t\tv.terminal.Focus()\n\tcase stFocusTheme:\n\t\tv.theme.Focus()\n\tdefault: // stFocusProfile\n\t\t// no text input to focus — the profile selector is keyboard-driven\n\t}\n}\n\n// recentActivityCount parses and validates the form's recent-activity count\n// field. A trimmed empty input means \"unset → default\"\n// (config.DefaultRecentActivityCount). Anything that does not parse as an\n// integer in 1–recentActivityCountMax returns an error so the caller can\n// surface it and keep the form open without persisting anything.\nfunc (v *settingsView) recentActivityCount() (int, error) {\n\traw := strings.TrimSpace(v.recentCount.Value())\n\tif raw == \"\" {\n\t\treturn config.DefaultRecentActivityCount, nil\n\t}\n\tn, err := strconv.Atoi(raw)\n\tif err != nil || n < 1 || n > recentActivityCountMax {\n\t\treturn 0, fmt.Errorf(\"recent activity count must be an integer between 1 and %d (blank = %d)\", recentActivityCountMax, config.DefaultRecentActivityCount)\n\t}\n\treturn n, nil\n}\n\n// settingsValue returns the form's current global values as config.Settings,\n// ready to be persisted with config.Save. The recent-activity count is\n// included only when valid — callers must run recentActivityCount() first (as\n// updateSettings does) so an invalid value never silently reaches disk as 0.\nfunc (v *settingsView) settingsValue() config.Settings {\n\ts := config.Settings{\n\t\tEditor:   strings.TrimSpace(v.editor.Value()),\n\t\tProfile:  profileOptions[v.profile].ID,\n\t\tTerminal: strings.TrimSpace(v.terminal.Value()),\n\t\tTheme:    strings.TrimSpace(v.theme.Value()),\n\t}\n\tif n, err := v.recentActivityCount(); err == nil {\n\t\ts.RecentActivityCount = n\n\t}\n\treturn s\n}\n\n// projectValue returns the form's current project values as project.Settings,\n// ready to be persisted with project.Save.\nfunc (v *settingsView) projectValue() project.Settings {\n\treturn project.Settings{\n\t\tBaseBranch:      strings.TrimSpace(v.baseBranch.Value()),\n\t\tJobBranchPrefix: strings.TrimSpace(v.jobBranchPrefix.Value()),\n\t}\n}\n\n// render draws the form.\nfunc (v *settingsView) render() string {\n\tvar b strings.Builder\n\tb.WriteString(titleStyle.Render(\"Settings\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Editor row (global).\n\teditorLabel := \"  Editor: \"\n\tif v.focus == stFocusEditor {\n\t\tb.WriteString(editorLabel + v.editor.View())\n\t} else {\n\t\tb.WriteString(dimStyle.Render(editorLabel) + dimStyle.Render(v.editor.View()))\n\t}\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"           blank = use $VISUAL / $EDITOR / nano / vi\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Base branch row (project). Labeled project-scoped so it's clear this\n\t// writes a different file (.manigot/manigot.json, committable) than the\n\t// editor/profile rows above and below it.\n\tbranchLabel := \"  Base branch (project): \"\n\tif v.focus == stFocusBranch {\n\t\tb.WriteString(branchLabel + v.baseBranch.View())\n\t} else {\n\t\tb.WriteString(dimStyle.Render(branchLabel) + dimStyle.Render(v.baseBranch.View()))\n\t}\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"           blank = main · stored in .manigot/manigot.json, shared with your team\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Job branch prefix row (project): the namespace job branches live under,\n\t// e.g. \"jobs\" makes a feature job's branch \"jobs/feature/<id>_<slug>\".\n\t// Project-scoped like base branch, so the same project-file note applies.\n\tprefixLabel := \"  Job branch prefix (project): \"\n\tif v.focus == stFocusJobPrefix {\n\t\tb.WriteString(prefixLabel + v.jobBranchPrefix.View())\n\t} else {\n\t\tb.WriteString(dimStyle.Render(prefixLabel) + dimStyle.Render(v.jobBranchPrefix.View()))\n\t}\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"           blank = feature/… · stored in .manigot/manigot.json, shared with your team\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Recent activity count row (global): the maximum number of entries the\n\t// dashboard's recent-activity strip may show.\n\tcountLabel := \"  Recent activity: \"\n\tif v.focus == stFocusCount {\n\t\tb.WriteString(countLabel + v.recentCount.View())\n\t} else {\n\t\tb.WriteString(dimStyle.Render(countLabel) + dimStyle.Render(v.recentCount.View()))\n\t}\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"           blank = 5 · max entries shown in the dashboard's recent activity strip, stored in config/tui-settings.json\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Profile row (global): one line per profile, the selected one highlighted.\n\tb.WriteString(\"  Profile:\\n\")\n\tfor i, p := range profileOptions {\n\t\tvar mark, id, rest string\n\t\tif i == v.profile && v.focus == stFocusProfile {\n\t\t\tmark = accentStyle.Render(\"▸ \")\n\t\t\tid = accentStyle.Render(p.ID)\n\t\t} else if i == v.profile {\n\t\t\tmark = lipgloss.NewStyle().Bold(true).Render(\"● \")\n\t\t\tid = lipgloss.NewStyle().Bold(true).Render(p.ID)\n\t\t} else {\n\t\t\tmark = \"  \"\n\t\t\tid = dimStyle.Render(p.ID)\n\t\t}\n\t\trest = \"  \" + dimStyle.Render(p.Label)\n\t\tb.WriteString(\"    \" + mark + id + rest)\n\t\tb.WriteString(\"\\n\")\n\t}\n\t// Describe the selected profile: which agent CLI it launches and what it\n\t// bills against, then where the choice is stored. The model is\n\t// deliberately not shown — the opencode profiles' model lives in manigot's\n\t// .env (OPENCODE_ZAI_MODEL/OPENCODE_GO_MODEL/OPENCODE_ZEN_MODEL/\n\t// OPENCODE_ZEN_FREE_MODEL), which the TUI does not read.\n\tsel := profileOptions[v.profile]\n\tselDesc := \"tool: \" + sel.Tool\n\tselDesc += \" · billed via \" + sel.Auth\n\tb.WriteString(dimStyle.Render(\"    \" + selDesc))\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"    saved as MANIGOT_PROFILE in manigot/.env — shared with the CLI (bare mg / mg profiles)\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Terminal row (global): the command used to spawn an agent session's\n\t// terminal, replacing launch's auto-detect spawn order when set. Inside\n\t// tmux the split pane always wins, regardless of this setting.\n\tterminalLabel := \"  Terminal: \"\n\tif v.focus == stFocusTerminal {\n\t\tb.WriteString(terminalLabel + v.terminal.View())\n\t} else {\n\t\tb.WriteString(dimStyle.Render(terminalLabel) + dimStyle.Render(v.terminal.View()))\n\t}\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"           blank = auto-detect (tmux / Terminal.app / gnome-terminal / ...) · inside tmux the split pane always wins · stored in config/tui-settings.json\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Theme row (global): the OpenCode theme name (e.g. \"nord\", \"tokyonight\"),\n\t// shared across every OpenCode profile — Claude Code already respects the\n\t// host terminal's own theme, so this has no effect there. Not validated\n\t// against a fixed list here, matching `mg theme`.\n\tthemeLabel := \"  Theme: \"\n\tif v.focus == stFocusTheme {\n\t\tb.WriteString(themeLabel + v.theme.View())\n\t} else {\n\t\tb.WriteString(dimStyle.Render(themeLabel) + dimStyle.Render(v.theme.View()))\n\t}\n\tb.WriteString(\"\\n\")\n\tb.WriteString(dimStyle.Render(\"           blank = OpenCode's own default/config · OpenCode only · saved as OPENCODE_THEME in manigot/.env\"))\n\tb.WriteString(\"\\n\\n\")\n\n\t// Footer: status or a focus-aware hint.\n\tif v.status != \"\" {\n\t\tb.WriteString(statusStyle.Render(v.status))\n\t} else {\n\t\tb.WriteString(dimStyle.Render(v.hint()))\n\t}\n\treturn b.String()\n}\n\n// hint returns the footer key hint, varied by which field is focused so it\n// always names the fields tab moves between rather than a static list.\nfunc (v *settingsView) hint() string {\n\tprefix := \"enter save · esc cancel\"\n\tswitch v.focus {\n\tcase stFocusEditor:\n\t\treturn \"tab/shift+tab base branch · \" + prefix\n\tcase stFocusBranch:\n\t\treturn \"tab/shift+tab job branch prefix · \" + prefix\n\tcase stFocusJobPrefix:\n\t\treturn \"tab/shift+tab recent activity · \" + prefix\n\tcase stFocusCount:\n\t\treturn \"tab/shift+tab profile · \" + prefix\n\tcase stFocusProfile:\n\t\treturn \"←/→ change profile · tab/shift+tab terminal · \" + prefix\n\tcase stFocusTerminal:\n\t\treturn \"tab/shift+tab theme · \" + prefix\n\tdefault: // stFocusTheme\n\t\treturn \"tab/shift+tab editor · \" + prefix\n\t}\n}","lineStart":1,"lineEnd":458,"totalLines":458,"truncated":false}},"title":"src/internal/ui/settings.go","time":{"start":1787919653686,"end":1787919653689}},"id":"prt_04850dabf001bp20HyD2ABXQxD","sessionID":"ses_fb7af5935ffeLyhZ1lIHw0GPEP","messageID":"msg_04850d35e00125oxb1GrWzYy2h"}}
{"type":"tool_use","timestamp":1787919653808,"sessionID":"ses_fb7af5935ffeLyhZ1lIHw0GPEP","part":{"type":"tool","tool":"read","callID":"call_01_yItycLmwP7mV00yGy5gp5028","state":{"status":"completed","input":{"filePath":"/workspace/src/internal/ui/styles.go"},"output":"<path>/workspace/src/internal/ui/styles.go</path>\n<type>file</type>\n<content>\n1: package ui\n2: \n3: import \"github.com/charmbracelet/lipgloss\"\n4: \n5: // Brand colour, matching the accent used in the scaffold.\n6: var accent = lipgloss.Color(\"#7D56F4\")\n7: \n8: // uiPaddingX / uiPaddingY are the outer margin the whole TUI keeps between\n9: // its content and the terminal edge. Asymmetric because terminal cells are\n10: // roughly twice as tall as they are wide, so 1 row / 2 columns reads as an\n11: // even margin rather than a wider gap on the sides. Every view sizes its\n12: // layout against a.width/a.height, which the WindowSizeMsg handler already\n13: // shrinks by this amount (see app.go's Update) — uiPaddingStyle then adds\n14: // it back as literal padding around the rendered frame, so the padded\n15: // output still exactly fills the alt-screen terminal instead of overflowing it.\n16: const (\n17: \tuiPaddingX = 2\n18: \tuiPaddingY = 1\n19: )\n20: \n21: // uiPaddingStyle wraps the top-level rendered frame in View().\n22: var uiPaddingStyle = lipgloss.NewStyle().Padding(uiPaddingY, uiPaddingX)\n23: \n24: var (\n25: \t// titleStyle is for the app title in the header.\n26: \ttitleStyle = lipgloss.NewStyle().Bold(true).Foreground(accent)\n27: \n28: \t// dimStyle is for secondary text.\n29: \tdimStyle = lipgloss.NewStyle().Faint(true)\n30: \n31: \t// activityStyle is for the recent-activity (git log) strip — a notch\n32: \t// lighter than dimStyle so it reads as background information, less\n33: \t// prominent than the job list and footer above it. The gray was\n34: \t// lightened from #585858 per the \"make git log a bit brighter\" brief:\n35: \t// the old value faded to near-invisible on low-contrast screens.\n36: \tactivityStyle = lipgloss.NewStyle().Faint(true).Foreground(lipgloss.Color(\"#808080\"))\n37: \n38: \t// headerStyle is for column headers.\n39: \theaderStyle = lipgloss.NewStyle().Bold(true)\n40: \n41: \t// selectedStyle highlights the current list row.\n42: \tselectedStyle = lipgloss.NewStyle().Bold(true).Foreground(accent)\n43: \n44: \t// accentStyle emphasises short tokens like action-bar keys.\n45: \taccentStyle = lipgloss.NewStyle().Bold(true).Foreground(accent)\n46: \n47: \t// statusOpen / statusDone colour the status column.\n48: \tstatusOpenStyle = lipgloss.NewStyle().Foreground(lipgloss.Color(\"#D7A000\"))\n49: \tstatusDoneStyle = lipgloss.NewStyle().Foreground(lipgloss.Color(\"#3FB950\"))\n50: \n51: \t// statusStyle is for the detail view's status line (launch confirmations).\n52: \tstatusStyle = lipgloss.NewStyle().Foreground(lipgloss.Color(\"#3FB950\"))\n53: \n54: \t// warnStyle is for the detail view's \"[needs human]\" mg-jdi badge and any\n55: \t// other warning-level tag — plain red text, no background fill, per\n56: \t// explicit feedback that a background banner was the wrong call. ANSI\n57: \t// palette index 9 (bright red), not a custom hex, so it renders from the\n58: \t// terminal's own configured red instead of depending on truecolor\n59: \t// support.\n60: \twarnStyle = lipgloss.NewStyle().Bold(true).Foreground(lipgloss.Color(\"9\"))\n61: \n62: \t// gitPanelModalStyle is the popup box that floats the git panel over the\n63: \t// detail view: a rounded, accent-bordered box with a solid background\n64: \t// fill, so the cells it covers are fully replaced rather than letting the\n65: \t// detail content show through (see App.gitPanelOverlay's placeOverlay).\n66: \tgitPanelModalStyle = lipgloss.NewStyle().\n67: \t\t\t\tBorder(lipgloss.RoundedBorder()).\n68: \t\t\t\tBorderForeground(accent).\n69: \t\t\t\tBackground(lipgloss.Color(\"#2D2A3E\")).\n70: \t\t\t\tPadding(1, 2)\n71: )\n\n(End of file - total 71 lines)\n</content>","metadata":{"preview":"package ui\n\nimport \"github.com/charmbracelet/lipgloss\"\n\n// Brand colour, matching the accent used in the scaffold.\nvar accent = lipgloss.Color(\"#7D56F4\")\n\n// uiPaddingX / uiPaddingY are the outer margin the whole TUI keeps between\n// its content and the terminal edge. Asymmetric because terminal cells are\n// roughly twice as tall as they are wide, so 1 row / 2 columns reads as an\n// even margin rather than a wider gap on the sides. Every view sizes its\n// layout against a.width/a.height, which the WindowSizeMsg handler already\n// shrinks by this amount (see app.go's Update) — uiPaddingStyle then adds\n// it back as literal padding around the rendered frame, so the padded\n// output still exactly fills the alt-screen terminal instead of overflowing it.\nconst (\n\tuiPaddingX = 2\n\tuiPaddingY = 1\n)\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/internal/ui/styles.go","text":"package ui\n\nimport \"github.com/charmbracelet/lipgloss\"\n\n// Brand colour, matching the accent used in the scaffold.\nvar accent = lipgloss.Color(\"#7D56F4\")\n\n// uiPaddingX / uiPaddingY are the outer margin the whole TUI keeps between\n// its content and the terminal edge. Asymmetric because terminal cells are\n// roughly twice as tall as they are wide, so 1 row / 2 columns reads as an\n// even margin rather than a wider gap on the sides. Every view sizes its\n// layout against a.width/a.height, which the WindowSizeMsg handler already\n// shrinks by this amount (see app.go's Update) — uiPaddingStyle then adds\n// it back as literal padding around the rendered frame, so the padded\n// output still exactly fills the alt-screen terminal instead of overflowing it.\nconst (\n\tuiPaddingX = 2\n\tuiPaddingY = 1\n)\n\n// uiPaddingStyle wraps the top-level rendered frame in View().\nvar uiPaddingStyle = lipgloss.NewStyle().Padding(uiPaddingY, uiPaddingX)\n\nvar (\n\t// titleStyle is for the app title in the header.\n\ttitleStyle = lipgloss.NewStyle().Bold(true).Foreground(accent)\n\n\t// dimStyle is for secondary text.\n\tdimStyle = lipgloss.NewStyle().Faint(true)\n\n\t// activityStyle is for the recent-activity (git log) strip — a notch\n\t// lighter than dimStyle so it reads as background information, less\n\t// prominent than the job list and footer above it. The gray was\n\t// lightened from #585858 per the \"make git log a bit brighter\" brief:\n\t// the old value faded to near-invisible on low-contrast screens.\n\tactivityStyle = lipgloss.NewStyle().Faint(true).Foreground(lipgloss.Color(\"#808080\"))\n\n\t// headerStyle is for column headers.\n\theaderStyle = lipgloss.NewStyle().Bold(true)\n\n\t// selectedStyle highlights the current list row.\n\tselectedStyle = lipgloss.NewStyle().Bold(true).Foreground(accent)\n\n\t// accentStyle emphasises short tokens like action-bar keys.\n\taccentStyle = lipgloss.NewStyle().Bold(true).Foreground(accent)\n\n\t// statusOpen / statusDone colour the status column.\n\tstatusOpenStyle = lipgloss.NewStyle().Foreground(lipgloss.Color(\"#D7A000\"))\n\tstatusDoneStyle = lipgloss.NewStyle().Foreground(lipgloss.Color(\"#3FB950\"))\n\n\t// statusStyle is for the detail view's status line (launch confirmations).\n\tstatusStyle = lipgloss.NewStyle().Foreground(lipgloss.Color(\"#3FB950\"))\n\n\t// warnStyle is for the detail view's \"[needs human]\" mg-jdi badge and any\n\t// other warning-level tag — plain red text, no background fill, per\n\t// explicit feedback that a background banner was the wrong call. ANSI\n\t// palette index 9 (bright red), not a custom hex, so it renders from the\n\t// terminal's own configured red instead of depending on truecolor\n\t// support.\n\twarnStyle = lipgloss.NewStyle().Bold(true).Foreground(lipgloss.Color(\"9\"))\n\n\t// gitPanelModalStyle is the popup box that floats the git panel over the\n\t// detail view: a rounded, accent-bordered box with a solid background\n\t// fill, so the cells it covers are fully replaced rather than letting the\n\t// detail content show through (see App.gitPanelOverlay's placeOverlay).\n\tgitPanelModalStyle = lipgloss.NewStyle().\n\t\t\t\tBorder(lipgloss.RoundedBorder()).\n\t\t\t\tBorderForeground(accent).\n\t\t\t\tBackground(lipgloss.Color(\"#2D2A3E\")).\n\t\t\t\tPadding(1, 2)\n)","lineStart":1,"lineEnd":71,"totalLines":71,"truncated":false}},"title":"src/internal/ui/styles.go","time":{"start":1787919653802,"end":1787919653806}},"id":"prt_04850db4d001eAADsMUwzoE6p2","sessionID":"ses_fb7af5935ffeLyhZ1lIHw0GPEP","messageID":"msg_04850d35e00125oxb1GrWzYy2h"}}
