.env

# Built TUI binary (produced by `make tui`).
/bin/

# Local TUI preferences (editor, subscription profile), written by the TUI's
# settings screen (tui/internal/config). Machine-specific, not shared.
/config/

# Runtime mount points: docs/ is bind-mounted here inside the container,
# so tracking them would duplicate docs/ in the repo.
.claude/
.opencode/

# OpenCode's read-only context mount of docs/AGENTS.md (see scripts/run.sh —
# CONTEXT_TARGET for opencode is /workspace/AGENTS.md). Same duplication
# problem as .claude/ and .opencode/ above; tracked source is docs/AGENTS.md.
/AGENTS.md

# mg-jdi's per-job status/run-log sidecar (Decision 4 in the "fully
# autonomous mode" brief) — kept in .manigot/, outside every job's own
# directory (docs/jobs/<name>/) and outside docs/ itself, so it can never
# be swept into an agent's `git add -A`, and not shared/tracked at all:
# it's ephemeral run state, not job content. (.manigot/manigot.json, the
# project settings, IS committed — only this ephemeral subdirectory is
# ignored.)
.manigot/jdi-status/
